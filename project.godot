; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TOSSA"
config/description="A juggler's climb in pixels: strict catches, hold-to-throw heights, and a career from backyard to world arena."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
; KEEP, NOT EXPAND, AND INTEGER, NOT FRACTIONAL (2026-08-21) - this is decision 1 of the
; pixel-art lock defended at the window seam. See CLAUDE.md, "THE ONE MODE NOBODY HAD
; EVER PHOTOGRAPHED". With "expand" the viewport becomes the window's own shape, and
; macOS reports a fullscreen framebuffer of 2560x1606, which gives a viewport of
; 1280x803 - an ODD height the 2px art grid cannot tile. Every 640x360 venue painting is
; then stretched 2.231x vertically, so a third of its source rows are drawn three screen
; pixels tall and the rest two. Measured on the Circus: 5.17% off-grid at 1280x720,
; 26.59% at 1280x803.
window/stretch/aspect="keep"
; "integer" floors the window scale to a whole number, so an art pixel is always a whole
; number of device pixels and the SCREEN-DENSITY text (decision 2) never lands on a half
; one. The cost is that a 1920x1080 screen scales by 1 rather than 1.5 - see CLAUDE.md.
window/stretch/scale_mode="integer"

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": false
}

[input_devices]

buffering/agile_event_flushing=true

[physics]

common/physics_ticks_per_second=120

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.06, 0.03, 0.05, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
