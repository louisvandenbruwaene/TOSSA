#region LOW-LEVEL INPUT POLLING (KEYBOARD + PAD)
func seed_input_edges() -> void:
	# prime the edge detector with the keys' REAL current state, so a key still
	# held from the establishing card (Space especially, which would prime a
	# trick) cannot fire a phantom edge on the first play frame
	var dev := pad_dev()
	# pad seeds mirror Louis's layout: triggers are the catches, bumpers the throws,
	# PAD_TRICK the trick (see _read_inputs)
	_prev["lc"] = Input.is_physical_key_pressed(K_LC) or (dev >= 0 and Input.get_joy_axis(dev, JOY_AXIS_TRIGGER_LEFT) > 0.5)
	_prev["rc"] = Input.is_physical_key_pressed(K_RC) or (dev >= 0 and Input.get_joy_axis(dev, JOY_AXIS_TRIGGER_RIGHT) > 0.5)
	_prev["lt"] = Input.is_physical_key_pressed(K_LT) or (dev >= 0 and Input.is_joy_button_pressed(dev, JOY_BUTTON_LEFT_SHOULDER))
	_prev["rt"] = Input.is_physical_key_pressed(K_RT) or (dev >= 0 and Input.is_joy_button_pressed(dev, JOY_BUTTON_RIGHT_SHOULDER))
	_prev["trick"] = Input.is_physical_key_pressed(K_TRICK) or (dev >= 0 and Input.is_joy_button_pressed(dev, PAD_TRICK))
	# drop any tap latched on a previous screen, so it cannot fire on frame one
	for name in _tap:
		_tap[name] = false


func _read_inputs() -> void:
	# each logical action is keyboard OR pad, combined BEFORE edge detection, so
	# a press on either device yields exactly one edge and can never double-fire.
	if collapsing or results_open:
		return   # the set is over: the hands rest until the next run. results_open
				 # is here so a press behind the results card cannot throw or catch
				 # the props still in hand (the card is driven by _input, not by poll)
	var dev := pad_dev()
	var p_lc := false
	var p_rc := false
	var p_lt := false
	var p_rt := false
	var p_tk := false
	if dev >= 0:
		# Louis's own layout: the BUMPERS throw (they sit where the fingers rest,
		# like F and J on the home row) and the TRIGGERS catch (the squeeze is the
		# catch), PAD_TRICK is the trick (remappable). The trigger latch keeps its
		# hysteresis so an analog trigger near threshold cannot flutter a catch.
		p_lt = Input.is_joy_button_pressed(dev, JOY_BUTTON_LEFT_SHOULDER)
		p_rt = Input.is_joy_button_pressed(dev, JOY_BUTTON_RIGHT_SHOULDER)
		p_tk = Input.is_joy_button_pressed(dev, PAD_TRICK)
		# _trig's "lt"/"rt" name the physical LEFT/RIGHT TRIGGER, unlike every other
		# "lt"/"rt" in this file (K_LT, _prev["lt"], p_lt above) which mean left/right
		# THROW - a deliberate but easy-to-misread key reuse, since these two feed
		# p_lc/p_rc (CATCH) right below, not the throw edges
		_trig["lt"] = _trig_held("lt", Input.get_joy_axis(dev, JOY_AXIS_TRIGGER_LEFT))
		_trig["rt"] = _trig_held("rt", Input.get_joy_axis(dev, JOY_AXIS_TRIGGER_RIGHT))
	else:
		_trig["lt"] = false
		_trig["rt"] = false
	p_lc = bool(_trig["lt"])
	p_rc = bool(_trig["rt"])
	# take the event-latched taps FIRST (always clearing), then fold them into the
	# polled held state, so a press the 120 Hz poll was too coarse to see still
	# registers this frame. Taking them unconditionally means a held key never
	# leaves a latch behind to delay its release by a frame (see _latch_tap).
	var t_lc := _take_tap("lc")
	var t_lt := _take_tap("lt")
	var t_rc := _take_tap("rc")
	var t_rt := _take_tap("rt")
	var t_tk := _take_tap("trick")
	var k_lc := Input.is_physical_key_pressed(K_LC) or t_lc
	var k_lt := Input.is_physical_key_pressed(K_LT) or t_lt
	var k_rc := Input.is_physical_key_pressed(K_RC) or t_rc
	var k_rt := Input.is_physical_key_pressed(K_RT) or t_rt
	var k_tk := Input.is_physical_key_pressed(K_TRICK) or t_tk
	_note_device(k_lc or k_lt or k_rc or k_rt or k_tk, p_lc or p_lt or p_rc or p_rt or p_tk)
	# the trick press is handled BEFORE the throw edges, so Space hit in the same
	# frame as a throw release still empowers THAT throw (the "powerup" promise:
	# space plus catch-throw makes exactly one trick shot, never the one after).
	var tk := k_tk or p_tk
	if tk and not bool(_prev["trick"]):
		on_trick()
	_prev["trick"] = tk
	_edge("lc", k_lc or p_lc, LEFT, true)
	_edge("lt", k_lt or p_lt, LEFT, false)
	_edge("rc", k_rc or p_rc, RIGHT, true)
	_edge("rt", k_rt or p_rt, RIGHT, false)
	# trick CYCLING is event-driven, not polled (see _pad_to_key / K_CYCLE): a
	# discrete press, keyboard or pad, steps it - _read_inputs never touches it


func pad_dev() -> int:
	# the device index of the first connected pad, or -1 when none is attached
	var pads := Input.get_connected_joypads()
	return pads[0] if not pads.is_empty() else -1


func _trig_held(name: String, v: float) -> bool:
	# analog triggers latch on above 0.5 and only let go below 0.4. the gap means
	# a trigger sitting near the threshold cannot flutter and fire a spurious
	# throw release, which would ruin the hold-for-height charge.
	if bool(_trig[name]):
		return v > 0.4
	return v > 0.5


func _note_device(kb: bool, pad: bool) -> void:
	# remember which device spoke last so the hints can follow it. the keyboard
	# wins a tie, so pad glyphs only appear from genuine pad input.
	if kb:
		_pad_last = false
	elif pad:
		_pad_last = true


func _edge(name: String, down: bool, h: int, is_catch: bool) -> void:
	var was := bool(_prev[name])
	if is_catch:
		if down and not was:
			on_catch(h)
	else:
		if down and not was:
			on_throw_press(h)
		elif was and not down:
			on_throw_release(h)
	_prev[name] = down


func _latch_tap(kc: int) -> void:
	# a discrete key-DOWN pulled from the buffered event stream, mapped to its
	# logical action. _read_inputs folds this into the polled held state, so a tap
	# whose down and up both fall between two physics ticks (invisible to the state
	# poll) still fires exactly one press. Never produces input on its own: only a
	# real key-down sets a latch, so this can add a missed press but never a phantom.
	if kc == K_LC:
		_tap["lc"] = true
	elif kc == K_LT:
		_tap["lt"] = true
	elif kc == K_RC:
		_tap["rc"] = true
	elif kc == K_RT:
		_tap["rt"] = true
	elif kc == K_TRICK:
		_tap["trick"] = true


func _take_tap(name: String) -> bool:
	# read and CLEAR a latched tap, so it fires on exactly one read and never sticks
	var v := bool(_tap[name])
	_tap[name] = false
	return v


# -----------------------------------------------------------------------------
# Geometry: OUTER catch point and INNER throw point per hand. Rising balls leave
# the inside, falling balls arrive on the outside, so their lanes never overlap.
# -----------------------------------------------------------------------------

#endregion

#region HAND GEOMETRY & BALL SLOTTING
func stack(h: int) -> Array[Ball]:
	return _stack_l if h == LEFT else _stack_r


func other(h: int) -> int:
	return RIGHT if h == LEFT else LEFT


# -----------------------------------------------------------------------------
# THE DOMINANT HAND HOLDS THE ODD PROP. One rule, one place, and every deal in the
# game goes through it (2026-07-27, Louis: it was not enforced at all times - only
# start_run knew about it, so a lesson always dealt right-handed, a count change
# topped up whichever hand was emptier, and a Settings change to the left hand did
# nothing outside a performance). Every juggler starts the extra prop in their strong
# hand: it throws first and it is the one that has to hold two.
# -----------------------------------------------------------------------------
func deal_side(i: int) -> int:
	# which hand prop i of a FRESH deal starts in. Alternating outward from the dominant
	# hand gives it ceil(n/2) - which is the extra one on any odd count, at any count.
	#
	# A SHOWER IS DEALT ONE-HANDED (2026-07-28, Louis: "make the shower have all objects
	# in the dominant hand except one"), and that is how a shower is actually picked up:
	# the whole load in the throwing hand, one in the other to start the rhythm off. It is
	# also what the pattern IS - one hand does every high throw and the other only passes
	# back - so an even split was always the wrong opening position for it.
	if pattern == SHOWER:
		return other(dominant_hand) if i == 0 else dominant_hand
	return dominant_hand if i % 2 == 0 else other(dominant_hand)


func redeal_for_pattern() -> void:
	# SWITCHING TO A SHOWER RE-DEALS THE LOAD (2026-07-28 evening, Louis: "when i switch
	# from one pattern to shower, the objects should switch hands, right now it starts with
	# almost equal amounts in both hands, which is wrong").
	#
	# `deal_side` already knows a shower is dealt one-handed, but it only ever ran at
	# `start_run` - so the rule applied to an act BOOKED as a shower and not to one switched
	# into with P, which is how a player actually reaches it mid-practice. The opening
	# position is not decoration: under a shower the dominant hand makes every high throw and
	# the other only passes back, so starting with the load split evenly means the weak hand
	# spends the first half of the pattern feeding props it should never have been holding.
	#
	# Only props IN HANDS move. Anything already in the air keeps its own path and lands
	# where it was always going to - the same contract every other part of a live pattern
	# switch honours, and the reason this is safe to do mid-run at all.
	if pattern != SHOWER:
		return
	var d := dominant_hand
	var o := other(d)
	var held: Array[Ball] = []
	for b in stack(o):
		held.append(b)
	stack(o).clear()
	# ONE stays in the weak hand, and it must be one that was ALREADY there if possible:
	# a prop physically passes across, it does not teleport back. If the weak hand was
	# empty, the dominant hand gives one up instead.
	if held.is_empty():
		if stack(d).size() > 1:
			stack(o).append(stack(d).pop_back())
	else:
		stack(o).append(held.pop_back())
		for b2 in held:
			stack(d).append(b2)


func top_up_side(choices: Array = []) -> int:
	# where the NEXT prop joins hands that are ALREADY holding (a count change, a lesson
	# topping up after a drop). Same rule stated the other way round: the dominant hand
	# is never allowed to fall behind, so it takes the prop whenever the two are level.
	# `choices` narrows it to hands that are free to receive - a hand with something
	# already dropping into it must never be handed another (that was a forced drop).
	var d := dominant_hand
	var o := other(d)
	var ok_d := choices.is_empty() or choices.has(d)
	var ok_o := choices.is_empty() or choices.has(o)
	if ok_d and (not ok_o or stack(d).size() <= stack(o).size()):
		return d
	if ok_o:
		return o
	return -1


func take_from_side() -> int:
	# ...and which hand gives one UP when the count drops: the weak hand first, so the
	# dominant one keeps the odd prop all the way down the ladder
	var d := dominant_hand
	var o := other(d)
	if not stack(o).is_empty() and stack(o).size() >= stack(d).size():
		return o
	if not stack(d).is_empty():
		return d
	return o if not stack(o).is_empty() else -1


func atick() -> float:
	# one cosmetic clock that advances in EVERY state: tick runs during play,
	# cine_tick runs in menus and cutscenes, so their sum always moves. Scenery
	# animation (stars, dust, lanterns, marquee bulbs) keys off this, which lets
	# the same primitives breathe both in cutscenes and behind live play.
	return float(tick + cine_tick)


func stage_center() -> Vector2:
	# the juggling hand height: about the figure's waist on the eight-head canon, so
	# the hands scoop at a natural level and the arms keep a natural (canon) length
	var s := get_viewport_rect().size
	return Vector2(s.x * 0.5, s.y * 0.57)


func outer_pos(h: int) -> Vector2:
	# the catch position, a little in from a shoulder-and-a-half so the arms rest a touch
	# less splayed (Louis). Kept 46px out from inner_pos so the crossing weave still
	# clears (see inner_pos); pulling only this one in cramps the two roads into overlap.
	# The stance NEVER widens for props or counts (Louis: the wide arms looked
	# horrible) - big loads keep their clearance by shrinking the prop HITBOX
	# instead, the drawn prop staying its true size. See prop_hit_scale.
	var c := stage_center()
	return Vector2(c.x - HAND_OUT_DX, c.y) if h == LEFT else Vector2(c.x + HAND_OUT_DX, c.y)


func inner_pos(h: int) -> Vector2:
	# just outside the torso silhouette, so a carried ball never sits on the body.
	# outer_pos and this move IN TOGETHER (Louis wanted the arms a touch less splayed):
	# the crossing clearance depends on outer - inner (the two crossing balls peak
	# ~(outer - inner) apart), so shrinking both by the same amount narrows the whole
	# stance without pulling the crossing weave into an overlap.
	var c := stage_center()
	return Vector2(c.x - HAND_IN_DX, c.y) if h == LEFT else Vector2(c.x + HAND_IN_DX, c.y)


func slot_pos(h: int, slot: int) -> Vector2:
	match slot:
		HAND_INNER:
			return inner_pos(h)
		_:
			return outer_pos(h)


func shoulder_pos(h: int) -> Vector2:
	# where the arms leave the body: the outer corner of the jacket's shoulder, one
	# arm-root radius BELOW the shoulder line. The upper-arm capsule is ~19px thick,
	# so an attach point ON the line let half the deltoid peak above the silhouette
	# (Louis: shoulders belong at shoulder height, not over it).
	var s := get_viewport_rect().size
	var c := s.x * 0.5
	var H := s.y * 0.056
	var y := s.y * 0.80 - 6.38 * H
	var dx := 0.9 * H
	return Vector2(c - dx, y) if h == LEFT else Vector2(c + dx, y)


func columns_side_lanes() -> int:
	# how many columns ONE hand owns. On an odd count the centre column is the odd one
	# out and belongs to neither side, which is why this is a plain halving either way.
	return maxi(1, num_balls / 2)


func columns_step() -> float:
	# the gap between two of one hand's columns. The band it has to fit into is fixed
	# (COL_LANE_IN out to HAND_OUT_DX), so this falls like 1/count - deliberately the
	# same curve prop_hit_scale's hitbox falls on, which is what keeps the clearance
	# roughly constant instead of running out at the top of the count range. Capped at
	# COL_LANE_STEP so three or four objects keep the airy spread they always had.
	var m := columns_side_lanes()
	if m <= 1:
		return 0.0
	return minf(COL_LANE_STEP, (HAND_OUT_DX - COL_LANE_IN) / float(m - 1))


func columns_mid_slot() -> int:
	# the centre column's slot, or -1 at an even count where there is no centre column
	return (num_balls / 2) if num_balls % 2 == 1 else -1


func columns_x(slot: int) -> float:
	# the x of vertical column `slot` (0..num_balls-1). Every column is a line a HAND CAN
	# STAND ON: the set is centred in the band each hand can reach without splaying, so
	# it never grows past the stance however many objects are up (it used to be a fixed
	# 40px per column, which at seven objects already reached 120px past centre and at
	# fifteen reached 280 - the arms had to follow it out there).
	var c := stage_center().x
	var mid := columns_mid_slot()
	if slot == mid:
		return c   # the centre column: straight up the middle line, thrown from it too
	var m := columns_side_lanes()
	var step := columns_step()
	# centre the side's lanes in the band, so a hand that owns only two of them uses the
	# middle of its reach rather than being pinned to the inside edge
	var first := COL_LANE_IN + ((HAND_OUT_DX - COL_LANE_IN) - float(m - 1) * step) * 0.5
	var last_left := num_balls / 2 - 1
	var first_right := (mid + 1) if mid >= 0 else num_balls / 2
	if slot >= first_right:
		return c + first + float(slot - first_right) * step
	return c - (first + float(last_left - slot) * step)


func assign_lane(b: Ball, h: int) -> void:
	# give a lane ball its own column: the nearest free slot on its hand's side, filled
	# from the INSIDE out so both hands load their columns the same way round (the left
	# hand used to fill outside-in simply because it walked its slots in index order,
	# which left the two sides holding mirror-image halves of the pattern). Left hand
	# owns the left columns, right the right, the centre column (odd counts) belongs to
	# neither and is handed out by do_throw. Persists on the ball for the whole run.
	if b.lane_x >= 0.0:
		return
	var mid_slot := columns_mid_slot()
	var inner := num_balls / 2 - 1                                  # left, nearest centre
	var outer := 0                                                  # left, widest
	if h == RIGHT:
		inner = (mid_slot + 1) if mid_slot >= 0 else num_balls / 2
		outer = num_balls - 1
	var taken := {}
	for o in balls:
		if o != b and o.lane_x >= 0.0:
			taken[int(round(o.lane_x))] = true
	var stepdir := 1 if outer > inner else -1
	for i in num_balls:
		var slot := inner + i * stepdir
		if (stepdir > 0 and slot > outer) or (stepdir < 0 and slot < outer):
			break
		var x := columns_x(slot)
		if not taken.has(int(round(x))):
			b.lane_x = x
			return
	# NO TWO PROPS MAY SHARE A COLUMN - that is a head-on collision, not a near miss, so
	# the fallback is the CENTRE line rather than a lane that is already occupied (which
	# is what it used to be). Reachable when a mid-run pattern change lands more props in
	# one hand than that side has columns; the centre is the odd count's spare line, so
	# taking it also makes this ball the centre one, catchable by either hand.
	var cx := stage_center().x
	if not taken.has(int(round(cx))):
		b.lane_x = cx
		col_mid_ball = b
		return
	b.lane_x = columns_x(clampi(inner, 0, num_balls - 1))   # never leave it unset


func next_throw_over_top(h: int) -> bool:
	# whether hand h's NEXT throw is an over-the-top launch. This is its own KIND
	# of throw (Louis): no inward carry, the hand lobs straight from the OUTER
	# catch point, which is what keeps the high road clear of the low weave. Used
	# always (Reverse Cascade), for one throw (Overthrow), or back and forth
	# (Tennis's marked ball).
	# Mirrors the over_top decision in do_throw, read BEFORE the ball is popped.
	# (Overthrow used to claim this road for one primed throw; it was removed as a trick
	# because the patterns below ARE that road - see the note on TRICKS.)
	if pattern == RCASC:
		return true
	if pattern == TENNIS:
		if tennis_ball == null or not balls.has(tennis_ball):
			return true   # nothing marked yet: the very NEXT throw claims the mark
		return stack(h).has(tennis_ball)
	# the shower's and half shower's high hand ride the over-the-top road too
	return h == dominant_hand and pattern in [SHOWER, HALFSHOWER]


# the STRUCTURAL throw/catch point for hand h under the current pattern/trick -
# always safe to read live, since it reflects what the player has already
# committed to (the pattern, an active toggle), never a guess about a ball in
# flight. throw_slot is read every tick while h is holding (see hand_target);
# catch_slot only seeds the initial hand_catch_rest, since after that the actual
# CATCH point is locked in per-ball at throw time (do_throw), not re-derived here.
func throw_slot(h: int) -> int:
	if pattern == COLUMNS:
		# Columns rests at ONE point (Louis, ROADMAP 12b): the same slot it catches at,
		# so the hand holds still and only the vertical throw-kick moves it. It used to
		# throw from VERY_INNER and catch at INNER - two slots 34px apart, retargeted
		# every catch/throw, so the hand never settled and read as a tremor. The lane
		# ball flies to its own lane_x either way (do_throw's `lanes` branch, never the
		# hand slot), so the hand slot is purely where the sprite waits; INNER sits
		# closest to the actual lanes, so it also shrinks the hand/ball gap.
		return HAND_INNER
	return HAND_OUTER if next_throw_over_top(h) else HAND_INNER


func catch_slot(h: int) -> int:
	if pattern == COLUMNS:
		return HAND_INNER
	if next_throw_over_top(other(h)):
		return over_top_land_slot(h)
	return HAND_OUTER


# where an over-the-top throw COMES DOWN on hand t, and the one rule that keeps the high
# road clear of the low weave. Hand t has two fixed slots: OUTER (its normal catch,
# dx 100 - see outer_pos) and INNER (its normal throw, dx 54 - see inner_pos). An
# over-the-top landing must avoid whichever of the two t's OWN throw already uses,
# so it takes the other one (a third slot, VERY_INNER, existed once for an older
# Columns implementation - see throw_slot's own note - but is long gone now).
# A geometric guarantee, not a tuned gap, holding at any cadence and for patterns not yet
# written (Phase 5).
#
# This is the fix for the ROADMAP 12a regression and its follow-on. ddbd706 landed every
# over-the-top throw at INNER: the reverse cascade wanted that close crossing (both its
# hands ride the high road, launch from OUTER, so INNER was free) but a MIXED pattern's
# low hand LAUNCHES from INNER, so the landing sat on the launch - -14px Half Shower,
# -22px Shower, a launch and a landing on one pixel.
#
# So it lands on the complement of t's OWN launch slot: INNER when t launches from OUTER
# (reverse cascade, both hands high), OUTER when t launches from INNER (a low hand). A
# landing then never sits on a launch, which was the whole -14/-22px regression. Landing
# at OUTER also costs no extra reach - it is the hand's normal catch point, where it is
# already waiting.
#
# This picks the LANDING slot only. It cannot, by itself, keep a MIXED pattern's high
# road from sharing air with the low weave mid-flight: now that every path is a strict
# parabola (Louis - no sideways swerve to dodge with), an over-the-top ball and a low
# ball timed into the same corner simply cross there, exactly as two juggling balls do.
# Good timing keeps them from occupying that corner at the SAME instant (a real player,
# and the Phase 5 siteswap rework, throw on a rhythm that interleaves them); the naive
# alternating autoplayer does not, so --collcheck still reports crossings on Half
# Shower and Tennis. Those read as balls crossing, not as an impossible path, and the mid-air
# clack penalty only bites in hard mode - so this is left to the siteswap rework, which
# replaces this whole hand-picked geometry with a rhythm derived from the pattern.
func over_top_land_slot(t: int) -> int:
	return HAND_INNER if throw_slot(t) == HAND_OUTER else HAND_OUTER


# where hand h wants to be right now (Louis): while holding, wherever ITS OWN
# next throw departs from; once empty, exactly where the soonest ball flying its
# way will actually land (to_pos: the landing ring's spot), so the ring always
# draws centred on the waiting palm even when drift has nudged that landing a
# few px off the slot's nominal centre. With nothing inbound, the slot the last
# throw aimed at.
func hand_target(h: int) -> Vector2:
	var p: Vector2
	var inc: Ball = null
	for b in balls:
		if b.state == STATE_FLIGHT and b.to_hand == h:
			if inc == null or b.land_tick < inc.land_tick:
				inc = b
	# HOLDING MEANS INWARD, EMPTY MEANS OUTWARD, and nothing else gets a say (2026-07-27,
	# Louis: "the hand is already gone to catch, but hasn't thrown yet, making the throw
	# look weird"). A holding hand used to reach for an incoming prop's landing point as
	# soon as it was within 36 ticks - so in a throw-then-catch exchange, which is the
	# beat the whole beginner cascade is made of, the hand had already travelled out to
	# the catch slot while it was still holding the prop it had not thrown yet. The throw
	# then departed from a hand that was visibly in the wrong place.
	#
	# The rule is also what the lesson prompts have always said out loud - a hand with a
	# prop in it is asked to THROW, never to catch - so the picture and the instruction
	# finally agree. A hand can still catch into a held stack (that rescue is unchanged):
	# catching is decided by timing, never by where the hand is drawn.
	if not stack(h).is_empty():
		p = slot_pos(h, throw_slot(h))
		# COLUMNS: STAND UNDER THE COLUMN YOU ARE ABOUT TO THROW (2026-07-27, Louis:
		# "the columns pattern looks awful: the hands are wrongly placed, the objects do
		# strange things"). Both complaints were one mismatch. A lane ball flies straight
		# up and down its own `lane_x` (columns_x spreads them symmetrically about
		# centre), but a HOLDING hand was pinned to the fixed inner slot at 54px - and
		# the two were never made to agree. Measured: at 3 balls the gap is 10px, at 5
		# it is 34, at 7 it is 66. So the ball leapt sideways out of the hand on every
		# throw, and because a CATCHING hand does go to the lane (`inc.to_pos`, below)
		# the hand also snapped in and out sideways once per cycle - the "wrongly placed"
		# hand and the "strange" objects were the same bug seen from two ends.
		#
		# pop_front is what do_throw takes, so stack[0] is the next one out. A ball keeps
		# its lane for the whole run once assigned, so only its very first throw - before
		# it has a lane at all - falls back to the slot, which is a beat nobody sees.
		if pattern == COLUMNS and stack(h)[0].lane_x >= 0.0:
			p.x = stack(h)[0].lane_x
	else:
		p = inc.to_pos if inc != null else slot_pos(h, hand_catch_rest[h])
	# THE HAND GOES TO THE COLUMN, ALL THE WAY (2026-07-28). There used to be a floor
	# here (COL_HAND_MIN, 40px) keeping a Columns hand out of the torso, because the lane
	# layout could put a column inside the body - at four objects the inner lanes sat 22px
	# off centre - and a hand sent there vanished into the chest. The lane band starts
	# outside the torso by construction now (COL_LANE_IN), so the floor had nothing left
	# to protect and was doing active harm: it was the reason a ball leapt sideways out of
	# the hand on release. **If a column is ever allowed inside COL_LANE_IN again, this is
	# the guard that has to come back with it.** The one hand that does now come to the
	# centre line is the one throwing or catching the CENTRE column, which is a hand in
	# front of the shirt rather than in the chest, and where a real juggler's hand goes
	# for a centre toss - the arms are drawn over the coat, so it reads correctly.
	# a brief upward kick right after a throw sells the release
	var k := tick - int(throw_kick[h])
	if k >= 0 and k < 14:
		p.y -= 22.0 * (1.0 - float(k) / 14.0)
	return p


func ball_color(i: int) -> Color:
	var cols := [
		Color(1.0, 0.82, 0.35),
		Color(1.0, 0.55, 0.25),
		Color(0.95, 0.40, 0.42),
		Color(0.72, 0.86, 0.95),
	]
	return cols[i % cols.size()]


# -----------------------------------------------------------------------------
# Start: balls begin held, and the run begins on the player's first throw.
# -----------------------------------------------------------------------------

# the Strength each ball count asks for, indexed by count (3 is free). The first
# rungs sit in the old 0..100 band; 8-15 climb the raised band toward the 200 cap,
# so the late game keeps earning new loads long after the World Arena. 12-15 added
# 2026-07-18 (Louis, after the throw-height clamp made room for more objects):
# the last few rungs close in tight on STR_CAP, so 15 objects is earned at almost
# exactly a maxed Strength stat, not before it.
# EVENLY SPACED (2026-07-27, Louis: "strength's nr of props that unlock isn't evenly
# spread... right now it looks bad on the stat menu"). It ran 9, 15, 23, 33, 60, 90,
# 125, 165, 175, 183, 191, 200 - four gates crammed into the bottom fifth, a canyon
# through the middle, then four more crammed into the top - which as a row of pips was
# unreadable and as a curve was three different games. Twelve counts across 200 points
# is one step of 16.7, so every count is the same distance of work from the last, and
# the track finally says what it means: this is how far another prop costs, always.
const BALL_GATES := {4: 16, 5: 33, 6: 50, 7: 66, 8: 83, 9: 100, 10: 116, 11: 133, 12: 150, 13: 166, 14: 183, 15: 200}


func max_balls() -> int:
	# THREE to start; every larger load is earned through Strength, each landing a bit
	# before the stage that leans on it (Louis). Four is the first unlock now, not free.
	var m := 3
	for n in range(4, MAX_BALLS_HARD + 1):
		if strength >= int(BALL_GATES[n]):
			m = n
	return m


func next_ball_strength() -> int:
	# Strength needed for the next ball unlock, or 0 if already at the cap
	for n in range(4, MAX_BALLS_HARD + 1):
		if strength < int(BALL_GATES[n]):
			return int(BALL_GATES[n])
	return 0


func count_air_scale() -> float:
	# the tap-height FLOOR scales with the load: 3-4 balls stay snappy and low, but five
	# and up must fly higher just to have air to weave in, so even a tap lofts a big load
	# enough to juggle. ~+45% airtime at six matches a real six-ball fountain's hold; the
	# 8-15 late-game loads keep climbing the same curve.
	if num_balls >= 5:
		return 1.3 + 0.15 * float(num_balls - 5)
	return 1.0


#endregion

#region ROUND START, CATCHING, GOALS
func start_run(n: int) -> void:
	if not available(prop_type):
		prop_type = PROP_BALLS   # not enough of that prop owned: fall back to balls
	# you cannot juggle more of a prop than you own (balls are unlimited)
	var cap := mini(max_balls(), have(prop_type))
	num_balls = clampi(n, MIN_BALLS, maxi(MIN_BALLS, cap))
	# the chosen pattern, snapped to what this level owns. Cascade needs no ball-
	# count match any more (it crosses odd, keeps each hand its own ball even, so
	# any count works); an explicitly chosen exotic pattern sticks whatever the count.
	if not pattern_unlocked(pattern_sel):
		pattern_sel = CASCADE
	pattern = pattern_sel
	# a Skills-screen practice runs its chosen pattern for THIS session without
	# re-booking the act: P (cycle_pattern) clears the override, an explicit choice.
	if pattern_once >= 0 and pattern_unlocked(pattern_once):
		pattern = pattern_once
	balls.clear()
	_stack_l.clear()
	_stack_r.clear()
	popups.clear()
	charging = [false, false]
	applause = 0.7
	peak_applause = 0.7
	score = 0.0
	banked_pts = 0.0
	run_pts = 0.0
	run_mult = 1.0
	chain = 0
	streak = 0
	best_streak = 0
	dropped = 0
	caught = 0
	# per-ACT state re-arms every run (the challenge roll is owned by
	# begin_performance, so practice and a dev autoplay never carry one)
	goals_hit = 0
	set_collapsed = false
	fail_reason = ""   # a fresh act has not failed yet
	running = false
	started = false
	stamina_max = 100.0 + 9.0 * float(endurance)
	# stamina PERSISTS through the day now: only sleep (or a meal) restores it, so
	# a third booking in one evening is genuinely tired work. Dev auto-runs top up
	# so screenshots stay comparable.
	if _demo or _shot or debug_mode:
		stamina = stamina_max
	stamina = clampf(stamina, 0.0, stamina_max)
	run_xp = 0
	last_pay = 0
	last_rep_delta = 0
	run_venue = play_venue()   # records and the results card key off where you performed
	results_open = false
	results_record = false
	results_tick = -999
	results_stamped = false
	record_broken = false
	last_streak_tick = -999
	freeze = 0
	parts.clear()
	thrown.clear()      # a fresh act starts on clean boards: nothing at the feet yet
	tomato_stains.clear()   # ...and a clean costume, whatever last night did to it
	_pile_pts.clear()   # ...and the baked pile goes with it, or last night's flowers
	_pile_cols.clear()  # would still be drawn under this one's feet
	_pile_idx.clear()
	_pile_bake_tick = -1000000
	_pile_dirty = true
	run_flowers = 0
	run_tomatoes = 0
	paused = false
	round_scored = false
	_prev_running = false
	# reset the per-run trick state. The SELECTION survives between runs (that is
	# the promise of the powerup model), and so does a RUNNING TOGGLE (Louis: an R
	# retry keeps the trick on, so it can be drilled run after run) - only its
	# per-run bookkeeping (the marked tennis ball, the lane reference) re-arms.
	# Snap both onto tricks this level actually owns, so a debug level change can
	# never leave a locked trick loaded or running.
	trick_primed = false
	if toggle_on >= 0 and not trick_unlocked(toggle_on):
		toggle_on = -1
	toggle_scored = false
	tennis_ball = null
	col_air_ref = -1.0
	col_mid_ball = null
	if trick_sel < 0 or not trick_unlocked(trick_sel):
		var un := unlocked_tricks()
		trick_sel = int(un[0]) if not un.is_empty() else -1
	trick_ready = -999
	spin_until = -999
	spin_scored = false
	tricks_landed = 0
	trick_score = 0
	trick_msg = ""
	trick_msg_tick = -999
	rng.seed = 20260705
	seed_input_edges()   # a key still held from the previous screen must not edge-fire
	collapsing = false
	falling.clear()
	# slow motion: the earned bursts reset per run (the pie keeps working all
	# day, so pie_active is untouched here and only sleep clears it)
	perfect_chain = 0
	amazing_until = -999999
	chain_until = -999999
	_slow_cur = 0.0
	_tick_acc = 1.0
	hpos = [outer_pos(LEFT), outer_pos(RIGHT)]
	hand_catch_rest = [catch_slot(LEFT), catch_slot(RIGHT)]
	hclose = [0.0, 0.0]
	catch_flash = [-999, -999]
	throw_kick = [-999, -999]

	# the deal, through the one shared rule (see deal_side): the dominant hand takes the
	# odd prop and throws first
	for i in num_balls:
		var b := Ball.new()
		b.state = STATE_HAND
		b.kind = prop_type
		b.color = ball_color(i) if prop_type == PROP_BALLS else prop_color(prop_type)
		b.spin_dir = 1.0 if i % 2 == 0 else -1.0
		balls.append(b)
		stack(deal_side(i)).append(b)
	# THE CENTRE COLUMN IS DEALT, not claimed by whoever threw first (2026-07-28). Two
	# reasons. It has to be the DOMINANT hand's, because on an odd count that hand holds
	# one more prop than its side of the stage has columns - the count only works out if
	# its extra one is the centre - and when the other hand claimed it instead, the
	# dominant hand ran out of lanes and assign_lane's fallback put TWO props in one
	# column, which is a head-on collision by construction. And knowing it up front means
	# its very first throw already leaves the centre line, instead of the one-off sideways
	# hop it used to make from the hand's resting slot.
	if pattern == COLUMNS and num_balls % 2 == 1 and not stack(dominant_hand).is_empty():
		col_mid_ball = stack(dominant_hand)[0]
		col_mid_ball.lane_x = stage_center().x
	_demo_next = dominant_hand


# -----------------------------------------------------------------------------
# Catch: strict. Window = secure (quality band). Committed-but-mistimed = drop.
# Nothing near = whiff (small poise wobble, no ball lost).
# -----------------------------------------------------------------------------

func on_catch(h: int) -> void:
	# YOU CANNOT CATCH WHILE YOU TURN (2026-07-29, Louis: "make it impossible to catch or throw
	# while spinning"). This is what replaced the cooldown, and it is a better limiter for a
	# reason worth stating: a cooldown is a RULE the game imposes, while the lockout is a COST
	# the player pays out of the same resource the pattern already spends - airtime. At three
	# balls a 44-tick blind spot is nothing; at fifteen it is three missed catches and
	# therefore three drops. The prop count polices the Spin by itself, and buying the airtime
	# to survive one (a High Toss first) becomes real play rather than a timer.
	if spinning() and not tut_active:
		return
	if collapsing:
		return  # the act has fallen apart: you watch it all come down, you cannot save it.
				# Without this a player (or the autoplayer) could keep catching the still-
				# airborne props after the crowd walked, grinding score with the clock off.
	var sure := false
	if tut_holding():
		if not tut_hold_names("catch", h):
			return  # a frozen beat hears only what it asked for, and in the order it asked:
					# a catch key pressed before the throw that makes room is not a whiff,
					# it is simply not the ask yet
		# a catch the guided beat itself asked for MUST land (Louis: "when he does, the
		# game continues, with a successful catch executed of course"). Every way this
		# function can lose a prop below is skipped for it: the beat froze the world at
		# the prop's own arrival, so the timing is already Perfect, and being failed by
		# a stamina bar or a chance roll on a press the script demanded teaches nothing.
		sure = true
	# a hand that already HOLDS a ball may still catch (Louis): the stack takes
	# another. The old "hand occupied, no catch" traffic rule is gone - traffic
	# is now the player's own problem, and holding two is a legitimate rescue.
	var best: Ball = null
	var best_d := 1000000
	for b in balls:
		# the odd-columns middle ball comes straight down dead centre and EITHER
		# hand may scoop it (Louis), so it counts for whichever catch fires first;
		# every other ball is claimed only by the hand it is actually flying to
		if b.state == STATE_FLIGHT and (b.to_hand == h or b == col_mid_ball):
			var d := absi(b.land_tick - tick)
			if d < best_d:
				best = b
				best_d = d
	if best == null or best_d > COMMIT:
		if sure:
			tut_hold_abort()   # the beat asked for a catch and there is nothing to catch:
			return             # let the world go rather than freeze on an impossible ask
		# reached for empty air: a whiff. Discourage mashing with a small wobble.
		applause = maxf(0.0, applause + APPL_WHIFF)
		catch_flash[h] = tick
		hclose[h] = 0.0
		add_popup(outer_pos(h), "whiff", Color(0.7, 0.66, 0.6, 1.0))
		play_sfx("whiff", -12.0)
		return
	if best_d > W_LATE and not sure:
		# way off the arrival: a genuine mistime, the ball drops
		drop_ball(best, "MISTIME")
		return
	# out of stamina: your hands simply cannot close (Louis). A well-timed arrival that
	# would otherwise be caught slips through, which soon trips the drop limit and ends
	# the set - see the exhaustion redirect in drop_ball, straight to eat/sleep.
	if stamina <= 0.0 and not sure:
		drop_ball(best, "SPENT")
		return
	# hard mode (set_collide): a ball that clacked another mid-air only catches
	# on PERFECT timing - the full Perfect window (Louis: same frames as normal,
	# not halved), but the Good/Late chance roll never applies. Saving one still
	# counts as the Perfect it timing-wise is.
	if best.bumped and best_d > perfect_window() and not sure:
		drop_ball(best, "collided")
		return
	# Perfect timing always secures. A Good or Late catch is a chance that rises
	# with Accuracy and falls with how far off the standard height the throw was.
	# The Perfect window itself shrinks for off-standard throws (Focus widens it),
	# so a wrong-height throw is hard to catch cleanly and easy to lose.
	var wperf := perfect_window()
	if best_d > wperf and not sure:
		# The Gale: the wind gives a Good or Late catch no chance at all - the
		# roll below never runs, so only a genuine Perfect ever lands tonight
		if encore_on("gale"):
			drop_ball(best, "gale")
			return
		var quality := 1 if best_d <= W_GOOD else 2
		if rng.randf() > catch_chance(quality, best.height):
			drop_ball(best, "slip")
			return
	# secured. Was the act actually RUNNING as this landed, or did the air just empty?
	# (Louis: juggling is at least one prop airborne at all times; anything else is
	# throwing one thing and catching it). Asked here, before the ball is put away.
	var juggled := juggling_catch(best)
	# harder patterns AND harder loads pay more per catch (their base difficulty is the
	# reward), so grinding the tamest routine is never the best. encore_score_mult zeroes
	# light props on a "For the Danger" night.
	# COSTUME_SET_BONUS joins the multiplier here rather than anywhere else, because this is
	# the one place every scoring path already passes through - and because dressing for the
	# house is exactly the kind of preparation that should pay per catch rather than once.
	var pm := pattern_mult() * object_mult() * encore_score_mult() * costume_set_bonus()
	best.state = STATE_HAND
	stack(h).append(best)
	catch_flash[h] = tick
	caught += 1
	career["catches"] = int(career["catches"]) + 1
	if tut_active:
		tut_hold_mark("catch", h)   # the beat's catch has landed; the world may move again
		tut_on_catch(juggled)   # a guided lesson counts your clean catches toward its goal
	spend_stamina(STAM_DRAIN_CATCH * energy_mult() * (1.0 + WEIGHT_STAM * float(prop_weight(best.kind) - 1)))
	# NO per-prop catch texture here (Louis, 2026-07-18: only perfect/good/late/
	# whiff, never a special sound per object) - it used to be
	# `play_sfx(_catch_sound(best.kind), -20.0)` right here. The sounds themselves
	# are still generated in gen_sfx if this ever wants to come back.
	var cashing_in := false
	if not juggled and not tut_active:
		# NOT JUGGLING (juggling_catch): the air is bare behind this catch. On stage
		# with a goal already reached, that IS the cash-in gesture (Louis): you caught
		# every ball, you are holding them all, the act ends right here on your own
		# terms - same as the finish key, and the crowd reads the stillness as the bow.
		# It is still a REAL catch (Louis: it should show its Perfect/Good/Late and
		# play the same sound as any other), so this falls through to the normal
		# scoring below instead of returning early; `cashing_in` fires the actual
		# finish only at the very end, after that scoring has happened.
		if mode == MODE_PERFORM and booking_active and goals_hit >= 1 \
				and running and not collapsing and balls_airborne() == 0:
			add_popup(outer_pos(h) + Vector2(0, -30), "CAUGHT THEM ALL", Color(1.0, 0.86, 0.42))
			cashing_in = true
		else:
			# otherwise: the player threw one prop and caught it again while the rest sat
			# in their hands, or simply finished catching everything with the air now
			# bare and no goal reached yet to cash in on. The catch is real - it
			# happened, it cost stamina, it keeps the prop off the floor - but the ACT
			# is not running (or no goal is banked), so it earns nothing at all: no
			# streak, no score, no crowd, no trick, and no popup calling it out. That
			# shuts the grind where holding two and pumping the third farmed a clean
			# Perfect every single time. It still gets its catch-quality SOUND, though
			# (Louis: catching the last object was going completely silent, which reads
			# as broken even when the silence on everything else is deliberate) -
			# a sound is not a score, so it costs the anti-farm rule nothing.
			if best_d <= wperf:
				play_sfx("perfect", -5.0)
			elif best_d <= W_GOOD:
				play_sfx("good", -8.0)
			else:
				play_sfx("late", -11.0)
			streak = 0
			perfect_chain = 0
			return
	if best_d <= wperf:
		streak += 1
		best_streak = maxi(best_streak, streak)
		last_streak_tick = tick
		chain += 1
		add_run_pts(CATCH_PTS * chain_mult() * pm)
		warm_room(APPL_PERFECT + prop_thrill())   # danger thrills the room
		add_xp(3)
		# the slow-motion earn, only when a REAL pattern is up (three props or
		# more, so two lazy balls cannot farm it): a FRAME-perfect catch is an
		# Amazing! burst, and FIFTY straight Perfects buy thirty seconds of thick
		# time, after which the count starts over for the next thirty
		if num_balls >= SLOW_MIN_BALLS:
			perfect_chain += 1
			if best_d == 0:
				amazing_until = _frames + AMAZING_FRAMES
				add_popup(outer_pos(h) + Vector2(0, -52), "AMAZING!", Color(0.75, 0.92, 1.0))
			if perfect_chain >= CHAIN_NEED:
				perfect_chain = 0
				chain_until = _frames + CHAIN_FRAMES
				add_popup(Vector2(get_viewport_rect().size.x * 0.5, get_viewport_rect().size.y * 0.30), "FIFTY PERFECT  -  thirty seconds of thick time", Color(0.75, 0.92, 1.0))
				play_sfx("record", -8.0)
		add_popup(outer_pos(h), "PERFECT", Color(1.0, 0.86, 0.42))
		play_sfx("perfect", -5.0)
		spawn_parts(outer_pos(h), Color(1.0, 0.88, 0.45), 9, 3.4, "spark")
		spawn_parts(outer_pos(h), Color(1.0, 0.9, 0.6), 1, 0.0, "ring")
		if streak % 10 == 0:
			# a milestone: a beat of hit-stop, a shock ring, a toast, the crowd lifts -
			# scaled by tier (Still open: "Escalating streak feedback") so streak 200
			# reads as a bigger deal than streak 10, not the identical beat forever.
			# Every 50 steps it up, every 100 is the biggest, adding a confetti burst
			# via spawn_parts's existing "confetti" kind (already built for the
			# results/unlock celebrations) rather than a new effect. Reduce Motion cuts
			# the hit-stop to a single tick (the ring/confetti counts already thin inside
			# spawn_parts), so the milestone still registers without the jolt.
			var streak_tier := 2 if streak % 100 == 0 else (1 if streak % 50 == 0 else 0)
			freeze = 1 if reduce_motion else 4 + streak_tier * 2
			spawn_parts(outer_pos(h), Color(1.0, 0.82, 0.4), 2 + streak_tier, 0.0, "ring")
			var vs := get_viewport_rect().size
			add_popup(Vector2(vs.x * 0.5, vs.y * 0.33), "x%d STREAK" % streak, Color(1.0, 0.82, 0.4))
			if streak_tier >= 1:
				spawn_parts(Vector2(vs.x * 0.5, vs.y * 0.16), Color(1.0, 0.85, 0.45), 12 + streak_tier * 10, 2.4, "confetti")
			if mode == MODE_PERFORM:
				play_sfx("cheer", -11.0)
		elif streak % 5 == 0:
			play_sfx("streak", -7.0)   # a rising flourish at every fifth in a row
	elif best_d <= W_GOOD:
		perfect_chain = 0
		streak += 1
		best_streak = maxi(best_streak, streak)
		last_streak_tick = tick
		# The Critic: nothing short of a Perfect pays - everything else about a
		# Good/Late catch (streak, applause, XP, the popup itself) is untouched,
		# only the score line is gated, same choke point "fire"/For the Danger uses
		# A GOOD CATCH RESETS THE CHAIN (Louis: "good catches reset the counter and that
		# weighs hard"). It still scores - it was a catch - but at a quarter rate and with the
		# linear multiplier back to nothing, which is what makes an all-Perfect act worth so
		# many times a merely clean one.
		chain = 0
		if not encore_on("critic"):
			add_run_pts(CATCH_PTS_GOOD * pm)
		warm_room(APPL_GOOD)
		add_xp(2)
		add_popup(outer_pos(h), "GOOD", Color(0.78, 0.92, 0.6))
		play_sfx("good", -8.0)
		spawn_parts(outer_pos(h), Color(0.85, 0.92, 0.6), 4, 2.4, "spark")
		if streak % 5 == 0:
			play_sfx("streak", -8.0)
	else:
		streak = 0
		perfect_chain = 0
		chain = 0
		if not encore_on("critic"):
			add_run_pts(10.0 * pm)
		applause = maxf(0.0, applause + APPL_LATE)
		add_xp(1)
		add_popup(outer_pos(h), "late", Color(0.95, 0.62, 0.4))
		play_sfx("late", -11.0)
	# the record chase: passing your own best AT this venue mid-act is a moment. The
	# act is one continuous run now, so its live score IS the number the record
	# board will judge.
	if mode == MODE_PERFORM and not record_broken and run_venue >= 0 and run_venue < rec_table().size() \
			and rec_table()[run_venue] > 0.0 and score > rec_table()[run_venue]:
		record_broken = true
		var s := get_viewport_rect().size
		add_popup(Vector2(s.x * 0.5, s.y * 0.27), "NEW RECORD!", Color(1.0, 0.86, 0.42))
		play_sfx("record", -7.0)
		spawn_parts(Vector2(s.x * 0.5, s.y * 0.16), Color(1.0, 0.85, 0.45), 26, 2.6, "confetti")

	# (A Spin no longer doubles individual catches. It multiplies the whole RUN the moment it
	# fires - see on_trick - which is both a far bigger reward and the thing that makes the
	# exponential exponential. Doubling catches on top would have been the same bonus paid
	# twice, and it is the mechanic the lockout replaced.)
	# an ARM trick (High Toss / Behind the Back) pays its flourish on a clean catch
	if best.trick >= 0 and best_d <= W_GOOD:
		reward_trick(best.trick, outer_pos(h), best.height)
	# THE ACT: this catch (with any trick bonus above) may carry the score across the
	# next goal, which arms - or re-arms - the cash-in
	if booking_active and mode == MODE_PERFORM and not tut_active:
		check_goals()
	if cashing_in:
		finish_performance()   # only now, after the catch has scored like any other


func check_goals() -> void:
	# the instant the score crosses a goal it LOCKS (goals_hit is monotonic: a
	# collapse later can strip score, never a goal already reached). Each crossing
	# is announced by name, and from the first one on the HUD holds the cash-in
	# offer open: bow out with the finish key, catch everything and hold, or push
	# for the next number and risk the collapse.
	if not booking_active or mode != MODE_PERFORM or tut_active:
		return
	while goals_hit < NUM_GOALS and score >= goal_for(run_venue, goals_hit) \
			and goal_clock_open(goals_hit):
		goals_hit += 1
		var s := get_viewport_rect().size
		var names := ["FIRST GOAL", "SECOND GOAL", "FINAL GOAL"]
		var txt := "%s  -  cash in any time, or push on" % names[clampi(goals_hit - 1, 0, 2)]
		if goals_hit >= NUM_GOALS:
			txt = "FINAL GOAL  -  the night is yours. Cash in, or chase the record"
		add_popup(Vector2(s.x * 0.5, s.y * 0.24), txt, Color(1.0, 0.86, 0.42))
		play_sfx("cheer", -5.0)
		# A GOAL IS PAID IN FLOWERS, ONE FROM EACH SIDE (2026-07-29, Louis: "subgoals should
		# flower small flowers, one on each side"). The room already throws on its own beat
		# when it is pleased; this is the room answering a MOMENT, which is a different thing
		# and reads as one because it is symmetrical - two stems arriving together from
		# opposite wings is a gesture, where one more stem in the drift is just weather.
		# Deliberately tier 0, the plain flower: the goal is the reward, not the tribute.
		throw_from_crowd("flower", 0, -1.0)
		throw_from_crowd("flower", 0, 1.0)
		play_sfx("record", -8.0)
		spawn_parts(Vector2(s.x * 0.5, s.y * 0.16), Color(1.0, 0.85, 0.45), 22, 2.5, "confetti")


# -----------------------------------------------------------------------------
# Throw: charge on THROW down-edge, launch on release. Longer hold = higher and
# less accurate. Height buys airtime (thins traffic) at the cost of a harder catch.
# -----------------------------------------------------------------------------

#endregion

#region THROWING
func on_throw_press(h: int) -> void:
	if spinning() and not tut_active:
		return   # ...and no throwing either, for the same reason - see on_catch
	if collapsing or stack(h).is_empty():
		return   # nothing you throw during a collapse counts; the set is already over
	if tut_holding():
		# a frozen beat throws on the PRESS, not the release: with the clock stopped
		# there is no time to hold the key THROUGH, so hold-for-height cannot be read
		# and the guided throw is always the snappy tap the drill is teaching. A press
		# the beat did not ask for is swallowed whole - never a throw out of sequence.
		if tut_hold_names("throw", h):
			do_throw(h, 0)   # do_throw calls tut_on_throw, which banks it on the beat
		return
	charging[h] = true
	charge_start[h] = tick


func on_throw_release(h: int) -> void:
	if not charging[h]:
		return
	charging[h] = false
	if stack(h).is_empty():
		return
	var hold := clampi(tick - int(charge_start[h]), 0, HOLD_MAX)
	do_throw(h, hold)


func do_throw(h: int, hold: int) -> void:
	if collapsing or stack(h).is_empty():
		return
	var b: Ball = stack(h).pop_front()
	b.trail = PackedVector2Array()
	b.bumped = false   # a fresh throw starts clean; only a NEW mid-air clack marks it
	b.flat = false     # ...and every throw re-decides whether it is a pass or a throw. A
					   # prop that fed once would otherwise stay flat for the rest of the
					   # run, and its next HIGH throw would come out as a flat one
	b.thrown_from = h
	var weight := prop_weight()
	var deficit := prop_deficit()   # >0 when too weak for this prop: lower and wilder
	# A tap is the LOWEST, snappiest throw; each tick of hold adds airtime. Height is set by
	# how long you hold, NOT by Strength: raw muscle must never loft a throw higher (a higher
	# throw is a wilder throw, so tying Strength to height wrongly punished the strong).
	# Strength ONLY matters when you are UNDER a prop's Required Strength: then the whole
	# throw sags (the ideas.rtf rule) with a lower tap floor (DEFICIT_BASE) AND a lower
	# ceiling (DEFICIT_HEIGHT), so a too-heavy prop never gets up to a clean height.
	# higher loads must fly HIGHER just to have time to weave (Louis): a 5/6/7 fountain
	# thrown at the 3-ball tap height comes back down before the hand can clear its other
	# props, so everything drops at once and it felt unthrowable. Airtime rises with the
	# count, so the tap FLOOR does too - a tap already lofts a big load enough to juggle.
	var base_air := float(BASE_AIR) * count_air_scale() * (1.0 - DEFICIT_BASE * deficit)
	var gain_mult := 1.0 - DEFICIT_HEIGHT * deficit
	# SURPLUS Strength over a heavy prop's requirement lofts it HIGHER per held
	# tick, scaled by weight (Louis: five clubs need real height to fit in the
	# air). Balls and eggs are untouched, and being under-strength still sags.
	if prop_req() > 0 and weight > 1 and deficit <= 0.0:
		gain_mult *= 1.0 + STRENGTH_LOFT * strength_surplus() * float(weight - 1) / 4.0
	var air := int(round(base_air + HOLD_GAIN * gain_mult * float(hold)))

	# a primed one-shot (Overthrow) reshapes this ONE throw; consuming the prime here
	# disarms it, while trick_sel keeps the selection for the next Space press. The
	# FLOURISH TOGGLES (High Toss, Behind the Back) shape EVERY throw while they run
	# (Louis: switch on, throw, switch off for a single one - that way the trick can
	# be trained continuously). A trick's forced height is built off the SAME lowered
	# base and Strength penalty, so an under-strength High Toss sags too and cannot
	# cheat the sagging rule.
	# AN ARMED ONE-SHOT AND A RUNNING TOGGLE ARE NOT THE SAME THING, and three guards below
	# had been treating them as one (2026-07-28 evening, found by auditing every
	# pattern x trick combination Louis asked about). They all read `this_trick`, which was
	# fine while the only way to set it WITHOUT a toggle was Overthrow: the guards exist so
	# that an armed one-shot - a throw the player spent a press on, which pays a flat bonus
	# when caught - can never be flattened by a pattern into a low pass that collects the
	# full bonus anyway. That is a real exploit and the guards are right about it.
	#
	# But a TOGGLE is on for EVERY throw, so the same guard turns "do not flatten this one
	# special throw" into "this pattern's low road does not exist while the toggle runs".
	# Measured at five clubs: High Toss under a Shower went from +18.6px of clearance to
	# **-5.7**, and under a Half Shower from +28.3 to +4.2, because both roads were being
	# sent high and the pattern is *defined* by having two roads at different heights.
	# Columns lost its lane-height sync entirely for the same reason.
	#
	# So `armed_trick` is the one an exploit could ride, and `this_trick` stays what shapes
	# the throw. Nothing about the exploit protection changes; it just stops firing for a
	# case that cannot exploit anything.
	var this_trick := -1
	var armed_trick := -1
	if trick_primed and trick_sel >= 0 and String(TRICKS[trick_sel]["kind"]) == "arm":
		this_trick = trick_sel
		armed_trick = trick_sel
		trick_primed = false
	elif toggle_on == TR_HIGH or toggle_on == TR_BTB:
		this_trick = toggle_on
	if this_trick == TR_HIGH or this_trick == TR_BTB:
		var tfrac := clampf(float(air - BASE_AIR) / (HOLD_GAIN * float(HOLD_MAX)), 0.0, 1.4)
		if this_trick == TR_HIGH:
			# a TAP already powers the toss sky high; HOLDING the throw powers it
			# further, up to 1.8 at a full hold - high enough to leave the frame for
			# a beat (a top-edge marker tracks it, see draw_balls_in_flight). The
			# extra height keeps its honest cost: the landing spreads wider and the
			# arrival gets less certain (height feeds drift/wobble/jitter below),
			# while the catch-chance penalty saturates at the 1.4 cap.
			tfrac = 1.35 + 0.45 * minf(tfrac, 1.0)
		else:
			tfrac = clampf(tfrac + 0.12, 0.0, 1.4)   # a touch higher to clear the arc behind the back
		air = int(round(base_air + tfrac * HOLD_GAIN * float(HOLD_MAX) * (1.0 - DEFICIT_HEIGHT * deficit)))
	# the pattern shapes the throw: a shower's feed hand snaps a fast low pass no
	# matter the hold. An ARMED ONE-SHOT (this_trick >= 0 here) always wins its
	# one throw: the player paid a press for it, so no pattern may flatten it
	# into a low pass that would still collect the trick's full bonus on the
	# catch (the shower feed used to do exactly that, a quiet 260-a-catch exploit).
	# THE FEED IS A PASS, NOT A THROW (2026-07-28, Louis: "a very low (-80% lower than
	# the shower before) arc for non domi to dominant hand ... the height should be
	# almost zero"). Its AIRTIME is untouched, because that is the rhythm of the pattern
	# and he has already played it and called it fine - only the arc is flattened, which
	# is the one thing in flight that can be moved without moving the timing with it.
	if pattern == SHOWER and h == other(dominant_hand) and armed_trick < 0:
		air = int(round(base_air * SHOWER_FEED))
		b.flat = true
	# the PATTERN shapes every throw (there is exactly one pattern at a time now -
	# Louis - so Reverse Cascade and Tennis reshape here as patterns, never as
	# trick toggles), and Overthrow (a one-shot) sends this single throw up and
	# over the top of whatever pattern runs. Pattern throws are NOT tagged
	# as tricks: the pattern's own score mult is its reward.
	# The SHOWER's and HALF SHOWER's high hand ride the same over-the-top road
	# (that is what those patterns ARE), so they inherit the outer launch, the
	# wide landing, and the corner dodge in one mechanic.
	var over_top := false
	if h == dominant_hand and pattern in [SHOWER, HALFSHOWER]:
		over_top = true
	elif pattern == RCASC:
		over_top = true
	elif pattern == TENNIS:
		if tennis_ball == null or not balls.has(tennis_ball):
			tennis_ball = b   # the marked ball: the first one thrown under the pattern
		if b == tennis_ball:
			over_top = true
	if pattern == HALFSHOWER and h == other(dominant_hand) and armed_trick < 0:
		# the weave side is capped LOW (a ceiling, not a floor), so it visibly stays clear
		# of the over-the-top road instead of drifting up to meet it. The cap is a
		# FRACTION OF THE TAP, not the tap plus a bit - see HALFSHOWER_LOW for why that
		# distinction is the whole fix at high counts.
		air = mini(air, int(round(base_air * HALFSHOWER_LOW)))
	if over_top:
		var high_min := OVER_TOP_MIN
		if h == dominant_hand and pattern == SHOWER:
			high_min = maxf(high_min, SHOWER_MIN)
		elif h == dominant_hand and pattern == HALFSHOWER:
			high_min = maxf(high_min, HALFSHOWER_MIN)
		elif pattern == TENNIS:
			# the marked prop is the only one crossing OVER a full weave rather than over
			# one road, so it gets the extra 20% Louis asked for to clear it cleanly
			high_min = maxf(high_min, TENNIS_MIN)
		air = maxi(air, int(round(base_air + high_min * HOLD_GAIN * gain_mult * float(HOLD_MAX))))
	# Columns (the pattern or the toggle trick) pulls this throw's airtime toward the
	# lanes' running height, so a slightly early or late release still lands close to
	# the others instead of drifting the apexes apart (Louis: mismatched heights made
	# the catch timing unreadable). Breakout throws are exempt: an over_top throw and
	# an armed one-shot (High Toss, Behind the Back) are meant to stand out, not blend
	# in - and neither may drag the lanes' reference height up after itself.
	var col_lanes := pattern == COLUMNS
	if col_lanes and not over_top and armed_trick < 0:
		if col_air_ref < 0.0:
			col_air_ref = float(air)
		else:
			air = int(round(lerp(float(air), col_air_ref, COLUMNS_SYNC)))
		col_air_ref = lerp(col_air_ref, float(air), 0.5)
	# frac is the height ACTUALLY reached (measured off the full-strength tap floor), so a
	# sagging under-strength throw reads as the low throw it is: easier to catch, worth less
	# Applause, and it clamps to 0 when the prop is too heavy to loft at all. The ceiling is
	# 1.8, reserved for a TRICK (only a held High Toss actually reaches it) - plain throws
	# clamp at 1.4. This clamp is EXPLICIT now (2026-07-18): count_air_scale (high ball
	# counts fly higher) and the Strength-surplus loft bonus (a heavy prop you're well
	# over-strength for flies higher too) both push air time up independently, and at
	# their extreme - maxed Strength, the heaviest prop, the highest count - they used to
	# stack past 1.4 on an ordinary throw with no trick at all (measured: a PLAIN full-hold
	# torch throw at 7 objects and max Strength hit 1.8, the trick-only ceiling, and even a
	# bare TAP already reached 0.6). Louis noticed this as "why do Behind the Back throws
	# with 7 torches go so high" - BTB was not the actual cause, just the visible symptom;
	# every plain throw at that combination was already pinned near the ceiling.
	var frac := clampf(float(air - BASE_AIR) / (HOLD_GAIN * float(HOLD_MAX)), 0.0, 1.8 if this_trick >= 0 else 1.4)
	b.height = frac
	b.trick = this_trick

	# Accuracy (dampened by low stamina) sets the base inaccuracy; being UNDER a prop's
	# Required Strength widens it. Weight alone does NOT: a heavy prop you are strong enough
	# for throws just as cleanly as a ball (only low Strength makes a heavy prop wild).
	# Inaccuracy normally scales with the throw's HEIGHT, so a low throw is placed cleanly.
	# But an under-strength RELEASE is itself unsteady, so a "spread floor" keyed to the
	# deficit keeps even a low under-strength throw drifting and wobbling, otherwise a weak
	# juggler could just tap heavy rings low and place them perfectly, which felt wrong.
	var inacc := inacc_factor() * (1.0 + DEFICIT_INACC * deficit)
	var spread := maxf(frac, deficit * DEFICIT_FLOOR)
	var jitter := int(round(rng.randf_range(-1.0, 1.0) * float(JITTER_MAX) * spread * inacc))
	var drift := rng.randf_range(-1.0, 1.0) * DRIFT_MAX * spread * inacc
	if _collcheck:
		# the overlap audit judges the IDEAL pattern: geometry must be clean
		# before inaccuracy gets a say, so the noise terms are zeroed here
		jitter = 0
		drift = 0.0

	b.state = STATE_FLIGHT
	b.launch_tick = tick
	b.land_tick = tick + air + jitter
	b.arc = ARC_PER_AIR * float(air)
	if b.flat:
		b.arc *= SHOWER_FEED_ARC   # a horizontal pass: almost no rise, same time in the air
	# a throw's stamina price is the prop's FLAT rate (Louis): balls 1, eggs 2,
	# rings 3, clubs 4, knives 5, torches 6. Focus shaves one point per 20
	# Focus, never below 1 - every throw costs at least one. Lessons stay free.
	if not tut_active:
		# STAGE BOOTS take a point off every throw, on the same floor Focus already uses:
		# never below 1, so no amount of gear makes a throw free
		var drain := maxf(1.0, float(PROPS[b.kind]["stam"]) - floor(focus() / 20.0) - (1.0 if wearing("boots") else 0.0))
		spend_stamina(drain)
	# where the throw is headed: crossing patterns swap hands, columns (pattern or
	# toggle) keep each ball its lane, and an over-the-top throw always crosses,
	# landing a touch wide of the usual catch point
	# every weaving pattern crosses hands; only Columns keeps a ball with its own
	# hand outright (Reverse Cascade and Tennis are woven too - their over-the-top
	# throws force cross below anyway, but Tennis's unmarked balls also weave, so
	# they cross here). Cascade is parity-only: it crosses at an odd count, keeps
	# each hand its own ball at an even one (the role Fountain used to play, before
	# it was folded into Cascade, 2026-07-19).
	var cross := (pattern == CASCADE and num_balls % 2 == 1) or pattern in [HALFSHOWER, SHOWER, RCASC, TENNIS]
	if over_top:
		cross = true
	# an over-the-top throw never joins the lane bookkeeping (it is the breakout,
	# and letting it claim the middle-ball mark or a lane made it un-over-the-top)
	var lanes := col_lanes and not over_top
	# an odd ball count cannot split evenly into two lanes: rather than just piling
	# the extra ball into one side (the same look as a four-ball columns with one
	# ball removed), one ball renders as a middle lane, so the pattern reads as a
	# genuinely symmetric left / middle / right instead of a lopsided double lane.
	var mid_ball := false
	if lanes and num_balls % 2 == 1:
		# (`was_mid` lived here: it told the launch point whether this was the ball's
		# first throw as the middle one, because a first throw launched from the hand
		# and later ones from stage centre. The middle ball always launches from the
		# hand now, so the distinction has nothing left to decide.)
		if col_mid_ball == null or not balls.has(col_mid_ball):
			col_mid_ball = b   # the first ball thrown once lanes engage claims the middle
		mid_ball = b == col_mid_ball
		if mid_ball:
			lanes = false
	if lanes:
		cross = false
	# the middle ball still never crosses hands: it stays with whichever hand first
	# threw it (same as a lane ball), just rendered at center. Crossing it to the
	# OTHER hand would race it against that hand's own permanent lane ball for the
	# same catch slot, and a hand can only ever catch into an empty stack, so
	# whichever of the two landed second became literally uncatchable.
	if mid_ball:
		cross = false
	b.to_hand = other(h) if cross else h
	# lock the receiving hand's waiting point in RIGHT NOW, for exactly this ball
	# (Louis): Columns/lane/mid-ball throws land INNER, an over-the-top throw lands
	# wherever the receiving hand does NOT throw from (over_top_land_slot), and a
	# plain throw lands OUTER. This is the one and only place hand_catch_rest
	# changes, so the empty hand never has to guess where a future throw goes -
	# it already knows, the instant this one leaves the hand. Resolving the slot ONCE
	# here, and reusing it for b.to_pos below, is what keeps the hand and the ball
	# agreeing on a single landing point even if the pattern changes mid-flight.
	var land_slot := HAND_OUTER
	if over_top:
		land_slot = over_top_land_slot(b.to_hand)
	elif lanes or mid_ball:
		land_slot = HAND_INNER
	elif pattern == SHOWER:
		# A SHOWER'S FEED MUST NOT LAND ON THE HAND'S OWN LAUNCH POINT (2026-07-28). The
		# rule is already stated for over-the-top throws just above - "a landing never
		# sits on a launch" - and the feed was the one throw in the game breaking it: it
		# landed OUTER, which is exactly where the same hand's high throw leaves from, so
		# an arriving prop and a departing one occupied one point. Measured at 5 objects
		# that was the tightest pass in the whole pattern, -10.5px, and it got worse the
		# more one-handed the deal became: with every prop in the throwing hand (which is
		# what a shower now deals, see deal_side) the hand catches and throws on nearly
		# every beat, so the two coincide constantly rather than occasionally. The feed
		# lands INNER now and the hand carries it out to throw, which is the scoop a
		# shower's throwing hand actually makes.
		land_slot = HAND_INNER
	hand_catch_rest[b.to_hand] = land_slot
	# always launch from wherever the ball is actually sitting: a lane or normal
	# ball rests pulled in at inner_pos while held, the middle ball rests at
	# stage center (see draw_hand) - EXCEPT on the very throw that first marks it
	# as the middle ball, when it has only ever been held at the normal inner_pos
	# and has no center position yet to launch from. An over-the-top throw is its
	# own kind of throw (Louis): NO inward carry, it lobs straight from the OUTER
	# catch point (hand_target holds the hand out there while it waits), so the
	# high road starts wide and never shares air with the low weave.
	b.over_top = over_top
	var cy := stage_center().y
	if lanes or mid_ball:
		# A COLUMN IS A VERTICAL LINE, and there are no exceptions to that any more
		# (2026-07-28, Louis: "the objects are thrown straight up and exactly from where
		# they landed"). Two things used to break it:
		#   - `drift`, the inaccuracy term, moved the LANDING sideways, so a ball came
		#     down a few px off its own column and was then thrown from the column again.
		#     It is dropped here (and only here): drift is purely cosmetic anyway, since
		#     on_catch judges a catch on TIMING, so a crooked column bought no difficulty.
		#     Accuracy still lands on this throw through `jitter`, which is timing.
		#   - the centre column, on an odd count, was a diagonal: it launched from the
		#     HAND and landed at centre. Measured with --collcheck at 3 torches, that
		#     diagonal was a real overlap (-29.8px) with the ball in the neighbouring
		#     column, and every odd count showed the same signature while every even one
		#     was clear. It is a column now, thrown from the centre line it lands on, so
		#     the hand comes to the line to throw and catch it (see hand_target).
		if mid_ball:
			b.lane_x = stage_center().x
		else:
			assign_lane(b, h)
		b.from_pos = Vector2(b.lane_x, cy)
		b.to_pos = Vector2(b.lane_x, cy)
	elif over_top:
		# the over-the-top lob leaves from the OUTER catch corner and rides a tall
		# parabola down onto land_slot (over_top_land_slot: the complement of the
		# receiving hand's own launch slot, so a landing never sits on a launch).
		# This road ALWAYS crosses the centre (outer_pos of one hand to an inner
		# slot of the other), so it is not a candidate for the toward-centre lane
		# nudge below - shifting either end toward the middle only pulls it closer
		# to whatever road it is crossing, worse not better. Left exactly as it was.
		b.from_pos = outer_pos(h)
		b.to_pos = slot_pos(b.to_hand, land_slot) + Vector2(drift, 0.0)
	else:
		# a plain cascade throw: inner launch, outer catch - ALWAYS these same two
		# points, whichever hand it lands in, and now including the even-count
		# Cascade's same-hand face (Louis, 2026-07-26). An extra ball sharing one
		# hand's own road no longer gets moved sideways onto a vertical lane; it gets
		# a TALLER ARC instead, so the road a player sees is the same fountain road
		# for every ball on it and only the height differs. See same_hand_arc_lift for
		# the geometry, and prop_hit_scale for the other half Louis authorized: the
		# hitbox, never the drawn size, absorbs what the lift cannot.
		#
		# A CROSSING throw is not part of this and never was: its road already runs
		# through the centre by design, so nothing about it can be nudged inward
		# without closing the gap with the opposite-direction road it crosses
		# (measurably worse, per the --latecatch audit). A crossing road's own
		# concurrency is carried entirely by prop_hit_scale.
		# ...and it lands on `land_slot`, which IS outer_pos for every pattern except the
		# Shower's feed (see the land_slot block above). This used to read outer_pos
		# outright, so the ball and the hand waiting for it could disagree: land_slot is
		# what sets hand_catch_rest, so hard-coding the landing here meant a change to one
		# silently did not move the other.
		b.from_pos = inner_pos(h)
		b.to_pos = slot_pos(b.to_hand, land_slot) + Vector2(drift, 0.0)
	if this_trick == TR_BTB:
		# BEHIND THE BACK actually goes behind now (Louis: it never read as
		# behind): the arm wraps and the ball RELEASES from behind the opposite
		# hip, a touch below the hand line, so it rises past the body - drawn
		# BEHIND the figure until it clears (the two-pass split in the play
		# draw). From release on it is the same clean parabola as any throw.
		var bc := stage_center()
		b.from_pos = Vector2(lerpf(bc.x, inner_pos(other(h)).x, 0.75), bc.y + 26.0)

	throw_kick[h] = tick
	charging[h] = false
	if not started:
		started = true
		running = true
	elif not running and mode == MODE_TRAIN:
		# training and lessons always resume on a throw. Without this, one full drop
		# latched running=false for good (update_sim only clears it, do_throw only set it
		# on the first-ever throw), so misses stopped being cleaned up and the lesson
		# froze with no move able to recover it.
		running = true
	# a clean, controlled (low) throw earns a little Applause; an under-strength throw
	# is low but sloppy, so the deficit strips most of that reward: a sagging heavy
	# prop should not read to the crowd as tidy control.
	warm_room(0.004 * (1.0 - clampf(frac, 0.0, 1.0)) * (1.0 - 0.8 * deficit))
	# but now that the crowd's patience is a resource (Phase 2), a genuinely BIG throw
	# thrills them: on stage, height feeds the meter a little, so spectacle buys time
	# and a timid low weave slowly bores the room even as it stays tidy.
	if mode == MODE_PERFORM and not tut_active:
		warm_room(APPL_THROW_HEIGHT * clampf(frac, 0.0, 1.4) * (1.0 - 0.8 * deficit))
	if mode == MODE_PERFORM and not tut_active and frac >= 1.1:
		play_sfx("gasp", -13.0)   # the crowd inhales at a genuinely risky throw
	play_sfx("throw", -13.0, clampf(1.2 - 0.09 * float(weight - 1) - 0.15 * frac, 0.5, 1.4))   # whup, lower for heavy/high
	if tut_active:
		tut_on_throw(h)   # a guided lesson watches your throws to advance its steps


#endregion

#region UNLOCK REQUIREMENTS & PATTERN/TRICK TABLES
# --- unlock requirements: a skill (trick or pattern) may ask for a level, a
# Strength, an Accuracy, and a stage of the career (the venue Reputation has
# reached). ALL present keys must be met, so the content spreads over the whole
# climb instead of dumping itself on the first evenings (Louis).
func dev_meet_req(d: Dictionary) -> void:
	# dev flags only (--pattern / --trick): floor every progress axis to satisfy
	# this entry's ask, so a screenshot run is never silently refused a skill.
	# Reputation only ever rises here (venue_pick is untouched, so the stage
	# actually shown stays whatever --venue chose).
	level = maxi(level, int(d.get("lvl", 1)))
	strength = maxi(strength, int(d.get("str", 0)))
	accuracy = maxi(accuracy, int(d.get("acc", 0)))
	if int(d.get("ven", 0)) > 0:
		reputation = maxi(reputation, VENUE_REP[int(d["ven"])])
	# ...AND IT GRANTS THE SKILL, which it did not have to before and absolutely does now
	# (2026-07-28 evening). Clearing the walls used to BE the unlock; since the deck
	# change, ownership is an explicit list and a wall only earns you a card. So every
	# `--pattern tennis` run was floring the stats, failing `pattern_unlocked`, and being
	# silently snapped back to Cascade by start_run - which is exactly what a whole
	# combination audit measured before the identical numbers gave it away (Tennis's three
	# rows came back byte-for-byte equal to Cascade's). **A dev flag that quietly does
	# something else is worse than one that errors**, and any tool that reads a gate needs
	# re-checking whenever the meaning of "unlocked" moves.
	var did := String(d.get("id", ""))
	if did != "" and not gifted.has(did):
		gifted.append(did)


# WHAT YOU HAVE, AND WHAT YOU HAVE EARNED, ARE TWO DIFFERENT QUESTIONS (2026-07-28).
# This is the change Louis asked for and it is worth stating the shape of it before the
# code: "hide the tricks and patterns until they are unlocked. just show that you unlock
# something: a trick card or a pattern card, but not which one. put a randomiser on it
# also. You can only obtain tricks and patterns you don't have already, all equal chance."
#
# Before, a WALL and a SKILL were the same thing: Behind the Back was the thing behind
# Accuracy 50, so the Skills screen could list every locked skill with the exact bar it
# sat behind, and crossing that bar always handed you that skill. Now the wall decides
# WHEN and the deal decides WHICH:
#   * `skill_gate_cleared(d)` is the old test - stats, level, stage, acts played. It no
#     longer says "you have this"; it says "you have earned a card of this kind".
#   * `owned_skills` is the truth about what the player HAS, and it is what every gameplay
#     check reads through `skill_req_met`. Nothing is unlocked by standing near its wall.
#   * `deal_skill_card` rolls one skill you do not own, uniformly, and that is the one the
#     card turns over.
# The PACING is deliberately untouched: the same walls, cleared in the same order, deal the
# same number of cards at the same moments. Only the identity behind each card is now a
# surprise, which is the whole point - and it means a locked skill can no longer advertise
# itself, so the Skills screen shows a face-down card where it used to print a name.
func skill_gate_cleared(d: Dictionary) -> bool:
	# TIME AT THE JOB, before anything else (2026-07-27, Louis: "i want less tricks
	# unlocked so early in the game. i have barely any reputation or stats and yet i have
	# them all already ... make sure the player has to play quite a bit and gets used to
	# the game before bringing in the new stuff"). Every other wall here is a STAT, and
	# stats can be rushed - a few good nights buys levels faster than a player learns to
	# juggle, which is exactly how he ended up holding the whole toolkit while still
	# unknown. Acts PLAYED cannot be rushed. It is the only requirement that measures
	# what he actually asked for, so it is the one that comes first.
	if int(career["perfs"]) < int(d.get("perf", 0)):
		return false
	if level < int(d.get("lvl", 1)):
		return false
	if strength < int(d.get("str", 0)):
		return false
	if accuracy < int(d.get("acc", 0)):
		return false
	if endurance < int(d.get("end", 0)):
		return false
	if speed < int(d.get("spd", 0)):
		return false
	if venue_index() < int(d.get("ven", 0)):
		return false
	return true


func skill_req_met(d: Dictionary) -> bool:
	# DO YOU HAVE IT. The one question every gameplay check asks - can this pattern be
	# selected, will this trick fire, does the Skills screen show it - and the answer is
	# ownership, never proximity to a wall. `gifted` is the older name of the same list
	# (it was the pity director's own record) and stays the persisted key so no save has to
	# be migrated; `owned_skills()` is what to call it in new code.
	var id := String(d.get("id", ""))
	if id == "":
		return true
	if skill_free(d):
		return true   # Cascade: no wall at all, so it is yours before anything is dealt
	return gifted.has(id)


func skill_free(d: Dictionary) -> bool:
	# a skill with NO requirement of any kind is the starting kit, not a prize. Cascade is
	# the only one, and it must never enter the random pool or the very first card dealt
	# could be the pattern the player is already using.
	return skill_req_text(d) == "yours from the start"


func skill_pool(is_trick: bool) -> Array[int]:
	# EVERY SKILL OF THIS KIND THE PLAYER DOES NOT YET HAVE (Louis: "you can only obtain
	# tricks and patterns you don't have already, all equal chance"). Indices, so the caller
	# can pick one with a flat randi and nothing needs weighting.
	var tab: Array = TRICKS if is_trick else PATTERNS
	var out: Array[int] = []
	for i in tab.size():
		var d: Dictionary = tab[i]
		if skill_free(d) or gifted.has(String(d["id"])):
			continue
		out.append(i)
	return out


func skill_earned_count(is_trick: bool) -> int:
	# HOW MANY CARDS OF THIS KIND THE PLAYER HAS EARNED: one per wall cleared. Counting
	# walls rather than matching each wall to its own skill is what lets the identity be
	# random while the PACING stays exactly what it was - the same gates, in the same
	# order of difficulty, deal the same number of cards at the same moments.
	var tab: Array = TRICKS if is_trick else PATTERNS
	var n := 0
	for i in tab.size():
		var d: Dictionary = tab[i]
		if skill_free(d):
			continue
		if skill_gate_cleared(d):
			n += 1
	return n


func skill_held_count(is_trick: bool) -> int:
	var tab: Array = TRICKS if is_trick else PATTERNS
	var n := 0
	for i in tab.size():
		var d: Dictionary = tab[i]
		if not skill_free(d) and gifted.has(String(d["id"])):
			n += 1
	return n


func deal_skill_card(is_trick: bool) -> int:
	# ROLL ONE, uniformly, from what is left. Uses the global randi and never the sim rng:
	# `rng` drives the deterministic catch sequence, and a card dealt mid-act must not
	# shift it (the same rule roll_encore and the flower throws already follow).
	var pool := skill_pool(is_trick)
	if pool.is_empty():
		return -1
	var idx: int = pool[randi() % pool.size()]
	var tab: Array = TRICKS if is_trick else PATTERNS
	gifted.append(String((tab[idx] as Dictionary)["id"]))
	return idx


func skill_req_text(d: Dictionary) -> String:
	# the requirement, said plainly, for lock messages and the Skills screen
	var parts: Array[String] = []
	# stage time first, because it is usually the binding one early on and it is the one
	# a player can do nothing about except keep performing - saying so is the whole point
	if int(d.get("perf", 0)) > 0:
		parts.append("%d performances" % int(d["perf"]))
	if int(d.get("lvl", 1)) > 1:
		parts.append("level %d" % int(d["lvl"]))
	if int(d.get("str", 0)) > 0:
		parts.append("Strength %d" % int(d["str"]))
	if int(d.get("acc", 0)) > 0:
		parts.append("Accuracy %d" % int(d["acc"]))
	if int(d.get("end", 0)) > 0:
		parts.append("Endurance %d" % int(d["end"]))
	if int(d.get("spd", 0)) > 0:
		parts.append("Speed %d" % int(d["spd"]))
	if int(d.get("ven", 0)) > 0:
		# some venues carry their own article ("The Circus", "The Midnight Show"), so
		# the sentence supplies one only when the name does not - it read "reach the
		# The Circus" on the Skills screen and in every lock message
		var vn := String(venue_data(int(d["ven"]))["name"])
		parts.append("reach %s" % vn if vn.begins_with("The ") else ("reach the %s" % vn))
	if parts.is_empty():
		return "yours from the start"
	return " + ".join(parts)


func skill_gate_badge(d: Dictionary) -> String:
	# the SHORT badge for a LOCKED skill on the Skills screen: name the FIRST axis the
	# player has not met yet (level, then Strength, then Accuracy, then the stage's Rep),
	# not always the level. A level-8 player eyeing Columns should see "Acc 8" - the wall
	# they are actually against - not "Lv 4+", a bar they cleared four levels ago. A
	# trailing "+" still says another axis is also unmet; the detail strip spells it all out.
	var unmet: Array[String] = []
	if level < int(d.get("lvl", 1)):
		unmet.append("Lv %d" % int(d.get("lvl", 1)))
	if strength < int(d.get("str", 0)):
		unmet.append("Str %d" % int(d["str"]))
	if accuracy < int(d.get("acc", 0)):
		unmet.append("Acc %d" % int(d["acc"]))
	if endurance < int(d.get("end", 0)):
		unmet.append("End %d" % int(d["end"]))
	if speed < int(d.get("spd", 0)):
		unmet.append("Spd %d" % int(d["spd"]))
	if venue_index() < int(d.get("ven", 0)):
		unmet.append("Rep %d" % VENUE_REP[int(d["ven"])])
	if unmet.is_empty():
		return "Lv %d" % int(d.get("lvl", 1))   # locked for another reason; show the level
	return unmet[0] + ("+" if unmet.size() > 1 else "")


func pattern_unlocked(i: int) -> bool:
	return skill_req_met(PATTERNS[i])


func pattern_order() -> Array:
	# pattern indices in the order a typical career actually reaches them. Sorting
	# by "lvl" alone (2026-07-18, a real bug: fixed here) was wrong: Shower, Reverse
	# Cascade and Tennis all carry "lvl": 1 but are really gated behind venue 3/4/5,
	# so they sorted ahead of Columns/Half Shower, which unlock far earlier
	# in real play on level/stat walls alone. Venue is the dominant, latest-clearing
	# gate, so it sorts first; level breaks ties within the same venue. The array
	# itself keeps indices 0..4 frozen for old saves, so display and the P cycle
	# sort here instead of reordering PATTERNS.
	var out: Array = []
	for i in PATTERNS.size():
		out.append(i)
	out.sort_custom(func(a, b):
		var va: int = int(PATTERNS[a].get("ven", 0))
		var vb: int = int(PATTERNS[b].get("ven", 0))
		if va != vb:
			return va < vb
		return int(PATTERNS[a]["lvl"]) < int(PATTERNS[b]["lvl"]))
	return out


func pattern_mult() -> float:
	return float(PATTERNS[pattern]["mult"])


func object_mult() -> float:
	# harder LOADS pay more, independent of which pattern they are juggled in
	# (ideas.rtf: using more objects should give score a good boost compared to
	# just spamming three balls). The ball-count term and the prop's own score
	# multiplier compound, so climbing BOTH axes (more props AND heavier ones)
	# is the way to a big number - e.g. seven torches far outpays three balls,
	# but only a player who can actually sustain them gets there.
	var ball_step := float(num_balls - MIN_BALLS)
	return (1.0 + OBJ_BALL_BONUS * ball_step) * prop_score_mult()


func stage_darkness() -> float:
	# HOW DARK THIS HOUSE IS, 0 (a lit stage) to 1 (you are juggling by feel). Driven by
	# the venue's own `spot` so it needs no second table to keep in sync: the Midnight
	# Show reads 1.0, the Backyard about 0.6, the Circus and everything brighter 0.
	# A dark CONTEXT (the Blackout encore, Stage Fright, the Midnight Show - the same
	# set torches already earn their bonus in) pins it to full. Only cosmetics read
	# this; nothing in the sim does.
	if is_dark_context():
		return 1.0
	var spot := float(venue_data(cur_venue())["spot"])
	return clampf((0.055 - spot) / 0.04, 0.0, 1.0)


func is_dark_context() -> bool:
	# where the stage light is genuinely poor and a self-lit prop earns its keep. Blackout
	# and Stage Fright can roll from The Street up, but both are SOFTENED (every prop keeps
	# a lit trail, markers aside), so a torch-less player is never simply blind; the one
	# place non-lit props go truly hard to read is the Midnight Show, which is post-win and
	# late, by when torches are long affordable (Louis, 2026-07-26: the "only torches can
	# be juggled" situation must never land before the player would obviously own them).
	return encore_on("blackout") or encore_on("fright") or run_venue == MAX_VENUE


func is_picky_crowd() -> bool:
	# a hard-to-please room: The Critic scores only Perfects, The Hecklers lose patience
	# fast. A dangerous prop (knives) is what wins a crowd like this over.
	return encore_on("critic") or encore_on("hecklers")


func prop_score_mult(kind: int = -1) -> float:
	# the prop's own score multiplier (reward), read by object_mult on top of the ball-count
	# term - plus its signature CONTEXT bonus: torches in the dark, knives before a picky
	# crowd. Both only ever ADD, so choosing the right prop for the night pays and choosing
	# the wrong one merely forgoes the bonus, never a penalty for it.
	var k := prop_type if kind < 0 else kind
	var m := float(PROPS[k]["smult"])
	if k == PROP_TORCHES and is_dark_context():
		m += DARK_PROP_BONUS
	if k == PROP_KNIVES and is_picky_crowd():
		m += PICKY_PROP_BONUS
	return m


func prop_thrill() -> float:
	# extra crowd patience a heavy prop's Perfect catch buys: the danger of the thing thrills
	# the room. Scales with weight, and doubles for knives before a picky crowd - exactly the
	# fast-draining Hecklers set where keeping the room in their seats matters most.
	var w := prop_weight() - 1
	if w <= 0:
		return 0.0
	var t := THRILL_PERFECT * float(w)
	if prop_type == PROP_KNIVES and is_picky_crowd():
		t *= 2.0
	return t


func chain_mult() -> float:
	# A SATURATING CURVE, so the score stays LINEAR IN TIME - see CHAIN_GAIN for why that
	# matters and what the previous version got wrong. x1.0 cold, x2.5 at forty straight
	# Perfects, approaching x4 and never reaching it. No hard cap anywhere: it is a limit, not
	# a wall, so nothing ever "maxes out" on screen.
	var c := float(chain)
	return 1.0 + CHAIN_GAIN * c / (c + CHAIN_HALF)


func trick_difficulty(t: int) -> float:
	# `p` FOR ONE LANDING OF THIS TRICK - the base in p^x - scaled by how hard the situation
	# is. The base sits in TRICKS; everything else is context, and it multiplies only the
	# EXCESS over 1.0, so the result can never dip to or below 1 and turn a trick into a
	# penalty. A Spin with three balls in a Cascade is worth x2; the same Spin with fifteen
	# chainsaws in Tennis is worth x6.9, which is the whole reason to climb.
	if t < 0 or t >= TRICKS.size():
		return 1.0
	var base := float(TRICKS[t].get("diff", 1.0))
	var ctx := (1.0 + TRICK_DIFF_WEIGHT * float(prop_weight() - 1)) \
		* (1.0 + TRICK_DIFF_COUNT * float(num_balls - MIN_BALLS)) \
		* pattern_mult()
	return 1.0 + (base - 1.0) * ctx


func add_run_pts(p: float) -> void:
	run_pts += maxf(p, 0.0)
	recalc_score()


func apply_trick_mult(t: int) -> void:
	# ONE LANDING, ONE MULTIPLICATION. x landings of the same trick therefore multiply the run
	# by p^x with no special case anywhere - which is exactly the sentence Louis wrote the
	# feature as, and the reason it is worth resisting any "and also +N points" on top.
	var p := trick_difficulty(t)
	if p <= 1.0:
		return
	run_mult = minf(run_mult * p, SCORE_CEIL)
	recalc_score()


func close_run() -> void:
	# A DROP BANKS THE RUN. Everything the run grew to is locked in and a fresh run opens at
	# multiplier 1 - so a drop is not a small setback, it is the end of an exponential, and the
	# later it happens the more it costs. That is the tension the whole system is for.
	banked_pts = minf(banked_pts + run_pts * run_mult, SCORE_CEIL)
	run_pts = 0.0
	run_mult = 1.0
	chain = 0
	recalc_score()


func recalc_score() -> void:
	score = minf(banked_pts + run_pts * run_mult, SCORE_CEIL)


func rec_table() -> Array[float]:
	# which record board this booking plays on: the stat-assisted one or the Purist
	return best_scores_purist if purist else best_scores


func purist_legend_complete() -> bool:
	# the post-win chase's cheap version (Still open): a Purist record standing at
	# EVERY venue, Midnight Show included - touches none of the encore-stacking
	# refactor that idea originally wanted, since the payoff here is just noticing
	# the Purist board (already fully tracked by rec_table/best_scores_purist) has
	# no empty rows left, not a new system.
	for v in best_scores_purist:
		if int(v) <= 0:
			return false
	return true


func cycle_pattern() -> void:
	# P steps the pattern in training (a performance is committed to its routine).
	# Restarts the run so the hands are re-dealt for the new choreography.
	pattern_once = -1   # the player's own hand on P ends any Skills-practice override
	var un: Array = []
	for i in pattern_order():
		if pattern_unlocked(i):
			un.append(i)
	if un.size() <= 2:
		# only the parity starters are open, and start_run snaps those to the ball
		# count anyway, so there is nothing real to cycle yet - say what comes next
		set_trick_msg("the next pattern (Columns) asks for %s" % skill_req_text(PATTERNS[COLUMNS]))
		return
	var idx := un.find(pattern_sel)
	pattern_sel = int(un[(idx + 1) % un.size()]) if idx >= 0 else int(un[0])
	set_trick_msg("%s  -  %s" % [String(PATTERNS[pattern_sel]["name"]).to_upper(), String(PATTERNS[pattern_sel]["desc"])])
	play_sfx("ui2", -13.0)
	start_run(num_balls)


func trick_unlocked(i: int) -> bool:
	return skill_req_met(TRICKS[i])


func unlocked_tricks() -> Array:
	# in unlock order, so C cycles the way the player learned them - same (venue,
	# then level) key as pattern_order(), for the same reason: a venue-gated
	# trick's "lvl" alone would understate how late it actually arrives
	var out: Array = []
	for i in TRICKS.size():
		if trick_unlocked(i):
			out.append(i)
	out.sort_custom(func(a, b):
		var va: int = int(TRICKS[a].get("ven", 0))
		var vb: int = int(TRICKS[b].get("ven", 0))
		if va != vb:
			return va < vb
		return int(TRICKS[a]["lvl"]) < int(TRICKS[b]["lvl"]))
	return out


#endregion

#region TRICKS: SPIN / CYCLE / REWARD
func balls_airborne() -> int:
	var n := 0
	for b in balls:
		if b.state == STATE_FLIGHT:
			n += 1
	return n


func juggling_catch(landing: Ball) -> bool:
	# THE definition of juggling (Louis): at least one prop is in the air at ALL times.
	# Anything less is just throwing one object and catching it again, however quickly
	# it is done - and the game must know the difference, everywhere, not only in the
	# lesson that teaches it.
	#
	# Testing that continuously would be wasted work, because the air can only ever
	# EMPTY at a catch: a throw only adds to it, and a drop is punished on its own terms.
	# So the whole rule reduces to one question asked at the one moment it can be
	# broken - does this catch empty the air? If something else is still up as this
	# lands, the air never emptied, and the pattern is live. If not, the player just
	# threw one thing and caught it, and this catch earns nothing (see on_catch).
	#
	# Two props landing on the same tick do not slip through: the first sees the second
	# still airborne and counts, the second finds the air bare behind it and does not -
	# so "hold one, pump two together" tops out at a streak of one, which is the point.
	for b in balls:
		if b != landing and b.state == STATE_FLIGHT:
			return true
	return false


func spinning() -> bool:
	return tick <= spin_until


func set_trick_msg(m: String) -> void:
	trick_msg = m
	trick_msg_tick = tick


func trick_pattern_warning(tr: int, pat: int) -> String:
	# WHICH COMBINATIONS FIGHT, measured rather than guessed (2026-07-28 evening, Louis:
	# "i want you to dissect the possibilities of patterns and tricks, since multiple can be
	# active at the same time. are all of these valid states?"). Every one of the eighteen
	# pattern x toggle states was run through --collcheck at five clubs with realistic
	# timing; fifteen are clean and these three are not, each for a reason that is about
	# GEOMETRY and not about tuning:
	#
	#   Behind the Back x COLUMNS      -13.6px. A column is DEFINED by going straight up and
	#                                  coming down where it left; Behind the Back is DEFINED
	#                                  by releasing from across the body. The two rules
	#                                  cannot both hold, and no constant reconciles them.
	#   Behind the Back x REV CASCADE  -9.8px. Every throw already goes over the top; adding
	#                                  a release from behind the far hip compounds two
	#                                  crossings on one road.
	#   High Toss x SHOWER             -4.4px. The shower's high hand throws every prop; at
	#                                  1.35-1.8 height they crowd a single road that already
	#                                  carries count-1 objects.
	#
	# (Two more were broken and are now FIXED rather than warned about - see the armed_trick
	# note in do_throw. Half Shower x High Toss went 4.2 -> 38.1px, Shower x Behind the Back
	# -7.5 -> +2.5. Those were a guard misfiring, which is a bug; these three are the shapes
	# genuinely disagreeing, which is not.)
	if tr == TR_BTB and pat == COLUMNS:
		return "columns want to come straight back down. Expect clashes."
	if tr == TR_BTB and pat == RCASC:
		return "both go over the top at once. Expect clashes."
	if tr == TR_HIGH and pat == SHOWER:
		return "the shower's high road is already full. Expect clashes."
	return ""


func on_trick() -> void:
	# The TRICK key (Space) is the one-shot powerup. With an arm trick selected it
	# primes exactly the next throw (pressing again waves it off); with Spin selected
	# it performs the spin right now. The selection itself lives on C (cycle_trick).
	# In a TRICK lesson the trick being TAUGHT is always usable, on EVERY step of it,
	# whatever your level - the lesson selects it and skips the unlock gate, so it can
	# never dead-end waiting for a Space press the gate silently refused, and a press
	# on the drill steps still acts on the taught trick, never on some other one.
	# In any OTHER lesson Space is not part of the exercise: say so instead of firing
	# a trick invisibly under a pattern drill.
	if tut_holding() and not tut_hold_names("trick", -1):
		return   # a frozen beat hears only what it asked for (see on_catch)
	if tut_active and tut_id.begins_with("trick_"):
		trick_sel = trick_by_id(tut_id.substr(6))
	elif tut_active:
		if tut_id.begins_with("pattern_"):
			set_trick_msg("this lesson is a PATTERN - it runs on its own. Tricks ride %s on the stage" % k_trick()[0])
		else:
			set_trick_msg("no trick in this lesson - just throws and catches")
		return
	elif unlocked_tricks().is_empty():
		set_trick_msg("the first trick (%s) asks for %s" % [String(TRICKS[0]["name"]), skill_req_text(TRICKS[0])])
		return
	elif trick_sel < 0 or not trick_unlocked(trick_sel):
		trick_sel = int(unlocked_tricks()[0])
	var t: Dictionary = TRICKS[trick_sel]
	# CASCADE ONLY, FOR EVERY TRICK BUT HIGH TOSS AND SPIN (2026-07-29, Louis). This is the
	# combination audit's finding turned into a rule rather than a warning: every pattern
	# except Cascade IS a fixed geometry, and a trick that reshapes every throw is in direct
	# conflict with one. Cascade is the only pattern with no shape of its own to protect, so it
	# is the only one with room for a shaping trick. High Toss changes height and Spin changes
	# nothing about the throw at all, so both ride anything.
	if bool(t.get("cascade_only", false)) and pattern != CASCADE:
		set_trick_msg("%s only works in a Cascade  -  press P to switch" % String(t["name"]).to_upper())
		play_sfx("whiff", -12.0)
		return
	match String(t["kind"]):
		"live":
			if balls_airborne() < int(t["min_air"]):
				var na := int(t["min_air"])
				set_trick_msg("Spin needs a ball in the air" if na == 1 else "Spin needs %d in the air" % na)
				return
			if spinning():
				return   # already turning: the lockout below is the limiter, not a mash guard
			spin_until = tick + SPIN_TICKS
			spin_scored = false
			trick_ready = tick + TRICK_COOLDOWN
			# THE SPIN MULTIPLIES THE RUN THE MOMENT IT FIRES, not on some later catch. A live
			# trick has no shaped throw to land - it IS the press - and it is now the biggest
			# multiplier in the game, paid for by the 44 ticks of blindness below.
			if not tut_active:
				apply_trick_mult(trick_sel)
				tricks_landed += 1
				trick_score += 1
			set_trick_msg("SPIN")
			play_sfx("streak", -7.0)
			if tut_active:
				# THE Spin lesson bug (Louis: "I do it but it won't register"). A
				# "trick_use" step counts through reward_trick - and reward_trick is
				# reached only from a catch whose BALL carries a trick tag, which
				# nothing but an ARM trick ever sets, and it returns early on a zero
				# bonus, which Spin's is. So the step's counter could never move and
				# the lesson dead-ended however many perfect Spins were performed.
				# A live trick has no shaped throw to land later: it IS the press, so
				# it is banked right here, the moment it fires.
				tut_tricks += 1
		"toggle":
			# one press ON, the next press OFF, smoothly mid-pattern (Louis).
			# Only one toggle runs at a time; switching replaces the old one.
			if toggle_on == trick_sel:
				toggle_on = -1
				set_trick_msg("%s OFF" % String(t["name"]).to_upper())
				play_sfx("ui", -16.0)
			else:
				toggle_on = trick_sel
				toggle_scored = false
				# ONE PRESS, ONE MULTIPLICATION - see the note on TRICKS. Switching a toggle
				# ON is the activation; holding it costs nothing more and pays nothing more,
				# so the score inside a run stays linear in time.
				if not tut_active:
					apply_trick_mult(trick_sel)
				# ...AND IT SAYS SO WHEN THE COMBINATION FIGHTS ITSELF. Three of the
				# eighteen pattern x toggle states are geometrically contradictory rather
				# than merely hard - see trick_pattern_warning - and the player is TOLD
				# rather than blocked. Blocking would be the wrong call twice over: it is
				# their press, and "Behind the Back during Columns" is a perfectly
				# reasonable thing to want to try. But props visibly passing through each
				# other with no explanation reads as a broken game, and the one thing that
				# turns that into a deliberate stunt is a line of text.
				var warn := trick_pattern_warning(trick_sel, pattern)
				if warn == "":
					set_trick_msg("%s ON" % String(t["name"]).to_upper())
				else:
					set_trick_msg("%s ON  -  %s" % [String(t["name"]).to_upper(), warn])
				play_sfx("ui2", -13.0)
		_:
			if trick_primed:
				trick_primed = false
				set_trick_msg("waved off  -  plain throw")
				play_sfx("ui", -16.0)
				return
			trick_primed = true
			set_trick_msg("%s  -  next throw" % String(t["name"]).to_upper())
			play_sfx("ui2", -13.0)
	if tut_active:
		tut_hold_mark("trick", -1)   # the beat's key has been pressed
		tut_check()   # a trick_on / trick_off lesson step clears the instant Space toggles


func cycle_trick() -> void:
	# C steps the SELECTION through every unlocked trick. Switching never fires
	# anything by itself: the loaded trick just waits for its own Space press.
	# A pending one-shot follows the switch, so prime-then-switch never fires
	# the trick you switched away from.
	var un := unlocked_tricks()
	if un.is_empty():
		set_trick_msg("no trick yet  -  keep leveling up")
		return
	var idx := un.find(trick_sel)
	trick_sel = int(un[(idx + 1) % un.size()]) if idx >= 0 else int(un[0])
	if String(TRICKS[trick_sel]["kind"]) == "live":
		trick_primed = false   # Spin fires on Space directly; nothing stays primed
		set_trick_msg("%s selected  -  Space performs it" % String(TRICKS[trick_sel]["name"]))
	else:
		set_trick_msg("%s selected  -  Space powers one throw" % String(TRICKS[trick_sel]["name"]))
	play_sfx("ui2", -13.0)


func reward_trick(t: int, at: Vector2, height: float = 0.0) -> void:
	# a landed shaped catch pays the trick's bonus. One-shots celebrate loudly.
	# A running toggle pays a smaller bonus on every shaped catch it lands, and
	# counts toward the trick tally only once per activation.
	if t < 0 or t >= TRICKS.size():
		return
	var td: Dictionary = TRICKS[t]
	if encore_score_mult() <= 0.0:
		return   # For the Danger: a light prop scores nothing, and neither do its tricks
	# **THE MULTIPLICATION ALREADY HAPPENED, AT THE PRESS.** This function runs on every catch
	# of a shaped throw, so multiplying here is multiplying per CATCH - which is the time-based
	# exponential the per-activation rule exists to remove. What is left for a landing to do is
	# what a landing always did: warm the room, count once toward the tally, and shout.
	var tog := String(td["kind"]) == "toggle"
	warm_room(0.03 if tog else 0.09)
	if tog:
		if not toggle_scored:
			toggle_scored = true
			tricks_landed += 1
			add_xp(3)
		add_xp(1)
		add_popup(at + Vector2(0, -34), String(td["shout"]), Color(1.0, 0.85, 0.45, 0.8))
	else:
		tricks_landed += 1
		add_xp(4)
		add_popup(at + Vector2(0, -34), String(td["shout"]), Color(1.0, 0.85, 0.45))
		play_sfx("streak", -6.0)
	if tut_active:
		tut_tricks += 1   # a trick_use lesson step counts each landed shaped catch
		tut_check()


# -----------------------------------------------------------------------------
# Progression: XP from skilled play, levels grant stat points, stats add comfort
# (never auto-play). Accuracy eases high throws, Endurance raises Stamina,
# Strength adds a little height control. All effects capped (skill-first guardrail).
# -----------------------------------------------------------------------------

#endregion

#region XP, LEVELING & UNLOCK ANNOUNCEMENTS
func xp_to_next(lv: int) -> int:
	# a power curve (exponent 1.4) plus a flat linear term: accelerates the XP cost
	# per level to pair with POINTS_PER_LEVEL's own accelerating points-per-level -
	# tuned to the ~level 115 / ~2.4M total XP completion arc (see CLAUDE.md)
	return int(round(60.0 * pow(float(lv), 1.4))) + 40 * lv


func all_stats_capped() -> bool:
	# the whole build is finished: every trainable stat sits at its ceiling
	return accuracy >= ACC_CAP and strength >= STR_CAP and endurance >= END_CAP and speed >= SPEED_CAP


func add_xp(amount: int) -> void:
	if amount <= 0:
		return
	xp += amount
	run_xp += amount
	var leveled := false
	while xp >= xp_to_next(level):
		xp -= xp_to_next(level)
		level += 1
		# points per level ACCELERATE with the level (3 early, one more per twelve
		# levels): with 839 points across the four caps, flat 3s put the finished
		# build at level 280 and ~20M XP - hundreds of hours, a treadmill nobody
		# ends. This curve lands it at ~level 115 and ~2.4M XP: about 30-40 hours
		# of skilled play, all content long since unlocked on the way (Louis asked
		# what the completion arc should be - that is the answer it now has).
		points += POINTS_PER_LEVEL + level / 12
		leveled = true
	if leveled:
		var s := get_viewport_rect().size
		# MASTERY (the late game): with every stat capped, points have nowhere to go,
		# so a level-up pays gold instead - skill keeps earning long after the build
		# is finished. Skill still sets the score; this is comfort, like pay always was.
		if all_stats_capped() and points > 0:
			var mg := points * MASTERY_GOLD
			money += mg
			career["mastery"] = int(career.get("mastery", 0)) + points
			points = 0
			add_popup(Vector2(s.x * 0.5, s.y * 0.34), "LEVEL %d  -  MASTERY  +%d %s" % [level, mg, coin_word()], Color(1.0, 0.9, 0.5))
			play_sfx("money", -8.0)
		else:
			add_popup(Vector2(s.x * 0.5, s.y * 0.34), "LEVEL %d" % level, Color(1.0, 0.9, 0.5))
		announce_unlocks()   # a level that crosses a skill's gate teaches it
		save_progress()


func queue_lesson(id: String) -> bool:
	# an unlock during a live set cannot interrupt it, so its lesson WAITS at the hub.
	# Queued once, taught once, then remembered forever (seen_tuts). A lesson already
	# taught, or already waiting, is never re-queued. Returns whether it queued NOW,
	# which is what announce_unlocks uses as its "newly unlocked" signal.
	if seen_tuts.has(id) or pending_tuts.has(id):
		return false
	pending_tuts.append(id)
	return true


func check_ball_unlock(prev_max: int) -> void:
	# max_balls() grows silently at Strength 12/20/30; catch each crossing and queue the
	# lesson that teaches the new, faster, higher count (a genuine content hole before)
	var now := max_balls()
	if now > prev_max:
		queue_lesson("count_%d" % now)


func lesson_title(id: String) -> String:
	# a human name for a queued lesson, shown on the hub's LEARN row
	if id.begins_with("trick_"):
		var t := trick_by_id(id.substr(6))
		return "%s (new trick)" % (String(TRICKS[t]["name"]) if t >= 0 else id.substr(6))
	if id.begins_with("pattern_"):
		var p := pattern_by_id(id.substr(8))
		return "%s (new pattern)" % (String(PATTERNS[p]["name"]) if p >= 0 else id.substr(8))
	if id.begins_with("count_"):
		return "%s balls" % id.substr(6)
	if id.begins_with("prop_"):
		var k := int(id.substr(5))
		return "%s (new prop)" % String(PROPS[k]["name"]) if k >= 0 and k < PROPS.size() else id
	if id == "balls":
		return "the basics"
	if id == TUT_ADVANCED:
		return "the advanced cascade (empty hands)"
	return id


func trick_by_id(tid: String) -> int:
	for i in TRICKS.size():
		if String(TRICKS[i]["id"]) == tid:
			return i
	return -1


func pattern_by_id(pid: String) -> int:
	for i in PATTERNS.size():
		if String(PATTERNS[i]["id"]) == pid:
			return i
	return -1


func announce_unlocks() -> void:
	# a requirement can be crossed on ANY progress axis - a level, a stat spend, a
	# stage reached - so after each of those this rechecks everything and announces
	# whatever is newly open. queue_lesson's own once-ever dedupe is the memory of
	# what was already announced, so nothing double-fires across sessions either.
	# Skills open from the very start (Cascade) never announce.
	# ONE CARD PER WALL CLEARED, and which skill is on it is rolled here (see
	# skill_req_met's header for why). Loops rather than single deals because a big stat
	# spend or a stage arrival can cross two walls in one frame; each deal takes one card
	# off the entitlement, so nothing is ever handed out twice and nothing is lost.
	#
	# The whole card is dealt at ONCE, face down, and the roll has already happened by the
	# time the player sees it. Rolling on the flip instead would be the same odds and a
	# worse feeling: the reveal has to be the moment the player finds out, not the moment
	# the game makes up its mind.
	for _pass in TRICKS.size():
		if skill_held_count(true) >= skill_earned_count(true):
			break
		var ti := deal_skill_card(true)
		if ti < 0:
			break
		queue_lesson("trick_%s" % String(TRICKS[ti]["id"]))
		# the fresh trick becomes the SELECTED one, so the very next Space press does the
		# thing the card just explained (nothing fires by itself: a trick wants its own press)
		trick_unlock = ti
		trick_unlock_tick = tick
		trick_sel = ti
		trick_primed = false
		perfs_since_unlock = 0   # the reward drought counter re-arms on any unlock
		deal_ucard(0, ti)
		play_sfx("streak", -5.0)
	for _pass2 in PATTERNS.size():
		if skill_held_count(false) >= skill_earned_count(false):
			break
		var pi := deal_skill_card(false)
		if pi < 0:
			break
		queue_lesson("pattern_%s" % String(PATTERNS[pi]["id"]))
		set_trick_msg("NEW PATTERN  -  P switches patterns in training")
		perfs_since_unlock = 0
		deal_ucard(1, pi)
		play_sfx("streak", -6.0)


func energy_mult() -> float:
	# performing costs more energy, and bigger routines cost more still;
	# training is lighter so you can practice without burning out. Focus (trained
	# Accuracy past 100) discounts every action's stamina cost (stage 1).
	if tut_active:
		return 0.0   # a lesson costs no stamina at all, so a slow drill never tires out
	var base := 0.5
	if mode == MODE_PERFORM:
		base = 1.0 + 0.15 * float(num_balls - MIN_BALLS)
	return base * focus_stam_mult()


func spend_stamina(amount: float) -> void:
	# every throw and catch's stamina cost funnels through here (Louis,
	# 2026-07-19): a well-stocked Energy-Drink Helmet auto-pours as many drinks
	# as it takes the INSTANT stamina would actually hit empty, so a player who
	# bought in bulk never sees the "hands cannot close" wall at all - that is
	# the whole point of stocking up. Never fires without the helmet, and never
	# invents stamina beyond what real owned drinks can cover.
	stamina = maxf(0.0, stamina - amount)
	while stamina <= 0.0 and wearing("helmet") and energy_drinks > 0:
		energy_drinks -= 1
		stamina = minf(stamina_max, stamina + stamina_max * ENERGY_DRINK_STAMINA_PCT)


#endregion

#region ROUND RESOLUTION & CATCH/CHANCE MATH
func on_round_end() -> void:
	if round_scored:
		return
	round_scored = true
	# a set of a real booking resolves through the booking machinery (bank + advance, or
	# end the night). Everything else - practice, a dev autoplay - just banks its XP.
	if mode == MODE_PERFORM and booking_active and not tut_active:
		resolve_act()
		return
	var clean := 1.0
	if caught + dropped > 0:
		clean = float(caught) / float(caught + dropped)
	# harder routines (more balls, heavier props) are worth more XP
	var diff := 1.0 + 0.25 * float(num_balls - MIN_BALLS) + 0.25 * float(prop_weight() - 1)
	add_xp(int(round((float(best_streak) * 4.0 + float(caught) * 1.5) * clean * diff)))
	career["best_streak"] = maxi(int(career["best_streak"]), best_streak)


func resolve_act() -> void:
	# the act is over - cashed in standing up (the finish key, or every ball caught
	# and held) or brought down by a collapse. ONE resolution for the whole night:
	# pay, reputation, records, XP and the win all read the act's single score.
	booking_active = false
	var complete := goals_hit >= NUM_GOALS
	# the push-your-luck settles here: a COLLAPSE strips the score back to the last
	# goal actually reached (goals already reached are safe, everything past them is
	# what you gambled), and a collapse before the first goal banks nothing at all.
	# A cash-in keeps every point on the board - that is why cashing in is a choice
	# worth making.
	if set_collapsed:
		score = goal_for(run_venue, goals_hit - 1) if goals_hit >= 1 else 0.0
	elif goals_hit == 0 and fail_reason == "":
		# ...unless something closer to the event already said why. The empty-air rule can
		# end an act because the props RAN OUT ("stranded"), and overwriting that with
		# "you chose the bow" would tell the player they made a decision they never made.
		# Same principle the collapse path is built on: the reason belongs to whichever
		# code actually knew.
		fail_reason = "bow"   # walked off under the first goal: say so plainly
	var purist_mult := PURIST_BONUS if purist else 1.0
	# a completion XP bonus off the whole act's play
	var clean := 1.0
	if caught + dropped > 0:
		clean = float(caught) / float(caught + dropped)
	var diff := 1.0 + 0.25 * float(num_balls - MIN_BALLS) + 0.25 * float(prop_weight() - 1)
	var xp_bonus := int(round((float(best_streak) * 4.0 + float(caught) * 1.5) * clean * diff))
	add_xp(xp_bonus)
	run_xp += xp_bonus
	# reputation swings on the goals: (g/3 * 1.5 - 0.5) gives +1.0 of a swing for a
	# complete act, roughly nothing for one goal, -0.5 for a night with none.
	var frac := float(goals_hit) / float(NUM_GOALS)
	var rep_delta := int(round(float(REP_SWING) * (frac * 1.5 - 0.5) * purist_mult))
	# ...then experience shifts it one point per REP_EXP_EVERY acts played, asymmetrically:
	# a gain grows, a loss shrinks TOWARD ZERO and never past it (a bad night must never
	# start paying). Read off career perfs, which is already counted and already saved.
	var seasoning := mini(int(career["perfs"]) / REP_EXP_EVERY, REP_EXP_MAX)
	if rep_delta >= 0:
		rep_delta += seasoning
	else:
		rep_delta = mini(0, rep_delta + seasoning)
	# a single act's rep swing is capped so it can never leap past the NEXT venue
	# tier in one night (cur_tier + 2, since VENUE_REP[cur_tier + 1] is the tier
	# just ahead): reaching a stage always takes at least one more act played there
	var cur_tier := venue_index_of(reputation)
	if cur_tier + 2 < VENUE_REP.size():
		rep_delta = mini(rep_delta, VENUE_REP[cur_tier + 2] - 1 - reputation)
	reputation = maxi(0, reputation + rep_delta)
	last_rep_delta = rep_delta
	# the reward drought grows by one act, THEN the unlock check runs - so a night
	# whose rep jump opens something still ends with the counter at zero
	perfs_since_unlock += 1
	announce_unlocks()   # a Reputation jump can open the stage a skill was waiting on
	# PAY scales with the score that survived (the score already scales with the
	# venue), lifted by Reputation and a Purist premium, with the busking floor so a
	# broke juggler always leaves with something.
	# THE FLOWER ECONOMY: the night's pay is simply what the room threw, already earned
	# in front of the player one flower at a time and lying at their feet. No formula,
	# no multiplier, nothing to compute at the end - the pile IS the purse, which is the
	# whole point of it (Louis). A Purist night still earns its premium, since that is a
	# promise about the whole board, not about the crowd.
	# A CLEAN NIGHT BRINGS THE HOUSE UP. Not one drop, and the act ended on your own
	# terms (a collapse is not a performance however few props hit the floor) with at
	# least one goal banked, so it cannot fire on a walk-off. The bonus goes into
	# run_flowers BEFORE the pay is taken off it, so it flows through the purse, the
	# ledger and the record exactly like every other flower - the rain itself is then
	# purely a picture and adds nothing more, or the night would be paid twice.
	ovation_bonus = 0
	ovation_left = 0
	if dropped == 0 and not set_collapsed and goals_hit >= 1:
		ovation_bonus = maxi(OVATION_BONUS_MIN, int(round(float(run_flowers) * OVATION_BONUS_PCT)))
		run_flowers += ovation_bonus
		ovation_left = OVATION_TICKS
		applause = 1.0    # they are on their feet, and the gauge has to agree
		play_sfx("streak", -3.0)
	last_pay = int(round(float(run_flowers) * purist_mult))
	if money < BROKE_GOLD and score > 0.0:
		last_pay = maxi(last_pay, BUSK_FLOOR)
	money += last_pay
	# ...and the tomatoes, which are only KEPT when the night actually went wrong: a
	# strong act that opened badly should not send the player home with a bag of them
	# (Louis: "if you fail a performance you get some tomatoes"). Being pelted harder
	# for a worse act is already true - the room throws more of them the longer it is
	# in the red - so there is no separate badness formula to write.
	# ...capped, so a long slow disaster cannot be farmed into a week of free stamina:
	# a bad night is a consolation, never a strategy
	last_tomatoes = mini(run_tomatoes, TOMATO_MAX_KEPT) if (set_collapsed or goals_hit == 0) else 0
	tomatoes += last_tomatoes
	if last_pay > 0:
		play_sfx("coin", -8.0)
	# a complete act (all three goals) raises this venue's standing bar for next time
	if complete and run_venue >= 0 and run_venue < ante.size():
		ante[run_venue] += 1
	# the career ledger remembers the night
	career["perfs"] = int(career["perfs"]) + 1
	career["gold_earned"] = int(career["gold_earned"]) + last_pay
	career["tricks"] = int(career["tricks"]) + tricks_landed
	career["best_score"] = maxf(float(career["best_score"]), score)
	career["best_streak"] = maxi(int(career["best_streak"]), best_streak)
	# the record board keys off the act's score. A Purist act writes to the Purist
	# board and never the assisted one.
	results_record = false
	if run_venue >= 0 and run_venue < rec_table().size() and score > rec_table()[run_venue]:
		rec_table()[run_venue] = score
		results_record = true
	# THE WIN: a record at the World Arena clears the game once, the first time, after the
	# results card is dismissed. The career then plays on freely, records still to chase.
	if run_venue >= TOP_VENUE and results_record and not won:
		won = true
		pending_win = true
	# THE DEMO WALL: venue_index() is capped inside a demo build, but Reputation
	# keeps climbing underneath regardless (nothing about earning it is scoped) -
	# the moment it would have unlocked a venue the demo does not have, say so
	# once, the same shape as the win above, then let the player keep playing
	# whatever they already have. venue_index_of(reputation) here is deliberately
	# the UNCAPPED tier - venue_index() itself would never trip this check.
	if in_demo_build() and not demo_wall_seen and venue_index_of(reputation) > DEMO_MAX_VENUE:
		demo_wall_seen = true
		pending_demo_wall = true
	# THE POST-WIN CHASE, cheap version (Still open): gated on won so it can only ever
	# land as a NEXT challenge, never as a surprise substitute for the real win. This
	# act may have just written the final missing Purist record into best_scores_purist
	# above (rec_table() returns that same array by reference when purist is set), so
	# the completion check belongs here, after that write, not before it.
	if won and not purist_legend_seen and purist_legend_complete():
		purist_legend_seen = true
		pending_purist_legend = true
	daily_share = ""
	if daily_active:
		# stamped once, off the FINAL (post-collapse-strip) score, and pushed to the
		# clipboard right away so a player who cashes in and quits still has it -
		# the results card shows the same string, never a second, later computation
		var enc_name := String(ENCORES[encore]["name"]) if encore >= 0 and encore < ENCORES.size() else "no Encore"
		var outcome := "all 3 goals" if complete else "%d/%d goals" % [goals_hit, NUM_GOALS]
		daily_share = GAME_TITLE + " Daily %d-%02d-%02d  -  %s, %s  -  %s  -  %s pts  -  best streak %d" % [
			int(daily_seed() / 10000), int(daily_seed() / 100) % 100, daily_seed() % 100,
			String(venue_data(run_venue)["name"]), enc_name, outcome, score_text(score), best_streak]
		DisplayServer.clipboard_set(daily_share)
	results_open = true
	results_tick = tick
	results_stamped = false
	save_progress()
	if _demo:
		# dev: report the whole-act outcome, so --demo --booking is a one-shot end-to-end
		# check of the resolve path (goals, stripping, pay, rep)
		print("ACT venue=%d prop=%d n=%d goals=%d/%d collapsed=%s score=%s pay=%d rep=%+d record=%s ticks=%d flowers=%d tomatoes=%d ovation=%d peakappl=%.2f" % [
			run_venue, prop_type, num_balls, goals_hit, NUM_GOALS, str(set_collapsed),
			score_text(score), last_pay, last_rep_delta, str(results_record), tick, run_flowers,
			run_tomatoes, ovation_bonus, peak_applause])
		if daily_active:
			print(daily_share)
		# ...and quit ONLY once the ovation has played out. Quitting on the spot meant the
		# harness could never reach the one path that only a perfect act takes, so the
		# rain and its bonus had no automated coverage at all - and a screenshot of it was
		# impossible, since the process was gone the frame the act ended. The line above
		# still prints at the same moment, so nothing reading the log changes.
		if ovation_left <= 0:
			get_tree().quit()
		else:
			_demo_quit_after_ovation = true


func stamina_mult() -> float:
	# full effect until Stamina drops under STAM_LOW, then ramps down to STAM_MIN_MULT
	var f := stamina / maxf(1.0, stamina_max)
	if f >= STAM_LOW:
		return 1.0
	return lerpf(STAM_MIN_MULT, 1.0, clampf(f / STAM_LOW, 0.0, 1.0))


func slow_target() -> float:
	# where the slow amount is HEADING, 0..1. All sources stack linearly
	# (ideas.rtf): the Speed stat, Uncle Dan's Pie (all day), an Amazing!
	# frame-perfect catch, and an earned fifty-Perfect thirty-second window. Purist sets
	# strip the bought shares but keep the earned bursts (those are skill).
	var a := 0.0 if purist_run() else float(mini(speed, SPEED_CAP)) / 8.0 / 100.0
	if pie_active and not purist_run():
		a += PIE_SLOW
	if _frames < amazing_until:
		a += BURST_SLOW
	if _frames < chain_until:
		a += BURST_SLOW
	if tut_active:
		a = maxf(a, tut_slow())   # a lesson sets a FLOOR on slowness, never a sum: it
								  # must not stack with a Pie into a frozen world. The
								  # basics open AT the cap (Louis: max slowmo, and max
								  # is the same 50% the whole game answers to)
	# the hard ceiling (Louis): past 50% the stepped sim reads as jitter, and 50%
	# is the intended best case anyway - fully invested Speed plus a Pie plus one
	# earned burst reaches it, so the stack only peaks when everything aligns
	return clampf(a, 0.0, SLOW_TOTAL_CAP)


func tut_slow() -> float:
	# the lesson's own slow-motion floor, and now always the step's OWN pinned value:
	# every drill step is built by tut_paced, which writes one of TUT_PHASES into it,
	# and the few one-off key-teaching steps pin their own. Nothing is derived from how
	# far through the lesson we are any more, and nothing is earned or lost mid-step -
	# the pace is a property of the pass being run, which is what makes "half speed,
	# then quarter, then full" a promise the lesson can actually keep.
	var steps := tut_lesson(tut_id)
	if tut_step >= 0 and tut_step < steps.size():
		var s: Dictionary = steps[tut_step]
		if s.has("slow"):
			return clampf(float(s["slow"]), 0.0, 1.0)
	return TUT_SLOW_START


func slow_amount() -> float:
	return _slow_cur   # the live value, always easing linearly (see SLOW_RAMP)


func purist_run() -> bool:
	# a PURIST booking strips the stat comforts from the catch maths, so its records are
	# pure skill. The Purist's Night Encore does the same to a single set. Which RECORD
	# board a night writes to still keys off the booking's `purist` flag, not this - so a
	# Purist Encore only makes the third set harder, it does not relabel the whole booking.
	# Training is never purist (practice is practice).
	return (purist and mode == MODE_PERFORM) or encore_on("purist")


func eff_accuracy() -> float:
	if purist_run():
		return clampf(5.0 * stamina_mult(), 0.0, 100.0)   # a fresh juggler's hands
	return clampf(float(accuracy) * stamina_mult(), 0.0, 100.0)


func inacc_factor() -> float:
	# 1.0 of the base inaccuracy at Accuracy 0, ACC_MIN_FACTOR at Accuracy 100.
	# Never reaches zero, so a max-height throw always still needs a real catch.
	return lerpf(1.0, ACC_MIN_FACTOR, eff_accuracy() / 100.0)


func catch_chance(quality: int, height: float) -> float:
	# probability that an off-Perfect catch (quality 1 = Good, 2 = Late) secures.
	# Rises with Accuracy and falls with the throw's height. Perfect timing is
	# handled separately in on_catch.
	if tut_active:
		return 1.0   # a lesson never punishes a reasonable attempt with an unseen dice
					 # roll. A total MISS still loses the ball (MISTIME/MISS_GRACE reach
					 # drop_ball), so whiffing entirely is still taught.
	var acc_norm := clampf(eff_accuracy() / ACC_FULL, 0.0, 1.0)
	var base := GOOD_BASE if quality == 1 else LATE_BASE
	var p := base + acc_norm * ACC_CATCH_BONUS - clampf(height, 0.0, 1.4) * HEIGHT_CATCH_PENALTY
	p += float(PROPS[prop_type]["fgive"])   # clubs are intrinsically forgiving: a better off-Perfect
	if wearing("gloves"):
		p += GLOVES_FGIVE   # SILK GLOVES give every prop what a club has by nature. Comfort
							 # axis only: it moves the off-Perfect ODDS, never the Perfect
							 # window itself, so the timing floor is exactly where it was
											# catch than their weight implies. A property of the prop
											# itself (like its weight), so it stands even in a Purist run.
	if not purist_run():
		p += strength_catch_mod()  # raw muscle steadies a heavy prop in the hand (and only a
								   # too-weak grip on a heavy prop makes the catch itself shaky)
		if wearing("glasses"):
			p += GLASSES_CATCH_BONUS   # bought gear lifts the odds of an off-Perfect catch
	if spinning():
		p -= SPIN_ACC_PENALTY      # a Spin means catching blind, so off-Perfect gets riskier
	return clampf(p, MIN_CATCH_P, 1.0)


func strength_surplus() -> float:
	# how far Strength exceeds the CURRENT prop's requirement, as a fraction of the
	# remaining room up to the stat's REAL cap. The old hardcoded 100 here was the
	# previous ceiling: with the cap at 200 it silently froze every benefit past
	# Strength 100, which (with the last ball gate at 165) made points above ~170
	# worth nothing at all (Louis). Now every point from the requirement to 200
	# pays out the same linear slice, for every prop.
	var req := prop_req()
	if req <= 0 or strength <= req:
		return 0.0
	return clampf((float(strength) - float(req)) / maxf(1.0, float(STR_CAP) - float(req)), 0.0, 1.0)


func strength_catch_mod() -> float:
	# How Strength changes the catch of the CURRENT prop. Light props (balls, eggs) are
	# unaffected. For a heavy prop, being well OVER its Required Strength steadies it and
	# eases the catch; being UNDER it makes even the catch shaky. Scales with the prop's
	# weight, so the top props gain the most from raw muscle, and it is never a height or
	# timing change, only a small nudge to the off-Perfect odds.
	var w := prop_weight() - 1                 # 0 for balls/eggs, up to 4 for torches
	var req := prop_req()
	if w <= 0 or req <= 0:
		return 0.0
	if strength > req:
		return strength_surplus() * float(w) * STRENGTH_CATCH
	var ratio := clampf(float(strength) / float(req) - 1.0, -1.0, 0.0)   # -1 hopeless, 0 just enough
	return ratio * float(w) * STRENGTH_CATCH


func focus() -> float:
	# Accuracy trained beyond 100 becomes Focus. Catch maths still cap at 100
	# (see eff_accuracy), so Focus never makes catching easier, only cheaper and,
	# very late, a touch more forgiving on the Perfect window.
	return maxf(0.0, float(accuracy) - 100.0)


func focus_stam_mult() -> float:
	# Stage 1: Focus 0..100 lowers every action's stamina cost toward a floor.
	return lerpf(1.0, FOCUS_STAM_FLOOR, clampf(focus() / 100.0, 0.0, 1.0))


func perfect_window() -> int:
	# Stage 2: once stage 1 has bottomed out (Focus > 100), each FOCUS_WINDOW_PER
	# of further Focus widens the Perfect band by a tick, capped at the Good band
	# (W_GOOD) so timing still rules. At the Accuracy cap (250) the window reaches
	# exactly W_GOOD, which FOLDS the Good tier into Perfect - those catches simply
	# score Perfect instead, a generous reward for maxing Accuracy, not a lost tier.
	# Below the cap a Good band still sits between Perfect and Late.
	if tut_active:
		return W_LATE   # in a lesson, ANY in-window press is a Perfect: a beginner
						# should never fail a catch they reasonably attempted. The real
						# windows return the instant the lesson ends.
	var w := W_PERFECT
	if not purist_run():           # no Focus widening on the Purist board
		var extra := focus() - 100.0
		var bonus := 0
		if extra > 0.0:
			bonus = mini(FOCUS_WINDOW_MAX, int(extra / FOCUS_WINDOW_PER))
		w = mini(W_GOOD, W_PERFECT + bonus)
	if encore_on("cold"):
		w = maxi(2, w - 2)         # Cold Hands: the Perfect window is two ticks tighter
	# heavier props ask for tighter timing (clubs stay forgiving for their weight, torches
	# tightest) - the difficulty half of the per-prop character. Floored so the sum of a
	# heavy prop AND Cold Hands is still humanly hittable.
	w = maxi(PWIN_FLOOR, w + int(PROPS[prop_type]["pwin"]))
	return w


func run_clean() -> float:
	if caught + dropped <= 0:
		return 1.0
	return float(caught) / float(caught + dropped)


func run_grade() -> String:
	# a single letter that reads the whole set: cleanliness carries it, the crowd's
	# high point and a long streak lift it. Skill first, so clean play dominates.
	var q := 0.55 * run_clean() + 0.28 * peak_applause + 0.17 * clampf(float(best_streak) / 25.0, 0.0, 1.0)
	if q >= 0.90:
		return "S"
	if q >= 0.78:
		return "A"
	if q >= 0.62:
		return "B"
	if q >= 0.42:
		return "C"
	return "D"


func grade_color(g: String) -> Color:
	match g:
		"S": return Color(1.0, 0.86, 0.42)
		"A": return Color(0.7, 0.95, 0.62)
		"B": return Color(0.62, 0.86, 0.98)
		"C": return Color(0.9, 0.8, 0.6)
		_: return Color(0.95, 0.55, 0.45)


const REP_TIER_NAMES := ["Unknown", "Street Name", "Rising Talent", "Known Act",
	"Headliner", "Renowned", "Legend"]

func rep_tier() -> String:
	# READ OFF VENUE_REP, never a second copy of the same numbers. These thresholds used
	# to be six hard-coded literals that happened to match the ladder - so re-balancing
	# the ladder (2026-07-27) would have left a player standing at the World Arena still
	# being called a Headliner, with nothing in the code to say the two were related.
	var t := 0
	for i in VENUE_REP.size():
		if reputation >= int(VENUE_REP[i]):
			t = i
	return REP_TIER_NAMES[clampi(t, 0, REP_TIER_NAMES.size() - 1)]


                                                           # (rebalanced 2026-07-27: the
# first two doors are CHEAPER, because the early career is where Louis found the climb
# too steep, and the last three are DEARER, to pay for the experience bonus that is by
# then adding up to +20 a night. The ladder was almost exactly doubling; it now grows a
# little faster than that, which is the "slightly exponentially growing amounts" the
# bonus is balanced against. Was [0, 100, 300, 700, 1500, 3000, 6000].)
const VENUE_REP := [0, 80, 260, 700, 1700, 4000, 9000]    # reputation at each venue's
														   # door; 6000 is also Legend,
														   # rep_tier()'s top rank
const TOP_VENUE := 5   # the World Arena: the summit of the climb, where the game is won -
						# UNCHANGED (2026-07-18): The Midnight Show is bonus content
						# reachable only AFTER winning, never a new win condition
const MAX_VENUE := 6   # the last real venue index (The Midnight Show); distinct from
						# TOP_VENUE, which specifically means "the win venue" and must
						# never move
const DEMO_MAX_VENUE := 1   # a SCOPED FREE DEMO (Still open) never lets venue_index() go
							 # past this, however high Reputation actually climbs - only
							 # inside a build exported with the custom_features "demo" tag
							 # (OS.has_feature("demo")), never a real release. Tunable: 1
							 # is Backyard + Street Corner, enough to feel the loop and the
							 # first couple of unlocks without giving away the game - Louis's
							 # call, change the one number to give away more or less.


#endregion

#region VENUES & PROPS
func debug_jump_venue(i: int) -> void:
	# debug: leap up the ladder by setting Reputation to a venue's door, then land
	# in the day so the higher stages can be played at once (no story to replay).
	# Clamps to MAX_VENUE, not TOP_VENUE (2026-07-18: those are no longer the same
	# thing - The Midnight Show sits past the win venue), and forces `won` too,
	# since venue 7 is gated on both.
	i = clampi(i, 0, MAX_VENUE)
	if i >= MAX_VENUE:
		won = true
	reputation = maxi(reputation, VENUE_REP[i])
	venue_pick = i
	save_progress()
	enter_day()


func in_demo_build() -> bool:
	# true in a real export tagged with the "demo" custom feature, OR under the
	# dev-only --demowall override (see _force_demo) - every demo-scoping check
	# reads THIS, never OS.has_feature("demo") directly, so the dev flag actually
	# exercises the same code path a real demo export would.
	return OS.has_feature("demo") or _force_demo


func venue_index() -> int:
	# the ONE gameplay-facing "how far can you go right now" - every real gate
	# (play_venue, the venue picker, a skill's own venue requirement, daily_venue)
	# reads THIS, not venue_index_of directly, so a demo cap here reaches every one
	# of them for free. venue_index_of(rep) itself stays uncapped on purpose - the
	# rep-swing math and the demo-wall detection in resolve_act() both need the
	# TRUE tier Reputation has actually earned, capped or not.
	var idx := venue_index_of(reputation)
	if in_demo_build():
		idx = mini(idx, DEMO_MAX_VENUE)
	return idx


func venue_index_of(rep: int) -> int:
	# the stage you play grows as Reputation climbs, six rungs to the World Arena -
	# The Midnight Show (2026-07-18) is a 7th, bonus rung on TOP of that: it asks
	# BOTH Legend reputation AND `won` (Louis: post-game content, never reachable
	# before the real win, however high reputation alone happens to climb)
	# THE FOURTH AND LAST READER OF THIS LADDER, and the one that actually opens the
	# doors - so it is the one a stale copy would hurt most. It held its own six literals
	# (100/300/700/1500/3000/6000) until 2026-07-27, when the ladder was re-balanced and
	# every one of them silently disagreed with VENUE_REP. rep_tier() and next_venue_rep()
	# had the same bug. All four read the constant now: **VENUE_REP is the ladder, and
	# nothing else may restate it.**
	if rep >= int(VENUE_REP[MAX_VENUE]) and won:
		return MAX_VENUE
	for i in range(TOP_VENUE, 0, -1):
		if rep >= int(VENUE_REP[i]):
			return i
	return 0


func cur_venue() -> int:
	# menu/results screens and previews (e.g. the Controls screen's backdrop) can
	# override which venue palette we render; view_venue < 0 means no override
	return view_venue if view_venue >= 0 else play_venue()


func venue_data(i: int) -> Dictionary:
	# per-venue palette: backdrop glow / floor / spotlight strength, and the
	# juggler's costume, so each rung of the career looks distinct while sharing
	# the warm theatrical base (ART_AND_MUSIC.md).
	match i:
		0:
			return {"name": "Backyard", "glow": Color(0.55, 0.62, 0.45), "floor": Color(0.09, 0.10, 0.07), "spot": 0.03,
				"suit": Color(0.42, 0.36, 0.28), "suit_dk": Color(0.30, 0.25, 0.19), "vest": Color(0.66, 0.58, 0.40), "collar": Color(0.85, 0.82, 0.72)}
		1:
			return {"name": "Street Corner", "glow": Color(0.95, 0.66, 0.34), "floor": Color(0.07, 0.07, 0.10), "spot": 0.05,
				"suit": Color(0.34, 0.36, 0.46), "suit_dk": Color(0.22, 0.24, 0.33), "vest": Color(0.70, 0.62, 0.42), "collar": Color(0.88, 0.86, 0.78)}
		2:
			return {"name": "Small Theatre", "glow": Color(0.95, 0.55, 0.28), "floor": Color(0.10, 0.05, 0.06), "spot": 0.05,
				"suit": Color(0.62, 0.16, 0.20), "suit_dk": Color(0.44, 0.10, 0.15), "vest": Color(0.90, 0.73, 0.42), "collar": Color(0.96, 0.90, 0.80)}
		3:
			return {"name": "The Circus", "glow": Color(0.98, 0.48, 0.35), "floor": Color(0.12, 0.06, 0.05), "spot": 0.06,
				"suit": Color(0.80, 0.22, 0.24), "suit_dk": Color(0.55, 0.14, 0.16), "vest": Color(0.96, 0.80, 0.40), "collar": Color(0.98, 0.93, 0.82)}
		4:
			return {"name": "Championship", "glow": Color(0.55, 0.68, 0.95), "floor": Color(0.06, 0.07, 0.11), "spot": 0.07,
				"suit": Color(0.20, 0.28, 0.52), "suit_dk": Color(0.13, 0.19, 0.38), "vest": Color(0.80, 0.84, 0.92), "collar": Color(0.90, 0.93, 0.98)}
		5:
			return {"name": "World Arena", "glow": Color(0.78, 0.52, 0.96), "floor": Color(0.09, 0.06, 0.12), "spot": 0.08,
				"suit": Color(0.42, 0.20, 0.55), "suit_dk": Color(0.28, 0.12, 0.40), "vest": Color(0.96, 0.82, 0.45), "collar": Color(0.98, 0.94, 0.86)}
		_:
			# The Midnight Show (2026-07-18): the bonus, post-game 7th stage - a
			# genuinely DARK house (spot half of even the Backyard's, the dimmest
			# of the original six) so the Glow-in-the-Dark Kit has somewhere it is
			# actually worth wearing. The costume carries the whole theme: a suit
			# that nearly vanishes into the dark, and a vest the same phosphor
			# green as the Kit's own halo, so the performer visibly glows.
			# `veil` 0.10: this set is already the darkest in the game, so the standard
			# 0.42 push-back had nothing left to take and simply erased it (see the note
			# at the veil in draw_backdrop). The floor is lifted off pure black for the
			# same reason - a dark room is not an unlit one, and the boards have to read
			# as boards for a landed prop to read as landed.
			return {"name": "The Midnight Show", "glow": Color(0.40, 0.92, 0.62), "floor": Color(0.045, 0.075, 0.06), "spot": 0.015,
				"veil": 0.10,
				"suit": Color(0.08, 0.10, 0.09), "suit_dk": Color(0.04, 0.05, 0.045), "vest": Color(0.55, 0.95, 0.65), "collar": Color(0.75, 0.92, 0.8)}


func cur_prop() -> Dictionary:
	return PROPS[prop_type]


func prop_req(kind: int = -1) -> int:
	return int(PROPS[prop_type if kind < 0 else kind]["req"])


func prop_weight(kind: int = -1) -> int:
	return int(PROPS[prop_type if kind < 0 else kind]["weight"])


func prop_deficit() -> float:
	# how far below the prop's Required Strength we are, 0 (fine) to 1 (hopeless)
	var req := prop_req()
	if req <= 0 or strength >= req:
		return 0.0
	return clampf(float(req - strength) / float(req), 0.0, 1.0)


func have(kind: int) -> int:
	# EVERY prop is owned by quantity now, balls included (Louis: they don't appear
	# out of thin air) - a fresh save starts with three, the shop sells the rest
	return prop_count[kind]


func available(kind: int) -> bool:
	# selectable only if you own enough to juggle the minimum count
	return have(kind) >= MIN_BALLS


func prop_color(kind: int) -> Color:
	match kind:
		PROP_EGGS:    return Color(0.96, 0.92, 0.82)
		PROP_RINGS:   return Color(0.45, 0.80, 0.95)
		PROP_CLUBS:   return Color(0.90, 0.35, 0.38)
		PROP_KNIVES:  return Color(0.82, 0.86, 0.92)
		PROP_TORCHES: return Color(1.0, 0.62, 0.24)
		PROP_CHAINSAW: return Color(0.96, 0.58, 0.14)
		_:            return Color(1.0, 0.82, 0.35)


func prop_scale(kind: int) -> float:
	# heavier and longer props are physically bigger than balls, so they read larger
	match kind:
		PROP_RINGS:   return 1.7
		PROP_CLUBS:   return 1.6
		PROP_KNIVES:  return 1.5
		PROP_TORCHES: return 1.75
		PROP_CHAINSAW: return 1.9
		PROP_EGGS:    return 1.1
		_:            return 1.0


const RING_HIT_FACTOR := 0.65  # rings are mostly hole - the true catchable rim reads far
								# smaller than the drawn ring's full diameter (Louis), so
								# their hitbox is always shrunk by this factor, on TOP of
								# the many-object squeeze below. Tune here if it feels off.

func _coll_pair(pa: Vector2, pb: Vector2, a: Ball, b: Ball) -> String:
	# one line naming WHERE the closest pass happened and what each prop was doing:
	# `ot` is the over-the-top road (so a Shower/Half Shower report says which of the two
	# roads each prop was on), `h` the height fraction it was thrown at, `p` how far
	# through its flight it was. Shared by both the hitbox and the drawn-size minimum.
	var prog := func(x: Ball) -> float:
		return clampf(float(tick - x.launch_tick) / float(maxi(1, x.land_tick - x.launch_tick)), 0.0, 1.0)
	return "tick %d  a=(%.0f,%.0f ot=%s h=%.2f p=%.2f)  b=(%.0f,%.0f ot=%s h=%.2f p=%.2f)" % [
		tick, pa.x, pa.y, str(a.over_top), a.height, prog.call(a),
		pb.x, pb.y, str(b.over_top), b.height, prog.call(b)]


func prop_hit_scale(_kind: int) -> float:
	# ONE HITBOX (2026-07-29, Louis: "right now i feel like some patterns use different hitboxes
	# for each prop. I want only one hitbox, such that the pattern that is most picky: eg 15
	# chainsaw columns, still works as expected").
	#
	# It used to be three shrinks multiplied together - a per-PROP one so a club's bulk faded
	# toward a ball's, a per-COUNT one on a ~1/count curve, and a per-PATTERN one off
	# PATTERNS["room"]. Each was individually well reasoned, and the three together meant no two
	# situations shared a collision rule: "does this pattern work at this count with this prop"
	# had 6 x 13 x 7 different answers, and tuning any one moved the others. That is the thing
	# he is describing.
	#
	# Now: one number, small enough that the tightest real geometry in the game - fifteen
	# chainsaws in Columns, which the lane arithmetic packs to about 9px of daylight - has room
	# to run. A clack is therefore a genuine collision at any count rather than a threshold that
	# moved under the player. PATTERNS["room"] is unread now; it stays in the table because it
	# is a measured fact about each pattern and whoever tunes collisions next will want it.
	return HIT_FLOOR


func invest(which: String) -> void:
	if points <= 0:
		return
	var prev_max := max_balls()   # Strength may cross a ball-count gate; catch it below
	# a capped stat refuses the point instead of eating it (Speed always did; the
	# others used to consume the point and change nothing)
	match which:
		"acc":
			if accuracy >= ACC_CAP:
				return
			accuracy += 1   # past 100 becomes Focus
		"str":
			if strength >= STR_CAP:
				return
			strength += 1
		"end":
			if endurance >= END_CAP:
				return
			endurance += 1
			stamina_max = 100.0 + 9.0 * float(endurance)
		"spd":
			if speed >= SPEED_CAP:
				return   # the permanent slow tops out (ideas.rtf): no point wasted
			speed += 1
	points -= 1
	check_ball_unlock(prev_max)   # a new ball count queues its own lesson at the hub
	announce_unlocks()            # a stat spend can cross a skill's Strength/Accuracy ask
	save_progress()


func _sheet_invest(which: String) -> void:
	if debug_mode:
		_adjust(which, 1)   # debug build: free, no point cost
	else:
		invest(which)


func sheet_repeat(dt: float) -> void:
	# debug build only: while the character sheet is open, HOLDING a stat-adjust key keeps
	# stepping the stat instead of one press per point. The first press was already applied
	# by _input, so a freshly held key waits SHEET_REPEAT_DELAY before it starts repeating.
	# Normal (non-debug) play never calls this, so there it stays one point per press.
	var key := 0
	var which := ""
	var delta := 0
	if Input.is_physical_key_pressed(KEY_1):
		key = KEY_1; which = "acc"; delta = 1
	elif Input.is_physical_key_pressed(KEY_2):
		key = KEY_2; which = "str"; delta = 1
	elif Input.is_physical_key_pressed(KEY_3):
		key = KEY_3; which = "end"; delta = 1
	elif Input.is_physical_key_pressed(KEY_4):
		key = KEY_4; which = "spd"; delta = 1
	elif Input.is_physical_key_pressed(KEY_R):
		key = KEY_R; which = "spd"; delta = -1
	elif Input.is_physical_key_pressed(KEY_Q):
		key = KEY_Q; which = "acc"; delta = -1
	elif Input.is_physical_key_pressed(KEY_W):
		key = KEY_W; which = "str"; delta = -1
	elif Input.is_physical_key_pressed(KEY_E):
		key = KEY_E; which = "end"; delta = -1
	# ...AND THE PURSE, on the same mechanism (2026-07-28, Louis: "make the debug money up
	# button (m) and down, be able to held to rapidly increase amounts (toggle by the
	# thousand)"). Two presses were needed for every 100 gold, and the things worth testing
	# cost 60,000 - which is twelve hundred presses of M to reach the Glow Kit.
	#
	# A TAP AND A HELD REPEAT ARE THE SAME THOUSAND, and the hold then ACCELERATES on the
	# same SHEET_REPEAT_RAMP curve the stats use - so a tap is a thousand, a second of
	# holding is several, and three seconds crosses the whole economy.

	elif Input.is_physical_key_pressed(KEY_M):
		key = KEY_M; which = "money"; delta = MONEY_HOLD_STEP
	elif Input.is_physical_key_pressed(KEY_N):
		key = KEY_N; which = "money"; delta = -MONEY_HOLD_STEP
	if key == 0:
		if _repeat_key != 0 and _repeat_dirty:
			save_progress()   # ...and the disk is written ONCE, on release. See below.
			_repeat_dirty = false
		_repeat_key = 0
		return
	if key != _repeat_key:
		_repeat_key = key       # newly held: hold off until the initial delay elapses
		_repeat_t = -SHEET_REPEAT_DELAY
		_repeat_held = 0.0
		return
	# ...and it ACCELERATES the longer it is held (Louis, 2026-07-27: "rapidly change
	# their values"). A flat 25 points a second takes eight seconds to walk Accuracy to
	# its cap, which is eight seconds of holding a key to set up one test. The rate
	# doubles every SHEET_REPEAT_RAMP seconds, up to SHEET_REPEAT_MAX steps a tick, so a
	# brief tap is still one point and a long hold crosses the whole range in a moment.
	_repeat_t += dt
	_repeat_held += dt
	var cap := MONEY_HOLD_MAX if which == "money" else SHEET_REPEAT_MAX
	var burst := clampi(int(pow(2.0, _repeat_held / SHEET_REPEAT_RAMP)), 1, cap)
	# ONE _adjust PER REPEAT, WITH THE BURST FOLDED INTO THE AMOUNT for money. A stat is
	# clamped to a cap, so stepping it `burst` times and stepping it once by `burst` are
	# genuinely different at the ceiling and the loop is correct there. A purse has no cap,
	# so the loop would just be MONEY_HOLD_MAX identical save_progress() calls a tick - up
	# to sixty-four disk writes per repeat, which is what makes a held key stutter.
	while _repeat_t >= SHEET_REPEAT_RATE:
		_repeat_t -= SHEET_REPEAT_RATE
		if which == "money":
			_repeat_dirty = true
			money = maxi(0, money + delta * burst)
		else:
			for _i in burst:
				_adjust(which, delta)


func _adjust(which: String, delta: int) -> void:
	var prev_max := max_balls()
	match which:
		"acc":
			accuracy = clampi(accuracy + delta, 1, ACC_CAP)
		"str":
			strength = clampi(strength + delta, 1, STR_CAP)
		"end":
			endurance = clampi(endurance + delta, 0, END_CAP)
			stamina_max = 100.0 + 9.0 * float(endurance)
			stamina = minf(stamina, stamina_max)
		"spd":
			speed = clampi(speed + delta, 0, SPEED_CAP)
		"money":
			# debug only, and it is a PURSE, not a stat - no cap, no ball unlock, and it
			# floors at nothing rather than at one
			money = maxi(0, money + delta)
	check_ball_unlock(prev_max)
	save_progress()


func save_file() -> String:
	# debug_mode stays first so --demo --debug (used to preview venues) still lands
	# on the debug save. Otherwise, any unattended dev autoplay writes to its own
	# scratch file and must never touch a real career slot.
	if debug_mode:
		return SAVE_PATH_DEBUG
	if _demo or _shot:
		return SAVE_PATH_DEMO
	return slot_path(save_slot)


func _migrate_lesson_id(id: String) -> String:
	# the four routine-reshaping toggles became PATTERNS (one pattern at a time,
	# Louis), so their old trick-lesson ids map to the pattern lessons that
	# replaced them. Every other id passes through untouched.
	match id:
		"trick_cols": return "pattern_columns"
		"trick_rcasc": return "pattern_rcasc"
		"trick_tennis": return "pattern_tennis"
	return id


func load_progress() -> void:
	var cf := ConfigFile.new()
	if cf.load(save_file()) == OK:
		accuracy = int(cf.get_value("stats", "accuracy", 5))
		strength = int(cf.get_value("stats", "strength", 6))
		endurance = int(cf.get_value("stats", "endurance", 0))
		speed = int(cf.get_value("stats", "speed", 0))
		pie_count = int(cf.get_value("stats", "pies", 0))
		pie_active = bool(cf.get_value("day", "pie_active", false))
		money = int(cf.get_value("stats", "money", START_GOLD))
		tomatoes = int(cf.get_value("stats", "tomatoes", 0))
		reputation = int(cf.get_value("stats", "reputation", 0))
		sync_props()
		var pc: Variant = cf.get_value("stats", "prop_count", [])
		if pc is Array:
			for i in mini((pc as Array).size(), prop_count.size()):
				prop_count[i] = int((pc as Array)[i])
		# balls used to be free and unlimited, so old saves stored 0 of them: every
		# save keeps at least the starting kit of three (balls are stock now)
		prop_count[PROP_BALLS] = maxi(prop_count[PROP_BALLS], 3)
		prop_type = int(cf.get_value("stats", "prop_type", PROP_BALLS))
		# an old save wrote ONE "glow_kit" flag; it means both halves, which is exactly
		# what it bought. Read it as the default for each so nobody loses a 60,000 item.
		var old_kit := bool(cf.get_value("stats", "glow_kit", false))
		has_glow_tape = bool(cf.get_value("stats", "glow_tape", old_kit))
		has_backroom = bool(cf.get_value("stats", "backroom", false))
		energy_drinks = int(cf.get_value("stats", "energy_drinks", 0))
		level = int(cf.get_value("prog", "level", 1))
		xp = int(cf.get_value("prog", "xp", 0))
		points = int(cf.get_value("prog", "points", 0))
		won = bool(cf.get_value("prog", "won", false))
		demo_wall_seen = bool(cf.get_value("prog", "demo_wall_seen", false))
		purist_legend_seen = bool(cf.get_value("prog", "purist_legend_seen", false))
		var bs: Variant = cf.get_value("prog", "best_scores", [])
		if bs is Array:
			for i in mini((bs as Array).size(), best_scores.size()):
				best_scores[i] = float((bs as Array)[i])
		var bp: Variant = cf.get_value("prog", "best_scores_purist", [])
		if bp is Array:
			for i in mini((bp as Array).size(), best_scores_purist.size()):
				best_scores_purist[i] = float((bp as Array)[i])
		pattern_ver = int(cf.get_value("prog", "pattern_ver", 0))
		var raw_pattern_sel := int(cf.get_value("prog", "pattern_sel", CASCADE))
		if pattern_ver < 2:
			# migrate a pre-2026-07-19 save straight from PATTERNS' ORIGINAL 8-entry
			# layout (Cascade0 Fountain1 Columns2 HalfShower3 Shower4 RCasc5
			# Waterfall6 Tennis7) to the current one in a single jump - no real save
			# was ever written in the brief intermediate 7-entry (Waterfall-removed-
			# only) shape, so there is nothing between "pre-migration" and "current"
			# worth stepping through. Fountain and Waterfall both fold into their
			# closest surviving relative rather than silently becoming whatever now
			# sits at their old index once (each shifted by their own amount).
			match raw_pattern_sel:
				0, 1: raw_pattern_sel = CASCADE       # Cascade itself, or Fountain folded in
				2: raw_pattern_sel = COLUMNS
				3: raw_pattern_sel = HALFSHOWER
				4: raw_pattern_sel = SHOWER
				5: raw_pattern_sel = RCASC
				6: raw_pattern_sel = HALFSHOWER       # Waterfall folded into Half Shower
				7: raw_pattern_sel = TENNIS
				_: raw_pattern_sel = CASCADE          # anything unrecognised: the safe default
			pattern_ver = 2
		pattern_sel = clampi(raw_pattern_sel, 0, PATTERNS.size() - 1)
		var cr: Variant = cf.get_value("prog", "career", {})
		if cr is Dictionary:
			for k in career:
				if (cr as Dictionary).has(k):
					career[k] = int((cr as Dictionary)[k])
		# lessons already taught, and lessons queued but not yet taught, both persist -
		# without this an unlock lesson (Phase 1) re-fired every launch (the seen_tuts bug).
		# Ids run through _migrate_lesson_id: a save from before the pattern fold may
		# still hold the four routine toggles as trick lessons.
		var st: Variant = cf.get_value("prog", "seen_tuts", [])
		if st is Array:
			seen_tuts.clear()
			for v in (st as Array):
				seen_tuts.append(_migrate_lesson_id(String(v)))
		var pt: Variant = cf.get_value("prog", "pending_tuts", [])
		if pt is Array:
			pending_tuts.clear()
			for v in (pt as Array):
				pending_tuts.append(_migrate_lesson_id(String(v)))
		# the standing ante per venue (complete acts there): the raised bar the venue
		# remembers between visits. The rest of the act is per-night and unsaved.
		var an: Variant = cf.get_value("prog", "ante", [])
		if an is Array:
			for i in mini((an as Array).size(), ante.size()):
				ante[i] = int((an as Array)[i])
		# the reward director's memory: gifts stay given, the drought clock survives
		var gf: Variant = cf.get_value("prog", "gifted", [])
		if gf is Array:
			gifted.clear()
			for v in (gf as Array):
				gifted.append(String(v))
		perfs_since_unlock = int(cf.get_value("prog", "perfs_since_unlock", 0))
		aid_pie_day = int(cf.get_value("prog", "aid_pie_day", -1))
		aid_meal_used = bool(cf.get_value("prog", "aid_meal_used", false))
		purist = bool(cf.get_value("day", "purist", false))
		day = int(cf.get_value("day", "day", 1))
		seg_used = int(cf.get_value("day", "seg_used", 0))
		venue_pick = int(cf.get_value("day", "venue_pick", -1))
		meals = int(cf.get_value("day", "meals", 0))
	# A SAVE FROM BEFORE THE CARDS OWNED ITS SKILLS IMPLICITLY (2026-07-28) - and this
	# migration is the part with teeth. Until today a skill was unlocked by STANDING PAST
	# ITS WALL: nothing was written down, `gifted` held only the handful the pity director
	# had granted, and every other skill was recomputed from the stats on every launch.
	# Ownership is explicit now, so loading an old save without this would silently strip a
	# mid-career juggler of every trick and pattern they had ever earned - the save file
	# would look intact and the player would open the Skills screen to find it empty.
	#
	# So: seed `gifted` with everything whose wall this save has ALREADY cleared, which is
	# exactly the set that was unlocked a moment before the update. `skill_ver` marks it
	# done, once, per save. Nothing is taken away and nothing new is granted.
	# every wear flag defaults TRUE, so a career from before the tailor existed opens
	# dressed in everything it owns rather than stripped by an update it never asked for
	outfit_suit = int(cf.get_value("wear", "suit", -1))
	# WHAT IS OWNED, AND WHAT IS ON. Both are flat lists keyed by "<piece>:<stage>", so adding
	# a ninth garment or an eighth house needs no migration at all.
	var ow: Variant = cf.get_value("wear", "owned", [])
	owned_wear.clear()
	if ow is Array:
		for v in (ow as Array):
			owned_wear.append(String(v))
	var wp: Variant = cf.get_value("wear", "worn", {})
	worn_piece.clear()
	if wp is Dictionary:
		for k in (wp as Dictionary):
			worn_piece[String(k)] = int((wp as Dictionary)[k])
	# A CAREER FROM BEFORE THE TAILOR SOLD CLOTHES keeps everything it bought, cut for the
	# house it had reached when it bought it - which is the only stage it could have been
	# wearing them at. Nothing is taken away, and one of them will therefore match.
	if int(cf.get_value("wear", "ver", 0)) < 1:
		var vstage := clampi(venue_index(), 0, MAX_VENUE)
		for pair in [["glasses", "glasses"], ["gloves", "gloves"], ["boots", "boots"],
				["hat", "hat"], ["coat", "coat"], ["vest", "vest"], ["helmet", "helmet"],
				["glow", "glow_suit"]]:
			if bool(cf.get_value("stats", String(pair[1]), false)):
				var k := wear_key(String(pair[0]), vstage)
				if not owned_wear.has(k):
					owned_wear.append(k)
				worn_piece[String(pair[0])] = vstage
	var skill_ver := int(cf.get_value("prog", "skill_ver", 0))
	if skill_ver < 1:
		for tab: Array in [TRICKS, PATTERNS]:
			for sd: Dictionary in tab:
				var sid := String(sd.get("id", ""))
				if sid == "" or skill_free(sd) or gifted.has(sid):
					continue
				if skill_gate_cleared(sd):
					gifted.append(sid)
	# OVERTHROW WAS REMOVED THE SAME DAY, and it was the LAST index in TRICKS - so unlike
	# the pattern fold above, nothing shifted and a clamp is the whole migration. Its
	# leftovers are dropped rather than left to point at the trick that took its slot
	# (there is none) or to keep a lesson queued that can never be taught.
	gifted.erase("over")
	pending_tuts.erase("trick_over")
	trick_sel = clampi(trick_sel, -1, TRICKS.size() - 1)
	stamina_max = 100.0 + 9.0 * float(endurance)
	# stamina persists through the day now (sleep restores it). An old save that
	# predates the day loop simply wakes rested.
	stamina = clampf(float(cf.get_value("day", "stamina", stamina_max)), 0.0, stamina_max)
	if venue_pick < 0:
		venue_pick = venue_index()   # older saves default to their grandest stage


func save_progress() -> void:
	var cf := ConfigFile.new()
	cf.set_value("stats", "accuracy", accuracy)
	cf.set_value("stats", "strength", strength)
	cf.set_value("stats", "endurance", endurance)
	cf.set_value("stats", "speed", speed)
	cf.set_value("stats", "pies", pie_count)
	cf.set_value("day", "pie_active", pie_active)
	cf.set_value("stats", "money", money)
	cf.set_value("stats", "tomatoes", tomatoes)
	cf.set_value("stats", "reputation", reputation)
	cf.set_value("stats", "prop_count", prop_count)
	cf.set_value("stats", "prop_type", prop_type)
	# THESE EIGHT KEYS ARE LEGACY, and they are written from OWNERSHIP rather than from what
	# is worn. They exist only so the pre-tailor migration in load_progress can read a save
	# written by an older build - and that migration takes them to mean "bought". Writing
	# them from `wearing()` would mean a hat taken off for one act came back as a hat never
	# bought, which is a save-eating bug hiding in a one-word difference.
	cf.set_value("stats", "glasses", owns_any("glasses"))
	cf.set_value("stats", "glow_kit", has_glow_tape and owns_any("glow"))   # kept for old builds
	cf.set_value("stats", "glow_tape", has_glow_tape)
	cf.set_value("stats", "glow_suit", owns_any("glow"))
	cf.set_value("stats", "gloves", owns_any("gloves"))
	cf.set_value("stats", "boots", owns_any("boots"))
	cf.set_value("stats", "hat", owns_any("hat"))
	cf.set_value("stats", "coat", owns_any("coat"))
	cf.set_value("stats", "vest", owns_any("vest"))
	cf.set_value("stats", "backroom", has_backroom)
	cf.set_value("stats", "helmet", owns_any("helmet"))
	cf.set_value("stats", "energy_drinks", energy_drinks)
	cf.set_value("prog", "level", level)
	cf.set_value("prog", "xp", xp)
	cf.set_value("prog", "points", points)
	cf.set_value("prog", "won", won)
	cf.set_value("prog", "demo_wall_seen", demo_wall_seen)
	cf.set_value("prog", "purist_legend_seen", purist_legend_seen)
	cf.set_value("prog", "best_scores", best_scores)
	cf.set_value("prog", "best_scores_purist", best_scores_purist)
	cf.set_value("prog", "pattern_sel", pattern_sel)
	cf.set_value("prog", "pattern_ver", pattern_ver)
	cf.set_value("prog", "skill_ver", 1)   # this save's skills are written down, not inferred
	# THE TAILOR's choices. Cosmetic, but persisted like anything else the player decided:
	# opening the game to find yourself re-dressed by the machine is exactly the small
	# betrayal that makes a wardrobe feel fake.
	cf.set_value("wear", "suit", outfit_suit)
	cf.set_value("wear", "owned", owned_wear)
	cf.set_value("wear", "worn", worn_piece)
	cf.set_value("wear", "ver", 1)
	cf.set_value("prog", "career", career)
	cf.set_value("prog", "seen_tuts", seen_tuts)       # so a lesson fires once, ever
	cf.set_value("prog", "pending_tuts", pending_tuts)  # a queued lesson survives quitting
	cf.set_value("prog", "ante", ante)                  # each venue's standing raised bar
	cf.set_value("prog", "gifted", gifted)              # pity unlocks stay unlocked
	cf.set_value("prog", "perfs_since_unlock", perfs_since_unlock)
	cf.set_value("prog", "aid_pie_day", aid_pie_day)
	cf.set_value("prog", "aid_meal_used", aid_meal_used)
	cf.set_value("day", "purist", purist)
	cf.set_value("day", "day", day)
	cf.set_value("day", "seg_used", seg_used)
	cf.set_value("day", "venue_pick", venue_pick)
	cf.set_value("day", "meals", meals)
	cf.set_value("day", "stamina", stamina)
	cf.save(save_file())


# -----------------------------------------------------------------------------
# Per-tick simulation and hand animation.
