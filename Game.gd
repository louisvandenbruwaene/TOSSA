func draw_tut_keyrow(font: Font, s: Vector2) -> void:
	# THE ONE PIECE OF FURNITURE THE REWRITE KEPT (Louis: "the player only needs the buttons
	# that are on the bottom of the screen: FJ throw, DK catch, R restart and esc escape").
	# It carries the lesson's own key too - trick or pattern - so every command the game has
	# gets its moment of attention in the lesson that owns it.
	var items: Array = []
	items.append([k_throw(), "throw"])
	items.append([k_catch(), "catch"])
	if tut_id.begins_with("trick_"):
		items.append([k_trick(), "trick"])
		items.append([k_cycle(), "switch trick"])
	elif tut_id.begins_with("pattern_"):
		items.append([k_pattern(), "pattern"])
	items.append([k_restart(), "restart"])
	items.append([k_pause(), "game menu"])
	draw_hints_row(font, s.x * 0.5, s.y - 40.0, items)


func draw_tut_tally(font: Font, s: Vector2, step: Dictionary) -> void:
	# TEN THROWS AND TEN CATCHES, counted where the player can see them (Louis: "show a
	# window that just counts to 10 catches and 10 throws"). Same side panel the hand
	# question uses, which is empty by then - see TUT_SIDE_X for why nothing sits under him.
	var need_t := int(step.get("throws", 0))
	var need_c := int(step.get("need", 0))
	var bw := TUT_SIDE_W
	var bx := s.x * TUT_SIDE_X
	var by := s.y * TUT_SIDE_Y
	soft_card(Rect2(bx, by, bw, 74.0), Color(0.10, 0.07, 0.09, 0.95), Color(1.0, 0.86, 0.55, 0.45), 1.4, 12.0, 14.0)
	var rows := [["throws", mini(tut_throws, need_t), need_t], ["catches", mini(tut_count, need_c), need_c]]
	for i in rows.size():
		var r: Array = rows[i]
		var y := by + 28.0 + float(i) * 26.0
		var doneR := int(r[1]) >= int(r[2])
		draw_string(font, Vector2(bx + 20.0, y), String(r[0]), HORIZONTAL_ALIGNMENT_LEFT, 120.0, ps(14), Color(0.82, 0.78, 0.70))
		draw_string(font, Vector2(bx + bw - 100.0, y), "%d / %d" % [int(r[1]), int(r[2])], HORIZONTAL_ALIGNMENT_RIGHT, 80.0, ps(16),
			Color(0.72, 0.95, 0.70) if doneR else Color(1.0, 0.90, 0.62))


func draw_speech_line(font: Font, pos: Vector2, line: String, take: int, size: int, base_col: Color) -> void:
	# A BRACKETED KEY - "[J]" - GETS ITS OWN LOOK (2026-07-29, Louis: "give J the same
	# look as below: yellow and slightly larger than the rest of the text"), matching
	# the bare key floating over the hand. draw_string has no rich-text span of its own,
	# so the line is split around the brackets and drawn as up to three runs, each
	# measured so the next one picks up exactly where the last left off. `take` still
	# reveals the line a character at a time (see tut_speech_chars), split across all
	# three runs, so the highlighted key types in with the rest of the sentence rather
	# than popping in whole.
	var key_size := size + 3
	var key_col := Color(1.0, 0.88, 0.32)
	var x := pos.x
	var at := 0
	while at < line.length():
		var lb := line.find("[", at)
		var rb := line.find("]", lb + 1) if lb >= 0 else -1
		var stop := lb if lb >= 0 and rb >= 0 else line.length()
		if stop > at:
			var plain := line.substr(at, stop - at)
			var shown := clampi(take - at, 0, plain.length())
			if shown > 0:
				draw_string(font, Vector2(x, pos.y), plain.substr(0, shown), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(size), base_col)
			x += font.get_string_size(plain, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(size)).x
			at = stop
		if lb < 0 or rb < 0:
			break
		var key := line.substr(lb, rb - lb + 1)
		var key_shown := clampi(take - lb, 0, key.length())
		if key_shown > 0:
			draw_string(font, Vector2(x, pos.y), key.substr(0, key_shown), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(key_size), key_col)
		x += font.get_string_size(key, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(key_size)).x
		at = rb + 1


func draw_tut_speech(font: Font, s: Vector2, step: Dictionary) -> void:
	# SOMEBODY IS TALKING TO YOU (2026-07-29, Louis: "create another window that looks
	# better and like a person talking"). A head in a lit disc on the left, the line beside
	# it, and a tail pointing down out of the box - the three marks that turn a text panel
	# into speech.
	#
	# **IT SITS ABOVE THE JUGGLER AND CANNOT REACH HIM.** Louis: "make sure none of this ...
	# ever overlap with the juggler, which should be visible at all times". The performer's
	# hat brim is the highest thing he has and it sits at about 0.30 of the screen, so the
	# box is clamped to end above TUT_SPEECH_BOT of the height - the same rule the goal
	# stem's bloom follows, a named number rather than a look at one screenshot.
	var line := String(step.get("text", ""))
	if line == "":
		return
	var bw := minf(720.0, s.x - 120.0)
	var bx := s.x * 0.5 - bw * 0.5
	var by := 24.0
	# the box grows to its own wrapped text and no further, then the whole thing is checked
	# against the juggler's ceiling
	var inner := bw - 128.0
	var lines := _wrap_lines(font, line, inner, 17)
	var sub := String(step.get("sub", ""))
	var subl: Array = _wrap_lines(font, sub, inner, 13) if sub != "" else []
	var bh := 46.0 + 24.0 * float(maxi(lines.size(), 1)) + (8.0 + 18.0 * float(subl.size()) if subl.size() > 0 else 0.0)
	bh = minf(bh, s.y * TUT_SPEECH_BOT - by)
	soft_card(Rect2(bx, by, bw, bh), Color(0.10, 0.07, 0.09, 0.95), Color(1.0, 0.86, 0.55, 0.55), 1.6, 14.0, 18.0)
	# the tail, so the box reads as something being SAID rather than a heading
	draw_colored_polygon(PackedVector2Array([
		Vector2(bx + 74.0, by + bh - 1.0), Vector2(bx + 104.0, by + bh - 1.0),
		Vector2(bx + 80.0, by + bh + 13.0)]), Color(0.10, 0.07, 0.09, 0.95))
	# the speaker: a lit disc with the game's own head in it, so the voice has a face and it
	# is a face the player already knows
	var hc := art_snap(Vector2(bx + 52.0, by + bh * 0.5))
	draw_glow(hc, 34.0, Color(1.0, 0.78, 0.42, 0.14))
	fill_disc_pix(hc, 26.0, Color(0.16, 0.11, 0.12, 0.95))
	draw_ring_pix(hc, 26.0, 2.0, Color(1.0, 0.86, 0.55, 0.45))
	# ...AND IT IS THE PERFORMER'S OWN FACE, cut from the body sprite (2026-08-08). This drew
	# draw_head - the TRACED juggler - with a comment claiming the voice looks like the man
	# on stage. That stopped being true the day the showman replaced him: a smooth vector
	# head in a smooth vector disc was talking to the player about the painted man standing
	# right behind the box, in a different style and with a different face. The bank
	# publishes his head's rectangle (see head_box), so this is a sub-rect blit of art the
	# game already has loaded, and it cannot drift from him.
	if not draw_fig_head(hc, 24.0):
		draw_head(hc + Vector2(0.0, 3.0), 15.0, Color(0.28, 0.16, 0.11), Color(0.87, 0.64, 0.45), false)
	# THE LINE, revealed a letter at a time. A line that appears whole is a sign; a line
	# that arrives is a person talking, and it is what the blip sound is timed against.
	var shown := tut_speech_chars()
	var ty := by + 34.0
	var used := 0
	for l in lines:
		var lt := String(l)
		var take := clampi(shown - used, 0, lt.length())
		if take > 0:
			draw_speech_line(font, Vector2(bx + 96.0, ty), lt, take, 17, Color(1.0, 0.94, 0.80))
		used += lt.length()
		ty += 24.0
	if subl.size() > 0 and shown >= _tut_line_len(lines):
		ty += 6.0
		for l2 in subl:
			draw_string(font, Vector2(bx + 96.0, ty), String(l2), HORIZONTAL_ALIGNMENT_LEFT, inner, ps(13), Color(0.80, 0.86, 0.95))
			ty += 18.0
	# ...and the prompt, only once the beat is actually clearable, so an Enter icon never
	# appears on a step whose key has not been pressed yet
	if tut_advance_at >= 0:
		draw_keycap(font, bx + bw - 78.0, by + bh - 30.0, String(k_finish()[0]))


func _tut_line_len(lines: Array) -> int:
	var n := 0
	for l in lines:
		n += String(l).length()
	return n


func tut_speech_done() -> bool:
	# has the whole of this step's line arrived on screen? Measured against the RAW text
	# rather than the wrapped lines, because wrapping is a draw-time concern and needs a
	# font - the two differ by the handful of spaces eaten at the line breaks, which errs on
	# the side of a few more frames of reading time and never the other way.
	return tut_speech_chars() >= String(tut_step_data().get("text", "")).length()


func tut_speech_chars() -> int:
	# how much of the line has arrived. Reset at every step (tut_speech_tick) and paced by
	# TUT_SPEECH_CPS, with the blip fired from update_sim rather than here - a draw pass can
	# run more than once for a tick and would stutter the sound.
	return int(maxf(0.0, atick() - tut_speech_tick) * TUT_SPEECH_CPS / 120.0)


func draw_tut_hand_pick(font: Font, s: Vector2) -> void:
	# WHICH HAND IS YOUR STRONG ONE. One question, two cards, and like the speech box it is
	# kept clear of the performer - it sits UNDER him, above the key row, because the two
	# cards are wide and a wide box at the top would have to sit on his hat.
	var bw := TUT_SIDE_W
	var bx := s.x * TUT_SIDE_X
	var by := s.y * TUT_SIDE_Y
	soft_card(Rect2(bx, by, bw, 150.0), Color(0.10, 0.07, 0.09, 0.96), Color(1.0, 0.86, 0.55, 0.5), 1.6, 12.0, 16.0)
	draw_string(font, Vector2(bx, by + 28.0), "which hand is your strong one?", HORIZONTAL_ALIGNMENT_CENTER, bw, ps(14), Color(0.92, 0.88, 0.78))
	# SIDE BY SIDE (2026-07-29, Louis: "left and right on the left and on the right side
	# of each other instead of on top of each other") - the layout is now the answer, not
	# just the label: the LEFT card sits on the left, the RIGHT card on the right, so the
	# choice reads before either word is even parsed.
	var gap := 14.0
	var cw := (bw - 48.0 - gap) * 0.5
	var cy := by + 44.0
	for i in 2:
		var h := LEFT if i == 0 else RIGHT
		# `dominant_hand` IS the hover here, pre-confirm (see the "hand" goal's input
		# handler): Left/Right move it live, Enter is what actually commits it.
		var sel := dominant_hand == h
		var cx := bx + 24.0 + float(i) * (cw + gap)
		soft_card(Rect2(cx, cy, cw, 38.0), Color(1.0, 0.86, 0.45, 0.12) if sel else Color(0.14, 0.10, 0.11, 0.9),
			Color(1.0, 0.88, 0.5, 0.9) if sel else Color(0.6, 0.55, 0.5, 0.4), 1.6 if sel else 1.0, 9.0, 10.0)
		draw_string(font, Vector2(cx, cy + 25.0), "LEFT" if h == LEFT else "RIGHT", HORIZONTAL_ALIGNMENT_CENTER, cw, ps(16),
			Color(1.0, 0.92, 0.62) if sel else Color(0.72, 0.68, 0.62))
	draw_hints_row(font, bx + bw * 0.5, by + 162.0,
		[[["Stick"] if pad_active() else ["Left", "Right"], "choose"], [k_finish(), "yes"]])


func draw_tutorial_banner(font: Font, s: Vector2) -> void:
	var step := tut_step_data()
	var steps := tut_lesson(tut_id)
	if tut_frozen():
		# a breath of dark over the STAGE while a beat has the world frozen: the picture
		# stays readable, but the world visibly stops, which is the whole message. Laid
		# down first, so everything the lesson draws to explain itself sits on top of it
		# at full brightness rather than being dimmed along with the scenery.
		draw_rect(Rect2(0, 0, s.x, s.y), Color(0.02, 0.01, 0.03, 0.30))
	# the aura goes on FIRST, under the key letters, so the prop is lit and the key that
	# acts on it sits on top of that light rather than competing with it
	draw_tut_focus(tut_focus_ball())
	draw_tut_prompts(font, s, step)   # a bare handed key over the hands, no boxes
	# **A SCRIPTED STEP SPEAKS INSTEAD** (2026-07-29). Every beat of the rewritten basics
	# carries `say`, and for those the banner below - the kind tag, the title, the pace pips,
	# the goal dots - is simply not drawn: Louis asked for the window and the key row and
	# nothing else. The older lessons (props, tricks, patterns) still run the banner, which
	# is why both live here rather than one replacing the other outright.
	if bool(step.get("say", false)):
		draw_tut_speech(font, s, step)
		if String(step["goal"]) == "hand":
			draw_tut_hand_pick(font, s)
		if String(step["goal"]) == "free" and int(step.get("throws", 0)) > 0:
			draw_tut_tally(font, s, step)
		draw_tut_keyrow(font, s)
		return
	# a SMALL rectangle at the top (2026-07-18, Louis: "not above and below, out of
	# vision, long texts of what to do - that is bad design"): the lesson kind, its
	# one-line title, and progress only. The old two-line "sub" paragraph explaining
	# WHY is gone from the live HUD entirely - what to press right now belongs dead
	# centre instead, drawn below by draw_tut_special_cue off tut_action_cue().
	# THE BANNER, rebuilt (2026-07-27, Louis: "outdated and ugly... no unneeded numbers /
	# explanations"). Two flat rectangles and three lines of text became one soft_card -
	# the same primitive every other panel in the game uses - carrying exactly three
	# things, none of them a number:
	#   a KIND tag on its own accent bar (TRICK / PATTERN / THE BASICS),
	#   the step's one-line title,
	#   and two little meters that ARE the numbers, drawn instead of written: three pace
	#   pips saying which of the 50/25/full passes is running, and a row of goal pips
	#   filling as catches land.
	# Gone: "Step 7 of 11" (a number the player can do nothing with) and "caught 4 / 6"
	# (a fraction where six dots say it faster and prettier).
	var kind_col := tut_kind_col()
	var bw := minf(560.0, s.x * 0.52)
	var bx := s.x * 0.5 - bw * 0.5
	var by := 20.0
	var bh := 74.0
	soft_card(Rect2(bx, by, bw, bh), Color(0.07, 0.05, 0.07, 0.90), Color(kind_col.r, kind_col.g, kind_col.b, 0.42), 1.5, 12.0, 16.0)
	draw_rect(Rect2(bx + 1.0, by + 12.0, 3.0, bh - 24.0), Color(kind_col.r, kind_col.g, kind_col.b, 0.85))
	draw_string(font, Vector2(bx + 18.0, by + 22.0), tut_kind_tag(), HORIZONTAL_ALIGNMENT_LEFT, bw - 36.0, ps(10), Color(kind_col.r, kind_col.g, kind_col.b, 0.95))
	draw_fit_string(title_font(), Vector2(bx + 18.0, by + 46.0), String(step["text"]), HORIZONTAL_ALIGNMENT_LEFT, bw - 36.0, 19, Color(1.0, 0.92, 0.68))
	var done := tut_advance_at >= 0
	# THE PACE PIPS CAME OUT WITH THE LADDER (2026-07-30). Three notches for the three passes, the
	# live one lit - a good picture of a system that no longer exists: no step has a `phase` any
	# more, so this drew nothing, and it read `tut_pace_line`, which is deleted.
	# the GOAL pips, bottom right: one dot per catch the step wants, filling as they land.
	# Capped at twelve dots so a ten-catch finale reads and nothing wider ever could.
	var need_n := int(step.get("need", 0))
	if need_n > 1 and String(step["goal"]) == "catch":
		var got := mini(tut_count, need_n)
		var dots := mini(need_n, 12)
		var dx := bx + bw - 18.0 - float(dots - 1) * 11.0
		for i in dots:
			var lit := float(i) < float(got) * float(dots) / float(need_n)
			draw_circle(Vector2(dx + float(i) * 11.0, by + bh - 16.0), 3.6 if lit else 3.0,
				Color(0.75, 0.95, 0.72) if lit else Color(0.55, 0.51, 0.48, 0.55))
	elif done and String(step["goal"]) != "read":
		# a "read" step is met the instant it opens, so congratulating the player for
		# arriving on it would be congratulating them for nothing
		var ga := 0.75 + 0.25 * sin(atick() * 0.1)
		draw_string(font, Vector2(bx, by + bh - 12.0), "GOOD JOB", HORIZONTAL_ALIGNMENT_RIGHT, bw - 18.0, ps(12), Color(0.72, 0.95, 0.7, ga))
	if bool(step.get("intro", false)):
		draw_tut_intro_card(font, s, step, kind_col)
	draw_tut_keyrow(font, s)
	# ONE cue slot, and exactly one thing may hold it - a screen that asks for two keys
	# at once has asked for neither. A frozen BEAT wins outright: the world is not
	# moving until it is answered, so nothing else on screen is the live question.
	# Enter comes next, because the whole point of its own callout is that it stops
	# being missable; otherwise the centred keycap (Louis: dead centre, not a sentence
	# at either edge) names whatever the live sim wants pressed right now.
	if tut_holding():
		draw_tut_hold_cue(font, s)
	elif done:
		draw_tut_enter_callout(font, s, step, tut_step >= steps.size() - 1)
	else:
		draw_tut_special_cue(font, s, tut_action_cue(step))
	# the full key legend belongs to the BASICS' closing "every key you have" step; an
	# intro step has its own card and must not have the legend printed through it
	if String(step["goal"]) == "read" and not bool(step.get("intro", false)):
		draw_tut_legend(font, s)
	# trick feedback ("HIGH TOSS ON", or the lesson's gentle no-trick-here guidance)
	# shows in lessons too - draw_hud, which normally carries it, never runs here
	if trick_msg != "" and tick - trick_msg_tick < 90:
		var ta := clampf(1.0 - float(tick - trick_msg_tick) / 90.0, 0.0, 1.0)
		draw_text_shout(font, Vector2(s.x * 0.5 - 200, s.y - 128.0), trick_msg, HORIZONTAL_ALIGNMENT_CENTER, 400, 17, Color(1.0, 0.88, 0.55, ta))


func draw_tut_intro_card(font: Font, s: Vector2, step: Dictionary, accent: Color) -> void:
	# THE OPENING CARD (see tut_intro): the one place a lesson is allowed to be wordy,
	# because nothing is moving yet and the player has not been asked to do anything.
	# A big keycap on the left says which button the whole lesson is about; the prose
	# sits beside it in its own box and is WRAPPED, never clipped. Enter starts the drill.
	var cw := minf(760.0, s.x - 120.0)
	var chh := minf(300.0, s.y * 0.42)
	var cx := s.x * 0.5 - cw * 0.5
	var cy := s.y * 0.30
	soft_card(Rect2(cx, cy, cw, chh), Color(0.07, 0.05, 0.08, 0.95), Color(accent.r, accent.g, accent.b, 0.5), 2.0, 14.0, 22.0)
	# the key, given the size of the thing it opens up
	var cap := String(step.get("cap", ""))
	var kx := cx + 30.0
	var ky := cy + 40.0
	if cap != "":
		var kw := maxf(72.0, font.get_string_size(cap, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(30)).x + 34.0)
		var pulse := 0.5 + 0.5 * sin(atick() * 0.09)
		draw_rect(Rect2(kx, ky, kw, 52.0), Color(accent.r, accent.g, accent.b, 0.86 + 0.14 * pulse))
		draw_string(font, Vector2(kx, ky + 36.0), cap, HORIZONTAL_ALIGNMENT_CENTER, kw, ps(30), Color(0.10, 0.06, 0.04))
		# two calls, not one string with a newline in it: draw_string has no concept of a
		# line break and runs the halves together ("the key thisles...")
		draw_string(font, Vector2(kx, ky + 72.0), "the key this", HORIZONTAL_ALIGNMENT_CENTER, kw, ps(11), Color(0.76, 0.72, 0.66))
		draw_string(font, Vector2(kx, ky + 86.0), "lesson is about", HORIZONTAL_ALIGNMENT_CENTER, kw, ps(11), Color(0.76, 0.72, 0.66))
		kx += kw + 28.0
	draw_string(title_font(), Vector2(kx, cy + 44.0), String(step["text"]), HORIZONTAL_ALIGNMENT_LEFT, cw - (kx - cx) - 30.0, ps(24), Color(1.0, 0.92, 0.66))
	# the body wraps INSIDE its box and stops at the bottom of it (the standing rule):
	# blank lines in the source become paragraph breaks, so this reads as prose
	var ty := cy + 68.0
	for para in String(step["sub"]).split("\n\n"):
		if String(para).strip_edges() == "":
			continue
		var used := draw_wrap_fit(font, String(para), Rect2(kx, ty, cw - (kx - cx) - 30.0, cy + chh - 24.0 - ty), 13,
			Color(0.86, 0.82, 0.75), HORIZONTAL_ALIGNMENT_LEFT)
		ty += used + 12.0
		if ty > cy + chh - 40.0:
			break


func tut_action_cue(step: Dictionary) -> Dictionary:
	# THE one button that has no hand of its own - trick, pattern, restart - so it gets
	# no home among the bare per-hand keys draw_tut_prompts already draws over every
	# throw/catch, in every lesson (2026-07-18, Louis, second pass: those were already
	# "central" enough - over the hands, bare, no box - and just wanted nudging a
	# little further off the hands, not replacing). This is the disconnect that broke
	# the Spin lesson: "press SPACE now" used to be baked straight into the step text
	# with no check against whether the press would do anything. The "live" branch
	# below asks on_trick()'s own two questions - enough in the air, not cooling down
	# - before ever naming Space, so the game can no longer promise a press it would
	# then silently refuse.
	var goal := String(step["goal"])
	if goal == "press_p":
		return {"key": String(k_pattern()[0]), "label": "pattern"}
	if goal == "press_r":
		return {"key": String(k_restart()[0]), "label": "restart"}
	if String(step.get("prompt", "")) == "trick":
		var ti: int = int(step.get("trick", trick_sel))
		if ti >= 0 and ti < TRICKS.size():
			var t: Dictionary = TRICKS[ti]
			if String(t["kind"]) == "live":
				if balls_airborne() >= int(t["min_air"]) and not spinning():
					return {"key": String(k_trick()[0]), "label": "%s  -  now" % String(t["name"]).to_upper()}
				return {}   # not ready: the per-hand keys are already naming the catch/throw that gets there
			var lbl := "switch on" if goal == "trick_on" else ("switch off" if goal == "trick_off" else "trick")
			return {"key": String(k_trick()[0]), "label": lbl}
	return {}


func draw_tut_special_cue(font: Font, s: Vector2, cue: Dictionary) -> void:
	# Space / P / R belong to neither hand, so they get the same central bottom slot
	# and bordered-keycap look as the Enter callout below (Louis, 2026-07-18: "the
	# space button should be where the enter now button is, nice and central") - the
	# two never show at once, since this only runs while the step is NOT yet done.
	if String(cue.get("key", "")) == "":
		return
	var label := String(cue.get("label", ""))
	var pulse := 0.5 + 0.5 * sin(atick() * 0.13)
	var fs := 19
	var cap := String(cue["key"])
	var lw := font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(fs)).x
	var cw := font.get_string_size(cap, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(fs)).x + 18.0
	var total := cw + 14.0 + lw
	var bh := float(fs) + 16.0
	var bx := s.x * 0.5 - total * 0.5
	var by := s.y - 96.0
	draw_rect(Rect2(bx - 18.0, by, total + 36.0, bh), Color(0.16, 0.10, 0.04, 0.88))
	draw_rect(Rect2(bx - 18.0, by, total + 36.0, bh), Color(1.0, 0.72, 0.4, 0.45 + 0.45 * pulse), false, 2.0)
	draw_rect(Rect2(bx, by + 6.0, cw, bh - 12.0), Color(1.0, 0.72, 0.4, 0.82 + 0.18 * pulse))
	draw_string(font, Vector2(bx, by + bh - 11.0), cap, HORIZONTAL_ALIGNMENT_CENTER, cw, ps(fs), Color(0.12, 0.07, 0.03))
	draw_string(font, Vector2(bx + cw + 14.0, by + bh - 11.0), label, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(fs), Color(1.0, 0.93, 0.72))


func draw_tut_hold_cue(font: Font, s: Vector2) -> void:
	# THE frozen beat's own prompt, in the same central bottom slot the Enter callout and
	# the special cue use (Louis approved that position; two prompt homes would be two
	# places to look). It says three things and nothing else:
	#
	#   - the world has STOPPED and is waiting on you (a wash of dark over the stage,
	#     so a stopped sim can never be mistaken for a hung game),
	#   - the key, or the keys IN THEIR ORDER with a "then" between them - a two-key
	#     beat like "J then K" is the exchange the cascade is made of and reads as one
	#     move, not two asks,
	#   - which hand each belongs to, spelled out, since that is the half beginners
	#     get wrong.
	#
	# A key already pressed this beat goes green and quiet, so a combination shows its
	# own progress with no counter anywhere. (The dark wash over the stage is laid down
	# by draw_tutorial_banner BEFORE any of the lesson's own furniture, so it dims the
	# WORLD and not the HUD that is explaining it.)
	var fs := 22
	var pulse := 0.5 + 0.5 * sin(atick() * 0.13)
	# measure: keycap, its label, and a "then" separator before every entry but the first
	var sep := "  then  "
	var sepw := font.get_string_size(sep, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(14)).x
	var caps := PackedFloat32Array()
	var labs := PackedFloat32Array()
	var total := 0.0
	for i in tut_hold.size():
		var e: Dictionary = tut_hold[i]
		var cw := maxf(46.0, font.get_string_size(String(e["key"]), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(fs)).x + 26.0)
		var lw := font.get_string_size(String(e["what"]), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13)).x
		caps.append(cw)
		labs.append(lw)
		total += maxf(cw, lw) + (sepw if i > 0 else 0.0)
	# the card is sized to the WIDEST thing in it, header included (Louis's standing
	# rule: no text ever leaves its container - the header was being clipped mid-word
	# by a card measured off the keycaps alone)
	var head := "PAUSED  -  the world is waiting for you"
	var bw := maxf(total + 56.0, font.get_string_size(head, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(12)).x + 44.0)
	var bh := 104.0
	var bx := s.x * 0.5 - bw * 0.5
	var by := s.y - 162.0
	soft_card(Rect2(bx, by, bw, bh), Color(0.09, 0.05, 0.10, 0.94), Color(0.72, 0.88, 1.0, 0.40 + 0.35 * pulse), 2.0, 11.0, 14.0)
	draw_fit_string(font, Vector2(bx + 12.0, by + 24.0), head, HORIZONTAL_ALIGNMENT_CENTER, bw - 24.0, 12, Color(0.72, 0.88, 1.0, 0.9))
	var x := bx + (bw - total) * 0.5
	for i in tut_hold.size():
		var e: Dictionary = tut_hold[i]
		if i > 0:
			draw_string(font, Vector2(x - sepw, by + 64.0), sep, HORIZONTAL_ALIGNMENT_CENTER, sepw, ps(14), Color(0.78, 0.74, 0.70, 0.85))
		var slot := maxf(caps[i], labs[i])
		var cw2: float = caps[i]
		var cx := x + slot * 0.5 - cw2 * 0.5
		var ok := bool(e.get("ok", false))
		var col := Color(0.55, 0.90, 0.55) if ok else Color(1.0, 0.86, 0.42)
		var a := 0.45 if ok else (0.82 + 0.18 * pulse)
		draw_rect(Rect2(cx, by + 38.0, cw2, 34.0), Color(col.r, col.g, col.b, a))
		draw_string(font, Vector2(cx, by + 64.0), String(e["key"]), HORIZONTAL_ALIGNMENT_CENTER, cw2, ps(fs), Color(0.10, 0.06, 0.03))
		draw_fit_string(font, Vector2(x, by + 92.0), String(e["what"]), HORIZONTAL_ALIGNMENT_CENTER, slot, 13,
			Color(0.62, 0.86, 0.62, 0.8) if ok else Color(1.0, 0.93, 0.75, 0.95))
		x += slot + sepw


func draw_tut_enter_callout(font: Font, s: Vector2, step: Dictionary, last: bool) -> void:
	# THE fix for the one thing every tester did (Louis): they got the juggling straight
	# away and then just kept juggling, because "Enter continues" was a small line in a
	# banner they had long stopped reading. So Enter gets a bar of its own above the key
	# row; it says what it will DO ("add a second ball") rather than that it continues;
	# and it grows and quickens for as long as it goes unanswered, so a player happily
	# lost in the juggling is eventually, gently, unmissably told there is more.
	var label := "finish the lesson" if last else String(step.get("next", "continue"))
	var urg := clampf(float(tick - tut_advance_at) / 900.0, 0.0, 1.0)
	var pulse := 0.5 + 0.5 * sin(atick() * (0.07 + 0.06 * urg))
	var fs := int(round(lerpf(17.0, 22.0, urg)))
	var cap := String(k_finish()[0])   # Enter, or A on a pad
	var lw := font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(fs)).x
	var cw := font.get_string_size(cap, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(fs)).x + 18.0
	var total := cw + 14.0 + lw
	var bh := float(fs) + 16.0
	var bx := s.x * 0.5 - total * 0.5
	var by := s.y - 96.0
	draw_rect(Rect2(bx - 18.0, by, total + 36.0, bh), Color(0.16, 0.10, 0.04, 0.88))
	draw_rect(Rect2(bx - 18.0, by, total + 36.0, bh), Color(1.0, 0.86, 0.42, 0.45 + 0.45 * pulse), false, 2.0)
	draw_rect(Rect2(bx, by + 6.0, cw, bh - 12.0), Color(1.0, 0.86, 0.42, 0.82 + 0.18 * pulse))
	draw_string(font, Vector2(bx, by + bh - 11.0), cap, HORIZONTAL_ALIGNMENT_CENTER, cw, ps(fs), Color(0.12, 0.07, 0.03))
	draw_string(font, Vector2(bx + cw + 14.0, by + bh - 11.0), label, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(fs), Color(1.0, 0.93, 0.72))
	# ...and the other half of the deal, quieter, because the step never stops being
	# playable and nobody should feel hurried out of the thing they just got working
	# ...but only where there is something to keep practising: an opening card is a page
	# to read, and inviting the player to stay on it longer is inviting them nowhere
	if String(step["goal"]) != "read":
		draw_string(font, Vector2(0, by - 8.0), "or keep practising as long as you like", HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(12), Color(0.78, 0.72, 0.64, 0.75))


func draw_tut_legend(font: Font, s: Vector2) -> void:
	# every command the game has, named, in one card (Louis: teach them all the buttons
	# they can press at all times, with clear names). Two columns, sat in the clear band
	# between the banner and the hands at 0.57, so it overlaps neither and the balls stay
	# visible underneath it. Keys come from the live bindings, so a remapped player reads
	# their own; the fixed ones are printed as they are.
	var kt := k_throw()
	var kc := k_catch()
	var rows := [
		[[String(kt[RIGHT]), String(kt[LEFT])], "throw", "right hand, left hand"],
		[[String(kc[RIGHT]), String(kc[LEFT])], "catch", "right hand, left hand"],
		[[String(k_trick()[0])], "trick", "one flourish  -  %s picks which" % String(k_cycle()[0])],
		[[String(k_pattern()[0])], "pattern", "the routine you juggle"],
		[[String(k_object()[0])], "object", "balls, rings, clubs, torches"],
		[k_count(), "how many", "props to juggle, live or fresh"],
		[[String(k_restart()[0])], "restart", "re-deal  -  practice only, never on stage"],
		[[String(k_shop()[0])], "the shop", "buy props and gear"],
		[[String(k_sheet()[0])], "your skills", "the sheet  -  spend your points"],
		[[String(k_pause()[0])], "the game menu", "resume, back to the day, quit"],
		[[String(k_finish()[0])], "finish", "take a bow on stage, or leave practice"],
	]
	var nrows := int(ceil(float(rows.size()) * 0.5))
	var cw := minf(920.0, s.x - 80.0)
	var cx := s.x * 0.5 - cw * 0.5
	var cy := 158.0
	var rowh := 26.0
	var ch := 34.0 + float(nrows) * rowh
	draw_rect(Rect2(cx, cy, cw, ch), Color(0.05, 0.03, 0.05, 0.9))
	draw_rect(Rect2(cx, cy, cw, ch), Color(0.82, 0.62, 0.34, 0.5), false, 2.0)
	var colw := cw * 0.5
	for i in rows.size():
		var row: Array = rows[i]
		var x := cx + 20.0 + float(i / nrows) * colw
		var y := cy + 26.0 + float(i % nrows) * rowh
		var kx := x
		for k in row[0]:
			kx += draw_keycap(font, kx, y - 14.0, String(k)) + 3.0
		draw_string(font, Vector2(x + 62.0, y), String(row[1]), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13), Color(1.0, 0.88, 0.58))
		draw_string(font, Vector2(x + 168.0, y), String(row[2]), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(11), Color(0.82, 0.76, 0.68, 0.9))


func draw_tut_key(font: Font, at: Vector2, key: String, col: Color, urgency: float) -> void:
	# a single BARE key letter floating beside a hand - outlined, no box - so the handed
	# press (which hand, which key) is guided at the point of action without a text
	# rectangle in the middle of the stage (Louis: keep the centre clear).
	var u := clampf(urgency, 0.0, 1.0)
	var sc := lerpf(1.0, 1.4, u)
	if u > 0.6:
		sc *= 1.0 + 0.06 * sin(atick() * 0.18) * (u - 0.6) / 0.4
	var fs := int(round(19.0 * sc))
	var a := lerpf(0.78, 1.0, u)   # never faint: a calm key must still read at a glance
	# A SMALL PULSING AURA (2026-07-29, Louis: "a small aura around it to emphasize (make
	# it pulsate slightly)"). One soft glow breathing behind the letter - draw_glow is a
	# single textured quad, so this costs nothing - is what turns a bare outlined letter
	# into something the eye keeps coming back to rather than reads once and forgets.
	var pulse := 0.5 + 0.5 * sin(atick() * 0.05)
	draw_glow(at, 20.0 + 5.0 * pulse, Color(col.r, col.g, col.b, (0.22 + 0.12 * pulse) * a))
	draw_text_shout(font, at - Vector2(80.0, 0.0), key, HORIZONTAL_ALIGNMENT_CENTER, 160.0, fs, Color(col.r, col.g, col.b, a))


func tut_ball_pos(b: Ball) -> Vector2:
	# where a prop is actually DRAWN this frame, in flight or in a hand - the held case
	# mirrors draw_hand's own stacking offset (pos + (0, -3 - 6i)) rather than guessing,
	# so an aura placed here sits on the prop and not near it.
	if b == null:
		return Vector2.ZERO
	if b.state == STATE_FLIGHT:
		return flight_pos(b)
	for h: int in [LEFT, RIGHT]:
		var st := stack(h)
		var i := st.find(b)
		if i >= 0:
			return fig_hand_pos(h) + Vector2(0.0, -3.0 - float(i) * 6.0)
	return Vector2.ZERO


func draw_tut_focus(b: Ball) -> void:
	# ONE PROP WEARS THE AURA, AND ONLY WHILE IT IS THE ASK (2026-07-31, Louis: "emphasize
	# only the ball that currently requires an action, not the one from the previous
	# action"). tut_focus_ball is the single answer to "which prop"; this only draws it.
	#
	# One soft aura is enough. A ring on top repeated the same emphasis and made a ball look
	# selected twice, so the textured glow is now the complete focus mark.
	if b == null:
		return
	var p := tut_ball_pos(b)
	if p == Vector2.ZERO:
		return
	var r := BALL_RADIUS_PX * prop_scale(b.kind) + 9.0
	var pulse := 0.5 + 0.5 * sin(atick() * 0.07)   # cine_tick runs at 120/s: halve the rate
	var gold := Color(1.0, 0.86, 0.32)
	draw_glow(p, r * 2.1 + 5.0 * pulse, Color(gold.r, gold.g, gold.b, 0.22 + 0.12 * pulse))


func draw_tut_prompts(font: Font, s: Vector2, step: Dictionary) -> void:
	# THE lesson affordance (Louis): which key, over which hand, at the moment to press it
	# - but as a bare letter and a timing ring, never a boxed bubble. A met goal no
	# longer silences these: the step holds open for more practice, so the guidance
	# keeps working until the player's Enter moves on.
	var kc := k_catch()
	var kt := k_throw()
	# THROW WINS, full stop (Louis, now three times - most recently: "it should keep
	# telling me to throw the ball until the hand is completely empty, only THEN
	# should it say to catch"). A hand still holding a ball NEVER shows a catch ring,
	# however soon something else is landing there - it keeps asking for its throw key
	# until the stack is empty. Without this, throwing two balls quickly from one hand
	# could leave the OTHER hand's still-unthrown ball hidden: that hand happened to
	# also be where one of the two just-thrown balls was headed, so its incoming-catch
	# ring silently won the same slot the throw key needed.
	var holding := [not stack(LEFT).is_empty(), not stack(RIGHT).is_empty()]
	# catch: a timing ring on the receiving hand, its bare catch key just above it -
	# but only once that hand is empty. The lead runs LONGER than the in-game glow
	# (Louis: shown early enough), so a beginner reads the key well before the ball
	# asks for it.
	var lead := PROMPT_LEAD * 3 / 2
	# when two balls are both bound for the same hand, only the SOONEST one gets a
	# ring - one ring per hand, never a stack of them (Louis)
	var soonest := [lead + 1, lead + 1]
	for b in balls:
		if b.state != STATE_FLIGHT:
			continue
		var d := b.land_tick - tick
		if d <= 0 or d > lead:
			continue
		var h := clampi(b.to_hand, 0, 1)
		if holding[h]:
			continue
		if d < soonest[h]:
			soonest[h] = d
	# while a beat has the world frozen, ONLY the hands that beat names get a prompt: a
	# calmer key over the other hand is a second ask, and the whole point of the pause
	# is that there is exactly one thing to do
	var beat := tut_holding()
	# ...AND A SCRIPTED `do` BEAT IS THE SAME PROMISE (2026-07-31, Louis: emphasise "only
	# the ball that currently requires an action, not the one from the previous action").
	# A `do` beat names exactly one key on one hand, but this function drew a throw key over
	# EVERY holding hand and a catch key over every receiving one - so the hand that had
	# just caught kept a bright key on it while the lesson had already moved the ask
	# somewhere else. That stale key, sitting on the prop of the PREVIOUS beat, is what read
	# as the wrong ball being emphasised. `tut_do_goal` is empty for every other kind of
	# step, so free play and the older lessons keep all their prompts.
	var do_goal := String(step.get("goal", "")) if (tut_do_step() and tut_advance_at < 0) else ""
	# ...with the one exception the guard forces (see tut_focus_ball's own note): if the world
	# is stopped because a prop is landing at a hand the beat did NOT name, that hand still
	# needs its key, or the player is staring at a frozen game with the only prompt on the
	# wrong side and no way to learn what to press.
	var guard_h := tut_guard_hand() if tut_catch_hold() else -1
	for h: int in [LEFT, RIGHT]:
		if soonest[h] > lead:
			continue
		if beat and not tut_hold_names("catch", h):
			continue
		if do_goal != "" and do_goal != ("catch_l" if h == LEFT else "catch_r") and guard_h != h:
			continue
		var hp: Vector2 = fig_hand_pos(h)
		# NO MORE RING (2026-07-31, Louis: "the circle that surrounds the ball ... it's
		# jagged or just positioned wrong or both ... just get rid of that circle around
		# the ball in the tutorial"). The bare key letter below is the whole prompt now.
		var urg := 1.0 - float(soonest[h]) / float(lead)
		# OUTWARD, NOT OVERHEAD (2026-07-29, Louis: the key should sit to the side of
		# the hand, clear of the juggler's own body, rather than floating above it).
		draw_tut_key(font, hp + Vector2((62.0 if h == RIGHT else -62.0), -18.0), String(kc[h]), Color(0.7, 0.88, 1.0), urg)
	# throw: the bare throw key over EVERY hand still holding a ball, all lesson long
	# (Louis: the keys are shown every single time, never assumed learned). It
	# brightens when the step's whole point is that throw, stays calm otherwise.
	var goal := String(step["goal"])
	for hh: int in [LEFT, RIGHT]:
		if not holding[hh]:
			continue
		if beat and not tut_hold_names("throw", hh):
			continue
		if do_goal != "" and do_goal != ("throw_l" if hh == LEFT else "throw_r"):
			continue   # see do_goal above: one beat, one key, one prop
		# a GUIDED step is a call-and-response with one ball on the table, so the hand
		# holding it IS the ask: its key burns as brightly as any named goal would. The
		# step's goal there is the catch at the far end, and reading only that left the
		# throw the whole beat depends on looking optional. A TRICK step (2026-07-18
		# fix) gets the same treatment: "arm it, then throw" landed the trick on a
		# barely-dimmed key next to the ongoing cascade's own bright catch prompts, so
		# the follow-up throw read as optional there too.
		var wants: bool = (goal == "throw_r" and hh == RIGHT) or (goal == "throw_l" and hh == LEFT) \
			or bool(step.get("guide", false)) or String(step.get("prompt", "")) == "trick"
		# OUTWARD, NOT OVERHEAD - see the catch ring just above for the same move.
		draw_tut_key(font, fig_hand_pos(hh) + Vector2((62.0 if hh == RIGHT else -62.0), -18.0), String(kt[hh]), Color(1.0, 0.82, 0.5), 0.85 if wants else 0.4)


#endregion

#region DAY-HUB PURCHASES (PIE / GLASSES)
func try_buy_pie() -> void:
	# Uncle Dan's Pie: bought slow-motion clarity, eaten in the day hub to arm
	# the next session - lasts the WHOLE DAY, until sleep clears it (PIE_COST)
	if money < PIE_COST:
		play_sfx("whiff", -10.0)
		return
	if not confirm_spend("pie", PIE_COST, false):
		return
	money -= PIE_COST
	pie_count += 1
	shop_buy_ms = int(Time.get_ticks_msec())
	# a receipt, because the rest drawer has no price plate to confirm against
	shop_msg = "one slice in the pantry  -  %d now" % pie_count
	shop_msg_warn = false
	shop_msg_ms = int(Time.get_ticks_msec())
	save_progress()
	play_sfx("money", -6.0)




func try_buy_drinks() -> void:
	# a bulk buy only (Louis: "bought for discount in large quantities") - ONE
	# drink at a time never made sense for a stock meant to last whole
	# performances. ENERGY_DRINK_BATCH_COST undercuts what ENERGY_DRINK_BATCH
	# drinks would cost bought one at a time, the real discount asked for.
	if money < ENERGY_DRINK_BATCH_COST:
		return
	if not confirm_spend("drinks", ENERGY_DRINK_BATCH_COST, true):
		return
	money -= ENERGY_DRINK_BATCH_COST
	energy_drinks += ENERGY_DRINK_BATCH
	shop_buy_ms = int(Time.get_ticks_msec())
	# a RECEIPT, because this is now reachable from the rest drawer as well as the counter
	# and the hub has no price plate of its own to confirm against - the same green line
	# try_top_up leaves after buying a set
	shop_msg = "%d more cans - %d in reserve" % [ENERGY_DRINK_BATCH, energy_drinks]
	shop_msg_warn = false
	shop_msg_ms = int(Time.get_ticks_msec())
	save_progress()
	play_sfx("money", -6.0)


# -----------------------------------------------------------------------------
# Game flow: main menu, save slots, settings, cutscenes.
# -----------------------------------------------------------------------------

#endregion

#region MAIN MENU / SLOTS / SETTINGS INPUT
func menu_options() -> Array[String]:
	# the live main-menu list. Both menu_input and draw_menu build the list from
	# here, so the cursor and the drawing can never disagree. (There used to be a
	# "Victory" entry that replayed the credits once any save had won - Louis
	# found it confusing on the START menu, a button that looked pressable but
	# wasn't really for pressing, so it's gone; the real win still rolls credits
	# on its own, from actually clearing the World Arena - see resolve_act/results.)
	var opts: Array[String] = ["Play", "Sprint"]
	opts.append("Settings")
	opts.append("Quit")
	return opts


func menu_input(kc: int) -> void:
	var opts := menu_options()
	var n := opts.size()
	match kc:
		KEY_UP, KEY_W:
			menu_sel = (menu_sel + n - 1) % n
			play_sfx("ui", -14.0)
		KEY_DOWN, KEY_S:
			menu_sel = (menu_sel + 1) % n
			play_sfx("ui", -14.0)
		KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
			play_sfx("ui2", -11.0)
			# dispatch on the chosen STRING, never the raw index, so an option list
			# that grows a Credits entry can never send Play where Settings was meant
			var choice := opts[clampi(menu_sel, 0, n - 1)]
			match choice:
				"Play":
					menu_sel = 0
					game_state = ST_SLOTS
				"Sprint":
					begin_sprint()
				"Settings":
					menu_sel = 0
					game_state = ST_SETTINGS
				"Quit":
					get_tree().quit()
		KEY_ESCAPE:
			get_tree().quit()


func credits_key() -> void:
	# any key ends the roll and returns to the main menu
	play_sfx("ui2", -12.0)
	game_state = ST_MENU
	menu_sel = 0


func slots_input(kc: int) -> void:
	var n := NUM_SLOTS + 1   # the slots, then Back
	# Left/Right navigate too, so the horizontal slot_cards experiment reads naturally
	# (the classic bars are vertical); both drive the same menu_sel either way.
	match kc:
		KEY_UP, KEY_W, KEY_LEFT:
			menu_sel = (menu_sel + n - 1) % n
		KEY_DOWN, KEY_S, KEY_RIGHT:
			menu_sel = (menu_sel + 1) % n
		KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
			if menu_sel >= NUM_SLOTS:
				menu_sel = 0
				game_state = ST_MENU
			else:
				start_slot(menu_sel)
		KEY_X, KEY_DELETE, KEY_BACKSPACE:
			if menu_sel < NUM_SLOTS:
				delete_slot(menu_sel)   # wipe that save file
		KEY_ESCAPE:
			menu_sel = 0
			game_state = ST_MENU


func settings_input(kc: int) -> void:
	# HARD COLLISIONS CAME OUT ON 2026-07-29 (Louis: "remove hard collisions from settings,
	# since it's no longer implemented"). It was the last reader of the mid-air clack, which
	# lost its other one when the Close Quarters Encore was replaced. The Ball.bumped field
	# and the clack loop go with it - a setting nobody can reach is a mechanic nobody can
	# meet, and leaving the machinery in place only makes the next reader believe it works.
	var n := 11  # music, sound, shake, reduce-motion, fullscreen, dominant hand, difficulty,
				 # catch with a full hand, controls, records, Back. Keep this equal to the
				 # length of `rows` in draw_settings_cards AND to what its `sections` cover -
				 # the three have to be edited in one go, and the last time they were not,
				 # `sections` listed a row 9 that `rows` did not have.
	match kc:
		KEY_UP, KEY_W:
			menu_sel = (menu_sel + n - 1) % n
			play_sfx("ui", -14.0)
		KEY_DOWN, KEY_S:
			menu_sel = (menu_sel + 1) % n
			play_sfx("ui", -14.0)
		KEY_ENTER, KEY_KP_ENTER, KEY_SPACE, KEY_LEFT, KEY_RIGHT:
			# Music / Sound are VOLUME SLIDERS now, not on/off: Left/Right fine-tune
			# in 10% steps, Enter/Space mutes and restores (0.0 <-> full)
			if menu_sel == 0 or menu_sel == 1:
				var step := 0.1 if kc == KEY_RIGHT else (-0.1 if kc == KEY_LEFT else 0.0)
				if menu_sel == 0:
					set_music = clampf(set_music + step, 0.0, 1.0) if step != 0.0 else (0.0 if set_music > 0.0 else 1.0)
				else:
					set_sfx = clampf(set_sfx + step, 0.0, 1.0) if step != 0.0 else (0.0 if set_sfx > 0.0 else 1.0)
				play_sfx("ui2", -12.0)
				save_settings()
				return
			match menu_sel:
				2:
					set_shake = not set_shake
				3:
					reduce_motion = not reduce_motion
				4:
					set_fullscreen = not set_fullscreen
					apply_fullscreen()
				5:
					dominant_hand = LEFT if dominant_hand == RIGHT else RIGHT
				6:
					# a three-way cycle, not a toggle - Left steps back, everything else
					# (Right, Enter, Space) steps forward, same as the pick screen's own cursor
					difficulty = (difficulty + 2) % 3 if kc == KEY_LEFT else (difficulty + 1) % 3
				7:
					set_catch_full = not set_catch_full
				8:
					remap_sel = 0
					remap_wait = false
					game_state = ST_REMAP   # the controls reference (and rebind the six actions)
				9:
					game_state = ST_STATS   # the career ledger, back with Esc
				10:
					menu_sel = 0
					game_state = ST_MENU
			play_sfx("ui2", -12.0)
			save_settings()
		KEY_ESCAPE:
			save_settings()
			menu_sel = 0
			game_state = ST_MENU


func apply_fullscreen() -> void:
	DisplayServer.window_set_mode(
		DisplayServer.WINDOW_MODE_FULLSCREEN if set_fullscreen else DisplayServer.WINDOW_MODE_WINDOWED)


#endregion

#region SAVE SLOTS
func start_slot(i: int) -> void:
	sprint_active = false
	sprint_failed = false
	save_slot = i
	# THE DEBUG BUILD HAS ONE SAVE, NOT THREE, and it must never be reset. save_file()
	# returns SAVE_PATH_DEBUG whenever debug_mode is on, so the per-slot file this screen
	# shows is not what actually gets loaded - and measuring `fresh` against slot_path(i)
	# would send a stocked sandbox through reset_new_game() and into the basics tutorial,
	# wiping every maxed stat the moment Louis clicked a slot. load_progress() stocks the
	# debug save if it has not been (see debug_stock), so this always resumes a full one.
	if debug_mode:
		load_progress()
		enter_day()
		return
	var fresh := not FileAccess.file_exists(slot_path(i))
	if fresh:
		# a brand new career picks its pace first (SLOTH/BEAR/OCTOPUS - see
		# difficulty_input) and THEN opens straight into the hands-on basics; the pick
		# has to land before reset_new_game, since Octopus's empty starting purse is
		# read there.
		diff_pick_sel = difficulty
		game_state = ST_DIFFICULTY
	else:
		load_progress()
		if post_lesson_show:
			# The mandatory first show was booked before the previous session ended.
			# Resume that onboarding beat instead of silently dropping the player in the hub.
			begin_performance(num_balls)
		else:
			enter_day()   # an existing career resumes at its day, not mid-juggle


func difficulty_input(kc: int) -> void:
	# three choices, Left/Right (or Up/Down - either reads naturally on three cards in
	# a row) move the cursor, Enter commits it as the GLOBAL setting and starts the new
	# career. There is no Back: a brand new slot has nothing to return TO but the slot
	# screen it just came from, which Escape still reaches.
	match kc:
		KEY_LEFT, KEY_UP, KEY_A, KEY_W:
			diff_pick_sel = (diff_pick_sel + 2) % 3
			play_sfx("ui", -14.0)
		KEY_RIGHT, KEY_DOWN, KEY_D, KEY_S:
			diff_pick_sel = (diff_pick_sel + 1) % 3
			play_sfx("ui", -14.0)
		KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
			difficulty = diff_pick_sel
			sprint_active = false
			sprint_failed = false
			save_settings()
			reset_new_game()
			# a brand new career opens straight into the hands-on basics (one ball, then
			# two, then the cascade); tut_finish drops into the day when they are done
			seen_tuts.append("balls")
			# reset_new_game() saved the newly-created slot before the lesson marker existed.
			# Persist it now so closing the window mid-lesson cannot turn the slot into an
			# "existing" career that resumes in the day hub and silently skips the basics.
			save_progress()
			begin_tutorial("balls")
			play_sfx("ui2", -11.0)
		KEY_ESCAPE:
			game_state = ST_SLOTS


func reset_new_game() -> void:
	# a brand new juggler, so a fresh slot never inherits the previous one's stats
	accuracy = 5
	strength = 6
	endurance = 0
	speed = 0
	pie_count = 0
	pie_active = false
	match difficulty:
		DIFF_SLOTH: money = SLOTH_START_GOLD
		DIFF_OCTOPUS: money = 0
		_: money = START_GOLD
	reputation = 0
	prop_count = [3, 0, 0, 0, 0, 0, 0]   # the starting kit: three worn stage balls
	sync_props()
	prop_type = PROP_BALLS
	glow_count = [0, 0, 0, 0, 0, 0, 0]
	has_backroom = false
	energy_drinks = 0
	level = 1
	xp = 0
	points = 0
	won = false
	demo_wall_seen = false   # fixing a gap from when this flag was first added: a
	purist_legend_seen = false   # fresh slot must not inherit a previous career's flags
	post_lesson_show = false
	show_guide_seen = false
	best_scores = [0, 0, 0, 0, 0, 0, 0]
	best_scores_purist = [0, 0, 0, 0, 0, 0, 0]
	pattern_sel = CASCADE
	purist = false
	purist_picks = [false, false, false, false]
	career = {"perfs": 0, "practices": 0, "catches": 0, "drops": 0,
		"best_streak": 0, "gold_earned": 0, "tricks": 0, "days": 1, "best_score": 0,
		"mastery": 0}
	day = 1
	seg_used = 0
	venue_pick = 0
	meals = 0
	tomatoes = 0           # nobody has thrown anything at a juggler who has not performed
	started = false
	seen_tuts.clear()      # a fresh slot re-teaches everything from scratch
	pending_tuts.clear()
	ante = [0, 0, 0, 0, 0, 0, 0]   # every venue back to its opening bar
	gifted.clear()              # a fresh slot earns (or is re-gifted) everything anew
	perfs_since_unlock = 0
	aid_pie_day = -1
	aid_meal_used = false
	stamina_max = 100.0 + 9.0 * float(endurance)
	stamina = stamina_max
	save_progress()


func begin_sprint() -> void:
	# Transient high-stakes route: reset its own in-memory career and never writes to a slot.
	# The familiar act and shop systems remain in use; only the rules around them change.
	sprint_active = true
	sprint_failed = false
	sprint_started_ms = Time.get_ticks_msec()
	sprint_finished_ms = -1
	# The route seed is part of its rules, not the wall clock. Every attempt in this
	# build sees the same simulation rolls, and each stage derives its own stream below.
	sprint_seed = 20260818
	sprint_replays.clear()
	reset_new_game()
	seen_tuts = ["balls"]
	pending_tuts.clear()
	enter_day()
	set_day_msg("SPRINT  -  no practice. One drop ends the attempt; clear all 3 goals to advance.")


func sprint_clock_text() -> String:
	var end_ms := sprint_finished_ms if sprint_finished_ms >= 0 else Time.get_ticks_msec()
	return TOSSA_FORMAT.duration_text(int((end_ms - sprint_started_ms) / 1000))


func sprint_record(action: String) -> void:
	if sprint_active and not sprint_replay.is_empty():
		TOSSA_REPLAY.append_event(sprint_replay, tick, action)


const OLD_NAMES: Array[String] = ["PIXELTOSSA"]   # every name this game has shipped under,
												  # newest first - see migrate_old_saves.
# ONE ENTRY, AND THE ENTRY THAT IS *NOT* HERE IS THE LOAD-BEARING ONE (2026-08-15).
#
# The list was empty on purpose while this was a fork with its own name. Taking the TOSSA
# name back means `config/name` is now "TOSSA", so `user://` moved from
# `app_userdata/PIXELTOSSA/` to `app_userdata/TOSSA/` and every career written under the
# fork's name is in the old folder. "PIXELTOSSA" carries them across.
#
# "TOSSA" MUST NEVER GO IN THIS LIST. `app_userdata/TOSSA/` is not empty - it holds the
# code-drawn original's own `tossa_*.cfg` saves, and that is now the folder this game
# lives in. Two things keep the two games' careers apart, and both matter:
#   1. Our save FILENAMES stay `pixeltossa_*.cfg`. That looks odd in a game called TOSSA
#      and it is deliberate: it is the only thing making the two sets of files
#      distinguishable inside one shared folder, and it costs a player nothing because no
#      save filename is ever shown. Renaming them to `tossa_*.cfg` would collide with the
#      archived game's saves file for file.
#   2. Adding "TOSSA" here would make migrate_old_saves copy the vector game's careers in
#      over the top on first launch - a different game's progress, silently adopted.
#
# The far more important half: "TOSSA" MUST NEVER BE ADDED HERE. migrate_old_saves walks
# to the PARENT of OS.get_user_data_dir() and reads the sibling folder named for each
# entry, so listing TOSSA would make this game read app_userdata/TOSSA/ - the live career
# of the game it was forked from. It only ever copies, never moves, so TOSSA's files
# would survive; but the two saves would then diverge silently under two different names,
# which is exactly the confusion an independent fork exists to avoid. Separate folder,
# separate filenames, separate career. Nothing crosses.

func migrate_old_saves() -> void:
	# THE RENAME MUST NOT COST ANYONE THEIR CAREER (2026-07-28), and it very nearly did,
	# in TWO separate ways that both had to be handled.
	#
	# (1) THE FILENAME. Every save is keyed by one, so IACTO -> TOSSA left three slots, a
	# settings file and the debug save sitting under names nothing reads any more.
	#
	# (2) THE FOLDER, which is the one that is easy to miss. `user://` on desktop is
	# `.../Godot/app_userdata/<config/name>/`, so renaming the PROJECT silently points
	# user:// at a brand new empty directory - a migration that only looks inside
	# user:// finds nothing and reports success. Verified on Louis's own machine: three
	# real careers sat in `app_userdata/IACTO/` while `app_userdata/TOSSA/` was empty.
	# The old folder is a SIBLING of the current one, which is true on every desktop
	# platform Godot uses this layout for, so it is reachable without hardcoding a path:
	# take the parent of OS.get_user_data_dir() and append the old name.
	#
	# It COPIES rather than moves, deliberately: an old build still installed keeps
	# working and the two simply diverge, which is the safe direction to fail in. It only
	# ever writes a file that is not already there, so it is idempotent - a second launch
	# does nothing, and a real TOSSA save is never overwritten by a stale IACTO one.
	# Delete this once no build under an old name is left anywhere, and not before:
	# "nobody could still have one" is a guess, not a fact.
	var here := DirAccess.open("user://")
	if here == null:
		return
	var parent := OS.get_user_data_dir().get_base_dir()
	for old_name in OLD_NAMES:
		var stem := String(old_name).to_lower()
		var names := [stem + "_settings.cfg", stem + "_debug.cfg", stem + "_demo.cfg"]
		for i in NUM_SLOTS:
			names.append(stem + "_slot%d.cfg" % i)
		for fn in names:
			var to := String(fn).replace(stem + "_", "pixeltossa_")
			if here.file_exists(to):
				continue                                  # a real PIXELTOSSA file wins
			if here.file_exists(fn):                      # (1) same folder, old name
				here.copy("user://" + fn, "user://" + to)
			else:                                         # (2) the old project's folder
				var src := parent.path_join(old_name).path_join(fn)
				if FileAccess.file_exists(src):
					DirAccess.copy_absolute(src, OS.get_user_data_dir().path_join(to))


func sync_props() -> void:
	# every per-prop array is exactly as long as PROPS, whatever a save file said. An old
	# save written before a prop existed simply leaves the new slot at zero, which is the
	# right answer: you do not own what did not exist.
	if prop_count.size() != PROPS.size():
		prop_count.resize(PROPS.size())


func slot_path(i: int) -> String:
	return "user://pixeltossa_slot%d.cfg" % i


func delete_slot(i: int) -> void:
	var dir := DirAccess.open("user://")
	var fn := "pixeltossa_slot%d.cfg" % i
	if dir != null and dir.file_exists(fn):
		dir.remove(fn)


#endregion

#region SETTINGS PERSISTENCE & CONTROLS REMAP
func load_settings() -> void:
	var cf := ConfigFile.new()
	if cf.load(SETTINGS_PATH) == OK:
		set_shake = bool(cf.get_value("opt", "shake", true))
		reduce_motion = bool(cf.get_value("opt", "reduce_motion", false))
		set_catch_full = bool(cf.get_value("opt", "catch_full", false))
		dominant_hand = int(cf.get_value("opt", "dominant_hand", RIGHT))
		difficulty = clampi(int(cf.get_value("opt", "difficulty", DIFF_BEAR)), DIFF_SLOTH, DIFF_OCTOPUS)
		set_music = clampf(float(cf.get_value("opt", "music", 1.0)), 0.0, 1.0)
		set_sfx = clampf(float(cf.get_value("opt", "sfx", 1.0)), 0.0, 1.0)
		set_fullscreen = bool(cf.get_value("opt", "fullscreen", false))
		K_LC = int(cf.get_value("keys", "lc", KEY_D))
		K_LT = int(cf.get_value("keys", "lt", KEY_F))
		K_RC = int(cf.get_value("keys", "rc", KEY_K))
		K_RT = int(cf.get_value("keys", "rt", KEY_J))
		K_TRICK = int(cf.get_value("keys", "trick", KEY_SPACE))
		K_CYCLE = int(cf.get_value("keys", "cycle", KEY_C))
		PAD_TRICK = int(cf.get_value("keys", "pad_trick", JOY_BUTTON_X))
		PAD_CYCLE = int(cf.get_value("keys", "pad_cycle", JOY_BUTTON_LEFT_STICK))
		# F9 variants belong to debug work only. Do not let an old local debug choice
		# alter the look of a release build that happens to share this user:// folder.
		if OS.is_debug_build():
			var loaded_exp = cf.get_value("opt", "experiments", experiments)
			if loaded_exp is Dictionary:
				for def in EXPERIMENT_DEFS:   # merge onto the defaults, so a NEW experiment
					var eid := String(def["id"])   # added later always starts at its own
					if loaded_exp.has(eid):        # default rather than a missing key
						experiments[eid] = bool(loaded_exp[eid])
			var loaded_var = cf.get_value("opt", "variants", art_variants)
			if loaded_var is Dictionary:
				for def in VARIANT_DEFS:
					var vid := String(def["id"])
					if loaded_var.has(vid):
						# CLAMPED ON THE WAY IN, not trusted. This file survives a code
						# change that shortens an option list, and an out-of-range index
						# would otherwise reach variant() every frame for the rest of the
						# session. Option 0 is always the shipped default.
						art_variants[vid] = clampi(int(loaded_var[vid]), 0, (def["opts"] as Array).size() - 1)


func save_settings() -> void:
	var cf := ConfigFile.new()
	cf.set_value("opt", "shake", set_shake)
	cf.set_value("opt", "reduce_motion", reduce_motion)
	cf.set_value("opt", "catch_full", set_catch_full)
	cf.set_value("opt", "dominant_hand", dominant_hand)
	cf.set_value("opt", "difficulty", difficulty)
	cf.set_value("opt", "music", set_music)
	cf.set_value("opt", "sfx", set_sfx)
	cf.set_value("opt", "fullscreen", set_fullscreen)
	cf.set_value("keys", "lc", K_LC)
	cf.set_value("keys", "lt", K_LT)
	cf.set_value("keys", "rc", K_RC)
	cf.set_value("keys", "rt", K_RT)
	cf.set_value("keys", "trick", K_TRICK)
	cf.set_value("keys", "cycle", K_CYCLE)
	cf.set_value("keys", "pad_trick", PAD_TRICK)
	cf.set_value("keys", "pad_cycle", PAD_CYCLE)
	if OS.is_debug_build():
		cf.set_value("opt", "experiments", experiments)
		cf.set_value("opt", "variants", art_variants)
	cf.save(SETTINGS_PATH)


func action_key(id: String) -> int:
	match id:
		"lc": return K_LC
		"lt": return K_LT
		"rc": return K_RC
		"rt": return K_RT
		"trick": return K_TRICK
		_: return K_CYCLE


func bind_action(id: String, kc: int) -> void:
	# assign kc to the action. If another action already holds kc, the two SWAP,
	# so every action always keeps some key and no press can mean two things.
	var old := action_key(id)
	for a in REMAP_ACTS:
		var aid := String(a[0])
		if aid != id and action_key(aid) == kc:
			_set_action_key(aid, old)
	_set_action_key(id, kc)
	save_settings()


func _set_action_key(id: String, kc: int) -> void:
	match id:
		"lc": K_LC = kc
		"lt": K_LT = kc
		"rc": K_RC = kc
		"rt": K_RT = kc
		"trick": K_TRICK = kc
		"cycle": K_CYCLE = kc


func pad_action_button(id: String) -> int:
	return PAD_TRICK if id == "trick" else PAD_CYCLE


func bind_pad_action(id: String, btn: int) -> void:
	# same clash-swap rule as the keyboard six (bind_action above), scoped to the
	# two pad-remappable actions: no press can ever mean two things.
	var old := pad_action_button(id)
	for a in PAD_ACTS:
		var aid := String(a[0])
		if aid != id and pad_action_button(aid) == btn:
			_set_pad_action_button(aid, old)
	_set_pad_action_button(id, btn)
	save_settings()


func _set_pad_action_button(id: String, btn: int) -> void:
	if id == "trick":
		PAD_TRICK = btn
	else:
		PAD_CYCLE = btn


func remap_input(kc: int) -> void:
	# remap_wait is handled upstream in _input (it captures the raw next key or,
	# on the gamepad column, the raw next pad button - see _input). Tab (keyboard,
	# or the pad's own Y/sheet button) swaps which column has focus.
	if kc == KEY_TAB:
		remap_col = 1 - remap_col
		remap_wait = false
		play_sfx("ui", -14.0)
		return
	if remap_col == 0:
		var n := REMAP_ACTS.size()
		match kc:
			KEY_UP, KEY_W:
				remap_sel = (remap_sel + n - 1) % n
				play_sfx("ui", -14.0)
			KEY_DOWN, KEY_S:
				remap_sel = (remap_sel + 1) % n
				play_sfx("ui", -14.0)
			KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
				remap_wait = true
				play_sfx("ui2", -13.0)
			KEY_ESCAPE:
				game_state = ST_SETTINGS
				play_sfx("ui", -12.0)
	else:
		var m := PAD_ACTS.size()
		match kc:
			KEY_UP, KEY_W:
				pad_remap_sel = (pad_remap_sel + m - 1) % m
				play_sfx("ui", -14.0)
			KEY_DOWN, KEY_S:
				pad_remap_sel = (pad_remap_sel + 1) % m
				play_sfx("ui", -14.0)
			KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
				remap_wait = true
				play_sfx("ui2", -13.0)
			KEY_ESCAPE:
				game_state = ST_SETTINGS
				play_sfx("ui", -12.0)


func pad_button_glyph(btn: int) -> String:
	# short display name for a raw pad button, used only on the Controls screen's
	# gamepad column (the k_* hint helpers elsewhere use plain "A"/"B"/... directly)
	match btn:
		JOY_BUTTON_A: return "A"
		JOY_BUTTON_B: return "B"
		JOY_BUTTON_X: return "X"
		JOY_BUTTON_Y: return "Y"
		JOY_BUTTON_LEFT_SHOULDER: return "LB"
		JOY_BUTTON_RIGHT_SHOULDER: return "RB"
		JOY_BUTTON_LEFT_STICK: return "L3"
		JOY_BUTTON_RIGHT_STICK: return "R3"
		JOY_BUTTON_BACK: return "Back"
		JOY_BUTTON_START: return "Start"
		JOY_BUTTON_DPAD_UP: return "D-Up"
		JOY_BUTTON_DPAD_DOWN: return "D-Down"
		JOY_BUTTON_DPAD_LEFT: return "D-Left"
		JOY_BUTTON_DPAD_RIGHT: return "D-Right"
		_: return "Btn %d" % btn


