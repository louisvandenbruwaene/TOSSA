			play_sfx("ui", -15.0)
		KEY_ENTER, KEY_KP_ENTER:
			_sheet_invest(ids[sheet_sel])
		KEY_1:
			sheet_sel = 0
			_sheet_invest("acc")
		KEY_2:
			sheet_sel = 1
			_sheet_invest("str")
		KEY_3:
			sheet_sel = 2
			_sheet_invest("end")
		KEY_4:
			sheet_sel = 3
