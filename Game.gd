# THE SHOP'S CURSOR IS TWO ROWS, and where one ends and the other begins is PROPS.size(),
# never a literal (2026-07-28). Adding the chainsaw as a seventh prop broke this in a
# dozen places at once: `shop_sel <= 5` sent the cursor's seventh card to try_buy_glasses,
# the up/down hop divided by a hard 6, and the row wrapped at a hard 10. Everything below
# is now derived, so an eighth prop is a PROPS row and nothing else.
# THE SHOP HAS TWO ROOMS (2026-07-28, Louis: "the shop can use ... like an 16+ fee, when
# payed you can enter the back of the shop, which contains the dangerous juggling
# equipment and uncle dan's pie"). It is a joke and it is also the fix for a real problem:
# a single row of prop cards ran out of screen width at SEVEN props, and no arithmetic
# saves it at eleven. Splitting the goods by what they ARE gives every card room again and
# gives the dangerous half a door to be behind.
const SHOP_ROOM_FRONT := 0
const SHOP_ROOM_BACK := 1

func shop_props() -> Array[int]:
	# EVERY PROP, IN ONE ROW (2026-07-29). Derived from PROPS, so an eighth is one table entry
	# and no other edit - the lesson the chainsaw taught when it walked into six hard-coded 6s.
	var out: Array[int] = []
	for i in PROPS.size():
		out.append(i)
	return out


func shop_gear() -> Array[Dictionary]:
	# WHAT THE SHOP STILL SELLS (2026-07-29, Louis: "I want all of these clothes to be for sale
	# in the tailor, not the shop. so sell the glow in dark props in the shop and glow in the
	# dark clothes with all other clothes in the tailor ... Energy drinks should ONLY be able
	# to be bought in the resting menu ... Uncle dan's pie should also be only for sale in the
	# rest menu. That should perhaps make the shop just one part again").
	#
	# So this is the PROP shop and nothing else: the objects you juggle, and the one piece of
	# gear that is about the objects rather than about you. Glasses, gloves, boots, hat,
	# tailcoat, waistcoat, glow suit and the energy helmet are clothing and live in the tailor;
	# the pie and the drinks are food and live in REST. Everything is where the thing IS - which
	# is also what let the two rooms and the 16+ curtain go, since they existed to solve a
	# layout problem (seven prop cards would not fit beside eleven gear ones) that no longer
	# exists.
	var g: Array[Dictionary] = []
	g.append({"id": "glow_tape", "name": "Glow Tape", "cost": GLOW_TAPE_COST, "owned": has_glow_tape,
		"col": Color(0.65, 0.95, 0.55), "desc": "the PROPS carry phosphor: you can read the pattern on any dark stage"})
	return g


func shop_gear0() -> int:
	return shop_props().size()          # the index the gear row starts at


func shop_cards() -> int:
	return shop_props().size() + shop_gear().size()


func shop_on_door() -> bool:
	return false   # ONE ROOM: there is nowhere to walk to. Kept as a function rather than
				   # deleted because prop CATEGORIES (the accepted next big piece) will want a
				   # drawer again, and this is the seam it will open at.

# THE KEYBOARD SHORTCUT PRINTED ON EACH CARD, in card order across both rows. One table,
# read by the drawing AND by shop_input, because the two disagreeing is exactly what
# happened when a seventh prop took the 7 key and every gear card went on advertising the
# one above it. Past the end of this list a card simply prints no shortcut rather than a
# wrong one - the arrows and Enter already reach every card.
const SHOP_KEYS: Array[String] = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "-"]

func shop_key_label(i: int) -> String:
	return SHOP_KEYS[i] if i >= 0 and i < SHOP_KEYS.size() else ""

func shop_buy_sel() -> void:
	# Enter (pad A) acts on whichever card the cursor lights, prop or gear - or walks
	# through the door, which is the one slot that is not a purchase
	var props := shop_props()
	if shop_sel < props.size():
		try_buy(props[shop_sel])
		return
	var g := shop_gear()
	var gi := shop_sel - props.size()
	if gi < 0 or gi >= g.size():
		return
	try_buy_gear(String(g[gi]["id"]))


func try_buy_gear(id: String) -> void:
	# the shop's gear row is one item now - the glow TAPE, which is about the props. Every
	# other piece of gear became clothing and is bought in the tailor, per house.
	if id != "glow_tape" or has_glow_tape or money < GLOW_TAPE_COST:
		return
	if not confirm_spend("glow_tape", GLOW_TAPE_COST, true):
		return
	money -= GLOW_TAPE_COST
	has_glow_tape = true
	shop_buy_ms = int(Time.get_ticks_msec())
	save_progress()
	play_sfx("money", -6.0)


func shop_input(kc: int) -> void:
	# the shop's keys, shared by the play overlay and the day hub. The number on
	# each card is its buy key: 1-7 the props (balls included), 8 glasses, 9 pie,
	# 0 the Glow Kit, - the helmet (then Energy Drinks once it's owned). Arrows
	# (dpad, stick) walk the cards - left/right along a row, up/down between the
	# prop row and the four-card gear row (each prop column hops to its nearest
	# gear card) - and Enter buys the lit one, so a pad shops as freely as the
	# keyboard. A number key also pulls the cursor onto its card.
	match kc:
		KEY_TAB, KEY_ESCAPE, KEY_S:
			shop_open = false
		KEY_LEFT:
			shop_sel = (shop_sel + shop_cards() - 1) % shop_cards()
			play_sfx("ui", -15.0)
		KEY_RIGHT:
			shop_sel = (shop_sel + 1) % shop_cards()
			play_sfx("ui", -15.0)
		KEY_DOWN, KEY_UP:
			var g0 := shop_gear0()
			var gn := maxi(1, shop_gear().size())
			if shop_sel < g0:
				shop_sel = g0 + shop_sel * gn / maxi(g0, 1)   # prop column -> nearest gear card
			else:
				shop_sel = (shop_sel - g0) * maxi(g0, 1) / gn   # ...and back again
			shop_sel = clampi(shop_sel, 0, shop_cards() - 1)
			play_sfx("ui", -15.0)
		KEY_ENTER, KEY_KP_ENTER:
			shop_buy_sel()
		KEY_B, KEY_SPACE:
			# BUY THE SET: enough of the lit prop to field your current count in one
			# press (gear has no sets, so it just buys the one thing). KEY_SPACE is here
			# for the pad: X routes to Space outside live play, and nothing else in the
			# shop claims it - the same trick the save-slot screen uses for delete.
			if shop_sel < shop_gear0():
				try_top_up(shop_props()[shop_sel])
			else:
				shop_buy_sel()
		# THE NUMBER KEYS ADDRESS THE ROOM YOU ARE STANDING IN, in card order, which is
		# the only scheme that survives the goods being split across two rooms - and it
		# is what the printed key on each card already says (see SHOP_KEYS).
		KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9, KEY_0, KEY_MINUS:
			var idx := SHOP_KEYS.find(OS.get_keycode_string(kc).to_lower())
			if idx >= 0 and idx < shop_cards():
				shop_sel = idx
				shop_buy_sel()


func skills_input(kc: int) -> void:
	# the Skills reference: browse every trick and pattern. Up/Down walk the whole
	# list (tricks then patterns), Left/Right jump between the two columns.
	var n := TRICKS.size() + PATTERNS.size()
	match kc:
		KEY_UP, KEY_W:
			skills_sel = (skills_sel + n - 1) % n
			play_sfx("ui", -15.0)
		KEY_DOWN, KEY_S:
			skills_sel = (skills_sel + 1) % n
			play_sfx("ui", -15.0)
		KEY_LEFT, KEY_A:
			skills_sel = mini(skills_sel, TRICKS.size() - 1)   # into the tricks column
			play_sfx("ui", -15.0)
		KEY_RIGHT, KEY_D:
			skills_sel = maxi(skills_sel, TRICKS.size())        # into the patterns column
			play_sfx("ui", -15.0)
		KEY_ENTER, KEY_KP_ENTER:
			practice_skill(skills_sel)   # drop into a practice with this skill on
		KEY_TAB, KEY_ESCAPE:
			skills_open = false
			play_sfx("ui", -13.0)


func practice_skill(idx: int) -> void:
	# Enter on a Skills entry books a PRACTICE with that skill already engaged, so a
	# trick (or pattern) can be drilled straight from where it is explained (Louis).
	# Costs a day segment like any practice; a locked skill or an empty tank refuses.
	var is_trick := idx < TRICKS.size()
	# the Skills screen lists patterns in UNLOCK order (pattern_order), so a
	# pattern row index translates back to the raw PATTERNS index here
	var pat := -1 if is_trick else int(pattern_order()[idx - TRICKS.size()])
	if is_trick and not trick_unlocked(idx):
		set_day_msg("that trick asks for %s" % skill_req_text(TRICKS[idx]))
		play_sfx("whiff", -10.0)
		return
	if not is_trick and not pattern_unlocked(pat):
		set_day_msg("that pattern asks for %s" % skill_req_text(PATTERNS[pat]))
		play_sfx("whiff", -10.0)
		return
	if too_tired():
		set_day_msg("too tired to practise  -  sleep first")
		play_sfx("whiff", -10.0)
		return
	# a pattern practice keeps the current ball count as-is (Cascade reads either
	# way, crossing odd / same-hand even; every other pattern is unlocked at its
	# own count regardless). The pattern rides the ONE-SESSION override, never
	# pattern_sel: trying a pattern from the Skills screen must not re-book the act
	# (Louis) - only P, the player's own hand, changes the persistent choice.
	if not is_trick:
		pattern_once = pat
	skills_open = false
	seg_used += 1
	career["practices"] = int(career["practices"]) + 1
	save_progress()
	mode = MODE_TRAIN
	game_state = ST_PLAY
	start_run(num_balls)
	# now engage the chosen trick (start_run has cleared the per-run trick state):
	# a toggle switches ON and stays, an arm trick primes the next throw, Spin just
	# loads. The player still throws to begin, so nothing fires unbidden.
	if is_trick:
		trick_sel = idx
		var kind := String(TRICKS[idx]["kind"])
		if kind == "toggle":
			toggle_on = idx
			toggle_scored = false
			set_trick_msg("%s ON  -  practising" % String(TRICKS[idx]["name"]).to_upper())
		elif kind == "arm":
			trick_primed = true
			set_trick_msg("%s  -  next throw" % String(TRICKS[idx]["name"]).to_upper())
		else:
			set_trick_msg("%s selected  -  %s performs it" % [String(TRICKS[idx]["name"]), k_trick()[0]])
	else:
		set_trick_msg("%s  -  %s" % [String(PATTERNS[pattern]["name"]).to_upper(), String(PATTERNS[pattern]["desc"])])
	play_sfx("ui2", -11.0)


#endregion

#region LIVE PROP / PATTERN / COUNT SWITCHING
func cycle_prop(dir: int) -> void:
	# step to the next prop you own enough of, and restart with it (per-run setting)
	var n := PROPS.size()
	var k := prop_type
	for _i in n:
		k = (k + dir + n) % n
		if available(k):
			prop_type = k
			break
	start_run(num_balls)


func cycle_prop_live(dir: int) -> void:
	# switch objects mid-performance WITHOUT restarting (Louis): the props already in
	# play are re-skinned to the new object and the run, score and streak carry on.
	# The new weight and spin take effect on the next throw. Only objects you own
	# enough of for the CURRENT load are offered.
	var n := PROPS.size()
	var need := maxi(MIN_BALLS, balls.size())
	var found := -1
	var k := prop_type
	for _i in n:
		k = (k + dir + n) % n
		if k != prop_type and have(k) >= need:
			found = k
			break
	if found < 0:
		set_trick_msg("no other object you own %d of" % need)
		play_sfx("late", -12.0)
		return
	prop_type = found
	var i := 0
	for b in balls:
		b.kind = prop_type
		b.color = ball_color(i) if prop_type == PROP_BALLS else prop_color(prop_type)
		b.spin_dir = 1.0 if i % 2 == 0 else -1.0
		i += 1
	set_trick_msg(String(PROPS[prop_type]["name"]).to_upper())
	play_sfx("ui2", -13.0)


func set_count_live(n: int) -> void:
	# change the LOAD mid-performance without restarting (Louis): extra props are
	# handed in from offstage into a hand no ball is flying toward, and removing
	# props takes HELD ones away. The run, score and streak carry on; the streak
	# cap and object mult simply follow the new count from here.
	n = clampi(n, MIN_BALLS, max_balls())
	if n == balls.size():
		return
	if have(prop_type) < n:
		set_trick_msg("you own %d of those  -  the shop sells more" % have(prop_type))
		play_sfx("late", -12.0)
		return
	while balls.size() < n:
		# a new ball skips any hand something is already flying toward (it would arrive
		# on top of that catch); between two free hands, top_up_side keeps the DOMINANT
		# hand holding the odd prop - it used to top up whichever hand held fewer, which
		# put the extra in the weak hand as often as not
		var free: Array[int] = []
		for hh in [LEFT, RIGHT]:
			var busy := false
			for b in balls:
				if b.state == STATE_FLIGHT and b.to_hand == hh:
					busy = true
					break
			if not busy:
				free.append(hh)
		var to_h := top_up_side(free)
		if to_h < 0:
			set_trick_msg("hands are busy  -  try again between catches")
			play_sfx("late", -12.0)
			break
		var nb := Ball.new()
		nb.state = STATE_HAND
		nb.kind = prop_type
		nb.color = ball_color(balls.size()) if prop_type == PROP_BALLS else prop_color(prop_type)
		nb.spin_dir = 1.0 if balls.size() % 2 == 0 else -1.0
		balls.append(nb)
		stack(to_h).append(nb)
	while balls.size() > n:
		var from_h := take_from_side()   # the weak hand gives one up first
		if from_h < 0 or stack(from_h).is_empty():
			set_trick_msg("everything is in the air  -  catch one first")
			play_sfx("late", -12.0)
			break
		var gone: Ball = stack(from_h).pop_back()
		balls.erase(gone)
	num_balls = balls.size()
	# the lane bookkeeping re-seeds for the new count (a middle lane may appear
	# or vanish); Tennis keeps its mark unless that very ball just left the stage
	col_air_ref = -1.0
	col_mid_ball = null
	if tennis_ball != null and not balls.has(tennis_ball):
		tennis_ball = null
	set_trick_msg("%d OBJECTS" % num_balls)
	play_sfx("ui2", -13.0)


func cycle_pattern_live(dir: int) -> void:
	# switch the routine mid-performance WITHOUT restarting: like a trick toggle, the
	# new pattern simply shapes every throw from here on. Balls already in flight keep
	# their own paths; the lane bookkeeping resets so Columns starts clean.
	var un: Array = []
	for i in pattern_order():
		if pattern_unlocked(i):
			un.append(i)
	if un.size() <= 1:
		set_trick_msg("the next pattern (Columns) asks for %s" % skill_req_text(PATTERNS[COLUMNS]))
		return
	pattern_once = -1   # the player's own hand on P ends any Skills-practice override
	var idx := un.find(pattern_sel)
	pattern_sel = int(un[(idx + dir + un.size()) % un.size()]) if idx >= 0 else int(un[0])
	pattern = pattern_sel
	col_air_ref = -1.0
	col_mid_ball = null
	tennis_ball = null   # Tennis re-marks its ball on the first throw under it
	redeal_for_pattern()
	set_trick_msg("%s  -  %s" % [String(PATTERNS[pattern_sel]["name"]).to_upper(), String(PATTERNS[pattern_sel]["desc"])])
	play_sfx("ui2", -13.0)


func confirm_spend(id: String, cost: int, in_shop: bool) -> bool:
	# any purchase that would leave tonight's bed unaffordable asks ONCE before
	# it goes through (Louis: warn anywhere the player can strand themselves,
	# because no bed and no strength to busk is the end of the road)
	if money - cost >= INN_COST:
		return true
	var now := int(Time.get_ticks_msec())
	if _confirm_id == id and now - _confirm_ms < 4000:
		_confirm_id = ""
		return true
	_confirm_id = id
	_confirm_ms = now
	var wtext := "careful  -  that leaves you short of the inn (%d %s). press again to spend anyway" % [INN_COST, coin_word()]
	if in_shop:
		shop_msg = wtext
		shop_msg_ms = now
		shop_msg_warn = true
	else:
		set_day_msg(wtext)
	play_sfx("late", -8.0)
	return false


func try_buy(kind: int) -> void:
	# buy one more of a prop; you can stock as many as you can afford
	var cost := int(PROPS[kind]["cost"])
	if money >= cost:
		if not confirm_spend("prop%d" % kind, cost, true):
			return
		var was := available(kind)
		money -= cost
		prop_count[kind] += 1
		shop_buy_ms = int(Time.get_ticks_msec())
		save_progress()
		play_sfx("money", -6.0)
		if not was and available(kind):
			offer_prop_tutorial(kind)   # first time you can juggle these: explain them


func try_top_up(kind: int) -> void:
	# BUY THE SET (2026-07-27). To juggle N of a prop you must own N of them, and eggs
	# break for good, so the shop's real job is usually "get me back to a full set" -
	# which used to be one Enter press per object, up to fifteen of them, and again
	# after every egg. This buys the whole shortfall in one press, or a spare set on top
	# when the set is already fielded, and it stops the moment the purse cannot take the
	# next one rather than half-failing with a warning.
	var cost := int(PROPS[kind]["cost"])
	var want := maxi(num_balls - prop_count[kind], MIN_BALLS if prop_count[kind] == 0 else 0)
	if want <= 0:
		want = num_balls   # already fielded: top up a spare set for the drops to come
	var can := clampi(int(floor(float(money) / float(maxi(cost, 1)))), 0, want)
	if can <= 0:
		shop_msg = "not enough %s for even one" % coin_word()
		shop_msg_ms = int(Time.get_ticks_msec())
		shop_msg_warn = true
		play_sfx("whiff", -10.0)
		return
	# one confirmation for the whole basket, not one per item
	if not confirm_spend("set%d" % kind, cost * can, true):
		return
	var was := available(kind)
	money -= cost * can
	prop_count[kind] += can
	shop_buy_ms = int(Time.get_ticks_msec())
	save_progress()
	play_sfx("money", -4.0)
	shop_msg = "%d %s  -  %s %s" % [can, String(PROPS[kind]["name"]).to_lower(), commafy(cost * can), coin_word()]
	if can < want:
		shop_msg += "  (all the purse would take)"
	shop_msg_ms = int(Time.get_ticks_msec())
	shop_msg_warn = false
	if not was and available(kind):
		offer_prop_tutorial(kind)


func offer_prop_tutorial(kind: int) -> void:
	# the first time a new prop becomes juggle-able, queue its hands-on lesson. It is
	# routed through the same queue every other unlock uses, so the hub's LEARN row
	# offers it (rather than yanking the player out of the shop mid-purchase).
	queue_lesson("prop_%d" % kind)


# =============================================================================
# Interactive tutorials. Unlike a cutscene, a lesson runs on the REAL sim: the
# player throws and catches actual balls, guided one step at a time, and each
# step advances only once its goal is met. Fired when something unlocks: a fresh
# save teaches the 1-ball basics (then 2, then 3), and buying a new prop teaches
# that prop. There is no menu entry; lessons arrive when they are relevant.
# =============================================================================

#endregion

#region TUTORIAL SYSTEM
func tut_paced(base: Dictionary, needs: Array, after: String) -> Array:
	# THE ladder every lesson runs (see TUT_PHASES): one drill, three times over, at
	# half speed, then quarter speed, then full speed. The first two passes are
	# GUIDED - the world freezes at each action and the asked-for press always lands -
	# and only the last one is played unaided. `needs` is the goal count per pass
	# (the slow ones are short: they are a rehearsal, not a grind), and `after` is
	# what Enter promises once the whole ladder is behind the player.
	#
	# `juggle` (only-counts-if-something-else-is-airborne) and any other strictness is
	# stripped from the guided passes on purpose: those passes deal the beats
	# themselves, so failing one is not a thing a player did, and the drill would
	# scold them for the script's own rhythm.
	var out: Array = []
	var last := TUT_PHASES.size() - 1
	for i in TUT_PHASES.size():
		var st: Dictionary = base.duplicate(true)
		st["slow"] = TUT_PHASES[i]
		st["phase"] = i
		st["guide"] = i < last
		if i < needs.size():
			st["need"] = int(needs[i])
		if i < last:
			st.erase("juggle")
			st["next"] = "the same, at quarter speed" if i == 0 else "the same, at FULL speed"
		else:
			st["next"] = after
		out.append(st)
	return out


func tut_pace_line(step: Dictionary) -> String:
	# the one line that says where on the ladder this step sits, in the words the
	# player experiences rather than a phase number
	var sl := float(step.get("slow", 0.0))
	if not bool(step.get("guide", false)):
		return "FULL SPEED  -  on your own now" if sl <= 0.001 else "%d%% slow" % int(round(sl * 100.0))
	return "%d%% slow  -  guided, one press at a time" % int(round(sl * 100.0))


func tut_lesson(id: String) -> Array:
	if id.begins_with("prop_"):
		var k := int(id.substr(5))
		var quirks := {
			PROP_EGGS: "They throw like balls, but a drop breaks for good, so keep your hands soft.",
			PROP_RINGS: "Heavier than balls, so they hang a touch longer. Catch them by the rim.",
			PROP_CLUBS: "These tumble in the air. Catch the handle, not the spin, so read the rotation.",
			PROP_KNIVES: "Fast and sharp, with less room for error. Endurance keeps your hands honest.",
			PROP_TORCHES: "The heaviest, lit and roaring. They ask for real Strength and a steady nerve.",
			PROP_CHAINSAW: "It never stops running. Catch it by the handle, high, and never reach for the bar - the chain is moving whether you are ready or not.",
		}
		var quirk := String(quirks.get(k, "A new prop. Feel out its weight and timing."))
		var need := 6 if k >= PROP_TORCHES else 5
		var pout: Array = [tut_intro("%s" % String(PROPS[k]["name"]).to_upper(),
			"%s\n\n%s swaps which object you juggle, any time you are practising. The pattern and the keys do not change - only what is in the air." % [quirk, String(k_object()[0])],
			String(k_object()[0]))]
		pout += tut_paced({"prop": k, "balls": 3, "hand": RIGHT, "goal": "catch", "need": need,
			"text": "New prop: %s" % String(PROPS[k]["name"]), "sub": quirk},
			[4, 4, need], "finish the lesson")
		return pout
	if id.begins_with("trick_"):
		return trick_lesson_steps(trick_by_id(id.substr(6)))
	if id.begins_with("count_"):
		return count_lesson_steps(int(id.substr(6)))
	if id.begins_with("pattern_"):
		return pattern_lesson_steps(pattern_by_id(id.substr(8)))
	if id == TUT_ADVANCED:
		return advanced_lesson_steps()
	# THE BASICS. Three drills - one ball, then two, then three - and each of them run
	# down the whole TUT_PHASES ladder before the next one starts: half speed guided,
	# quarter speed guided, full speed alone. So a player meets one ball nine beats
	# hand-held, plays it themselves, and only then is a second ball added; by the
	# cascade they have already been walked through the exact throw-then-catch
	# exchange twice at a speed where it cannot go wrong.
	#
	# The old shape (two scripted call-and-response steps, then freestyle on an
	# adaptive pace ladder) is gone: the response was scripted for exactly two presses
	# and everything after it was sink-or-swim.
	#
	# Only the LAST pass of the three-ball drill gates on REAL juggling (the "juggle"
	# key): catches that leave the air empty behind them do not count, so nobody walks
	# out of the basics having only ever thrown one ball at a time. Key names come from
	# the live bindings, so a remapped player is taught THEIR keys, and every step still
	# names them (Louis: never assumed remembered).
	var kj := OS.get_keycode_string(K_RT)
	var kf := OS.get_keycode_string(K_LT)
	var kd := OS.get_keycode_string(K_LC)
	var kk := OS.get_keycode_string(K_RC)
	var out: Array = []
	# THE WARM-UPS run on the ADVANCED mechanic (hands empty, catch then throw) and are
	# never called that, because with one or two props the choice does not exist yet:
	# there is nothing to hold back, so keeping the air alive is the only thing to do.
	# What it buys is that every beat after the opening throw is a real two-key pair -
	# catch it, send it back - instead of a string of lone presses (Louis: no single
	# button pause screens past the opening). The word BEGINNER is saved for three
	# props, where holding two back is a genuine decision, and ADVANCED for its own
	# lesson right after.
	out += tut_paced({"prop": PROP_BALLS, "balls": 1, "hand": RIGHT, "goal": "catch", "need": 4,
		"style": TUT_ADVANCED,
		"text": "One ball, hand to hand",
		"sub": "Every hand has its own two keys: %s and %s throw, %s and %s catch. Catch the ball, then send it straight back the other way." % [kf, kj, kd, kk]},
		[4, 4, 6], "add a second ball")
	# BOTH balls start stacked in one hand, so throw, throw, catch, catch is the only
	# sequence physically available - the player is always juggling by construction,
	# never scolded into it (Louis). The throws CROSS (a forced cascade), rehearsing
	# the weave three will ask for.
	out += tut_paced({"prop": PROP_BALLS, "balls": 2, "hand": RIGHT, "goal": "catch", "need": 4,
		"pattern": CASCADE, "style": TUT_ADVANCED,
		"text": "Two balls - throw, throw, catch, catch",
		"sub": "Both start stacked in one hand. %s throws the first, %s throws the second BEFORE it lands - then keep them going: catch one, send it straight back. That handover, one ball crossing right after the other, is the whole weave three balls will ask for." % [kj, kj]},
		[4, 4, 6], "add the third ball")
	out += tut_paced({"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "catch", "need": 10,
		"juggle": true, "style": TUT_BEGINNER,
		"text": "Three balls - the BEGINNER cascade",
		"sub": "Two stay in your hands, one is in the air. As it comes down, throw the ball waiting in that hand up under it FIRST, then catch: %s then %s, or %s then %s. Throw, catch, throw, catch - that exchange, over and over, is juggling." % [kj, kk, kf, kd]},
		[6, 6, 10], "learn the other keys")
	# --- R, drilled rather than described: it is the key that rescues every tangle.
	#     Named through k_restart, so a pad player is taught THEIR button ---
	out.append({"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "press_r", "need": 1,
		"slow": 0.4, "next": "see every key at once",
		"text": "Tangled? %s starts you over" % String(k_restart()[0]),
		"sub": "Press %s now and watch the balls come back to your hands. In any practice it re-deals - on stage it does nothing, because a performance is not restartable." % String(k_restart()[0])})
	# --- and the whole command set, named, in one place ---
	out.append({"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "read", "need": 0,
		"slow": 0.4, "next": "finish the lesson",
		"text": "Every key you have",
		"sub": "These work whenever you are juggling - practice or performance. You never need to memorise them: the row along the bottom of the screen always names the ones that matter."})
	return out


func advanced_lesson_steps() -> Array:
	# THE OTHER WAY TO HOLD A PATTERN (see TUT_BEGINNER). Everything about this lesson is
	# the same drill the basics ended on - three balls, the same cascade, the same two
	# keys per hand - and exactly one thing differs: the hands stay EMPTY, so every beat
	# runs catch-then-throw instead of throw-then-catch. Teaching it as its own lesson,
	# right after the basics, is what makes the difference visible: the player already
	# has the beginner rhythm in their hands and feels this one land as its mirror image.
	var kj := OS.get_keycode_string(K_RT)
	var kf := OS.get_keycode_string(K_LT)
	var kd := OS.get_keycode_string(K_LC)
	var kk := OS.get_keycode_string(K_RC)
	var out: Array = [tut_intro("TWO WAYS TO JUGGLE",
		"You already know the BEGINNER cascade: two props rest in your hands, one is in the air, and as it falls you throw first and catch second.\n\nThe ADVANCED cascade is the mirror of it. Every prop goes up at the start and your hands stay EMPTY, so each beat is catch first, throw second - the same two keys, the opposite order.\n\nIt is harder to start and smoother to hold, and the big counts are impossible without it.",
		kk)]
	out += tut_paced({"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "catch", "need": 10,
		"juggle": true, "style": TUT_ADVANCED, "pattern": CASCADE,
		"text": "The ADVANCED cascade - empty hands",
		"sub": "Put ALL THREE up first, spaced how you judge it, then keep your hands empty: every ball you catch goes straight back up. %s then %s, or %s then %s - the same keys as the beginner cascade, in the opposite order. It is harder to start and smoother to hold, and it is what the high counts need." % [kk, kj, kd, kf]},
		[6, 6, 10], "finish the lesson")
	return out


const TRICK_TUT_SLOW := 0.55   # flat, generous slow motion for every trick-lesson step
								# (2026-07-18, Louis: "too cumbersome... don't break it
								# down into hundreds of small steps, that's only for the
								# first tutorial") - a trick lesson teaches ONE new button,
								# not the input system itself, so there is nothing to build
								# UP to across steps and no reason to ramp the world back
								# toward real speed the way the basics lesson does.

func trick_lesson_steps(t: int) -> Array:
	# a trick lesson mirrors the three INPUT GRAMMARS the game has, because the grammar
	# is what confuses people, not the trick: a toggle switches on and off, an arm shot
	# empowers one throw, a live trick acts on what is already in the air. Taught with
	# plain balls (the trick shaping is prop-independent).
	#
	# The SWITCH steps (on / off) are single presses of a key that is already named dead
	# centre on screen, so they stay one-off and unguided at TRICK_TUT_SLOW - freezing
	# the world to ask for a press the player is already staring at teaches nothing. It
	# is the DRILL - the trick actually being used inside a running weave - that runs the
	# full TUT_PHASES ladder, guided twice and then alone.
	if t < 0 or t >= TRICKS.size():
		return tut_paced({"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "catch", "need": 3,
			"text": "Keep the cascade going", "sub": "Land three."}, [3, 3, 3], "finish the lesson")
	var td: Dictionary = TRICKS[t]
	var nm := String(td["name"])
	var kb := String(k_trick()[0])
	var kcy := String(k_cycle()[0])
	# what SPACE actually does depends on the trick's grammar, and that is the one thing
	# worth saying before anything moves - a toggle stays on, an arm shot empowers one
	# throw, a live trick fires now. Said on the opening card, not buried in a drill.
	var grammar := "%s performs it right now, on whatever is already in the air." % kb
	if String(td["kind"]) == "toggle":
		grammar = "%s switches it ON, and switches it OFF again. While it runs, EVERY throw is reshaped." % kb
	elif String(td["kind"]) == "arm":
		grammar = "%s arms your next throw and only that one. Press, throw, catch - a fresh press every time." % kb
	var intro := tut_intro(nm.to_upper(),
		"%s\n\n%s\n\n%s swaps which trick %s carries, whenever you are juggling." % [String(td.get("desc", "")), grammar, kcy, kb],
		kb)
	match String(td["kind"]):
		"toggle":
			var out: Array = [intro,
				{"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "trick_on", "need": 1,
					"trick": t, "prompt": "trick", "slow": TRICK_TUT_SLOW,
					"next": "catch a few with it running",
					"text": "%s: switch it ON" % nm,
					"sub": "Press %s ONCE - not repeatedly. Every throw reshapes into %s until you switch it off." % [kb, nm]},
			]
			out += tut_paced({"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "catch", "need": 3,
				"prompt": "catch",
				"text": "Now catch them with %s running" % nm,
				"sub": "Watch the weave change shape. The bottom-right card reads '%s - ON' whenever it runs." % nm.to_upper()},
				[3, 3, 4], "switch it off again")
			out.append({"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "trick_off", "need": 1,
				"trick": t, "prompt": "trick", "slow": TRICK_TUT_SLOW,
				"next": "finish the lesson",
				"text": "And switch it OFF",
				"sub": "Press %s once more. One press ON, one press OFF - that is the whole toggle. %s swaps which trick %s carries." % [kb, kcy, kb]})
			return out
		"arm":
			var outa: Array = [intro]
			outa += tut_paced({"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "trick_use", "need": 1,
				"trick": t, "prompt": "trick",
				"text": "%s: arm it, then throw" % nm,
				"sub": "Press %s once, then throw. Just that ONE next throw flies over the top, and it lands the trick - so it is a fresh press every single time. The bottom-right card says READY while one is armed; %s swaps tricks." % [kb, kcy]},
				[1, 1, 2], "finish the lesson")
			return outa
		_:  # live (Spin): acts on the balls already airborne
			var out2: Array = [intro,
				{"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "catch", "need": 2,
					"prompt": "catch", "slow": TRICK_TUT_SLOW,
					"next": "call the %s" % nm.to_lower(),
					"text": "First get all three weaving",
					"sub": "%s acts on the balls already in the air, so fill the air before you call it." % nm},
			]
			out2 += tut_paced({"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "trick_use", "need": 1,
				"trick": t, "prompt": "trick",
				"text": "Now press it, and catch through the turn",
				"sub": "Press %s once - it fires the moment you press, and it is landed the moment it fires. Catches come while you spin; the bottom-right card shows its cooldown. %s swaps tricks." % [kb, kcy]},
				[1, 1, 2], "finish the lesson")
			return out2


func count_lesson_steps(n: int) -> Array:
	# a new ball count: the same load felt three times over, half speed guided, quarter
	# guided, then full speed alone. Whatever pattern is already running keeps running;
	# Cascade itself reads either way (crossing odd, same-hand even), so a count change
	# never strands it.
	var out: Array = [tut_intro("%d PROPS" % n,
		"Your Strength carries another one.\n\n%s and %s step the count down and up whenever you are practising, so you can always drop back to a load you can hold.\n\nMore props climb higher and move faster. Throw a touch higher than feels right." % [String(k_count()[0]), String(k_count()[1])],
		String(k_count()[1]))]
	out += tut_paced({"prop": PROP_BALLS, "balls": n, "hand": RIGHT, "goal": "catch", "need": 6,
		"prompt": "catch",
		"text": "%d balls now" % n,
		"sub": "Your Strength carries another. It climbs higher and moves faster than before - throw a touch higher than feels right."},
		[5, 5, 10], "finish the lesson")
	return out


func pattern_lesson_steps(p: int) -> Array:
	# a new pattern: forced via the "pattern" step key, run down the whole pace ladder
	# with the PATTERNS table's own desc as the teaching text (one source of truth).
	if p < 0 or p >= PATTERNS.size():
		return tut_paced({"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "catch", "need": 3,
			"text": "Keep the cascade going", "sub": "Land three."}, [3, 3, 3], "finish the lesson")
	var pd: Dictionary = PATTERNS[p]
	var nm := String(pd["name"])
	var desc := String(pd.get("desc", "Feel out its shape."))
	var n := 3   # every pattern lesson reads at 3 (Cascade's own even-count face isn't
				# taught as a separate lesson any more - it's the same skill, see PATTERNS)
	var out: Array = [tut_intro(nm.to_upper(),
		"%s\n\n%s is the PATTERN key. One press steps to the next routine you know, any time you are practising - the card at the bottom left always names the one running.\n\nA pattern is the whole shape of the juggle, not a flourish: it needs no timing of its own, it just changes where every throw goes." % [desc, String(k_pattern()[0])],
		String(k_pattern()[0]))]
	out += tut_paced({"prop": PROP_BALLS, "balls": n, "hand": RIGHT, "pattern": p,
		"goal": "catch", "need": 5, "prompt": "catch",
		"text": "New pattern: %s" % nm, "sub": desc},
		[4, 4, 8], "see the key patterns live on")
	# the last step TEACHES the key that owns patterns: one press of P visibly hands
	# the routine back to the plain weave. The lesson never touches pattern_sel, so
	# what the player chose before the lesson is exactly what they keep after it.
	out.append({"prop": PROP_BALLS, "balls": n, "hand": RIGHT, "goal": "press_p", "need": 1,
		"prompt": "pattern", "slow": 0.4, "next": "finish the lesson",
		"text": "Patterns live on the P key",
		"sub": "Press P once: the routine swaps back to the plain weave. In any practice, P chooses your pattern - the bottom-left card always names the one running."})
	return out


func begin_tutorial(id: String) -> void:
	tut_prev_prop = prop_type   # captured before tut_setup_step can overwrite it below
	tut_id = id
	tut_step = 0
	tut_active = true
	tut_hold.clear()      # no beat from a previous lesson is still waiting on a press
	tut_last_throw = LEFT
	game_state = ST_PLAY
	started = true            # a lesson is its own thing, not the opening "first run"
	_slow_cur = tut_slow()    # a lesson opens ALREADY thick, it does not ease in over the
							  # ~4s the 0.0025 ramp would take from a standing start
	# a lesson is a controlled space: nothing primed or toggled walks in from the last
	# session, so step one always starts from the state its text describes
	toggle_on = -1
	trick_primed = false
	tennis_ball = null
	spin_until = -999
	# ...and nothing LATCHED walks in either (Louis: "the tutorial is broken again -
	# space does nothing"). A performance that ended in collapse and was left through
	# the pause menu kept `collapsing` true forever - only start_run and the on-stage
	# landing of the last prop ever cleared it, and a lesson passes through neither.
	# With it stuck, _read_inputs returned immediately: Space, throws and catches all
	# dead, while the event keys (Escape) still worked. Every flag that can gate the
	# poll is cleared here, so a lesson always opens with live hands.
	collapsing = false
	results_open = false
	falling.clear()
	# the key that ACTIVATED the lesson (Space or Enter on the hub row) is still held
	# right now. Without seeding, the first play frame read that held Space as a fresh
	# edge and fired the trick BEFORE the player saw step one - the step then cleared
	# (or toggled) itself, and the player's own later press did the opposite of the
	# banner's ask. That is the "Space does not work in lessons" bug.
	seed_input_edges()
	tut_setup_step()


func tut_setup_step() -> void:
	var steps := tut_lesson(tut_id)
	var step: Dictionary = steps[clampi(tut_step, 0, steps.size() - 1)]
	mode = MODE_TRAIN
	var want_prop := int(step["prop"])
	var want_n := int(step["balls"])
	# a step's "hand" is which hand it TEACHES FROM, not a literal side: RIGHT means the
	# player's strong hand, so a left-handed player's lesson mirrors rather than starting
	# every drill in their weak hand (the dominant-hand setting reached only start_run)
	var start_hand := dominant_hand if int(step.get("hand", RIGHT)) == RIGHT else other(dominant_hand)
	# a met goal flows into the next step, but ANY change in the ball COUNT deals a
	# clean, fully-held table rather than topping up mid-air (Louis): adding a ball to a
	# hand that a live ball is already dropping into made the current one uncatchable -
	# a forced drop right at "two balls now". Same count (a trick/pattern drill) flows on.
	var fresh := balls.is_empty() or prop_type != want_prop or balls.size() != want_n
	prop_type = want_prop
	num_balls = want_n
	# a pattern lesson forces its own pattern FOR THE LESSON ONLY: pattern_sel (the
	# player's own P choice, the one that persists) is never touched here - a lesson
	# demonstrating Columns must not walk out with Columns selected (Louis). A step
	# without a "pattern" key keeps whatever is running when the juggle flows on, and
	# falls back to Cascade only on a fresh deal.
	if step.has("pattern"):
		pattern = int(step["pattern"])
	elif fresh:
		pattern = CASCADE
	# a trick lesson selects (and de-arms) its trick, so the step starts from a known
	# state: Space will act on exactly this trick. A "switch it OFF" step is the one
	# exception - it must start with the toggle RUNNING (the thing to switch off),
	# otherwise the player's one press flips it back ON and the step cannot complete
	if step.has("trick"):
		trick_sel = int(step["trick"])
		toggle_on = trick_sel if String(step["goal"]) == "trick_off" else -1
		trick_primed = false
		tennis_ball = null
	if fresh:
		balls.clear()
		_stack_l.clear()
		_stack_r.clear()
		popups.clear()
		charging = [false, false]
		applause = 0.7
		streak = 0
		caught = 0
		dropped = 0
		running = false
		stamina_max = 100.0 + 9.0 * float(endurance)
		stamina = stamina_max
		hpos = [outer_pos(LEFT), outer_pos(RIGHT)]
		hand_catch_rest = [catch_slot(LEFT), catch_slot(RIGHT)]
		hclose = [0.0, 0.0]
		catch_flash = [-999, -999]
		throw_kick = [-999, -999]
		rng.seed = 20260705
		# deal the balls; a single-ball step starts in the exact hand it is teaching, and
		# so does the two-ball step (Louis: both stacked in one hand, so throw-throw-
		# catch-catch is the only sequence available - three and up split through
		# deal_side, which puts the odd prop in the DOMINANT hand like every other deal)
		for i in num_balls:
			var b := Ball.new()
			b.state = STATE_HAND
			b.kind = prop_type
			b.color = ball_color(i) if prop_type == PROP_BALLS else prop_color(prop_type)
			b.spin_dir = 1.0 if i % 2 == 0 else -1.0
			balls.append(b)
			stack(deal_side(i) if num_balls > 2 else start_hand).append(b)
	else:
		# top up: the new step wants more balls, so they join the hands that are already
		# holding - through top_up_side, so the dominant hand still ends with the odd one
		while balls.size() < want_n:
			var b := Ball.new()
			b.state = STATE_HAND
			b.kind = prop_type
			b.color = ball_color(balls.size()) if prop_type == PROP_BALLS else prop_color(prop_type)
			b.spin_dir = 1.0 if balls.size() % 2 == 0 else -1.0
			balls.append(b)
			stack(top_up_side()).append(b)
	tut_count = 0
	tut_threw_l = false
	tut_threw_r = false
	tut_tricks = 0
	tut_keys = 0
	tut_advance_at = -1
	# the guided beat re-arms with a BREATH: nothing freezes the world until the step's
	# own title has had TUT_STEP_READ ticks on screen, so a step never opens mid-ask.
	# The feed alternation starts opposite the teaching hand, so the very first thing
	# asked for is a throw from the hand the step deals into.
	tut_hold.clear()
	tut_hold_end = tick + TUT_STEP_READ
	tut_last_throw = other(start_hand)
	if _demo:
		print("TUTTRACE setup step=%d goal=%s balls=%d slow=%.2f guide=%s juggle=%s tick=%d" % [tut_step, String(step["goal"]), num_balls, tut_slow(), str(step.get("guide", false)), str(step.get("juggle", false)), tick])
	# a step with nothing to DO (the key legend) is already met the moment it opens, so
	# its Enter prompt is live immediately rather than after some press that never comes.
	# Safe to ask now: every counter above is zeroed, so a step with a real goal cannot
	# read as done here. Must stay AFTER tut_advance_at = -1, which tut_check gates on.
	tut_check()


func tut_step_data() -> Dictionary:
	# the current lesson step, always in range - the one source every tutorial reader uses
	var steps := tut_lesson(tut_id)
	return steps[clampi(tut_step, 0, steps.size() - 1)]


# -----------------------------------------------------------------------------
# THE GUIDED BEAT (2026-07-27, Louis). On the 50% and 25% passes of any drill the
# world does not merely slow down, it STOPS at every action the drill asks for and
# will not move again until the player makes that action. What it asks for is read
# off the live sim, never scripted, so it works for one ball, for a five-ball
# fountain, for a Shower, for a trick lesson - anything the lesson engine can deal.
#
# The three questions it asks, in the order a juggler asks them:
#
#   1. Does this step's own KEY want pressing right now? (arm the trick, spin) -
#      first in the beat, because a trick has to be armed BEFORE the throw it shapes.
#   2. Is a prop about to land? A hand that still holds one is asked to THROW it and
#      then CATCH ("J then K"): that exchange, repeated, IS the cascade. An empty
#      hand is asked only to catch.
#   3. Is the air emptier than the pattern needs? Then the hand whose turn it is
#      feeds another prop up. Turns alternate, which is what makes a cascade cross.
#
# Presses out of turn are swallowed silently (never a whiff, never a wrong throw), and
# the asked-for press always succeeds - see on_catch's own `sure`, which takes the
# failure branches out of it while a beat is being guided. Failing a beat the SCRIPT
# dealt teaches nothing; the full-speed pass is where failing means something.
# -----------------------------------------------------------------------------
func tut_guided() -> bool:
	# is the step now running one of the two slow, hand-held passes?
	return tut_active and bool(tut_step_data().get("guide", false))


func tut_holding() -> bool:
	return tut_active and not tut_hold.is_empty()


func tut_style() -> String:
	# which of the two ways of holding a pattern this step is teaching (see TUT_BEGINNER)
	return String(tut_step_data().get("style", TUT_BEGINNER))


func tut_air_target() -> int:
	# how many props the beat keeps in the air at this count - the whole difference
	# between the two styles, in one number.
	#   ADVANCED puts EVERYTHING up and keeps the hands empty.
	#   BEGINNER keeps two in the hands, so the air holds the rest.
	# Two props and fewer are drills rather than patterns: one has nothing to keep up,
	# and two is Louis's "throw, throw, catch, catch", where both go up by design.
	if tut_style() == TUT_ADVANCED:
		return num_balls
	return num_balls if num_balls <= 2 else num_balls - 2


func tut_open_gap() -> int:
	# while the air is still FILLING, the opening throws are spaced by the pattern's own
	# beat (airtime over the count) rather than the tight TUT_HOLD_GAP. An advanced
	# opening puts every prop up before catching any of them, and three taps eight ticks
	# apart would bring all three down within a quarter-second of each other - a pile-up
	# the player is then asked to sort out. Spread, they arrive in the rhythm the pattern
	# actually runs at, which is the thing "throw them at a speed you judge" means.
	if balls_airborne() >= tut_air_target():
		return TUT_HOLD_GAP
	return maxi(TUT_HOLD_GAP, int(float(BASE_AIR) * count_air_scale() / float(maxi(1, num_balls))))


func tut_feed_hand() -> int:
	# whose turn it is to put another prop up: the hand that did NOT throw last, unless
	# it is empty. Returns -1 when neither hand is holding anything to throw.
	var h := other(tut_last_throw)
	if stack(h).is_empty():
		h = other(h)
	return h if not stack(h).is_empty() else -1


func tut_due_key(step: Dictionary) -> Array:
	# the one key this step exists to teach, asked for only at a moment when pressing it
	# would actually DO something - the same check that fixed the Spin prompt in
	# tut_action_cue, now asked of the paused world too, so the beat can never freeze
	# waiting on a press the trick gate would silently refuse.
	if String(step["goal"]) != "trick_use":
		return []
	var ti := int(step.get("trick", trick_sel))
	if ti < 0 or ti >= TRICKS.size() or tut_tricks >= int(step.get("need", 1)):
		return []
	var t: Dictionary = TRICKS[ti]
	var e := {"act": "trick", "hand": -1, "rank": 0, "ok": false,
		"key": String(k_trick()[0]), "what": String(t["name"]).to_upper()}
	if String(t["kind"]) == "live":
		if balls_airborne() >= int(t["min_air"]) and not spinning():
			return [e]
		return []
	if not trick_primed:
		e["what"] = "arm %s" % String(t["name"]).to_upper()
		return [e]
	return []


func tut_due_actions() -> Array:
	# everything the paused world is entitled to ask for at this instant (see the
	# region comment above). Ranks order the beat: trick, then throw, then catch.
	var step := tut_step_data()
	var out: Array = tut_due_key(step)
	# the soonest prop arriving at each hand, if it is close enough to be this beat.
	# A negative lead (the gap let it slip past) still counts - it is still catchable,
	# and far inside a lesson's W_LATE window, so the guided catch is still a Perfect.
	var soon := [9999, 9999]
	for b in balls:
		if b.state != STATE_FLIGHT:
			continue
		var d := b.land_tick - tick
		if d > TUT_EXCHANGE_LEAD:
			continue
		var h := clampi(b.to_hand, 0, 1)
		if d < soon[h]:
			soon[h] = d
	var kt := k_throw()
	var kc := k_catch()
	var adv := tut_style() == TUT_ADVANCED
	var side := func(h: int) -> String: return "left" if h == LEFT else "right"
	for h: int in [LEFT, RIGHT]:
		if soon[h] > TUT_EXCHANGE_LEAD:
			continue
		var thr := {"act": "throw", "hand": h, "ok": false, "key": String(kt[h]), "what": "throw  %s hand" % side.call(h)}
		var cat := {"act": "catch", "hand": h, "ok": false, "key": String(kc[h]), "what": "catch  %s hand" % side.call(h)}
		if adv and stack(h).is_empty():
			# ADVANCED: nothing is being held, so the prop is caught and sent straight
			# back up - catch, THEN throw. The same two keys a beginner presses, in the
			# opposite order, which is exactly what separates the two styles.
			cat["rank"] = 1
			thr["rank"] = 2
			out.append(cat)
			out.append(thr)
		else:
			# BEGINNER: the receiving hand is holding one, so it is emptied UNDER the
			# incoming prop and then receives it - throw, THEN catch. (An advanced beat
			# also lands here if a hand is unexpectedly full, e.g. just after a drop was
			# topped up: clearing it first is the right recovery either way.)
			if not stack(h).is_empty():
				thr["rank"] = 1
				out.append(thr)
			cat["rank"] = 2
			out.append(cat)
	if not out.is_empty():
		return out
	# nothing arriving and no key owed: does the pattern want another prop in the air?
	# This is the ONLY place a lesson ever asks for a single key on its own, and it
	# happens exactly n-2 times for a beginner and n times for an advanced juggler -
	# the opening, and nothing after it (Louis).
	if balls_airborne() < tut_air_target():
		var fh := tut_feed_hand()
		if fh >= 0:
			out.append({"act": "throw", "hand": fh, "rank": 1, "ok": false,
				"key": String(kt[fh]), "what": "throw  %s hand" % side.call(fh)})
	return out


func tut_hold_update() -> void:
	# open a beat if the world has something to ask for. Never while one is already
	# open, never before the step has been readable for a moment, and never once the
	# step's goal is MET - a won step goes back to being free play, however slow it is,
	# because "keep practising as long as you like" has to actually mean that.
	if not tut_hold.is_empty() or not tut_guided():
		return
	if collapsing or results_open or tut_advance_at >= 0:
		return
	if tick - tut_hold_end < TUT_HOLD_GAP:
		return
	var due := tut_due_actions()
	if due.is_empty():
		return
	# a beat with a CATCH in it is about a prop already on its way down and may never be
	# postponed - it would sail past the hand. Only a bare FEED throw (the opening, and
	# only the opening) waits out the wider pattern-beat spacing, which is what stops an
	# advanced start putting every prop up at once and raining them back down together.
	var landing := false
	for e in due:
		if String(e["act"]) == "catch":
			landing = true
			break
	if not landing and tick - tut_hold_end < tut_open_gap():
		return
	due.sort_custom(func(a, b): return int(a["rank"]) < int(b["rank"]))
	tut_hold = due
	tut_hold_at = tick
	play_sfx("ui", -20.0)


func tut_hold_rank_of(entries: Array) -> int:
	# the lowest rank still outstanding in a list of beat actions - shared by the live
	# hold and by --demo, which walks the same list without ever opening a hold
	var r := 99
	for e in entries:
		if not bool(e.get("ok", false)):
			r = mini(r, int(e["rank"]))
	return r


func tut_hold_rank() -> int:
	# the rank the beat will hear right now: a press for a LATER part of the beat is
	# not accepted early, so the lesson can never teach catch-then-throw
	var r := 99
	for e in tut_hold:
		if not bool(e.get("ok", false)):
			r = mini(r, int(e["rank"]))
	return r


func tut_hold_names(act: String, h: int) -> bool:
	# does the open beat still want this action? (h < 0 asks "any hand"). Queries only:
	# the handler does the deed and then calls tut_hold_mark to bank it.
	if not tut_holding():
		return false
	var rank := tut_hold_rank()
	for e in tut_hold:
		if bool(e.get("ok", false)) or int(e["rank"]) != rank:
			continue
		if String(e["act"]) == act and (h < 0 or int(e["hand"]) < 0 or int(e["hand"]) == h):
			return true
	return false


func tut_hold_mark(act: String, h: int) -> void:
	# the asked-for thing has actually HAPPENED. When the last of them has, the world
	# moves again and the next beat may not stop it for TUT_HOLD_GAP ticks, so the
	# throw and the catch just made are seen happening rather than teleporting.
	if not tut_holding():
		return
	for e in tut_hold:
		if bool(e.get("ok", false)):
			continue
		if String(e["act"]) == act and (int(e["hand"]) < 0 or h < 0 or int(e["hand"]) == h):
			e["ok"] = true
			break
	for e in tut_hold:
		if not bool(e.get("ok", false)):
			return
	tut_hold.clear()
	tut_hold_end = tick


func tut_hold_abort() -> void:
	# something took the beat's subject away (a drop, an R re-deal): let the world go
	# rather than sit frozen waiting on a catch that can never come
	if tut_hold.is_empty():
		return
	tut_hold.clear()
	tut_hold_end = tick


func tut_hold_autoplay() -> void:
	# --demo has no hands, so it performs the beat itself, one rank at a time: a dev
	# run still walks a guided lesson end to end (never in normal play)
	var rank := tut_hold_rank()
	for e in tut_hold:
		if bool(e.get("ok", false)) or int(e["rank"]) != rank:
			continue
		match String(e["act"]):
			"throw": on_throw_press(int(e["hand"]))
			"catch": on_catch(int(e["hand"]))
			"trick": on_trick()
		return


func tut_incoming(h: int) -> bool:
	# is any ball in flight dropping toward hand h right now? (the odd-count middle ball
	# either hand may take, so it counts for both). Used to keep a top-up off a busy hand.
	for b in balls:
		if b.state == STATE_FLIGHT and (b.to_hand == h or b == col_mid_ball):
			return true
	return false


func tut_reset_step() -> void:
	# R re-deals THIS step from a clean hold, so a tangle is never a dead end - the same
	# controlled start it began with, no forced drop, no stray state carried in (Louis)
	balls.clear()
	_stack_l.clear()
	_stack_r.clear()
	charging = [false, false]
	tut_advance_at = -1
	tut_hold_abort()   # whatever beat was frozen was about props that no longer exist
	tut_setup_step()   # balls now empty, so it deals the step fresh
	play_sfx("ui2", -13.0)


func tut_demo_reset() -> void:
	# the basics lesson's "press R" step: the press must both DO the thing (the balls
	# re-deal, so the key is seen working) and COUNT toward the goal - tut_reset_step
	# cannot be used as-is because it zeroes the step's counters, which would wipe the
	# very press being taught. So: spill the hands, let tut_maintain re-stock them,
	# and bank the press.
	balls.clear()
	_stack_l.clear()
	_stack_r.clear()
	charging = [false, false]
	tut_keys += 1
	play_sfx("ui2", -13.0)
	tut_check()


func tut_demo_pattern_off() -> void:
	# the pattern lesson's "press P" step: one press visibly hands the routine back to
	# the plain weave, so the player SEES that P is how patterns are chosen - without
	# ever touching pattern_sel (their own persistent choice)
	pattern = CASCADE
	col_air_ref = -1.0
	col_mid_ball = null
	tennis_ball = null
	tut_keys += 1
	play_sfx("ui2", -13.0)
	tut_check()


func tut_on_throw(h: int) -> void:
	if h == LEFT:
		tut_threw_l = true
	else:
		tut_threw_r = true
	tut_last_throw = h   # feed throws alternate off this, which is what crosses a cascade
	tut_hold_mark("throw", h)
	tut_check()


func tut_on_catch(juggled: bool) -> void:
	# a step marked "juggle" only accepts catches that leave a ball in the air behind
	# them (juggling_catch): the two- and three-ball steps must not be clearable by
	# throwing one ball at a time, which is the thing they exist to teach against
	# (Louis). The run has to be CONSECUTIVE - a solo catch puts the count back to zero -
	# because "there is always a ball in the air" is a property of a stretch of juggling,
	# not a tally of good moments. The banner (and the step holding open forever) is
	# the teaching; a solo catch just quietly fails to advance, no scolding popup.
	var step := tut_step_data()
	if bool(step.get("juggle", false)) and not juggled:
		if _demo:
			print("TUTTRACE solo-catch rejected at tick=%d (count was %d)" % [tick, tut_count])
		if tut_count > 0:
			play_sfx("whiff", -14.0)
		tut_count = 0
		return
	# ...and a step that TEACHES A STYLE only accepts catches made in that style
	# (2026-07-27, Louis: "when teaching the advanced cascade: make sure only that one
	# scores, not the beginner cascade"). The guided passes enforce the order by
	# construction, so this is really about the last pass, where the player is free -
	# and free to fall back into the rhythm they already know without noticing.
	#
	# The tell is not the keypress order, which is gone by the time a catch resolves:
	# it is HOW FULL THE AIR IS at the instant the prop lands. An advanced juggler has
	# just caught from a sky holding everything, so num_balls - 1 are still up; a
	# beginner threw first from a hand that was holding, so one fewer is. That single
	# comparison is the whole difference between the two styles, measured rather than
	# remembered. Two props and fewer have no styles to tell apart.
	if step.has("style") and num_balls >= 3:
		var want_adv := String(step["style"]) == TUT_ADVANCED
		var is_adv := balls_airborne() >= num_balls - 1
		if want_adv != is_adv:
			if tut_count > 0:
				play_sfx("whiff", -14.0)
			set_trick_msg("that was the BEGINNER exchange  -  catch first, then throw" if want_adv
				else "that was the ADVANCED exchange  -  throw first, then catch")
			tut_count = 0
			return
	tut_count += 1
	tut_check()


func tut_check() -> void:
	if tut_advance_at >= 0:
		return   # already cleared this step, just waiting for the throw to land
	var steps := tut_lesson(tut_id)
	var step: Dictionary = steps[clampi(tut_step, 0, steps.size() - 1)]
	var done := false
	match String(step["goal"]):
		"throw_r": done = tut_threw_r
		"throw_l": done = tut_threw_l
		"trick_on": done = toggle_on == int(step.get("trick", -1))   # the toggle is running
		"trick_off": done = toggle_on < 0                             # ...and now switched off
		"trick_use": done = tut_tricks >= int(step["need"])           # arm/live: reward_trick fired
		"press_r", "press_p": done = tut_keys >= int(step["need"])   # the key itself is the goal
		"read": done = true   # nothing to do but read it: Enter is live from the first frame
		_: done = tut_count >= int(step["need"])
	if done:
		# the goal is met, but the step HOLDS OPEN: the banner flips to "good job -
		# Enter continues, or keep trying", and only the player's Enter moves on
		# (Louis: never cut away while they are still trying it out). A "read" step is
		# met at setup, so it makes no noise about it.
		tut_advance_at = tick
		# the beat that was frozen is over too: a WON step goes back to free play, so a
		# player who wants to keep going is not stopped at every prop from here on
		tut_hold_abort()
		if String(step["goal"]) != "read":
			play_sfx("streak", -10.0)


func tut_advance() -> void:
	# Enter moves the lesson on - and only once the step's goal has been met. A
	# step never advances by itself: the player decides when they are done trying.
	if tut_advance_at < 0:
		return
	tut_step += 1
	if tut_step >= tut_lesson(tut_id).size():
		tut_finish()
	else:
		play_sfx("ui2", -11.0)
		tut_setup_step()


func tut_maintain() -> void:
	# the --demo autoplayer has no Enter: it takes each met goal after a beat, so a
	# dev run can walk a whole lesson end to end unattended (never in normal play).
	# It has no R or P either, so on a key-teaching step it mimes the press through
	# the same handler a real player's key reaches.
	if _demo and tut_advance_at >= 0 and tick - tut_advance_at >= 50:
		tut_advance()
		return
	if _demo and tut_advance_at < 0 and tick % 240 == 239:
		match String(tut_step_data().get("goal", "")):
			"press_r": tut_demo_reset()
			"press_p": tut_demo_pattern_off()
	# keep the step playable by topping the hands back up shortly after a ball is
	# lost, so a fumble never stalls a lesson (34 ticks, ~0.28s: enough of a beat
	# for the drop to actually register before the ball reappears)
	if balls.size() < num_balls and tick - last_drop_tick > 34:
		var step := tut_step_data()
		var teach_hand := int(step.get("hand", RIGHT))
		for _i in (num_balls - balls.size()):
			# only ever refill a hand with NOTHING dropping into it, so a top-up never
			# lands on the hand a live ball still needs - that was the forced drop (Louis).
			# If both hands are busy catching, wait a beat and try again next tick.
			var choices: Array[int] = []
			for hh in [LEFT, RIGHT]:
				if not tut_incoming(hh):
					choices.append(hh)
			if choices.is_empty():
				break
			var to_h := top_up_side(choices)   # the dominant hand keeps the odd prop
			if num_balls == 1 and choices.has(teach_hand):
				to_h = teach_hand   # a single-ball step returns the ball to its teaching hand
			if to_h < 0:
				break
			var b := Ball.new()
			b.state = STATE_HAND
			b.kind = prop_type
			b.color = ball_color(balls.size()) if prop_type == PROP_BALLS else prop_color(prop_type)
			b.spin_dir = 1.0
			balls.append(b)
			stack(to_h).append(b)


func tut_finish() -> void:
	if _demo:
		print("TUTTRACE finished id=%s tick=%d" % [tut_id, tick])
	var was_basics := tut_id == "balls"
	var was_prop_lesson := tut_id.begins_with("prop_")
	tut_active = false
	tut_id = ""
	mode = MODE_TRAIN
	play_sfx("coin", -6.0)   # a bright flourish on finishing a lesson
	if was_basics:
		prop_type = PROP_BALLS   # ONLY the basics lesson forces balls back; a trick or
								 # count lesson taught with the owned prop leaves it be
		# ...and the OTHER way of holding a pattern is queued right behind it, so the
		# two styles are met one after the other while the first is still in the hands
		queue_lesson(TUT_ADVANCED)
		# the FIRST lesson earns a small congrats card - the starting kit and a
		# breath - instead of a hard cut into the day hub (Louis)
		game_state = ST_TUTDONE
		cine_tick = 0
		return
	if not was_prop_lesson:
		# trick/count/pattern lessons always drill with Balls (tut_lesson's own step
		# data), whatever the player was actually equipped with - restore it now, so
		# "leaves it be" (above) is actually true. A prop_ lesson is the one exception:
		# its whole point is walking out equipped with the prop it just taught.
		prop_type = tut_prev_prop
	# THE LESSON MEAL (2026-07-27, Louis): learning something new and then being too
	# spent to go and use it is the worst possible moment to run out of day. Every
	# lesson but the basics (which already ends on its own congratulations card, with a
	# full bar behind it) hands over a hot meal on the way out - free, no gold, no time -
	# so the new trick or pattern can be taken straight to the practice hall.
	var fed := stamina < stamina_max
	if fed:
		stamina = minf(stamina_max, stamina + stamina_max * EAT_STAM)   # a FRACTION, like any meal
	enter_day()
	set_day_msg("lesson complete  -  a hot meal on the house, now go and use it" if fed
		else "lesson complete  -  your day begins")


func tut_kind_tag() -> String:
	# what KIND of thing this lesson teaches, in two or three words - the long sentences
	# that used to live here moved into the opening card, where there is room to read them
	if tut_id.begins_with("trick_"):
		return "TRICK"
	if tut_id.begins_with("pattern_"):
		return "PATTERN"
	if tut_id.begins_with("prop_"):
		return "NEW PROP"
	if tut_id.begins_with("count_"):
		return "MORE PROPS"
	if tut_id == TUT_ADVANCED:
		return "ADVANCED STYLE"
	return "THE BASICS"


func tut_kind_col() -> Color:
	if tut_id.begins_with("trick_"):
		return Color(1.0, 0.72, 0.4)
	if tut_id.begins_with("pattern_"):
		return Color(0.65, 0.85, 1.0)
	if tut_id == TUT_ADVANCED:
		return Color(0.72, 0.95, 0.72)
	return Color(0.85, 0.75, 0.6)


func tut_intro(title: String, body: String, cap: String) -> Dictionary:
	# THE OPENING CARD every lesson now starts on (2026-07-27, Louis: "start it by saying
	# press P to switch pattern / use space to do the trick"). The live banner is
	# deliberately tiny and carries no prose - which left the one sentence that says
	# WHICH KEY this lesson is even about with nowhere to be said. So it gets a card of
	# its own, before the drill, held open until Enter: the key on a big cap, what it
	# does, and what the lesson is about to ask for. Nothing is happening on stage yet,
	# so there is room, and it costs the player exactly one keypress to move past.
	return {"prop": PROP_BALLS, "balls": 3, "hand": RIGHT, "goal": "read", "need": 0,
		"slow": 0.5, "intro": true, "cap": cap, "next": "start the drill",
		"text": title, "sub": body}


func draw_tutorial_banner(font: Font, s: Vector2) -> void:
	var step := tut_step_data()
	var steps := tut_lesson(tut_id)
	if tut_holding():
		# a breath of dark over the STAGE while a beat has the world frozen: the picture
		# stays readable, but the world visibly stops, which is the whole message. Laid
		# down first, so everything the lesson draws to explain itself sits on top of it
		# at full brightness rather than being dimmed along with the scenery.
		draw_rect(Rect2(0, 0, s.x, s.y), Color(0.02, 0.01, 0.03, 0.30))
	draw_tut_prompts(font, s, step)   # a timing ring + bare handed key over the hands, no boxes
	# a SMALL rectangle at the top (2026-07-18, Louis: "not above and below, out of
	# vision, long texts of what to do - that is bad design"): the lesson kind, its
	# one-line title, and progress only. The old two-line "sub" paragraph explaining
	# WHY is gone from the live HUD entirely - what to press right now belongs dead
	# centre instead, drawn below by draw_tut_special_cue off tut_action_cue().
	# THE BANNER, rebuilt (2026-07-27, Louis: "outdated and ugly... no unneeded numbers /
	# explanations"). Two flat rectangles and three lines of text became one soft_card -
	# the same primitive every other panel in the game uses - carrying exactly three
	# things, none of them a number:
	#   a KIND tag on its own accent bar (TRICK / PATTERN / THE BASICS),
	#   the step's one-line title,
	#   and two little meters that ARE the numbers, drawn instead of written: three pace
	#   pips saying which of the 50/25/full passes is running, and a row of goal pips
	#   filling as catches land.
	# Gone: "Step 7 of 11" (a number the player can do nothing with) and "caught 4 / 6"
	# (a fraction where six dots say it faster and prettier).
	var kind_col := tut_kind_col()
	var bw := minf(560.0, s.x * 0.52)
	var bx := s.x * 0.5 - bw * 0.5
	var by := 20.0
	var bh := 74.0
	soft_card(Rect2(bx, by, bw, bh), Color(0.07, 0.05, 0.07, 0.90), Color(kind_col.r, kind_col.g, kind_col.b, 0.42), 1.5, 12.0, 16.0, 0.05)
	draw_rect(Rect2(bx + 1.0, by + 12.0, 3.0, bh - 24.0), Color(kind_col.r, kind_col.g, kind_col.b, 0.85))
	draw_string(font, Vector2(bx + 18.0, by + 22.0), tut_kind_tag(), HORIZONTAL_ALIGNMENT_LEFT, bw - 36.0, 10, Color(kind_col.r, kind_col.g, kind_col.b, 0.95))
	draw_fit_string(title_font(), Vector2(bx + 18.0, by + 46.0), String(step["text"]), HORIZONTAL_ALIGNMENT_LEFT, bw - 36.0, 19, Color(1.0, 0.92, 0.68))
	var done := tut_advance_at >= 0
	# the PACE pips, bottom left: three notches for the three passes, the live one lit and
	# wider. This is "50% slow, guided" said as a picture, and it also shows at a glance
	# that there IS a third pass coming where the hand-holding stops.
	var ph_i := int(step.get("phase", -1))
	if ph_i >= 0:
		var pxx := bx + 18.0
		for i in TUT_PHASES.size():
			var live := i == ph_i
			var pw2 := 22.0 if live else 14.0
			draw_rect(Rect2(pxx, by + bh - 18.0, pw2, 4.0),
				Color(kind_col.r, kind_col.g, kind_col.b, 0.95) if live else Color(0.62, 0.58, 0.54, 0.45 if i > ph_i else 0.8))
			pxx += pw2 + 4.0
		draw_string(font, Vector2(pxx + 6.0, by + bh - 13.0), tut_pace_line(step), HORIZONTAL_ALIGNMENT_LEFT, bw - (pxx - bx) - 24.0, 10,
			Color(0.72, 0.88, 1.0) if bool(step.get("guide", false)) else Color(1.0, 0.84, 0.5))
	# the GOAL pips, bottom right: one dot per catch the step wants, filling as they land.
	# Capped at twelve dots so a ten-catch finale reads and nothing wider ever could.
	var need_n := int(step.get("need", 0))
	if need_n > 1 and String(step["goal"]) == "catch":
		var got := mini(tut_count, need_n)
		var dots := mini(need_n, 12)
		var dx := bx + bw - 18.0 - float(dots - 1) * 11.0
		for i in dots:
			var lit := float(i) < float(got) * float(dots) / float(need_n)
			draw_circle(Vector2(dx + float(i) * 11.0, by + bh - 16.0), 3.6 if lit else 3.0,
				Color(0.75, 0.95, 0.72) if lit else Color(0.55, 0.51, 0.48, 0.55))
	elif done and String(step["goal"]) != "read":
		# a "read" step is met the instant it opens, so congratulating the player for
		# arriving on it would be congratulating them for nothing
		var ga := 0.75 + 0.25 * sin(atick() * 0.1)
		draw_string(font, Vector2(bx, by + bh - 12.0), "GOOD JOB", HORIZONTAL_ALIGNMENT_RIGHT, bw - 18.0, 12, Color(0.72, 0.95, 0.7, ga))
	if bool(step.get("intro", false)):
		draw_tut_intro_card(font, s, step, kind_col)
	# the controls that actually WORK in a lesson, always, along the very bottom - plus
	# the lesson's own key (trick / pattern) so every command the game has gets its
	# moment of attention in the lesson that owns it (Louis)
	var items: Array = []
	items.append([k_throw(), "throw"])
	items.append([k_catch(), "catch"])
	if tut_id.begins_with("trick_"):
		items.append([k_trick(), "trick"])
		items.append([k_cycle(), "switch trick"])
	elif tut_id.begins_with("pattern_"):
		items.append([k_pattern(), "pattern"])
	items.append([k_restart(), "restart"])
	items.append([k_pause(), "game menu"])
	draw_hints_row(font, s.x * 0.5, s.y - 40.0, items)
	# ONE cue slot, and exactly one thing may hold it - a screen that asks for two keys
	# at once has asked for neither. A frozen BEAT wins outright: the world is not
	# moving until it is answered, so nothing else on screen is the live question.
	# Enter comes next, because the whole point of its own callout is that it stops
	# being missable; otherwise the centred keycap (Louis: dead centre, not a sentence
	# at either edge) names whatever the live sim wants pressed right now.
	if tut_holding():
		draw_tut_hold_cue(font, s)
	elif done:
		draw_tut_enter_callout(font, s, step, tut_step >= steps.size() - 1)
	else:
		draw_tut_special_cue(font, s, tut_action_cue(step))
	# the full key legend belongs to the BASICS' closing "every key you have" step; an
	# intro step has its own card and must not have the legend printed through it
	if String(step["goal"]) == "read" and not bool(step.get("intro", false)):
		draw_tut_legend(font, s)
	# trick feedback ("HIGH TOSS ON", or the lesson's gentle no-trick-here guidance)
	# shows in lessons too - draw_hud, which normally carries it, never runs here
	if trick_msg != "" and tick - trick_msg_tick < 90:
		var ta := clampf(1.0 - float(tick - trick_msg_tick) / 90.0, 0.0, 1.0)
		draw_text_shout(font, Vector2(s.x * 0.5 - 200, s.y - 128.0), trick_msg, HORIZONTAL_ALIGNMENT_CENTER, 400, 17, Color(1.0, 0.88, 0.55, ta))


func draw_tut_intro_card(font: Font, s: Vector2, step: Dictionary, accent: Color) -> void:
	# THE OPENING CARD (see tut_intro): the one place a lesson is allowed to be wordy,
	# because nothing is moving yet and the player has not been asked to do anything.
	# A big keycap on the left says which button the whole lesson is about; the prose
	# sits beside it in its own box and is WRAPPED, never clipped. Enter starts the drill.
	var cw := minf(760.0, s.x - 120.0)
	var chh := minf(300.0, s.y * 0.42)
	var cx := s.x * 0.5 - cw * 0.5
	var cy := s.y * 0.30
	soft_card(Rect2(cx, cy, cw, chh), Color(0.07, 0.05, 0.08, 0.95), Color(accent.r, accent.g, accent.b, 0.5), 2.0, 14.0, 22.0, 0.05)
	# the key, given the size of the thing it opens up
	var cap := String(step.get("cap", ""))
	var kx := cx + 30.0
	var ky := cy + 40.0
	if cap != "":
		var kw := maxf(72.0, font.get_string_size(cap, HORIZONTAL_ALIGNMENT_LEFT, -1, 30).x + 34.0)
		var pulse := 0.5 + 0.5 * sin(atick() * 0.09)
		draw_rect(Rect2(kx, ky, kw, 52.0), Color(accent.r, accent.g, accent.b, 0.86 + 0.14 * pulse))
		draw_string(font, Vector2(kx, ky + 36.0), cap, HORIZONTAL_ALIGNMENT_CENTER, kw, 30, Color(0.10, 0.06, 0.04))
		# two calls, not one string with a newline in it: draw_string has no concept of a
		# line break and runs the halves together ("the key thisles...")
		draw_string(font, Vector2(kx, ky + 72.0), "the key this", HORIZONTAL_ALIGNMENT_CENTER, kw, 11, Color(0.76, 0.72, 0.66))
		draw_string(font, Vector2(kx, ky + 86.0), "lesson is about", HORIZONTAL_ALIGNMENT_CENTER, kw, 11, Color(0.76, 0.72, 0.66))
		kx += kw + 28.0
	draw_string(title_font(), Vector2(kx, cy + 44.0), String(step["text"]), HORIZONTAL_ALIGNMENT_LEFT, cw - (kx - cx) - 30.0, 24, Color(1.0, 0.92, 0.66))
	# the body wraps INSIDE its box and stops at the bottom of it (the standing rule):
	# blank lines in the source become paragraph breaks, so this reads as prose
	var ty := cy + 68.0
	for para in String(step["sub"]).split("\n\n"):
		if String(para).strip_edges() == "":
			continue
		var used := draw_wrap_fit(font, String(para), Rect2(kx, ty, cw - (kx - cx) - 30.0, cy + chh - 24.0 - ty), 13,
			Color(0.86, 0.82, 0.75), HORIZONTAL_ALIGNMENT_LEFT)
		ty += used + 12.0
		if ty > cy + chh - 40.0:
			break


func tut_action_cue(step: Dictionary) -> Dictionary:
	# THE one button that has no hand of its own - trick, pattern, restart - so it gets
	# no home among the bare per-hand keys draw_tut_prompts already draws over every
	# throw/catch, in every lesson (2026-07-18, Louis, second pass: those were already
	# "central" enough - over the hands, bare, no box - and just wanted nudging a
	# little further off the hands, not replacing). This is the disconnect that broke
	# the Spin lesson: "press SPACE now" used to be baked straight into the step text
	# with no check against whether the press would do anything. The "live" branch
	# below asks on_trick()'s own two questions - enough in the air, not cooling down
	# - before ever naming Space, so the game can no longer promise a press it would
	# then silently refuse.
	var goal := String(step["goal"])
	if goal == "press_p":
		return {"key": String(k_pattern()[0]), "label": "pattern"}
	if goal == "press_r":
		return {"key": String(k_restart()[0]), "label": "restart"}
	if String(step.get("prompt", "")) == "trick":
		var ti: int = int(step.get("trick", trick_sel))
		if ti >= 0 and ti < TRICKS.size():
			var t: Dictionary = TRICKS[ti]
			if String(t["kind"]) == "live":
				if balls_airborne() >= int(t["min_air"]) and not spinning():
					return {"key": String(k_trick()[0]), "label": "%s  -  now" % String(t["name"]).to_upper()}
				return {}   # not ready: the per-hand keys are already naming the catch/throw that gets there
			var lbl := "switch on" if goal == "trick_on" else ("switch off" if goal == "trick_off" else "trick")
			return {"key": String(k_trick()[0]), "label": lbl}
	return {}


func draw_tut_special_cue(font: Font, s: Vector2, cue: Dictionary) -> void:
	# Space / P / R belong to neither hand, so they get the same central bottom slot
	# and bordered-keycap look as the Enter callout below (Louis, 2026-07-18: "the
	# space button should be where the enter now button is, nice and central") - the
	# two never show at once, since this only runs while the step is NOT yet done.
	if String(cue.get("key", "")) == "":
		return
	var label := String(cue.get("label", ""))
	var pulse := 0.5 + 0.5 * sin(atick() * 0.13)
	var fs := 19
	var cap := String(cue["key"])
	var lw := font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x
	var cw := font.get_string_size(cap, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x + 18.0
	var total := cw + 14.0 + lw
	var bh := float(fs) + 16.0
	var bx := s.x * 0.5 - total * 0.5
	var by := s.y - 96.0
	draw_rect(Rect2(bx - 18.0, by, total + 36.0, bh), Color(0.16, 0.10, 0.04, 0.88))
	draw_rect(Rect2(bx - 18.0, by, total + 36.0, bh), Color(1.0, 0.72, 0.4, 0.45 + 0.45 * pulse), false, 2.0)
	draw_rect(Rect2(bx, by + 6.0, cw, bh - 12.0), Color(1.0, 0.72, 0.4, 0.82 + 0.18 * pulse))
	draw_string(font, Vector2(bx, by + bh - 11.0), cap, HORIZONTAL_ALIGNMENT_CENTER, cw, fs, Color(0.12, 0.07, 0.03))
	draw_string(font, Vector2(bx + cw + 14.0, by + bh - 11.0), label, HORIZONTAL_ALIGNMENT_LEFT, -1, fs, Color(1.0, 0.93, 0.72))


func draw_tut_hold_cue(font: Font, s: Vector2) -> void:
	# THE frozen beat's own prompt, in the same central bottom slot the Enter callout and
	# the special cue use (Louis approved that position; two prompt homes would be two
	# places to look). It says three things and nothing else:
	#
	#   - the world has STOPPED and is waiting on you (a wash of dark over the stage,
	#     so a stopped sim can never be mistaken for a hung game),
	#   - the key, or the keys IN THEIR ORDER with a "then" between them - a two-key
	#     beat like "J then K" is the exchange the cascade is made of and reads as one
	#     move, not two asks,
	#   - which hand each belongs to, spelled out, since that is the half beginners
	#     get wrong.
	#
	# A key already pressed this beat goes green and quiet, so a combination shows its
	# own progress with no counter anywhere. (The dark wash over the stage is laid down
	# by draw_tutorial_banner BEFORE any of the lesson's own furniture, so it dims the
	# WORLD and not the HUD that is explaining it.)
	var fs := 22
	var pulse := 0.5 + 0.5 * sin(atick() * 0.13)
	# measure: keycap, its label, and a "then" separator before every entry but the first
	var sep := "  then  "
	var sepw := font.get_string_size(sep, HORIZONTAL_ALIGNMENT_LEFT, -1, 14).x
	var caps := PackedFloat32Array()
	var labs := PackedFloat32Array()
	var total := 0.0
	for i in tut_hold.size():
		var e: Dictionary = tut_hold[i]
		var cw := maxf(46.0, font.get_string_size(String(e["key"]), HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x + 26.0)
		var lw := font.get_string_size(String(e["what"]), HORIZONTAL_ALIGNMENT_LEFT, -1, 13).x
		caps.append(cw)
		labs.append(lw)
		total += maxf(cw, lw) + (sepw if i > 0 else 0.0)
	# the card is sized to the WIDEST thing in it, header included (Louis's standing
	# rule: no text ever leaves its container - the header was being clipped mid-word
	# by a card measured off the keycaps alone)
	var head := "PAUSED  -  the world is waiting for you"
	var bw := maxf(total + 56.0, font.get_string_size(head, HORIZONTAL_ALIGNMENT_LEFT, -1, 12).x + 44.0)
	var bh := 104.0
	var bx := s.x * 0.5 - bw * 0.5
	var by := s.y - 162.0
	soft_card(Rect2(bx, by, bw, bh), Color(0.09, 0.05, 0.10, 0.94), Color(0.72, 0.88, 1.0, 0.40 + 0.35 * pulse), 2.0, 11.0, 14.0, 0.05)
	draw_fit_string(font, Vector2(bx + 12.0, by + 24.0), head, HORIZONTAL_ALIGNMENT_CENTER, bw - 24.0, 12, Color(0.72, 0.88, 1.0, 0.9))
	var x := bx + (bw - total) * 0.5
	for i in tut_hold.size():
		var e: Dictionary = tut_hold[i]
		if i > 0:
			draw_string(font, Vector2(x - sepw, by + 64.0), sep, HORIZONTAL_ALIGNMENT_CENTER, sepw, 14, Color(0.78, 0.74, 0.70, 0.85))
		var slot := maxf(caps[i], labs[i])
		var cw2: float = caps[i]
		var cx := x + slot * 0.5 - cw2 * 0.5
		var ok := bool(e.get("ok", false))
		var col := Color(0.55, 0.90, 0.55) if ok else Color(1.0, 0.86, 0.42)
		var a := 0.45 if ok else (0.82 + 0.18 * pulse)
		draw_rect(Rect2(cx, by + 38.0, cw2, 34.0), Color(col.r, col.g, col.b, a))
		draw_string(font, Vector2(cx, by + 64.0), String(e["key"]), HORIZONTAL_ALIGNMENT_CENTER, cw2, fs, Color(0.10, 0.06, 0.03))
		draw_fit_string(font, Vector2(x, by + 92.0), String(e["what"]), HORIZONTAL_ALIGNMENT_CENTER, slot, 13,
			Color(0.62, 0.86, 0.62, 0.8) if ok else Color(1.0, 0.93, 0.75, 0.95))
		x += slot + sepw


func draw_tut_enter_callout(font: Font, s: Vector2, step: Dictionary, last: bool) -> void:
	# THE fix for the one thing every tester did (Louis): they got the juggling straight
	# away and then just kept juggling, because "Enter continues" was a small line in a
	# banner they had long stopped reading. So Enter gets a bar of its own above the key
	# row; it says what it will DO ("add a second ball") rather than that it continues;
	# and it grows and quickens for as long as it goes unanswered, so a player happily
	# lost in the juggling is eventually, gently, unmissably told there is more.
	var label := "finish the lesson" if last else String(step.get("next", "continue"))
	var urg := clampf(float(tick - tut_advance_at) / 900.0, 0.0, 1.0)
	var pulse := 0.5 + 0.5 * sin(atick() * (0.07 + 0.06 * urg))
	var fs := int(round(lerpf(17.0, 22.0, urg)))
	var cap := String(k_finish()[0])   # Enter, or A on a pad
	var lw := font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x
	var cw := font.get_string_size(cap, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x + 18.0
	var total := cw + 14.0 + lw
	var bh := float(fs) + 16.0
	var bx := s.x * 0.5 - total * 0.5
	var by := s.y - 96.0
	draw_rect(Rect2(bx - 18.0, by, total + 36.0, bh), Color(0.16, 0.10, 0.04, 0.88))
	draw_rect(Rect2(bx - 18.0, by, total + 36.0, bh), Color(1.0, 0.86, 0.42, 0.45 + 0.45 * pulse), false, 2.0)
	draw_rect(Rect2(bx, by + 6.0, cw, bh - 12.0), Color(1.0, 0.86, 0.42, 0.82 + 0.18 * pulse))
	draw_string(font, Vector2(bx, by + bh - 11.0), cap, HORIZONTAL_ALIGNMENT_CENTER, cw, fs, Color(0.12, 0.07, 0.03))
	draw_string(font, Vector2(bx + cw + 14.0, by + bh - 11.0), label, HORIZONTAL_ALIGNMENT_LEFT, -1, fs, Color(1.0, 0.93, 0.72))
	# ...and the other half of the deal, quieter, because the step never stops being
	# playable and nobody should feel hurried out of the thing they just got working
	# ...but only where there is something to keep practising: an opening card is a page
	# to read, and inviting the player to stay on it longer is inviting them nowhere
	if String(step["goal"]) != "read":
		draw_string(font, Vector2(0, by - 8.0), "or keep practising as long as you like", HORIZONTAL_ALIGNMENT_CENTER, s.x, 12, Color(0.78, 0.72, 0.64, 0.75))


func draw_tut_legend(font: Font, s: Vector2) -> void:
	# every command the game has, named, in one card (Louis: teach them all the buttons
	# they can press at all times, with clear names). Two columns, sat in the clear band
	# between the banner and the hands at 0.57, so it overlaps neither and the balls stay
	# visible underneath it. Keys come from the live bindings, so a remapped player reads
	# their own; the fixed ones are printed as they are.
	var kt := k_throw()
	var kc := k_catch()
	var rows := [
		[[String(kt[RIGHT]), String(kt[LEFT])], "throw", "right hand, left hand"],
		[[String(kc[RIGHT]), String(kc[LEFT])], "catch", "right hand, left hand"],
		[[String(k_trick()[0])], "trick", "one flourish  -  %s picks which" % String(k_cycle()[0])],
		[[String(k_pattern()[0])], "pattern", "the routine you juggle"],
		[[String(k_object()[0])], "object", "balls, rings, clubs, torches"],
		[k_count(), "how many", "props to juggle, live or fresh"],
		[[String(k_restart()[0])], "restart", "re-deal  -  practice only, never on stage"],
		[[String(k_shop()[0])], "the shop", "buy props and gear"],
		[[String(k_sheet()[0])], "your skills", "the sheet  -  spend your points"],
		[[String(k_pause()[0])], "the game menu", "resume, back to the day, quit"],
		[[String(k_finish()[0])], "finish", "take a bow on stage, or leave practice"],
	]
	var nrows := int(ceil(float(rows.size()) * 0.5))
	var cw := minf(920.0, s.x - 80.0)
	var cx := s.x * 0.5 - cw * 0.5
	var cy := 158.0
	var rowh := 26.0
	var ch := 34.0 + float(nrows) * rowh
	draw_rect(Rect2(cx, cy, cw, ch), Color(0.05, 0.03, 0.05, 0.9))
	draw_rect(Rect2(cx, cy, cw, ch), Color(0.82, 0.62, 0.34, 0.5), false, 2.0)
	var colw := cw * 0.5
	for i in rows.size():
		var row: Array = rows[i]
		var x := cx + 20.0 + float(i / nrows) * colw
		var y := cy + 26.0 + float(i % nrows) * rowh
		var kx := x
		for k in row[0]:
			kx += draw_keycap(font, kx, y - 14.0, String(k)) + 3.0
		draw_string(font, Vector2(x + 62.0, y), String(row[1]), HORIZONTAL_ALIGNMENT_LEFT, -1, 13, Color(1.0, 0.88, 0.58))
		draw_string(font, Vector2(x + 168.0, y), String(row[2]), HORIZONTAL_ALIGNMENT_LEFT, -1, 11, Color(0.82, 0.76, 0.68, 0.9))


func draw_timing_ring(at: Vector2, d: int) -> void:
	# LESSON ONLY: turn the invisible catch window into a visible target. A ring around
	# the receiving hand tightens as the ball approaches (d = ticks until it lands) and
	# flashes gold across the Perfect window, so a beginner can SEE why a catch is early
	# or on time. Never drawn in a real set - it would defeat the timing skill.
	var pw := perfect_window()
	var r := lerpf(14.0, 48.0, clampf(float(d) / float(PROMPT_LEAD), 0.0, 1.0))
	var perfect := absi(d) <= pw
	var col := Color(1.0, 0.85, 0.35, 0.95) if perfect else Color(0.7, 0.8, 0.95, 0.55)
	var width := 3.5 if perfect else 2.0
	draw_arc(at, r, 0.0, TAU, 40, col, width, true)
	if perfect:
		draw_arc(at, r + 4.0, 0.0, TAU, 40, Color(1.0, 0.9, 0.5, 0.4), 2.0, true)


func draw_tut_key(font: Font, at: Vector2, key: String, col: Color, urgency: float) -> void:
	# a single BARE key letter floating over a hand - outlined, no box - so the handed
	# press (which hand, which key) is guided at the point of action without a text
	# rectangle in the middle of the stage (Louis: keep the centre clear).
	var u := clampf(urgency, 0.0, 1.0)
	var sc := lerpf(1.0, 1.4, u)
	if u > 0.6:
		sc *= 1.0 + 0.06 * sin(atick() * 0.18) * (u - 0.6) / 0.4
	var fs := int(round(19.0 * sc))
	var a := lerpf(0.78, 1.0, u)   # never faint: a calm key must still read at a glance
	draw_text_shout(font, at - Vector2(80.0, 0.0), key, HORIZONTAL_ALIGNMENT_CENTER, 160.0, fs, Color(col.r, col.g, col.b, a))


func draw_tut_prompts(font: Font, s: Vector2, step: Dictionary) -> void:
	# THE lesson affordance (Louis): which key, over which hand, at the moment to press it
	# - but as a bare letter and a timing ring, never a boxed bubble. A met goal no
	# longer silences these: the step holds open for more practice, so the guidance
	# keeps working until the player's Enter moves on.
	var kc := k_catch()
	var kt := k_throw()
	# THROW WINS, full stop (Louis, now three times - most recently: "it should keep
	# telling me to throw the ball until the hand is completely empty, only THEN
	# should it say to catch"). A hand still holding a ball NEVER shows a catch ring,
	# however soon something else is landing there - it keeps asking for its throw key
	# until the stack is empty. Without this, throwing two balls quickly from one hand
	# could leave the OTHER hand's still-unthrown ball hidden: that hand happened to
	# also be where one of the two just-thrown balls was headed, so its incoming-catch
	# ring silently won the same slot the throw key needed.
	var holding := [not stack(LEFT).is_empty(), not stack(RIGHT).is_empty()]
	# catch: a timing ring on the receiving hand, its bare catch key just above it -
	# but only once that hand is empty. The lead runs LONGER than the in-game glow
	# (Louis: shown early enough), so a beginner reads the key well before the ball
	# asks for it.
	var lead := PROMPT_LEAD * 3 / 2
	# when two balls are both bound for the same hand, only the SOONEST one gets a
	# ring - one ring per hand, never a stack of them (Louis)
	var soonest := [lead + 1, lead + 1]
	for b in balls:
		if b.state != STATE_FLIGHT:
			continue
		var d := b.land_tick - tick
		if d <= 0 or d > lead:
			continue
		var h := clampi(b.to_hand, 0, 1)
		if holding[h]:
			continue
		if d < soonest[h]:
			soonest[h] = d
	# while a beat has the world frozen, ONLY the hands that beat names get a prompt: a
	# calmer key over the other hand is a second ask, and the whole point of the pause
	# is that there is exactly one thing to do
	var beat := tut_holding()
	for h: int in [LEFT, RIGHT]:
		if soonest[h] > lead:
			continue
		if beat and not tut_hold_names("catch", h):
			continue
		var hp: Vector2 = hpos[h]
		draw_timing_ring(hp, soonest[h])
		var urg := 1.0 - float(soonest[h]) / float(lead)
		draw_tut_key(font, hp + Vector2(0.0, -60.0), String(kc[h]), Color(0.7, 0.88, 1.0), urg)
	# throw: the bare throw key over EVERY hand still holding a ball, all lesson long
	# (Louis: the keys are shown every single time, never assumed learned). It
	# brightens when the step's whole point is that throw, stays calm otherwise.
	var goal := String(step["goal"])
	for hh: int in [LEFT, RIGHT]:
		if not holding[hh]:
			continue
		if beat and not tut_hold_names("throw", hh):
			continue
		# a GUIDED step is a call-and-response with one ball on the table, so the hand
		# holding it IS the ask: its key burns as brightly as any named goal would. The
		# step's goal there is the catch at the far end, and reading only that left the
		# throw the whole beat depends on looking optional. A TRICK step (2026-07-18
		# fix) gets the same treatment: "arm it, then throw" landed the trick on a
		# barely-dimmed key next to the ongoing cascade's own bright catch prompts, so
		# the follow-up throw read as optional there too.
		var wants: bool = (goal == "throw_r" and hh == RIGHT) or (goal == "throw_l" and hh == LEFT) \
			or bool(step.get("guide", false)) or String(step.get("prompt", "")) == "trick"
		draw_tut_key(font, hpos[hh] + Vector2(0.0, -60.0), String(kt[hh]), Color(1.0, 0.82, 0.5), 0.85 if wants else 0.4)


#endregion

#region DAY-HUB PURCHASES (PIE / GLASSES)
func try_buy_pie() -> void:
	# Uncle Dan's Pie: bought slow-motion clarity, eaten in the day hub to arm
	# the next session - lasts the WHOLE DAY, until sleep clears it (PIE_COST)
	if money < PIE_COST:
		play_sfx("whiff", -10.0)
		return
	if not confirm_spend("pie", PIE_COST, false):
		return
	money -= PIE_COST
	pie_count += 1
	shop_buy_ms = int(Time.get_ticks_msec())
	# a receipt, because the rest drawer has no price plate to confirm against
	shop_msg = "one slice in the pantry  -  %d now" % pie_count
	shop_msg_warn = false
	shop_msg_ms = int(Time.get_ticks_msec())
	save_progress()
	play_sfx("money", -6.0)




func try_buy_drinks() -> void:
	# a bulk buy only (Louis: "bought for discount in large quantities") - ONE
	# drink at a time never made sense for a stock meant to last whole
	# performances. ENERGY_DRINK_BATCH_COST undercuts what ENERGY_DRINK_BATCH
	# drinks would cost bought one at a time, the real discount asked for.
	if money < ENERGY_DRINK_BATCH_COST:
		return
	if not confirm_spend("drinks", ENERGY_DRINK_BATCH_COST, true):
		return
	money -= ENERGY_DRINK_BATCH_COST
	energy_drinks += ENERGY_DRINK_BATCH
	shop_buy_ms = int(Time.get_ticks_msec())
	# a RECEIPT, because this is now reachable from the rest drawer as well as the counter
	# and the hub has no price plate of its own to confirm against - the same green line
	# try_top_up leaves after buying a set
	shop_msg = "%d more cans - %d in reserve" % [ENERGY_DRINK_BATCH, energy_drinks]
	shop_msg_warn = false
	shop_msg_ms = int(Time.get_ticks_msec())
	save_progress()
	play_sfx("money", -6.0)


