#endregion

#region MAIN LOOP & INPUT ROUTING
func _process(delta: float) -> void:
	# ONE DRAW PER PRESENTED FRAME, and this single line is the largest performance
	# finding in the project's history (2026-07-28). Every `queue_redraw()` used to sit
	# in `_physics_process`, which runs at 120Hz - and `queue_redraw()` is not a request
	# to the renderer, it is a deferred callable pushed onto Godot's MessageQueue.
	# `Main::iteration()` flushes that queue INSIDE its physics-step loop, so the
	# callback fired, `NOTIFICATION_DRAW` was dispatched, and `_draw()` ran - **120 times
	# a second, whatever the display was actually showing.** On a 60Hz panel that is
	# every other frame thrown away; under load it was 116 of every 120.
	#
	# The probe had been printing the evidence for two sessions and it was read
	# backwards. `draws/s` (counted inside `_draw`) sat pinned at 120-127 in every run
	# while `engine fps` tracked the load exactly - 4.3 fps at fifteen torches, 94.9 with
	# nothing in the air, same window, same second. A previous pass concluded from that
	# disagreement that `engine fps` was a background-window artefact and dismissed it.
	# **When two counters disagree, the one that responds to load is the real one**: a
	# macOS throttle does not care how many props are on stage. `draws/s` was measuring
	# the physics rate wearing a renderer's name.
	#
	# So the draw is driven from here, `_process`, which Godot calls exactly once per
	# main-loop iteration - i.e. per presented frame. Nothing else had to change: `_draw`
	# reads live state, so it is as smooth at 60 draws a second as at 120, and the sim
	# still steps 120 times regardless. Do NOT put a `queue_redraw()` back into
	# `_physics_process`; if a paused screen needs to animate, it already gets a frame
	# here every frame.
	queue_redraw()
	# dev only: the --fps probe. Everything the game does is in _physics_process and
	# _draw; this runs per RENDERED frame, which is the only place real fps is visible.
	if not _fps:
		return
	# `draws/s` AND `engine fps` SHOULD NOW AGREE, and if they ever diverge again
	# something has put a `queue_redraw()` back on the physics clock - see the note on
	# the call above. That divergence is what a previous pass mistook for a macOS
	# background-window throttle: it blamed the metric that was responding correctly to
	# load and trusted the one that was silently counting physics ticks. macOS does
	# throttle an unfocused window's presentation, so `engine fps` from a backgrounded
	# run is still a soft number - but it is not a fabricated one, and a drop that
	# scales with the number of props on stage is real work, not a windowing artefact.
	var fps := Engine.get_frames_per_second()
	_fps_frames += 1
	_fps_sum += fps
	if _fps_frames > 20:
		_fps_min = minf(_fps_min, fps)   # ignore the first frames: shader/font warm-up
	_fps_t += delta
	if _fps_t >= 1.0:
		_perf_line = "draws/s %d   draw %.1fms   calls %d   prims %s   props %d   flowers %d" % [
			_draw_n, float(_draw_us) / float(maxi(_draw_n, 1)) / 1000.0,
			int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)),
			commafy(int(Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME))),
			balls.size(), thrown.size()]
		print("PHYS %.0fus/tick (%d ticks) | DRAW %.0fus/frame | draws/s=%d | engine fps=%.1f | calls=%d prims=%d | balls=%d parts=%d" % [
			float(_phys_us) / float(maxi(_phys_n, 1)), _phys_n,
			float(_draw_us) / float(maxi(_draw_n, 1)), _draw_n,
			_fps_sum / float(maxi(_fps_frames, 1)),
			int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)),
			int(Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME)),
			balls.size(), parts.size()])
		_draw_us = 0
		_draw_n = 0
		_phys_us = 0
		_phys_n = 0
		_fps_t = 0.0
		_fps_frames = 0
		_fps_sum = 0.0
		_fps_lines += 1


func _physics_process(delta: float) -> void:
	# every screen fades in on arrival: detected passively here (game_state is SET
	# from dozens of places - menu_input, day_input, results dismissal, and more -
	# so watching for the change in one place beats touching every call site)
	if game_state != _fade_prev_state:
		_fade_prev_state = game_state
		_state_fade_t = 0
	elif _state_fade_t < STATE_FADE_FRAMES:
		_state_fade_t += 1
	audio_update()   # pick the music theme and glide the layer volumes, every state
	# the unlock card clears itself once its dismissal fade has run out. Done here,
	# above every early return below, so it expires from whatever screen it was dealt on.
	if ucard_kind >= 0 and ucard_out_tick >= 0.0 and atick() - ucard_out_tick > UCARD_OUT:
		ucard_kind = -1
		ucard_out_tick = -1.0
		ucard_flip = -1.0
	# ...and the autoplayer presses the key for itself, BOTH times: the flip and then the
	# dismissal. It has no hands, and the card HOLDS the sim until one arrives - so an
	# unlock landing inside a --demo/--calib run would stop that run dead, with no ACT line
	# and no quit, looking exactly like a hang. (--shotat still captures either way: the
	# shot counter is above this.) Same move --demo already makes to dismiss the
	# establishing card.
	if ucard_kind >= 0 and _demo:
		if ucard_flip < 0.0 and atick() - ucard_tick >= UCARD_ARM + 40.0:
			ucard_flip = atick()
		elif ucard_flip >= 0.0 and ucard_out_tick < 0.0 \
				and atick() - ucard_flip >= UCARD_FLIP + UCARD_READ + 40.0:
			ucard_out_tick = atick()
	if _shot or _collcheck or _handlog:
		_shot_frames += 1   # advances even while paused, so we can capture the sheet
		if _shot_frames >= _shot_tick:
			_capture_and_quit()
			return
	if game_state != ST_PLAY:
		cine_tick += 1           # drives the stage card, menu, and hub motion
		if game_state == ST_DAY and day_anim != "":
			day_anim_step()          # a hub vignette is playing; its effect lands at the end
		if _demo and game_state == ST_ESTABLISH and cine_tick > 40:
			establish_key()          # dev: the autoplayer dismisses each set's card, so
									 #      --demo --booking runs a whole booking end to end
		return
	# THE UNLOCK CARD HOLDS THE ACT. It waits for a key now, so without this the crowd
	# would drain and props would fall behind a card the player is reading. cine_tick is
	# advanced by hand because the card's pop-in, its glow and its "press any key" pulse
	# are all timed on atick() - a stopped clock would freeze the card into a still
	# picture and make a waiting game look like a hung one. Same reasoning, and the same
	# shape, as the guided-beat hold further down. Above the sheet/shop/pause gate,
	# because that one returns WITHOUT advancing any clock.
	if ucard_kind >= 0:
		cine_tick += 1
		update_hands()
		return
	if sheet_open or shop_open or skills_open or tailor_open or paused or debug_panel_open:
		if sheet_open and debug_mode:
			# debug build only: holding a stat key keeps stepping it, faster the longer
			# it is held. Runs in BOTH sheet pictures now - the talent tree reads the
			# same stats through the same _adjust, so there was never a reason to
			# exclude it, and its own pips are the best place to watch a stat climb
			sheet_repeat(delta)
		return   # the sheet, shop, pause menu, and debug panel all halt the sim
	if freeze > 0:
		# hit-stop: the world holds its breath for a few ticks so a drop lands with
		# weight. Input is still read (a press during the hold acts on the held world,
		# never lost) and the hands keep easing, but tick and the sim do not advance.
		freeze -= 1
		if not _demo:
			_read_inputs()
		update_hands()
		return
	# THE GUIDED BEAT (see the tutorial region): on a 50% or 25% lesson pass the world
	# stops dead at every action the drill asks for. Same shape as the hit-stop above -
	# input is polled, the hands ease, the sim's clock does not move - but it holds for
	# as long as the player needs rather than a fixed few ticks. cine_tick keeps
	# running so the scenery, the prompt's pulse and the music breathe through it: a
	# stopped SIM must not read as a hung game.
	if tut_active:
		tut_hold_update()
		if not tut_hold.is_empty():
			cine_tick += 1
			if _demo:
				tut_hold_autoplay()
			else:
				_read_inputs()
			update_hands()
			return
	# SLOW MOTION (ideas.rtf): the sim advances by FRACTIONAL ticks while real
	# time flows on, so every catch window stretches in the player's hands. Input
	# polls every real frame so slow motion can never eat a press. Sources stack
	# (Speed stat, Uncle Dan's Pie, an Amazing! catch, ten straight Perfects) and
	# the rate floors at 0.12: near-frozen, never stopped.
	var _phys_t0 := Time.get_ticks_usec() if _fps else 0
	_frames += 1
	if not _demo:
		_read_inputs()
	_slow_cur = move_toward(_slow_cur, slow_target(), SLOW_RAMP)
	if _slow_cur > 0.001:
		_tick_acc += maxf(1.0 - _slow_cur, 0.12)
		if _tick_acc < 1.0:
			update_hands()
			return
		_tick_acc -= 1.0
	tick += 1
	if _calib and (tick >= _calib_ticks or collapsing):
		# the calibration verdict: what a strong player (the fixed-metronome autoplayer)
		# scores before the crowd walks - or in _calib_ticks if it never does - at this
		# venue / prop / count. Quitting AT the collapse captures the true reachable score,
		# since after a collapse the halted-sim autoplayer keeps zombie-feeding itself.
		var wt := goal_for(run_venue, 0)
		var reason := "COLLAPSE" if collapsing else "time"
		print("CALIB venue=%d prop=%d n=%d hold=%d end=%s tick=%d score=%s caught=%d streak=%d appl=%.2f  goal1=%s clears=%s" % [
			run_venue, prop_type, num_balls, _demo_hold, reason, tick, score_text(score), caught, best_streak, applause, score_text(wt), str(score >= wt)])
		get_tree().quit()
		return
	step_effects()   # age the egg-break shards, yolk splats, and particles
	if results_open and ovation_left <= 0:
		results_anim_sfx()   # the card's count-up ticks, stamp, and record fanfare
	if _eggdemo and tick % 42 == 0:
		var vp := get_viewport_rect().size
		spawn_egg_break(Vector2(vp.x * 0.5 + randf_range(-140, 140), vp.y * 0.42))
	if _demo:
		_demo_step()
	if running:
		update_sim()
	# THE VERDICT WAITS FOR THE LAST PROP TO LAND, not for the boards to be cleared - and
	# the difference only started mattering when a dropped prop began lying there for three
	# seconds instead of half of one (see FALLEN_LINGER). This was `falling.is_empty()`,
	# i.e. "no dropped prop is still being DRAWN", which silently became a three-second
	# stall between the collapse and the results card. `still_dropping()` asks the question
	# that was always meant: is anything still in the air.
	if collapsing and running and balls_airborne() == 0 and not still_dropping():
		collapsing = false
		running = false   # the last prop has landed: only NOW may the verdict arrive
	if _prev_running and not running and not tut_active:
		on_round_end()   # the run just ended: bank the completion XP (never mid-lesson)
	_prev_running = running
	if tut_active:
		tut_maintain()   # advance the lesson and keep the hands stocked
	update_hands()
	age_popups()
	if _fps:
		_phys_us += Time.get_ticks_usec() - _phys_t0
		_phys_n += 1
	# screen shake decays toward rest (uses cosmetic RNG so the sim stays deterministic)
	if shake > 0.2:
		position = Vector2(randf_range(-shake, shake), randf_range(-shake, shake))
		shake *= 0.82
	elif position != Vector2.ZERO:
		position = Vector2.ZERO


func _input(event: InputEvent) -> void:
	# both devices funnel into one keycode here, so every per-screen match below
	# serves keyboard and pad identically with zero duplicated navigation code.
	var kc: int = -1
	if event is InputEventKey:
		var ek := event as InputEventKey
		if not (ek.pressed and not ek.echo):
			return
		kc = ek.physical_keycode
		_pad_last = false
		# the controls screen, while listening on the KEYBOARD column, captures the
		# next keyboard key as the new binding (Esc cancels, F11 stays fullscreen)
		if game_state == ST_REMAP and remap_wait and remap_col == 0:
			remap_wait = false
			if kc != KEY_ESCAPE and kc != KEY_F11:
				bind_action(String(REMAP_ACTS[remap_sel][0]), kc)
				play_sfx("ui2", -12.0)
			return
	elif event is InputEventJoypadButton:
		# joypad events carry no echo flag, so a held table drops any duplicate
		# press a driver might deliver while the button is already down
		var jb := event as InputEventJoypadButton
		var held := bool(_joy_held.get(jb.button_index, false))
		_joy_held[jb.button_index] = jb.pressed
		if not jb.pressed or held:
			return
		# the controls screen, while listening on the GAMEPAD column, captures the
		# next RAW pad button as the new binding (Start cancels, mirrors Esc/F11
		# above) - captured here, before _pad_to_key's translation, so the exact
		# physical button gets bound rather than whatever it currently means
		if game_state == ST_REMAP and remap_wait and remap_col == 1:
			remap_wait = false
			if jb.button_index != JOY_BUTTON_START:
				bind_pad_action(String(PAD_ACTS[pad_remap_sel][0]), jb.button_index)
				play_sfx("ui2", -12.0)
			return
		_pad_last = true
		kc = _pad_to_key(jb.button_index)
		if kc == -1:
			return
	elif event is InputEventJoypadMotion:
		# BOTH STICKS steer every list exactly like the arrows (Louis: the sticks
		# move the focus of the selected option in menus). Each axis latches: a push
		# past 0.6 fires ONE step and holds until the stick eases back under 0.35,
		# so drift near centre can never scroll a menu and holding the stick does
		# not machine-gun the cursor. The live sim ignores them entirely (throw and
		# catch are buttons, and a stick brushed mid-juggle must not do anything).
		var jm := event as InputEventJoypadMotion
		if jm.axis != JOY_AXIS_LEFT_X and jm.axis != JOY_AXIS_LEFT_Y \
				and jm.axis != JOY_AXIS_RIGHT_X and jm.axis != JOY_AXIS_RIGHT_Y:
			return
		var dir := 0
		if jm.axis_value > 0.6:
			dir = 1
		elif jm.axis_value < -0.6:
			dir = -1
		elif absf(jm.axis_value) < 0.35:
			_stick_dir[jm.axis] = 0
			return
		else:
			return   # the hysteresis band: keep whatever the latch already holds
		if int(_stick_dir.get(jm.axis, 0)) == dir:
			return   # still held the same way: the step already fired
		_stick_dir[jm.axis] = dir
		if _pad_sim_live():
			return
		_pad_last = true
		if jm.axis == JOY_AXIS_LEFT_X or jm.axis == JOY_AXIS_RIGHT_X:
			kc = KEY_RIGHT if dir > 0 else KEY_LEFT
		else:
			kc = KEY_DOWN if dir > 0 else KEY_UP
	else:
		return
	if kc == KEY_F11:
		# fullscreen toggle, available from every screen, remembered across launches
		set_fullscreen = not set_fullscreen
		apply_fullscreen()
		save_settings()
		return
	if kc == KEY_F10 and OS.is_debug_build():
		# THE PERFORMANCE READOUT, on screen, in a FOCUSED window - which is the only
		# place a frame rate means anything (2026-07-28: a whole session's worth of
		# conclusions came off a backgrounded window's throttled fps). Deliberately NOT a
		# Settings row: this is a dev instrument, it must never reach a release build, and
		# Settings already has a three-view invariant that a tenth row has to honour.
		_perf_hud = not _perf_hud
		_fps = _perf_hud          # ...and it drives the same counters --fps prints
		return
	if kc == KEY_F9 and OS.is_debug_build():
		# the EXPERIMENTS panel, available from every screen exactly like F11 above -
		# a safe place to flip an alternate version of a screen on or off without
		# ever touching the code. Release exports never see this key at all.
		debug_panel_open = not debug_panel_open
		debug_panel_sel = 0
		play_sfx("ui2", -12.0)
		save_settings()
		return
	if ucard_kind >= 0:
		# ANY key works the unlock card, and the key is EATEN here - it never reaches
		# the screen underneath. That is the whole reason this sits above the per-state
		# dispatch: the card usually lands on the results card or in the day hub, where
		# the very same Enter would otherwise confirm whatever was selected behind it and
		# the player would lose a menu choice they never saw themselves make. Keys stay
		# eaten through the fade-out too, so a second press cannot land early either.
		#
		# TWO PRESSES NOW, because the card has two sides: the first TURNS IT OVER and the
		# second puts it away. Each has its own arming beat (UCARD_ARM, then UCARD_READ)
		# for the identical reason - a card is dealt one frame after the player pressed
		# something, and without a beat that one press would run the whole sequence and
		# throw the card away before it was seen.
		if ucard_flip < 0.0:
			if atick() - ucard_tick >= UCARD_ARM:
				ucard_flip = atick()
				play_sfx("ui2", -9.0)
		elif ucard_out_tick < 0.0 and atick() - ucard_flip >= UCARD_FLIP + UCARD_READ:
			ucard_out_tick = atick()
			play_sfx("ui2", -11.0)
		return
	if debug_panel_open:
		debug_panel_input(kc)
		return
	match game_state:
		ST_MENU:
			menu_input(kc)
			return
		ST_SLOTS:
			slots_input(kc)
			return
		ST_SETTINGS:
			settings_input(kc)
			return
		ST_STATS:
			if kc == KEY_ESCAPE or kc == KEY_ENTER or kc == KEY_KP_ENTER:
				game_state = ST_SETTINGS
				play_sfx("ui", -12.0)
			return
		ST_REMAP:
			remap_input(kc)
			return
		ST_GAMEOVER:
			if cine_tick > 90:   # a beat of stillness before the page can turn
				reset_new_game()   # the career is over: the slot starts fresh
				game_state = ST_MENU
				menu_sel = 0
				play_sfx("ui", -12.0)
			return
		ST_TUTDONE:
			# the congrats card reads itself out for a beat, then any key begins the day
			if cine_tick > 40 and kc in [KEY_ENTER, KEY_KP_ENTER, KEY_SPACE, KEY_ESCAPE]:
				enter_day()
				set_day_msg("your first day begins  -  the stage is yours")
				play_sfx("ui2", -11.0)
			return
		ST_DEMO_WALL:
			# the demo's own "that's everything" card - same shape as ST_TUTDONE:
			# reads itself out for a beat, then any key drops back into the day, the
			# player free to keep playing whatever venues the demo already gave them
			if cine_tick > 60 and kc in [KEY_ENTER, KEY_KP_ENTER, KEY_SPACE, KEY_ESCAPE]:
				enter_day()
				play_sfx("ui2", -11.0)
			return
		ST_PURIST_LEGEND:
			# the post-win chase's payoff card - same shape again: a beat, then any
			# key back into the day, the career playing on same as after the real win
			if cine_tick > 60 and kc in [KEY_ENTER, KEY_KP_ENTER, KEY_SPACE, KEY_ESCAPE]:
				enter_day()
				play_sfx("ui2", -11.0)
			return
		ST_ESTABLISH:
			establish_key()
			return
		ST_CREDITS:
			credits_key()
			return
		ST_DAY:
			day_input(kc)
			return
	# ST_PLAY only past here. Latch a live-play action key straight from the
	# buffered event stream, so a tap too brief for the state poll in _read_inputs
	# still registers (see _latch_tap). Skipped while the sim is halted (paused /
	# sheet / shop / results), where reads do not run (or are ignored) and a latch
	# would otherwise fire stale on resume.
	if not paused and not sheet_open and not shop_open and not results_open:
		_latch_tap(kc)
	# the in-play pause menu owns all input while it is up
	if paused:
		pause_input(kc)
		return
	# during a hands-on lesson the command keys are locked, so no stray press can break
	# it into a normal run, a panel, or a prop swap. The juggling itself - throw, catch,
	# Space - stays live (polled in _read_inputs). Only the lesson's own keys act here:
	# R re-deals the step, P completes a pattern lesson's "P is the pattern key" step,
	# and Escape pauses. (This is the ONE lesson key handler - a second, later block
	# used to shadow this and left R dead inside lessons.)
	if tut_active:
		if kc == K_CYCLE and tut_id.begins_with("trick_"):
			cycle_trick()   # C is part of a trick lesson's teaching, so it stays live
			return          # (the next Space re-pins the taught trick regardless)
		match kc:
			KEY_ENTER, KEY_KP_ENTER:
				tut_advance()   # a met goal holds open until the player says done
			KEY_R:
				if String(tut_step_data().get("goal", "")) == "press_r":
					tut_demo_reset()   # the step IS the reset key: show it, count it
				else:
					tut_reset_step()
			KEY_P:
				if String(tut_step_data().get("goal", "")) == "press_p":
					tut_demo_pattern_off()   # the step IS the pattern key: show the swap
			KEY_ESCAPE:
				open_pause()
		return
	# the end-of-performance results panel: go again with R (another booking, so
	# it costs a fresh day segment), spend/shop, or Enter/Esc back into the day.
	# It stays open behind the sheet and shop, so you can invest then continue.
	if results_open and ovation_left <= 0 and not sheet_open and not shop_open:
		match kc:
			KEY_R, KEY_SPACE:
				if not too_tired():
					# "go again" books a WHOLE fresh booking (a new establishing card and a
					# new Encore), not a bare set, so it costs a day segment like any booking
					seg_used += 1
					save_progress()
					results_open = false
					begin_performance(num_balls)
				else:
					play_sfx("whiff", -10.0)   # out of stamina: sleep first (the
											   # card's footer says so in words)
			KEY_TAB:
				sheet_open = true
			KEY_S:
				shop_open = true
			KEY_ENTER, KEY_KP_ENTER, KEY_ESCAPE:
				results_open = false
				# clearing the top stage this set rolls straight into the victory
				# screen; hitting the demo's own ceiling rolls into its wishlist card,
				# completing the Purist board into its own payoff card; otherwise the
				# card dismisses back into the day as normal
				if pending_win:
					pending_win = false
					game_state = ST_CREDITS
					cine_tick = 0
				elif pending_demo_wall:
					pending_demo_wall = false
					game_state = ST_DEMO_WALL
					cine_tick = 0
				elif pending_purist_legend:
					pending_purist_legend = false
					game_state = ST_PURIST_LEGEND
					cine_tick = 0
				else:
					enter_day()
					if daily_active:
						# enter_day() clears day_msg first - the share line has to land
						# after, or it never survives the trip back to the hub. Already
						# on the clipboard too (resolve_act), for a player who quits
						# straight from the results card instead of dismissing it here.
						set_day_msg(daily_share)
		return
	# ST_PLAY: the existing in-game handling below
	if sheet_open:
		sheet_input(kc)
		return
	if shop_open:
		shop_input(kc)
		return
	# a performance cannot be reset or rebuilt mid-set: no restart, no ball-count
	# change, no prop swap, no bailing to practice. That would make a good ending
	# trivial to fish for. You either FINISH cleanly (Enter) or drop out, and you
	# only try again from the results card afterwards. Training stays freely resettable.
	var performing := mode == MODE_PERFORM
	if kc == K_CYCLE:
		cycle_trick()   # which trick the TRICK key is loaded with (remappable, so not in the match)
		return
	match kc:
		KEY_TAB:
			sheet_open = true
		KEY_S:
			shop_open = true
		KEY_ENTER, KEY_KP_ENTER:
			if performing:
				finish_performance()   # end the set on a high note, no drop needed
			else:
				# practice over: Enter steps back into the day - and BANKS the round
				# first (Louis: practice grants XP too). The completion bonus used to
				# fire only on the running->false edge, so leaving mid-run with Enter
				# quietly ate it; a round already over has already banked, so the
				# running check keeps this from paying the same round twice.
				if running and not tut_active:
					running = false
					_prev_running = false
					on_round_end()
				enter_day()
		KEY_R:
			if not performing:
				start_run(num_balls)
		# ([ and ] used to step the count too, but they are unreachable on AZERTY
		# and other layouts (Louis: "they don't work, nor should they"). ONE key
		# per count (3-9, 0, minus) worked up to eleven, but ran out of number row
		# at fifteen (2026-07-18: the cap rose after the throw-height clamp made
		# room for more objects) - 1/2 STEP the count by one instead (2026-07-18,
		# Louis: Minus/Equal were "bad choices" - swapped for 1 and 2, free here
		# since the shop/sheet/pause handlers that also read the number row all
		# gate and return well above this match). Both target functions clamp to
		# [3, max_balls()] on their own, so stepping past either end is always a
		# safe no-op, not an error.
		KEY_1:
			if performing: set_count_live(num_balls - 1)
			else: start_run(num_balls - 1)
		KEY_2:
			if performing: set_count_live(num_balls + 1)
			else: start_run(num_balls + 1)
		KEY_O:
			# switch the object either way: live during a performance (re-skins the
			# props in play, keeps the run), or with a fresh deal in practice
			if performing:
				cycle_prop_live(1)
			else:
				cycle_prop(1)
		KEY_P:
			if performing:
				cycle_pattern_live(1)   # switch the routine live, mid-performance
			else:
				cycle_pattern()   # step the juggling pattern (re-deals the hands)
		KEY_F1:
			if debug_mode: debug_jump_venue(0)   # debug: F1..F7 jump reputation to venues 1..7
		KEY_F2:
			if debug_mode: debug_jump_venue(1)
		KEY_F3:
			if debug_mode: debug_jump_venue(2)
		KEY_F4:
			if debug_mode: debug_jump_venue(3)
		KEY_F5:
			if debug_mode: debug_jump_venue(4)
		KEY_F6:
			if debug_mode: debug_jump_venue(5)
		KEY_F7:
			if debug_mode: debug_jump_venue(6)   # The Midnight Show (also forces `won`)
		KEY_ESCAPE:
			open_pause()


func _pad_sim_live() -> bool:
	# is the juggling sim the thing the pad is talking to right now? While it is,
	# the polled play actions own their buttons (Y = trick) and the event path must
	# stay out of their way; every panel over the sim hands them back.
	return game_state == ST_PLAY and not paused and not results_open and not sheet_open and not shop_open


func _pad_to_key(btn: int) -> int:
	# translate a recognised pad button into the keycode the per-screen matches
	# already understand. -1 means the button has no meaning on this screen.
	# LOUIS'S LAYOUT, 2026-07-18 SWAP: bumpers throw (F / J), triggers catch (D / K)
	# - both polled in _read_inputs, not here - and A <-> B, X <-> Y swapped from
	# the original scheme: A = Enter (confirm / finish / take a bow), B = Escape
	# (back / the game menu), Y = Tab (the sheet), X = TRICK (remappable, see
	# PAD_TRICK), and the dpad carries the four letter commands while playing: up O
	# (object), right P (pattern), down S (shop), left R (restart). In menus the
	# dpad falls back to arrows and the STICKS move the focus, so navigation never
	# fights the play commands.
	if game_state == ST_SLOTS and btn == JOY_BUTTON_X:
		return KEY_X   # delete the highlighted save slot - X keeps this one job here,
						# where it isn't already claimed by TRICK
	if btn == PAD_TRICK:
		# while the sim is live this is the POLLED trick button (see _read_inputs)
		# and must not double-fire here; everywhere else it doubles as Space
		if _pad_sim_live():
			return -1
		return KEY_SPACE
	if btn == PAD_CYCLE:
		return K_CYCLE   # which trick TRICK is loaded with - previously had no
						  # pad button at all; now remappable alongside PAD_TRICK
	match btn:
		JOY_BUTTON_DPAD_UP:
			return KEY_O if game_state == ST_PLAY else KEY_UP
		JOY_BUTTON_DPAD_DOWN:
			return KEY_S if game_state == ST_PLAY else KEY_DOWN
		JOY_BUTTON_DPAD_LEFT:
			return KEY_R if game_state == ST_PLAY else KEY_LEFT
		JOY_BUTTON_DPAD_RIGHT:
			return KEY_P if game_state == ST_PLAY else KEY_RIGHT
		JOY_BUTTON_A:
			return KEY_ENTER    # bottom face: confirm / finish / take a bow (swapped)
		JOY_BUTTON_B:
			return KEY_ESCAPE   # right face: back / the game menu (swapped)
		JOY_BUTTON_Y:
			return KEY_TAB      # top face: the sheet / menu (swapped)
		JOY_BUTTON_START:
			# Start also pauses inside play, the one habit every pad player has
			return KEY_ESCAPE if game_state == ST_PLAY else -1
		JOY_BUTTON_BACK:
			# the load-count step keys (2026-07-18): a pad previously had NO way at
			# all to change the count. Back/R3 were the two guaranteed-universal
			# buttons left unclaimed (every bumper/trigger/face button/dpad
			# direction/L3 already means something else in Louis's layout). The
			# keyboard side moved from Minus/Equal to 1/2, but the virtual key these
			# route to is what the count handler itself matches on, so it moves too.
			return KEY_1 if game_state == ST_PLAY else -1
		JOY_BUTTON_RIGHT_STICK:
			return KEY_2 if game_state == ST_PLAY else -1
	return -1


func _notification(what: int) -> void:
	# a performance must never die to a missed alt-tab: losing window focus mid-set
	# auto-pauses instead of letting the sim keep draining stamina unattended.
	if what == NOTIFICATION_APPLICATION_FOCUS_OUT:
		if _demo or _shot:
			return   # unattended dev captures may lose focus; they must keep running
		if game_state == ST_PLAY and started and running and not paused and not sheet_open and not shop_open and not results_open:
			open_pause()


func _on_joy_connection(_device: int, connected: bool) -> void:
	# a set must never die to a dead pad battery. losing the pad mid-performance
	# auto-pauses, mirroring the focus-loss guard above, and the hints fall back
	# to the keyboard names because the pad can no longer speak.
	if connected:
		return
	_pad_last = false
	if _demo or _shot:
		return
	if game_state == ST_PLAY and started and running and not paused and not sheet_open and not shop_open and not results_open:
		open_pause()


#endregion

#region PAUSE & PERFORMANCE FLOW
func open_pause() -> void:
	paused = true
	pause_sel = 0
	play_sfx("ui", -12.0)


func debug_panel_input(kc: int) -> void:
	# EXPERIMENTS: a tiny, debug-only list (F9 opens/closes it from anywhere, live
	# over whatever screen is already open) - up/down picks one, Enter/Space flips
	# it on the spot, and the change is visible the next time that screen draws
	# (no restart, no code edit). See EXPERIMENT_DEFS for what's on it.
	var n := EXPERIMENT_DEFS.size()
	match kc:
		KEY_UP:
			debug_panel_sel = (debug_panel_sel + n - 1) % n
			play_sfx("ui", -16.0)
		KEY_DOWN:
			debug_panel_sel = (debug_panel_sel + 1) % n
			play_sfx("ui", -16.0)
		KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
			var eid := String(EXPERIMENT_DEFS[debug_panel_sel]["id"])
			experiments[eid] = not exp_on(eid)
			save_settings()
			play_sfx("ui2", -13.0)
		KEY_ESCAPE:
			# F9 also closes it, but that's caught globally above _input's state
			# dispatch (same spot F11 is), so it never reaches this match at all
			debug_panel_open = false
			play_sfx("ui2", -14.0)


func pause_input(kc: int) -> void:
	match kc:
		KEY_UP:
			pause_sel = (pause_sel + 2) % 3
			play_sfx("ui", -16.0)
		KEY_DOWN:
			pause_sel = (pause_sel + 1) % 3
			play_sfx("ui", -16.0)
		KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
			pause_activate()
		KEY_1:
			pause_sel = 0; pause_activate()
		KEY_2:
			pause_sel = 1; pause_activate()
		KEY_3:
			pause_sel = 2; pause_activate()
		KEY_ESCAPE, KEY_P:
			paused = false
			play_sfx("ui2", -14.0)


func pause_activate() -> void:
	match pause_sel:
		0:   # resume the run right where it froze
			paused = false
			play_sfx("ui2", -14.0)
		1:   # end the session and step back out into the day (clears any panels).
			# `collapsing` clears too: leaving a mid-collapse set through this menu
			# used to carry the latch into the NEXT session, where it silenced every
			# polled key (the "space does nothing in the lesson" bug, Louis)
			paused = false
			tut_active = false
			results_open = false
			sheet_open = false
			shop_open = false
			collapsing = false
			enter_day()
			play_sfx("ui", -12.0)
		2:   # leave the game
			get_tree().quit()


func finish_performance() -> void:
	# CASH IN. The finish key always ends the act gracefully - you catch what you
	# have and bow, the crowd stays happy, nothing falls - and the whole score is
	# kept (a collapse is what strips it back to the last goal). Catching every ball
	# and holding them fires this same function from on_catch, so the two cash-in
	# gestures Louis asked for are one path. Clearing running fires on_round_end from
	# the running->false edge, where resolve_act() settles the night.
	if mode != MODE_PERFORM or not running or tut_active:
		return
	play_sfx("streak", -6.0)   # a short rising flourish to close the act
	running = false


func begin_performance(n: int) -> void:
	# an act opens on an establishing shot of WHERE you are about to play, the way a
	# film cuts to the outside of the building before the scene inside. The act's one
	# optional challenge is rolled here, so the card can announce it up front.
	daily_active = false   # a real booking always supersedes a stale Daily Challenge flag
	mode = MODE_PERFORM
	establish_after = n
	establish_venue = play_venue()
	pattern_once = -1   # an act always performs the pattern the player chose with P
	booking_active = true
	goals_hit = 0
	# one challenge for the WHOLE act (Louis: never a different condition per phase),
	# rolled with the global randi (never the sim rng, so the deterministic catch
	# sequence is untouched). The Backyard stays pure: no conditions on stage one.
	encore = roll_encore(play_venue())
	game_state = ST_ESTABLISH
	cine_tick = 0


func daily_seed() -> int:
	# today's date as one int - stable for everyone playing the same calendar day,
	# regardless of time zone precision (a day is plenty granular for a daily act)
	var d := Time.get_date_dict_from_system()
	return int(d["year"]) * 10000 + int(d["month"]) * 100 + int(d["day"])


func daily_venue() -> int:
	# never above what THIS save's own Reputation has actually unlocked (same rule
	# play_venue() already enforces) - two players on the same day can still land on
	# different venues early in their careers, but never a venue either could not
	# otherwise reach
	var cap := venue_index()
	if cap <= 0:
		return 0
	return daily_seed() % (cap + 1)


func daily_encore(venue: int, seed_val: int) -> int:
	# the seeded twin of roll_encore: same pool, same exclusion rules, just a picked
	# index instead of a rolled one, so the pool and the pick can never disagree
	var pool := encore_pool(venue)
	if pool.is_empty():
		return -1
	return int(pool[seed_val % pool.size()])


func begin_daily_challenge() -> void:
	# a repeatable, comparable act (Still open: "a seeded daily/weekly challenge"):
	# venue and Encore are both seeded off today's date instead of chosen/rolled, so
	# two players on the same day face the identical stage and challenge - only their
	# own hands decide the score. Otherwise this is the real booking flow end to end
	# (same goals, pay, rep, records) - `daily_active` only changes what the results
	# card shows afterward, never how the act itself plays or scores.
	var dv := daily_venue()
	venue_pick = dv   # "tonight's stage" becomes the daily's, same as picking it by hand
	mode = MODE_PERFORM
	establish_after = num_balls
	establish_venue = dv
	pattern_once = -1
	booking_active = true
	goals_hit = 0
	daily_active = true
	encore = daily_encore(dv, daily_seed())
	game_state = ST_ESTABLISH
	cine_tick = 0


func establish_key() -> void:
	game_state = ST_PLAY
	start_run(establish_after)   # the card dismissed: walk out and begin the act


# --- act maths: the three goals, the deck's live effects, the drop limit -----

#endregion

#region ACT GOALS & ENCORES
func goal_for(venue: int, gi: int) -> float:
	# goal number gi (0 first, 1 second, 2 final), scaling off the VENUE and the
	# standing ante, never off the player's own record (scaling off your best would
	# punish you for improving). A challenge that stretches the night (The Long Set)
	# stretches only the FINAL goal - the hardest number is the one it makes harder.
	var base := float(VENUE_BASE[clampi(venue, 0, VENUE_BASE.size() - 1)])
	var step := float(GOAL_STEP[clampi(gi, 0, GOAL_STEP.size() - 1)])
	var a := minf(pow(ANTE_GROWTH, float(ante[clampi(venue, 0, ante.size() - 1)])), ANTE_CAP)
	var enc := encore_target_mult() if gi == NUM_GOALS - 1 else 1.0
	return base * step * a * enc


# THE BUILD EACH HOUSE EXPECTS, as data rather than as a sentence in a comment. VENUE_BASE was
# derived from these, and until they were written down the derivation lived only in my head and
# in prose - which is how a ladder ends up with assumptions nobody can check. `--ladder` reads
# them and prints the arithmetic.
# `skill` IS THE ONE I HAD BEEN LEAVING OUT, and Louis found it by naming a number: "backyard
# final goal = 300", where the ladder said 800. Everything above is computed for a FLAWLESS act -
# an unbroken chain, every catch a Perfect - which is what the autoplayer does and what no human
# does, least of all at their first house. A beginner drops, takes Goods, and resets the chain
# constantly; they score a fraction of the bot's rate. So each house carries the share of
# flawless a player at THAT house can really be expected to hold, and it climbs as they learn.
# 0.375 at the Backyard is his 300 exactly.
#
# **This is the assumption that was silently baked into every rung before, and writing it down
# is most of the value.** A ladder derived from a perfect player is a ladder nobody can climb.
const LADDER_BUILD := [
	{"n": 3,  "prop": 0, "pat": 0, "set": 0, "acts": 0, "skill": 0.375},  # Backyard: three balls, no tricks
	{"n": 4,  "prop": 0, "pat": 1, "set": 2, "acts": 2, "skill": 0.45},   # Street Corner
	{"n": 5,  "prop": 3, "pat": 1, "set": 4, "acts": 2, "skill": 0.55},   # Small Theatre: clubs
	{"n": 5,  "prop": 4, "pat": 2, "set": 6, "acts": 3, "skill": 0.62},   # The Circus: knives
	{"n": 7,  "prop": 5, "pat": 2, "set": 8, "acts": 4, "skill": 0.70},   # Championship: torches
	{"n": 9,  "prop": 5, "pat": 4, "set": 8, "acts": 4, "skill": 0.78},   # World Arena
	{"n": 11, "prop": 6, "pat": 5, "set": 8, "acts": 5, "skill": 0.85},   # Midnight: chainsaws, Tennis
]

func print_ladder() -> void:
	# dev (--ladder): THE WHOLE SCORE LADDER, computed from the live constants and printed in
	# one second. It exists because the autoplayer cannot measure the upper houses - at seven
	# objects in a plain Cascade a catch arrives every 19 ticks and a Spin needs 52 clear, and
	# at eleven chainsaws the bot simply drops everything - so every rung above the Small
	# Theatre was arithmetic hiding in a comment. Arithmetic in a comment rots; arithmetic in a
	# tool gets re-run.
	#
	# It models a FLAWLESS act: an unbroken chain, the build in LADDER_BUILD, and `acts` trick
	# activations landed. That is an upper bound on a real player, which is the right side to
	# calibrate from - the goal should be reachable by someone playing well, not by everyone.
	print("%-18s %-13s %-16s %5s %7s %12s %14s %5s %7s %9s" % ["VENUE", "BUILD", "PATTERN", "skill", "rate/s", "goal 1", "final", "needs", "floor", "at-build"])
	for v in VENUE_BASE.size():
		var b: Dictionary = LADDER_BUILD[v]
		var n := int(b["n"])
		var pk := int(b["prop"])
		var pat := int(b["pat"])
		var acts := int(b["acts"])
		# the catch rate: one catch per prop per cycle, and the cycle is the tap airtime
		var scale := 1.0 if n < 5 else 1.3 + 0.15 * float(n - 5)
		var air_s := BASE_AIR * scale / 120.0
		var cps := float(n) / air_s
		# the per-catch multiplier, at the chain's settled value rather than its ramp
		var setb := 1.0 + SET_PIECE_BONUS * float(b["set"])
		if int(b["set"]) >= WEAR_PIECES.size():
			setb *= SET_FULL_BONUS
		var pm := float(PATTERNS[pat]["mult"]) * (1.0 + OBJ_BALL_BONUS * float(n - MIN_BALLS)) \
			* float(PROPS[pk]["smult"]) * setb
		var settled := 1.0 + CHAIN_GAIN * 0.82     # ~x3.5, the chain past its ramp
		var rate := CATCH_PTS * settled * pm * cps * float(b.get("skill", 1.0))
		# what one trick activation is worth in THIS build
		var ctx := (1.0 + TRICK_DIFF_WEIGHT * float(int(PROPS[pk]["weight"]) - 1)) \
			* (1.0 + TRICK_DIFF_COUNT * float(n - MIN_BALLS)) * float(PATTERNS[pat]["mult"])
		var p := 1.0 + (2.0 - 1.0) * ctx           # a Spin, the strongest
		var mult := pow(p, float(acts))
		var g1 := float(VENUE_BASE[v]) * float(GOAL_STEP[0])
		var g3 := float(VENUE_BASE[v]) * float(GOAL_STEP[2])
		# seconds to the FINAL goal at this build, and the clock floor it must also clear
		var secs := g3 / maxf(rate * mult, 0.0001)
		var floor_s: float = lerpf(GOAL_MIN_S_LOW[2], GOAL_MIN_S_HIGH[2], float(v) / float(maxi(MAX_VENUE, 1)))
		# ...and how many activations it would actually take to meet that floor
		var need := 0
		while need < 40 and g3 / maxf(rate * pow(p, float(need)), 0.0001) > floor_s:
			need += 1
		print("%-18s %2dx %-9s %-16s %5.2f %7.0f %12s %14s %5d %6.0fs %8.0fs" % [
			String(venue_data(v)["name"]), n, String(PROPS[pk]["name"]), String(PATTERNS[pat]["name"]),
			float(b.get("skill", 1.0)), rate, score_text(g1), score_text(g3), need, floor_s, secs])
	print("")
	print("rate/s     points a second at that build and skill share, with NO tricks")
	print("needs      trick activations required to reach the final goal by its clock floor")
	print("at-build   seconds to the final goal with the activations LADDER_BUILD assumes")
	print("A house is calibrated when `needs` is at or just under the build's own `acts`.")


func goal_seconds(gi: int) -> float:
	# the CLOCK gate for goal gi at THIS venue, in seconds - see GOAL_MIN_S_LOW/HIGH.
	var g := clampi(gi, 0, GOAL_MIN_S_LOW.size() - 1)
	var t := clampf(float(run_venue) / float(maxi(MAX_VENUE, 1)), 0.0, 1.0)
	return lerpf(GOAL_MIN_S_LOW[g], GOAL_MIN_S_HIGH[g], t)


func goal_ticks(gi: int) -> int:
	# ...in sim ticks. Measured from the first throw, not from the establishing card, so
	# reading the venue's name is not part of the thirty seconds.
	return int(round(goal_seconds(gi) * 120.0))


func goal_clock_open(gi: int) -> bool:
	return tick >= goal_ticks(gi)


func goal_clock_left(gi: int) -> float:
	# seconds still to run on that floor, for the HUD. A goal whose NUMBER is already beaten
	# but whose clock has not opened must say so - otherwise the player watches a bar sit full
	# and concludes the game is broken, which is the one failure a hidden gate always causes.
	return maxf(0.0, float(goal_ticks(gi) - tick) / 120.0)


func next_goal() -> float:
	# the first goal the act has NOT yet reached, or the final goal once all have
	# fallen (the meter then shows a full bar, not a moving one)
	return goal_for(run_venue, clampi(goals_hit, 0, NUM_GOALS - 1))


func goal_bar_pos(v: float, final: float) -> float:
	# where a score value sits on the goal METER, 0..1. NOT linear in score: the streak
	# multiplier makes score accelerate (slow while the streak builds, fast once it is up),
	# so a linear fill crawls early then rockets late. A concave (log-like) mapping,
	# GOAL_BAR_GAMMA < 1, amplifies the low end so the bar advances more evenly over TIME
	# (Louis, 2026-07-26). Fill AND the goal notches share it, so a notch still marks its
	# real score - only the spacing is remapped.
	var x := clampf(v / maxf(1.0, final), 0.0, 1.0)
	return pow(x, GOAL_BAR_GAMMA)


func encore_pool(venue: int) -> Array[int]:
	# every Encore this venue and this save's own props currently allow - the shared
	# gate behind both a random roll (roll_encore) and a seeded pick (daily_encore),
	# so the two can never drift apart. Never on the Backyard (venue 0), the one pure
	# lesson stage - and otherwise fair game, EXCEPT "For the Danger" (only clubs/
	# knives/torches score), which needs a floor of its own (2026-07-18, Louis: it
	# rolled before he could even afford a club, so the act was unscoreable start to
	# finish). It is excluded from the pool below The Circus (venue 3) AND unless the
	# player owns ENOUGH of a qualifying prop to actually field the smallest real
	# routine - MIN_BALLS (3), not just one (Louis caught this: owning a single club
	# is not enough to switch to and juggle it at all, let alone score with it).
	var pool: Array[int] = []
	if venue < 1:
		return pool
	for i in ENCORES.size():
		if String(ENCORES[i]["id"]) == "fire" and (venue < 3 \
				or (have(PROP_CLUBS) < MIN_BALLS and have(PROP_KNIVES) < MIN_BALLS and have(PROP_TORCHES) < MIN_BALLS)):
			continue
		pool.append(i)
	return pool


func roll_encore(venue: int) -> int:
	# a random challenge for the whole act - see encore_pool for what is eligible
	var pool := encore_pool(venue)
	if pool.is_empty():
		return -1
	return int(pool[randi() % pool.size()])


func encore_on(id: String) -> bool:
	# is THIS act's challenge the named one? A challenge colours the WHOLE act - one
	# condition from the first throw to the bow (Louis). -1 means a clean night, which
	# is every Backyard night and any venue the roll spared.
	return booking_active and mode == MODE_PERFORM \
		and encore >= 0 and encore < ENCORES.size() and String(ENCORES[encore]["id"]) == id


func encore_decay_mult() -> float:
	# how fast the crowd's patience bleeds this set: The Hecklers double it, The Long
	# Set halves it (a patient crowd for a marathon target)
	if encore_on("hecklers"):
		return 2.0
	if encore_on("long"):
		return 0.5
	return 1.0


func encore_target_mult() -> float:
	return 2.0 if encore_on("long") else 1.0


func encore_score_mult() -> float:
	# For the Danger: only heavy props (clubs and up) score, so a crowd that came for
	# danger cannot be satisfied with balls. A run uses one prop, so the current prop's
	# weight decides the whole set.
	if encore_on("fire") and prop_weight() < 3:
		return 0.0
	return 1.0


func drop_limit() -> int:
	# three drops and the crowd turns. The Understudy lowers it to one.
	if encore_on("understudy"):
		return 1
	return DROP_LIMIT


# =============================================================================
# The day hub (GDD 4.5): a juggler's life between performances. A day holds
# SEG_PER_DAY action segments. Performing and practicing each spend one, eating
# and the shop are quick, sleep ends the day and restores stamina. Everything
# here is texture and pacing around the juggling, never a new difficulty axis,
# so the skill-first guardrails are untouched.
# =============================================================================

func play_venue() -> int:
	# the stage you CHOSE to play tonight, never above what reputation unlocks
	return clampi(venue_pick, 0, venue_index())


func too_tired() -> bool:
	# STAMINA is the day's limiter now (Louis: the day is spent when you have no
	# strength left, not when a counter says so). Work as long as you can stand -
	# or, with the Energy-Drink Helmet stocked, as long as the next dip has a
	# real drink behind it: spend_stamina pours one the instant it's needed, so
	# a stocked player is never actually stuck here, just reading a stale number.
	if wearing("helmet") and energy_drinks > 0:
		return false
	return stamina < TIRED_FLOOR


func check_dead_end() -> void:
	# the survival check. A meal (EAT_COST) always lifts you back over the
	# tiredness floor, so the road only truly ends when you are too tired to
	# work AND too poor for both the bed and the dinner that would save you.
	# Warned about at every purchase, but if it lands, it lands.
	if too_tired() and money < INN_COST and money < EAT_COST and game_state == ST_DAY:
		game_state = ST_GAMEOVER
		cine_tick = 0


func seg_name() -> String:
	# the day's beats (Louis): wake to DAYLIGHT, work into NIGHT and DEEP NIGHT.
	# ("daylight" not "day": next to the day NUMBER it read as a stutter, "day 1,
	# day".) The clock is flavour; only running out of STAMINA says sleep.
	if too_tired():
		return "time to sleep"
	var names := ["daylight", "night", "deep night"]
	return names[clampi(seg_used, 0, 2)]


func next_venue_rep() -> int:
	# the Reputation the NEXT stage opens at, or 0 when there is nowhere higher
	# left to climb (mirrors venue_index_of's ladder). At the World Arena this
	# names The Midnight Show's Reputation gate, though that stage also needs
	# `won` - close enough as a hint (by the time Reputation alone gets there,
	# a win is generally close behind).
	# OFF VENUE_REP, never a copy of it. This held its own literal list of the same six
	# numbers, so re-balancing the ladder (2026-07-27) left the hub promising the next
	# stage at the OLD figure while the door actually opened at the new one - caught only
	# because a screenshot happened to show a player 20 short of a gate it said was 40
	# away. rep_tier() had the identical bug. If a fourth reader of this ladder is ever
	# added, derive it here too.
	var vi := venue_index()
	return int(VENUE_REP[vi + 1]) if vi + 1 < VENUE_REP.size() else 0


#endregion

#region DAY HUB LOGIC
func enter_day() -> void:
	game_state = ST_DAY
	day_sel = 0
	day_group = ""    # a new day always opens at the top level, never mid-drawer
	day_msg = ""
	view_venue = -1
	cine_tick = 0
	pattern_once = -1   # a Skills-practice pattern was for that session only
	# came off the stage SPENT: open the REST drawer and land the cursor on the first
	# recovery you can afford (a meal, else the inn), so the player is steered straight
	# at it instead of left guessing - the drawer is opened FOR them here
	if exhausted:
		exhausted = false
		day_group = "rest"
		var rows := day_rows()
		var want := "eat" if money >= EAT_COST and stamina < stamina_max - 1.0 else "inn"
		for i in rows.size():
			if String(rows[i]["id"]) == want:
				day_sel = i
				break
		set_day_msg("your hands gave out  -  eat or sleep to get them back")
	reward_director()   # a stuck player gets a nudge, a gift, or an unlock - never a wall
	save_progress()
	check_dead_end()   # broke AND spent on arrival: the road ends here


func reward_director() -> void:
	# THE REWARD DIRECTOR (Louis): rewards are SPREAD - a new stage always pays (the
	# venue-gated arrival skills in TRICKS/PATTERNS), and when the road between
	# stages runs dry too long, help arrives instead of nothing:
	#   - a long drought with no unlock gifts the nearest walled skill outright
	#   - a broke player finds a pie at the door (at most one a day), so the next
	#     act can still be earned rather than lost to the spiral
	#   - the once-per-career meal rescue keeps empty-stamina-and-broke from being
	#     the end of the road while any of this is still being learned
	# It runs on ARRIVING at the hub, so a gift is always found standing up, never
	# shoved into a set. Practice is the promoted answer for a stuck player: it
	# costs no crowd, grants XP (same as a stage since this batch), and the pity
	# message says so in words.
	if perfs_since_unlock >= PITY_DROUGHT:
		pity_grant()
	if money < 30 and pie_count == 0 and not pie_active and day != aid_pie_day:   # 30: too
		# poor to risk a shop trip, but not yet the meal-rescue's real emergency below
		aid_pie_day = day
		pie_count += 1
		set_day_msg("a fan left a pie at your door  -  eat it before a big night")
		play_sfx("coin", -10.0)
	elif stamina <= 0.15 * stamina_max and money < EAT_COST and not aid_meal_used:   # 15%:
		# too tired to work AND too broke to eat - the actual dead end this rescues
		aid_meal_used = true
		stamina = clampf(0.6 * stamina_max, stamina, stamina_max)
		set_day_msg("a stranger paid for your meal  -  it will not happen twice")
		play_sfx("coin", -10.0)


func pity_grant() -> void:
	# six acts without a single new skill: deal a card anyway. It is the same card the
	# walls deal - face down, one skill you do not own, flat odds - so the player cannot
	# tell a pity card from an earned one, which is the point of a pity system.
	#
	# THE "NEAREST WALL" RULE IS GONE, and it had to go (2026-07-28). It used to gift the
	# locked skill with the smallest shortfall across level/Strength/Accuracy, on the
	# reasoning that the gift should be the thing the player was visibly working toward.
	# With the skills hidden there is nothing visible to work toward: the player no longer
	# knows which skill sits behind which bar, so "the one you were nearly at" is a
	# distinction they cannot perceive and cannot be pleased by. A flat roll over
	# everything left says the same thing more honestly.
	#
	# It deliberately deals BEYOND the earned entitlement, and that is what makes it a
	# gift: the next wall the player crosses will find the card already spent and pass
	# quietly. A pity grant is an advance on the next reward, not a free extra one.
	var kinds: Array[bool] = []
	if not skill_pool(true).is_empty():
		kinds.append(true)
	if not skill_pool(false).is_empty():
		kinds.append(false)
	if kinds.is_empty():
		return   # the player owns everything; there is nothing left to be short of
	var is_trick: bool = kinds[randi() % kinds.size()]
	var idx := deal_skill_card(is_trick)
	if idx < 0:
		return
	perfs_since_unlock = 0
	if is_trick:
		queue_lesson("trick_%s" % String(TRICKS[idx]["id"]))
		trick_sel = idx
		trick_primed = false
	else:
		queue_lesson("pattern_%s" % String(PATTERNS[idx]["id"]))
	deal_ucard(0 if is_trick else 1, idx)
	set_day_msg("all that stage time paid off  -  something new just clicked.")


func set_day_msg(m: String) -> void:
	day_msg = m
	day_msg_tick = cine_tick


func day_actions() -> Array[Dictionary]:
	# every hub action with its live enabled state, the reason when not, the drawer it
	# belongs in, and an icon/accent for its card. Built fresh every frame and every
	# keypress so drawing and input can never disagree about what is on screen.
	var out: Array[Dictionary] = []
	var tired := too_tired()
	var tired_why := "too tired to work (stamina under %d)  -  sleep first" % int(TIRED_FLOOR)
	out.append({"id": "perform", "grp": "work", "icon": "star", "name": "PERFORM",
		"cost": "", "ok": not tired, "why": tired_why if tired else "",
		"sub": "%s and reputation, while stamina lasts. P books it PURIST." % coin_word()})
	out.append({"id": "practice", "grp": "work", "icon": "loop", "name": "PRACTICE",
		"cost": "", "ok": not tired, "why": tired_why if tired else "",
		"sub": "no crowd, no pay. Work as long as you can stand."})
	out.append({"id": "daily", "grp": "work", "icon": "cal", "name": "DAILY CHALLENGE",
		"cost": String(venue_data(daily_venue())["name"]), "ok": not tired, "why": tired_why if tired else "",
		"sub": "today's stage and Encore, the same for every juggler playing today. Costs a segment, same as PERFORM."})
	var full := stamina >= stamina_max - 1.0
	var eat_why := ""
	if money < EAT_COST:
		eat_why = "not enough %s" % coin_word()
	elif full:
		eat_why = "not hungry yet"
	out.append({"id": "eat", "grp": "rest", "icon": "plate", "name": "EAT a hot meal",
		"cost": "%d %s" % [EAT_COST, coin_word()], "ok": money >= EAT_COST and not full, "why": eat_why,
		"sub": "stamina back. Every third meal adds a point of Strength."})
	out.append({"id": "inn", "grp": "rest", "icon": "bed", "name": "SLEEP at the inn",
		"cost": "%d %s" % [INN_COST, coin_word()], "ok": money >= INN_COST,
		"why": "not enough %s  -  the innkeeper does not haggle" % coin_word() if money < INN_COST else "",
		"sub": "ends the day, wake fully rested. Keep %d %s aside or the road ends." % [INN_COST, coin_word()]})
	# UNCLE DAN'S PIE IS SOLD WHERE IT IS EATEN (2026-07-29, Louis: "Uncle dan's pie should
	# also be only for sale in the rest menu"). It was a shop card, which put a stimulant on
	# the same row as juggling clubs; the rest drawer is where every other restorative already
	# lives and where a player is when they want one. Buying costs no day segment - it is a
	# pie, not an evening.
	out.append({"id": "buy_pie", "grp": "rest", "icon": "pie", "name": "BUY Uncle Dan's Pie",
		"cost": "%s %s" % [commafy(PIE_COST), coin_word()], "ok": money >= PIE_COST,
		"why": "not enough %s" % coin_word() if money < PIE_COST else "",
		"sub": "a stimulant slice for the pantry. You have %d. Eating one slows the whole day %d%%." % [pie_count, int(round(PIE_SLOW * 100.0))]})
	if pie_count > 0:
		out.append({"id": "pie", "grp": "rest", "icon": "pie", "name": "EAT Uncle Dan's Pie",
			"cost": "own %d" % pie_count, "ok": not pie_active, "why": "one is already working" if pie_active else "",
			# the number comes from PIE_SLOW, never a written-out fraction: this line
			# still said "a quarter slower" long after the slice was nerfed to 15%
			"sub": "a stimulant slice: the whole day runs %d%% slower, until you sleep." % int(round(PIE_SLOW * 100.0))})
	if tomatoes > 0:
		# THE CROWD'S OTHER GIFT (2026-07-27, Louis): a night that fell apart sends you
		# home pelted, and what you were pelted with is food. Free stamina with a bruise
		# on it - the worse the act, the more of them you are carrying - so the road never
		# ends purely because a performance went wrong.
		out.append({"id": "tomato", "grp": "rest", "icon": "tomato", "name": "EAT a thrown tomato",
			"cost": "have %d" % tomatoes, "ok": not full, "why": "not hungry yet" if full else "",
			"sub": "free, and a little humbling: +%d stamina, no %s, no Strength." % [int(TOMATO_EAT_STAM), coin_word()]})
	if have(PROP_EGGS) > 0:
		out.append({"id": "egg", "grp": "rest", "icon": "egg", "name": "EAT a raw egg",
			"cost": "own %d" % have(PROP_EGGS), "ok": not full, "why": "not hungry yet" if full else "",
			"sub": "no %s and no Strength tick: just +%d stamina, and one fewer egg to juggle." % [coin_word(), int(EGG_EAT_STAM)]})
	if true:
		# DRINKS BELONG WHERE THE RECOVERY IS (2026-07-28, Louis, describing them as
		# bought "in the resting area"). They are stocked from the shop too and always
		# were, but everything else that puts stamina back - the meal, the bed, the pie,
		# the tomato, the egg - is on this drawer, and a restock is the same errand as a
		# meal. It costs no day segment: it is a case of cans, not an evening out.
		out.append({"id": "drinks", "grp": "rest", "icon": "drink", "name": "STOCK Energy Drinks",
			"cost": "%s %s" % [commafy(ENERGY_DRINK_BATCH_COST), coin_word()],
			"ok": money >= ENERGY_DRINK_BATCH_COST,
			"why": "not enough %s" % coin_word() if money < ENERGY_DRINK_BATCH_COST else "",
			"sub": "%d cans for the helmet, %d in reserve now. Each is +%d%% stamina, poured the moment you run dry." % [
				ENERGY_DRINK_BATCH, energy_drinks, int(ENERGY_DRINK_STAMINA_PCT * 100.0)]})
	out.append({"id": "shop", "grp": "prep", "icon": "shop", "name": "SHOP",
		"cost": "", "ok": true, "why": "",
		"sub": "props and gear. A new prop teaches itself when you buy it."})
	out.append({"id": "skills", "grp": "prep", "icon": "book", "name": "SKILLS",
		"cost": "", "ok": true, "why": "",
		"sub": "every trick and pattern you know, and the keys that pull it off."})
	out.append({"id": "tailor", "grp": "prep", "icon": "hanger", "name": "TAILOR",
		"cost": "", "ok": true, "why": "",
		"sub": "dress for the stage: a suit from any house you have played, and every piece you own."})
	return out


func day_rows() -> Array[Dictionary]:
	# WHAT THE CURSOR WALKS. The hub used to lay all ten actions out at once, which
	# Louis called crowded, so they live in three DRAWERS now (see DAY_GROUPS) and the
	# top level shows one card each: at most four things on screen instead of ten.
	# `day_group` is "" at the top level, else the open drawer's id. Everything else
	# (day_activate, the venue picker, the vignettes) keys off row ids exactly as
	# before - only which rows exist at a given moment changed.
	var out: Array[Dictionary] = []
	if day_group == "":
		# a queued lesson always sits at the very top of the hub, never inside a
		# drawer: a new unlock should be the first thing seen, and it costs no time
		if not pending_tuts.is_empty():
			# the lesson's NAME goes in the explanation, not the title: a trick name is
			# data and can be any length, and the title strip is narrow
			out.append({"id": "learn", "icon": "spark", "name": "LEARN something new",
				"cost": "free", "ok": true, "why": "", "col": Color(0.55, 0.88, 0.52),
				"sub": "%s, taught slow, one step at a time. Costs no time at all." % lesson_title(pending_tuts[0])})
		var acts := day_actions()
		for g in DAY_GROUPS:
			var gid := String(g["id"])
			var open_n := 0
			var total := 0
			var blocked := ""
			for a in acts:
				if String(a["grp"]) != gid:
					continue
				total += 1
				if bool(a["ok"]):
					open_n += 1
				elif blocked == "":
					blocked = String(a["why"])
			# the drawer says what it holds and, when nothing in it can be done, why
			var note := String(g["sub"])
			if open_n == 0 and blocked != "":
				note = blocked
			out.append({"id": "grp:" + gid, "icon": String(g["icon"]), "name": String(g["name"]),
				"cost": "%d of %d" % [open_n, total] if open_n < total else "%d" % total,
				"ok": open_n > 0, "why": blocked, "col": Color(g["col"]), "sub": note,
				"drawer": true})
		return out
	for a in day_actions():
		if String(a["grp"]) == day_group:
			var r := a.duplicate()
			r["col"] = day_group_col(day_group)
			out.append(r)
	out.append({"id": "back", "icon": "back", "name": "BACK", "cost": "", "ok": true, "why": "",
		"col": Color(0.78, 0.72, 0.66), "sub": "out to the day's other choices."})
	return out


func day_group_col(gid: String) -> Color:
	for g in DAY_GROUPS:
		if String(g["id"]) == gid:
			return Color(g["col"])
	return Color(0.95, 0.7, 0.4)


func day_group_name(gid: String) -> String:
	for g in DAY_GROUPS:
		if String(g["id"]) == gid:
			return String(g["name"])
	return ""


func day_input(kc: int) -> void:
	# the sheet, shop, and skills overlays keep their usual keys while open over the hub
	if sheet_open:
		sheet_input(kc)
		return
	if shop_open:
		shop_input(kc)
		return
	if skills_open:
		skills_input(kc)
		return
	if tailor_open:
		tailor_input(kc)
		return
	if day_anim != "":
		return   # a little vignette is playing; the hub listens again when it ends
	check_dead_end()   # a shop spree can strand you; the road ends the moment it is true
	if game_state != ST_DAY:
		return
	var rows := day_rows()
	var n := rows.size()
	day_sel = clampi(day_sel, 0, n - 1)
	match kc:
		KEY_UP, KEY_W:
			day_sel = (day_sel + n - 1) % n
			play_sfx("ui", -14.0)
		KEY_DOWN, KEY_S:
			day_sel = (day_sel + 1) % n
			play_sfx("ui", -14.0)
		KEY_LEFT, KEY_RIGHT:
			# choosing tonight's stage is free, any venue reputation has unlocked.
			# The picker STOPS at both ends (Louis: left to right, never wrapping).
			if String(rows[day_sel]["id"]) == "perform":
				var dir := 1 if kc == KEY_RIGHT else -1
				var np := clampi(play_venue() + dir, 0, venue_index())
				if np != play_venue():
					venue_pick = np
					play_sfx("ui2", -14.0)
			elif kc == KEY_LEFT and day_group != "":
				day_close_drawer()   # left is also "out of this drawer", like a file tree
			elif kc == KEY_RIGHT and String(rows[day_sel]["id"]).begins_with("grp:"):
				day_activate(String(rows[day_sel]["id"]), true, "")   # right opens one
		KEY_P:
			# book tonight PURIST: the pure-skill ladder with its own records
			purist = not purist
			set_day_msg("tonight is a PURIST set  -  no stat help, its own records" if purist else "back to the assisted board")
			save_progress()
			play_sfx("ui2", -13.0)
		KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
			day_activate(String(rows[day_sel]["id"]), bool(rows[day_sel]["ok"]), String(rows[day_sel]["why"]))
		KEY_TAB:
			sheet_open = true
			play_sfx("ui2", -13.0)
		KEY_ESCAPE:
			# inside a drawer, Escape backs out of it rather than leaving the day
			# entirely - the same thing Back does, and what a folder view should do
			if day_group != "":
				day_close_drawer()
				return
			save_progress()
			game_state = ST_MENU
			menu_sel = 0
			play_sfx("ui", -12.0)


func day_close_drawer() -> void:
	# back out to the top level, landing the cursor ON the drawer just left, so the
	# way back in is exactly where the eye already is
	var was := day_group
	day_group = ""
	day_sel = 0
	var rows := day_rows()
	for i in rows.size():
		if String(rows[i]["id"]) == "grp:" + was:
			day_sel = i
			break
	play_sfx("ui", -13.0)


func day_activate(id: String, ok: bool, why: String) -> void:
	# a DRAWER always opens, even when nothing inside it can be done right now: the
	# player is allowed to look, and the row inside says why it is closed
	if id.begins_with("grp:"):
		day_group = id.substr(4)
		day_sel = 0
		play_sfx("ui2", -13.0)
		return
	if id == "back":
		day_close_drawer()
		return
	if not ok:
		set_day_msg(why)
		play_sfx("whiff", -10.0)
		return
	match id:
		"perform":
			seg_used += 1
			save_progress()
			begin_performance(num_balls)
			play_sfx("ui2", -11.0)
		"daily":
			seg_used += 1
			save_progress()
			begin_daily_challenge()
			play_sfx("ui2", -11.0)
		"practice":
			seg_used += 1
			career["practices"] = int(career["practices"]) + 1
			save_progress()
			mode = MODE_TRAIN
			game_state = ST_PLAY
			start_run(num_balls)
			play_sfx("ui2", -11.0)
		"eat", "inn":
			# these two open with a small vignette; the effect lands when it
			# ends. Dinner that would break the bed money asks first.
			if id == "eat" and not confirm_spend("eat", EAT_COST, false):
				return
			day_anim = id
			day_anim_start = cine_tick
			play_sfx("ui2", -13.0)
		"shop":
			# the counter opens the moment you ask for it (Louis: the awning
			# vignette between the press and the shop was dead time)
			shop_open = true
			play_sfx("ui2", -13.0)
		"buy_pie":
			try_buy_pie()
			if shop_msg != "":
				set_day_msg(shop_msg)
		"drinks":
			# a restock, not an errand: no vignette and no day segment, for the same
			# reason the shop itself opens instantly. try_buy_drinks owns the whole
			# transaction (price, cap, message, save), so the hub and the shop counter
			# cannot end up charging differently for the same case of cans.
			try_buy_drinks()
			if shop_msg != "":
				set_day_msg(shop_msg)
		"pie", "egg", "tomato":
			# EVERY thing you eat gets its beat of picture now (2026-07-27, Louis: only
			# sleeping had one). Same contract as eat/inn above - the vignette plays, and
			# day_anim_step lands the effect when it ends - so the hub never moves the
			# ledger before the player has seen why.
			day_anim = id
			day_anim_start = cine_tick
			play_sfx("ui2", -13.0)
		"skills":
			skills_open = true          # a reference card, no cost, no vignette
			skills_sel = 0
			play_sfx("ui2", -13.0)
		"tailor":
			# same shape as SKILLS: a room you look at, not an errand you spend the day on.
			# Dressing costs nothing and takes no segment - it would be a strange game that
			# charged an evening for putting a hat on.
			tailor_open = true
			tailor_sel = 0
			tailor_col = 0
			play_sfx("ui2", -13.0)
		"learn":
			# drain one queued lesson and teach it now. Marked seen BEFORE teaching, and
			# saved, so it is remembered as taught even if the player quits mid-lesson.
			if not pending_tuts.is_empty():
				var lid: String = pending_tuts[0]
				pending_tuts.remove_at(0)
				if not seen_tuts.has(lid):
					seen_tuts.append(lid)
				save_progress()
				begin_tutorial(lid)
				play_sfx("ui2", -11.0)


func day_anim_len(id: String) -> int:
	# how long each day-action vignette holds, in cine_ticks (120/s: inn's 220 is
	# ~1.8s, eat's 150 ~1.25s, everything else 100 is ~0.8s) - inn runs longest
	# since sleep is the day-ending beat and earns a slower breath
	match id:
		"inn": return 220
		"eat": return 150
		"pie", "tomato": return 140
		"egg": return 120
		_: return 100


func day_anim_step() -> void:
	# the little vignette has finished: NOW the action actually happens, so the
	# picture always leads and the ledger follows
	if cine_tick - day_anim_start < day_anim_len(day_anim):
		return
	var id := day_anim
	day_anim = ""
	match id:
		"eat":
			money -= EAT_COST
			play_sfx("money", -9.0)   # gold on the counter
			stamina = minf(stamina_max, stamina + EAT_STAM * stamina_max)
			meals += 1
			if meals % MEALS_PER_STR == 0 and strength < STR_CAP:
				var prev_max := max_balls()
				strength += 1
				check_ball_unlock(prev_max)   # a meal's Strength can cross a ball gate too
				set_day_msg("the good food is paying off  -  Strength +1")
				play_sfx("streak", -8.0)
			else:
				set_day_msg("a hot meal, stamina restored a little")
		"inn":
			money -= INN_COST   # full price, always (the row blocks when short)
			play_sfx("money", -9.0)
			sleep_day()
		"pie":
			pie_count -= 1
			pie_active = true
			set_day_msg("the pie hums in your blood  -  the world runs slow until you sleep")
			save_progress()
			play_sfx("ui2", -11.0)
		"egg":
			prop_count[PROP_EGGS] = maxi(0, prop_count[PROP_EGGS] - 1)
			stamina = minf(stamina_max, stamina + EGG_EAT_STAM)
			set_day_msg("a raw egg down the hatch  -  a little stamina back, one fewer to juggle")
			save_progress()
			play_sfx("c_egg", -10.0)   # the same crack the stage already uses when one breaks
		"tomato":
			tomatoes = maxi(0, tomatoes - 1)
			stamina = minf(stamina_max, stamina + TOMATO_EAT_STAM)
			set_day_msg("still good  -  the crowd's opinion, eaten")
			save_progress()
			play_sfx("good", -12.0)


func sleep_day() -> void:
	# the day turns over: segments refill and stamina comes back full. Sleeping
	# rough was cut (Louis): the inn is the only bed, full price, full rest.
	day += 1
	seg_used = 0
	pie_active = false   # the pie's clarity wears off with sleep
	career["days"] = maxi(int(career["days"]), day)
	stamina = stamina_max
	set_day_msg("day %d  -  you wake rested" % day)
	play_sfx("streak", -9.0)
	save_progress()


