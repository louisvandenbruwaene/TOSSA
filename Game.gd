# =============================================================================
# Audio. The SFX below are all synthesised in code into an AudioStreamWAV at
# startup (gen_sfx, setup_audio), then just played, so there is no per-frame
# synthesis cost. Music is NOT synthesised: it is two of Louis's own Suno MP3
# loops (MUSIC_PATH "juggling", MUSIC_PATH_CHILL "chill", both loaded and
# looping from setup_audio) that audio_update volume-automates and staged-
# crossfades between - see the _mix walk there. No crowd-murmur bed; that idea
# was cut (2026-07-18) in favour of zero ambient noise and tonal stingers only.
# =============================================================================

#endregion

#region AUDIO SYNTHESIS (SFX)
func setup_audio() -> void:
	gen_sfx()
	for _i in 8:                       # a round-robin pool for overlapping one-shots
		var p := AudioStreamPlayer.new()
		add_child(p)
		sfx_pool.append(p)
	mus = AudioStreamPlayer.new(); add_child(mus); mus.volume_db = -80.0
	var m := load(MUSIC_PATH) as AudioStreamMP3
	if m != null:
		m.loop = true
		mus.stream = m
		mus.play()
	# the calmer non-juggling track, looping alongside, held silent until it is wanted
	mus2 = AudioStreamPlayer.new(); add_child(mus2); mus2.volume_db = -80.0
	var m2 := load(MUSIC_PATH_CHILL) as AudioStreamMP3
	if m2 != null:
		m2.loop = true
		mus2.stream = m2
		mus2.play()
	_audio_ready = true


func play_sfx(name: String, vol_db: float = 0.0, pitch: float = 1.0) -> void:
	if set_sfx <= 0.0 or not _audio_ready or not sfx.has(name):
		return
	var p: AudioStreamPlayer = sfx_pool[_sfx_next]
	_sfx_next = (_sfx_next + 1) % sfx_pool.size()
	p.stream = sfx[name]
	p.volume_db = vol_db + linear_to_db(set_sfx)   # the slider only ATTENUATES: at
													# 1.0 every hand-tuned vol_db above
													# is untouched, same as the old bool
	p.pitch_scale = clampf(pitch, 0.3, 3.0)
	p.play()


func _catch_sound(kind: int) -> String:
	match kind:
		PROP_EGGS: return "c_egg"
		# rings share the ball catch sound (Louis: didn't like the ring timbre)
		PROP_CLUBS: return "c_club"
		PROP_KNIVES: return "c_knife"
		PROP_TORCHES: return "c_torch"
		PROP_CHAINSAW: return "c_saw"
		_: return "c_ball"


func audio_update() -> void:
	# runs every frame in every state: glide the track's volume to fit the moment.
	# Louis's song IS the soundtrack, so the game never changes the material, only
	# how much room it takes: the "juggling" loop plays whenever juggling could
	# start (the stage door onward), the "chill" loop takes over everywhere else
	# (menus, day hub, results), and a prop hitting the floor dips it briefly
	# (via _duck).
	if not _audio_ready:
		return
	var in_play := game_state == ST_PLAY
	var perf := in_play and mode == MODE_PERFORM and not tut_active
	# JUGGLING = anywhere the player could start juggling: the stage card and the
	# whole play state (performance, practice, or a lesson - throwing or not). The
	# handover used to wait for the FIRST THROW, which meant the chill mix was still
	# fading while you were already juggling (Louis); now it starts at the stage
	# door, so the swap is done before the balls go up. Only the results card hands
	# back to the chill mix (the performance is over).
	var juggling := game_state == ST_ESTABLISH or (in_play and not results_open)
	var energy := clampf(applause * 0.65 + clampf(float(streak) / 8.0, 0.0, 1.0) * 0.55, 0.0, 1.0)
	# the handover between the two tracks is STAGED (Louis: they differ too much in
	# tempo and volume to overlap - a crossfade read as a mashup). _mix walks 0..1,
	# and the gain curves carve the walk into three bands: the leaving track fades
	# fully OUT, a breath of true silence holds, then the arriving track fades IN
	# from nothing. Both directions get the same shape.
	_mix = move_toward(_mix, 1.0 if juggling else 0.0, 1.0 / (3.0 * 120.0))
	var chill_g := clampf(1.0 - _mix / 0.38, 0.0, 1.0)     # gone 38% into the walk
	var main_g := clampf((_mix - 0.62) / 0.38, 0.0, 1.0)   # enters only after the hush
	# the stage track RESTARTS from the top whenever it returns from full silence, so
	# every performance opens on the song's opening bars instead of joining mid-loop
	if main_g <= 0.0:
		_main_silent = true
	elif _main_silent:
		_main_silent = false
		mus.play(0.0)
	var main_base := (lerpf(-13.0, -9.0, energy) if perf else -14.0) - _duck * 9.0
	# the slider only ATTENUATES (maxf floors it at -80dB, effectively silent, so
	# there is no separate "if muted" branch to keep in sync with this one)
	var vol_off := linear_to_db(maxf(set_music, 0.0001))
	var main_t := main_base + linear_to_db(maxf(main_g, 0.001)) + vol_off
	var chill_t := -13.0 + linear_to_db(maxf(chill_g, 0.001)) + vol_off
	# the base loudness still GLIDES (energy swells, drop ducks); only the handover
	# itself is the timed crossfade above
	_vol["mus"] = lerpf(_vol["mus"], main_t, 0.06)
	mus.volume_db = maxf(_vol["mus"], -80.0)
	_vol["mus2"] = lerpf(_vol["mus2"], chill_t, 0.06)
	mus2.volume_db = maxf(_vol["mus2"], -80.0)
	_duck = maxf(0.0, _duck - 0.03)


# --- synthesis primitives -----------------------------------------------------

func _wav(data: PackedFloat32Array, loop: bool) -> AudioStreamWAV:
	var n := data.size()
	var bytes := PackedByteArray()
	bytes.resize(n * 2)
	for i in n:
		bytes.encode_s16(i * 2, int(clampf(data[i], -1.0, 1.0) * 32767.0))
	var w := AudioStreamWAV.new()
	w.format = AudioStreamWAV.FORMAT_16_BITS
	w.mix_rate = AUDIO_SR
	w.stereo = false
	w.data = bytes
	if loop:
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = n
	return w


func _wsamp(phase: float, wave: int) -> float:
	var ph := fposmod(phase, TAU)
	match wave:
		1:
			return 4.0 * absf(ph / TAU - 0.5) - 1.0   # triangle
		2:
			return ph / PI - 1.0                       # saw
		3:
			return 1.0 if ph < PI else -1.0            # square
		_:
			return sin(ph)


func _tone(freqs: Array, amps: Array, dur: float, wave: int, atk: float, decay: float, vol: float, noise: float) -> PackedFloat32Array:
	# additive partials with a fast-attack exponential-decay (plucked) envelope
	var n := int(AUDIO_SR * dur)
	var out := PackedFloat32Array()
	out.resize(n)
	var phs := PackedFloat32Array()
	phs.resize(freqs.size())
	for i in n:
		var t := float(i) / AUDIO_SR
		var e := (t / maxf(atk, 0.0001)) if t < atk else exp(-(t - atk) / maxf(decay, 0.0001))
		var s := 0.0
		var asum := 0.0
		for j in freqs.size():
			phs[j] += TAU * float(freqs[j]) / AUDIO_SR
			s += _wsamp(phs[j], wave) * float(amps[j])
			asum += float(amps[j])
		s /= maxf(asum, 0.0001)
		if noise > 0.0:
			s = lerpf(s, randf() * 2.0 - 1.0, noise)
		out[i] = s * e * vol
	return out


func _click(dur: float, decay: float, vol: float) -> PackedFloat32Array:
	# a short broadband noise transient: the real "point of contact" a catch or
	# knock makes, decaying far faster than any tonal body mixed under it via
	# _mix_into. _tone's own `noise` param blends noise for the WHOLE note (right
	# for something airy like a whiff or a torch whoosh); this is for the crisp
	# attack a _tone alone can't give a "something just hit my hand" sound.
	var n := int(AUDIO_SR * dur)
	var out := PackedFloat32Array()
	out.resize(n)
	for i in n:
		var t := float(i) / AUDIO_SR
		out[i] = (randf() * 2.0 - 1.0) * exp(-t / maxf(decay, 0.0001)) * vol
	return out


func _mix_into(base: PackedFloat32Array, extra: PackedFloat32Array) -> PackedFloat32Array:
	# additively layers `extra` under/over `base` (e.g. a _click transient under
	# a _tone body), sample by sample, clamped so the two can never clip together
	for i in mini(base.size(), extra.size()):
		base[i] = clampf(base[i] + extra[i], -1.0, 1.0)
	return base


func _seq_bells(freqs: Array, gap: float, vol: float) -> PackedFloat32Array:
	# a little run of bell notes, for coins and streak flourishes
	var note := 0.18
	var n := int(AUDIO_SR * (gap * float(freqs.size()) + note))
	var out := PackedFloat32Array()
	out.resize(n)
	for j in freqs.size():
		var start := int(AUDIO_SR * gap * float(j))
		var ph := 0.0
		for i in int(AUDIO_SR * note):
			var idx := start + i
			if idx >= n:
				break
			ph += TAU * float(freqs[j]) / AUDIO_SR
			out[idx] = clampf(out[idx] + sin(ph) * exp(-float(i) / AUDIO_SR / 0.08) * vol, -1.0, 1.0)
	return out


func _drop_sound() -> PackedFloat32Array:
	# a prop hitting the floor: a falling low thud (120Hz down to 55Hz) with a
	# sharp noise click layered on top for the impact
	var dur := 0.34
	var n := int(AUDIO_SR * dur)
	var out := PackedFloat32Array()
	out.resize(n)
	var ph := 0.0
	for i in n:
		var t := float(i) / AUDIO_SR
		ph += TAU * lerpf(120.0, 55.0, clampf(t / 0.2, 0.0, 1.0)) / AUDIO_SR
		var body := sin(ph) * exp(-t / 0.12)
		var click := (randf() * 2.0 - 1.0) * exp(-t / 0.02) * 0.5
		out[i] = clampf((body * 0.8 + click) * 0.6, -1.0, 1.0)
	return out


func _throw_sound() -> PackedFloat32Array:
	# a soft downward "whup": a quick falling pitch with a little air, not a noise burst
	var dur := 0.16
	var n := int(AUDIO_SR * dur)
	var out := PackedFloat32Array()
	out.resize(n)
	var ph := 0.0
	for i in n:
		var t := float(i) / AUDIO_SR
		var f := lerpf(540.0, 240.0, clampf(t / dur, 0.0, 1.0))   # falling whup
		ph += TAU * f / AUDIO_SR
		var air := (randf() * 2.0 - 1.0) * 0.22
		var e := exp(-t / 0.06)
		out[i] = clampf((sin(ph) * 0.75 + air * 0.5) * e * 0.32, -1.0, 1.0)
	return out


func _catch_perfect() -> PackedFloat32Array:
	# the satisfying one: a soft round body plus a bright major-third sparkle on top
	var dur := 0.34
	var n := int(AUDIO_SR * dur)
	var out := PackedFloat32Array()
	out.resize(n)
	var body := 0.0
	var s1 := 0.0
	var s2 := 0.0
	var s3 := 0.0
	for i in n:
		var t := float(i) / AUDIO_SR
		body += TAU * 300.0 / AUDIO_SR      # warm pock body
		s1 += TAU * 1046.5 / AUDIO_SR       # C6
		s2 += TAU * 1318.5 / AUDIO_SR       # E6
		s3 += TAU * 1568.0 / AUDIO_SR       # G6
		var eb := exp(-t / 0.05)
		var eb2 := exp(-t / 0.16)
		var v := sin(body) * 0.5 * eb + (sin(s1) + 0.7 * sin(s2) + 0.5 * sin(s3)) / 2.2 * 0.55 * eb2
		out[i] = clampf(v * 0.6, -1.0, 1.0)
	return out


func _splat_sound() -> PackedFloat32Array:
	# the egg shattering on the floor (paired with spawn_egg_break, not a generic
	# prop drop): a noisy wet burst over a low 150Hz tone, both dying out fast
	var dur := 0.22
	var n := int(AUDIO_SR * dur)
	var out := PackedFloat32Array()
	out.resize(n)
	var ph := 0.0
	for i in n:
		var t := float(i) / AUDIO_SR
		ph += TAU * 150.0 / AUDIO_SR
		out[i] = clampf(((randf() * 2.0 - 1.0) * 0.6 + sin(ph) * 0.4) * exp(-t / 0.05) * 0.6, -1.0, 1.0)
	return out


func _gasp_sound() -> PackedFloat32Array:
	# the room inhaling at a risky throw: a soft quick upward slide, pure tone
	var dur := 0.28
	var n := int(AUDIO_SR * dur)
	var out := PackedFloat32Array()
	out.resize(n)
	var ph := 0.0
	for i in n:
		var t := float(i) / AUDIO_SR
		ph += TAU * lerpf(320.0, 560.0, clampf(t / dur, 0.0, 1.0)) / AUDIO_SR
		out[i] = sin(ph) * clampf(t / 0.06, 0.0, 1.0) * exp(-maxf(t - 0.14, 0.0) / 0.07) * 0.3
	return out


func _groan_sound() -> PackedFloat32Array:
	# the room sagging at a drop: two low tones sliding down a third, pure tone
	var dur := 0.5
	var n := int(AUDIO_SR * dur)
	var out := PackedFloat32Array()
	out.resize(n)
	var ph := 0.0
	var ph2 := 0.0
	for i in n:
		var t := float(i) / AUDIO_SR
		var slide := lerpf(196.0, 155.6, clampf(t / 0.3, 0.0, 1.0))
		ph += TAU * slide / AUDIO_SR
		ph2 += TAU * slide * 1.5 / AUDIO_SR
		out[i] = (sin(ph) + 0.4 * sin(ph2)) / 1.4 * clampf(t / 0.05, 0.0, 1.0) * exp(-maxf(t - 0.2, 0.0) / 0.14) * 0.34
	return out


func _cheer_sound() -> PackedFloat32Array:
	# the room lifting: a warm major chord that swells and settles under a quick
	# rising run of bells. All tone, no noise (the old version was a noise swell,
	# which Louis heard as static rather than a cheer).
	var dur := 1.1
	var n := int(AUDIO_SR * dur)
	var out := PackedFloat32Array()
	out.resize(n)
	var chord := [523.25, 659.26, 783.99]   # C5 E5 G5
	var phs := [0.0, 0.0, 0.0]
	for i in n:
		var t := float(i) / AUDIO_SR
		var e := clampf(t / 0.22, 0.0, 1.0) * exp(-maxf(t - 0.22, 0.0) / 0.38)
		var s := 0.0
		for j in 3:
			phs[j] += TAU * float(chord[j]) * (1.0 + 0.004 * sin(TAU * 5.0 * t + float(j))) / AUDIO_SR
			s += sin(float(phs[j]))
		out[i] = s / 3.0 * e * 0.4
	# the quick bell run on top, stepping up the C major pentatonic
	var run := [783.99, 987.77, 1174.66, 1567.98]
	for j in run.size():
		var start := int(AUDIO_SR * (0.05 + 0.07 * float(j)))
		var ph := 0.0
		for i in int(AUDIO_SR * 0.3):
			var idx := start + i
			if idx >= n:
				break
			ph += TAU * float(run[j]) / AUDIO_SR
			out[idx] = clampf(out[idx] + sin(ph) * exp(-float(i) / AUDIO_SR / 0.09) * 0.22, -1.0, 1.0)
	return out


func _stamp_sound() -> PackedFloat32Array:
	# a heavy stamp for the grade badge: a low thump plus a snap of noise
	var dur := 0.22
	var n := int(AUDIO_SR * dur)
	var out := PackedFloat32Array()
	out.resize(n)
	var ph := 0.0
	for i in n:
		var t := float(i) / AUDIO_SR
		ph += TAU * lerpf(140.0, 62.0, clampf(t / 0.12, 0.0, 1.0)) / AUDIO_SR
		var body := sin(ph) * exp(-t / 0.09)
		var snap := (randf() * 2.0 - 1.0) * exp(-t / 0.012) * 0.6
		out[i] = clampf((body * 0.9 + snap) * 0.7, -1.0, 1.0)
	return out


func gen_sfx() -> void:
	# catch feedback, by quality: perfect is satisfying, good is a warm nod, late is a
	# dull "meh", whiff is a soft airy miss. These are the load-bearing sounds.
	sfx["perfect"] = _wav(_catch_perfect(), false)
	sfx["cheer"] = _wav(_cheer_sound(), false)
	sfx["stamp"] = _wav(_stamp_sound(), false)
	sfx["count"] = _wav(_tone([1318.5], [1.0], 0.05, 0, 0.001, 0.02, 0.22, 0.0), false)
	sfx["record"] = _wav(_seq_bells([659.3, 784.0, 987.8, 1318.5], 0.09, 0.5), false)
	sfx["good"] = _wav(_tone([880.0, 1318.5], [1.0, 0.45], 0.24, 0, 0.001, 0.11, 0.46, 0.0), false)
	sfx["late"] = _wav(_tone([392.0], [1.0], 0.15, 1, 0.003, 0.05, 0.34, 0.03), false)
	sfx["whiff"] = _wav(_tone([520.0, 415.0], [1.0, 0.5], 0.10, 0, 0.001, 0.045, 0.18, 0.1), false)
	sfx["throw"] = _wav(_throw_sound(), false)
	sfx["drop"] = _wav(_drop_sound(), false)
	sfx["splat"] = _wav(_splat_sound(), false)
	sfx["coin"] = _wav(_seq_bells([987.8, 1318.5], 0.09, 0.5), false)
	# gold changing hands: a quick high jingle of coin-on-coin clinks, distinct from
	# the two-note "coin" flourish above (the lesson-complete fanfare, also reused
	# for the reward director's pie/meal aid grants - see reward_director)
	sfx["money"] = _wav(_seq_bells([1568.0, 2093.0, 1760.0, 2637.0], 0.045, 0.42), false)
	sfx["streak"] = _wav(_seq_bells([784.0, 987.8, 1318.5], 0.08, 0.5), false)
	sfx["ui"] = _wav(_tone([880.0], [1.0], 0.05, 0, 0.001, 0.02, 0.3, 0.0), false)
	sfx["ui2"] = _wav(_tone([1174.7, 1568.0], [1.0, 0.5], 0.10, 0, 0.001, 0.05, 0.35, 0.0), false)
	sfx["gasp"] = _wav(_gasp_sound(), false)
	sfx["groan"] = _wav(_groan_sound(), false)
	# per-prop catch textures: NOT PLAYED right now (Louis: only perfect/good/late/
	# whiff, no per-object sounds) - see the removed play_sfx call in on_catch.
	# Kept generated (and the _click/_mix_into transient helpers kept defined,
	# unused) so this whole texture layer is one commented-out line away from
	# coming back, not deleted.
	sfx["c_ball"] = _wav(_tone([420.0], [1.0], 0.10, 0, 0.001, 0.035, 0.5, 0.15), false)
	sfx["c_egg"] = _wav(_tone([520.0], [1.0], 0.09, 0, 0.001, 0.03, 0.45, 0.2), false)
	sfx["c_club"] = _wav(_tone([190.0, 320.0], [1.0, 0.4], 0.10, 1, 0.001, 0.04, 0.5, 0.25), false)
	sfx["c_knife"] = _wav(_tone([1200.0, 2760.0, 5400.0], [1.0, 0.5, 0.25], 0.42, 0, 0.001, 0.30, 0.32, 0.0), false)
	sfx["c_torch"] = _wav(_tone([140.0], [1.0], 0.28, 0, 0.02, 0.18, 0.4, 0.7), false)
	# THE CHAINSAW lands with a bite of engine, not a chime: a low two-stroke fundamental
	# with a rough harmonic over it and a long-ish tail, so catching one sounds like
	# taking hold of something that is still running rather than like a heavy ball
	sfx["c_saw"] = _wav(_tone([96.0, 173.0, 262.0], [1.0, 0.62, 0.34], 0.34, 1, 0.004, 0.24, 0.42, 0.85), false)


func dump_audio(dir: String) -> void:
	# dev: write every sound to <dir> as .wav, for verification and preview.
	# The music is Louis's own track now, so only the procedural SFX are dumped.
	for name in sfx:
		(sfx[name] as AudioStreamWAV).save_to_wav("%s/sfx_%s.wav" % [dir, name])


# =============================================================================
# Presentation layer. Everything below is procedural (the code-only art rule):
# the establishing card, the credits, the shared "royal" polish (gradients,
# vignette, gold frames, drifting dust), and the venue exteriors.
# cine_tick drives all the motion.
# =============================================================================

#endregion

#region ESTABLISHING CARD & CREDITS
func venue_blurb(i: int) -> String:
	# one line on the crowd you are about to face, so each stage reads distinct
	match i:
		0: return "a quiet yard  -  a forgiving place to find your hands"
		1: return "a street corner  -  passers-by you keep only by playing clean"
		2: return "a ticketed house  -  quiet, paying, and quietly exacting"
		3: return "the big top  -  loud, vast, and hungry for spectacle"
		4: return "a scored floor  -  judged on precision, never on flash"
		5: return "the summit  -  no help left but your own two hands"
		_: return "no lights but yours  -  the crowd that stayed after the win"


func draw_establish(font: Font, s: Vector2) -> void:
	# the STAGE CARD: a portrait of the venue you are about to play, its rung on the
	# ladder, the record to beat, and how the next stage opens. The exterior drifts
	# in a slow push so the card feels composed rather than static.
	var ez := 1.0 + 0.07 * clampf(float(cine_tick) / 340.0, 0.0, 1.0)
	draw_set_transform(s * 0.5 * (1.0 - ez), 0.0, Vector2(ez, ez))
	ext_center = true    # the card is a portrait of the venue: hero mid-frame
	draw_venue_exterior(s, establish_venue)
	ext_center = false
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	var fin := clampf(float(cine_tick) / 26.0, 0.0, 1.0)
	if fin < 1.0:
		draw_rect(Rect2(0, 0, s.x, s.y), Color(0.02, 0.01, 0.02, 1.0 - fin))
	draw_vignette(s, 0.6)
	draw_frame(s, 22.0, Color(0.82, 0.62, 0.34, 0.55))

	var tagA := clampf(float(cine_tick - 10) / 20.0, 0.0, 1.0)
	# ONLY the marquee stays over the portrait: STAGE n of 6, the name in lights, the
	# crowd blurb - text with the 8-way outline, no boxes. Everything informational
	# (record, set, target, encore, purist) lives in two small cards at the BOTTOM
	# corners now (Louis: the centred stack of rectangles buried the venue portrait).
	# the Midnight Show sits PAST the 6-stage ladder (TOP_VENUE), so it gets its own
	# tag rather than a "STAGE 7 of 6" that would contradict TOP_VENUE's own meaning
	var stage_tag := "ENCORE" if establish_venue > TOP_VENUE else "STAGE  %d  of  %d" % [establish_venue + 1, TOP_VENUE + 1]
	draw_text_shout(font, Vector2(0, s.y * 0.10), stage_tag, HORIZONTAL_ALIGNMENT_CENTER, s.x, 16, Color(0.9, 0.78, 0.55, 0.85 * tagA))
	var vn := String(venue_data(establish_venue)["name"]).to_upper()
	draw_title_glow(font, s.y * 0.12 + 12.0, vn, 52, Color(1.0, 0.9, 0.55), s)
	draw_ornament(s.x * 0.5, s.y * 0.12 + 72.0, 190.0, Color(0.82, 0.62, 0.34, 0.85))
	draw_text_shout(font, Vector2(0, s.y * 0.12 + 96.0), venue_blurb(establish_venue), HORIZONTAL_ALIGNMENT_CENTER, s.x, 14, Color(0.86, 0.78, 0.66, 0.8 * tagA))

	var py := s.y - 70.0
	draw_gradient_v(Rect2(0, py - 30.0, s.x, s.y - py + 30.0), Color(0.02, 0.01, 0.02, 0.0), Color(0.02, 0.01, 0.02, 0.9), 16)

	# bottom-LEFT: the record chase at this venue (its own board on a purist night)
	var rw := 330.0
	var rh := 96.0 if purist else 76.0
	var rx := 18.0
	var ry := s.y - 88.0 - rh
	hud_panel(Rect2(rx, ry, rw, rh))
	draw_string(font, Vector2(rx + 16.0, ry + 24.0), "RECORD TO BEAT", HORIZONTAL_ALIGNMENT_LEFT, -1, 12, Color(0.85, 0.72, 0.55, 0.9 * tagA))
	if establish_venue >= 0 and establish_venue < rec_table().size() and rec_table()[establish_venue] > 0:
		draw_string(font, Vector2(rx + 16.0, ry + 54.0), commafy(rec_table()[establish_venue]), HORIZONTAL_ALIGNMENT_LEFT, -1, 24, Color(0.96, 0.83, 0.52, tagA))
	else:
		draw_string(font, Vector2(rx + 16.0, ry + 52.0), "none yet  -  set one", HORIZONTAL_ALIGNMENT_LEFT, -1, 17, Color(0.9, 0.82, 0.6, 0.85 * tagA))
	if purist:
		draw_string(font, Vector2(rx + 16.0, ry + 80.0), "PURIST  -  no stat help, its own board", HORIZONTAL_ALIGNMENT_LEFT, -1, 12, Color(0.82, 0.72, 0.85, 0.9 * tagA))

	# bottom-RIGHT: the act's ask - the three goals to chase, and the whole-act
	# challenge when one was rolled. Cash in from the first number on; each further
	# goal is the gamble.
	if booking_active:
		var has_enc := encore >= 0 and encore < ENCORES.size()
		var bw := 400.0
		var bh := 146.0 if has_enc else 76.0
		var bx := s.x - 18.0 - bw
		var by2 := s.y - 88.0 - bh
		hud_panel(Rect2(bx, by2, bw, bh))
		draw_string(font, Vector2(bx + 16.0, by2 + 24.0), "THE ACT  -  cash in at any goal", HORIZONTAL_ALIGNMENT_LEFT, -1, 12, Color(0.85, 0.72, 0.55, 0.9 * tagA))
		draw_string(font, Vector2(bx + 16.0, by2 + 54.0), "goals  %s  ·  %s  ·  %s" % [
			commafy(goal_for(establish_venue, 0)), commafy(goal_for(establish_venue, 1)), commafy(goal_for(establish_venue, 2))],
			HORIZONTAL_ALIGNMENT_LEFT, -1, 19, Color(1.0, 0.88, 0.5, tagA))
		if has_enc:
			var enc: Dictionary = ENCORES[encore]
			var ec := Color(1.0, 0.55, 0.4)
			draw_fit_string(font, Vector2(bx + 16.0, by2 + 82.0), "TONIGHT'S CHALLENGE:  %s" % String(enc["name"]).to_upper(), HORIZONTAL_ALIGNMENT_LEFT, bw - 32.0, 13, Color(ec.r, ec.g, ec.b, 0.95 * tagA))
			draw_wrap_fit(font, String(enc["desc"]), Rect2(bx + 16.0, by2 + 92.0, bw - 32.0, bh - 100.0), 11,
				Color(0.9, 0.82, 0.72, 0.85 * tagA))

	var pulse := 0.6 + 0.4 * sin(float(cine_tick) * 0.08)
	draw_string(font, Vector2(0, s.y - 34.0), "press any key to begin", HORIZONTAL_ALIGNMENT_CENTER, s.x, 18, Color(1.0, 0.9, 0.6, 0.5 + 0.5 * pulse))


# --- the victory screen: shown once the top stage is conquered ----------------

func draw_credits(font: Font, s: Vector2) -> void:
	var cx := s.x * 0.5
	# the royal backdrop shared with the menu
	draw_gradient_v(Rect2(0, 0, s.x, s.y), Color(0.10, 0.05, 0.07), Color(0.02, 0.015, 0.025), 24)
	draw_spotlight_cone(s, cx, 0.08)
	draw_dust(s, 26, Color(1.0, 0.85, 0.55))
	# the calm cascade keeps watch up high while the roll climbs beneath it
	draw_menu_cascade(Vector2(cx, s.y * 0.12), 0.8)

	# assemble the roll as a stack of rows in content space. Each row sits a fixed
	# gap below the one before it, and cine_tick scrolls the whole stack upward. It
	# opens on the win, then rolls the credits and a line of your own career.
	var gold := Color(1.0, 0.88, 0.5)
	var rows: Array[Dictionary] = []
	var cur := 0.0
	cur += 40.0;  rows.append({"y": cur, "kind": "title", "a": GAME_TITLE, "b": ""})
	cur += 84.0;  rows.append({"y": cur, "kind": "win", "a": "WORLD'S GREATEST JUGGLER", "b": ""})
	cur += 44.0;  rows.append({"y": cur, "kind": "sub", "a": "every stage, conquered", "b": ""})
	cur += 60.0;  rows.append({"y": cur, "kind": "orn", "a": "", "b": ""})
	cur += 78.0;  rows.append({"y": cur, "kind": "line", "a": "best score   %s" % score_text(float(career["best_score"])), "b": "%d day%s on the road" % [day, "" if day == 1 else "s"]})
	cur += 90.0;  rows.append({"y": cur, "kind": "orn", "a": "", "b": ""})
	cur += 82.0;  rows.append({"y": cur, "kind": "role", "a": "design", "b": "Louis Vandenbruwaene"})
	cur += 66.0;  rows.append({"y": cur, "kind": "role", "a": "code", "b": "Louis Vandenbruwaene"})
	cur += 66.0;  rows.append({"y": cur, "kind": "role", "a": "art", "b": "Louis Vandenbruwaene"})
	cur += 66.0;  rows.append({"y": cur, "kind": "role", "a": "music", "b": "Louis Vandenbruwaene"})
	cur += 84.0;  rows.append({"y": cur, "kind": "orn", "a": "", "b": ""})
	cur += 84.0;  rows.append({"y": cur, "kind": "line", "a": "made in Godot, every picture and sound", "b": "drawn and synthesised in code"})
	cur += 90.0;  rows.append({"y": cur, "kind": "line", "a": "built with the help of Claude", "b": ""})
	cur += 118.0; rows.append({"y": cur, "kind": "thanks", "a": "thank you for playing", "b": ""})
	var last_y := cur

	# the scroll: slow enough that the whole roll takes about 100 seconds. cine_tick
	# runs at 120/s (not 60 - this was tuned against the wrong rate once already,
	# which halved the intended read time to ~50s), so speed is px per 1/120s tick
	var speed := 0.10
	var scroll := float(cine_tick) * speed
	var base := s.y * 0.56   # where content y 0 rests before any scrolling

	for row in rows:
		var ry := base + float(row["y"]) - scroll
		if ry < -80.0 or ry > s.y + 80.0:
			continue   # off the top or bottom, nothing to draw
		# soft edge fades so a line melts in near the bottom and out near the top,
		# which also keeps text clear of the cascade riding above
		var a := 1.0
		if ry > s.y - 190.0:
			# fully faded by 40px ABOVE the bottom edge, so a line entering the roll is
			# never still visible where the gold frame crosses it
			a = clampf((s.y - 40.0 - ry) / 150.0, 0.0, 1.0)
		if ry < 150.0:
			a = minf(a, clampf(ry / 150.0, 0.0, 1.0))
		var kind := String(row["kind"])
		var atxt := String(row["a"])
		var btxt := String(row["b"])
		match kind:
			"title":
				draw_wordmark(ry - 78.0, 52, Color(gold.r, gold.g, gold.b, a), s)
			"sub":
				draw_string(font, Vector2(0, ry), atxt, HORIZONTAL_ALIGNMENT_CENTER, s.x, 24, Color(0.9, 0.8, 0.68, a))
			"orn":
				draw_ornament(cx, ry, 150.0, Color(0.82, 0.62, 0.34, 0.8 * a))
			"role":
				draw_string(font, Vector2(0, ry - 8.0), atxt, HORIZONTAL_ALIGNMENT_CENTER, s.x, 17, Color(0.82, 0.7, 0.52, 0.85 * a))
				draw_string(font, Vector2(0, ry + 22.0), btxt, HORIZONTAL_ALIGNMENT_CENTER, s.x, 27, Color(gold.r, gold.g, gold.b, a))
			"line":
				draw_string(font, Vector2(0, ry), atxt, HORIZONTAL_ALIGNMENT_CENTER, s.x, 21, Color(0.92, 0.86, 0.76, a))
				if btxt != "":
					draw_string(font, Vector2(0, ry + 28.0), btxt, HORIZONTAL_ALIGNMENT_CENTER, s.x, 21, Color(0.92, 0.86, 0.76, a))
			"win":
				draw_string(font, Vector2(0, ry), atxt, HORIZONTAL_ALIGNMENT_CENTER, s.x, 30, Color(1.0, 0.86, 0.42, a))
			"thanks":
				draw_string(font, Vector2(0, ry), atxt, HORIZONTAL_ALIGNMENT_CENTER, s.x, 30, Color(1.0, 0.9, 0.6, a))

	# once the last line has climbed past centre the roll settles into a held final
	# title card, which waits, unmoving, for any key. The scrolling text is above it
	# by then, so the two never overlap.
	var last_sy := base + last_y - scroll
	if last_sy < s.y * 0.30:
		var fa := clampf((s.y * 0.30 - last_sy) / 140.0, 0.0, 1.0)
		var fy := s.y * 0.42
		draw_wordmark(fy - 96.0, 58, Color(1.0, 0.9, 0.55, fa), s)
		draw_ornament(cx, fy + 44.0, 175.0, Color(0.82, 0.62, 0.34, 0.85 * fa))
		draw_string(font, Vector2(0, fy + 86.0), "press any key", HORIZONTAL_ALIGNMENT_CENTER, s.x, 15, Color(0.82, 0.72, 0.6, 0.65 * fa))

	draw_vignette(s, 0.55)
	draw_frame(s, 22.0, Color(0.82, 0.62, 0.34, 0.5))


#endregion

#region SHARED VISUAL HELPERS
# --- shared premium-look helpers ---------------------------------------------

func draw_gradient_v(r: Rect2, top: Color, bot: Color, steps: int = 22) -> void:
	# a vertical gradient, drawn as stacked strips (no shaders, per the art rule).
	# Strips TILE exactly (each one's bottom is the next one's top) rather than
	# overlapping: an overlap doubled the alpha of semi-transparent gradients at
	# every seam, which showed as dark horizontal lines (e.g. over the menu balls).
	var n := maxi(1, steps)
	for i in n:
		var f := float(i) / float(n)
		var y0 := r.position.y + r.size.y * float(i) / float(n)
		var y1 := r.position.y + r.size.y * float(i + 1) / float(n)
		draw_rect(Rect2(r.position.x, y0, r.size.x, y1 - y0), top.lerp(bot, f))


func draw_gradient_h(r: Rect2, left: Color, right: Color, steps: int = 22) -> void:
	# strips TILE exactly (each one's right edge is the next one's left), like
	# draw_gradient_v. The old version overlapped strips by 1px, which doubled the
	# alpha of a semi-transparent gradient at every seam and showed as faint vertical
	# lines (visible in the vignette bands over the sky). Exact tiling removes them.
	var n := maxi(1, steps)
	for i in n:
		var f := float(i) / float(n)
		var x0 := r.position.x + r.size.x * float(i) / float(n)
		var x1 := r.position.x + r.size.x * float(i + 1) / float(n)
		draw_rect(Rect2(x0, r.position.y, x1 - x0, r.size.y), left.lerp(right, f))


func draw_vignette(s: Vector2, strength: float = 0.55) -> void:
	# darken the four edges so the eye is pulled to the lit centre. This one cheap
	# trick is most of what makes a flat scene read as photographed and rich.
	var band := 170.0
	var dk := Color(0.02, 0.008, 0.02, strength)
	var clear := Color(0.02, 0.008, 0.02, 0.0)
	draw_gradient_v(Rect2(0, 0, s.x, band), dk, clear, 18)
	draw_gradient_v(Rect2(0, s.y - band, s.x, band), clear, dk, 18)
	draw_gradient_h(Rect2(0, 0, band, s.y), dk, clear, 18)
	draw_gradient_h(Rect2(s.x - band, 0, band, s.y), clear, dk, 18)


func draw_frame(s: Vector2, inset: float, col: Color) -> void:
	# a royal double gold border with small corner ticks
	var r := Rect2(inset, inset, s.x - 2.0 * inset, s.y - 2.0 * inset)
	draw_rect(r, col, false, 2.0)
	var r2 := r.grow(-6.0)
	draw_rect(r2, Color(col.r, col.g, col.b, col.a * 0.5), false, 1.0)
	var t := 16.0
	for c in [r.position, Vector2(r.end.x, r.position.y), Vector2(r.position.x, r.end.y), r.end]:
		var sx := 1.0 if c.x < s.x * 0.5 else -1.0
		var sy := 1.0 if c.y < s.y * 0.5 else -1.0
		draw_line(c, c + Vector2(sx * t, 0), col, 3.0)
		draw_line(c, c + Vector2(0, sy * t), col, 3.0)


func draw_ornament(cx: float, y: float, half_w: float, col: Color) -> void:
	# a thin rule with a centre diamond and end dots, a classic decorative flourish
	draw_line(Vector2(cx - half_w, y), Vector2(cx - 10.0, y), col, 2.0)
	draw_line(Vector2(cx + 10.0, y), Vector2(cx + half_w, y), col, 2.0)
	draw_colored_polygon(PackedVector2Array([
		Vector2(cx, y - 5.0), Vector2(cx + 6.0, y), Vector2(cx, y + 5.0), Vector2(cx - 6.0, y)]), col)
	draw_circle(Vector2(cx - half_w, y), 2.5, col)
	draw_circle(Vector2(cx + half_w, y), 2.5, col)


func draw_title_glow(font: Font, y: float, text: String, size: int, col: Color, s: Vector2) -> void:
	draw_string(font, Vector2(2, y + 2.0 + float(size)), text, HORIZONTAL_ALIGNMENT_CENTER, s.x, size, Color(0, 0, 0, 0.55))
	draw_string(font, Vector2(0, y + float(size)), text, HORIZONTAL_ALIGNMENT_CENTER, s.x, size, col)


# THE WORDMARK IS THE PICTURE, EVERYWHERE (2026-07-28, Louis: "the tossa logo on the
# welcome screen should use the same logo to depict tossa as the picture you made
# before"). There used to be two marks doing the same job and drifting apart: the store
# capsules spelled TOSSA entirely in props - two knives for the T, a ring for the O, lines
# of balls for the S's, two burning torches for the A - while the title screen, the key
# art and the credits still drew the WORD in the UI font with a single ball standing in
# for the final letter. A game has one logo. This is it, at whatever size the caller asks.
#
# `size` is the LETTER height, not the picture's - see MARK_RISE / MARK_DROP for how far
# the flames and handles reach past it, and `mark_height()` for the total. Callers place
# whatever sits underneath off that number rather than off a guess.
func draw_wordmark(y: float, size: int, col: Color, s: Vector2) -> void:
	# `y` is the top of the picture, the same convention the text mark used, so the
	# baseline sits MARK_RISE letter-heights down from it
	capsule_mark(s, y + float(size) * MARK_RISE - float(size) * 0.5, float(size), col.a)


func draw_dust(s: Vector2, n: int, glow: Color) -> void:
	# warm motes drifting up through the light, a subtle atmosphere layer
	for i in n:
		var seed := float(i) * 41.3
		var bx := fposmod(sin(seed) * 43758.5, 1.0)
		var speed := 0.15 + fposmod(cos(seed) * 12.9, 1.0) * 0.25
		var by := fposmod(0.9 - atick() * 0.0008 * speed - float(i) * 0.13, 1.0)
		var px := bx * s.x + sin(atick() * 0.01 + seed) * 12.0
		var py := by * s.y
		var a := 0.10 + 0.10 * sin(atick() * 0.03 + seed)
		draw_rect(Rect2(px - 1.4, py - 1.4, 2.8, 2.8), Color(glow.r, glow.g, glow.b, maxf(0.0, a)))


#endregion

#region PARTICLE EFFECTS & POPUPS
func spawn_egg_break(at: Vector2) -> void:
	var floor_y := get_viewport_rect().size.y * 0.80
	for i in 8:
		var ang := randf_range(-PI, 0.0)   # shell flies upward and out
		var spd := randf_range(2.2, 5.2)
		shards.append({
			"pos": at + Vector2(randf_range(-4, 4), randf_range(-4, 4)),
			"vel": Vector2(cos(ang), sin(ang)) * spd,
			"ang": randf_range(0.0, TAU), "spin": randf_range(-0.4, 0.4),
			"born": tick, "floor": floor_y + randf_range(-4, 6)})
	splats.append({"pos": Vector2(at.x + randf_range(-8, 8), floor_y + randf_range(-2, 4)),
		"r": 3.0, "born": tick})


# --- the cosmetic particle layer: sparks, embers, confetti, shock rings --------
# Spawned on catches, drops, records and torches; stepped here, never in the sim,
# and drawn late so the juice sits over the stage. All positions use the global
# randf (cosmetic RNG), so the deterministic sim rng is never consumed.

func spawn_parts(at: Vector2, col: Color, n: int, spd: float, kind: String = "spark") -> void:
	if reduce_motion:
		n = maxi(1, n / 2)   # accessibility: thinner bursts, but a ring/marker still shows
	for _i in n:
		var ang := randf_range(-PI, PI) if kind != "confetti" else randf_range(-PI * 0.8, -PI * 0.2)
		var v := Vector2(cos(ang), sin(ang)) * randf_range(spd * 0.4, spd)
		if kind == "spark":
			v.y -= spd * 0.5   # sparks kick upward off the impact
		var life := 34
		if kind == "confetti":
			life = 90
		elif kind == "ring":
			life = 18   # a quick pulse; a lingering circle reads as clutter
		parts.append({"kind": kind, "pos": at + Vector2(randf_range(-3, 3), randf_range(-3, 3)),
			"vel": v, "col": col, "born": tick, "life": life,
			"seed": randf() * TAU, "r": randf_range(1.6, 3.0)})


func step_parts() -> void:
	if parts.is_empty():
		return
	var keep: Array[Dictionary] = []
	for d in parts:
		var v: Vector2 = d["vel"]
		match String(d["kind"]):
			"spark":
				v.y += 0.16
				v *= 0.96
			"ember":
				v.y -= 0.05   # embers drift up off the flame
				v.x += sin(float(tick) * 0.2 + float(d["seed"])) * 0.05
				v *= 0.98
			"confetti":
				v.y = minf(v.y + 0.10, 1.4)   # flutter down, swaying
				v.x = sin(float(tick) * 0.11 + float(d["seed"])) * 1.1
			"ring":
				pass
		d["vel"] = v
		d["pos"] = Vector2(d["pos"]) + v
		if tick - int(d["born"]) < int(d["life"]):
			keep.append(d)
	parts = keep


func draw_parts() -> void:
	for d in parts:
		var age := tick - int(d["born"])
		var f := clampf(1.0 - float(age) / float(int(d["life"])), 0.0, 1.0)
		var p: Vector2 = d["pos"]
		var c: Color = d["col"]
		match String(d["kind"]):
			"ring":
				# an expanding shockwave stroke that thins as it grows
				var rr := 14.0 + float(age) * 2.6
				draw_arc(p, rr, 0.0, TAU, 40, Color(c.r, c.g, c.b, 0.5 * f), maxf(1.0, 3.5 * f), true)
			"confetti":
				var ang := float(d["seed"]) + float(age) * 0.12
				draw_set_transform(p, ang, Vector2.ONE)
				draw_rect(Rect2(-3.0, -1.6, 6.0, 3.2), Color(c.r, c.g, c.b, 0.9 * f))
				draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
			"ember":
				draw_circle(p, float(d["r"]) * (0.6 + 0.4 * f), Color(c.r, c.g, c.b, 0.7 * f))
			_:
				draw_circle(p, float(d["r"]) * f + 0.6, Color(c.r, c.g, c.b, 0.9 * f))


func ovation_step() -> void:
	# the beat between the last catch and the results card, when the night was perfect.
	if ovation_left <= 0:
		return
	ovation_left -= 1
	applause = 1.0                    # held up, so the gauge reads what the room is doing
	if ovation_left % OVATION_RAIN_BEAT == 0:
		for _i in 1 + int(round(2.0 * venue_generosity())):
			rain_flower()
	if ovation_left == 0:
		# the card's own count-up starts NOW, not back when the act resolved, or it would
		# have run its whole animation behind the ovation and appeared already finished
		results_tick = tick
		results_stamped = false
		if _demo_quit_after_ovation:
			get_tree().quit()


func rain_flower() -> void:
	# IT COMES DOWN, it is not thrown up. throw_from_crowd arcs a flower out of a seat,
	# which is the right picture for one person's tribute during the act; an ovation is
	# the entire room at once and reads as WEATHER. Different spawn, same `thrown` list,
	# so the pile, the batched drawing and the fade all work on it unchanged.
	var s := get_viewport_rect().size
	var fy := stage_floor_y()
	var x := randf_range(s.x * 0.08, s.x * 0.92)
	var v := venue_generosity()
	var tier := 0
	if randf() < 0.42 + 0.30 * v:
		tier = 1
	if randf() < 0.08 + 0.20 * v:
		tier = FLOWER_BOUQUET if randf() < 0.45 else 2
	var near := 0
	for d in thrown:
		if absf(float((d["to"] as Vector2).x) - x) < 20.0:
			near += 1
	thrown.append({"kind": "flower", "tier": tier,
		"from": Vector2(x + randf_range(-30.0, 30.0), -40.0),
		"to": Vector2(x, fy - FLOWER_STEM_FLAT - randf_range(0.0, 6.0) - minf(float(near) * 1.5, 8.0)),
		"born": tick, "land": tick + FLOWER_FLIGHT - 8 + randi_range(-10, 10),
		"arc": randf_range(-14.0, 14.0),   # falling, so barely an arc at all
		"rot": randf_range(0.0, TAU), "settle": randf_range(-0.42, 0.42)})
	_pile_dirty = true


func step_effects() -> void:
	step_parts()
	throw_step()    # what the room throws, on its own beat
	tomato_step()   # ...and what bursts on him when it gets there
	ovation_step()  # ...and the rain, when the night was perfect
	# lit torches shed a lazy ember now and then, so fire reads as fire
	if tick % 9 == 0:
		for b in balls:
			if b.kind == PROP_TORCHES and b.state == STATE_FLIGHT:
				spawn_parts(flight_pos(b) + Vector2(0, -10), Color(1.0, 0.6, 0.2), 1, 0.7, "ember")
	var keep_sh: Array[Dictionary] = []
	for d in shards:
		var v: Vector2 = d["vel"]
		v.y += 0.28   # gravity
		v *= 0.995
		var p: Vector2 = d["pos"] + v
		if p.y >= float(d["floor"]):
			p.y = float(d["floor"])
			v = Vector2(v.x * 0.4, -v.y * 0.25)   # a small bounce, then settle
			if absf(v.y) < 0.6:
				v.y = 0.0
		d["pos"] = p
		d["vel"] = v
		# A SHELL CHIP THAT HAS SETTLED STOPS TURNING (2026-07-27). Exactly the bug the
		# thrown flowers had, and faster: `spin` runs to 0.4 rad per tick, so a shard
		# that had come to rest on the boards sat there revolving seven times a second
		# for the rest of its 150-tick life. The falling props already get this right by
		# skipping their whole update once at rest - this is the same question asked in
		# the one place a shard can answer it.
		if v.length_squared() > 0.01:
			d["ang"] = float(d["ang"]) + float(d["spin"])
		if tick - int(d["born"]) < 150:
			keep_sh.append(d)
	shards = keep_sh
	var keep_sp: Array[Dictionary] = []
	for d in splats:
		d["r"] = minf(float(d["r"]) + 0.9, 16.0)   # the yolk spreads then holds
		if tick - int(d["born"]) < 260:
			keep_sp.append(d)
	splats = keep_sp
	# dropped props falling to the stage floor: eggs break on LANDING, everything
	# else bounces once, rests a moment, then fades away
	var floor_y := get_viewport_rect().size.y * 0.80
	var keep_f: Array[Dictionary] = []
	for d in falling:
		if int(d["rest"]) >= 0:
			if tick - int(d["rest"]) < FALLEN_LINGER:
				keep_f.append(d)
			continue
		var v: Vector2 = d["vel"]
		v.y += 0.28
		var p: Vector2 = d["pos"] + v
		d["ang"] = float(d["ang"]) + float(d["spin"])
		if p.y >= floor_y:
			if int(d["kind"]) == PROP_EGGS:
				spawn_egg_break(Vector2(p.x, floor_y))
				play_sfx("splat", -8.0)
				add_popup(Vector2(p.x, floor_y - 14.0), "SPLAT", Color(1.0, 0.32, 0.3))
				continue   # the egg is shards and yolk now
			if not bool(d["bounced"]):
				d["bounced"] = true
				p.y = floor_y
				v = Vector2(v.x * 0.5, -absf(v.y) * 0.35)
				play_sfx(_catch_sound(int(d["kind"])), -22.0, 0.6)   # a dull floor knock
			else:
				p.y = floor_y
				v = Vector2.ZERO
				d["rest"] = tick
		d["pos"] = p
		d["vel"] = v
		keep_f.append(d)
	falling = keep_f


#region WHAT THE ROOM THROWS (flowers and tomatoes)
func coin_word() -> String:
	# WHAT THE CURRENCY IS CALLED, everywhere it is written. It is one function and not
	# a literal because the name has changed once already (it was "gold" until the crowd
	# started paying in flowers) and six player-facing strings were found still saying
	# the old word next to a purse reading the new one. `money` is one variable; only
	# its name is content. Never type the word - ask here.
	return "flowers"


func draw_coin_mark(c: Vector2, r: float, col: Color, turning: bool = false) -> void:
	# the currency's own MARK, used by the purse readouts and the hub's ledger card:
	# a coin in the gold economy, a flower in the flower one, so the two never disagree
	# about what the number in front of them means
	# `turning` is opt-in, and deliberately so (2026-07-27, Louis: "the flowers
	# shouldn't turn when on stage, perhaps the icon could tho: in the store").
	# A flower lying on the boards is an OBJECT at rest and must be still; the same
	# mark used as a UI icon is a symbol, and a slow drift there just keeps the
	# screen alive. Phased off its own x so a shelf of price plates drifts
	# organically instead of turning in lockstep like a row of gears.
	var rot := -PI * 0.5
	if turning:
		rot += atick() * 0.006 + c.x * 0.02
	draw_flower(c, 0, r / 5.0, rot, col.a)


func stage_floor_y() -> float:
	return get_viewport_rect().size.y * 0.80   # the boards, where thrown things land


func flower_pressure() -> float:
	# HOW HARD THE ROOM IS THROWING, 0 upward, off the crowd meter alone (2026-07-27,
	# Louis: "only throws flowers consistently when you are in the green. In the orange
	# you shouldn't get much"). The curve below the green line is SQUARED, not
	# proportional: a room that is merely not-leaving does not throw flowers, it waits
	# to see whether you are any good. In the orange that works out to a stem or two a
	# minute; in the green it is a steady shower, and a full house is better still.
	if applause < FLOWER_FLOOR:
		return 0.0
	if applause >= FLOWER_GREEN:
		return 1.0 + 0.6 * clampf((applause - FLOWER_GREEN) / (1.0 - FLOWER_GREEN), 0.0, 1.0)
	var f := (applause - FLOWER_FLOOR) / (FLOWER_GREEN - FLOWER_FLOOR)
	return f * f * 0.5


func flower_fame() -> float:
	# ...and WHO IS THROWING IT. A performer people have heard of gets showered; an
	# unknown one gets polite applause and a few stems, however well the night goes.
	# Capped like every other Reputation effect, so a long career cannot turn the stage
	# into a florist's - the crowd meter has to stay the thing that matters most.
	return clampf(0.45 + float(reputation) / FLOWER_FAME_DIV, 0.45, FLOWER_FAME_CAP)


func venue_generosity() -> float:
	# 0 at the Backyard, 1 at the last stage: how much room this house has for a tribute
	# that costs money. Used by the flower ladder and by the ovation's rain.
	return clampf(float(run_venue) / float(maxi(MAX_VENUE, 1)), 0.0, 1.0)


func flower_tier_roll() -> int:
	# WHICH flower. Two things decide it and they MULTIPLY rather than replace each other.
	# How well you are playing still gates the top of the ladder exactly as it did - a
	# posy needs a room already won over, and the rarest tiers need one won over with
	# nothing dropped all night, so the colour of the pile goes on saying something its
	# size cannot. What is new is that the size of the ROOM raises the floor and widens
	# the odds (see FLOWER_ROOM_LIFT): the same act pays in single stems at the Backyard
	# and in bouquets at the World Arena.
	var v := venue_generosity()
	# THE TOP HAT is a showman's hat and the room answers it: every tier's odds widen,
	# which reads as posies where there were single stems rather than as a bigger number
	if wearing("hat"):
		v = clampf(v + HAT_TIER_LIFT, 0.0, 1.0)
	if dropped == 0 and applause > 0.94:
		if v >= 0.5 and randf() < 0.04 + 0.09 * v:
			return FLOWER_BOUQUET          # only a big house sends a bouquet up
		if randf() < 0.06 + 0.06 * v:
			return 2
	if dropped <= 1 and applause > 0.84 and randf() < 0.13 + 0.20 * v:
		return 1
	# ...and the floor: past the middle stages a "plain" stem is often already a posy,
	# which is what stops a big room's pile looking like a small room's
	if randf() < FLOWER_ROOM_LIFT * v * v:
		return 1
	return 0


func throw_from_crowd(kind: String, tier: int, side: float = 0.0) -> void:
	# one flower (or tomato) leaves a seat and arcs down to the boards near the feet.
	# It comes from a random point along the crowd line and lands in a loose scatter
	# around the juggler, so a heavy shower reads as a shower and not as a stack.
	#
	# `side` PINS WHICH WING IT COMES FROM (-1 left, +1 right, 0 anywhere), which the goal
	# salute uses. Two stems arriving together from opposite wings reads as a GESTURE; the same
	# two thrown from random seats read as one more gust of the ordinary drift, and the moment
	# is lost. It is a parameter rather than a second function because everything else about
	# the throw - the arc, the landing scatter, the pile - is identical.
	var s := get_viewport_rect().size
	var fy := stage_floor_y()
	var fx := randf_range(s.x * 0.05, s.x * 0.95)
	if side < 0.0:
		fx = randf_range(s.x * 0.06, s.x * 0.22)
	elif side > 0.0:
		fx = randf_range(s.x * 0.78, s.x * 0.94)
	var from := Vector2(fx, fy + randf_range(16.0, 46.0))
	# A TOMATO IS AIMED (2026-07-27, Louis: "make sure they are towards his body and
	# visible stains"). Flowers are TRIBUTE and are tossed at the feet; a tomato is an
	# ATTACK and goes at the man. It therefore takes the torso as its target - the same
	# eight-head landmarks draw_juggler uses, so it lands between hip and shoulder - on a
	# flatter, faster arc, because nobody lobs a tomato. It bursts on arrival rather than
	# joining the pile (see tomato_step): the point of it is that the room hit him.
	if kind == "tomato":
		var H := s.y * 0.056
		thrown.append({"kind": kind, "tier": tier, "from": from,
			"to": Vector2(s.x * 0.5 + randf_range(-0.85, 0.85) * H, fy - randf_range(4.2, 6.7) * H),
			"born": tick, "land": tick + FLOWER_FLIGHT - 12 + randi_range(-4, 4),
			"arc": randf_range(30.0, 70.0), "rot": randf_range(0.0, TAU),
			"settle": randf_range(0.0, TAU)})
		_pile_dirty = true
		return
	var lx := s.x * 0.5 + randf_range(-165.0, 165.0)
	# HOW A THROWN FLOWER COMES TO REST (2026-07-27, Louis: "blossom facing the player
	# and the stem facing the public"). The crowd is drawn BELOW the floor line
	# (draw_crowd's `fy + 14 + r*21`), so the public is down-screen and the juggler is
	# up-screen - and a thrown flower lands heavy end first, blossom leading, with the
	# stem trailing back toward whoever threw it. In draw_flower the stem runs along
	# `rot + PI/2`, so rot = 0 puts it at (0, +1): straight down-screen at the public,
	# blossom up toward the performer. A little spread either side of 0 so a pile is not
	# a row of identical stamps, but never enough to turn one around.
	var settle := randf_range(-0.42, 0.42)
	# ...and it LIES on the boards rather than standing in them. A stem pointing at the
	# audience is pointing nearly at the camera, so it foreshortens to about half what
	# the same flower shows side-on in the air (FLOWER_STEM_FLAT against
	# FLOWER_STEM_AIR) - drawn at full length it read as a flower GROWING out of the
	# stage. The blossom then sits just that shortened stem clear of the floor line, so
	# the stem reaches down to the boards instead of through them into the crowd.
	var ly := fy - FLOWER_STEM_FLAT - randf_range(0.0, 6.0)
	# A PILE, not a plane: each flower already lying near this spot lifts the next one a
	# little, so a heavy shower builds a shallow heap instead of everything sharing one
	# line. Capped, or a long green night would stack a tower up the backdrop.
	var near := 0
	for d in thrown:
		if absf(float((d["to"] as Vector2).x) - lx) < 20.0:
			near += 1
	var to := Vector2(lx, ly - minf(float(near) * 1.5, 8.0))
	thrown.append({"kind": kind, "tier": tier, "from": from, "to": to,
		"born": tick, "land": tick + FLOWER_FLIGHT + randi_range(-6, 6),
		"arc": randf_range(90.0, 190.0), "rot": randf_range(0.0, TAU),
		"settle": settle})
	_pile_dirty = true   # a new entry shifts every landed flower's index, so its fade too


func throw_step() -> void:
	# THE ROOM'S OWN BEAT. Every FLOWER_BEAT ticks the people who can reach the stage
	# each get one chance to throw something, and what they throw is decided entirely by
	# how the act is going: deep in the green it is flowers, down in the red it is
	# tomatoes, and in the wide middle the room just watches.
	if mode != MODE_PERFORM or not running or tut_active:
		return
	if tick % FLOWER_BEAT != 0:
		return
	var vi := clampi(run_venue, 0, FLOWER_THROWERS.size() - 1)
	var rolls := int(FLOWER_THROWERS[vi])
	# ...and the SEQUIN WAISTCOAT is the late-game money piece: the room throws OFTENER,
	# which compounds with everything already raising the rate rather than replacing it
	var p := clampf(FLOWER_P * flower_pressure() * flower_fame() * (VEST_RATE if wearing("vest") else 1.0), 0.0, 0.85)
	if p > 0.0:
		for _i in rolls:
			if randf() < p:
				var t := flower_tier_roll()
				throw_from_crowd("flower", t)
				run_flowers += int(FLOWER_TIERS[t]["val"])
	elif applause <= TOMATO_RED and not collapsing:
		# the room turning on you. Still rarer than flowers by design - this is a warning
		# you can still act on, not a punishment stacked on top of losing the crowd - but
		# it has to actually HAPPEN to be a warning (2026-07-27, Louis: "i didn't see
		# tomatoes thrown at the player when he does bad"). The old window was applause
		# <= 0.22, which is a sliver of the red, usually crossed on the way to a collapse
		# that suppresses them anyway; 0.30 is the whole red band and still cannot
		# overlap the flowers, which need FLOWER_FLOOR (0.34).
		for _i in rolls:
			if randf() < 0.15:
				throw_from_crowd("tomato", 0)
				run_tomatoes += 1
	while thrown.size() > FLOWER_PILE_MAX:
		thrown.remove_at(0)
		_pile_dirty = true   # the oldest left the boards; the bake still has it


func draw_flower(p: Vector2, tier: int, sc: float, rot: float, a: float, stem: float = 0.0) -> void:
	# a flower drawn as a flower: petals round a lit centre, on the same "draw the
	# object" rule the money hat and the coin follow. The petal COUNT and colour carry
	# the tier, so a pile can be read at a glance without a single number on screen.
	# `stem` (2026-07-27, Louis) hangs a green stem and a leaf off it, in the direction
	# the flower is lying - a cut flower without one reads as a badge, and a pile of
	# badges does not read as a bouquet on the boards.
	if stem > 0.0:
		var dir := Vector2(cos(rot + PI * 0.5), sin(rot + PI * 0.5))
		var tip := p + dir * stem * sc
		draw_line(p, tip, Color(0.30, 0.56, 0.28, a), maxf(1.0, 1.6 * sc))
		var mid := p.lerp(tip, 0.55)
		var side := Vector2(-dir.y, dir.x)
		var lv := PackedVector2Array()
		for k in 9:
			var t := TAU * float(k) / 8.0
			lv.append(mid + side * 3.4 * sc + Vector2(cos(t) * 3.6 * sc, sin(t) * 1.6 * sc).rotated(dir.angle()))
		draw_colored_polygon(lv, Color(0.34, 0.60, 0.30, a))
	if tier == FLOWER_BOUQUET:
		# A BOUQUET IS SEVERAL FLOWERS, never one big one. Three blooms round a single
		# binding point with the florist's paper behind them: that is the read that says
		# "somebody bought this on the way in", and a scaled-up single flower cannot say
		# it at any size. Each bloom recurses at a lower tier, so they are real flowers
		# with real petals rather than a decorative cluster that would drift out of step
		# with draw_flower the first time the petal shape changes.
		var br := float(FLOWER_TIERS[FLOWER_BOUQUET]["r"]) * sc
		draw_colored_polygon(PackedVector2Array([
			p + Vector2(cos(rot + 2.30), sin(rot + 2.30)) * br * 1.30,
			p + Vector2(cos(rot + 0.30), sin(rot + 0.30)) * br * 1.30,
			p - Vector2(cos(rot + 1.30), sin(rot + 1.30)) * br * 0.45]),
			Color(0.95, 0.91, 0.82, a * 0.42))
		var spread: Array[float] = [-0.90, 0.0, 0.90]
		var btier: Array[int] = [1, 2, 1]
		for k in 3:
			var ba := rot + spread[k]
			draw_flower(p + Vector2(cos(ba), sin(ba)) * br * 0.52, btier[k], sc * 0.58, ba, a)
		return
	var td: Dictionary = FLOWER_TIERS[clampi(tier, 0, FLOWER_TIERS.size() - 1)]
	var col: Color = td["col"]
	var mid: Color = td["mid"]
	var n := int(td["petals"])
	var r := float(td["r"]) * sc
	for i in n:
		var ang := rot + TAU * float(i) / float(n)
		var pc := Vector2(cos(ang), sin(ang)) * r * 0.72
		# each petal an ellipse pointing outward - two circles would read as a berry.
		# 0.72 out plus 0.52 long is FLOWER_REACH: change either and change that too,
		# or a layout placed clear of a flower stops being clear of it
		var pv := PackedVector2Array()
		for k in 9:
			var t := TAU * float(k) / 8.0
			pv.append(p + pc + Vector2(cos(t) * r * 0.52, sin(t) * r * 0.34).rotated(ang))
		draw_colored_polygon(pv, Color(col.r, col.g, col.b, a))
	draw_circle(p, r * 0.38, Color(mid.r, mid.g, mid.b, a))
	if tier == 2:
		draw_star4(p, r * 0.9, Color(1.0, 0.98, 0.85, 0.45 * a))   # a gold rose glints


func draw_tomato(p: Vector2, sc: float, rot: float, a: float) -> void:
	var r := 6.0 * sc
	fill_ellipse(p, r * 1.05, r * 0.92, Color(0.86, 0.18, 0.16, a))
	draw_circle(p + Vector2(-r * 0.32, -r * 0.34), r * 0.24, Color(1.0, 0.62, 0.54, 0.7 * a))
	# the calyx, a few short leaves off the top - what stops it reading as a red ball
	for i in 4:
		var ang := rot + TAU * float(i) / 4.0
		draw_line(p + Vector2(0, -r * 0.7), p + Vector2(0, -r * 0.7) + Vector2(cos(ang), sin(ang)) * r * 0.5,
			Color(0.35, 0.60, 0.28, a), maxf(1.0, r * 0.22))


# --- the triangle soup: many shapes, ONE draw call -----------------------------------
# Everything here appends into `_soup_*` and is flushed by _soup_emit. The shapes are
# the same ones draw_flower/draw_tomato paint; only the delivery changes, so a batched
# flower and a per-frame one are the same picture. Segment counts are lower than the
# immediate-mode originals because a landed flower is about 10px across, where a 6-sided
# petal and an 8-sided one are indistinguishable - and the bake loop is the cost here.
func _soup_clear() -> void:
	_soup_pts.clear()
	_soup_cols.clear()
	_soup_idx.clear()


func _soup_fan(c: Vector2, ring: PackedVector2Array, col: Color) -> void:
	# a filled shape as a triangle fan: centre, then the ring, then indices round it
	var base := _soup_pts.size()
	_soup_pts.append(c)
	_soup_cols.append(col)
	for q in ring:
		_soup_pts.append(q)
		_soup_cols.append(col)
	for k in ring.size() - 1:
		_soup_idx.append(base)
		_soup_idx.append(base + 1 + k)
		_soup_idx.append(base + 2 + k)


func _soup_ellipse(c: Vector2, rx: float, ry: float, rot: float, seg: int, col: Color) -> void:
	var ring := PackedVector2Array()
	for k in seg + 1:
		var t := TAU * float(k) / float(seg)
		ring.append(c + Vector2(cos(t) * rx, sin(t) * ry).rotated(rot))
	_soup_fan(c, ring, col)


func _soup_line(a: Vector2, b: Vector2, w: float, col: Color) -> void:
	# a thick line is a quad; two triangles, no cap (nothing here needs one)
	var d := b - a
	if d.length_squared() < 0.0001:
		return
	var n := Vector2(-d.y, d.x).normalized() * (w * 0.5)
	var base := _soup_pts.size()
	_soup_pts.append(a - n)
	_soup_pts.append(a + n)
	_soup_pts.append(b + n)
	_soup_pts.append(b - n)
	for _k in 4:
		_soup_cols.append(col)
	_soup_idx.append(base)
	_soup_idx.append(base + 1)
	_soup_idx.append(base + 2)
	_soup_idx.append(base)
	_soup_idx.append(base + 2)
	_soup_idx.append(base + 3)


func _soup_emit() -> void:
	if _soup_idx.is_empty():
		return
	RenderingServer.canvas_item_add_triangle_array(get_canvas_item(), _soup_idx, _soup_pts, _soup_cols)


func _soup_flower(p: Vector2, tier: int, sc: float, rot: float, a: float, stem: float) -> void:
	if stem > 0.0:
		var dir := Vector2(cos(rot + PI * 0.5), sin(rot + PI * 0.5))
		var tip := p + dir * stem * sc
		_soup_line(p, tip, maxf(1.0, 1.6 * sc), Color(0.30, 0.56, 0.28, a))
		var mid := p.lerp(tip, 0.55)
		var side := Vector2(-dir.y, dir.x)
		_soup_ellipse(mid + side * 3.4 * sc, 3.6 * sc, 1.6 * sc, dir.angle(), 6, Color(0.34, 0.60, 0.30, a))
	var td: Dictionary = FLOWER_TIERS[clampi(tier, 0, FLOWER_TIERS.size() - 1)]
	var col: Color = td["col"]
	var midc: Color = td["mid"]
	var n := int(td["petals"])
	var r := float(td["r"]) * sc
	for i in n:
		var ang := rot + TAU * float(i) / float(n)
		_soup_ellipse(p + Vector2(cos(ang), sin(ang)) * r * 0.72, r * 0.52, r * 0.34, ang, 6,
			Color(col.r, col.g, col.b, a))
	_soup_ellipse(p, r * 0.38, r * 0.38, 0.0, 6, Color(midc.r, midc.g, midc.b, a))
	if tier >= 2:
		var sr := r * 0.9
		var si := sr * 0.26
		_soup_fan(p, PackedVector2Array([
			p + Vector2(0.0, -sr), p + Vector2(si, -si), p + Vector2(sr, 0.0), p + Vector2(si, si),
			p + Vector2(0.0, sr), p + Vector2(-si, si), p + Vector2(-sr, 0.0), p + Vector2(-si, -si),
			p + Vector2(0.0, -sr)]), Color(1.0, 0.98, 0.85, 0.45 * a))


func _soup_tomato(p: Vector2, sc: float, rot: float, a: float) -> void:
	var r := 6.0 * sc
	_soup_ellipse(p, r * 1.05, r * 0.92, 0.0, 8, Color(0.86, 0.18, 0.16, a))
	_soup_ellipse(p + Vector2(-r * 0.32, -r * 0.34), r * 0.24, r * 0.24, 0.0, 6, Color(1.0, 0.62, 0.54, 0.7 * a))
	for i in 4:
		var ang := rot + TAU * float(i) / 4.0
		var b := p + Vector2(0, -r * 0.7)
		_soup_line(b, b + Vector2(cos(ang), sin(ang)) * r * 0.5, maxf(1.0, r * 0.22), Color(0.35, 0.60, 0.28, a))


func tomato_step() -> void:
	# A TOMATO BURSTS ON HIM. It never joins the pile at his feet - it was aimed at the
	# man, so it leaves the array the moment it arrives and leaves a mark behind instead.
	# Walked backwards so removing an entry cannot skip the next one.
	var i := thrown.size() - 1
	while i >= 0:
		var d: Dictionary = thrown[i]
		if String(d["kind"]) == "tomato" and tick >= int(d["land"]):
			var at: Vector2 = d["to"]
			var s := get_viewport_rect().size
			tomato_stains.append({
				"off": at - Vector2(s.x * 0.5, stage_floor_y()),   # kept relative to the
				"born": tick,                                       # body's own origin
				"seed": randf() * TAU, "r": randf_range(7.0, 11.5)})
			while tomato_stains.size() > TOMATO_STAIN_MAX:
				tomato_stains.remove_at(0)
			spawn_parts(at, Color(0.86, 0.20, 0.16), 6, 2.4, "spark")
			play_sfx("splat", -9.0)
			thrown.remove_at(i)
			_pile_dirty = true
		i -= 1


func draw_tomato_stains() -> void:
	# worn on the costume, drawn straight after the body so it sits ON him. One draw call
	# for the lot, through the same triangle soup the flower pile uses.
	if tomato_stains.is_empty():
		return
	var s := get_viewport_rect().size
	var origin := Vector2(s.x * 0.5, stage_floor_y())
	_soup_clear()
	for d in tomato_stains:
		var age := float(tick - int(d["born"]))
		var a := clampf(1.0 - age / TOMATO_STAIN_FADE, 0.0, 1.0)
		if a <= 0.01:
			continue
		var p := origin + (d["off"] as Vector2)
		var r: float = d["r"]
		var sd: float = d["seed"]
		# the burst: a dark body, a wetter highlight up-left, satellite specks around it,
		# and a run of juice that creeps downward over the first second. Everything is
		# derived from the stain's own stored seed - never randf, which in a draw
		# function would reshape the splatter every single frame.
		_soup_ellipse(p, r, r * 0.80, 0.0, 9, Color(0.62, 0.10, 0.09, 0.88 * a))
		_soup_ellipse(p + Vector2(-r * 0.18, -r * 0.16), r * 0.58, r * 0.44, 0.0, 8, Color(0.86, 0.20, 0.17, 0.9 * a))
		for k in 6:
			var ang := sd + TAU * float(k) / 6.0 + fposmod(sd * float(k + 2), 0.7)
			var rr := r * (1.05 + 0.75 * fposmod(sd * float(k + 3), 1.0))
			var sr := r * (0.10 + 0.16 * fposmod(sd * float(k + 7), 1.0))
			_soup_ellipse(p + Vector2(cos(ang), sin(ang)) * rr, sr, sr, 0.0, 6,
				Color(0.74, 0.14, 0.12, 0.8 * a))
		var run := r * (0.7 + 1.7 * fposmod(sd, 1.0)) * clampf(age / 55.0, 0.0, 1.0)
		if run > 1.0:
			_soup_line(p, p + Vector2(0.0, run), maxf(1.6, r * 0.26), Color(0.58, 0.09, 0.08, 0.7 * a))
			_soup_ellipse(p + Vector2(0.0, run), r * 0.17, r * 0.20, 0.0, 6, Color(0.58, 0.09, 0.08, 0.7 * a))
	_soup_emit()


func _bake_pile() -> void:
	# every flower that had landed as of this tick, as one indexed triangle soup
	_soup_clear()
	var last := maxi(1, thrown.size() - 1)
	for i in thrown.size():
		var d: Dictionary = thrown[i]
		if int(d["land"]) > tick:
			continue
		var a := clampf(0.35 + 0.65 * float(i) / float(last), 0.35, 1.0)
		if String(d["kind"]) == "tomato":
			_soup_tomato(d["to"], 1.0, float(d["settle"]), a)
		else:
			_soup_flower(d["to"], int(d["tier"]), 1.0, float(d["settle"]), a, FLOWER_STEM_FLAT)
	_pile_pts = _soup_pts.duplicate()
	_pile_cols = _soup_cols.duplicate()
	_pile_idx = _soup_idx.duplicate()
	_pile_bake_tick = tick
	_pile_dirty = false


func draw_thrown() -> void:
	# in flight, and then at rest on the boards. A landed one FADES as newer ones arrive
	# on top of it (the array is capped), so the pile stays a live read on the last
	# stretch of the act rather than an ever-growing monument to its opening.
	#
	# THE PILE IS BAKED (see the PILE_REBAKE block by `thrown`): everything already at
	# rest goes out as ONE triangle-array call, and only what is still moving - plus
	# anything that landed since the last bake, so nothing ever pops - is drawn per
	# frame below. Re-bake only when something actually changed AND the throttle allows.
	if _pile_dirty and tick - _pile_bake_tick >= PILE_REBAKE:
		_bake_pile()
	if not _pile_idx.is_empty():
		RenderingServer.canvas_item_add_triangle_array(get_canvas_item(), _pile_idx, _pile_pts, _pile_cols)
	_soup_clear()   # the airborne batch is rebuilt from scratch every frame
	var last_i := maxi(1, thrown.size() - 1)
	for i in thrown.size():
		var d: Dictionary = thrown[i]
		var lt := int(d["land"])
		if lt <= _pile_bake_tick:
			continue   # already in the baked pile
		var p: Vector2 = d["to"]
		var a := 1.0
		var sc := 1.0
		if tick < lt:
			var f := clampf(float(tick - int(d["born"])) / float(maxi(1, lt - int(d["born"]))), 0.0, 1.0)
			p = (d["from"] as Vector2).lerp(d["to"], f)
			p.y -= 4.0 * float(d["arc"]) * f * (1.0 - f)   # the same parabola every prop flies
			sc = 0.8 + 0.2 * f
		else:
			# older entries sit lower in the array; fade the oldest third of the pile so
			# it settles into the boards instead of stacking forever
			a = clampf(0.35 + 0.65 * float(i) / float(last_i), 0.35, 1.0)
			# it has come to rest but missed the last bake - ask for the next one. Free:
			# this loop is already running, and it is the only place a landing is noticed
			# without walking the array a second time every frame just to look for one.
			_pile_dirty = true
		# THE TUMBLE SETTLES, it does not just stop (2026-07-27, Louis). Two bugs in one
		# line before this: the rotation accumulated off `tick - born`, which never stops
		# growing, so a flower went on spinning where it lay for the rest of the act (a
		# settled pile was a field of pinwheels); and even frozen it froze at whatever
		# arbitrary angle it happened to reach, so half the pile lay stem-up.
		# It now turns from its random launch angle to its OWN resting angle across the
		# flight and holds there - which is both the tumble and the landing orientation,
		# from one number. lerp_angle takes the short way round, so it reads as a flower
		# turning over once and coming to rest, never as a spin-down. Eased so most of
		# the turning happens early, the way a tumbling thing does as drag catches it.
		var rot: float = float(d["settle"])
		if tick < lt:
			var rf := clampf(float(tick - int(d["born"])) / float(maxi(1, lt - int(d["born"]))), 0.0, 1.0)
			rot = lerp_angle(float(d["rot"]), float(d["settle"]), rf * rf * (3.0 - 2.0 * rf))
		if String(d["kind"]) == "tomato":
			_soup_tomato(p, sc, rot, a)
		else:
			# the stem foreshortens as the flower turns to face the boards - full length
			# while it is side-on in the air, about half once it lies pointing at us
			var stem := FLOWER_STEM_FLAT
			if tick < lt:
				var sf := clampf(float(tick - int(d["born"])) / float(maxi(1, lt - int(d["born"]))), 0.0, 1.0)
				stem = lerpf(FLOWER_STEM_AIR, FLOWER_STEM_FLAT, sf * sf * (3.0 - 2.0 * sf))
			_soup_flower(p, int(d["tier"]), sc, rot, a, stem)
	# ...and the whole shower goes out as ONE call too. These move every frame so they
	# cannot be baked, but building ~19 flowers' triangles in GDScript is still cheaper
	# than the ~170 individual draws it replaces - measured, not assumed.
	_soup_emit()
#endregion


func draw_falling() -> void:
	# the lost props on their way down, and lying on the boards afterwards.
	#
	# A DROPPED PROP IS THE SAME OBJECT IT WAS IN THE AIR (2026-07-28, Louis: "when the
	# chainsaw drops, it should stay a chainsaw"). This used to be a `match` on the kind
	# with a case per prop and a `_:` default that drew a BALL - so the seventh prop, added
	# after this function was written, fell out of the sky as a ball. That is the exact
	# failure mode this file already records for `draw_glow_in_dark`: **a second renderer
	# for an existing prop is easy to write without ever asking what the prop is**, and the
	# only durable fix is not to have a second renderer. It goes through `draw_prop_rich`
	# now, the one dispatcher the stage and the shop already share, so the eighth prop needs
	# no edit here and cannot come down as the wrong shape.
	#
	# The fade rides `_cap_a` for the same reason `capsule_mark` does: half these props
	# paint their own reds, steels and brass inside their own functions, so multiplying the
	# ONE colour this loop knows about faded a ball and left a chainsaw at full strength.
	for d in falling:
		var p: Vector2 = d["pos"]
		var a := 1.0
		if int(d["rest"]) >= 0:
			# IT LIES THERE FOR THREE SECONDS (Louis, and the number is the ask). It used
			# to fade out over 70 ticks - 0.58s - which is barely long enough to look down
			# and see what you dropped. It now holds, then fades over the last stretch, so
			# the prop is legible on the boards and still gone before the next exchange.
			var age := tick - int(d["rest"])
			a = clampf(float(FALLEN_LINGER - age) / float(FALLEN_FADE), 0.0, 1.0)
		var sc := prop_scale(int(d["kind"])) * 0.95   # a dropped prop keeps the size it flew at
		_cap_a = a
		draw_prop_rich(int(d["kind"]), p, d["col"], float(d["ang"]), sc, false)
		_cap_a = 1.0   # always restored, exactly as the wordmark's own fade is


func draw_egg_splats() -> void:
	for d in splats:
		var age := tick - int(d["born"])
		var a := clampf(1.0 - float(age) / 260.0, 0.0, 1.0)
		var p: Vector2 = d["pos"]
		var r: float = d["r"]
		fill_ellipse(p, r, r * 0.4, Color(0.95, 0.82, 0.35, 0.5 * a))       # spread yolk
		draw_circle(p, r * 0.45, Color(1.0, 0.7, 0.2, 0.8 * a))             # bright centre
		fill_ellipse(p + Vector2(r * 0.8, 1.0), r * 0.3, r * 0.16, Color(0.97, 0.9, 0.7, 0.4 * a))


func draw_egg_shards() -> void:
	var shell := Color(0.97, 0.93, 0.84)
	var shell_dk := Color(0.85, 0.80, 0.70)
	for d in shards:
		var age := tick - int(d["born"])
		var a := clampf(1.0 - float(age) / 150.0, 0.0, 1.0)
		var p: Vector2 = d["pos"]
		var ang: float = d["ang"]
		# a little curved shell fragment
		draw_set_transform(p, ang, Vector2.ONE)
		draw_colored_polygon(PackedVector2Array([
			Vector2(-4, 1), Vector2(0, -4), Vector2(4, 1), Vector2(0, 3)]),
			Color(shell.r, shell.g, shell.b, a))
		draw_line(Vector2(-4, 1), Vector2(4, 1), Color(shell_dk.r, shell_dk.g, shell_dk.b, a), 1.0)
		draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


func draw_text_shout(font: Font, pos: Vector2, text: String, align: int, width: float, size: int, col: Color) -> void:
	# floating STAGE text - popups, shouts, warnings, prompts - rides over whatever the
	# venue paints (a lit-window skyline, a warm spotlight), so it carries a dark outline
	# to stay legible on any of them without moving off the spot it belongs to (Louis).
	var oc := Color(0.04, 0.02, 0.03, col.a * 0.9)
	for o in [Vector2(-1.5, 0.0), Vector2(1.5, 0.0), Vector2(0.0, -1.5), Vector2(0.0, 1.5),
			Vector2(-1.1, -1.1), Vector2(1.1, -1.1), Vector2(-1.1, 1.1), Vector2(1.1, 1.1)]:
		draw_string(font, pos + o, text, align, width, size, oc)
	draw_string(font, pos, text, align, width, size, col)


func draw_popups(font: Font) -> void:
	for p in popups:
		var age := tick - int(p["born"])
		var a := clampf(1.0 - float(age) / 46.0, 0.0, 1.0)
		var pos: Vector2 = p["pos"] + Vector2(0, -float(age) * 0.6)
		var c: Color = p["col"]
		c.a = a
		var txt := String(p["text"])
		# the big moments land bigger, with a quick settle from oversized to rest
		var big := txt == "PERFECT" or txt == "NEW RECORD!" or txt.begins_with("LEVEL") or txt.ends_with("STREAK")
		var size := 18
		if big:
			size = 23 + maxi(0, 6 - age)
		# the box is 240 wide, so its LEFT edge sits half that from the anchor: the
		# old -60 offset centred every popup 60px right of the hand it belonged to
		draw_text_shout(font, pos - Vector2(120.0, 0), txt, HORIZONTAL_ALIGNMENT_CENTER, 240, size, c)


