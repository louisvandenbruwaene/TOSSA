#region DEV: AUTOPLAYER & SCREENSHOT CAPTURE
func demo_spin_room() -> bool:
	# dev only: the autoplayer will not spin itself into a drop. A Spin now blocks catching for
	# SPIN_TICKS, so a bot that spins whenever it can simply deletes its own set - measured,
	# `--demo --trick spin` collapsed after 202 ticks with nothing on the board, which makes
	# the flag useless for exactly the thing it exists to capture. It waits for a real gap now,
	# which is also the way a human has to play it.
	for b in balls:
		if b.state == STATE_FLIGHT and b.land_tick - tick < SPIN_TICKS + 8:
			return false
	return balls_airborne() > 0


func _demo_step() -> void:
	# INSIDE A LESSON the autoplayer plays off the beat logic and nothing else. On a
	# GUIDED step the beats already drive it (tut_hold_autoplay); on the free pass its
	# own metronome used to take over, and that metronome re-throws the instant it
	# catches - which is the ADVANCED style. On a beginner step that now fails the style
	# check outright (see tut_on_catch), so a --demo run could no longer finish the
	# basics. Reading tut_due_actions here means the harness always plays in whatever
	# style the step is teaching, which is also the only way it can verify one.
	if tut_active:
		var due := tut_due_actions()
		for e in due:
			if int(e["rank"]) != tut_hold_rank_of(due):
				continue
			match String(e["act"]):
				"throw":
					# do_throw, not on_throw_press: OUTSIDE a hold a press only starts
					# the charge and the release does the throwing, and the autoplayer
					# has no release. (Inside a hold on_throw_press throws directly,
					# which is why the guided path could use it.)
					var th := int(e["hand"])
					if not stack(th).is_empty():
						do_throw(th, 0)
				"catch": on_catch(int(e["hand"]))
				"trick": on_trick()
			break
		return
	# in a --booking demo the autoplayer cashes in the moment the FINAL goal falls, so
	# a whole act runs end to end (all three crossings, the resolve, the pay) and never
	# hangs at a venue whose crowd a low routine can sustain forever (v0/v1)
	if booking_active and goals_hit >= NUM_GOALS and running:
		finish_performance()
		return
	# --latecatch needs bootstrap throws before the catch-triggered loop below has
	# anything airborne to catch: one throw per ball beyond the first, DEMO_BEAT
	# apart, same as the metronome's own cadence, so every ball actually enters
	# rotation instead of a couple sitting as permanent, never-thrown residents.
	var settle_tick := 24 + (num_balls - 1) * DEMO_BEAT + 60
	if _late_catch_n >= 0 and tick >= 24 and tick < 24 + (num_balls - 1) * DEMO_BEAT and (tick - 24) % DEMO_BEAT == 0:
		var bh := _demo_next
		if stack(bh).is_empty():
			bh = other(bh)
		if not stack(bh).is_empty():
			do_throw(bh, _demo_hold)
			_demo_next = other(bh)
	# the bootstrap's own throws (fixed-beat, identical regardless of N) tend to
	# produce the tightest clearance of the whole run purely because they are not
	# yet on the late-catch rhythm - left alone, that bootstrap-phase minimum would
	# dominate _coll_min and mask whatever the ACTUAL late-catch-driven steady
	# state does, which is the only thing this mode exists to measure. One clean
	# reset once the bootstrap is behind and the rhythm has had a cycle to settle.
	if _late_catch_n >= 0 and tick == settle_tick:
		_coll_min = 1000000.0
		_coll_at = ""
		_coll_min_drawn = 1000000.0
		_coll_at_drawn = ""
	# auto-catch: secure any ball arriving at an empty hand (the odd-columns middle
	# ball counts for either hand, matching the either-hand rule in on_catch).
	# --latecatch N (see _late_catch_n) instead waits until exactly N ticks AFTER
	# the ball's ideal land_tick - still a Perfect catch as long as N is within
	# perfect_window() - and immediately re-throws that hand on this same tick,
	# so the audit actually exercises "a real, not-frame-0 Perfect catch followed
	# by an immediate throw" instead of only ever the idealized frame-perfect one.
	# Unlike the near-instant branch below, this does NOT skip a hand that
	# already holds a ball (on_catch itself never required an empty hand - a
	# hand legitimately holds two at a cascade's start - skipping it here once
	# stranded a hand's leftover ball forever, since nothing else would ever
	# ask it to catch, or to throw, again).
	for h in [LEFT, RIGHT]:
		if _late_catch_n < 0 and not stack(h).is_empty():
			continue
		for b in balls:
			if b.state != STATE_FLIGHT or (b.to_hand != h and b != col_mid_ball):
				continue
			var due := (tick == b.land_tick + _late_catch_n) if _late_catch_n >= 0 else absi(b.land_tick - tick) <= 1
			if due:
				var before := stack(h).size()
				on_catch(h)
				if _late_catch_n >= 0 and stack(h).size() > before:
					do_throw(h, _demo_hold)   # immediate: the whole point of this mode
				break
	# dev trick preview: kick off a Spin whenever the pattern is full and cooled down
	# (in unpinned mode, or when Spin itself is the pinned trick)
	var pin_kind := String(TRICKS[_demo_trick_pin]["kind"]) if _demo_trick_pin >= 0 else ""
	if _demo_trick and (_demo_trick_pin == -1 or _demo_trick_pin == TR_SPIN) \
			and balls_airborne() >= 2 and not spinning() and tick >= 40 and demo_spin_room():
		spin_until = tick + SPIN_TICKS
		spin_scored = false
		trick_ready = tick + TRICK_COOLDOWN
	# a pinned TOGGLE switches on once (one mimed Space press) and stays running
	# THE AUTOPLAYER MUST PRESS THE KEY, NOT SET THE FLAG (2026-07-29). It assigned
	# `toggle_on` directly, which was harmless while a toggle's only effect was to reshape
	# throws - and became a silent lie the moment a trick's PRESS is what multiplies the run.
	# Measured: `--trick btb` at five clubs scored 20,900, byte for byte what the same run
	# scored with no trick at all, because `apply_trick_mult` lives in on_trick and on_trick
	# was never reached. **A dev flag that quietly does something else is worse than one that
	# errors** - the same finding `dev_meet_req` produced the day before, in a different
	# disguise. It goes through the real handler now, so the flag exercises the real path.
	if _demo_trick and pin_kind == "toggle" and toggle_on != _demo_trick_pin and tick >= 24:
		trick_sel = _demo_trick_pin
		on_trick()
	# a tutorial's "switch it OFF" step needs the mime to let go again - outside a
	# lesson the point is showing the trick run, so this only fires once the lesson
	# has actually reached that step (never mid-drill, never in a bare --trick demo)
	if _demo_trick and tut_active and toggle_on == _demo_trick_pin \
			and String(tut_step_data().get("goal", "")) == "trick_off":
		toggle_on = -1
	# metronome: every beat, release one ball from a hand that actually holds one.
	# This can never desync because it only throws real held balls. Off under
	# --latecatch, whose own catch-then-immediately-rethrow above is the only
	# throw trigger that mode wants - the beat would otherwise fire independently
	# and blur the very timing this mode exists to isolate.
	if _late_catch_n < 0 and tick >= 24 and tick % DEMO_BEAT == 0:
		var h := _demo_next
		if stack(h).is_empty():
			h = other(h)
		if not stack(h).is_empty():
			if _demo_trick:
				# mimic a real Space press per throw for an "arm" trick - one that primes
				# a throw and pays when it is caught. There is no such trick left in
				# TRICKS (Overthrow was the last, removed 2026-07-28) but the branch and
				# the machinery behind it are kept: the flourish toggles and the live Spin
				# run through the same `trick_sel`, and an arm trick is a plausible thing
				# to add back. The flourish toggles (High Toss / BTB) run via toggle_on,
				# set once above, so there is nothing to prime for them.
				if pin_kind == "arm":
					trick_sel = _demo_trick_pin
					trick_primed = true
			do_throw(h, _demo_hold)
			_demo_next = other(h)


func _capture_and_quit() -> void:
	if _collcheck:
		# the overlap audit's verdict: the tightest edge-to-edge clearance any two
		# airborne props reached this session (negative would be a visual overlap)
		if _coll_min > 100000.0:
			# still the sentinel: two props never shared the air, so nothing was
			# actually audited. Loudly say so rather than let the absurd number read
			# as "infinite clearance, all clear" (give the run more frames via
			# --shotat, or a real --pattern/--balls/--prop to put props up)
			print("collcheck WARNING: nothing measured - no two props were ever airborne together")
		print("collcheck min clearance: %.1f px" % _coll_min)
		print("collcheck at: %s" % _coll_at)
		# ...and at drawn size, which is the one that answers "do the two roads LOOK
		# like they pass through each other" (see _coll_min_drawn)
		print("collcheck min drawn gap: %.1f px" % _coll_min_drawn)
		print("collcheck drawn at: %s" % _coll_at_drawn)
	# the audit needs no picture, and a picture is the only thing --headless cannot
	# give us (the viewport has no texture there). Asking for one anyway is what used
	# to force the whole pattern sweep through slow, wall-clock-bound windowed runs.
	if _shot_path != "":
		var tex := get_viewport().get_texture()
		if tex != null:
			var img := tex.get_image()
			if img != null:
				img.save_png(_shot_path)
	get_tree().quit()

#endregion
