func sheet_input(kc: int) -> void:
	# the character sheet's keys, shared by the play overlay and the day hub.
	# ARROWS SELECT, ENTER CONFIRMS - THE ONLY WAY IN NOW (2026-07-31, Louis: "remove the
	# buttons: 1, 2, 3, 4 from the stats: increase only by selecting with arrows and
	# pressing enter"). The 1-4 jump-and-spend shortcut is gone; holding Enter itself now
	# repeats (see sheet_repeat), which is the speed those keys used to provide.
	var ids := sheet_ids()
	match kc:
		KEY_TAB, KEY_ESCAPE:
			sheet_open = false
		KEY_LEFT:
			sheet_sel = (sheet_sel + ids.size() - 1) % ids.size()
			play_sfx("ui", -15.0)
		KEY_RIGHT:
			sheet_sel = (sheet_sel + 1) % ids.size()
			play_sfx("ui", -15.0)
		KEY_ENTER, KEY_KP_ENTER:
			_sheet_invest(ids[sheet_sel])
		KEY_Q:
			if debug_mode: _adjust("acc", -1)
		KEY_W:
			if debug_mode: _adjust("str", -1)
		KEY_E:
			if debug_mode: _adjust("end", -1)
		KEY_R:
			if debug_mode: _adjust("spd", -1)
		KEY_M:
			if debug_mode: _adjust("money", MONEY_TAP)
		KEY_N:
			if debug_mode: _adjust("money", -MONEY_TAP)
		KEY_PERIOD:
			if debug_mode:   # raise reputation to preview later venues/costumes
				reputation += 250
				save_progress()
		KEY_COMMA:
			if debug_mode:
				reputation = maxi(0, reputation - 250)
				save_progress()


# THE SHOP'S CURSOR IS TWO ROWS, and where one ends and the other begins is PROPS.size(),
# never a literal (2026-07-28). Adding the chainsaw as a seventh prop broke this in a
# dozen places at once: `shop_sel <= 5` sent the cursor's seventh card to try_buy_glasses,
# the up/down hop divided by a hard 6, and the row wrapped at a hard 10. Everything below
# is now derived, so an eighth prop is a PROPS row and nothing else.
# THE SHOP HAS TWO ROOMS (2026-07-28, Louis: "the shop can use ... like an 16+ fee, when
# payed you can enter the back of the shop, which contains the dangerous juggling
# equipment and uncle dan's pie"). It is a joke and it is also the fix for a real problem:
# a single row of prop cards ran out of screen width at SEVEN props, and no arithmetic
# saves it at eleven. Splitting the goods by what they ARE gives every card room again and
# gives the dangerous half a door to be behind.
const SHOP_ROOM_FRONT := 0
const SHOP_ROOM_BACK := 1

func shop_props() -> Array[int]:
	# EVERY PROP, IN ONE ROW (2026-07-29). Derived from PROPS, so an eighth is one table entry
	# and no other edit - the lesson the chainsaw taught when it walked into six hard-coded 6s.
	var out: Array[int] = []
	for i in PROPS.size():
		out.append(i)
	return out


func shop_gear() -> Array[Dictionary]:
	# WHAT THE SHOP STILL SELLS (2026-07-29, Louis: "I want all of these clothes to be for sale
	# in the tailor, not the shop. so sell the glow in dark props in the shop and glow in the
	# dark clothes with all other clothes in the tailor ... Energy drinks should ONLY be able
	# to be bought in the resting menu ... Uncle dan's pie should also be only for sale in the
	# rest menu. That should perhaps make the shop just one part again").
	#
	# So this is the PROP shop and nothing else: the objects you juggle, and the one piece of
	# gear that is about the objects rather than about you. Glasses, gloves, boots, hat,
	# tailcoat, waistcoat, glow suit and the energy helmet are clothing and live in the tailor;
	# the pie and the drinks are food and live in REST. Everything is where the thing IS - which
	# is also what let the two rooms and the 16+ curtain go, since they existed to solve a
	# layout problem (seven prop cards would not fit beside eleven gear ones) that no longer
	# exists.
	# ...AND THE GEAR ROW IS EMPTY NOW (2026-07-29). Its one card was the Glow Tape, and
	# phosphor became a property of each prop rather than a switch over all of them, so it is
	# bought on the prop's own card (G) like any other stock. Kept as a function rather than
	# deleted: it is the seam prop CATEGORIES will reopen, and every caller already handles
	# an empty row.
	var g: Array[Dictionary] = []
	return g


func shop_grid_on() -> bool:
	# THE GRID ONLY OPENS WHEN THE GEAR ROW IS SHUT (2026-07-30, F9 `shop_v2`). With gear empty -
	# which it now permanently is, the clothes having gone to the tailor and the glow tape having
	# become per-prop stock - the panel's whole lower half is dead by construction: seven squeezed
	# cards across the top, 300px of nothing, then the detail strip. So the props take the room.
	# Should gear ever come back (prop CATEGORIES is the accepted next piece and shop_gear is the
	# seam it reopens at), this returns false and the old single row draws exactly as it did,
	# rather than a grid quietly stealing the space the gear row needs.
	return exp_on("shop_v2") and shop_gear().size() == 0


func shop_grid_cols() -> int:
	# how many prop cards to a row, read by the DRAWING and by shop_input's up/down. One
	# function, because a grid whose cursor disagrees with its layout is the exact failure this
	# file already records for the seventh prop and the printed buy keys.
	var np := shop_props().size()
	if not shop_grid_on() or np <= 4:
		return maxi(np, 1)
	return int(ceil(float(np) / 2.0))


func shop_gear0() -> int:
	return shop_props().size()          # the index the gear row starts at


func shop_cards() -> int:
	return shop_props().size() + shop_gear().size()


func shop_on_door() -> bool:
	return false   # ONE ROOM: there is nowhere to walk to. Kept as a function rather than
				   # deleted because prop CATEGORIES (the accepted next big piece) will want a
				   # drawer again, and this is the seam it will open at.

# THE KEYBOARD SHORTCUT PRINTED ON EACH CARD, in card order across both rows. One table,
# read by the drawing AND by shop_input, because the two disagreeing is exactly what
# happened when a seventh prop took the 7 key and every gear card went on advertising the
# one above it. Past the end of this list a card simply prints no shortcut rather than a
# wrong one - the arrows and Enter already reach every card.

func shop_buy_sel() -> void:
	# Enter (pad A) acts on whichever card the cursor lights, prop or gear - or walks
	# through the door, which is the one slot that is not a purchase
	var props := shop_props()
	if shop_sel < props.size():
		try_buy(props[shop_sel])
		return
	var g := shop_gear()
	var gi := shop_sel - props.size()
	if gi < 0 or gi >= g.size():
		return
	try_buy_gear(String(g[gi]["id"]))


func try_buy_gear(_id: String) -> void:
	# nothing left in the shop's gear row - see shop_gear
	return


func shop_input(kc: int) -> void:
	# the shop's keys, shared by the play overlay and the day hub. Arrows (dpad, stick)
	# walk the cards - left/right along a row, up/down between rows - and Enter buys the
	# lit one.
	#
	# THE NUMBER KEYS ARE GONE (2026-07-30, Louis: "Remove the shortcuts: eg 5 buys a
	# knive, make sure the player goes over there with arrows / thumbstick, and presses
	# enter"). 1-7 used to jump the cursor onto a card AND buy in the same press, which is
	# a purchase with no cursor movement to confirm it - the one input in the game that
	# could spend 9,000 flowers off a single keystroke aimed at the wrong digit. It also
	# forced every card to print its key, which is a number on a card that is not a stat.
	# With them gone the shop has ONE way to buy and it is the same on keyboard and pad,
	# and `SHOP_KEYS`/`shop_key_label` went with them.
	match kc:
		KEY_TAB, KEY_ESCAPE, KEY_S:
			shop_open = false
		KEY_LEFT:
			shop_sel = (shop_sel + shop_cards() - 1) % shop_cards()
			play_sfx("ui", -15.0)
		KEY_RIGHT:
			shop_sel = (shop_sel + 1) % shop_cards()
			play_sfx("ui", -15.0)
		KEY_DOWN, KEY_UP:
			if shop_grid_on():
				# UP/DOWN WALKS THE GRID'S COLUMNS, which is the one input change the grid needs
				# and cannot do without: with the gear row empty the old branch below computed
				# `7 + sel * 1 / 7` = 7 for every prop and then clamped it to 6, so up and down
				# both simply jumped to the last card wherever you were. A card stays lit if its
				# column is short (7 cards over 4 columns leaves the fourth with one), because
				# moving the cursor to a different column would be a worse surprise than not
				# moving it at all.
				var cols := shop_grid_cols()
				var to := shop_sel + (cols if kc == KEY_DOWN else -cols)
				if to >= 0 and to < shop_cards():
					shop_sel = to
			else:
				var g0 := shop_gear0()
				var gn := maxi(1, shop_gear().size())
				if shop_sel < g0:
					shop_sel = g0 + shop_sel * gn / maxi(g0, 1)   # prop column -> nearest gear card
				else:
					shop_sel = (shop_sel - g0) * maxi(g0, 1) / gn   # ...and back again
				shop_sel = clampi(shop_sel, 0, shop_cards() - 1)
			play_sfx("ui", -15.0)
		KEY_ENTER, KEY_KP_ENTER:
			shop_buy_sel()
		KEY_B, KEY_SPACE:
			# BUY THE SET: enough of the lit prop to field your current count in one
			# press (gear has no sets, so it just buys the one thing). KEY_SPACE is here
			# for the pad: X routes to Space outside live play, and nothing else in the
			# shop claims it - the same trick the save-slot screen uses for delete.
			if shop_sel < shop_gear0():
				try_top_up(shop_props()[shop_sel])
			else:
				shop_buy_sel()
		KEY_G:
			# BUY THE GLOWING SET of the lit prop, the same one-press basket B buys the plain
			# one with. Its own key rather than a mode on B, because the two are very different
			# amounts of money and a player should never find out which one they bought after
			# the fact.
			if shop_sel < shop_gear0():
				try_top_up_glow(shop_props()[shop_sel])


func skills_input(kc: int) -> void:
	# the Skills reference: browse every trick and pattern. Up/Down walk the whole
	# list (tricks then patterns), Left/Right jump between the two columns.
	var n := TRICKS.size() + PATTERNS.size()
	match kc:
		KEY_UP, KEY_W:
			skills_sel = (skills_sel + n - 1) % n
			play_sfx("ui", -15.0)
		KEY_DOWN, KEY_S:
			skills_sel = (skills_sel + 1) % n
			play_sfx("ui", -15.0)
		KEY_LEFT, KEY_A:
			skills_sel = mini(skills_sel, TRICKS.size() - 1)   # into the tricks column
			play_sfx("ui", -15.0)
		KEY_RIGHT, KEY_D:
			skills_sel = maxi(skills_sel, TRICKS.size())        # into the patterns column
			play_sfx("ui", -15.0)
		KEY_ENTER, KEY_KP_ENTER:
			practice_skill(skills_sel)   # drop into a practice with this skill on
		KEY_TAB, KEY_ESCAPE:
			skills_open = false
			play_sfx("ui", -13.0)


func practice_skill(idx: int) -> void:
	# Enter on a Skills entry books a PRACTICE with that skill already engaged, so a
	# trick (or pattern) can be drilled straight from where it is explained (Louis).
	# Costs a day segment like any practice; a locked skill or an empty tank refuses.
	var is_trick := idx < TRICKS.size()
	# the Skills screen lists patterns in UNLOCK order (pattern_order), so a
	# pattern row index translates back to the raw PATTERNS index here
	var pat := -1 if is_trick else int(pattern_order()[idx - TRICKS.size()])
	if is_trick and not trick_unlocked(idx):
		set_day_msg("that trick asks for %s" % skill_req_text(TRICKS[idx]))
		play_sfx("whiff", -10.0)
		return
	if not is_trick and not pattern_unlocked(pat):
		set_day_msg("that pattern asks for %s" % skill_req_text(PATTERNS[pat]))
		play_sfx("whiff", -10.0)
		return
	if too_tired():
		set_day_msg("too tired to practise  -  sleep first")
		play_sfx("whiff", -10.0)
		return
	# a pattern practice keeps the current ball count as-is (Cascade reads either
	# way, crossing odd / same-hand even; every other pattern is unlocked at its
	# own count regardless). The pattern rides the ONE-SESSION override, never
	# pattern_sel: trying a pattern from the Skills screen must not re-book the act
	# (Louis) - only P, the player's own hand, changes the persistent choice.
	if not is_trick:
		pattern_once = pat
	skills_open = false
	seg_used += 1
	career["practices"] = int(career["practices"]) + 1
	save_progress()
	mode = MODE_TRAIN
	game_state = ST_PLAY
	start_run(num_balls)
	# now engage the chosen trick (start_run has cleared the per-run trick state):
	# a toggle switches ON and stays, an arm trick primes the next throw, Spin just
	# loads. The player still throws to begin, so nothing fires unbidden.
	if is_trick:
		trick_sel = idx
		var kind := String(TRICKS[idx]["kind"])
		if kind == "toggle":
			toggle_on = idx
			toggle_scored = false
			set_trick_msg("%s ON  -  practising" % String(TRICKS[idx]["name"]).to_upper())
		elif kind == "arm":
			trick_primed = true
			set_trick_msg("%s  -  next throw" % String(TRICKS[idx]["name"]).to_upper())
		else:
			set_trick_msg("%s selected  -  %s performs it" % [String(TRICKS[idx]["name"]), k_trick()[0]])
	else:
		set_trick_msg("%s  -  %s" % [String(PATTERNS[pattern]["name"]).to_upper(), String(PATTERNS[pattern]["desc"])])
	play_sfx("ui2", -11.0)


#endregion

#region LIVE PROP / PATTERN / COUNT SWITCHING
func cycle_prop(dir: int) -> void:
	# step to the next prop you own enough of, and restart with it (per-run setting)
	var n := PROPS.size()
	var k := prop_type
	for _i in n:
		k = (k + dir + n) % n
		if available(k):
			prop_type = k
			break
	start_run(num_balls)


func confirm_spend(id: String, cost: int, in_shop: bool) -> bool:
	# any purchase that would leave tonight's bed unaffordable asks ONCE before
	# it goes through (Louis: warn anywhere the player can strand themselves,
	# because no bed and no strength to busk is the end of the road)
	if money - cost >= INN_COST:
		return true
	var now := int(Time.get_ticks_msec())
	if _confirm_id == id and now - _confirm_ms < 4000:
		_confirm_id = ""
		return true
	_confirm_id = id
	_confirm_ms = now
	var wtext := "careful  -  that leaves you short of the inn (%d %s). press again to spend anyway" % [INN_COST, coin_word()]
	if in_shop:
		shop_msg = wtext
		shop_msg_ms = now
		shop_msg_warn = true
	else:
		set_day_msg(wtext)
	play_sfx("late", -8.0)
	return false


func try_buy(kind: int) -> void:
	# buy one more of a prop; you can stock as many as you can afford
	var cost := int(PROPS[kind]["cost"])
	if money >= cost:
		if not confirm_spend("prop%d" % kind, cost, true):
			return
		var was := available(kind)
		money -= cost
		prop_count[kind] += 1
		shop_buy_ms = int(Time.get_ticks_msec())
		save_progress()
		play_sfx("money", -6.0)
		if not was and available(kind):
			offer_prop_tutorial(kind)   # first time you can juggle these: explain them


func glow_cost(kind: int) -> int:
	# a glowing copy of one object - see GLOW_PROP_MULT
	return int(round(float(PROPS[kind]["cost"]) * GLOW_PROP_MULT))


func try_top_up_glow(kind: int) -> void:
	# BUY THE GLOWING SET, the same one-press basket try_top_up already established for plain
	# stock and for the same reason: what a player wants at this counter is "enough of these
	# to juggle in the dark", not fifteen separate confirmations. Glowing props are a straight
	# parallel stock - they are not a different prop, they are the same prop that shines - so
	# nothing else in the game has to know about them beyond prop_glows().
	var cost := glow_cost(kind)
	var want := maxi(num_balls - glow_count[kind], 0)
	if want <= 0:
		want = num_balls   # already a full glowing set: buy spares for the drops to come
	var can := clampi(int(floor(float(money) / float(maxi(cost, 1)))), 0, want)
	if can <= 0:
		shop_msg = "a glowing %s is %s" % [String(PROPS[kind]["name"]).to_lower(), commafy(cost)]
		shop_msg_ms = int(Time.get_ticks_msec())
		shop_msg_warn = true
		play_sfx("whiff", -10.0)
		return
	if not confirm_spend("glowset%d" % kind, cost * can, true):
		return
	money -= cost * can
	glow_count[kind] += can
	shop_msg = "%d glowing %s" % [can, prop_plural(kind)]
	shop_msg_ms = int(Time.get_ticks_msec())
	shop_msg_warn = false
	shop_buy_ms = int(Time.get_ticks_msec())
	save_progress()
	play_sfx("money", -6.0)


func try_top_up(kind: int) -> void:
	# BUY THE SET (2026-07-27). To juggle N of a prop you must own N of them, and eggs
	# break for good, so the shop's real job is usually "get me back to a full set" -
	# which used to be one Enter press per object, up to fifteen of them, and again
	# after every egg. This buys the whole shortfall in one press, or a spare set on top
	# when the set is already fielded, and it stops the moment the purse cannot take the
	# next one rather than half-failing with a warning.
	var cost := int(PROPS[kind]["cost"])
	var want := maxi(num_balls - prop_count[kind], MIN_BALLS if prop_count[kind] == 0 else 0)
	if want <= 0:
		want = num_balls   # already fielded: top up a spare set for the drops to come
	var can := clampi(int(floor(float(money) / float(maxi(cost, 1)))), 0, want)
	if can <= 0:
		shop_msg = "not enough %s for even one" % coin_word()
		shop_msg_ms = int(Time.get_ticks_msec())
		shop_msg_warn = true
		play_sfx("whiff", -10.0)
		return
	# one confirmation for the whole basket, not one per item
	if not confirm_spend("set%d" % kind, cost * can, true):
		return
	var was := available(kind)
	money -= cost * can
	prop_count[kind] += can
	shop_buy_ms = int(Time.get_ticks_msec())
	save_progress()
	play_sfx("money", -4.0)
	shop_msg = "%d %s  -  %s %s" % [can, prop_plural(kind), commafy(cost * can), coin_word()]
	if can < want:
		shop_msg += "  (all the purse would take)"
	shop_msg_ms = int(Time.get_ticks_msec())
	shop_msg_warn = false
	if not was and available(kind):
		offer_prop_tutorial(kind)


func offer_prop_tutorial(kind: int) -> void:
	# the first time a new prop becomes juggle-able, queue its hands-on lesson. It is
	# routed through the same queue every other unlock uses, so the hub's LEARN row
	# offers it (rather than yanking the player out of the shop mid-purchase).
	queue_lesson("prop_%d" % kind)


# =============================================================================
# Interactive tutorials. Unlike a cutscene, a lesson runs on the REAL sim: the
# player throws and catches actual balls, guided one step at a time, and each
# step advances only once its goal is met. Fired when something unlocks: a fresh
# save teaches the 1-ball basics (then 2, then 3), and buying a new prop teaches
# that prop. There is no menu entry; lessons arrive when they are relevant.
# =============================================================================

#endregion

#region TUTORIAL SYSTEM
# THE PACE LADDER IS GONE, and with it tut_paced() and tut_pace_line() (2026-07-30). Every drill
# in every lesson used to run three times over - half speed, quarter speed, full speed - and the
# basics were rewritten out of that in July on Louis's "remove all slowmo from the tutorial": slow
# motion teaches the player to juggle in a world that does not exist and then hands them the real
# one. The trick, pattern, prop, count and advanced lessons kept running it for another day, and
# now they speak like the basics instead (see tut_beat), so the builder had no callers left. One
# honest pass at full speed asks what the ladder's LAST pass asked, so nothing got easier.
# TUT_PHASES itself survives only as the guided beat's own note above; draw_tutorial_banner's pace
# pips are unreachable along with the rest of that banner - see the `say` early-out in it.

func tut_lesson(id: String) -> Array:
	if id.begins_with("prop_"):
		var k := int(id.substr(5))
		var quirks := {
			PROP_EGGS: "They throw like balls, but a drop breaks for good, so keep your hands soft.",
			PROP_RINGS: "Heavier than balls, so they hang a touch longer. Catch them by the rim.",
			PROP_CLUBS: "These tumble in the air. Catch the handle, not the spin, so read the rotation.",
			PROP_KNIVES: "Fast and sharp, with less room for error. Endurance keeps your hands honest.",
			PROP_TORCHES: "The heaviest, lit and roaring. They ask for real Strength and a steady nerve.",
			PROP_CHAINSAW: "It never stops running. Catch it by the handle, high, and never reach for the bar - the chain is moving whether you are ready or not.",
		}
		var quirk := String(quirks.get(k, "A new prop. Feel out its weight and timing."))
		var need := 6 if k >= PROP_TORCHES else 5
		# spoken, like every other lesson now - see trick_lesson_steps for what came out and why
		return [
			tut_say("%s. %s" % [String(PROPS[k]["name"]), quirk]),
			tut_say("%s swaps which object you juggle, any time you are practising. The pattern and the keys do not change - only what is in the air." % String(k_object()[0])),
			tut_beat("Land %d of them." % need, "catch", need, 3, {"prop": k, "prompt": "catch"}),
		]
	if id.begins_with("trick_"):
		return trick_lesson_steps(trick_by_id(id.substr(6)))
	if id.begins_with("count_"):
		return count_lesson_steps(int(id.substr(6)))
	if id.begins_with("pattern_"):
		return pattern_lesson_steps(pattern_by_id(id.substr(8)))
	if id == TUT_ADVANCED:
		return advanced_lesson_steps()
	# =========================================================================
	# THE BASICS, rewritten to Louis's script (2026-07-29 evening). It is a CONVERSATION
	# now, not a drill ladder: one line at a time, one key at a time, in the order a
	# person would actually teach it.
	#
	# WHAT CAME OUT, and why each piece went:
	#   * the TUT_PHASES ladder - every drill run three times, at 50%, 25% and full speed.
	#     Louis: "remove all slowmo from the tutorial". Slow motion taught the player to
	#     juggle in a world that does not exist, and then handed them the real one.
	#   * the top BANNER and the full-screen INTRO CARD. "Remove all unnecessary text from
	#     the current tutorial, the player only needs the buttons that are on the bottom of
	#     the screen." The key row stays; everything else is spoken.
	#   * the paragraph-long `sub` explanations. A line of dialogue is one sentence.
	#
	# WHAT IT IS NOW: `say` beats (a line, then Enter), `do` beats (a line, then the ONE
	# key it names - Enter is dead on those, so the only way past is the actual press), a
	# `hand` beat that asks which hand is dominant, and `free` beats that hold the lesson
	# open until the player has juggled a real count. Every key name is resolved from the
	# live bindings AND from the dominant hand, so a left-hander is taught their own hands
	# in their own keys - see tut_kt / tut_kc.
	var dom := dominant_hand
	var off := other(dom)
	var TD := tut_kt(dom)     # throw, dominant hand      (J by default)
	var TO := tut_kt(off)     # throw, other hand         (F)
	var CD := tut_kc(dom)     # catch, dominant hand      (K)
	var CO := tut_kc(off)     # catch, other hand         (D)
	var out: Array = []
	out.append(tut_say("Hello, this is a game about juggling. If you want to learn it, you've come to the right place!"))
	out.append({"goal": "hand", "prop": PROP_BALLS, "balls": 0, "need": 0, "slow": 0.0, "say": true,
		"text": "Let's start with one ball in your strong hand.", "next": "one ball"})
	# ONE BALL, hand to hand. Four presses, each one named and waited for.
	out.append(tut_do("Great! Now throw it to your other hand in an arc.", "throw", dom, TD, 1, 1))
	out.append(tut_do("Now catch it.", "catch", off, CO, 1, 1))
	out.append(tut_do("Amazing! Now throw it back.", "throw", off, TO, 1, 1))
	out.append(tut_do("Catch it.", "catch", dom, CD, 1, 1))
	out.append(tut_say("The catch words are timing grades: PERFECT is centred, GOOD and LATE are less secure, and a miss drops the prop."))
	out.append(tut_free("That's it! Feel free to master one ball before moving on.", 1, 0, 0,
		"When you are ready, press Enter for the second ball.", 1))
	# HEIGHT is a real input, not trivia: this step only clears after a release held long
	# enough to change the flight. It runs unfrozen so press duration can actually exist.
	out.append({"goal": "hold_throw", "prop": PROP_BALLS, "balls": 1, "hand": RIGHT,
		"stack": 1, "need": 1, "slow": 0.0, "say": true, "manual": true, "next": "go on",
		"text": "Hold [%s] until the gold gauge grows, release the high throw, then watch it and catch it. Higher arcs give you more time but are harder to secure." % TD})
	out.append(tut_say("Use low taps for rhythm and held throws to make room. Height buys time, but very high catches are less forgiving."))
	# TWO BALLS, one in each hand, so throw-throw-catch-catch is the only thing available.
	out.append(tut_do("One ball in each hand now. Throw the first.", "throw", dom, TD, 2, 1, false, {"sequence": true}))
	out.append(tut_do("Throw the second before it lands - wait for the first to reach the top.", "throw", off, TO, 2, 1, true, {"sequence": true}))
	# Exact right-dominant order requested: J F D F K J K J D F D F K J K J ...
	# Hands and live bindings are substituted, so the same rhythm mirrors correctly.
	var two_actions := [
		["catch", off], ["throw", off], ["catch", dom], ["throw", dom],
		["catch", dom], ["throw", dom], ["catch", off], ["throw", off],
		["catch", off], ["throw", off], ["catch", dom], ["throw", dom],
		["catch", dom], ["throw", dom],
	]
	for a2: Array in two_actions:
		var ah2 := int(a2[1])
		var key2 := (CD if ah2 == dom else CO) if String(a2[0]) == "catch" else (TD if ah2 == dom else TO)
		out.append(tut_do("Catch this one." if String(a2[0]) == "catch" else "Throw it back.",
			String(a2[0]), ah2, key2, 2, 1, false, {"sequence": true}))
	out.append(tut_free("Keep that going: catch, throw it right back, on each side in turn.",
		2, 6, 6, "Practise the two-ball exchange. Enter when you've got it.", 1))
	# THREE BALLS, two in the dominant hand: the real cascade, one exchange at a time.
	out.append(tut_do("Three balls. Two in your strong hand. Throw the first.", "throw", dom, TD, 3, 2, false, {"sequence": true}))
	out.append(tut_do("Wait for it to reach the top, then throw the next one under it.", "throw", off, TO, 3, 2, true, {"sequence": true}))
	# Exact right-dominant rhythm: J F D J K F D J K F D J K. Mirroring dom/off also
	# mirrors every throw and catch for a left-dominant player. The free step re-deals
	# cleanly if this guided rhythm still has props airborne.
	var three_actions := [
		["catch", off], ["throw", dom], ["catch", dom], ["throw", off],
		["catch", off], ["throw", dom], ["catch", dom], ["throw", off],
		["catch", off], ["throw", dom], ["catch", dom],
	]
	for a3: Array in three_actions:
		var ah3 := int(a3[1])
		var key3 := (CD if ah3 == dom else CO) if String(a3[0]) == "catch" else (TD if ah3 == dom else TO)
		out.append(tut_do("Catch this one." if String(a3[0]) == "catch" else "Throw the next ball.",
			String(a3[0]), ah3, key3, 3, 2, false, {"sequence": true}))
	out.append(tut_free("That is the whole cascade. Try it out until you feel comfortable.", 3, 10, 10,
		"Prove it: ten throws and ten catches, always with another ball in the air.", 2, true))
	# EMPTY-HANDS CASCADE, exact right-dominant order requested:
	# J F J D F K J D F K J D F ... Every key is its own stopped-world beat.
	out.append(tut_say("Now the empty-hands cascade. Put all three up first; after that, catch first and throw from that same hand. We will pause on every key."))
	out.append(tut_do("First ball up.", "throw", dom, TD, 3, 2, false, {"style": TUT_ADVANCED, "sequence": true}))
	out.append(tut_do("Second ball under it.", "throw", off, TO, 3, 2, true, {"style": TUT_ADVANCED, "sequence": true}))
	out.append(tut_do("When the second ball is high, put the third ball up - now both hands are empty.", "throw", dom, TD, 3, 2, true, {"style": TUT_ADVANCED, "sequence": true}))
	var empty_actions := [
		["catch", off], ["throw", off], ["catch", dom], ["throw", dom],
		["catch", off], ["throw", off], ["catch", dom], ["throw", dom],
		["catch", off], ["throw", off],
	]
	for ae: Array in empty_actions:
		var ahe := int(ae[1])
		var keye := (CD if ahe == dom else CO) if String(ae[0]) == "catch" else (TD if ahe == dom else TO)
		out.append(tut_do("Catch into the empty hand." if String(ae[0]) == "catch" else "Throw it straight back.",
			String(ae[0]), ahe, keye, 3, 2, false, {"style": TUT_ADVANCED, "sequence": true}))
	out.append(tut_say("That full sequence is the empty-hands rhythm: all three up, then catch and immediately throw from the same hand."))
	out.append(tut_say("That is enough for now. [%s] restarts this practice deal, and [%s] opens the game menu." % [String(k_restart()[0]), String(k_pause()[0])]))
	out.append({"goal": "read", "prop": PROP_BALLS, "balls": 3, "hand": dom, "stack": 2, "need": 0, "slow": 0.0,
		"next": "finish the lesson", "say": true,
		"text": "Tangled? [%s] starts you over, any time you are practising." % String(k_restart()[0])})
	return out


func tut_kt(h: int) -> String:
	# the THROW key for a hand, in the player's own bindings. The tutorial names keys rather
	# than hands ("press J"), so every line has to be built from these two functions or a
	# left-handed player is taught somebody else's hands.
	if pad_active():
		return "LB" if h == LEFT else "RB"
	return OS.get_keycode_string(K_LT if h == LEFT else K_RT)


func tut_kc(h: int) -> String:
	if pad_active():
		return "LT" if h == LEFT else "RT"
	return OS.get_keycode_string(K_LC if h == LEFT else K_RC)


func tut_say(line: String) -> Dictionary:
	# A LINE, and Enter to go on. Nothing to do but read it.
	return {"goal": "read", "prop": PROP_BALLS, "balls": 0, "need": 0, "slow": 0.0, "say": true,
		"next": "go on", "text": line}


func tut_do(line: String, act: String, h: int, keyname: String, n: int, stack: int = 0,
		peak: bool = false, extra: Dictionary = {}) -> Dictionary:
	# A LINE AND ONE KEY. `goal` names the exact press, so Enter cannot skip it (see
	# tut_advance: a `do` beat holds until the goal is met, and only then does Enter mean
	# anything). `peak` is Louis's "pause and highlight the first ball at its peak" beat -
	# see tut_peak_hold.
	# "hand": RIGHT IS SYMBOLIC, NOT LITERAL (2026-07-30 fix, Louis: "if i select the left
	# hand, the player holds the ball in the right hand and pressing F doesn't work"). Every
	# lesson in the game - this one included - deals relative to the DOMINANT side, and
	# RIGHT is the convention that means "dominant" (see tut_step_hand): a mirrored lesson
	# for a left-handed player is `RIGHT` too, never `LEFT`. This used to pass the ALREADY-
	# RESOLVED `dominant_hand` value here instead, which tut_setup_step then resolved a
	# SECOND time - correct by coincidence for a right-handed player (whose dominant_hand
	# already equals the RIGHT constant) and exactly backwards for a left-handed one, whose
	# every deal came out mirrored onto the wrong hand entirely.
	var g := ("throw_l" if h == LEFT else "throw_r") if act == "throw" else ("catch_l" if h == LEFT else "catch_r")
	var d := {"goal": g, "prop": PROP_BALLS, "balls": n, "hand": RIGHT, "stack": stack, "need": 1, "slow": 0.0,
		"say": true, "key": keyname, "peak": peak, "next": "go on",
		"text": "%s  [%s]" % [line, keyname]}
	for k in extra:
		d[k] = extra[k]
	return d


func tut_beat(line: String, goal: String, need: int, n: int, extra: Dictionary = {}) -> Dictionary:
	# A SPOKEN BEAT WITH ANY GOAL, and its absence is why half the lessons in the game still
	# looked like the old ones (2026-07-30, Louis: "fix the 'learn something new' tutorials, which
	# should be given in the same style and layout as the actual tutorial"). The basics have three
	# builders - tut_say (a line and Enter), tut_do (a line and one named key), tut_free (a line
	# and a real count) - and a trick or pattern lesson needs a line and a goal like `trick_on` or
	# `press_p`, which none of them could express. So those lessons had no way to SPEAK, and fell
	# back on the banner, the full-screen intro card, the paragraph-long `sub` and the three-pass
	# slow-motion ladder that the basics were deliberately rewritten out of.
	#
	# `say` is the one flag that switches the whole HUD over (see draw_tutorial_banner), so with
	# this in hand every step of every lesson can carry it and the game has ONE lesson style.
	# `extra` carries whatever the goal needs - `trick`, `pattern`, `prop`, `prompt`, `key` - so
	# no goal, need, count or reward changed in the conversion: only the presentation moved.
	var d := {"goal": goal, "prop": PROP_BALLS, "balls": n, "hand": RIGHT, "need": need,
		"slow": 0.0, "say": true, "next": "go on", "text": line}
	for k in extra:
		d[k] = extra[k]
	return d


func tut_free(line: String, n: int, throws: int, catches: int, sub: String,
		stack: int = 0, require_juggle: bool = false) -> Dictionary:
	# FREE PLAY, held open until the player has actually done it - and with no goal at all
	# (throws and catches both zero) it is simply "play with this until you press Enter",
	# which is what "feel free to master one ball" means. "hand": RIGHT is symbolic - see
	# tut_do just above.
	return {"goal": "free", "prop": PROP_BALLS, "balls": n, "hand": RIGHT, "stack": stack, "need": maxi(catches, 0),
		"throws": throws, "slow": 0.0, "say": true, "next": "go on",
		"text": line, "sub": sub, "juggle": require_juggle}


func advanced_lesson_steps() -> Array:
	# THE OTHER WAY TO HOLD A PATTERN (see TUT_BEGINNER). Everything about this lesson is
	# the same drill the basics ended on - three balls, the same cascade, the same two
	# keys per hand - and exactly one thing differs: the hands stay EMPTY, so every beat
	# runs catch-then-throw instead of throw-then-catch. Teaching it as its own lesson,
	# right after the basics, is what makes the difference visible: the player already
	# has the beginner rhythm in their hands and feels this one land as its mirror image.
	var kj := OS.get_keycode_string(K_RT)
	var kf := OS.get_keycode_string(K_LT)
	var kd := OS.get_keycode_string(K_LC)
	var kk := OS.get_keycode_string(K_RC)
	return [
		tut_say("You already know the beginner cascade: two props rest in your hands, one is in the air, and as it falls you throw first and catch second."),
		tut_say("This is the mirror of it. Every prop goes up at the start and your hands stay EMPTY, so each beat is catch first, throw second - the same two keys, the opposite order."),
		tut_say("It is harder to start and smoother to hold, and the big counts are impossible without it."),
		tut_beat("Put all three up, then keep your hands empty: %s then %s, or %s then %s. Ten clean catches." % [kk, kj, kd, kf],
			"catch", 10, 3, {"juggle": true, "style": TUT_ADVANCED, "pattern": CASCADE, "prompt": "catch"}),
	]


# TRICK_TUT_SLOW is deleted with the ladder: a trick lesson has no slow motion in it now.

func trick_lesson_steps(t: int) -> Array:
	# A trick lesson mirrors the three INPUT GRAMMARS the game has, because the grammar is what
	# confuses people, not the trick: a toggle switches on and off, an arm shot empowers one throw,
	# a live trick acts on what is already in the air. Taught with plain balls, since the shaping
	# is prop-independent.
	#
	# SPOKEN, LIKE THE BASICS (2026-07-30). This used to open on a full-screen intro card and then
	# run its drill three times over - half speed guided, quarter speed guided, full speed alone -
	# with a paragraph of `sub` under each. All of that is what the basics were rewritten out of in
	# July, for reasons recorded at tut_lesson: slow motion teaches a world that does not exist,
	# and a line of dialogue is one sentence. The grammar is now the thing SAID first, one line at
	# a time, and the drill is one honest pass at full speed - the same need the old ladder's LAST
	# pass asked for, so nothing got easier, only shorter.
	if t < 0 or t >= TRICKS.size():
		return [tut_beat("Keep the cascade going: land three.", "catch", 3, 3, {"prompt": "catch"})]
	var td: Dictionary = TRICKS[t]
	var nm := String(td["name"])
	var kb := String(k_trick()[0])
	var kcy := String(k_cycle()[0])
	var grammar := "%s performs it right now, on whatever is already in the air." % kb
	if String(td["kind"]) == "toggle":
		grammar = "%s switches it ON, and switches it OFF again. While it runs, EVERY throw is reshaped." % kb
	elif String(td["kind"]) == "arm":
		grammar = "%s arms your next throw and only that one. Press, throw, catch - a fresh press every time." % kb
	var out: Array = [
		tut_say("%s. %s" % [nm, String(td.get("desc", ""))]),
		tut_say(grammar),
	]
	match String(td["kind"]):
		"toggle":
			out.append(tut_beat("Switch it on.  [%s]" % kb, "trick_on", 1, 3,
				{"trick": t, "prompt": "trick", "key": kb}))
			out.append(tut_beat("Now catch four with it running - watch the weave change shape.",
				"catch", 4, 3, {"trick": t, "prompt": "catch"}))
			out.append(tut_beat("And switch it off again. One press on, one press off - that is the whole toggle.  [%s]" % kb,
				"trick_off", 1, 3, {"trick": t, "prompt": "trick", "key": kb}))
		"arm":
			out.append(tut_beat("Arm it, then throw. Only that one next throw carries it, so it is a fresh press every time.  [%s]" % kb,
				"trick_use", 2, 3, {"trick": t, "prompt": "trick", "key": kb}))
		_:  # live (Spin): acts on the balls already airborne
			out.append(tut_beat("Get all three weaving first - it acts on what is already in the air.",
				"catch", 2, 3, {"prompt": "catch"}))
			out.append(tut_beat("Now call it, and catch through the turn.  [%s]" % kb,
				"trick_use", 2, 3, {"trick": t, "prompt": "trick", "key": kb}))
	out.append(tut_say("%s swaps which trick %s carries, whenever you are juggling." % [kcy, kb]))
	return out


func count_lesson_steps(n: int) -> Array:
	# a new ball count, spoken (see trick_lesson_steps for why the intro card and the three-pass
	# ladder went). Whatever pattern is already running keeps running; Cascade reads either way
	# (crossing odd, same-hand even), so a count change never strands it.
	return [
		tut_say("Your Strength carries another one. That makes %d." % n),
		tut_say("More props climb higher and move faster. Throw a touch higher than feels right."),
		tut_beat("Keep it going: ten clean catches.", "catch", 10, n, {"prompt": "catch"}),
		tut_say("%s and %s step the count down and up whenever you are practising, so you can always drop back to a load you can hold." % [String(k_count()[0]), String(k_count()[1])]),
	]


func pattern_lesson_steps(p: int) -> Array:
	# a new pattern, spoken (see trick_lesson_steps). The PATTERNS table's own desc is the teaching
	# text, so there is one source of truth for what a pattern is.
	if p < 0 or p >= PATTERNS.size():
		return [tut_beat("Keep the cascade going: land three.", "catch", 3, 3, {"prompt": "catch"})]
	var pd: Dictionary = PATTERNS[p]
	var nm := String(pd["name"])
	var desc := String(pd.get("desc", "Feel out its shape."))
	var kp := String(k_pattern()[0])
	var n := 3   # every pattern lesson reads at 3 (Cascade's own even-count face isn't taught as a
				# separate lesson any more - it's the same skill, see PATTERNS)
	return [
		tut_say("%s. %s" % [nm, desc]),
		tut_say("A pattern is the whole shape of the juggle, not a flourish: it needs no timing of its own, it just changes where every throw goes."),
		tut_beat("Try it: eight clean catches.", "catch", 8, n, {"pattern": p, "prompt": "catch"}),
		# the last beat TEACHES the key that owns patterns: one press visibly hands the routine
		# back to the plain weave. The lesson never touches pattern_sel, so what the player chose
		# before the lesson is exactly what they keep after it.
		tut_beat("Patterns live on the pattern key. Press it once and the routine swaps back to the plain weave.  [%s]" % kp,
			"press_p", 1, n, {"pattern": p, "prompt": "pattern", "key": kp}),
		tut_say("In any practice, %s chooses your pattern - the card at the bottom left always names the one running." % kp),
	]


func begin_tutorial(id: String) -> void:
	tut_prev_prop = prop_type   # captured before tut_setup_step can overwrite it below
	tut_id = id
	tut_step = 0
	tut_active = true
	# EVERY LESSON OPENS IN THE BACKYARD, PLAIN (2026-07-29, Louis: "a tutorial should be
	# in the backyard outfit (which is free for the player), without any special things
	# or props"). A lesson is a controlled space (see the block below, "nothing primed
	# walks in from the last session") and the costume/backdrop were the one thing still
	# leaking the player's real career in: `wearing()` gates every piece of the wardrobe
	# unconditionally, so a bought top hat or glow suit was drawn straight into a first-
	# timer's very first lesson. `view_venue` is the existing preview override built for
	# exactly this ("which venue palette to draw", regardless of real progression) - see
	# tut_finish for the matching restore. `wearing()` itself now also refuses while
	# tut_active, which is the other half: see its own comment.
	view_venue = 0
	tut_hold.clear()      # no beat from a previous lesson is still waiting on a press
	tut_last_throw = LEFT
	game_state = ST_PLAY
	started = true            # a lesson is its own thing, not the opening "first run"
	_slow_cur = tut_slow()    # a lesson opens ALREADY thick, it does not ease in over the
							  # ~4s the 0.0025 ramp would take from a standing start
	# a lesson is a controlled space: nothing primed or toggled walks in from the last
	# session, so step one always starts from the state its text describes
	toggle_on = -1
	trick_primed = false
	tennis_ball = null
	spin_until = -999
	# ...and nothing LATCHED walks in either (Louis: "the tutorial is broken again -
	# space does nothing"). A performance that ended in collapse and was left through
	# the pause menu kept `collapsing` true forever - only start_run and the on-stage
	# landing of the last prop ever cleared it, and a lesson passes through neither.
	# With it stuck, _read_inputs returned immediately: Space, throws and catches all
	# dead, while the event keys (Escape) still worked. Every flag that can gate the
	# poll is cleared here, so a lesson always opens with live hands.
	collapsing = false
	results_open = false
	falling.clear()
	# the key that ACTIVATED the lesson (Space or Enter on the hub row) is still held
	# right now. Without seeding, the first play frame read that held Space as a fresh
	# edge and fired the trick BEFORE the player saw step one - the step then cleared
	# (or toggled) itself, and the player's own later press did the opposite of the
	# banner's ask. That is the "Space does not work in lessons" bug.
	seed_input_edges()
	tut_setup_step()


func tut_step_hand(step: Dictionary) -> int:
	# a step's "hand" is which hand it TEACHES FROM, and it is SYMBOLIC, not a literal
	# side: RIGHT means the player's strong hand, so a left-handed player's lesson mirrors
	# rather than starting every drill in their weak hand. The one and only place this
	# gets resolved into a real hand index - every reader of step["hand"] must come
	# through here (2026-07-30 fix: two readers used to each resolve it their own way,
	# and one of them, tut_do/tut_free's own builder, was not resolving it at all - it
	# passed the already-real `dominant_hand` value straight through, which a SECOND
	# resolution here then silently mirrored again for anyone actually left-handed).
	return dominant_hand if int(step.get("hand", RIGHT)) == RIGHT else other(dominant_hand)


func tut_setup_step() -> void:
	var steps := tut_lesson(tut_id)
	var step: Dictionary = steps[clampi(tut_step, 0, steps.size() - 1)]
	mode = MODE_TRAIN
	var want_prop := int(step["prop"])
	var want_n := int(step["balls"])
	var start_hand := tut_step_hand(step)
	# a met goal flows into the next step, but ANY change in the ball COUNT deals a
	# clean, fully-held table rather than topping up mid-air (Louis): adding a ball to a
	# hand that a live ball is already dropping into made the current one uncatchable -
	# a forced drop right at "two balls now". Same count (a trick/pattern drill) flows on.
	var fresh := balls.is_empty() or prop_type != want_prop or balls.size() != want_n
	# ...AND NOBODY IS HANDED THE CONTROLS MID-FLIGHT (2026-07-31, Louis: "there was also a
	# rule about not giving control to the player while any balls are in the air"). A `free`
	# beat is the one place the helping stops - no guard, no stopped world, a drop is real -
	# so opening one with a prop already falling hands the player somebody else's throw to
	# rescue. Counting beats until the air happens to be empty is not a rule, it is a
	# coincidence that has to be re-derived every time the choreography changes (it was
	# wrong for the three-ball section, which ended on two catches and still had one up), so
	# a free beat simply DEALS ITSELF CLEAN whenever anything is still flying. That also
	# fixes the hands: a fresh deal honours the step's own `stack`, where flowing on left the
	# two-ball drill starting with both props in the weak hand.
	# The same beat also re-deals when the HANDS are not where the drill starts from: the
	# two-ball section can end with both props in the weak hand, which is a legal position
	# and not the one "keep that going, on each side in turn" is describing.
	if String(step["goal"]) == "free" and (balls_airborne() > 0
			or (int(step.get("stack", -1)) >= 0 and stack(tut_step_hand(step)).size() != int(step["stack"]))):
		fresh = true
	prop_type = want_prop
	num_balls = want_n
	# a pattern lesson forces its own pattern FOR THE LESSON ONLY: pattern_sel (the
	# player's own P choice, the one that persists) is never touched here - a lesson
	# demonstrating Columns must not walk out with Columns selected (Louis). A step
	# without a "pattern" key keeps whatever is running when the juggle flows on, and
	# falls back to Cascade only on a fresh deal.
	if step.has("pattern"):
		pattern = int(step["pattern"])
	elif fresh:
		pattern = CASCADE
	# a trick lesson selects (and de-arms) its trick, so the step starts from a known
	# state: Space will act on exactly this trick. A "switch it OFF" step is the one
	# exception - it must start with the toggle RUNNING (the thing to switch off),
	# otherwise the player's one press flips it back ON and the step cannot complete
	if step.has("trick"):
		trick_sel = int(step["trick"])
		toggle_on = trick_sel if String(step["goal"]) == "trick_off" else -1
		trick_primed = false
		tennis_ball = null
	if fresh:
		balls.clear()
		_stack_l.clear()
		_stack_r.clear()
		popups.clear()
		charging = [false, false]
		applause = 0.7
		streak = 0
		caught = 0
		dropped = 0
		running = false
		stamina_max = 100.0 + 9.0 * float(endurance)
		stamina = stamina_max
		hpos = [inner_pos(LEFT), inner_pos(RIGHT)]   # rest inward, everywhere (2026-07-31, Louis)
		hclose = [0.0, 0.0]
		catch_flash = [-999, -999]
		throw_kick = [-999, -999]
		rng.seed = 20260705
		# deal the balls; a single-ball step starts in the exact hand it is teaching, and
		# so does the two-ball step (Louis: both stacked in one hand, so throw-throw-
		# catch-catch is the only sequence available - three and up split through
		# deal_side, which puts the odd prop in the DOMINANT hand like every other deal)
		# A STEP MAY SAY EXACTLY HOW THE HANDS START (2026-07-29). `stack` is how many go in
		# the DOMINANT hand, which is the whole difference between the two-ball drill (one
		# each, so throw-throw is available) and the three-ball one (two in the strong hand,
		# the real cascade opening). Without it the deal follows the old rule, which is
		# right for every lesson that is not the scripted basics.
		var want_stack := int(step.get("stack", -1))
		for i in num_balls:
			var b := Ball.new()
			b.state = STATE_HAND
			b.kind = prop_type
			b.color = ball_color(i) if prop_type == PROP_BALLS else prop_color(prop_type)
			b.spin_dir = 1.0 if i % 2 == 0 else -1.0
			balls.append(b)
			if want_stack >= 0:
				stack(start_hand if i < want_stack else other(start_hand)).append(b)
			else:
				stack(deal_side(i) if num_balls > 2 else start_hand).append(b)
	else:
		# top up: the new step wants more balls, so they join the hands that are already
		# holding - through top_up_side, so the dominant hand still ends with the odd one
		while balls.size() < want_n:
			var b := Ball.new()
			b.state = STATE_HAND
			b.kind = prop_type
			b.color = ball_color(balls.size()) if prop_type == PROP_BALLS else prop_color(prop_type)
			b.spin_dir = 1.0 if balls.size() % 2 == 0 else -1.0
			balls.append(b)
			stack(top_up_side()).append(b)
	tut_count = 0
	tut_threw_l = false
	tut_threw_r = false
	tut_caught_l = false
	tut_caught_r = false
	tut_throws = 0
	tut_held_throws = 0
	tut_hand_picked = false
	tut_tricks = 0
	tut_keys = 0
	tut_advance_at = -1
	# the guided beat re-arms with a BREATH: nothing freezes the world until the step's
	# own title has had TUT_STEP_READ ticks on screen, so a step never opens mid-ask.
	# The feed alternation starts opposite the teaching hand, so the very first thing
	# asked for is a throw from the hand the step deals into.
	tut_hold.clear()
	tut_hold_end = tick + TUT_STEP_READ
	tut_speech_tick = atick()    # the line starts arriving now, a letter at a time
	tut_speech_said = 0
	tut_last_throw = other(start_hand)
	if _demo:
		print("TUTTRACE setup step=%d goal=%s balls=%d held=%d/%d air=%d slow=%.2f guide=%s juggle=%s tick=%d" % [tut_step, String(step["goal"]), num_balls, stack(LEFT).size(), stack(RIGHT).size(), balls_airborne(), tut_slow(), str(step.get("guide", false)), str(step.get("juggle", false)), tick])
	# a step with nothing to DO (the key legend) is already met the moment it opens, so
	# its Enter prompt is live immediately rather than after some press that never comes.
	# Safe to ask now: every counter above is zeroed, so a step with a real goal cannot
	# read as done here. Must stay AFTER tut_advance_at = -1, which tut_check gates on.
	tut_check()


func tut_step_data() -> Dictionary:
	# the current lesson step, always in range - the one source every tutorial reader uses
	var steps := tut_lesson(tut_id)
	return steps[clampi(tut_step, 0, steps.size() - 1)]


# -----------------------------------------------------------------------------
# THE GUIDED BEAT (2026-07-27, Louis). On the 50% and 25% passes of any drill the
# world does not merely slow down, it STOPS at every action the drill asks for and
# will not move again until the player makes that action. What it asks for is read
# off the live sim, never scripted, so it works for one ball, for a five-ball
# fountain, for a Shower, for a trick lesson - anything the lesson engine can deal.
#
# The three questions it asks, in the order a juggler asks them:
#
#   1. Does this step's own KEY want pressing right now? (arm the trick, spin) -
#      first in the beat, because a trick has to be armed BEFORE the throw it shapes.
#   2. Is a prop about to land? A hand that still holds one is asked to THROW it and
#      then CATCH ("J then K"): that exchange, repeated, IS the cascade. An empty
#      hand is asked only to catch.
#   3. Is the air emptier than the pattern needs? Then the hand whose turn it is
#      feeds another prop up. Turns alternate, which is what makes a cascade cross.
#
# Presses out of turn are swallowed silently (never a whiff, never a wrong throw), and
# the asked-for press always succeeds - see on_catch's own `sure`, which takes the
# failure branches out of it while a beat is being guided. Failing a beat the SCRIPT
# dealt teaches nothing; the full-speed pass is where failing means something.
# -----------------------------------------------------------------------------
func tut_guided() -> bool:
	# is the step now running one of the two slow, hand-held passes?
	return tut_active and bool(tut_step_data().get("guide", false))


func tut_holding() -> bool:
	return tut_active and not tut_hold.is_empty()


func tut_frozen() -> bool:
	# true while EITHER stopped-world mechanism has the clock - the older lessons'
	# tut_hold list, or the basics' own "do" beat. Kept separate from tut_holding()
	# on purpose: that function also gates what on_catch/on_throw_press are allowed to
	# DO (a frozen beat's catch must always land), and its own tut_hold_names check
	# would silently swallow every press during a "do" freeze, since tut_hold is empty
	# for it. This is purely for drawing "is the world visibly stopped right now".
	return tut_holding() or (tut_active and tut_do_step() and tut_do_ready()) or tut_catch_hold()


func tut_style() -> String:
	# which of the two ways of holding a pattern this step is teaching (see TUT_BEGINNER)
	return String(tut_step_data().get("style", TUT_BEGINNER))


func tut_air_target() -> int:
	# how many props the beat keeps in the air at this count - the whole difference
	# between the two styles, in one number.
	#   ADVANCED puts EVERYTHING up and keeps the hands empty.
	#   BEGINNER keeps two in the hands, so the air holds the rest.
	# Two props and fewer are drills rather than patterns: one has nothing to keep up,
	# and two is Louis's "throw, throw, catch, catch", where both go up by design.
	if tut_style() == TUT_ADVANCED:
		return num_balls
	return num_balls if num_balls <= 2 else num_balls - 2


func tut_open_gap() -> int:
	# while the air is still FILLING, the opening throws are spaced by the pattern's own
	# beat (airtime over the count) rather than the tight TUT_HOLD_GAP. An advanced
	# opening puts every prop up before catching any of them, and three taps eight ticks
	# apart would bring all three down within a quarter-second of each other - a pile-up
	# the player is then asked to sort out. Spread, they arrive in the rhythm the pattern
	# actually runs at, which is the thing "throw them at a speed you judge" means.
	if balls_airborne() >= tut_air_target():
		return TUT_HOLD_GAP
	return maxi(TUT_HOLD_GAP, int(float(BASE_AIR) * count_air_scale() / float(maxi(1, num_balls))))


func tut_feed_hand() -> int:
	# whose turn it is to put another prop up: the hand that did NOT throw last, unless
	# it is empty. Returns -1 when neither hand is holding anything to throw.
	var h := other(tut_last_throw)
	if stack(h).is_empty():
		h = other(h)
	return h if not stack(h).is_empty() else -1


func tut_due_key(step: Dictionary) -> Array:
	# the one key this step exists to teach, asked for only at a moment when pressing it
	# would actually DO something - the same check that fixed the Spin prompt in
	# tut_action_cue, now asked of the paused world too, so the beat can never freeze
	# waiting on a press the trick gate would silently refuse.
	if String(step["goal"]) != "trick_use":
		return []
	var ti := int(step.get("trick", trick_sel))
	if ti < 0 or ti >= TRICKS.size() or tut_tricks >= int(step.get("need", 1)):
		return []
	var t: Dictionary = TRICKS[ti]
	var e := {"act": "trick", "hand": -1, "rank": 0, "ok": false,
		"key": String(k_trick()[0]), "what": String(t["name"]).to_upper()}
	if String(t["kind"]) == "live":
		if balls_airborne() >= int(t["min_air"]) and not spinning():
			return [e]
		return []
	if not trick_primed:
		e["what"] = "arm %s" % String(t["name"]).to_upper()
		return [e]
	return []


func tut_due_actions() -> Array:
	# everything the paused world is entitled to ask for at this instant (see the
	# region comment above). Ranks order the beat: trick, then throw, then catch.
	var step := tut_step_data()
	var out: Array = tut_due_key(step)
	# the soonest prop arriving at each hand, if it is close enough to be this beat.
	# A negative lead (the gap let it slip past) still counts - it is still catchable,
	# and far inside a lesson's W_LATE window, so the guided catch is still a Perfect.
	var soon := [9999, 9999]
	for b in balls:
		if b.state != STATE_FLIGHT:
			continue
		var d := b.land_tick - tick
		if d > TUT_EXCHANGE_LEAD:
			continue
		var h := clampi(b.to_hand, 0, 1)
		if d < soon[h]:
			soon[h] = d
	var kt := k_throw()
	var kc := k_catch()
	var adv := tut_style() == TUT_ADVANCED
	var side := func(h: int) -> String: return "left" if h == LEFT else "right"
	for h: int in [LEFT, RIGHT]:
		if soon[h] > TUT_EXCHANGE_LEAD:
			continue
		var thr := {"act": "throw", "hand": h, "ok": false, "key": String(kt[h]), "what": "throw  %s hand" % side.call(h)}
		var cat := {"act": "catch", "hand": h, "ok": false, "key": String(kc[h]), "what": "catch  %s hand" % side.call(h)}
		if adv and stack(h).is_empty():
			# ADVANCED: nothing is being held, so the prop is caught and sent straight
			# back up - catch, THEN throw. The same two keys a beginner presses, in the
			# opposite order, which is exactly what separates the two styles.
			cat["rank"] = 1
			thr["rank"] = 2
			out.append(cat)
			out.append(thr)
		else:
			# BEGINNER: the receiving hand is holding one, so it is emptied UNDER the
			# incoming prop and then receives it - throw, THEN catch. (An advanced beat
			# also lands here if a hand is unexpectedly full, e.g. just after a drop was
			# topped up: clearing it first is the right recovery either way.)
			if not stack(h).is_empty():
				thr["rank"] = 1
				out.append(thr)
			cat["rank"] = 2
			out.append(cat)
	if not out.is_empty():
		return out
	# nothing arriving and no key owed: does the pattern want another prop in the air?
	# This is the ONLY place a lesson ever asks for a single key on its own, and it
	# happens exactly n-2 times for a beginner and n times for an advanced juggler -
	# the opening, and nothing after it (Louis).
	if balls_airborne() < tut_air_target():
		var fh := tut_feed_hand()
		if fh >= 0:
			out.append({"act": "throw", "hand": fh, "rank": 1, "ok": false,
				"key": String(kt[fh]), "what": "throw  %s hand" % side.call(fh)})
	return out


func tut_hold_update() -> void:
	# open a beat if the world has something to ask for. Never while one is already
	# open, never before the step has been readable for a moment, and never once the
	# step's goal is MET - a won step goes back to being free play, however slow it is,
	# because "keep practising as long as you like" has to actually mean that.
	if not tut_hold.is_empty() or not tut_guided():
		return
	if collapsing or results_open or tut_advance_at >= 0:
		return
	# NOBODY IS ASKED TO ACT ON A SENTENCE THEY HAVE NOT READ YET (2026-08-08, Louis: the
	# tutorial should be smooth and logical "qua pauses and help").
	#
	# The two clocks were never introduced to each other. A line arrives at TUT_SPEECH_CPS,
	# 46 characters a second, so an ordinary instruction takes over two seconds to finish
	# typing - while the earliest a beat could stop the world was TUT_STEP_READ + TUT_HOLD_GAP
	# after the step opened, which is 38 ticks, a THIRD of a second. So the world froze and
	# demanded a specific key while the sentence naming that key was still appearing, which
	# is the worst possible moment to freeze: the player is reading, and the game has stopped
	# and is waiting for them.
	#
	# The breath that matters is not a fixed number of ticks, it is "the instruction is on
	# screen". TUT_STEP_READ stays as the floor underneath it.
	#
	# ...EXCEPT FOR A PROP THAT IS ALREADY COMING DOWN, which is the whole reason this test
	# sits below `landing` rather than at the top of the function. A catch beat is about
	# something the script already threw; postponing it until a sentence finishes typing
	# does not give the player more time, it drops the ball. Those beats open on time and
	# the line is snapped to its full length instead, so the freeze never lands mid-word.
	if tick - tut_hold_end < TUT_HOLD_GAP:
		return
	var due := tut_due_actions()
	if due.is_empty():
		return
	# a beat with a CATCH in it is about a prop already on its way down and may never be
	# postponed - it would sail past the hand. Only a bare FEED throw (the opening, and
	# only the opening) waits out the wider pattern-beat spacing, which is what stops an
	# advanced start putting every prop up at once and raining them back down together.
	var landing := false
	for e in due:
		if String(e["act"]) == "catch":
			landing = true
			break
	if not landing and tick - tut_hold_end < tut_open_gap():
		return
	if not landing and not tut_speech_done():
		return
	due.sort_custom(func(a, b): return int(a["rank"]) < int(b["rank"]))
	tut_hold = due
	tut_hold_at = tick
	# a beat that had to open early (a prop was already falling) takes the rest of its line
	# with it: if the game is stopping to ask for a key, the sentence naming that key is
	# finished being coy about it
	if not tut_speech_done():
		tut_speech_tick = -100000.0
	play_sfx("ui", -20.0)


func tut_hold_rank_of(entries: Array) -> int:
	# the lowest rank still outstanding in a list of beat actions - shared by the live
	# hold and by --demo, which walks the same list without ever opening a hold
	var r := 99
	for e in entries:
		if not bool(e.get("ok", false)):
			r = mini(r, int(e["rank"]))
	return r


func tut_hold_rank() -> int:
	# the rank the beat will hear right now: a press for a LATER part of the beat is
	# not accepted early, so the lesson can never teach catch-then-throw
	var r := 99
	for e in tut_hold:
		if not bool(e.get("ok", false)):
			r = mini(r, int(e["rank"]))
	return r


func tut_hold_names(act: String, h: int) -> bool:
	# does the open beat still want this action? (h < 0 asks "any hand"). Queries only:
	# the handler does the deed and then calls tut_hold_mark to bank it.
	if not tut_holding():
		return false
	var rank := tut_hold_rank()
	for e in tut_hold:
		if bool(e.get("ok", false)) or int(e["rank"]) != rank:
			continue
		if String(e["act"]) == act and (h < 0 or int(e["hand"]) < 0 or int(e["hand"]) == h):
			return true
	return false


func tut_hold_mark(act: String, h: int) -> void:
	# the asked-for thing has actually HAPPENED. When the last of them has, the world
	# moves again and the next beat may not stop it for TUT_HOLD_GAP ticks, so the
	# throw and the catch just made are seen happening rather than teleporting.
	if not tut_holding():
		return
	for e in tut_hold:
		if bool(e.get("ok", false)):
			continue
		if String(e["act"]) == act and (int(e["hand"]) < 0 or h < 0 or int(e["hand"]) == h):
			e["ok"] = true
			break
	for e in tut_hold:
		if not bool(e.get("ok", false)):
			return
	tut_hold.clear()
	tut_hold_end = tick


func tut_hold_abort() -> void:
	# something took the beat's subject away (a drop, an R re-deal): let the world go
	# rather than sit frozen waiting on a catch that can never come
	if tut_hold.is_empty():
		return
	tut_hold.clear()
	tut_hold_end = tick


func tut_hold_autoplay() -> void:
	# --demo has no hands, so it performs the beat itself, one rank at a time: a dev
	# run still walks a guided lesson end to end (never in normal play)
	var rank := tut_hold_rank()
	for e in tut_hold:
		if bool(e.get("ok", false)) or int(e["rank"]) != rank:
			continue
		match String(e["act"]):
			"throw": on_throw_press(int(e["hand"]))
			"catch": on_catch(int(e["hand"]))
			"trick": on_trick()
		return


# -----------------------------------------------------------------------------
# THE STOPPED WORLD, FOR A "do" BEAT (2026-07-29 evening, Louis: "you are not pausing
# the game enough for the player to learn... pause the game at the perfect frame for
# catching (show them the best timing) and wait for the player to hit [the key]").
# THE BASICS above (tut_do) already name one exact key and refuse Enter until it is
# pressed - what they never did is stop the WORLD while they wait, so a slow player
# could watch the very thing being taught fall past its own window. This holds the
# clock exactly the way tut_hold does for the older lesson types (same trick: skip the
# tick advance, keep polling input, let cine_tick breathe) but the gate is simpler,
# because a `do` beat already knows the one action it wants with no derivation needed.
# A THROW has no timing of its own, so it holds from the moment the line finishes; a
# CATCH lets the world run at real speed until the ball reaches ITS OWN land_tick - the
# centre of every catch window - and holds there, so the beat always shows the true
# perfect frame rather than an arbitrary pause. The three FREE checkpoints (1/2/3 balls)
# and the "hand"/"read" beats are deliberately not `do` beats, so they are untouched:
# free play is exactly where this must not apply.
# -----------------------------------------------------------------------------
func tut_do_step() -> bool:
	if not tut_active or tut_advance_at >= 0 or collapsing or results_open:
		return false
	var g := String(tut_step_data().get("goal", ""))
	return g == "throw_l" or g == "throw_r" or g == "catch_l" or g == "catch_r"


func tut_do_ready() -> bool:
	# should the world actually be held right now, this frame?
	var step := tut_step_data()
	var g := String(step.get("goal", ""))
	if g == "throw_l" or g == "throw_r":
		# THE PEAK HOLD (2026-07-30). The `peak` flag has been carried on the three-ball step
		# since the script was written and nothing read it - Louis's "pause and highlight the
		# first ball at its peak and prompt the second throw". Without it this beat froze the
		# world the instant it began, which is the WRONG instant: it asks the player to throw
		# the second ball UNDER the first, and the first has only just left the hand. So they
		# were taught to fire both at once, which is not a cascade, and the line telling them
		# to wait was contradicted by the game stopping and demanding a key.
		if bool(step.get("peak", false)):
			return tut_at_peak()
		return true
	# A CATCH BEAT HOLDS AS THE PROP COMES IN, not once it has arrived. It used to be
	# `tick >= b.land_tick`: the world ran at full speed for the whole flight and only stopped
	# at the arrival tick itself, so every press a beginner made on the way in was read as a
	# real, ungraded, un-helped catch - a whiff, or a mistimed one that dropped the ball. The
	# guard is the same TUT_CATCH_GUARD the stretch-wide hold below uses, so the two cannot
	# disagree about when a prop is "coming in".
	# THE SOONEST PROP, NOT THE FIRST ONE IN THE ARRAY (2026-07-31, Louis: "it should always
	# be the first thrown ball that needs to be caught"). This used to `return` on whichever
	# prop the `balls` list happened to reach first, so with two bound for the same hand it
	# could time the freeze off the LATER arrival and let the earlier one sail past the
	# stopped-world guard it exists to provide. tut_landing_ball answers the question once,
	# for this and for the aura that marks the same prop on screen.
	var h := LEFT if g == "catch_l" else RIGHT
	var lb := tut_landing_ball(h)
	if lb == null:
		return false
	return tick >= lb.land_tick - TUT_CATCH_GUARD


func tut_landing_ball(h: int) -> Ball:
	# THE PROP THIS HAND MUST DEAL WITH NEXT: of everything in flight bound for hand h, the
	# one arriving SOONEST - which, at the one height a lesson throws at, is always the one
	# thrown first. Returns null when nothing is on its way. (The odd-count middle ball
	# belongs to whichever hand takes it, the same exception tut_incoming/tut_guard_hand make.)
	var best: Ball = null
	for b in balls:
		if b.state != STATE_FLIGHT:
			continue
		if b.to_hand != h and b != col_mid_ball:
			continue
		if best == null or b.land_tick < best.land_tick:
			best = b
	return best


func tut_focus_ball() -> Ball:
	# THE ONE PROP THE LESSON IS ASKING ABOUT RIGHT NOW (2026-07-31, Louis: "you should
	# emphasize - yellow aura circle around the ball - ONLY the ball that currently requires
	# an action, not the one from the previous action"). Everything a lesson beat asks for is
	# about exactly one prop: a catch is about the prop coming down at that hand, a throw is
	# about the prop that press would send up (do_throw pops the FRONT of the stack, so that
	# is the one, not whichever was added last). Answered here once so the aura, the key
	# prompt and the freeze can never disagree about which prop is the subject.
	if not tut_active:
		return null
	# THE CATCH GUARD OUTRANKS THE SCRIPT, because it outranks it in the sim too. A helped
	# stretch stops the world whenever ANY prop comes within TUT_CATCH_GUARD of landing,
	# wherever the script has got to (tut_catch_hold) - so the lesson regularly freezes for a
	# prop the current beat never named, and during the two-ball opening it always does: the
	# first ball's own arrival lands inside the beat that is still asking for the second
	# throw. Whatever the world stopped FOR is, by definition, "the ball that currently
	# requires an action", so it takes the aura ahead of the beat's own subject.
	var gh := tut_guard_hand()
	if gh >= 0 and tut_catch_hold():
		return tut_landing_ball(gh)
	if tut_holding():
		# an older lesson's multi-key beat: its lowest outstanding rank is the live ask
		var rank := tut_hold_rank()
		for e in tut_hold:
			if bool(e.get("ok", false)) or int(e["rank"]) != rank:
				continue
			var eh := int(e["hand"])
			if eh < 0:
				continue
			if String(e["act"]) == "catch":
				return tut_landing_ball(eh)
			if String(e["act"]) == "throw":
				return stack(eh)[0] if not stack(eh).is_empty() else null
		return null
	if tut_advance_at >= 0:
		return null   # this beat is answered; nothing is owed until the next one opens
	var g := String(tut_step_data().get("goal", ""))
	if g == "catch_l" or g == "catch_r":
		return tut_landing_ball(LEFT if g == "catch_l" else RIGHT)
	if g == "throw_l" or g == "throw_r":
		var th := LEFT if g == "throw_l" else RIGHT
		return stack(th)[0] if not stack(th).is_empty() else null
	return null


func tut_at_peak() -> bool:
	# is a prop sitting at the top of its arc right now? Read off the SIM (half way between the
	# throw and the arrival is the apex of a parabola, whatever the height or the airtime), so
	# it is true for any throw the player actually made rather than for a scripted one.
	for b in balls:
		if b.state != STATE_FLIGHT:
			continue
		var apex := b.launch_tick + int(round(float(b.land_tick - b.launch_tick) * 0.5))
		if absi(tick - apex) <= TUT_PEAK_WINDOW:
			return true
	return false


func tut_quiet_fx() -> bool:
	# NO CATCH FLOURISH ON A CATCH THE LESSON IS ABOUT TO STOP THE WORLD ON (2026-07-31,
	# Louis: "remove the catching special effects while the game pauses, because it looks
	# bad - either pause once the effect is gone, or remove the effect for catches that
	# will be paused"). Of his two options this is the second, and it is the only one that
	# is actually available: a guided beat freezes because a prop is CLOSE TO LANDING, so
	# "wait for the effect to finish first" would mean waiting past the very arrival the
	# freeze exists to protect - the pause cannot be deferred without giving up its whole
	# job. Every popup and particle a catch fires is therefore skipped for the stretch of
	# the lesson where the world is being held for the player.
	#
	# It costs nothing in feedback, either: a helped catch is graded PERFECT by
	# construction (see on_catch's `sure`), so "PERFECT" over a hand the game stopped
	# itself to demand a press from was never telling the player anything they did. The
	# sounds still play, and `free` practice - which is not helped, and where a catch is
	# genuinely earned - keeps the full flourish.
	return tut_active and tut_helped()


func tut_helped() -> bool:
	# IS THE PLAYER BEING HELPED RIGHT NOW, as opposed to trying it out? Everything in a lesson
	# is helped except a `free` beat - which is where Louis explicitly wants dropping to be
	# possible ("he may try out and drop during the 'try it out and press enter when ready'
	# phases"). This is deliberately NOT gated on tut_advance_at the way tut_do_step is: the
	# window where a satisfied beat waits for Enter is exactly where the drops were happening.
	# The player throws, the beat is met, the banner asks for Enter - and the ball they just
	# threw goes on flying, unhelped, while they read the line.
	if not tut_active or collapsing or results_open:
		return false
	return String(tut_step_data().get("goal", "")) != "free"


func tut_guard_hand() -> int:
	# which hand has a prop coming in inside TUT_CATCH_GUARD, or -1. The odd-count middle ball
	# belongs to whichever hand takes it, so it guards the one it is nominally flying to.
	var best := -1
	var best_d := TUT_CATCH_GUARD + 1
	for b in balls:
		if b.state != STATE_FLIGHT:
			continue
		var d := b.land_tick - tick
		if d < -MISS_GRACE or d > TUT_CATCH_GUARD:
			continue
		if d < best_d:
			best_d = d
			best = clampi(b.to_hand, 0, 1)
	return best


func tut_catch_hold() -> bool:
	# THE STRETCH-WIDE HOLD. A helped lesson stops the world whenever a prop is about to land,
	# whatever the script is currently asking for - so a beginner cannot drop while they are
	# being taught, which is the whole of Louis's note. A `do` catch beat reaches the same state
	# through tut_do_ready above; this covers the two cases that one cannot, and they are the
	# two that were actually losing balls: a beat already satisfied and waiting on Enter, and a
	# `say` beat that happens to be on screen while something is in the air.
	return tut_helped() and tut_guard_hand() >= 0


func tut_do_autoplay() -> void:
	# --demo still has no hands: it presses the one key the beat is holding for
	match String(tut_step_data()["goal"]):
		"throw_l": on_throw_press(LEFT)
		"throw_r": on_throw_press(RIGHT)
		"catch_l": on_catch(LEFT)
		"catch_r": on_catch(RIGHT)


func tut_incoming(h: int) -> bool:
	# is any ball in flight dropping toward hand h right now? (the odd-count middle ball
	# either hand may take, so it counts for both). Used to keep a top-up off a busy hand.
	for b in balls:
		if b.state == STATE_FLIGHT and (b.to_hand == h or b == col_mid_ball):
			return true
	return false


func tut_reset_step() -> void:
	# R re-deals THIS step from a clean hold, so a tangle is never a dead end - the same
	# controlled start it began with, no forced drop, no stray state carried in (Louis)
	balls.clear()
	_stack_l.clear()
	_stack_r.clear()
	charging = [false, false]
	tut_advance_at = -1
	tut_hold_abort()   # whatever beat was frozen was about props that no longer exist
	tut_setup_step()   # balls now empty, so it deals the step fresh
	play_sfx("ui2", -13.0)


func tut_demo_reset() -> void:
	# the basics lesson's "press R" step: the press must both DO the thing (the balls
	# re-deal, so the key is seen working) and COUNT toward the goal - tut_reset_step
	# cannot be used as-is because it zeroes the step's counters, which would wipe the
	# very press being taught. So: spill the hands, let tut_maintain re-stock them,
	# and bank the press.
	balls.clear()
	_stack_l.clear()
	_stack_r.clear()
	charging = [false, false]
	tut_keys += 1
	play_sfx("ui2", -13.0)
	tut_check()


func tut_demo_pattern_off() -> void:
	# the pattern lesson's "press P" step: one press visibly hands the routine back to
	# the plain weave, so the player SEES that P is how patterns are chosen - without
	# ever touching pattern_sel (their own persistent choice)
	pattern = CASCADE
	col_air_ref = -1.0
	col_mid_ball = null
	tennis_ball = null
	tut_keys += 1
	play_sfx("ui2", -13.0)
	tut_check()


func tut_on_throw(h: int, hold: int = 0) -> void:
	if h == LEFT:
		tut_threw_l = true
	else:
		tut_threw_r = true
	tut_throws += 1      # the `free` beats count real throws as well as catches
	if hold >= maxi(10, HOLD_MAX / 3):
		tut_held_throws += 1
	tut_last_throw = h   # feed throws alternate off this, which is what crosses a cascade
	tut_hold_mark("throw", h)
	tut_check()


func tut_on_catch(juggled: bool, hand: int = -1) -> void:
	# Once a free-practice target is complete, its displayed achievement is banked. Extra
	# catches (including collecting the pattern to continue) cannot reset 10 back to zero.
	var current := tut_step_data()
	if String(current.get("goal", "")) == "free" and tut_advance_at >= 0:
		tut_count = int(current.get("need", tut_count))
		return
	# WHICH HAND CAUGHT matters now: the basics ask for one named key at a time ("catch it
	# with D"), so a catch in the wrong hand must not clear the beat.
	if hand == LEFT:
		tut_caught_l = true
	elif hand == RIGHT:
		tut_caught_r = true
	# a step marked "juggle" only accepts catches that leave a ball in the air behind
	# them (juggling_catch): the two- and three-ball steps must not be clearable by
	# throwing one ball at a time, which is the thing they exist to teach against
	# (Louis). The run has to be CONSECUTIVE - a solo catch puts the count back to zero -
	# because "there is always a ball in the air" is a property of a stretch of juggling,
	# not a tally of good moments. The banner (and the step holding open forever) is
	# the teaching; a solo catch just quietly fails to advance, no scolding popup.
	var step := tut_step_data()
	if bool(step.get("juggle", false)) and not juggled:
		if _demo:
			print("TUTTRACE solo-catch rejected at tick=%d (count was %d)" % [tick, tut_count])
		if tut_count > 0:
			play_sfx("whiff", -14.0)
		tut_count = 0
		return
	# ...and a step that TEACHES A STYLE only accepts catches made in that style
	# (2026-07-27, Louis: "when teaching the advanced cascade: make sure only that one
	# scores, not the beginner cascade"). The guided passes enforce the order by
	# construction, so this is really about the last pass, where the player is free -
	# and free to fall back into the rhythm they already know without noticing.
	#
	# The tell is not the keypress order, which is gone by the time a catch resolves:
	# it is HOW FULL THE AIR IS at the instant the prop lands. An advanced juggler has
	# just caught from a sky holding everything, so num_balls - 1 are still up; a
	# beginner threw first from a hand that was holding, so one fewer is. That single
	# comparison is the whole difference between the two styles, measured rather than
	# remembered. Two props and fewer have no styles to tell apart.
	if step.has("style") and num_balls >= 3:
		var want_adv := String(step["style"]) == TUT_ADVANCED
		var is_adv := balls_airborne() >= num_balls - 1
		if want_adv != is_adv:
			if tut_count > 0:
				play_sfx("whiff", -14.0)
			set_trick_msg("that was the BEGINNER exchange  -  catch first, then throw" if want_adv
				else "that was the ADVANCED exchange  -  throw first, then catch")
			tut_count = 0
			return
	var cap := int(step.get("need", 0))
	if String(step.get("goal", "")) == "free" and cap > 0:
		tut_count = mini(tut_count + 1, cap)
	else:
		tut_count += 1
	tut_check()


func tut_check() -> void:
	if tut_advance_at >= 0:
		return   # already cleared this step, just waiting for the throw to land
	var steps := tut_lesson(tut_id)
	var step: Dictionary = steps[clampi(tut_step, 0, steps.size() - 1)]
	var goal := String(step["goal"])
	var done := false
	match goal:
		"throw_r": done = tut_threw_r
		"throw_l": done = tut_threw_l
		"catch_r": done = tut_caught_r
		"catch_l": done = tut_caught_l
		"hand": done = tut_hand_picked
		"free": done = tut_count >= int(step.get("need", 0)) and tut_throws >= int(step.get("throws", 0))
		# The high throw must be watched back into the hand. Clearing on release erased
		# the ball on the next dialogue step before the player could see the arc finish.
		"hold_throw": done = tut_held_throws >= int(step.get("need", 1)) and tut_count >= 1
		"trick_on": done = toggle_on == int(step.get("trick", -1))   # the toggle is running
		"trick_off": done = toggle_on < 0                             # ...and now switched off
		"trick_use": done = tut_tricks >= int(step["need"])           # arm/live: reward_trick fired
		"press_r", "press_p": done = tut_keys >= int(step["need"])   # the key itself is the goal
		"read": done = true   # nothing to do but read it: Enter is live from the first frame
		_: done = tut_count >= int(step["need"])
	if done:
		tut_advance_at = tick
		# the beat that was frozen is over too: a WON step goes back to free play, so a
		# player who wants to keep going is not stopped at every prop from here on
		tut_hold_abort()
		if goal != "read":
			play_sfx("streak", -10.0)
		# A SUCCEEDED ACTION MOVES ON BY ITSELF NOW (2026-07-30, Louis: "i shouldn't have
		# to press enter when i succesfully do what it asks ... should immediately jump to
		# the next dialogue window"). Only two goals still wait on the player's own Enter:
		# `read`, which IS a line of dialogue with nothing to press but Enter, and `free`,
		# whose own text invites practice PAST the threshold ("feel free to master one ball
		# before moving on") - advancing the instant the count is hit would cut that
		# practice off rather than offer it. Every named-key `do` beat, every trick/
		# pattern/prop/count `tut_beat`, and the hand question all clear the instant their
		# one action lands.
		# Left off `--demo` on purpose: the harness's own pacing (the dead gap
		# `tut_maintain` holds open, and the guard in `_demo_step` that leans on it to
		# keep the generic feeder from sneaking in a stray throw - see its own comment)
		# is tuned around a step staying "done but open" for a beat, and this collapses
		# that beat to zero for a real player only.
		if goal != "read" and goal != "free" and not bool(step.get("manual", false)) \
				and (not _demo or bool(step.get("sequence", false))):
			tut_advance()


func tut_advance() -> void:
	# Enter moves the lesson on - and only once the step's goal has been met. A
	# step never advances by itself: the player decides when they are done trying.
	if tut_advance_at < 0:
		return
	tut_step += 1
	if tut_step >= tut_lesson(tut_id).size():
		tut_finish()
	else:
		play_sfx("ui2", -11.0)
		tut_setup_step()


func tut_speech_step() -> void:
	# THE VOICE, one blip per letter as the line arrives (Louis: "also create a small noise
	# for that: in balatro they have some kind of explanation sound which i like"). Fired
	# from the SIM rather than from the drawing, because a draw pass can run more than once
	# for a tick and the sound would stutter; and every third character rather than every
	# one, which is what turns a machine-gun into speech.
	if not tut_active:
		return
	var want := tut_speech_chars()
	if want <= tut_speech_said:
		return
	if int(want / 3) > int(tut_speech_said / 3):
		play_sfx("talk", -19.0, randf_range(0.94, 1.10))
	tut_speech_said = want


func tut_maintain() -> void:
	# the --demo autoplayer has no Enter: it takes each met goal after a beat, so a
	# dev run can walk a whole lesson end to end unattended (never in normal play).
	# It has no R or P either, so on a key-teaching step it mimes the press through
	# the same handler a real player's key reaches.
	if _demo and tut_advance_at >= 0 and tick - tut_advance_at >= 50:
		tut_advance()
		return
	if _demo and tut_advance_at < 0 and tick % 240 == 239:
		match String(tut_step_data().get("goal", "")):
			"press_r": tut_demo_reset()
			"press_p": tut_demo_pattern_off()
			"hand":
				# the autoplayer has no arrow keys either: it answers the dominant-hand
				# question the same way it mimes R and P, through the state the real key
				# would set, so a --demo run can still walk the whole basics lesson
				tut_hand_picked = true
				tut_check()
	# keep the step playable by topping the hands back up shortly after a ball is
	# lost, so a fumble never stalls a lesson (34 ticks, ~0.28s: enough of a beat
	# for the drop to actually register before the ball reappears)
	if balls.size() < num_balls and tick - last_drop_tick > 34:
		var step := tut_step_data()
		var teach_hand := tut_step_hand(step)
		for _i in (num_balls - balls.size()):
			# only ever refill a hand with NOTHING dropping into it, so a top-up never
			# lands on the hand a live ball still needs - that was the forced drop (Louis).
			# If both hands are busy catching, wait a beat and try again next tick.
			var choices: Array[int] = []
			for hh in [LEFT, RIGHT]:
				if not tut_incoming(hh):
					choices.append(hh)
			if choices.is_empty():
				break
			var to_h := top_up_side(choices)   # the dominant hand keeps the odd prop
			if num_balls == 1 and choices.has(teach_hand):
				to_h = teach_hand   # a single-ball step returns the ball to its teaching hand
			if to_h < 0:
				break
			var b := Ball.new()
			b.state = STATE_HAND
			b.kind = prop_type
			b.color = ball_color(balls.size()) if prop_type == PROP_BALLS else prop_color(prop_type)
			b.spin_dir = 1.0
			balls.append(b)
			stack(to_h).append(b)


func tut_finish() -> void:
	if _demo:
		print("TUTTRACE finished id=%s tick=%d" % [tut_id, tick])
	var was_basics := tut_id == "balls"
	var was_prop_lesson := tut_id.begins_with("prop_")
	tut_active = false
	tut_id = ""
	mode = MODE_TRAIN
	view_venue = -1   # hand the venue palette back to the player's real progression -
					   # see begin_tutorial, which pinned it to the Backyard for the lesson
	play_sfx("coin", -6.0)   # a bright flourish on finishing a lesson
	if was_basics:
		prop_type = PROP_BALLS   # ONLY the basics lesson forces balls back; a trick or
								 # count lesson taught with the owned prop leaves it be
		# THE ADVANCED (empty-hands) STYLE IS NO LONGER ITS OWN LESSON (2026-07-29,
		# Louis: "you should have explained that quickly in text during the real
		# tutorial... remove that 'advanced juggling technique' tutorial from the 'new
		# ideas' menu"). It used to be queued here and taken later, as a full second
		# drill, from the hub's LEARN row - now the basics' own closing line covers it
		# in one sentence (see the "Tangled?" step in tut_lesson) and nothing queues
		# it any more. advanced_lesson_steps() and TUT_ADVANCED are left in place for
		# `--tutorial advanced`, since the drill itself still works; it is simply never
		# offered on its own again.
		# the FIRST lesson earns a small congrats card - the starting kit and a
		# breath - instead of a hard cut into the day hub (Louis)
		game_state = ST_TUTDONE
		cine_tick = 0
		return
	if not was_prop_lesson:
		# trick/count/pattern lessons always drill with Balls (tut_lesson's own step
		# data), whatever the player was actually equipped with - restore it now, so
		# "leaves it be" (above) is actually true. A prop_ lesson is the one exception:
		# its whole point is walking out equipped with the prop it just taught.
		prop_type = tut_prev_prop
	# THE LESSON MEAL (2026-07-27, Louis): learning something new and then being too
	# spent to go and use it is the worst possible moment to run out of day. Every
	# lesson but the basics (which already ends on its own congratulations card, with a
	# full bar behind it) hands over a hot meal on the way out - free, no gold, no time -
	# so the new trick or pattern can be taken straight to the practice hall.
	var fed := stamina < stamina_max
	if fed:
		stamina = minf(stamina_max, stamina + stamina_max * EAT_STAM)   # a FRACTION, like any meal
	enter_day()
	set_day_msg("lesson complete  -  a hot meal on the house, now go and use it" if fed
		else "lesson complete  -  your day begins")


func tut_kind_tag() -> String:
	# what KIND of thing this lesson teaches, in two or three words - the long sentences
	# that used to live here moved into the opening card, where there is room to read them
	if tut_id.begins_with("trick_"):
		return "TRICK"
	if tut_id.begins_with("pattern_"):
		return "PATTERN"
	if tut_id.begins_with("prop_"):
		return "NEW PROP"
	if tut_id.begins_with("count_"):
		return "MORE PROPS"
	if tut_id == TUT_ADVANCED:
		return "ADVANCED STYLE"
	return "THE BASICS"


func tut_kind_col() -> Color:
	if tut_id.begins_with("trick_"):
		return Color(1.0, 0.72, 0.4)
	if tut_id.begins_with("pattern_"):
		return Color(0.65, 0.85, 1.0)
	if tut_id == TUT_ADVANCED:
		return Color(0.72, 0.95, 0.72)
	return Color(0.85, 0.75, 0.6)


