	draw_string(font, Vector2(lx + 330.0, ly), "purist", HORIZONTAL_ALIGNMENT_RIGHT, 90.0, ps(13), Color(0.82, 0.72, 0.85))
	for i in 7:
		var ry := ly + 34.0 + float(i) * 38.0
