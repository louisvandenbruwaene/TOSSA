		var wa := 0.6 + 0.4 * sin(float(cine_tick) * 0.05)
		draw_string(font, Vector2(0, s.y * 0.68), "WISHLIST %s ON STEAM" % GAME_TITLE, HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(22), Color(1.0, 0.9, 0.55, wa))
		draw_string(font, Vector2(0, s.y * 0.68 + 30.0), "to keep climbing when it ships",
			HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(13), Color(0.8, 0.76, 0.68, 0.85))
	if cine_tick > 120:
		var pa := 0.5 + 0.5 * sin(float(cine_tick) * 0.05)
		draw_string(font, Vector2(0, s.y * 0.84), "any key  -  keep playing what you've already got",
			HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(14), Color(0.75, 0.7, 0.62, 0.4 + 0.5 * pa))
	draw_vignette(s, 0.7)


func draw_purist_legend(font: Font, s: Vector2) -> void:
	# the post-win chase's payoff card, cheap version (Still open): no gear, no
	# stats, no help, at every single venue - the Purist board (already tracked in
	# full on the Records screen) has no empty rows left. Same shape as
	# draw_demo_wall: lead with what was actually done, list it, then straight back
	# into the same career - a payoff, not a new ending.
	# SEAM (2026-08-13): an illuminated border rather than a scene. Every other card here
	# gets a place, but this one is a BOARD - a list of seven venues and seven scores read
	# straight down the middle - so a room behind it would only fight the numbers. A gold
	# and violet certificate frame gives it the weight of a trophy and leaves its whole
	# middle empty velvet, which is exactly what a table of figures wants. Violet because
	# that is already the Purist accent this screen prints its own title in.
	if not art_blit_rect("ui/end_legend", Rect2(Vector2.ZERO, s)):
		draw_rect(Rect2(0, 0, s.x, s.y), Color(0.05, 0.03, 0.05))
	else:
		draw_read_column(s)
	var fin := clampf(float(cine_tick) / 60.0, 0.0, 1.0)
	draw_title_glow(font, s.y * 0.14, "PURIST LEGEND", 42, Color(0.86, 0.78, 1.0, fin), s)
	draw_ornament(s.x * 0.5, s.y * 0.14 + 68.0, 220.0, Color(0.7, 0.6, 0.9, 0.85 * fin))
	draw_string(font, Vector2(0, s.y * 0.27),
		"No gear. No stats. No help. A record stands at every stage on your own hands alone.",
		HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(16), Color(0.88, 0.84, 0.94, fin))
	var lx := s.x * 0.5 - 160.0
	for i in best_scores_purist.size():
		var ry := s.y * 0.40 + float(i) * 30.0
		var la := clampf(float(cine_tick - 60 - i * 12) / 30.0, 0.0, 1.0)
		draw_fit_string(font, Vector2(lx, ry), String(venue_data(i)["name"]), HORIZONTAL_ALIGNMENT_LEFT, 240.0, 15, Color(0.85, 0.8, 0.9, la))
		draw_string(font, Vector2(lx + 240.0, ry), score_text(best_scores_purist[i]), HORIZONTAL_ALIGNMENT_RIGHT, 100.0, ps(15), Color(0.86, 0.78, 1.0, la))
	if cine_tick > 90:
		var pa := 0.5 + 0.5 * sin(float(cine_tick) * 0.05)
		draw_string(font, Vector2(0, s.y * 0.88), "any key  -  the career plays on, records still to chase",
			HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(14), Color(0.75, 0.7, 0.8, 0.4 + 0.5 * pa))
	draw_vignette(s, 0.7)


func draw_show_guide(font: Font, s: Vector2) -> void:
	# THE FIRST SHOW'S GUIDE (2026-07-31, Louis: extend the tutorial into the first real
	# performance). Same speech-box language as the basics lesson (draw_tut_speech) - a
	# head in a lit disc, a line beside it, a tail pointing down - but without that
	# function's letter-by-letter reveal, since this is not a tut_active lesson and has no
	# speech-tick of its own: the line simply appears whole, which a four-line, one-time
	# guide does not need more than.
	if show_guide_step < 0 or show_guide_step >= show_guide_lines.size():
		return
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.02, 0.01, 0.03, 0.30))
	var line := String(show_guide_lines[show_guide_step])
	var bw := minf(720.0, s.x - 120.0)
	var bx := s.x * 0.5 - bw * 0.5
	var by := 24.0
	var inner := bw - 128.0
	var lines := _wrap_lines(font, line, inner, 17)
	var bh := 46.0 + 24.0 * float(maxi(lines.size(), 1))
	bh = minf(bh, s.y * TUT_SPEECH_BOT - by)
	soft_card(Rect2(bx, by, bw, bh), Color(0.10, 0.07, 0.09, 0.95), Color(1.0, 0.86, 0.55, 0.55), 1.6, 14.0, 18.0)
	draw_colored_polygon(PackedVector2Array([
		Vector2(bx + 74.0, by + bh - 1.0), Vector2(bx + 104.0, by + bh - 1.0),
		Vector2(bx + 80.0, by + bh + 13.0)]), Color(0.10, 0.07, 0.09, 0.95))
	var hc := Vector2(bx + 52.0, by + bh * 0.5)
	draw_glow(hc, 34.0, Color(1.0, 0.78, 0.42, 0.14))
	draw_circle(hc, 26.0, Color(0.16, 0.11, 0.12, 0.95))
	draw_arc(hc, 26.0, 0.0, TAU, 28, Color(1.0, 0.86, 0.55, 0.45), 1.4)
	draw_head(hc + Vector2(0.0, 3.0), 15.0, Color(0.28, 0.16, 0.11), Color(0.87, 0.64, 0.45), false)
	var ty := by + 34.0
	for l in lines:
		draw_string(font, Vector2(bx + 96.0, ty), String(l), HORIZONTAL_ALIGNMENT_LEFT, inner, ps(17), Color(1.0, 0.94, 0.80))
		ty += 24.0
	var pa := 0.7 + 0.3 * sin(atick() * 0.14)
	draw_string(font, Vector2(bx + bw - 100.0, by + bh - 10.0), "%s  go on" % String(k_finish()[0]), HORIZONTAL_ALIGNMENT_RIGHT, 90.0, ps(12), Color(1.0, 0.9, 0.7, pa))
	# The guide points at the same rail it is naming. The outline is deliberately broad:
	# each card already labels its individual numbers, while this teaches the screen map.

	# THE SECOND LINE MAKES THE STEM DEMONSTRATE ITSELF (2026-07-31, Louis: "instead of a
	# dumb circle around it, make it fill up very fast and run out again at the same speed").
	# The ring that used to be drawn here - a 90px arc thrown round the goal card - is gone:
	# a circle can only say "look over there", and what the player needs to understand is
	# what the thing DOES. draw_hud drives the real stem off guide_stem_demo() while this
	# line is up, so the explanation and the object explained are the same picture. All that
	# is left here is a soft wash of light behind it, to carry the eye across.
	if show_guide_step == 2:
		var stem_c := Vector2(18.0 + 152.0 + 17.0, 78.0 + 12.0 + 74.0)
