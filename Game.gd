		draw_string(font, Vector2(lx + 230.0, ry), score_text(b) if b > 0 else "-", HORIZONTAL_ALIGNMENT_RIGHT, 90.0, ps(15), Color(1.0, 0.86, 0.45) if b > 0 else Color(0.5, 0.46, 0.42))
