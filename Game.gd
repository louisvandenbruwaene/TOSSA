func setup_font() -> void:
	# SEAM: a pixel face, if one has been dropped in. This is the ONE art element chosen
	# once rather than per draw call, so it gets a path check instead of a manifest key.
	#
	# The three properties below are the whole difference between a pixel font and a
	# blurry one, and Godot's defaults are wrong for every one of them: antialiasing
	# feathers the glyph edges into grey, subpixel positioning lets a glyph start at a
	# fractional x (so identical letters render differently down a line), and hinting
	# nudges stems off the grid. A bitmap face with these left on looks like a smaller
	# version of the current font, not like pixel art - which is the usual reason a first
	# pixel-art pass "still looks wrong" and nobody can say why.
	if setup_pixel_font():
		return
	# one clean humane face at semibold, set up as a FontVariation so the single
	# variable-weight file serves every size. If the file is ever missing the
	# engine fallback quietly takes over and nothing breaks.
	var base: Variant = load("res://fonts/Nunito.ttf")
	if base is Font:
		var fv := FontVariation.new()
		fv.base_font = base
		fv.variation_opentype = {"wght": 600}
		ui_font = fv
		# a heavier cut of the SAME variable file for headings, so titles and big numbers
		# carry real weight against the semibold body - typographic hierarchy for free,
		# no second asset. Used via title_font() on screen titles and the biggest numerals.
		var tv := FontVariation.new()
		tv.base_font = base
		tv.variation_opentype = {"wght": 800}
		title_font_v = tv


func setup_pixel_font() -> bool:
	# Assets/Fonts/pixel.ttf (or .fnt / .otf) takes over both faces if it is there. Returns
	# false - silently, because "no pixel font yet" is the normal state of this branch - so
	# setup_font falls through to Nunito. Note both faces get the SAME file: a pixel font
	# has no weight axis to vary, so title_font()'s hierarchy has to come from size, which
	# is how bitmap type has always done it.
	for ext: String in ["ttf", "otf", "fnt", "font"]:
		var path := "res://Assets/Fonts/pixel." + ext
		if not ResourceLoader.exists(path):
			continue
		var f: Variant = load(path)
		if not (f is Font):
			continue
		if f is FontFile:
			var ff := f as FontFile
			ff.antialiasing = TextServer.FONT_ANTIALIASING_NONE
			ff.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_DISABLED
			ff.hinting = TextServer.HINTING_NONE
			ff.multichannel_signed_distance_field = false
		ui_font = f
		title_font_v = f
		print("art: pixel font active (%s)" % path)
		return true
	return false


func game_font() -> Font:
	return ui_font if ui_font != null else ThemeDB.fallback_font


func title_font() -> Font:
	return title_font_v if title_font_v != null else game_font()


const PS_STEP := 4    # the pixel font is only crisp at multiples of this
const PS_MIN := 12    # ...and illegible below this


func ps(size: int) -> int:
	# QUANTISE A FONT SIZE TO THE PIXEL FONT'S GRID. Every draw and every measurement in
	# this file goes through here, and if you add a text call it must too.
	#
	# WHY, MEASURED IN THE ENGINE AND NOT ASSUMED (2026-08-05). A pixel font is an outline
	# font whose outlines sit on a grid. Ask for a size that is not a whole multiple of
	# that grid and the rasteriser has to put some stems on one pixel and some on two, with
	# antialiasing off to smooth it over - so the glyphs do not blur, they DEFORM. A sweep
	# of Pixel Operator at every size from 9 to 34, rendered by Godot itself rather than by
	# a proxy rasteriser, shows the damage precisely:
	#
	#     12  clean          16  clean          20  clean      24/28/32  clean
	#     13  "220" -> "ZZ0", the D in SPEND loses its bowl
	#     14  passable, uneven E and D, 8 reads as 0
	#     15  "220" -> "ZZ0" again, "0123456789" -> "01Z3456789"
	#     17  uneven        19/21/23/25...  uneven
	#
	# TOSSA's three most-used sizes are 13 (x31), 15 (x31) and 12 (x29), so two of the
	# three worst sizes in the table were carrying most of the game's text. This is what
	# made the first pixel-font screenshot look subtly wrong in a way that reads as "bad
	# font" rather than "wrong size".
	#
	# ROUNDING IS TO NEAREST, TIES DOWNWARD. Down on a tie because text that shrinks
	# degrades gracefully here and text that grows can overflow: 18 -> 16 rather than 20.
	# The clamp at PS_MIN matters for fit_size, which is allowed to ask for 9.
	#
	# IT IS SAFE TO APPLY TWICE. ps(ps(n)) == ps(n), which is what lets fit_size keep
	# stepping by 1 while measuring through this function - it simply measures the same
	# crisp size a few times before crossing a rung, and the size it returns is quantised
	# again at the draw site. Measurement and drawing therefore can never disagree, which
	# is the bug that would otherwise show up as text overflowing a box it was measured to
	# fit inside.
	if size <= PS_MIN:
		return PS_MIN
	return maxi(PS_MIN, int(floor((float(size) + float(PS_STEP) * 0.5 - 1.0) / float(PS_STEP))) * PS_STEP)


func _ready() -> void:
	# Dev-only flags. Normal play passes NONE of these: the game then simply waits
	# for the player's first THROW and never auto-plays or auto-quits.
	#   --demo         run the headless auto-player (for verifying choreography)
	#   --shot <path>  capture one frame to <path> then quit
	var ua := OS.get_cmdline_user_args()
	# THE WINDOW SAYS WHICH BUILD IT IS (2026-07-28, Louis: "rename the app to tossa and
	# tossa debug"). project.godot's config/name is the shipped name and cannot vary, so
	# the debug marker goes on at runtime. Worth having: a debug run keeps its own save
	# file, its own experiment toggles and every dev flag, so telling the two apart at a
	# glance in the Dock and the window list is the difference between editing a career
	# and editing a test one.
	DisplayServer.window_set_title(GAME_TITLE if not OS.is_debug_build() else GAME_TITLE + " (debug)")
	sync_props()          # every per-prop array as long as PROPS, before anything reads one
	migrate_old_saves()   # the game was called IACTO until 2026-07-28: carry those
						  # careers across before anything reads a save (see below)
	# --artmanifest must be read BEFORE art_boot, which is the one dev flag that cannot wait
	# for the block below - the bank is built once, at startup. Guarded on is_debug_build
	# for the same reason every other flag is: none of them may parse in a shipped build.
	if OS.is_debug_build():
		var mi := ua.find("--artmanifest")
		if mi != -1 and mi + 1 < ua.size():
			art_manifest_path = ua[mi + 1]
	load_settings()
	art_boot()            # the pixel-art seam's texture bank, BEFORE setup_font: a bitmap
						  # face registered under "font/ui" wins over Nunito, and the font
						  # is the one piece of art that is chosen once instead of per draw
	setup_font()
	# a pad can arrive or vanish at any moment, and vanishing mid-set must pause
	Input.joy_connection_changed.connect(_on_joy_connection)
	if set_fullscreen and not ua.has("--shot"):
		apply_fullscreen()                       # honour the remembered display mode
												 # (a --shot capture run stays at the
												 # windowed 1280x720 design size, so
												 # screenshots are comparable and a
												 # dev capture never seizes the display)
	setup_audio()                                # synthesise all sound at startup
	hpos = [outer_pos(LEFT), outer_pos(RIGHT)]   # idle hands for the title screen
	if not OS.is_debug_build():
		# a real release export (what ships to players): none of the dev flags
		# below can ever parse, no matter what a player passes on the command
		# line. --debug in particular grants free stat editing and story-jump
		# shortcuts, which must never be reachable in a shipped build. Editor
		# runs and debug-template exports (this project's own screenshot and
		# test workflow) are unaffected, since is_debug_build() is true there.
		game_state = ST_MENU
		return
	if ua.has("--demo"):
		_demo = true
	# --- pixel-art remaster flags (PIXELTOSSA); see the PIXEL-ART RENDER SEAM region ---
	if ua.has("--procart"):    # force every art key to miss: the A/B against a sprite
		art_on = false
	# --variant <set>:<option>, repeatable: pick a design for this run without touching the
	# saved settings. This is what lets screenshot.sh photograph all three performer looks in
	# one pass - the panel writes to the settings file, and a capture harness that did that
	# would leave Louis's own chosen look changed behind it.
	#
	# THE BANK IS ALREADY BUILT by the time this block runs (art_boot is up at the top, so
	# the bitmap font is registered before setup_font). Rather than hoist a third flag above
	# load_settings the way --artmanifest had to be, this just re-reads the manifests once
	# at the end - the textures are in Godot's resource cache, so the second read is free.
	var vchanged := false
	for vi in ua.size():
		if ua[vi] != "--variant" or vi + 1 >= ua.size():
			continue
		var spec := ua[vi + 1].split(":")
		if spec.size() != 2:
			push_warning("--variant wants <set>:<option>, got '%s'" % ua[vi + 1])
			continue
		var vdef := variant_def(spec[0])
		if vdef.is_empty():
			push_warning("--variant: no design set named '%s'" % spec[0])
			continue
		var found := -1
		for oi in (vdef["opts"] as Array).size():
			if String(((vdef["opts"] as Array)[oi] as Dictionary)["key"]) == spec[1]:
				found = oi
		if found < 0:
			push_warning("--variant: '%s' has no option '%s'" % [spec[0], spec[1]])
			continue
		art_variants[String(vdef["id"])] = found
		vchanged = true
	if vchanged:
		art_boot()
	if ua.has("--artreport"):  # print which seam keys this run reached, and which had art
		_art_report = true
	if ua.has("--pixel"):      # capture --shot at art density instead of 1280x720
		_art_pixel = true
	var pri := ua.find("--propref")   # dev: draw ONE prop isolated, for measuring and for
	if pri != -1 and pri + 1 < ua.size():   # img2img reference - see _draw_prop_ref
		_propref = ua[pri + 1]
		art_on = false            # photograph the DRAWING, never a sprite already replacing it
	if ua.has("--charref"):       # dev: the juggler alone on a flat field - see _draw_char_ref
		_charref = true
		art_on = false            # same reason: photograph the drawing, not its replacement
	if ua.has("--artboxes"):      # dev: print where every sized element was drawn, on quit
		_art_boxes_on = true
	var csi := ua.find("--charsuppress")   # dev: the "without" half of the isolation
	if csi != -1:                          # difference. Bare = every char key; with a key
		_art_suppress = "*"                # argument = only that one (see art_blit_size).
		if csi + 1 < ua.size() and not str(ua[csi + 1]).begins_with("--"):
			_art_suppress = ua[csi + 1]
	if ua.has("--charid"):        # dev: render the costume as a region ID map (see costume_palette)
		_charid = true
	if ua.has("--chargear"):      # dev: force every wardrobe piece on, for --charref only
		_chargear = true
	if ua.has("--charback"):      # dev: the figure facing away, for the Spin torso art
		_charback = true
	if ua.has("--charopen"):      # dev: hold the hand open, for the open-mitt art
		_charopen = true
	var chi := ua.find("--charhide")   # dev: leave ONE garment off under --chargear,
	if chi != -1 and chi + 1 < ua.size():   # so a piece it would occlude can be seen
		_charhide = ua[chi + 1]
	var mri := ua.find("--markref")   # dev: the prop wordmark alone, at a given letter height
	if mri != -1:
		_markref = true
		_markref_size = float(MENU_MARK)
		if mri + 1 < ua.size() and not str(ua[mri + 1]).begins_with("--"):
			_markref_size = float(ua[mri + 1])
		art_on = false            # photograph the DRAWING, not a bake already replacing it
	if ua.has("--bgref"):         # dev: the backdrop alone, unlit - see the bg seam
		_bgref = true
		art_on = false            # photograph the DRESSING, never a backdrop already replacing it
	if ua.has("--menuref"):       # dev: the title proscenium alone, dustless - see draw_menuref
		_menuref = true
		art_on = false            # photograph the DRAWING, never the bake already replacing it
	if ua.has("--parkcheck"):     # dev: autoplay the STOP GESTURE and audit it - see parkcheck_step
		_parkcheck = true
	if ua.has("--extref"):        # dev: one venue EXTERIOR alone, dustless - see draw_venue_exterior
		var eri := ua.find("--extref")
		_extref = int(ua[eri + 1]) if eri + 1 < ua.size() else 0
		art_on = false            # photograph the DRAWING, never the bake already replacing it
	if ua.has("--debug") or OS.has_feature("debug_launcher"):   # debug build: free stat
		debug_mode = true                                        # editing (uses a separate save).
		# OS.has_feature check mirrors in_demo_build()'s "demo" feature tag: a real export
		# built with the "debug_launcher" custom feature starts in debug_mode with no
		# command line needed, same as passing --debug by hand.
	if ua.has("--demowall"):   # dev: exercise the scoped-demo path without a real
		_force_demo = true     # "demo"-tagged export - see in_demo_build()
	if ua.has("--fps"):        # dev: the performance probe (see _fps above)
		_fps = true
	var si := ua.find("--shot")
	if si != -1 and si + 1 < ua.size():
		_shot = true
		_shot_path = ua[si + 1]
	var sa := ua.find("--shotat")   # dev: capture at frame N (to test late transitions)
	if sa != -1 and sa + 1 < ua.size():
		_shot_tick = int(ua[sa + 1])
	var da := ua.find("--dumpaudio")             # dev: write every sound to <dir>, then quit
	if da != -1 and da + 1 < ua.size():
		dump_audio(ua[da + 1])
		get_tree().quit()
		return

	# Dev/test flags jump straight into play; a normal launch opens the main menu.
	if ua.has("--collcheck"):   # dev: audit the ideal pattern for mid-air overlap. Runs
		_collcheck = true       # fine under --headless, and IMPLIES --demo: the audit needs
		_demo = true            # the autoplayer actually juggling or nothing is ever thrown,
								# and the clearance stays at its sentinel - a silent no-op run
								# (bare --collcheck used to report 1000000 px, measuring nothing)
	if ua.has("--calib"):       # dev: same reasoning, and it was the same silent hang. A calib
		_demo = true            # IS a measurement of the autoplayer (its own printout says so),
								# but it never reached play: without --demo, skip_menu below
								# stayed false, the run sat at the main menu, `tick` never
								# advanced, and the quit condition it is waiting on
								# (tick >= _calib_ticks) could never fire. A bare
								# `--calib 3` ran for 24 minutes and printed nothing.
	var lci := ua.find("--latecatch")   # dev: --collcheck --latecatch N - a realistic-timing
	if lci != -1 and lci + 1 < ua.size():   # variant of the audit (see _late_catch_n above)
		_late_catch_n = int(ua[lci + 1])
	if ua.has("--handlog"):     # dev: log hand x every tick (ROADMAP 12b jitter diagnosis)
		_handlog = true
	# debug_mode is NOT in this list (2026-08-05, Louis: the debug build should open the
	# title screen, not a practice tool). It used to be, so /Applications/PIXELTOSSA
	# Debug.app dropped straight into Practice and the menu, slots, settings and credits
	# were unreachable in the one build made for looking at things. Every OTHER entry here
	# is an unattended dev capture that genuinely has nowhere to click, and --demo/--shot
	# still skip the menu when combined with --debug, which is what venue previews use.
	var skip_menu := _demo or _shot or _collcheck or _handlog or ua.has("--sheet") or ua.has("--shop") or ua.has("--results") or ua.has("--pause") or ua.has("--day") or ua.has("--stats")
	if ua.has("--menu"):   # dev: hold the title screen, which is what --shot otherwise skips past.
		skip_menu = false  # It briefly took a 1..4 variant while the four backdrops were being
						   # compared; there is one picture again, so there is nothing to pick.
	if skip_menu:
		save_slot = 0
		load_progress()
		var start_n := 3
		var bi := ua.find("--balls")   # dev: force the ball count (audit even-count Cascade, e.g. 4/6)
		if bi != -1 and bi + 1 < ua.size():
			strength = maxi(strength, prop_req(PROP_CHAINSAW, MAX_BALLS_HARD))   # every count of everything open
