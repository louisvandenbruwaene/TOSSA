				_calib_ticks = maxi(120, int(ua[ci + 1]))
		if ua.has("--maxstats"):   # dev: model a fully INVESTED master, not just the demo save's
			# stats - the honest test for whether a heavy prop pays for a player who earned
			# the Endurance/Accuracy to field it (a bare-Strength calib undersells them badly).
			accuracy = ACC_CAP
			strength = STR_CAP
			endurance = END_CAP
			speed = SPEED_CAP
			stamina_max = 100.0 + 9.0 * float(endurance)
			stamina = stamina_max
		var pi := ua.find("--pattern")   # dev: force a pattern for screenshots, e.g. --pattern shower
		if pi != -1 and pi + 1 < ua.size():
			for pj in PATTERNS.size():
				if String(PATTERNS[pj]["id"]) == ua[pi + 1]:
					dev_meet_req(PATTERNS[pj])   # composite reqs now: floor every axis it asks
					pattern_sel = pj
					start_run(num_balls)
		var tri := ua.find("--trick")   # dev: unlock every trick and let the auto-player
		if tri != -1:                   # show them off. An optional id (--trick high)
			_demo_trick = true          # pins that one trick, so toggles can be watched
			for tj in TRICKS.size():
				dev_meet_req(TRICKS[tj])
			if tri + 1 < ua.size() and not ua[tri + 1].begins_with("--"):
				for tj in TRICKS.size():
					if String(TRICKS[tj]["id"]) == ua[tri + 1]:
						_demo_trick_pin = tj
			if ua.has("--unlock"):   # dev: also show the new-trick banner
				trick_unlock = TR_SPIN
				trick_unlock_tick = 0
		# dev: deal the UNLOCK CARD for any skill, on any screen - `--ucard trick:spin`
		# or `--ucard pattern:shower`. The card is normally only reachable by actually
		# crossing a wall, which is a whole career away for the later ones, so without
		# this most of them could never be looked at.
		# `--ucard trick:spin` / `--ucard pattern:shower` deals that card ALREADY TURNED
		# OVER, because inspecting a face is what the flag is for. `--ucard back:trick` and
		# `--ucard back:pattern` deal the face-down side instead - which now needs its own
		# capture path, since a real card only shows its back until a key is pressed and a
		# headless run presses nothing.
		var uci := ua.find("--ucard")
		if uci != -1 and uci + 1 < ua.size():
			var spec: PackedStringArray = ua[uci + 1].split(":")
			var head := String(spec[0]) if spec.size() > 0 else ""
			var want := String(spec[1]) if spec.size() > 1 else ""
			var face_down := head == "back"
			if face_down:
				ucard_kind = 1 if want == "pattern" else 0
			else:
				ucard_kind = 1 if head == "pattern" else 0
			var tab: Array = PATTERNS if ucard_kind == 1 else TRICKS
			ucard_idx = 0
			for k in tab.size():
				if String((tab[k] as Dictionary)["id"]) == want:
					ucard_idx = k
			ucard_tick = 0.0
			# `ucard_flip` is an atick STAMP, and any negative value means "still face
			# down" - so a fake stamp in the past cannot be used to pre-flip it. 0.0 is
			# the turn starting at the very first frame, which is complete long before any
			# useful --shotat.
			ucard_flip = -1.0 if face_down else 0.0
		var hoi := ua.find("--hold")    # dev: the auto-player's hold per throw (0..44),
		if hoi != -1 and hoi + 1 < ua.size():   # to verify held heights on screenshots
			_demo_hold = clampi(int(ua[hoi + 1]), 0, HOLD_MAX)
		if ua.has("--collide"):     # dev: force the hard-collisions toggle ON this session
			set_collide = true
		if ua.has("--glow"):        # dev: own the whole Glow Kit this session, for Blackout shots
			has_glow_tape = true
		if ua.has("--wardrobe"):
			# dev: buy and wear THIS STAGE'S cut of every garment. A full wardrobe now costs
			# 28,500 per house and there are seven houses, so without this the dressed figure
			# has no capture path at all and every piece would only ever be judged alone -
			# which is how a hat and a tailcoat end up fighting.
			for _p in WEAR_PIECES:
				var _k := wear_key(_p, cur_venue())
				if not owned_wear.has(_k):
					owned_wear.append(_k)
				worn_piece[_p] = cur_venue()
		if ua.has("--boo"):         # dev: pin the room in the red, so the tomato path
			_boo = true             # can be seen at all - see the note in update_sim
		if ua.has("--nokit"):       # dev: the mirror of --glow. The demo save OWNS the
			has_glow_tape = false   # Glow Kit (glow_kit=true), so every --demo capture of
									# a dark stage was silently the charged version and the
									# un-charged one had no capture path at all
		if ua.has("--sheet"):   # dev: open the character sheet for a screenshot
			points = maxi(points, 6)
			sheet_open = true
		if ua.has("--shop"):    # dev: open the shop for a screenshot
			shop_open = true
		if ua.has("--results"):   # dev: fabricate a finished act to screenshot the card
			mode = MODE_PERFORM
			run_venue = 4
			goals_hit = 3             # a complete night, for the card's header and grade
			caught = 214; dropped = 3; best_streak = 132; score = 951875
			peak_applause = 0.94; tricks_landed = 11; trick_score = 42600
			last_pay = 6996; last_rep_delta = 60; run_xp = 1240; points = 3
