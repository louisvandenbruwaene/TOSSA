func draw_spotlight_cone(s: Vector2, cx: float, strength: float) -> void:
	# A BEAM WITH EDGES, not a triangle (2026-07-27). The old one was a single flat
	# polygon at one alpha, so the light stopped dead along two straight lines - at
	# capsule size especially it read as a geometric wedge laid over the picture rather
	# than as a lamp. Its half-width was a hard 300px too, which meant the beam changed
	# proportion with the window instead of with the stage.
	#
	# Softened with PER-VERTEX ALPHA through draw_polygon, which is one draw call. That
	# matters: the note on draw_glow records that stacking low-alpha shapes to fake a
	# gradient measured 30% SLOWER and banded visibly once the stack was thinned. Here
	# the interpolation is free - the rasterizer already does it.
	#
	# The base is bowed rather than flat because four collinear points on one edge is
	# exactly the degenerate case Godot's triangulator is fussy about (see the helmet
	# brim), and a beam's far end genuinely is an ellipse on the floor, not a straight cut.
	var hw := s.x * 0.234           # the old 300px at the 1280 the number was picked for
	var ay := -0.04 * s.y
	var yb := s.y * 0.86
	var bow := s.y * 0.012
	var warm := Color(1.0, 0.85, 0.55)
	draw_polygon(
		PackedVector2Array([
			Vector2(cx, ay),
			Vector2(cx - hw, yb), Vector2(cx - hw * 0.38, yb + bow),
			Vector2(cx + hw * 0.38, yb + bow), Vector2(cx + hw, yb)]),
		PackedColorArray([
			Color(warm.r, warm.g, warm.b, strength),
			Color(warm.r, warm.g, warm.b, 0.0), Color(warm.r, warm.g, warm.b, strength * 0.5),
			Color(warm.r, warm.g, warm.b, strength * 0.5), Color(warm.r, warm.g, warm.b, 0.0)]))


func draw_shadow(feet: Vector2, w: float) -> void:
	fill_ellipse(feet, w * 0.5, w * 0.16, Color(0, 0, 0, 0.3))


#endregion

#region DEV: AUTOPLAYER & SCREENSHOT CAPTURE
func demo_spin_room() -> bool:
	# dev only: the autoplayer will not spin itself into a drop. A Spin now blocks catching for
	# SPIN_TICKS, so a bot that spins whenever it can simply deletes its own set - measured,
	# `--demo --trick spin` collapsed after 202 ticks with nothing on the board, which makes
	# the flag useless for exactly the thing it exists to capture. It waits for a real gap now,
	# which is also the way a human has to play it.
	for b in balls:
		if b.state == STATE_FLIGHT and b.land_tick - tick < SPIN_TICKS + 8:
			return false
	return balls_airborne() > 0


func _demo_step() -> void:
	# **THE ACT IS OVER: STOP PLAYING** (2026-07-29). Without this the autoplayer keeps
	# throwing after the results card is up, and a throw sets `running` again - so the act
	# resolves, the crowd stands, the bot restarts it, it resolves again, and `ovation_left`
	# is re-armed to OVATION_TICKS every time it is about to reach zero. Since --demo now
	# quits ON that zero, the harness hung forever on any act it played cleanly. It looked
	# like a scoring bug and it is a harness bug, and it only started firing on every run
	# when the new goals made a flawless act the NORMAL outcome rather than a rare one: the
	# ovation needs `dropped == 0`, and the old goals took long enough that the bot always
	# fumbled something on the way. The "zombie-feeding" this file's --calib note already
	# describes is the same behaviour, seen from the collapse side.
	if results_open:
		return
	# INSIDE A LESSON the autoplayer plays off the beat logic and nothing else. On a
	# GUIDED step the beats already drive it (tut_hold_autoplay); on the free pass its
	# own metronome used to take over, and that metronome re-throws the instant it
	# catches - which is the ADVANCED style. On a beginner step that now fails the style
	# check outright (see tut_on_catch), so a --demo run could no longer finish the
	# basics. Reading tut_due_actions here means the harness always plays in whatever
	# style the step is teaching, which is also the only way it can verify one.
	if tut_active:
		# THE BASICS' OWN "do" BEATS MUST NOT BE FED (2026-07-29). Once a step is met,
		# tut_advance_at holds it open for TUT_HOLD_GAP-ish ticks before auto-advancing
		# (see tut_maintain) - and during that dead gap the world runs unfrozen, which is
		# exactly when this generic feeder used to sneak in an extra throw the script
		# never asked for (tut_due_actions has no notion of "one step, one key"; it just
		# keeps the pattern going). That stray throw left the NEXT do-step's hand empty
		# before it even began - the ball was already back in the air - so the next
		# beat's own freeze (tut_do_step/tut_do_ready) held forever waiting for a throw
		# that could never come, since nothing was left to throw. Scoped to the basics
		# lesson only: the older paced lessons want this feeder running right through
		# their own dead gaps, and always have.
		if tut_id == "balls" and tut_advance_at >= 0:
			return
		# A scripted sequence owns every press. While a peak-timed throw is still rising,
		# the generic demo feeder must not "help" by throwing the next scripted ball early.
		if bool(tut_step_data().get("sequence", false)):
			return
		# The height lesson is the one basics step whose press duration is the goal.
		# Feed it with a genuinely held throw so --tutorial balls tests that branch too.
		if String(tut_step_data().get("goal", "")) == "hold_throw":
			var hh := tut_step_hand(tut_step_data())
			if tut_held_throws == 0 and not stack(hh).is_empty():
				do_throw(hh, maxi(10, HOLD_MAX / 3))
			elif tut_held_throws > 0:
				for hb: Ball in balls:
					if hb.state == STATE_FLIGHT and absi(hb.land_tick - tick) <= 1:
						on_catch(hh)
						break
			return
		var due := tut_due_actions()
		for e in due:
			if int(e["rank"]) != tut_hold_rank_of(due):
				continue
			match String(e["act"]):
				"throw":
					# do_throw, not on_throw_press: OUTSIDE a hold a press only starts
					# the charge and the release does the throwing, and the autoplayer
					# has no release. (Inside a hold on_throw_press throws directly,
					# which is why the guided path could use it.)
					var th := int(e["hand"])
					if not stack(th).is_empty():
						do_throw(th, 0)
				"catch": on_catch(int(e["hand"]))
				"trick": on_trick()
			break
		return
	# in a --booking demo the autoplayer cashes in the moment the FINAL goal falls, so
	# a whole act runs end to end (all three crossings, the resolve, the pay) and never
	# hangs at a venue whose crowd a low routine can sustain forever (v0/v1)
	if booking_active and goals_hit >= NUM_GOALS and running:
		finish_performance()
		return
	# --latecatch needs bootstrap throws before the catch-triggered loop below has
	# anything airborne to catch: one throw per ball beyond the first, DEMO_BEAT
	# apart, same as the metronome's own cadence, so every ball actually enters
	# rotation instead of a couple sitting as permanent, never-thrown residents.
	var settle_tick := 24 + (num_balls - 1) * DEMO_BEAT + 60
	if _late_catch_n >= 0 and tick >= 24 and tick < 24 + (num_balls - 1) * DEMO_BEAT and (tick - 24) % DEMO_BEAT == 0:
		var bh := _demo_next
		if stack(bh).is_empty():
			bh = other(bh)
		if not stack(bh).is_empty():
			do_throw(bh, _demo_hold)
			_demo_next = other(bh)
	# the bootstrap's own throws (fixed-beat, identical regardless of N) tend to
	# produce the tightest clearance of the whole run purely because they are not
	# yet on the late-catch rhythm - left alone, that bootstrap-phase minimum would
	# dominate _coll_min and mask whatever the ACTUAL late-catch-driven steady
	# state does, which is the only thing this mode exists to measure. One clean
	# reset once the bootstrap is behind and the rhythm has had a cycle to settle.
	if _late_catch_n >= 0 and tick == settle_tick:
		_coll_min = 1000000.0
		_coll_at = ""
		_coll_min_drawn = 1000000.0
		_coll_at_drawn = ""
	# auto-catch: secure any ball arriving at an empty hand (the odd-columns middle
	# ball counts for either hand, matching the either-hand rule in on_catch).
	# --latecatch N (see _late_catch_n) instead waits until exactly N ticks AFTER
	# the ball's ideal land_tick - still a Perfect catch as long as N is within
	# perfect_window() - and immediately re-throws that hand on this same tick,
	# so the audit actually exercises "a real, not-frame-0 Perfect catch followed
	# by an immediate throw" instead of only ever the idealized frame-perfect one.
	# Unlike the near-instant branch below, this does NOT skip a hand that
	# already holds a ball (on_catch itself never required an empty hand - a
	# hand legitimately holds two at a cascade's start - skipping it here once
	# stranded a hand's leftover ball forever, since nothing else would ever
	# ask it to catch, or to throw, again).
	for h in [LEFT, RIGHT]:
		if _late_catch_n < 0 and not stack(h).is_empty() and not parkcheck_collecting():
			continue
		for b in balls:
			if b.state != STATE_FLIGHT or (b.to_hand != h and b != col_mid_ball):
				continue
			var due := (tick == b.land_tick + _late_catch_n) if _late_catch_n >= 0 else absi(b.land_tick - tick) <= 1
			if due:
				var before := stack(h).size()
				on_catch(h)
				if _late_catch_n >= 0 and stack(h).size() > before:
					do_throw(h, _demo_hold)   # immediate: the whole point of this mode
				break
	# dev trick preview: kick off a Spin whenever the pattern is full and cooled down
	# (in unpinned mode, or when Spin itself is the pinned trick)
	var pin_kind := String(TRICKS[_demo_trick_pin]["kind"]) if _demo_trick_pin >= 0 else ""
	if _demo_trick and (_demo_trick_pin == -1 or _demo_trick_pin == TR_SPIN) \
			and balls_airborne() >= 2 and not spinning() and tick >= 40 and demo_spin_room():
		spin_until = tick + SPIN_TICKS
		spin_scored = false
		trick_ready = tick + TRICK_COOLDOWN
	# a pinned TOGGLE switches on once (one mimed Space press) and stays running
	# THE AUTOPLAYER MUST PRESS THE KEY, NOT SET THE FLAG (2026-07-29). It assigned
	# `toggle_on` directly, which was harmless while a toggle's only effect was to reshape
	# throws - and became a silent lie the moment a trick's PRESS is what multiplies the run.
	# Measured: `--trick btb` at five clubs scored 20,900, byte for byte what the same run
	# scored with no trick at all, because `apply_trick_mult` lives in on_trick and on_trick
	# was never reached. **A dev flag that quietly does something else is worse than one that
	# errors** - the same finding `dev_meet_req` produced the day before, in a different
	# disguise. It goes through the real handler now, so the flag exercises the real path.
	if _demo_trick and pin_kind == "toggle" and toggle_on != _demo_trick_pin and tick >= 24:
		trick_sel = _demo_trick_pin
		on_trick()
	# a tutorial's "switch it OFF" step needs the mime to let go again - outside a
	# lesson the point is showing the trick run, so this only fires once the lesson
	# has actually reached that step (never mid-drill, never in a bare --trick demo)
	if _demo_trick and tut_active and toggle_on == _demo_trick_pin \
			and String(tut_step_data().get("goal", "")) == "trick_off":
		toggle_on = -1
	# metronome: every beat, release one ball from a hand that actually holds one.
	# This can never desync because it only throws real held balls. Off under
	# --latecatch, whose own catch-then-immediately-rethrow above is the only
	# throw trigger that mode wants - the beat would otherwise fire independently
	# and blur the very timing this mode exists to isolate.
	if _late_catch_n < 0 and tick >= 24 and tick % DEMO_BEAT == 0 and not parkcheck_collecting():
		var h := _demo_next
		if stack(h).is_empty():
			h = other(h)
		if not stack(h).is_empty():
			if _demo_trick:
				# mimic a real Space press per throw for an "arm" trick - one that primes
				# a throw and pays when it is caught. There is no such trick left in
				# TRICKS (Overthrow was the last, removed 2026-07-28) but the branch and
				# the machinery behind it are kept: the flourish toggles and the live Spin
				# run through the same `trick_sel`, and an arm trick is a plausible thing
				# to add back. The flourish toggles (High Toss / BTB) run via toggle_on,
				# set once above, so there is nothing to prime for them.
				if pin_kind == "arm":
					trick_sel = _demo_trick_pin
					trick_primed = true
			do_throw(h, _demo_hold)
			_demo_next = other(h)
	parkcheck_step()


func parkcheck_collecting() -> bool:
	# --parkcheck: THE STOP GESTURE, autoplayed, because a player is the only thing that can
	# normally perform it and a headless run has no player.
	#
	# The full-hand rule (see catch_full_on) is unreachable by the ordinary autoplayer BY
	# DESIGN - it skips any hand that already holds, which is exactly right for demonstrating a
	# pattern and exactly wrong for testing the one mechanic that depends on not doing that. So
	# under this flag, the moment a goal is banked the autoplayer stops throwing and catches
	# everything that arrives, full hand or not: catch the set, hold it, done.
	# ...after a stretch of ordinary juggling, so the pattern is actually running when the
	# gesture starts. Tick-based for the same reason catch_full_on is flag-based: it must not
	# depend on how well the autoplayer happens to be doing.
	return _parkcheck and tick >= PARK_START


func parkcheck_step() -> void:
	# ...and the audit. Called once a tick while the gesture is running; quits with a verdict
	# as soon as every prop is in a hand, which is the state the gesture exists to reach.
	if not parkcheck_collecting():
		return
	var c0 := stage_center().x
	for h in [LEFT, RIGHT]:
		if hand_parked[h]:
			_park_seen[h] = true
		# THE REACH, MEASURED IN FLIGHT, which is the only moment it means anything: with
		# nothing in the air every hand rests inward and the test would pass on a bug. What
		# is being checked is that a hand which is HOLDING and has a prop ON ITS WAY aims at
		# the prop - the exact case that was wrong before (Louis: "it won't go outwards
		# because there are balls in the hand").
		if hand_parked[h] and not stack(h).is_empty():
			for b in balls:
				if b.state == STATE_FLIGHT and b.to_hand == h:
					_park_reach = maxf(_park_reach, absf(hand_target(h).x - c0))
					break
	if balls_airborne() > 0:
		return
	var held := stack(LEFT).size() + stack(RIGHT).size()
	var parked := int(_park_seen[LEFT]) + int(_park_seen[RIGHT])
	print("parkcheck: %d/%d props held, %d hand(s) parked" % [held, balls.size(), parked])
	# THE THROW LOCKOUT, tested by trying it rather than by reading the flag. A parked hand
	# that can still be made to throw is the whole failure this harness exists to catch.
	var refused := 0
	for h in [LEFT, RIGHT]:
		if not hand_parked[h] or stack(h).is_empty():
			continue
		var before := stack(h).size()
		do_throw(h, 0)
		if stack(h).size() == before:
			refused += 1
		else:
			print("parkcheck FAIL: parked %s threw anyway" % ["L" if h == LEFT else "R"])
	# and the REACH, the visible half of the rule (see the in-flight measurement above).
	if _park_reach > HAND_IN_DX + 1.0:
		print("parkcheck OK: a parked hand reached %.0fpx from centre for an incoming prop "
			% _park_reach + "(the throw slot it can no longer use is %.0f)" % HAND_IN_DX)
	elif _park_reach <= 0.0:
		# NOT A FAILURE, AND SAYING SO MATTERS. At three or four props the hand parks on the
		# very LAST catch of the set, so by the time it is parked there is nothing left in the
		# air to reach for and the case simply does not arise. It needs five, where the
		# collecting hand still has props coming after it has taken its second.
		print("parkcheck: reach not exercised at %d props - a hand parks on the last catch "
			% balls.size() + "here, so nothing is left in the air afterwards. Try more props.")
	else:
		print("parkcheck FAIL: a parked hand reached only %.0fpx, no further than its dead "
			% _park_reach + "throw slot (%.0f)" % HAND_IN_DX)
	if parked == 0:
		print("parkcheck FAIL: the gesture never parked a hand")
	elif refused == parked:
		print("parkcheck OK: every parked hand refused to throw")
	get_tree().quit()


func _capture_and_quit() -> void:
	if _collcheck:
		# the overlap audit's verdict: the tightest edge-to-edge clearance any two
		# airborne props reached this session (negative would be a visual overlap)
		if _coll_min > 100000.0:
			# still the sentinel: two props never shared the air, so nothing was
			# actually audited. Loudly say so rather than let the absurd number read
			# as "infinite clearance, all clear" (give the run more frames via
			# --shotat, or a real --pattern/--balls/--prop to put props up)
			print("collcheck WARNING: nothing measured - no two props were ever airborne together")
		print("collcheck min clearance: %.1f px" % _coll_min)
		print("collcheck at: %s" % _coll_at)
		# ...and at drawn size, which is the one that answers "do the two roads LOOK
		# like they pass through each other" (see _coll_min_drawn)
		print("collcheck min drawn gap: %.1f px" % _coll_min_drawn)
		print("collcheck drawn at: %s" % _coll_at_drawn)
	# the audit needs no picture, and a picture is the only thing --headless cannot
	# give us (the viewport has no texture there). Asking for one anyway is what used
	# to force the whole pattern sweep through slow, wall-clock-bound windowed runs.
	if _shot_path != "":
		var tex := get_viewport().get_texture()  # see shot_state_name() below for the print
		if tex != null:
			var img := tex.get_image()
			if img != null:
				if _art_pixel:
					img = art_pixel_preview(img)
				img.save_png(_shot_path)
		# SAY WHAT WAS PHOTOGRAPHED, OVERLAY AND ALL. A capture can silently be the wrong screen -
		# get_viewport().get_texture() hands back the last PRESENTED frame, and an
		# unfocused window presents late - and the PNG that comes out is a perfectly
		# valid picture of something else, so no check on the file can catch it.
		# Measured 2026-08-05: `--establish 2` and `--establish 3` each captured the
		# practice screen once and the right card on retry, from the identical command.
		# Printing the state turns that into something a script can assert on
		# (scripts/screenshot.sh does), and it costs one line per dev capture.
		print("shot state: %d %s" % [game_state, shot_state_name()])
	get_tree().quit()


func shot_state_name() -> String:
	# The label a capture script asserts against (see the --shot print above). It has to
	# name the OVERLAY, not just game_state, because the screens dev flags reach most
	# often are overlays: --shop, --sheet, --skills, --pause, --results and --tailor all
	# sit on top of ST_PLAY or ST_DAY, so game_state alone would report "play" for six
	# different pictures and assert nothing. Overlays are tested before the base state
	# and in paint order, topmost first, so the name matches what is actually on screen.
	if _propref != "" or _charref:
		return "ref"          # an isolated art reference, not a screen
	if debug_panel_open:
		return "f9"
	if paused:
		return "pause"
	if results_open:
		return "results"
	if ucard_kind >= 0:
		return "ucard"
	if shop_open:
		return "shop"
	if tailor_open:
		return "tailor"
	if sheet_open:
		return "sheet"
	if skills_open:
		return "skills"
	if tut_id != "":
		return "tutorial"
	match game_state:
		ST_MENU: return "menu"
		ST_SLOTS: return "slots"
		ST_SETTINGS: return "settings"
		ST_PLAY: return "play"
		ST_ESTABLISH: return "establish"
		ST_CREDITS: return "credits"
		ST_DAY: return "day"
		ST_STATS: return "stats"
		ST_REMAP: return "remap"
		ST_GAMEOVER: return "gameover"
		ST_TUTDONE: return "tutdone"
		ST_CAPSULE: return "capsule"
		ST_DEMO_WALL: return "demowall"
		ST_PURIST_LEGEND: return "legend"
		ST_MENUTOUR: return "menutour"
		ST_DIFFICULTY: return "difficulty"
	return "state%d" % game_state

#endregion
