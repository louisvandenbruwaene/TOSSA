#region VENUES & PROPS
func debug_jump_venue(i: int) -> void:
	# debug: leap up the ladder by setting Reputation to a venue's door, then land
	# in the day so the higher stages can be played at once (no story to replay).
	# Clamps to MAX_VENUE, not TOP_VENUE (2026-07-18: those are no longer the same
	# thing - The Midnight Show sits past the win venue), and forces `won` too,
	# since venue 7 is gated on both.
	i = clampi(i, 0, MAX_VENUE)
	if i >= MAX_VENUE:
		won = true
	reputation = maxi(reputation, VENUE_REP[i])
	venue_pick = i
	save_progress()
	enter_day()


func in_demo_build() -> bool:
	# true in a real export tagged with the "demo" custom feature, OR under the
	# dev-only --demowall override (see _force_demo) - every demo-scoping check
	# reads THIS, never OS.has_feature("demo") directly, so the dev flag actually
	# exercises the same code path a real demo export would.
	return OS.has_feature("demo") or _force_demo


func venue_index() -> int:
	# the ONE gameplay-facing "how far can you go right now" - every real gate
	# (play_venue, the venue picker, a skill's own venue requirement, daily_venue)
	# reads THIS, not venue_index_of directly, so a demo cap here reaches every one
	# of them for free. venue_index_of(rep) itself stays uncapped on purpose - the
	# rep-swing math and the demo-wall detection in resolve_act() both need the
	# TRUE tier Reputation has actually earned, capped or not.
	var idx := venue_index_of(reputation)
	if in_demo_build():
		idx = mini(idx, DEMO_MAX_VENUE)
	return idx


func venue_index_of(rep: int) -> int:
	# the stage you play grows as Reputation climbs, six rungs to the World Arena -
	# The Midnight Show (2026-07-18) is a 7th, bonus rung on TOP of that: it asks
	# BOTH Legend reputation AND `won` (Louis: post-game content, never reachable
	# before the real win, however high reputation alone happens to climb)
	# THE FOURTH AND LAST READER OF THIS LADDER, and the one that actually opens the
	# doors - so it is the one a stale copy would hurt most. It held its own six literals
	# (100/300/700/1500/3000/6000) until 2026-07-27, when the ladder was re-balanced and
	# every one of them silently disagreed with VENUE_REP. rep_tier() and next_venue_rep()
	# had the same bug. All four read the constant now: **VENUE_REP is the ladder, and
	# nothing else may restate it.**
	if rep >= int(VENUE_REP[MAX_VENUE]) and won:
		return MAX_VENUE
	for i in range(TOP_VENUE, 0, -1):
		if rep >= int(VENUE_REP[i]):
			return i
	return 0


func cur_venue() -> int:
	# menu/results screens and previews (e.g. the Controls screen's backdrop) can
	# override which venue palette we render; view_venue < 0 means no override
	return view_venue if view_venue >= 0 else play_venue()


func venue_flavour(i: int) -> Dictionary:
	return VENUE_FLAVOUR[clampi(i, 0, VENUE_FLAVOUR.size() - 1)]


const STAND_DEFAULT := 0.86   # see `stand` below, and stage_floor_y


func venue_data(i: int) -> Dictionary:
	# per-venue palette: backdrop glow / floor / spotlight strength, and the
	# juggler's costume, so each rung of the career looks distinct while sharing
	# the warm theatrical base (ART_AND_MUSIC.md).
	#
	# `stand` IS WHERE HIS FEET GO, as a fraction of the viewport height, and it is a
	# measured property of that venue's PAINTING - see stage_floor_y for why it can no
	# longer be one number for all seven rooms. Read off the backdrop with a labelled
	# ruler (art y / 360) and then checked against a real capture, because the floor a
	# painting shows is a band in perspective and the number has to land INSIDE it:
	#
	#   venue           floor band (art y)   stand   what he is standing on
	#   Backyard              255..360        0.87   the lawn, out in front of the house
	#   Street Corner         285..360        0.88   the cobbles, out in front of the lamp
	#   Small Theatre         289..360        0.85   the boards, a third of the way out
	#   The Circus            292..340        0.87   the sawdust, inside the ring wall
	#   Championship          272..360        0.85   the marked floor
	#   World Arena           292..360        0.86   the pitch
	#   The Midnight Show     265..313        0.83   the cabaret boards, among the tables
	#
	# The Midnight Show is the one with a hard LOWER edge rather than a band running off the
	# bottom of the frame: its little stage has a front lip at art y 313 and a dark drop below
	# it, so 0.87 would have stood him on the very edge of it.
	#
	# The lower bound on all of these is the HUD, not the picture: the bottom strips start
	# at 0.90 of the height, so a standing line past ~0.89 puts his boots in the readout.
	match i:
		0:
			return {"name": "Backyard", "glow": Color(0.55, 0.62, 0.45), "floor": Color(0.09, 0.10, 0.07), "spot": 0.03, "stand": 0.87,
				"suit": Color(0.42, 0.36, 0.28), "suit_dk": Color(0.30, 0.25, 0.19), "vest": Color(0.66, 0.58, 0.40), "collar": Color(0.85, 0.82, 0.72)}
		1:
			return {"name": "Street Corner", "glow": Color(0.95, 0.66, 0.34), "floor": Color(0.07, 0.07, 0.10), "spot": 0.05, "stand": 0.88,
				"suit": Color(0.34, 0.36, 0.46), "suit_dk": Color(0.22, 0.24, 0.33), "vest": Color(0.70, 0.62, 0.42), "collar": Color(0.88, 0.86, 0.78)}
		2:
			return {"name": "Small Theatre", "glow": Color(0.95, 0.55, 0.28), "floor": Color(0.10, 0.05, 0.06), "spot": 0.05, "stand": 0.85,
				"suit": Color(0.62, 0.16, 0.20), "suit_dk": Color(0.44, 0.10, 0.15), "vest": Color(0.90, 0.73, 0.42), "collar": Color(0.96, 0.90, 0.80)}
		3:
			return {"name": "The Circus", "glow": Color(0.98, 0.48, 0.35), "floor": Color(0.12, 0.06, 0.05), "spot": 0.06, "stand": 0.87,
				"suit": Color(0.80, 0.22, 0.24), "suit_dk": Color(0.55, 0.14, 0.16), "vest": Color(0.96, 0.80, 0.40), "collar": Color(0.98, 0.93, 0.82)}
		4:
			return {"name": "Championship", "glow": Color(0.55, 0.68, 0.95), "floor": Color(0.06, 0.07, 0.11), "spot": 0.07, "stand": 0.85,
				"suit": Color(0.20, 0.28, 0.52), "suit_dk": Color(0.13, 0.19, 0.38), "vest": Color(0.80, 0.84, 0.92), "collar": Color(0.90, 0.93, 0.98)}
		5:
			return {"name": "World Arena", "glow": Color(0.78, 0.52, 0.96), "floor": Color(0.09, 0.06, 0.12), "spot": 0.08, "stand": 0.86,
				"suit": Color(0.42, 0.20, 0.55), "suit_dk": Color(0.28, 0.12, 0.40), "vest": Color(0.96, 0.82, 0.45), "collar": Color(0.98, 0.94, 0.86)}
		_:
			# The Midnight Show (2026-07-18): the bonus, post-game 7th stage - a
			# genuinely DARK house (spot half of even the Backyard's, the dimmest
			# of the original six) so the Glow-in-the-Dark Kit has somewhere it is
			# actually worth wearing. The costume carries the whole theme: a suit
			# that nearly vanishes into the dark, and a vest the same phosphor
			# green as the Kit's own halo, so the performer visibly glows.
			# `veil` 0.40, AND IT USED TO BE 0.10 (2026-08-15). The old number was not a
			# taste call, it was a fact about the old PAINTING: that set was drapes and
			# tables over near-black, so the standard 0.42 push-back had nothing left to
			# take and simply erased it. The painting that replaced it - a raised stage
			# with the supper tables in front - has a warm oak floor, and 0.10 left it at
			# luminance 85 against the old set's 45 and the Circus's 64. That made the
			# darkest room in the game the BRIGHTEST, which quietly cancels the reason the
			# room exists: a suit that nearly vanishes and a phosphor-green vest have
			# nothing to vanish into on lit boards, and the Glow Kit stops being worth
			# wearing. **A venue's veil belongs to its painting, so a repaint has to
			# re-measure it** - it is the one number in this table that is about the art
			# rather than about the design. 0.40 brings the boards back to ~52, still just
			# off the old floor and still the dimmest house on the ladder.
			# The floor colour is lifted off pure black for the older reason, which has not
			# changed - a dark room is not an unlit one, and the boards have to read as
			# boards for a landed prop to read as landed.
			return {"name": "The Midnight Show", "glow": Color(0.40, 0.92, 0.62), "floor": Color(0.045, 0.075, 0.06), "spot": 0.015,
				# STAND 0.811, AND THE JOURNEY TO IT IS THE POINT (2026-08-15, Louis: "for the
				# midnight show: put the tables in front of the stage, not on top of it"). The old
				# painting put the supper tables on the SAME floor the performer stands on, so he
				# juggled in the middle of a restaurant among the diners rather than in front of
				# them. The repaint is three bands: drapes, a raised stage, then the front row of
				# tables below and in front of the stage edge, cropped by the bottom of the frame.
				#
				# The obvious move was to follow the new painting - its stage ended at art y 250, so
				# `stand` went to 0.645 - and that is WRONG for a reason no amount of looking at the
				# picture reveals. The hand line hangs off the standing line, so raising him by 133
				# screen px raises every throw by 133. A full-hold 1.4 throw peaks BASE_AIR * 1.4 *
				# ARC_PER_AIR = 253 px above the hand: at 0.83 that apex is screen y 85 and on
				# screen, at 0.645 it is y -48 and gone. Holding the throw key is not an edge case,
				# and the player has to TRACK a prop to catch it.
				#
				# **THE FLOOR BAND HAS A MINIMUM DEPTH, AND THE ARC SETS IT, NOT THE PAINTING.** So
				# the painting was rebanded to fit the game instead (scripts/reband_backdrop.py):
				# drapes stretched, boards deepened, foreground furniture moved at 1:1 and cropped.
				# 0.811 keeps him on the boards with stage visible behind his heels and in front,
				# and puts the 1.4 apex back at y 70. Keep pixelise_paint.py's STAND copy in step -
				# nothing links them.
				"veil": 0.40, "stand": 0.811,
				"suit": Color(0.08, 0.10, 0.09), "suit_dk": Color(0.04, 0.05, 0.045), "vest": Color(0.55, 0.95, 0.65), "collar": Color(0.75, 0.92, 0.8)}


func cur_prop() -> Dictionary:
	return PROPS[prop_type]


func prop_weight(kind: int = -1) -> int:
	return int(PROPS[prop_type if kind < 0 else kind]["weight"])


func have(kind: int) -> int:
	# EVERY prop is owned by quantity now, balls included (Louis: they don't appear
	# out of thin air) - a fresh save starts with three, the shop sells the rest
	return prop_count[kind]


func available(kind: int) -> bool:
	# selectable only if you own enough to juggle the minimum count AND are strong enough to
	# throw that many. Both halves are hard walls (2026-07-29): a prop you cannot lift three
	# of is not a prop you can practise with, so it should not be offered.
	return have(kind) >= MIN_BALLS and max_count(kind) >= MIN_BALLS


func prop_color(kind: int) -> Color:
	match kind:
		PROP_EGGS:    return Color(0.96, 0.92, 0.82)
		PROP_RINGS:   return Color(0.45, 0.80, 0.95)
		PROP_CLUBS:   return Color(0.90, 0.35, 0.38)
		PROP_KNIVES:  return Color(0.82, 0.86, 0.92)
		PROP_TORCHES: return Color(1.0, 0.62, 0.24)
		PROP_CHAINSAW: return Color(0.96, 0.58, 0.14)
		_:            return Color(1.0, 0.82, 0.35)


func prop_scale(kind: int) -> float:
	# heavier and longer props are physically bigger than balls, so they read larger
	match kind:
		PROP_RINGS:   return 1.7
		PROP_CLUBS:   return 1.6
		PROP_KNIVES:  return 1.5
		PROP_TORCHES: return 1.75
		PROP_CHAINSAW: return 1.9
		PROP_EGGS:    return 1.1
		_:            return 1.0


const RING_HIT_FACTOR := 0.65  # rings are mostly hole - the true catchable rim reads far
								# smaller than the drawn ring's full diameter (Louis), so
								# their hitbox is always shrunk by this factor, on TOP of
								# the many-object squeeze below. Tune here if it feels off.

func _coll_pair(pa: Vector2, pb: Vector2, a: Ball, b: Ball) -> String:
	# one line naming WHERE the closest pass happened and what each prop was doing:
	# `ot` is the over-the-top road (so a Shower/Half Shower report says which of the two
	# roads each prop was on), `h` the height fraction it was thrown at, `p` how far
	# through its flight it was. Shared by both the hitbox and the drawn-size minimum.
	var prog := func(x: Ball) -> float:
		return clampf(float(tick - x.launch_tick) / float(maxi(1, x.land_tick - x.launch_tick)), 0.0, 1.0)
	return "tick %d  a=(%.0f,%.0f ot=%s h=%.2f p=%.2f)  b=(%.0f,%.0f ot=%s h=%.2f p=%.2f)" % [
		tick, pa.x, pa.y, str(a.over_top), a.height, prog.call(a),
		pb.x, pb.y, str(b.over_top), b.height, prog.call(b)]


func prop_hit_scale(_kind: int) -> float:
	# ONE HITBOX (2026-07-29, Louis: "right now i feel like some patterns use different hitboxes
	# for each prop. I want only one hitbox, such that the pattern that is most picky: eg 15
	# chainsaw columns, still works as expected").
	#
	# It used to be three shrinks multiplied together - a per-PROP one so a club's bulk faded
	# toward a ball's, a per-COUNT one on a ~1/count curve, and a per-PATTERN one off
	# PATTERNS["room"]. Each was individually well reasoned, and the three together meant no two
	# situations shared a collision rule: "does this pattern work at this count with this prop"
	# had 6 x 13 x 7 different answers, and tuning any one moved the others. That is the thing
	# he is describing.
	#
	# Now: one number, small enough that the tightest real geometry in the game - fifteen
	# chainsaws in Columns, which the lane arithmetic packs to about 9px of daylight - has room
	# to run. A clack is therefore a genuine collision at any count rather than a threshold that
	# moved under the player. PATTERNS["room"] is unread now; it stays in the table because it
	# is a measured fact about each pattern and whoever tunes collisions next will want it.
	return HIT_FLOOR


func invest(which: String, defer_save: bool = false) -> void:
	if points <= 0:
		return
	var prev_max := max_balls()   # Strength may cross a ball-count gate; catch it below
	# a capped stat refuses the point instead of eating it (Speed always did; the
	# others used to consume the point and change nothing)
	match which:
		"acc":
			if accuracy >= ACC_CAP:
				return
			accuracy += 1   # past 100 becomes Focus
		"str":
			if strength >= STR_CAP:
				return
			strength += 1
		"end":
			if endurance >= END_CAP:
				return
			endurance += 1
			stamina_max = 100.0 + 9.0 * float(endurance)
		"spd":
			if speed >= SPEED_CAP:
				return   # the permanent slow tops out (ideas.rtf): no point wasted
			speed += 1
	points -= 1
	check_ball_unlock(prev_max)   # a new ball count queues its own lesson at the hub
	announce_unlocks()            # a stat spend can cross a skill's Strength/Accuracy ask
	if not defer_save:
		save_progress()


func sheet_ids() -> Array[String]:
	# the four stat cards, in the order the sheet lays them out and arrows walk them -
	# one array, read by sheet_input, sheet_repeat and the talent-tree sheet alike, so
	# the order can never drift between a reader and another.
	return ["acc", "str", "end", "spd"]


func _sheet_invest(which: String) -> void:
	if debug_mode:
		_adjust(which, 1)   # debug build: free, no point cost
	else:
		invest(which)


func _sheet_invest_repeat(which: String) -> void:
	# the same free/spend choice _sheet_invest makes, for a HELD Enter (sheet_repeat) -
	# but the save is deferred to key-release rather than fired on every point of a
	# burst, the same reason the money repeat above defers its own save.
	if debug_mode:
		_adjust(which, 1)
	else:
		invest(which, true)


func sheet_repeat(dt: float) -> void:
	# HOLDING ENTER KEEPS INVESTING IN THE SELECTED STAT (2026-07-31, Louis: stats go up
	# only by arrow-selecting one and confirming with Enter, "make sure you can hold it to
	# increase numbers fast") - real play's own repeat, on the exact accel curve the
	# debug-only keys below already used. `_sheet_invest_repeat` makes the same free/spend
	# choice `_sheet_invest` does but defers the save (see its own comment) the same way
	# the money repeat below does, so a fast burst is not also a burst of disk writes.
	# Every OTHER key here (1-4, Q/W/E/R, M/N) stays debug build only: while the character
	# sheet is open, HOLDING one of those keeps stepping the stat instead of one press per
	# point. The first press was already applied by _input, so a freshly held key waits
	# SHEET_REPEAT_DELAY before it starts repeating.
	var key := 0
	var which := ""
	var delta := 0
	if Input.is_physical_key_pressed(KEY_ENTER) or Input.is_physical_key_pressed(KEY_KP_ENTER):
		key = KEY_ENTER; which = sheet_ids()[sheet_sel]; delta = 1
	elif not debug_mode:
		pass   # every remaining key below is debug-only
	elif Input.is_physical_key_pressed(KEY_1):
		key = KEY_1; which = "acc"; delta = 1
	elif Input.is_physical_key_pressed(KEY_2):
		key = KEY_2; which = "str"; delta = 1
	elif Input.is_physical_key_pressed(KEY_3):
		key = KEY_3; which = "end"; delta = 1
	elif Input.is_physical_key_pressed(KEY_4):
		key = KEY_4; which = "spd"; delta = 1
	elif Input.is_physical_key_pressed(KEY_R):
		key = KEY_R; which = "spd"; delta = -1
	elif Input.is_physical_key_pressed(KEY_Q):
		key = KEY_Q; which = "acc"; delta = -1
	elif Input.is_physical_key_pressed(KEY_W):
		key = KEY_W; which = "str"; delta = -1
	elif Input.is_physical_key_pressed(KEY_E):
		key = KEY_E; which = "end"; delta = -1
	# ...AND THE PURSE, on the same mechanism (2026-07-28, Louis: "make the debug money up
	# button (m) and down, be able to held to rapidly increase amounts (toggle by the
	# thousand)"). Two presses were needed for every 100 gold, and the things worth testing
	# cost 60,000 - which is twelve hundred presses of M to reach the Glow Kit.
	#
	# A TAP AND A HELD REPEAT ARE THE SAME THOUSAND, and the hold then ACCELERATES on the
	# same SHEET_REPEAT_RAMP curve the stats use - so a tap is a thousand, a second of
	# holding is several, and three seconds crosses the whole economy.

	elif Input.is_physical_key_pressed(KEY_M):
		key = KEY_M; which = "money"; delta = MONEY_HOLD_STEP
	elif Input.is_physical_key_pressed(KEY_N):
		key = KEY_N; which = "money"; delta = -MONEY_HOLD_STEP
	if key == 0:
		if _repeat_key != 0 and _repeat_dirty:
			save_progress()   # ...and the disk is written ONCE, on release. See below.
			_repeat_dirty = false
		_repeat_key = 0
		return
	if key != _repeat_key:
		_repeat_key = key       # newly held: hold off until the initial delay elapses
		_repeat_t = -SHEET_REPEAT_DELAY
		_repeat_held = 0.0
		return
	# ...and it ACCELERATES the longer it is held (Louis, 2026-07-27: "rapidly change
	# their values"). A flat 25 points a second takes eight seconds to walk Accuracy to
	# its cap, which is eight seconds of holding a key to set up one test. The rate
	# doubles every SHEET_REPEAT_RAMP seconds, up to SHEET_REPEAT_MAX steps a tick, so a
	# brief tap is still one point and a long hold crosses the whole range in a moment.
	_repeat_t += dt
	_repeat_held += dt
	var cap := MONEY_HOLD_MAX if which == "money" else SHEET_REPEAT_MAX
	var burst := clampi(int(pow(2.0, _repeat_held / SHEET_REPEAT_RAMP)), 1, cap)
	# ONE _adjust PER REPEAT, WITH THE BURST FOLDED INTO THE AMOUNT for money. A stat is
	# clamped to a cap, so stepping it `burst` times and stepping it once by `burst` are
	# genuinely different at the ceiling and the loop is correct there. A purse has no cap,
	# so the loop would just be MONEY_HOLD_MAX identical save_progress() calls a tick - up
	# to sixty-four disk writes per repeat, which is what makes a held key stutter.
	while _repeat_t >= SHEET_REPEAT_RATE:
		_repeat_t -= SHEET_REPEAT_RATE
		if which == "money":
			_repeat_dirty = true
			money = maxi(0, money + delta * burst)
		elif key == KEY_ENTER:
			_repeat_dirty = true   # invest() defers its own save - see _sheet_invest_repeat
			for _i in burst:
				_sheet_invest_repeat(which)
		else:
			for _i in burst:
				_adjust(which, delta)


func _adjust(which: String, delta: int) -> void:
	var prev_max := max_balls()
	match which:
		"acc":
			accuracy = clampi(accuracy + delta, 1, ACC_CAP)
		"str":
			strength = clampi(strength + delta, 1, STR_CAP)
		"end":
			endurance = clampi(endurance + delta, 0, END_CAP)
			stamina_max = 100.0 + 9.0 * float(endurance)
			stamina = minf(stamina, stamina_max)
		"spd":
			speed = clampi(speed + delta, 0, SPEED_CAP)
		"money":
			# debug only, and it is a PURSE, not a stat - no cap, no ball unlock, and it
			# floors at nothing rather than at one
			money = maxi(0, money + delta)
	check_ball_unlock(prev_max)
	save_progress()


func save_file() -> String:
	# debug_mode stays first so --demo --debug (used to preview venues) still lands
	# on the debug save. Otherwise, any unattended dev autoplay writes to its own
	# scratch file and must never touch a real career slot.
	if debug_mode:
		return SAVE_PATH_DEBUG
	if _demo or _shot:
		return SAVE_PATH_DEMO
	return slot_path(save_slot)


func _migrate_lesson_id(id: String) -> String:
	# the four routine-reshaping toggles became PATTERNS (one pattern at a time,
	# Louis), so their old trick-lesson ids map to the pattern lessons that
	# replaced them. Every other id passes through untouched.
	match id:
		"trick_cols": return "pattern_columns"
		"trick_rcasc": return "pattern_rcasc"
		"trick_tennis": return "pattern_tennis"
	return id


func load_progress() -> void:
	var cf := ConfigFile.new()
	if cf.load(save_file()) == OK:
		# CLAMPED TO THE LIVE CAPS ON THE WAY IN (2026-07-29). Accuracy's ceiling came down
		# from 250 to 200 with the Focus rework, so a save made before that can carry up to
		# fifty points the game no longer has a use for - and an out-of-range stat is the
		# kind of thing that reads fine on the sheet and then divides by a cap somewhere far
		# away. The points are not refunded: they were spent on a stage of Focus that no
		# longer exists, and quietly handing back fifty stat points is a bigger surprise than
		# quietly losing them.
		accuracy = clampi(int(cf.get_value("stats", "accuracy", 5)), 0, ACC_CAP)
		strength = clampi(int(cf.get_value("stats", "strength", 6)), 0, STR_CAP)
		endurance = clampi(int(cf.get_value("stats", "endurance", 0)), 0, END_CAP)
		speed = clampi(int(cf.get_value("stats", "speed", 0)), 0, SPEED_CAP)
		pie_count = int(cf.get_value("stats", "pies", 0))
		pie_active = bool(cf.get_value("day", "pie_active", false))
		money = int(cf.get_value("stats", "money", START_GOLD))
		tomatoes = int(cf.get_value("stats", "tomatoes", 0))
		reputation = int(cf.get_value("stats", "reputation", 0))
		sync_props()
		var pc: Variant = cf.get_value("stats", "prop_count", [])
		if pc is Array:
			for i in mini((pc as Array).size(), prop_count.size()):
				prop_count[i] = int((pc as Array)[i])
		# balls used to be free and unlimited, so old saves stored 0 of them: every
		# save keeps at least the starting kit of three (balls are stock now)
		prop_count[PROP_BALLS] = maxi(prop_count[PROP_BALLS], 3)
		prop_type = int(cf.get_value("stats", "prop_type", PROP_BALLS))
		# an old save wrote ONE "glow_kit" flag; it means both halves, which is exactly
		# what it bought. Read it as the default for each so nobody loses a 60,000 item.
		# AN OLD SAVE'S GLOW TAPE LIT EVERY PROP IT OWNED, so that is exactly what it is
		# migrated to: a glowing copy of the whole collection. Anything else would take a
		# 34,000 purchase away from somebody mid-career.
		var old_kit := bool(cf.get_value("stats", "glow_kit", false))
		var old_tape := bool(cf.get_value("stats", "glow_tape", old_kit))
		var gsaved: Array = cf.get_value("stats", "glow_count", [])
		glow_count = [0, 0, 0, 0, 0, 0, 0]
		for gi2 in mini(gsaved.size(), glow_count.size()):
			glow_count[gi2] = maxi(0, int(gsaved[gi2]))
		if old_tape and gsaved.is_empty():
			for gi3 in glow_count.size():
				glow_count[gi3] = int(prop_count[gi3]) if gi3 < prop_count.size() else 0
		has_backroom = bool(cf.get_value("stats", "backroom", false))
		energy_drinks = int(cf.get_value("stats", "energy_drinks", 0))
		level = int(cf.get_value("prog", "level", 1))
		xp = int(cf.get_value("prog", "xp", 0))
		points = int(cf.get_value("prog", "points", 0))
		won = bool(cf.get_value("prog", "won", false))
		demo_wall_seen = bool(cf.get_value("prog", "demo_wall_seen", false))
		purist_legend_seen = bool(cf.get_value("prog", "purist_legend_seen", false))
		post_lesson_show = bool(cf.get_value("prog", "post_lesson_show", false))
		show_guide_seen = bool(cf.get_value("prog", "show_guide_seen", false))
		var bs: Variant = cf.get_value("prog", "best_scores", [])
		if bs is Array:
			for i in mini((bs as Array).size(), best_scores.size()):
				best_scores[i] = float((bs as Array)[i])
		var bp: Variant = cf.get_value("prog", "best_scores_purist", [])
		if bp is Array:
			for i in mini((bp as Array).size(), best_scores_purist.size()):
				best_scores_purist[i] = float((bp as Array)[i])
		pattern_ver = int(cf.get_value("prog", "pattern_ver", 0))
		var raw_pattern_sel := int(cf.get_value("prog", "pattern_sel", CASCADE))
		if pattern_ver < 2:
			# migrate a pre-2026-07-19 save straight from PATTERNS' ORIGINAL 8-entry
			# layout (Cascade0 Fountain1 Columns2 HalfShower3 Shower4 RCasc5
			# Waterfall6 Tennis7) to the current one in a single jump - no real save
			# was ever written in the brief intermediate 7-entry (Waterfall-removed-
			# only) shape, so there is nothing between "pre-migration" and "current"
			# worth stepping through. Fountain and Waterfall both fold into their
			# closest surviving relative rather than silently becoming whatever now
			# sits at their old index once (each shifted by their own amount).
			match raw_pattern_sel:
				0, 1: raw_pattern_sel = CASCADE       # Cascade itself, or Fountain folded in
				2: raw_pattern_sel = COLUMNS
				3: raw_pattern_sel = HALFSHOWER
				4: raw_pattern_sel = SHOWER
				5: raw_pattern_sel = RCASC
				6: raw_pattern_sel = HALFSHOWER       # Waterfall folded into Half Shower
				7: raw_pattern_sel = TENNIS
				_: raw_pattern_sel = CASCADE          # anything unrecognised: the safe default
			pattern_ver = 2
		pattern_sel = clampi(raw_pattern_sel, 0, PATTERNS.size() - 1)
		var cr: Variant = cf.get_value("prog", "career", {})
		if cr is Dictionary:
			for k in career:
				if (cr as Dictionary).has(k):
					career[k] = int((cr as Dictionary)[k])
		# lessons already taught, and lessons queued but not yet taught, both persist -
		# without this an unlock lesson (Phase 1) re-fired every launch (the seen_tuts bug).
		# Ids run through _migrate_lesson_id: a save from before the pattern fold may
		# still hold the four routine toggles as trick lessons.
		var st: Variant = cf.get_value("prog", "seen_tuts", [])
		if st is Array:
			seen_tuts.clear()
			for v in (st as Array):
				seen_tuts.append(_migrate_lesson_id(String(v)))
		var pt: Variant = cf.get_value("prog", "pending_tuts", [])
		if pt is Array:
			pending_tuts.clear()
			for v in (pt as Array):
				pending_tuts.append(_migrate_lesson_id(String(v)))
		# the standing ante per venue (complete acts there): the raised bar the venue
		# remembers between visits. The rest of the act is per-night and unsaved.
		var an: Variant = cf.get_value("prog", "ante", [])
		if an is Array:
			for i in mini((an as Array).size(), ante.size()):
				ante[i] = int((an as Array)[i])
		# the reward director's memory: gifts stay given, the drought clock survives
		var gf: Variant = cf.get_value("prog", "gifted", [])
		if gf is Array:
			gifted.clear()
			for v in (gf as Array):
				gifted.append(String(v))
		perfs_since_unlock = int(cf.get_value("prog", "perfs_since_unlock", 0))
		aid_pie_day = int(cf.get_value("prog", "aid_pie_day", -1))
		aid_meal_used = bool(cf.get_value("prog", "aid_meal_used", false))
		purist = bool(cf.get_value("day", "purist", false))
		# an OLD save has no per-stat picks at all - default them to match the one flag
		# it does have, so a save from before this existed still reads as consistent
		var pp: Variant = cf.get_value("day", "purist_picks", [purist, purist, purist, purist])
		if pp is Array and (pp as Array).size() == 4:
			purist_picks = [bool(pp[0]), bool(pp[1]), bool(pp[2]), bool(pp[3])]
		day = int(cf.get_value("day", "day", 1))
		seg_used = int(cf.get_value("day", "seg_used", 0))
		venue_pick = int(cf.get_value("day", "venue_pick", -1))
		meals = int(cf.get_value("day", "meals", 0))
	# A SAVE FROM BEFORE THE CARDS OWNED ITS SKILLS IMPLICITLY (2026-07-28) - and this
	# migration is the part with teeth. Until today a skill was unlocked by STANDING PAST
	# ITS WALL: nothing was written down, `gifted` held only the handful the pity director
	# had granted, and every other skill was recomputed from the stats on every launch.
	# Ownership is explicit now, so loading an old save without this would silently strip a
	# mid-career juggler of every trick and pattern they had ever earned - the save file
	# would look intact and the player would open the Skills screen to find it empty.
	#
	# So: seed `gifted` with everything whose wall this save has ALREADY cleared, which is
	# exactly the set that was unlocked a moment before the update. `skill_ver` marks it
	# done, once, per save. Nothing is taken away and nothing new is granted.
	# every wear flag defaults TRUE, so a career from before the tailor existed opens
	# dressed in everything it owns rather than stripped by an update it never asked for
	outfit_suit = int(cf.get_value("wear", "suit", -1))
	# WHAT IS OWNED, AND WHAT IS ON. Both are flat lists keyed by "<piece>:<stage>", so adding
	# a ninth garment or an eighth house needs no migration at all.
	var ow: Variant = cf.get_value("wear", "owned", [])
	owned_wear.clear()
	if ow is Array:
		for v in (ow as Array):
			owned_wear.append(String(v))
	var wp: Variant = cf.get_value("wear", "worn", {})
	worn_piece.clear()
	if wp is Dictionary:
		for k in (wp as Dictionary):
			worn_piece[String(k)] = int((wp as Dictionary)[k])
	# A CAREER FROM BEFORE THE TAILOR SOLD CLOTHES keeps everything it bought, cut for the
	# house it had reached when it bought it - which is the only stage it could have been
	# wearing them at. Nothing is taken away, and one of them will therefore match.
	if int(cf.get_value("wear", "ver", 0)) < 1:
		var vstage := clampi(venue_index(), 0, MAX_VENUE)
		for pair in [["glasses", "glasses"], ["gloves", "gloves"], ["boots", "boots"],
				["hat", "hat"], ["coat", "coat"], ["vest", "vest"], ["helmet", "helmet"],
				["glow", "glow_suit"]]:
			if bool(cf.get_value("stats", String(pair[1]), false)):
				var k := wear_key(String(pair[0]), vstage)
				if not owned_wear.has(k):
					owned_wear.append(k)
				worn_piece[String(pair[0])] = vstage
	var skill_ver := int(cf.get_value("prog", "skill_ver", 0))
	if skill_ver < 1:
		for tab: Array in [TRICKS, PATTERNS]:
			for sd: Dictionary in tab:
				var sid := String(sd.get("id", ""))
				if sid == "" or skill_free(sd) or gifted.has(sid):
					continue
				if skill_gate_cleared(sd):
					gifted.append(sid)
	# OVERTHROW WAS REMOVED THE SAME DAY, and it was the LAST index in TRICKS - so unlike
	# the pattern fold above, nothing shifted and a clamp is the whole migration. Its
	# leftovers are dropped rather than left to point at the trick that took its slot
	# (there is none) or to keep a lesson queued that can never be taught.
	gifted.erase("over")
	pending_tuts.erase("trick_over")
	trick_sel = clampi(trick_sel, -1, TRICKS.size() - 1)
	# ONE PIECE PER CATEGORY, ENFORCED ON LOAD TOO (2026-07-30): a save from before this rule,
	# or the pre-tailor migration just above (which sets every owned piece's flag from a flat
	# bool with no notion of a slot at all), can load with a hat and the Energy Helmet both
	# marked worn. See wear_normalize.
	wear_normalize()
	stamina_max = 100.0 + 9.0 * float(endurance)
	# stamina persists through the day now (sleep restores it). An old save that
	# predates the day loop simply wakes rested.
	stamina = clampf(float(cf.get_value("day", "stamina", stamina_max)), 0.0, stamina_max)
	if venue_pick < 0:
		venue_pick = venue_index()   # older saves default to their grandest stage
	# THE DEBUG BUILD STOCKS ITSELF (see debug_stock). Outside the load block on purpose:
	# a debug save that does not exist yet never enters it, and that is exactly the case
	# this exists for. get_value on an unloaded ConfigFile returns the default, so a
	# missing file reads as "not stocked" and gets stocked.
	if debug_mode and not bool(cf.get_value("prog", "debug_stocked", false)):
		debug_stock()


func debug_stock() -> void:
	# A DEBUG BUILD SHOULD OPEN INTO A SANDBOX, NOT A GRIND. The debug shortcuts (1/2/3/4
	# up, Q/W/E/R down, M/N purse, ,/. reputation, F1-F7 venue jumps) are byte-identical to
	# TOSSA's - that was never the gap. The gap was the SAVE: TOSSA's tossa_debug.cfg had
	# been played into a loaded sandbox over months (every stat at 200, eight figures in the
	# purse, every prop and garment owned), while this fork started a brand new
	# pixeltossa_debug.cfg at three balls and sixty flowers. Same perks, nothing to use them
	# on, so the debug build opened on a pauper and everything interesting was a grind away.
	#
	# Copying the file across would have fixed it once and diverged again, and would not
	# survive deleting the save. Stocking on first load fixes it for good, including for a
	# third fork. It runs ONCE - `debug_stocked` is written into the save - so anything
	# deliberately spent or sold from here stays spent.
	#
	# It cannot touch a real career: save_file() returns SAVE_PATH_DEBUG whenever
	# debug_mode is on, and debug_mode is only ever set by --debug.
	accuracy = ACC_CAP
	strength = STR_CAP
	endurance = END_CAP
	speed = SPEED_CAP
	stamina_max = 100.0 + 9.0 * float(endurance)
	stamina = stamina_max
	money = 100_000_000            # past anything the shop can ask for, and it is a sandbox
	reputation = 12000             # clears every gate including the Midnight Show's 6000
	energy_drinks = 20
	pie_count = 10
	has_backroom = true
	# every prop, at a count the late game can actually use, and the glowing version too
	for i in prop_count.size():
		prop_count[i] = MAX_BALLS_HARD
		glow_count[i] = MAX_BALLS_HARD
	# EVERY CUT OF EVERY GARMENT, not just this stage's. A wardrobe is 8 pieces x 7 houses
	# and the whole point of the debug build is to look at any of them without earning it.
	# Nothing is WORN: wear_normalize enforces one piece per category, and picking the
	# outfit is a thing to test rather than a thing to assume.
	owned_wear.clear()
	for p in WEAR_PIECES:
		for v in TOP_VENUE + 2:      # 0..TOP_VENUE plus the Midnight Show's own cut
			owned_wear.append(wear_key(p, v))
	# points to spend, so the character sheet has something to do on the first screen
	points = 20
	save_progress()


func save_progress() -> void:
	if sprint_active:
		return   # a Sprint must never overwrite a normal career slot
	var cf := ConfigFile.new()
	cf.set_value("stats", "accuracy", accuracy)
	cf.set_value("stats", "strength", strength)
	cf.set_value("stats", "endurance", endurance)
	cf.set_value("stats", "speed", speed)
	cf.set_value("stats", "pies", pie_count)
	cf.set_value("day", "pie_active", pie_active)
	cf.set_value("stats", "money", money)
	cf.set_value("stats", "tomatoes", tomatoes)
	cf.set_value("stats", "reputation", reputation)
	cf.set_value("stats", "prop_count", prop_count)
	cf.set_value("stats", "prop_type", prop_type)
	# THESE EIGHT KEYS ARE LEGACY, and they are written from OWNERSHIP rather than from what
	# is worn. They exist only so the pre-tailor migration in load_progress can read a save
	# written by an older build - and that migration takes them to mean "bought". Writing
	# them from `wearing()` would mean a hat taken off for one act came back as a hat never
	# bought, which is a save-eating bug hiding in a one-word difference.
	cf.set_value("stats", "glasses", owns_any("glasses"))
	cf.set_value("stats", "glow_count", glow_count)
	cf.set_value("stats", "glow_suit", owns_any("glow"))
	cf.set_value("stats", "gloves", owns_any("gloves"))
	cf.set_value("stats", "boots", owns_any("boots"))
	cf.set_value("stats", "hat", owns_any("hat"))
	cf.set_value("stats", "coat", owns_any("coat"))
	cf.set_value("stats", "vest", owns_any("vest"))
	cf.set_value("stats", "backroom", has_backroom)
	cf.set_value("stats", "helmet", owns_any("helmet"))
	cf.set_value("stats", "energy_drinks", energy_drinks)
	cf.set_value("prog", "level", level)
	cf.set_value("prog", "xp", xp)
	cf.set_value("prog", "points", points)
	cf.set_value("prog", "won", won)
	# written for every save, read only by the debug build (see debug_stock): it is what
	# stops the sandbox being restocked over whatever the last debug session left behind.
	cf.set_value("prog", "debug_stocked", debug_mode)
	cf.set_value("prog", "demo_wall_seen", demo_wall_seen)
	cf.set_value("prog", "purist_legend_seen", purist_legend_seen)
	cf.set_value("prog", "post_lesson_show", post_lesson_show)
	cf.set_value("prog", "show_guide_seen", show_guide_seen)
	cf.set_value("prog", "best_scores", best_scores)
	cf.set_value("prog", "best_scores_purist", best_scores_purist)
	cf.set_value("prog", "pattern_sel", pattern_sel)
	cf.set_value("prog", "pattern_ver", pattern_ver)
	cf.set_value("prog", "skill_ver", 1)   # this save's skills are written down, not inferred
	# THE TAILOR's choices. Cosmetic, but persisted like anything else the player decided:
	# opening the game to find yourself re-dressed by the machine is exactly the small
	# betrayal that makes a wardrobe feel fake.
	cf.set_value("wear", "suit", outfit_suit)
	cf.set_value("wear", "owned", owned_wear)
	cf.set_value("wear", "worn", worn_piece)
	cf.set_value("wear", "ver", 1)
	cf.set_value("prog", "career", career)
	cf.set_value("prog", "seen_tuts", seen_tuts)       # so a lesson fires once, ever
	cf.set_value("prog", "pending_tuts", pending_tuts)  # a queued lesson survives quitting
	cf.set_value("prog", "ante", ante)                  # each venue's standing raised bar
	cf.set_value("prog", "gifted", gifted)              # pity unlocks stay unlocked
	cf.set_value("prog", "perfs_since_unlock", perfs_since_unlock)
	cf.set_value("prog", "aid_pie_day", aid_pie_day)
	cf.set_value("prog", "aid_meal_used", aid_meal_used)
	cf.set_value("day", "purist", purist)
	cf.set_value("day", "purist_picks", purist_picks)
	cf.set_value("day", "day", day)
	cf.set_value("day", "seg_used", seg_used)
	cf.set_value("day", "venue_pick", venue_pick)
	cf.set_value("day", "meals", meals)
	cf.set_value("day", "stamina", stamina)
	cf.save(save_file())


# -----------------------------------------------------------------------------
# Per-tick simulation and hand animation.
# -----------------------------------------------------------------------------

#endregion

#region SIM TICK: DROPS, COLLAPSE, FLIGHT
func spawn_falling(pos: Vector2, kind: int, col: Color) -> void:
	# a lost prop becomes a cosmetic body that FALLS to the stage floor (eggs
	# break where they land, not at arm height, Louis's note)
	# cosmetic randomness only (global randf, never the sim rng, so the sim's
	# deterministic roll sequence is untouched by how a prop happens to tumble)
	falling.append({"pos": pos, "vel": Vector2(randf_range(-0.8, 0.8), 1.4),
		"kind": kind, "col": col, "ang": randf_range(0.0, TAU),
		"spin": randf_range(-0.12, 0.12), "bounced": false, "rest": -1})


func still_dropping() -> bool:
	# is any dropped prop STILL FALLING? A prop with `rest` set has hit the boards and is
	# only lying there fading, which is scenery - see the collapse gate in _physics_process
	# for why "the list is not empty" is the wrong question.
	for d in falling:
		if int(d["rest"]) < 0:
			return true
	return false


func drop_ball(b: Ball, why: String) -> void:
	if not balls.has(b):
		return
	# A DROP CLOSES THE RUN, and that is now the most expensive thing in the game: whatever the
	# tricks multiplied this run to is banked at that value, and the next one opens at x1.
	# Done FIRST, before anything else about the drop, so nothing can score into a run that is
	# already over.
	close_run()
	balls.erase(b)
	dropped += 1
	career["drops"] = int(career["drops"]) + 1
	streak = 0
	perfect_chain = 0
	last_drop_tick = tick
	applause = maxf(0.0, applause - 0.26)
	if tut_active:
		# a drop breaks any in-a-row count a juggle-gated step was building - ten at
		# full speed means ten unbroken
		if bool(tut_step_data().get("juggle", false)):
			tut_count = 0
		# ...and it takes the subject of any frozen beat away with it. Without this the
		# world would sit stopped forever waiting on a catch of a prop that is now on
		# the floor: the one way a guided beat could deadlock.
		tut_hold_abort()
	if set_shake and not reduce_motion:
		shake = 5.0
	freeze = 1 if reduce_motion else 8   # a short hit-stop so the loss registers before play rolls on
	spawn_parts(flight_pos(b), Color(0.75, 0.5, 0.4), 10, 2.6, "spark")
	spawn_falling(flight_pos(b), b.kind, b.color)
	if b.kind == PROP_EGGS:
		# a dropped egg breaks for good, so it leaves your stock (ideas.rtf). A lesson
		# is practice, so a broken egg there is free (the mess shows when it LANDS).
		if not tut_active:
			prop_count[PROP_EGGS] = maxi(0, prop_count[PROP_EGGS] - 1)
			save_progress()
	play_sfx("drop", -7.0)
	if mode == MODE_PERFORM and not tut_active:
		play_sfx("groan", -10.0)   # the crowd sags with the prop (ART doc stingers)
	_duck = 1.0   # a drop briefly ducks the music, so the silence lands
	add_popup(b.to_pos + Vector2(0, -6), why, Color(1.0, 0.32, 0.3))
	# the collapse now has TWO triggers: an emptied crowd (below) and, new in Phase 2,
	# the drop limit. Both funnel through start_collapse(). Training plays on.
	if mode == MODE_PERFORM and not tut_active:
		if stamina <= 0.0:
			# collapsing because you are SPENT, not because the crowd walked: remember it,
			# so the day steers you to eat or sleep the moment this comes down (Louis)
			exhausted = true
		# ONE reason, in priority order, because only one of these actually ended the set:
		# empty hands beat a full drop sheet (you dropped it BECAUSE you were spent), and
		# both beat a bored room that was still, technically, watching.
		if stamina <= 0.0:
			add_popup(b.to_pos + Vector2(0, -28), "SPENT  -  THAT'S THE NIGHT", Color(1.0, 0.5, 0.35))
			start_collapse("spent")
		elif dropped >= drop_limit():
			add_popup(b.to_pos + Vector2(0, -28), "THAT'S THE NIGHT", Color(1.0, 0.5, 0.35))
			start_collapse("drops")
		elif applause <= 0.0:
			start_collapse("crowd")
	elif mode == MODE_TRAIN and not tut_active and stamina <= 0.0 and running:
		# spent in practice too: end the session so the day can steer you to recovery
		exhausted = true
		running = false


func start_collapse(reason: String) -> void:
	# the act falls apart: the hands give up and whatever is still held slips from them,
	# so the player watches it all come down. The round ends only once everything has
	# landed (see the collapse step in _physics_process). Marks set_collapsed so the act
	# resolves as a hard ending, which is what strips the score to the last goal reached.
	# `reason` is WHY, recorded here because here is the only place that actually knows -
	# it is carried, unedited, to the collapse banner and the results card (Louis).
	if collapsing:
		return
	collapsing = true
	set_collapsed = true
	fail_reason = reason
	for h in [LEFT, RIGHT]:
		for hb in stack(h):
			balls.erase(hb)
			spawn_falling(hpos[h], hb.kind, hb.color)
		stack(h).clear()


func fail_text() -> Array:
	# WHY the night ended, as [headline, the plain sentence and what to do about it].
	# Strictly the one reason that actually fired (fail_reason): a player whose hands
	# gave out is never also told the crowd was bored, because the crowd was not the
	# problem and being handed all three possibilities teaches nothing (Louis).
	match fail_reason:
		"crowd":
			return ["THE PUBLIC WASN'T HAPPY",
				"the room ran out of patience and emptied. Catches and big throws are what keep them in their seats."]
		"spent":
			return ["OUT OF STAMINA",
				"your hands had nothing left and stopped closing. Eat or sleep before the next booking."]
		"drops":
			return ["YOU DROPPED IT ALL",
				"%d drops, and this house allows %d." % [dropped, drop_limit()]]
		"bow":
			return ["YOU BOWED OUT UNDER THE TARGET",
				"you chose the bow before the number fell, so the night ends here. The crowd went home happy."]
		"stranded":
			return ["NOTHING LEFT TO JUGGLE",
				"one prop cannot make a pattern, and a catch only scores with something still in the air - so the act ended itself. Buy a spare set before the next booking."]
	return ["", ""]


func coach_text() -> String:
	# one honest, specific line for a night that did NOT collapse - the same generosity
	# fail_text gives a lost act, extended to a survived one. It names the single biggest
	# lever the REAL numbers show, never a nag and never a generic "well done": drops
	# reset the streak (and the streak is the score multiplier), so on a dropped night
	# that is always the truest thing to say; on a spotless one, the load is the next
	# rung. Silent on a collapse (fail_text already owns that) and during a lesson.
	if set_collapsed or tut_active:
		return ""
	var rec: float = rec_table()[run_venue] if run_venue >= 0 and run_venue < rec_table().size() else 0.0
	var ds := "" if dropped == 1 else "s"
	if dropped > 0:
		var gap := rec - score
		if not results_record and gap > 0.0 and gap * 4.0 < score:
			# genuinely close to the board - quantify exactly how close
			return "%d drop%s closed your run. Just %s more and the record here was yours." % [dropped, ds, score_text(gap)]
		# ...and the line is about the EXPONENTIAL now, not the streak: a drop banks the run
		# and starts the multiplier again at one, which is both more expensive to explain and
		# far more useful for a player to hear
		return "%d drop%s banked your run and started the multiplier over. The longer a run lives, the more every trick in it is worth." % [dropped, ds]
	# a spotless night: praise honestly, then point at the load, the real way up
	if num_balls < 5 or prop_weight() <= 1:
		return "Not one drop. Heavier props and higher counts pay more per catch - the record falls to a bigger load, not a safer one."
	return "Not one drop at this load - masterful control. From here the record falls to a longer set, not a safer one."


func update_sim() -> void:
	# THE CLOCK (Phase 2): the crowd's patience bleeds every tick while performing, at a
	# venue-scaled rate the Encore can bend. Reach zero and the room empties (the collapse
	# that was always built and never reached). Catches and big throws pay patience back,
	# so keeping the crowd is simply keeping the act alive.
	if mode == MODE_PERFORM and not tut_active and running and not collapsing:
		applause = maxf(0.0, applause - APPL_DECAY[clampi(run_venue, 0, APPL_DECAY.size() - 1)] * encore_decay_mult())
		if applause <= 0.0:
			start_collapse("crowd")   # the room emptied: nothing to do with drops or stamina
	var lost: Array[Ball] = []
	for b in balls:
		if b.state == STATE_FLIGHT and tick > b.land_tick + MISS_GRACE:
			lost.append(b)
		elif b.state == STATE_FLIGHT and tick % 2 == 0:
			# the flight trail: sample the path so a comet tail follows the
			# prop, longer for higher (riskier) throws, so risk is legible at a glance.
			#
			# Samples must be SPACED, not merely taken (2026-07-27). draw_trail offsets
			# each one sideways by up to ~3px per side to build one tapered ribbon, and
			# an offset that outruns the gap between two samples folds the ribbon back
			# through itself - a self-intersecting polygon, which is the "Invalid
			# polygon data, triangulation failed" spam the renderer has been printing.
			# Two ways to crowd samples: a prop at the top of its arc (barely moving),
			# and a prop sitting PAST its arrival in the MISS_GRACE beat before it is
			# declared dropped, where flight_pos clamps and repeats exactly. TRAIL_STEP
			# (squared) answers both - a slow prop simply keeps a shorter tail, which is
			# what a comet tail does anyway.
			var np := flight_pos(b)
			if b.trail.is_empty() or b.trail[b.trail.size() - 1].distance_squared_to(np) > TRAIL_STEP_SQ:
				b.trail.append(np)
			var maxlen := 5 + int(clampf(b.height, 0.0, 1.4) * 8.0)
			while b.trail.size() > maxlen:
				b.trail.remove_at(0)
	# MID-AIR CONTACT IS A DEV AUDIT NOW, not a mechanic (2026-07-29). Two props that
	# visibly clacked used to become nearly uncatchable, behind either the Close Quarters
	# Encore or the Hard Collisions setting; the Encore was replaced and Louis removed the
	# setting ("it's no longer implemented"), so nothing switched it on any more. The LOOP
	# survives because --collcheck rides it to audit the ideal pattern's clearance, which is
	# a genuinely useful tool and the only thing left that cares where two props pass.
	if _collcheck:
		var fly: Array[Ball] = []
		var fpos: Array[Vector2] = []
		for b in balls:
			if b.state == STATE_FLIGHT:
				fly.append(b)
				fpos.append(flight_pos(b))
		for i in fly.size():
			for j in range(i + 1, fly.size()):
				var d := fpos[i].distance_to(fpos[j])
				var rr := BALL_RADIUS_PX * (prop_hit_scale(fly[i].kind) + prop_hit_scale(fly[j].kind))
				if _collcheck and d - rr < _coll_min:
					_coll_min = d - rr
					_coll_at = _coll_pair(fpos[i], fpos[j], fly[i], fly[j])
				if _collcheck:
					# the same pair judged at DRAWN size - what the player actually sees
					# passing through what (see _coll_min_drawn)
					var dr := BALL_RADIUS_PX * (prop_scale(fly[i].kind) + prop_scale(fly[j].kind))
					if d - dr < _coll_min_drawn:
						_coll_min_drawn = d - dr
						_coll_at_drawn = _coll_pair(fpos[i], fpos[j], fly[i], fly[j])
	for b in lost:
		drop_ball(b, "DROP")
	# THE AIR BEING EMPTY ENDS THE ACT, however it emptied (2026-07-27, Louis: "if there
	# are no objects in the air during a performance, that the performance stops if any
	# milestone has been reached"). on_catch already handles the deliberate version - you
	# catch the last prop and stand there holding them all, which is the bow - but that
	# path only runs on a CATCH. Empty the air any other way, and nothing was watching:
	# DROP the last airborne prop with a goal banked and the act just sat there, running,
	# with every prop in a hand or on the floor, until the crowd drained into a collapse.
	# Checked here rather than in a draw pass because it is a rule about the act, and
	# after the drops above so a prop lost this very tick is already counted.
	# The grace exists so a single tick of bare air - the frame between a catch and the
	# throw that follows it - can never read as a bow.
	# ONE PROP IN A HAND IS THE END OF THE ACT, GOAL OR NO GOAL (2026-07-28, Louis: "the
	# game should automatically stop, finish, when the player has only one object and he is
	# holding it. since he can't score"). The reasoning is exactly his: pillar two says at
	# least one prop must be in the air for a catch to score (`juggling_catch`), so a
	# performer holding his last object cannot earn another point however long he stands
	# there. The `goals_hit >= 1` gate above is right for the ordinary bow - you do not get
	# to cash in before you have banked something - but it is wrong for this case, because
	# there is nothing left to bank it WITH. Without this the act sat there, throwing and
	# catching one prop for no score, until the crowd drained into a collapse: several
	# minutes of a game that had already ended.
	#
	# Reachable at low counts specifically: three props and two drops leaves one, and two is
	# under DROP_LIMIT, so nothing else was watching. It resolves as a graceful FINISH rather
	# than a collapse - the player keeps what they scored, which is the honest outcome for
	# someone whose set was ended by the props running out rather than by the room.
	var stranded := balls.size() <= 1
	if mode == MODE_PERFORM and booking_active and running and not collapsing \
			and not results_open and not tut_active and (goals_hit >= 1 or stranded) \
			and balls_airborne() == 0:
		_empty_air += 1
		if _empty_air >= EMPTY_AIR_GRACE:
			_empty_air = 0
			if stranded and goals_hit < 1:
				# ...and it says WHY, because an act that ends on its own with nothing
				# banked has to explain itself or it reads as the game giving up
				fail_reason = "stranded"
			finish_performance()
			return
	else:
		_empty_air = 0
	if _boo:
		# dev (--boo): pin the room in the red. The tomato path was unreachable for a
		# screenshot any other way - the auto-player performs too well to lose a crowd,
		# and a human bad enough to earn tomatoes is usually collapsing, which suppresses
		# them. Same reasoning as --wallcard and --legend: a state with no capture path
		# is a state nobody has actually looked at.
		applause = minf(applause, TOMATO_RED * 0.6)
	peak_applause = maxf(peak_applause, applause)
	if balls.is_empty():
		running = false


func update_hands() -> void:
	for h in [LEFT, RIGHT]:
		var cur: Vector2 = hpos[h]
		var target := hand_target(h)
		if exp_on("hand_spring"):
			var accel := (target - cur) * HAND_SPRING_K - hvel[h] * HAND_SPRING_D
			hvel[h] += accel
			hpos[h] = cur + hvel[h]
		else:
			hpos[h] = cur.lerp(target, HAND_SMOOTH)
			hvel[h] = Vector2.ZERO   # so a mid-run F9 toggle back to spring never inherits a stale kick
		var want := 1.0 if not stack(h).is_empty() else 0.0
		hclose[h] = lerpf(hclose[h], want, 0.3)
	if _handlog and tick >= 24:
		# one line per tick: each hand's live x, its target x, the slot it is aiming at,
		# and whether it holds. A hand that alternates target slots every few ticks (its
		# aim x jumping) is the tremor; a steady aim far from the ball's lane is the
		# other hypothesis. dc is the centre-relative offset, so 24/58/104 read directly.
		var c := stage_center().x
		print("t%4d  L x=%6.1f aim=%6.1f dc=%5.1f hold=%d park=%d   R x=%6.1f aim=%6.1f dc=%5.1f hold=%d park=%d   full=%d" % [
			tick, hpos[LEFT].x, hand_target(LEFT).x, hand_target(LEFT).x - c,
			int(not stack(LEFT).is_empty()), int(hand_parked[LEFT]),
			hpos[RIGHT].x, hand_target(RIGHT).x, hand_target(RIGHT).x - c,
			int(not stack(RIGHT).is_empty()), int(hand_parked[RIGHT]), int(catch_full_on())])
		# THE RESIDUAL between the hand the simulation has and the hand that is PAINTED.
		# This is the number "the objects must align with the hands" reduces to, and it is the
		# only honest way to check it: a still frame cannot tell a hand that is simply LATE to
		# a catch (correct, and what the smoothing is for) from an arm bank with no entry
		# anywhere near that reach (a hole in the art). Both are screen px, and the bank is
		# quantised in ART px, so 2 here is one step of the table.
		if fig_anim_live():
			var dl: Vector2 = fig_hand_pos(LEFT) - hpos[LEFT]
			var dr: Vector2 = fig_hand_pos(RIGHT) - hpos[RIGHT]
			print("      palm-vs-hand  L dx=%5.1f dy=%5.1f   R dx=%5.1f dy=%5.1f   raw %5.1f %5.1f" % [
				dl.x, dl.y, dr.x, dr.y, _palm_raw[LEFT], _palm_raw[RIGHT]])


func add_popup(pos: Vector2, text: String, col: Color) -> void:
	# a newcomer that would land on a still-living popup (same neighbourhood: a
	# trick shout, its PERFECT, and a Spin's x2 all fire from one catch) slides up
	# above it, so a busy moment stacks into a readable little column instead of
	# three lines of text printed through each other
	# BORN ON atick(), NOT tick (2026-07-31, Louis: "the PERFECT should disappear after a
	# while" - it wasn't, during a tutorial freeze). `tick` is exactly what a guided beat
	# HOLDS while it waits for the player's next press, so a popup timed off it froze
	# mid-fade for as long as the pause lasted, however long that was. `atick()` is
	# `tick + cine_tick`, and `cine_tick` is the one clock this codebase already keeps
	# running through every freeze for precisely this reason (the prompt pulse, the
	# scenery) - see its own comment ("a stopped SIM must not read as a hung game").
	var p := pos + Vector2(0, -40)
	var moved := true
	var guard := 0
	while moved and guard < 8:
		moved = false
		guard += 1
		for q in popups:
			var qpos: Vector2 = q["pos"] + Vector2(0, -(atick() - float(q["born"])) * 0.6)
			if absf(qpos.x - p.x) < 120.0 and absf(qpos.y - p.y) < 26.0:
				p.y = qpos.y - 26.0
				moved = true
	popups.append({"pos": p, "text": text, "col": col, "born": atick()})


func age_popups() -> void:
	var keep: Array[Dictionary] = []
	for p in popups:
		if atick() - float(p["born"]) <= 46:
			keep.append(p)
	popups = keep


func flight_pos(b: Ball) -> Vector2:
	# Every prop is a projectile: constant horizontal velocity, gravity on the
	# vertical, so the path is ALWAYS a clean parabola (Louis) - nothing ever
	# swerves sideways in the air. Which parabola differs per throw (its launch
	# and landing x, and its height b.arc); a column shares one x, so it rides
	# straight up and down on the very same curve. Flight time is set by the
	# throw's height alone (b.land_tick, from the hold), never by how wide it is,
	# so a wide throw of the same height just travels faster across.
	var span := maxi(1, b.land_tick - b.launch_tick)
	var p := clampf(float(tick - b.launch_tick) / float(span), 0.0, 1.0)
	var pos := b.from_pos.lerp(b.to_pos, p)
	pos.y -= 4.0 * b.arc * p * (1.0 - p)   # the parabola: peak height = b.arc at mid-flight
	return pos


func flight_vel(b: Ball) -> Vector2:
	# THE EXACT DERIVATIVE of flight_pos, in pixels per tick.
	#
	# This exists because of a real bug (2026-07-27, Louis: the round props look
	# "jittery" in the air). The squash/stretch in draw_prop used to measure velocity as
	# `pos - b.trail[last]` - but comet-trail samples are deliberately SPACED, never
	# per-frame (TRAIL_STEP_SQ, 6px apart), so that difference GREW from ~0 to 6+px and
	# SNAPPED BACK every time a new sample landed. Two artifacts fell out of it: the
	# stretch amount sawtoothed at the sampling rate, and - worse - right after each snap
	# the angle of a near-zero vector is numerical noise, so `vel.angle()` spun the prop
	# through arbitrary angles. On a circle that was invisible until the relit art put a
	# seam and a specular on it; on an egg it was always a visible whip.
	#
	# flight_pos is a closed-form parabola, so none of that guesswork is needed. With
	#   pos = from + (to - from) * p,  pos.y -= 4 * arc * p * (1 - p),  p = (tick - t0)/span
	# the derivative is (to - from) - (0, 4 * arc * (1 - 2p)), all over span. Smooth
	# everywhere, exactly zero vertical speed at the apex, and no sampling artifact.
	var span := maxi(1, b.land_tick - b.launch_tick)
	var p := clampf(float(tick - b.launch_tick) / float(span), 0.0, 1.0)
	return (b.to_pos - b.from_pos - Vector2(0.0, 4.0 * b.arc * (1.0 - 2.0 * p))) / float(span)


# -----------------------------------------------------------------------------
# Rendering: warm-theatrical, code-only. A stylized performer with procedurally
# posed arms and open/closing hands, so the no-crossing choreography is visible.
# Draw order keeps balls above the figure and the HUD clear of the stage.
# -----------------------------------------------------------------------------

#endregion

#region PIXEL-ART RENDER SEAM
# ---------------------------------------------------------------------------------------
# THE SEAM (PIXELTOSSA branch). Everything the player SEES is drawn by code today. This
# region is the single place where a hand-authored sprite can take over from a procedural
# drawing, one element at a time, without a gameplay function ever knowing it happened.
#
# THE CONTRACT, and it is the whole point of the branch:
#
#   func draw_whatever(...):
#       if art_blit("group/key", pos, sc, ang, tint): return   # <- sprite, if one exists
#       <the existing procedural code, untouched>              # <- otherwise, as before
#
# `art_blit` returns FALSE whenever no texture is registered for that key, so with an empty
# bank - which is the state this branch ships in - every one of these lines is a dictionary
# miss and the game draws exactly what `main` draws, pixel for pixel. Registering art is
# editing DATA (drop a PNG in Assets/, add a line to Resources/art_manifest.json), never
# editing code. That is objective 4 of the remaster brief, discharged.
#
# WHY draw_colored_polygon AND NOT draw_texture_rect. A textured polygon composes with
# whatever transform is already active (draw_prop_body runs its squash-and-stretch through
# `draw_set_transform` before calling into the prop art), and it takes a rotation for free.
# draw_texture_rect would need its own draw_set_transform to rotate, which would CLOBBER an
# outer one and silently drop the squash. It is also one engine call per sprite, against the
# dozens each procedural prop currently spends - see docs/coding_guidelines.md on draw cost
# being ~5us PER CALL, not per vertex. Sprites should make this file faster, not slower.
#
# ART_PIXEL AND THE COORDINATE SPACE. The stage's coordinate space stays 1280x720 and is not
# negotiable: `inner_pos`/`outer_pos`, every hitbox, `--collcheck`'s clearances and the whole
# throw model are expressed in it, so changing it would change gameplay. The authoring
# density must therefore divide 1280x720 EXACTLY, or source pixels land on fractional screen
# blocks and the art crawls. That leaves 640x360 (2x) and 320x180 (4x) as the only sane
# candidates at 16:9.
#
# IT IS 640x360, DECIDED BY MEASUREMENT (Louis, 2026-08-05). The earlier prep pass assumed
# 320x180 on the grounds that it is the more authentic density, and for the ART it is: a
# `--pixel` capture of the stage at 4x down shows the juggler at ~86px reading beautifully.
# The same capture shows why it cannot be the answer here. THE FIGURE SURVIVES THE
# DOWNSAMPLE AND THE TEXT DOES NOT. A 13px HUD label becomes 3px tall and is not read so
# much as guessed at, and this game is unusually text-heavy - shop cards carry a stat table,
# body copy and a hint row; the day hub, sheet, skills and results screens are almost
# entirely words. Fixing that at 320x180 is not an art job, it is a redesign of ~15 screens
# into fewer, larger panels with far less to say, and the brief for this fork is to stay as
# close to TOSSA's design and UI as possible.
#
# At 640x360 the arithmetic goes the other way and nothing has to be given up: the juggler
# is ~172px tall (more detail than 320x180 could hold, not less), a ball is 12px, and a
# 10-12px bitmap font keeps every existing layout. Two screen pixels per art pixel is still
# unmistakably pixel art - it is the density Dead Cells and Blasphemous ship at.
#
# The one real cost is upstream, not on screen: PixelLab caps a generated image at 400px per
# side, so a full 640x360 backdrop is two tiles stitched rather than one generation. That is
# a pipeline problem with a pipeline answer, and it is the right thing to pay for legible UI.
#
# Everything below derives from ART_PIXEL, so this stayed a one-constant change. What it is
# NOT able to do is rescale a PNG: art authored for the old density draws at half size after
# the switch, which is why the four props registered by the prep pass were unregistered in
# the same commit. Run `--pixel` to see the endpoint today.
# ---------------------------------------------------------------------------------------

const ART_PIXEL := 2.0                 # screen units per authored art pixel (1280/640)
const ART_W := 640                     # the authoring canvas, and the eventual viewport
const ART_H := 360
const ART_MANIFEST := "res://Resources/art_manifest.json"
var torch_flame: Dictionary = {}  # the torch sprite's flame geometry, from a manifest's
                                  # _TORCH block. EMPTY means the sprite carries its own fire
                                  # (or there is no sprite) and nothing is drawn over it.
var fig_arms: Dictionary = {}     # the performer's ARM BANK, from a manifest's _ARMS block:
                                  # {"left": [...], "right": [...]} plus the atlas geometry.
                                  # Each entry is one arm at one reach, with the painted
                                  # palm's position measured off it - see fig_arm_pick.
                                  # EMPTY means the figure's arms are solved live instead.
var fig_design: Dictionary = {}   # the active character design's landmark geometry, from a
                                  # variant manifest's _FIGURE block. EMPTY means the traced
                                  # juggler, whose proportions live in fig_ys as constants.
var fig_spin: Dictionary = {}     # the TURNAROUND, from a manifest's _SPIN block: an ordered
                                  # list of directions, one painted frame per eighth of a
                                  # turn. EMPTY means no turnaround shipped, and a live Spin
                                  # falls back to the old cos(angle) width squash.
var art_manifest_path := ART_MANIFEST   # --artmanifest <path> points this elsewhere, which
										# is how the placeholder set is tried on without
										# editing (or risking) the real manifest
# not a `const`: GDScript will not accept a PackedVector2Array as a constant expression.
# Built once at load and never mutated, which is the only property the call sites need.
var art_uv := PackedVector2Array([Vector2(0, 0), Vector2(1, 0), Vector2(1, 1), Vector2(0, 1)])

var art_bank: Dictionary = {}      # key -> {"tex": Texture2D, "pivot": Vector2, "scale": float}
var art_on := true                 # --procart clears this: every key misses, procedural wins
var art_asked: Dictionary = {}     # every key any draw call has ever requested
var art_hits: Dictionary = {}      # ...and the subset that resolved to a real texture
var _art_pixel := false          # --pixel: downsample the --shot capture to art density
var _art_report := false           # --artreport: dump both lists on quit
var _propref := ""                 # --propref <name>: draw only that prop (see _draw_prop_ref)
var _charref := false              # --charref: draw only the juggler, on a flat field
var _art_boxes_on := false         # --artboxes: record where each sized element is drawn
var _art_boxes: Dictionary = {}    # key -> Rect2, the last box the game asked for
var _art_suppress := ""            # --charsuppress [key]: claim that char key (or "*") and draw nothing
var _charid := false               # --charid: paint costume regions as flat ID colours
var _bgref := false                # --bgref: draw only sky + dressing, the layers bg/* replaces
var _menuref := false              # --menuref: draw only the title proscenium, dustless
var _extref := -1                  # --extref <vi>: draw only that venue's exterior, dustless
const PARK_START := 600            # --parkcheck: ticks of ordinary juggling before collecting
var _parkcheck := false            # --parkcheck: autoplay the stop gesture and audit the result
var _park_seen := [false, false]   # ...which hands actually parked while it did
var _park_reach := 0.0             # ...and how far one reached for an incoming prop
var _palm_raw := [0.0, 0.0]        # --handlog: the UNGUARDED palm-to-hand distance
var _chargear := false             # --chargear: wear every garment (reference render only)
var _charback := false             # --charback: draw the figure facing away (the Spin view)
var _charopen := false             # --charopen: hold the hand open (reference render only)
var _charhide := ""                # --charhide <id>: one garment to leave off under --chargear
var _markref := false              # --markref [size]: the prop wordmark alone, for baking
var _markref_size := 0.0           # ...at this letter height (default MENU_MARK)


func art_boot() -> void:
	# Read the manifest once at startup. A missing/!empty manifest is the NORMAL state on this
	# branch and must stay completely silent - it means "no art authored yet", not an error.
	art_bank.clear()          # re-entrant: an F9 variant change reboots the bank in place
	fig_design.clear()        # ...and so does the active design's landmark geometry
	fig_arms.clear()          # ...and its arm bank
	fig_spin.clear()          # ...and its turnaround
	torch_flame.clear()       # ...and the torch's live-fire geometry
	art_read_manifest(art_manifest_path, true)
	# ...then lay each chosen VARIANT over the top. Option 0 is the shipped default and has
	# no file, so a release build reads exactly one manifest and this loop does nothing.
	# Overlay order is VARIANT_DEFS order; two sets are not expected to claim the same key,
	# and if they ever do the later set wins, which is at least a rule rather than a race.
	for d: Dictionary in VARIANT_DEFS:
		var vid := String(d["id"])
		var opt := variant(vid)
		if int(art_variants.get(vid, 0)) == 0:
			continue
		var vpath := "res://Resources/art_variants/%s.%s.json" % [vid, opt]
		if not FileAccess.file_exists(vpath):
			# A variant with no art file is not an error either: it is how a look is
			# reserved on the panel before its generator has been run. It simply draws
			# the base art, which is the honest thing for "this look does not exist yet".
			continue
		art_read_manifest(vpath, false)


func art_read_manifest(path: String, quiet_if_missing: bool) -> void:
	# Shared by the base manifest and every variant overlay. Entries land in art_bank by
	# key, so an overlay REPLACES a base entry for the same key and leaves the rest alone -
	# that is what lets a character variant ship only the parts it actually repaints.
	if not FileAccess.file_exists(path):
		if not quiet_if_missing:
			push_warning("art: variant manifest %s missing" % path)
		return
	var raw := FileAccess.get_file_as_string(path)
	var parsed: Variant = JSON.parse_string(raw)
	if typeof(parsed) != TYPE_DICTIONARY:
		push_warning("art: %s is not a JSON object - running fully procedural" % path)
		return
	var pd := parsed as Dictionary
	if pd.has("_FIGURE") and typeof(pd["_FIGURE"]) == TYPE_DICTIONARY:
		# A GENERATED CHARACTER DESIGN carries geometry, not just pictures. The traced
		# juggler's proportions are constants in fig_ys; a design painted from scratch has
		# its own, and the one thing the game must get right is where its ARMS leave the
		# body - because those are drawn live, to hand positions that never move. See
		# fig_design_on / draw_figure_design.
		fig_design = (pd["_FIGURE"] as Dictionary).duplicate(true)
	if pd.has("_TORCH") and typeof(pd["_TORCH"]) == TYPE_DICTIONARY:
		# WHERE THE TORCH SPRITE'S FIRE USED TO BE, in art pixels of its own canvas. The
		# sprite is the handle alone and the flame is drawn live over it (see
		# art_blit_prop), so the game needs the painting's own idea of where the fire sits
		# and how big it is - the card's proportions, not the vector drawing's.
		torch_flame = (pd["_TORCH"] as Dictionary).duplicate(true)
	if pd.has("_SPIN") and typeof(pd["_SPIN"]) == TYPE_DICTIONARY:
		# THE TURNAROUND: eight painted frames, one per eighth of a live Spin. Read here
		# rather than assumed from the key names, because the ORDER is the animation - the
		# list says which way round the body goes, and fig_spin_key does nothing but round
		# a turn fraction onto it.
		fig_spin = (pd["_SPIN"] as Dictionary).duplicate(true)
	if pd.has("_ARMS") and typeof(pd["_ARMS"]) == TYPE_DICTIONARY:
		# THE ARM BANK: two lists of arms, "left" and "right", each entry an atlas slot plus
		# the reach it was painted at and the position of its palm. Sorted by reach, which is
		# the whole interface - fig_arm_pick does a nearest lookup on that one number and
		# needs to know nothing else about how the animation was made.
		fig_arms = (pd["_ARMS"] as Dictionary).duplicate(true)
	for key: String in pd.keys():
		if key.begins_with("_"):
			continue                          # "_comment" and friends are documentation
		var e: Variant = pd[key]
		if typeof(e) != TYPE_DICTIONARY:
			continue
		var fpath := str((e as Dictionary).get("path", ""))
		if fpath == "" or not ResourceLoader.exists(fpath):
			# a manifest line whose file is not there yet is a PLAN, not a failure - it is
			# exactly how you reserve a key before drawing the art. Loud enough to find,
			# quiet enough to leave in place for weeks.
			push_warning("art: '%s' -> %s not found, falling back to procedural" % [key, fpath])
			continue
		var tex: Variant = load(fpath)
		if not (tex is Texture2D):
			continue
		var piv: Variant = (e as Dictionary).get("pivot", [0.5, 0.5])
		var pv := Vector2(0.5, 0.5)
		if typeof(piv) == TYPE_ARRAY and (piv as Array).size() == 2:
			pv = Vector2(float((piv as Array)[0]), float((piv as Array)[1]))
		art_bank[key] = {
			"tex": tex,
			"pivot": pv,
			"scale": float((e as Dictionary).get("scale", 1.0)),
		}
	if art_bank.size() > 0:
		print("art: %d sprite(s) registered after %s" % [art_bank.size(), path])


func art_rebank() -> void:
	# THE SAMPLED FLOOR COLOURS GO WITH IT. bg_floor_colour caches one colour per backdrop
	# because it is a texture read on a per-frame path, and a variant swap or a --procart
	# toggle can put a different painting (or none) behind that same key - so a stale entry
	# would paint the old room's ground under the new room.
	# Re-read every manifest and redraw. This is what an F9 variant change calls, and the
	# reason a look can be judged by flipping between them in front of the same frame
	# rather than by launching twice and remembering. Cheap - a few dozen small textures,
	# all already in Godot's resource cache after the first read.
	_bg_floor.clear()
	art_boot()
	queue_redraw()


func art_snap(v: Vector2) -> Vector2:
	# to the ART_PIXEL grid, so a blitted sprite's source pixels stay square and stop
	# crawling as the thing under them moves at sub-pixel speed. Deliberately NOT the
	# project-wide `snap_2d_vertices_to_pixel`: that one would also snap every procedural
	# polygon in the file and destroy the explicit alpha feathers this project's triangle
	# edges depend on (see docs/coding_guidelines.md). Snap the sprites, not the paint.
	return (v / ART_PIXEL).round() * ART_PIXEL


func art_native_size(key: String) -> Vector2:
	# A SPRITE'S OWN SIZE IN SCREEN UNITS - its art pixels at exactly ART_PIXEL each.
	#
	# For the callers that must draw a picture at 1:1 and place it by its CORNER, which
	# art_blit_fit (centres in a box) and art_blit_rect (stretches to a box) both refuse to
	# do. The wordmark is the case it was written for: its box was four measured constants,
	# the bake was re-run when the ring art changed, and the two silently disagreed by 12
	# screen px - so the logo, the first thing a player sees, was being stretched 1.5% and
	# every one of its pixels resampled. A box read off the texture cannot drift from it.
	#
	# Vector2.ZERO if the key is procedural, which is the same "sprite or not" contract the
	# rest of the seam uses.
	if not art_on or not art_bank.has(key):
		return Vector2.ZERO
	return Vector2((art_bank[key] as Dictionary)["tex"].get_size()) * ART_PIXEL


func art_blit(key: String, pos: Vector2, sc: float = 1.0, ang: float = 0.0,
		tint: Color = Color.WHITE) -> bool:
	# The one substitution point. TRUE = a sprite was drawn and the caller must return
	# immediately; FALSE = draw yourself, exactly as before.
	art_asked[key] = true
	if not art_on or not art_bank.has(key):
		return false
	var e: Dictionary = art_bank[key]
	var tex: Texture2D = e["tex"]
	var size := Vector2(tex.get_size()) * ART_PIXEL * float(e["scale"]) * sc
	if size.x <= 0.0 or size.y <= 0.0:
		return false
	art_hits[key] = true
	var half := size * 0.5
	# the pivot as an offset from the sprite's CENTRE, since the quad is built around its
	# centre - a (0.5, 0.5) pivot is therefore the zero case and costs nothing
	var piv: Vector2 = e["pivot"]
	var off := Vector2((0.5 - piv.x) * size.x, (0.5 - piv.y) * size.y)
	var c := pos + (off.rotated(ang) if not is_zero_approx(ang) else off)
	if is_zero_approx(ang):
		c = art_snap(c - half) + half     # snap the top-left, keep the quad centred on c
	_art_quad(tex, c, half, ang, tint)
	return true


func art_blit_size(key: String, center: Vector2, size: Vector2, ang: float = 0.0,
		tint: Color = Color.WHITE) -> bool:
	# For elements whose on-screen size is decided by the GAME rather than by the art: the
	# head is drawn at whatever radius its caller has, a boot at a fraction of figure height,
	# a keycap at the width of its label. Those sizes are layout and must not change when a
	# sprite arrives, so the texture is fitted to them instead of setting them. Same
	# true/false contract as art_blit.
	art_asked[key] = true
	if _art_suppress != "" and (_art_suppress == "*" or _art_suppress == key) and key.begins_with("char/"):
		# --charsuppress [key]: claim the element and draw NOTHING. This exists so a
		# reference pass can isolate a part exactly, instead of cropping its bounding box
		# and hoping. A head is drawn OVER the collar, so its box contains collar pixels in
		# every corner the head does not cover, and those bake into the sprite as a white
		# notch under the chin. Render the figure once with the part and once without,
		# difference the two, and what is left is precisely what that part drew.
		#
		# IT TAKES A KEY, AND THAT IS NOT OPTIONAL POLISH. Suppressing every char/* at once
		# works only while no two elements overlap. Turn the wardrobe on and they do: the
		# top hat and the glasses both sit inside the head's box, so a single all-at-once
		# difference hands the head sprite its own hat and spectacles, baked in and
		# impossible to tint or remove. One key at a time costs one render per part and is
		# the only version that stays correct as parts are added.
		if _art_boxes_on:
			_art_boxes[key] = Rect2(center - size.abs() * 0.5, size.abs())
		return true
	if _art_boxes_on:
		# THE SEAM ALREADY KNOWS THE GEOMETRY, so nothing else has to guess it. Recording
		# the box here is what makes deriving character art possible without a second,
		# drifting copy of the figure's proportions: every char/* element states the exact
		# centre and size the game will draw it at, so a reference render can be cropped to
		# that rectangle and reduced to (size / ART_PIXEL) with no measuring by eye.
		# Recorded BEFORE the art_on/bank check, because the whole point is to capture the
		# geometry while the element is still PROCEDURAL and has no sprite yet.
		_art_boxes[key] = Rect2(center - size.abs() * 0.5, size.abs())
	if not art_on or not art_bank.has(key):
		return false
	# a NEGATIVE width is meaningful and must survive: it mirrors the quad, which is how one
	# boot/hand/arm asset serves both sides exactly as the procedural version mirrors through
	# a transform. Only a zero-area box is rejected.
	if is_zero_approx(size.x) or is_zero_approx(size.y):
		return false
	art_hits[key] = true
	var e: Dictionary = art_bank[key]
	var sz := size * float(e["scale"])
	var piv: Vector2 = e["pivot"]
	var off := Vector2((0.5 - piv.x) * sz.x, (0.5 - piv.y) * sz.y)
	var c := center + (off.rotated(ang) if not is_zero_approx(ang) else off)
	if is_zero_approx(ang):
		c = art_snap(c - sz * 0.5) + sz * 0.5
	_art_quad(e["tex"], c, sz * 0.5, ang, tint)
	return true


func art_blit_regions(prefix: String, box: Rect2, regions: Array) -> bool:
	# PER-REGION BODY ART, and the reason the body could not simply become one sprite.
	#
	# costume_palette() repaints the whole outfit per venue - olive at the Backyard, red at
	# the Circus, purple at the World Arena - and it does it across five separate colours
	# (suit, suit_dk, vest, collar, accent) plus a trouser rung. One sprite freezes the
	# outfit; one tint cannot carry five colours. So each colour region is its own
	# GREYSCALE mask, blitted over the same box with that region's live costume colour as
	# the tint. The wardrobe keeps working exactly as it did, and the shapes become pixels.
	#
	# `regions` is an ordered Array of [suffix, tint] pairs, and the ORDER IS THE PAINT
	# ORDER - suit, then collar, then vest, then buttons, the same sequence the procedural
	# torso lays down. Getting it wrong buries the waistcoat under the jacket.
	#
	# ALL-OR-NOTHING ON PURPOSE. If any one region has no art the whole call returns false
	# and the caller draws the entire body procedurally. A half-sprited torso - a pixel
	# jacket with a vector waistcoat over it - would be worse than either, and worse in a
	# way that looks like a rendering bug rather than a missing file.
	var keys: Array[String] = []
	for r: Array in regions:
		keys.append(prefix + "_" + str(r[0]))
	for k: String in keys:
		art_asked[k] = true
	if _art_boxes_on:
		for k: String in keys:
			_art_boxes[k] = box
	if not art_on:
		return false
	for k: String in keys:
		if not art_bank.has(k):
			return false
	var c := box.position + box.size * 0.5
	for i in regions.size():
		art_blit_size(keys[i], c, box.size, 0.0, regions[i][1])
	return true


func _art_quad(tex: Texture2D, c: Vector2, half: Vector2, ang: float, tint: Color) -> void:
	# one textured quad, built by hand so it COMPOSES with any draw_set_transform already in
	# effect (draw_prop_body's squash-and-stretch is exactly that case) and so a rotation
	# costs nothing extra. Winding is consistent and the quad is convex, so it can never hit
	# the silent-nothing-drawn failure draw_colored_polygon has on self-intersecting shapes.
	var pts := PackedVector2Array()
	for q: Vector2 in [Vector2(-1, -1), Vector2(1, -1), Vector2(1, 1), Vector2(-1, 1)]:
		var d := Vector2(q.x * half.x, q.y * half.y)
		pts.append(c + (d.rotated(ang) if not is_zero_approx(ang) else d))
	draw_colored_polygon(pts, tint, art_uv, tex)


func art_blit_fit(key: String, box: Rect2, tint: Color = Color.WHITE) -> bool:
	# A PICTURE CENTRED IN A BOX AT A WHOLE-PIXEL SCALE, never stretched to fill it.
	#
	# art_blit_rect stretches, which is right for a backdrop that must cover the frame and
	# wrong for an illustration: the SAME card art is drawn in the Skills screen's 208x256
	# window and again on the unlock card, which is bigger, so one of the two would always be
	# a fractional resample - the one thing pixel art cannot survive. This takes the largest
	# whole multiple of ART_PIXEL that fits and centres it, so the picture is crisp at both
	# sizes and the bigger card simply carries more margin.
	art_asked[key] = true
	if not art_on or not art_bank.has(key):
		return false
	var tex: Texture2D = (art_bank[key] as Dictionary)["tex"]
	var t := Vector2(tex.get_size())
	if t.x <= 0.0 or t.y <= 0.0:
		return false
	# WHOLE SCREEN PIXELS PER ART PIXEL, so any k >= 1 is exact. ART_PIXEL (2) is "full size"
	# and 1 is half - both lossless, anything between is not, so the scale is floored rather
	# than fitted. k of 0 means the box is smaller than the picture's own pixels.
	var k := floorf(minf(box.size.x / t.x, box.size.y / t.y))
	if k < 1.0:
		return false
	art_hits[key] = true
	var sz := t * k
	var p := art_snap(box.position + (box.size - sz) * 0.5)
	draw_colored_polygon(PackedVector2Array([
		p, p + Vector2(sz.x, 0.0), p + sz, p + Vector2(0.0, sz.y)]), tint, art_uv, tex)
	return true


func art_blit_rect(key: String, box: Rect2, tint: Color = Color.WHITE) -> bool:
	# For elements sized by their BOX rather than by the art: backdrops, panels, card frames.
	# The texture is stretched to the box, so a 9-slice-ish asset should be authored at the
	# proportions it will be used at. Same true/false contract as art_blit.
	art_asked[key] = true
	if not art_on or not art_bank.has(key):
		return false
	if box.size.x <= 0.0 or box.size.y <= 0.0:
		return false
	art_hits[key] = true
	var tex: Texture2D = (art_bank[key] as Dictionary)["tex"]
	var p := art_snap(box.position)
	var sz := art_snap(box.position + box.size) - p
	draw_colored_polygon(PackedVector2Array([
		p, p + Vector2(sz.x, 0.0), p + sz, p + Vector2(0.0, sz.y)]), tint, art_uv, tex)
	return true


func art_blit_prop(kind: int, pos: Vector2, sc: float, ang: float, tint: Color) -> bool:
	# THE PROP SEAM, and it exists as its own function because of the single rule that
	# separates crisp pixel art from mush: A SPRITE MUST NEVER BE DRAWN AT A FRACTIONAL
	# SCALE. Every source pixel has to land on a whole number of screen pixels, the same
	# whole number for every sprite on screen, or the art crawls and shimmers.
	#
	# `prop_scale` is 1.0/1.1/1.5/1.6/1.7/1.75/1.9 - not one of them an integer. Feeding it
	# to art_blit as a size multiplier would draw a club's pixels at 6.4 screen px each,
	# beside a ball's at 4, which is exactly the failure above. So prop art carries its own
	# physical size instead: each sprite is authored at (local extent x prop_scale) /
	# ART_PIXEL pixels, and is always blitted at ART_PIXEL screen px per source pixel.
	#
	# `sc` is then only ever a ZOOM, and it is rounded to an integer. On the stage the
	# caller passes prop_scale itself, so zoom is 1 and a source pixel is 4 screen px. In
	# the shop draw_prop_icon passes PROP_ICON_MAG (3.0 for balls), so zoom is 3 and the
	# icon is a clean 3x magnification - which is how pixel art shows an item close up.
	var base := prop_scale(kind)
	var zoom := maxi(1, int(roundf(sc / maxf(base, 0.001))))
	var key := art_key_prop(kind)
	if not art_blit(key, pos, float(zoom), ang, tint):
		return false
	# THE FIRE IS NOT PART OF THE OBJECT. The torch sprite is a handle; its flame is drawn
	# live, on top, every frame - which is the only way it can move, and moving is what a
	# fire does. See strip_torch_flame for why the bake stops at the wick.
	if key == "prop/torch":
		draw_sprite_torch_flame("prop/torch", "stage", pos, ang, sc, zoom)
	return true


func draw_sprite_torch_flame(key: String, which: String, pos: Vector2, ang: float, sc: float,
		zoom: int) -> void:
	# The live flame, fitted to the SPRITE's fire rather than to the vector drawing's.
	#
	# The two are not the same size and that is not a defect: the stage torch is derived from
	# the shop card, whose painter gave it a taller flame and a shorter handle than TOSSA's own
	# drawing had. Placing the live fire from TORCH_WICK/TORCH_FLAME_H would have it start
	# seven art pixels below where the painted one did, floating clear of the wick it belongs
	# to. So the geometry comes from the picture, measured when the flame was stripped off it.
	var fm: Dictionary = torch_flame.get(which, {})
	if fm.is_empty() or not art_bank.has(key):
		return
	var e: Dictionary = art_bank[key]
	var tex: Texture2D = e["tex"]
	var pv: Vector2 = e["pivot"]
	var hpx := float(tex.get_size().y)
	# art px -> the prop's own LOCAL units, so the flame turns with the tumble like everything
	# else the transform below carries. One art px is ART_PIXEL x the key's own `scale` screen
	# px at zoom 1, and READING THAT SCALE IS NOT OPTIONAL: the stage torch is authored at
	# double density behind a scale of 0.5, so assuming a bare ART_PIXEL here draws the fire at
	# twice the size of the handle carrying it. The measurements in torch_flame.json are in
	# authored pixels of whichever sprite they were taken from, so they follow the same factor.
	var kscale := float((art_bank[key] as Dictionary).get("scale", 1.0))
	var u := ART_PIXEL * kscale * float(zoom) / maxf(sc, 0.001)
	var base_y := (float(fm.get("base_row", 0)) - pv.y * hpx) * u
	var fh := float(fm.get("height", 0)) * u
	var hw := float(fm.get("half_width", 1.0)) * u
	if fh <= 0.0:
		return
	var t := fire_clock()
	var fl := 1.0 + 0.16 * sin(t * 0.5) + 0.07 * sin(t * 1.31)     # the same two-rate flicker
	var sway := (2.2 * sin(t * 0.29) + 0.9 * sin(t * 0.71)) * (hw / TORCH_FLAME_W)
	var b := Vector2(0.0, base_y)
	var fw := hw / 0.62                 # flame_shape's profile peaks at 0.62 of `w`
	# ON THE ART GRID. Drawn as plain polygons the fire stepped at ONE SCREEN PIXEL while the
	# coat and the handle beside it stepped at two - a vector flame pasted onto pixel art, and
	# the most obvious remaining seam in the game once the props themselves were sprites.
	# a card is a still, close-up portrait and can afford the outer aura the stage cannot -
	# the same concession draw_torch_flame's `rich` makes, for the same reason
	if which == "card":
		fill_flame_pix(pos, ang, sc, b, fh * 1.22 * fl, fw * 1.30, sway * 1.2,
			Color(1.0, 0.32, 0.06, 0.35))
	fill_flame_pix(pos, ang, sc, b, fh * fl, fw, sway, Color(1.0, 0.44, 0.10, 0.95))
	fill_flame_pix(pos, ang, sc, b, fh * 0.68 * fl, fw * 0.68, sway * 0.7,
		Color(1.0, 0.72, 0.20, 0.95), 11.0)
	fill_flame_pix(pos, ang, sc, b + Vector2(0.0, -u * 0.5), fh * 0.39 * fl, fw * 0.42,
		sway * 0.35, Color(1.0, 0.96, 0.72, 0.95), 23.0)
	var dk := stage_darkness()
	if dk > 0.02:
		draw_glow(pos + Vector2(0.0, base_y - fh * 0.5).rotated(ang) * sc, 42.0 * sc,
			Color(1.0, 0.60, 0.22, 0.34 * dk))


func art_key_prop(kind: int) -> String:
	# One prop -> one art key, derived from the PROPS table rather than from a second
	# hand-written list, so a prop added to that table can never be missing a key here.
	var n := "ball"
	if kind >= 0 and kind < PROPS.size():
		n = str((PROPS[kind] as Dictionary)["name"]).to_lower()
	return "prop/" + n


const PROPREF_AT := Vector2(640.0, 420.0)  # where the prop's draw position is put
const PROPREF_MAG := 6                     # rendered this many times larger than the stage
# BOTH NUMBERS ARE CONSTRAINED BY THE LONGEST PROP, NOT CHOSEN FOR ROUNDNESS. The capture
# is the full 1280x720 viewport, and a club is the tall one: it spans about -22.5..+17.8
# local units about its draw position, so at prop_scale 1.6 and x6 that is -216..+171 px,
# i.e. y from 204 to 591 with PROPREF_AT.y at 420. x8 put its head off the top of the
# frame, which silently truncates the very bounding box this mode exists to measure.
# The draw position sits BELOW centre for the same reason: these props are top-heavy.


func _draw_prop_ref() -> void:
	# --propref <name>: ONE prop, isolated on a flat field, drawn through the real
	# draw_prop_rich. Two jobs, and both of them are about not guessing.
	#
	# 1. SIZES AND PIVOTS ARE DERIVED, NEVER CHOSEN. A prop sprite's texture size is
	#    (local extent x prop_scale) / ART_PIXEL, and its pivot is the point the game
	#    ROTATES the shape about - which is emphatically NOT the centre of the shape.
	#    cap_club and cap_knife both draw_set_transform(p, ang), and a club spans about
	#    -22.5..+17.8 around that p. Get the pivot wrong and the prop orbits a point
	#    instead of spinning about it, which reads as bad art and is not. Reading those
	#    extents out of seven drawing functions by hand is exactly the transcription that
	#    goes quietly wrong, so: render it, and let the alpha bounding box answer.
	#    The draw position is PROPREF_AT, a known point, so the pivot falls straight out
	#    as (PROPREF_AT - bbox.position) / bbox.size on the measuring side.
	#
	# 2. THE REFERENCE IMAGE IS THE BRIEF. This render is what PixelLab is given as an
	#    img2img reference, so the generated art inherits TOSSA's actual silhouette
	#    instead of a model's idea of "a juggling club". Describing a shape in words and
	#    hoping is how a remake stops looking like the thing it is remaking.
	#
	# MAGNIFIED x8 on purpose: the stage draws a club 64px tall, which is too small to
	# guide an img2img pass and too coarse to measure a pivot from precisely.
	#
	# The seam is forced off before this runs, or a prop that already has a sprite would
	# photograph its own replacement rather than the drawing being replaced. The halo is
	# off too: the glow is stage lighting, not the object, and it would swell the measured
	# box by a soft edge that is not part of the prop.
	var kind := PROP_BALLS
	for k in PROPS.size():
		if str((PROPS[k] as Dictionary)["name"]).to_lower() == _propref:
			kind = k
			break
	draw_prop_rich(kind, PROPREF_AT, Color.WHITE, 0.0, prop_scale(kind) * float(PROPREF_MAG), false)


func _draw_char_ref() -> void:
	# --charref: the juggler alone, at the size and stance the stage draws him, on a flat
	# field. The companion to --propref, and the source for every char/* sprite.
	#
	# NO MAGNIFICATION HERE, unlike --propref, and the reason is arithmetic rather than
	# taste. The stage draws this figure about 348px tall, and the target sprite density is
	# exactly half that (ART_PIXEL = 2), so a native capture reduces by precisely 2 with
	# every source pixel landing in a clean 2x2 box. Magnifying first would only add a
	# resample step between the drawing and the sprite.
	#
	# WHY THIS IS THE ONLY HONEST WAY TO GET THIS ART. The stance and proportions are
	# settled and explicitly off-limits to change as a side effect. A generated figure -
	# tested, 2026-08-05 - comes back with realistic proportions, a semi-realistic face and
	# the arms down, which is a different character wearing the same coat. Tracing the
	# game's own render cannot drift, because it IS the game's own render.
	#
	# Pair it with --artboxes: the seam records the exact centre and size of every char/*
	# element while it is still procedural, so each part can be cropped from this capture
	# by rectangle rather than by eye.
	draw_juggler(get_viewport_rect().size)


func art_boxes_report() -> void:
	# --artboxes: key, then the rectangle the game drew it in, then the sprite size that
	# rectangle implies at the current density. This is the crop list.
	var keys := _art_boxes.keys()
	keys.sort()
	print("\n--- art boxes: %d element(s) ---" % keys.size())
	for k: String in keys:
		var r: Rect2 = _art_boxes[k]
		print("BOX %s %.2f %.2f %.2f %.2f -> %dx%d" % [k, r.position.x, r.position.y,
			r.size.x, r.size.y,
			int(round(r.size.x / ART_PIXEL)), int(round(r.size.y / ART_PIXEL))])


func art_report() -> void:
	# --artreport: what the running game ASKED the bank for, and what it got. This is the
	# remaster's to-do list, generated from the code rather than maintained by hand - drive
	# the game through a screen and every replaceable element on it prints here.
	var keys := art_asked.keys()
	keys.sort()
	print("\n--- art seam report: %d key(s) reached, %d served by a sprite ---"
		% [keys.size(), art_hits.size()])
	for k: String in keys:
		print("  [%s] %s" % ["sprite" if art_hits.has(k) else "  proc", k])
	print("--- add any of these to %s to replace it ---\n" % art_manifest_path)


func art_pixel_preview(img: Image) -> Image:
	# --pixel: answer "what does this screen look like as a 320x180 pixel-art game?" by
	# resampling the captured frame down by ART_PIXEL with NEAREST, then back up so the
	# result is viewable at normal size with every art pixel a hard 4x4 block.
	#
	# THIS IS DELIBERATELY A CAPTURE-SIDE TOOL AND NOT A LIVE VIEWPORT, and the reason is
	# worth recording because it is the first thing anyone will try. Godot's
	# CONTENT_SCALE_MODE_VIEWPORT makes `content_scale_size` BOTH the framebuffer and the
	# coordinate space the game draws in, and `content_scale_factor` does not separate the
	# two (set to 0.25 it silently reads back 1.0). So a live 320x180 viewport hands
	# `get_viewport_rect().size` = (320, 180) to a file whose every font size, panel inset
	# and hint-row offset is written in 1280x720 units - measured, not assumed: the HUD
	# collapses into overlapping boxes with text four times too big.
	#
	# Down-sampling the finished frame gives the same answer about legibility - which is
	# the whole question at this stage - without pretending the layout has been ported.
	# Porting the layout to 320x180 is real work for the END of the remaster, once no
	# procedural drawing is left to be measured in the old space.
	var w := int(img.get_width() / ART_PIXEL)
	var h := int(img.get_height() / ART_PIXEL)
	img.resize(w, h, Image.INTERPOLATE_NEAREST)
	print("art: --pixel preview downsampled to %dx%d" % [w, h])
	img.resize(int(w * ART_PIXEL), int(h * ART_PIXEL), Image.INTERPOLATE_NEAREST)
	return img


#endregion

#region STAGE BACKDROP DRAWING
func _draw() -> void:
	# --propref / --charref: draw one thing, isolated, and nothing else.
	if _propref != "":
		_draw_prop_ref()
		return
	if _charref:
		_draw_char_ref()
		return
	if _markref:
		# --markref: the five props that spell the mark, at the exact size the title screen
		# uses, on a flat field. The PIXEL prefix is deliberately NOT included: it is type,
		# it is already crisp in the pixel font, and reducing it by two would destroy it.
		# The bake is the props; the word draws live on top of it.
		var mref := get_viewport_rect().size
		capsule_mark(mref, mark_cy_centred(mref.y, _markref_size, 0.5), _markref_size)
		return
	if _bgref:
		# draw_backdrop returns early under this flag, having drawn only the sky gradient
		# and the dressing - so this is the whole frame. The veil, cone and footlights
		# never run, which is the point: they are light, not scenery.
		draw_backdrop(get_viewport_rect().size)
		return
	if _menuref:
		# --menuref: the title screen's proscenium alone, dustless. See draw_menuref.
		draw_menuref(get_viewport_rect().size)
		return
	if _extref >= 0:
		# --extref <vi>: ONE VENUE EXTERIOR, exactly as the card composes it and with the one
		# moving layer suppressed. Same split every bake in this project makes: the bake holds
		# the SCENERY and whatever drifts is drawn live over it. draw_dust reads _extref and
		# returns, so a re-bake can never double the motes into the picture.
		ext_center = true       # every live call site composes the hero mid-frame
		draw_venue_exterior(get_viewport_rect().size, _extref)
		ext_center = false
		return
	var t0 := Time.get_ticks_usec() if _fps else 0
	_draw_screen()
	_draw_state_fade()
	# the unlock card rides on top of WHATEVER screen just drew, the same trick the state
	# fade and the debug panel use - an unlock can land on the results card, in the day
	# hub or mid-act, and none of those should have to know about it
	draw_unlock_card(game_font(), get_viewport_rect().size)
	if debug_panel_open:
		draw_debug_panel()   # same trick as _draw_state_fade: drawn on top of WHATEVER
							  # screen just drew, so no screen needs to know about it
	if _perf_hud and _perf_line != "":
		# one line, top-left, over everything - and the numbers that MEAN something:
		# draws/s is the real frame rate, draw ms is the CPU cost of building a frame.
		# Deliberately no "fps": see the correction in cap_torch for what reading one off
		# a background window cost.
		var pf := game_font()
		var pw2 := pf.get_string_size(_perf_line, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13)).x
		draw_rect(Rect2(8.0, 8.0, pw2 + 20.0, 26.0), Color(0.02, 0.02, 0.04, 0.8))
		draw_string(pf, Vector2(18.0, 26.0), _perf_line, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13),
			Color(0.6, 1.0, 0.7))
	if _fps:
		_draw_us += Time.get_ticks_usec() - t0
		_draw_n += 1


func _draw_state_fade() -> void:
	# a short fade-in overlay drawn on top of WHATEVER screen just drew, so no
	# individual screen's draw function needs to know about it (see the passive
	# detector in _physics_process). A dark curtain, not pure black, so it reads
	# as a theatrical fade rather than a hard cut to nothing.
	if _state_fade_t >= STATE_FADE_FRAMES:
		return
	var s := get_viewport_rect().size
	var a := 1.0 - float(_state_fade_t) / float(STATE_FADE_FRAMES)
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.03, 0.02, 0.03, a))


func _draw_screen() -> void:
	var s := get_viewport_rect().size
	var font := game_font()
	match game_state:
		ST_MENU:
			draw_menu(font, s)
			return
		ST_SLOTS:
			draw_slots_screen(font, s)
			return
		ST_SETTINGS:
			draw_settings_screen(font, s)
			return
		ST_STATS:
			draw_stats(font, s)
			return
		ST_REMAP:
			draw_remap(font, s)
			return
		ST_CAPSULE:
			draw_capsule_art(font, s)
			return
		ST_GAMEOVER:
			draw_gameover(font, s)
			return
		ST_TUTDONE:
			draw_tutdone(font, s)
			return
		ST_DEMO_WALL:
			draw_demo_wall(font, s)
			return
		ST_PURIST_LEGEND:
			draw_purist_legend(font, s)
			return
		ST_MENUTOUR:
			draw_menutour(font, s)
			return
		ST_DIFFICULTY:
			draw_difficulty_screen(font, s)
			return
		ST_ESTABLISH:
			draw_establish(font, s)
			return
		ST_CREDITS:
			draw_credits(font, s)
			return
		ST_DAY:
			draw_day(font, s)
			if sheet_open:
				draw_sheet_screen(font, s)
			if shop_open:
				draw_shop(font, s)
			if skills_open:
				draw_skills(font, s)
			if tailor_open:
				draw_tailor(font, s)
			return
	draw_backdrop(s)
	draw_egg_splats()      # yolk on the floor sits behind the performer
	draw_balls_in_flight(true)   # Behind-the-Back balls still BEHIND the body
	draw_juggler(s)
	draw_tomato_stains()   # what the room landed on him, worn on top of the costume
	# ...and in a Blackout the performer is in the same dark as his room. Drawn HERE, so
	# it dims the backdrop and the figure (and the props in his hands) but nothing after
	# it - the airborne props keep every bit of the little glow they have. He stays
	# readable rather than going black: the challenge is finding the PROPS, and a player
	# who cannot see where the hands are is not being challenged, only blindfolded.
	# Skipped entirely when the Glow Kit is worn, which is the whole point of owning it.
	if encore_on("blackout") and not glow_props_lit():
		draw_rect(Rect2(0, 0, s.x, s.y), Color(0.012, 0.014, 0.022, 0.42))
	draw_targets()
	draw_balls_in_flight()
	draw_thrown()          # what the crowd threw: flowers (or tomatoes) at the feet
	draw_falling()         # lost props tumbling down to the boards
	draw_egg_shards()      # flying shell pieces read above the stage
	draw_charge_gauges()   # the hold-to-throw height gauge beside a charging hand
	draw_vignette(s, 0.5)  # frame the lit stage so it reads photographed, not flat
	if tut_active:
		draw_tutorial_banner(font, s)   # a lesson shows only the guided banner, no HUD -
		if tut_id.begins_with("trick_"):     # - plus the ONE corner card its text points
			draw_trick_hud(font, s)          # at, so "the bottom-right card" is a real
		elif tut_id.begins_with("pattern_"): # thing on screen, not a promise (Louis)
			draw_routine_hud(font, s)
	else:
		draw_hud(font, s)
	draw_show_guide(font, s)   # the first show's own guide, over the live HUD it explains
	draw_popups(font)
	if results_open and not tut_active:
		if ovation_left > 0:
			draw_ovation(font, s)   # ...the room on its feet, first
		else:
			draw_results(font, s)   # the end-of-performance card, over the frozen stage
	draw_parts()           # sparks and confetti ride above the stage and the card
	if sheet_open:
		draw_sheet_screen(font, s)
	if shop_open:
		draw_shop(font, s)
	if paused:
		draw_pause_screen(font, s)     # the pause menu sits over everything


var _bg_floor: Dictionary = {}    # bg key -> the ground colour sampled from its painting


func bg_floor_colour(bg_key: String, fallback: Color) -> Color:
	# THE FLOOR HE STANDS ON, TAKEN FROM THE PAINTING BEHIND HIM (2026-08-13, Louis: "make
	# sure that the podium or ground the player is standing on and the ground before him is
	# matching the background").
	#
	# `venue_data`'s "floor" is a hand-picked colour per venue, and every one of them was
	# chosen before these rooms were paintings - seven dark neutrals in the 0.045..0.12 range
	# that agree with nothing in particular. So the Circus's sawdust ring stopped at the floor
	# line and a cold grey-brown started, and the Arena's pitch did the same.
	#
	# The painting covers the whole frame and the floor is drawn OVER its bottom fifth, so the
	# ground the picture itself shows is right there to be read: sample the rows just above
	# the floor line (art y 276..286, the last ground the player can actually see) and carry
	# that colour down. A regenerated backdrop re-matches itself with no numbers to update,
	# which matters because these get re-rolled.
	#
	# Cached per key: get_image() is a texture read and this is called every frame.
	if _bg_floor.has(bg_key):
		return _bg_floor[bg_key]
	if not art_on or not art_bank.has(bg_key):
		return fallback     # no painting: the hand-picked colour is still the right answer
	var tex: Texture2D = (art_bank[bg_key] as Dictionary)["tex"]
	var img := tex.get_image()
	if img == null:
		return fallback
	var w := img.get_width()
	var h := img.get_height()
	# in the painting's own pixels, whatever size it is: the band just above the floor line,
	# which sits at 0.80 of the frame
	# ...AND THE BAND FOLLOWS THE VENUE'S OWN STANDING LINE, which is no longer 0.80 in every
	# room (see stage_floor_y). Sampling a fixed band would now read the Circus's ring wall
	# rather than its sawdust in exactly the rooms whose floor sits lowest.
	var stand := float(venue_data(cur_venue()).get("stand", STAND_DEFAULT))
	var y0 := int(h * (stand - 0.033))
	var y1 := maxi(y0 + 1, int(h * (stand - 0.003)))
	var acc := Vector3.ZERO
	var n := 0
	for y in range(y0, mini(y1, h)):
		for x in range(0, w, 4):     # every fourth column is plenty for a mean
			var c := img.get_pixel(x, y)
			acc += Vector3(c.r, c.g, c.b)
			n += 1
	if n == 0:
		return fallback
	acc /= float(n)
	# DARKENED A LITTLE ON PURPOSE. The sampled band is lit room; the apron is nearer the
	# audience and out of the wash, and a floor at exactly the wall's value flattens the two
	# into one surface. 0.72 keeps it recognisably the same material without matching it.
	var out := Color(acc.x * 0.72, acc.y * 0.72, acc.z * 0.72)
	_bg_floor[bg_key] = out
	return out


func venue_ground() -> Color:
	# THE COLOUR OF THE GROUND IN TONIGHT'S ROOM, for the screens that have to build a floor
	# instead of standing on a painted one - the tailor's mirror and the skills preview. Both
	# are panels a few hundred pixels wide, so they cannot blit a backdrop into themselves (a
	# painting scaled to a box is the one thing pixel art cannot survive), but they can be the
	# same MATERIAL as the house the player is booked into, which is most of what sells it.
	var v := venue_data(cur_venue())
	return bg_floor_colour("bg/" + str(v["name"]).to_lower().replace(" ", "_"), v["floor"])


func draw_preview_floor(area: Rect2, fy: float, glow: Color) -> void:
	# A FLOOR A PREVIEW FIGURE CAN STAND ON (2026-08-14, Louis: "there is no floor at all").
	#
	# Both panels used to draw the same two marks: one flat near-black rectangle below the
	# figure and a single 1.5px line across the top of it. That is a HORIZON, not a floor -
	# the man reads as standing on a wire in front of a dark wall, which is what he was.
	# Three cheap things fix it, and they are the three the stage itself has: a ground that
	# recedes (bright where the light lands at his boots, dark at the front edge), the seams
	# of the boards opening up as they come forward, and a warm lip on the line his feet are
	# on. Nothing here is scenery - it is the same light-not-scenery rule draw_stage_light
	# follows - so it costs one gradient and four rects and cannot fight a costume.
	var ap := float(ART_PIXEL)
	var top := art_snap(Vector2(0.0, fy)).y
	var bot := area.position.y + area.size.y
	if bot - top < ap * 2.0:
		return
	# ...KEPT DARK. The first version lit the near edge at 1.9x the sampled ground and the two
	# panels came back with a pale grey slab across them - a concrete step, not a floor, and
	# the brightest thing on either screen when the figure is meant to be. A floor in a dark
	# room is dark: a little lift where the light lands, and away to near-black at the front.
	# ...AND THE CEILING IS WHAT MAKES "KEPT DARK" TRUE AT EVERY HOUSE (2026-08-15). The lift
	# above is a MULTIPLIER, so how dark the floor ends up is decided by the backdrop it
	# sampled, and two of the seven venues have a genuinely pale ground - the Circus ring is
	# lit sawdust and the Small Theatre's boards are warm oak. Measured on a Circus capture,
	# the tailor's mirror drew its boards at 0.59/0.52/0.42 against a performer whose lit coat
	# is 0.42: the note above was written about a bug that was still happening, on the one
	# screen whose entire job is looking at the man. The clamp is PROPORTIONAL rather than
	# per-channel so a warm floor stays warm instead of turning grey as it hits the limit -
	# clipping the channels independently is what turns a colour into a wash of whichever
	# channel was smallest.
	var g := venue_ground()
	var near := Color(g.r * 1.30 + 0.020, g.g * 1.26 + 0.017, g.b * 1.22 + 0.015)
	var peak := maxf(near.r, maxf(near.g, near.b))
	if peak > PV_FLOOR_MAX:
		var kdim := PV_FLOOR_MAX / peak
		near = Color(near.r * kdim, near.g * kdim, near.b * kdim)
	var far := Color(g.r * 0.42, g.g * 0.42, g.b * 0.50)
	draw_gradient_v(Rect2(area.position.x, top, area.size.x, bot - top), near, far,
		maxi(2, int((bot - top) / ap)))
	# THE SEAMS WIDEN AS THEY COME FORWARD, which is the whole reason four lines read as a
	# receding floor and four evenly spaced ones read as a ladder. Snapped to the art grid so
	# a board edge is a whole pixel, never a grey smear across two.
	var y := top + ap * 2.0
	var gap := ap * 2.0
	while y < bot - ap:
		draw_rect(Rect2(area.position.x, art_snap(Vector2(0.0, y)).y, area.size.x, ap),
			Color(far.r * 0.5, far.g * 0.5, far.b * 0.5, 0.60))
		gap *= 1.55
		y += gap
	# the lit lip: the light he is standing in, landing on the line his boots are on
	draw_rect(Rect2(area.position.x, top, area.size.x, ap),
		Color(glow.r, glow.g, glow.b, 0.34))


func draw_backdrop(s: Vector2) -> void:
	var vi := cur_venue()
	var v := venue_data(vi)
	var glow: Color = v["glow"]
	var floor_c: Color = v["floor"]
	var spot: float = v["spot"]
	# `spot` only scales SOME of what follows (the cone and the light pool's spot*0.9
	# term); the floor lip's 0.10 baseline and the footlights below keep a small fixed
	# glow regardless of venue, so even the Midnight Show's near-zero spot (0.015)
	# reads as a dim, softly-lit dark rather than pitch black - a deliberately gentle
	# floor, not a bug, but worth knowing if a venue is ever asked to go fully dark.

	# a warm vertical gradient behind everything gives the stage depth instead of a
	# flat black void (the biggest single "cheap look" fix on the play screen)
	var sky_top := Color(floor_c.r * 0.7, floor_c.g * 0.7, floor_c.b * 0.9)
	var sky_bot := Color(glow.r * 0.10 + 0.02, glow.g * 0.09 + 0.02, glow.b * 0.10 + 0.03)

	var fy := stage_floor_y()

	# SEAM: ONE PAINTING PER HOUSE, and it replaces exactly two layers - the sky gradient
	# and the set dressing. Everything after it (the veil, the spotlight cone, the
	# footlights, the floor) is LIGHT, not scenery, and stays procedural on purpose: the
	# cone narrows and warms as a streak builds, which is the stage rewarding focus, and
	# `stage_darkness`/Blackout drive the rest. A painted backdrop that had the lighting
	# baked into it would freeze all of that, and the light is the half of this picture
	# that is actually reacting to the player.
	var bg_key := "bg/" + str(v["name"]).to_lower().replace(" ", "_")
	# (the sampled ground colour that used to be read here went with the drawn podium: nothing
	# on this screen paints a floor any more, the painting IS the floor. It survives as
	# venue_ground, for the two panels that have to build one - see draw_preview_floor.)
	if _bgref:
		# --bgref: draw ONLY the two layers the seam replaces - the sky gradient and the
		# set dressing - and nothing after them. This is the backdrop equivalent of
		# --propref/--charref, and it exists because two of the seven venues cannot be
		# generated: the Backyard and the Street Corner are outdoor and asymmetric, so the
		# mirror trick that built the other five duplicates their scenery, and separately
		# generated halves do not meet at the horizon. Reducing the game's own dressing to
		# the art grid is guaranteed to match TOSSA exactly, which is the brief, and it is
		# the same technique the props and the body already use.
		# The lighting deliberately does NOT run: a backdrop with the spotlight baked into
		# it would freeze the cone that narrows and warms as a streak builds.
		draw_gradient_v(Rect2(0, 0, s.x, s.y), sky_top, sky_bot, 22)
		draw_venue_dressing(s, vi, fy, glow)
		return
	if not art_blit_rect(bg_key, Rect2(Vector2.ZERO, s)):
		draw_gradient_v(Rect2(0, 0, s.x, s.y), sky_top, sky_bot, 22)
		# the venue's own set dressing sits behind the light, then a dark veil pushes it
		# back into the depth, so the escalating ladder is FELT without ever competing
		# with the props (ART pillars 1 and 4)
		draw_venue_dressing(s, vi, fy, glow)
	# THE VEIL IS PER-VENUE (2026-07-27, Louis: some stages are "some blurry line in the
	# dark ... most stages do fine: like the circus. but some don't; like the midnight
	# event"). This flat 42% wash exists to push the set behind the props, and on a bright
	# set - the Circus canopy, the Arena bowl - that is exactly right. On an already-dark
	# set it is applied to dressing that had no brightness to spare, and what survives is
	# a faint smudge: the Midnight Show's clock, moon window and candles were all being
	# drawn and then wiped off. Each venue now says how much push-back its own set can
	# take (`veil`), so a dark house keeps its detail without any venue losing its depth.
	# ...AND IT IS TOP-WEIGHTED, NOT FLAT (2026-08-08, Louis: "make it logical that the
	# juggler has his back to the background of the stage, people there won't see that
	# much"). Five of the seven backdrops paint tiered SEATING behind the performer, and a
	# flat wash lit all of it evenly - so the far side of the house read as a second
	# audience, watching an act that has its back to them, as brightly as the one in front.
	# Nothing on a stage is lit that way: the lamps point down at the performer, the back
	# wall is the darkest thing in the building, and the people up there are the ones who
	# paid least and see least.
	#
	# So the veil now deepens toward the top - the same average push-back each venue was
	# tuned for, redistributed. It costs nothing but a stacked gradient, it makes those seats
	# read as a dim gallery rather than a front row, and it separates the performer from the
	# painting behind him, which is the thing the whole veil exists to do.
	var veil := float(v.get("veil", 0.42))
	var veil_c := Color(sky_bot.r * 0.4, sky_bot.g * 0.4, sky_bot.b * 0.5, 1.0)
	# ...and the bottom of the ramp is the venue's OWN veil, never less. Grading it down
	# there as well (0.55x was tried) redistributes the wash honestly and still gets it
	# wrong, because the performer stands at the bottom: it makes the set immediately behind
	# him BRIGHTER than it was, which is the one place the veil was earning its keep. The
	# ramp only ever adds darkness, going up.
	draw_gradient_v(Rect2(0, 0, s.x, fy),
		Color(veil_c.r, veil_c.g, veil_c.b, minf(1.0, veil * 1.55)),
		Color(veil_c.r, veil_c.g, veil_c.b, veil), 24)
	# ...AND IT DOES NOT STOP DEAD AT HIS FEET (2026-08-15, Louis: "there is a too obvious
	# cutoff below the characters feet: like dark above and light right under it").
	#
	# The veil ran from the top of the frame to `fy` and then simply ended, so the row above
	# the standing line carried the venue's full wash and the row below it carried none. That
	# is a hard step in one row, across the entire width of the screen, a few pixels under the
	# performer - measured on a Circus capture, (125,100,82) to (185,165,145), a jump of 60 per
	# channel. It reads as the floor being a separate brighter object pasted under him, which
	# is exactly the "vector stage" look deleting the podium was supposed to end.
	#
	# THE LEVELS ARE UNCHANGED AND THAT IS THE CONSTRAINT (Louis: "keep the same light
	# levels"). Nothing above the line moves at all, and no new brightness target is invented:
	# the veil simply CONTINUES at the value it already reached and decays to nothing over the
	# next 72px. So the row below the line now matches the row above it - which is what removes
	# the step - and the floor comes up to its painted brightness gradually instead of in one
	# jump. It also happens to be right about depth for free: the boards at the back of the
	# band are further away than the boards at the front, so they should carry more of the
	# room's air, and this is the same near-bright/far-dark reading draw_preview_floor builds
	# by hand for the two panels that have no painting to lean on.
	#
	# The other direction was tried and is recorded above: grading the veil DOWN toward the
	# floor removes the step by brightening the set immediately behind the performer, which is
	# the one place the veil is earning its keep.
	var lip := minf(72.0, maxf(0.0, s.y - fy))
	if lip > 0.0:
		draw_gradient_v(Rect2(0, fy, s.x, lip),
			Color(veil_c.r, veil_c.g, veil_c.b, veil),
			Color(veil_c.r, veil_c.g, veil_c.b, 0.0), 16)
	draw_stage_grade(s, fy, glow)

	# THE SPOTLIGHT CONE IS GONE (2026-08-15, Louis: "none of the stages should have a cone
	# light, because where would that even come from?").
	#
	# It was a flat triangle from the top of the frame down to the boards, drawn in every
	# venue at the venue's own `spot`. The question kills it: a backyard has no followspot
	# rig, a street corner has no followspot rig, and the two arenas are lit by the floodlight
	# arrays already painted into their own backdrops. Only a real theatre could motivate one,
	# and the Small Theatre's light belongs to its footlights, which are drawn along the lip.
	# Drawing the beam anyway is the same mistake as a baked spotlight in a painting, one step
	# later in the pipeline: light that names a source the picture does not contain.
	#
	# WHAT REPLACES IT IS THE LIGHT THE ROOM ALREADY OWNS. The Circus keeps its ring of light
	# because that ring is PAINTED ON ITS FLOOR - it is sawdust catching the big top's own
	# lanterns, not a cone hanging in the air, which is exactly the distinction Louis drew.
	# The soft pool below stays, quietened: it is a ground-level lift that keeps the performer
	# legible against a dark house without claiming a lantern that is not there. `hot` survives
	# because the pool still answers a streak, which is the half of this the player earns.
	var hot := clampf(float(streak) / 15.0, 0.0, 1.0) if game_state == ST_PLAY else 0.0

	# a SMOOTH warm light pool on the performer, built from many faint overlapping
	# discs (bright centre fading out), so it reads as a soft spotlight instead of
	# the hard target rings it used to be. A small floor keeps the stage from a void.
	# Its centre is measured UP FROM THE FLOOR for the same reason the cone's end is
	# measured down to it: the pool is on the man, and the man moves with the room.
	var pc := Vector2(s.x * 0.5, fy - s.y * 0.30)
	var pool := (0.045 + spot * 0.9) * (1.0 + 0.30 * hot)
	# ONE textured glow, where this used to be a stack of 26 flat discs (see draw_glow):
	# same soft pool, one draw call instead of twenty-six, and no visible rings - which
	# is what appeared the moment the stack was thinned to pay for itself.
	draw_glow(pc, 410.0 - 40.0 * hot, Color(glow.r, glow.g, glow.b, pool * 1.15))

	# THE PAINTING IS THE FLOOR NOW - THERE IS NO DRAWN PODIUM (2026-08-14, Louis: "i wanted
	# you to remove the podium: the player always stands on some vector drawn stage, which i
	# don't like. Instead i want you to generate a floor for whatever stage he is in").
	#
	# The striking thing on going to look: EVERY BACKDROP ALREADY HAD A PAINTED FLOOR, and the
	# apron had been drawn on top of it the whole time. The Small Theatre paints warm boards,
	# the Circus its sawdust ring inside a red-and-cream ring wall, the Championship a polished
	# marked floor, the World Arena the pitch, the Street Corner cobbles, the Backyard its porch
	# steps and grass. So the fix is deletion, not construction: stop covering them.
	#
	# What stays is LIGHT, which is the same split the backdrop itself has always used: the lip
	# wash where the pool meets the floor, and the footlights. Scenery is painted, light reacts.
	draw_stage_light(s, fy, vi, glow, spot)

	# the near field: the handful of things the act is standing AMONG, drawn past the
	# veil so they read, unlike the set dressing behind it (see draw_venue_foreground)
	draw_venue_foreground(s, vi, fy, glow)

	# a drop briefly cools the whole room, the visual half of the music duck
	if game_state == ST_PLAY and tick - last_drop_tick < 26 and tick - last_drop_tick >= 0:
		var da := 0.12 * (1.0 - float(tick - last_drop_tick) / 26.0)
		draw_rect(Rect2(0, 0, s.x, s.y), Color(0.35, 0.45, 0.65, da))
	# BLACKOUT ACTUALLY CUTS THE LIGHTS (2026-07-27, Louis: the challenge "is too easy: i
	# just see a different color ball"). He was right, and the reason is worse than a
	# tuning miss: the Encore never darkened the house AT ALL. `spot` is read straight
	# from venue_data with no override, so a Blackout at the Circus ran on the Circus's
	# full stage lighting and the only thing that changed was the colour of the props -
	# which is exactly what he described. The room goes dark HERE, over the finished
	# backdrop and everything in it, and the props are drawn afterwards, so their glow is
	# genuinely the only light in the picture instead of a green repaint of a lit one.
	# The performer is deliberately left legible enough to time a catch against: the
	# challenge is finding the props, not guessing where his hands are.
	if encore_on("blackout"):
		draw_rect(Rect2(0, 0, s.x, s.y), Color(0.012, 0.014, 0.022, 0.88))


# draw_crowd AND crowd_person WERE DELETED HERE (2026-08-14). They drew the house as rows of
# rasterised silhouettes below the stage - heads, shoulders, three kinds of hat, a warm rim on
# every crown - and Louis's note on the whole lower frame was "whatever those moving parts are
# in the front should also be generated". They were the last vector crowd in the game and they
# had become redundant besides: the backdrops now paint their own audiences (the Circus's
# bleachers, the World Arena's bowl, the Midnight Show's candlelit tables), so the drawn row
# was a second, cruder audience sitting in front of a better one.
#
# WHAT WENT WITH THEM, and it is worth stating rather than discovering later: the crowd used to
# EMPTY ITS SEATS on a bad night (each seat had a stable leave threshold tested against
# `applause`, so a real crater visibly thinned the house). That feedback now lives only in the
# HUD's crowd dial and in the flowers and tomatoes. If it should come back it wants to come
# back as generated art, not as these.



func draw_stage_grade(s: Vector2, fy: float, glow: Color) -> void:
	# THE STAGE-LIGHT VARIANT (F9 > THE LOOK > Stage light). A wash laid over the finished
	# backdrop and UNDER the spotlight cone, so it changes how far the room sits behind the
	# performer without touching a single pixel of the painting or of the light that
	# reacts to the player. That placement is the whole design: put it after the cone and
	# it would dull the one thing on this screen that rewards a streak.
	#
	# It is a grade, not scenery, so it costs a handful of rects and can be judged purely
	# on feel - which is what makes it a fair thing to put on the panel. The backdrops
	# themselves cannot be varied this cheaply: seven venues times three looks is
	# twenty-one paintings, and five of the seven are PixelLab generations that would have
	# to be re-run and re-mirrored.
	match variant("lighting"):
		"depth":
			# THE ROOM SINKS. A second cool veil over the backdrop only - the performer is
			# lit by the cone that comes after this, so pushing the room back pushes HIM
			# forward for free. Graded top-down rather than flat: the ceiling of a big
			# house is the part that should read as far away, and the seats near the
			# stage lip are the part that should not.
			draw_gradient_v(Rect2(0, 0, s.x, fy), Color(0.04, 0.05, 0.10, 0.40),
				Color(0.04, 0.05, 0.10, 0.10), 10)
		"warm":
			# TUNGSTEN SPILL AND A HEAVIER VIGNETTE. Real theatre light is not white, and
			# the corners of a lit stage fall off hard because the lanterns are all aimed
			# at the middle of it. The spill is the venue's OWN glow colour rather than a
			# fixed amber, so a house keeps its identity - the Midnight Show does not
			# suddenly warm up into the Circus.
			draw_rect(Rect2(0, 0, s.x, fy), Color(glow.r, glow.g, glow.b, 0.10))
			var vw := s.x * 0.22
			draw_gradient_h(Rect2(0, 0, vw, fy), Color(0.02, 0.01, 0.02, 0.45), Color(0.02, 0.01, 0.02, 0.0), 8)
			draw_gradient_h(Rect2(s.x - vw, 0, vw, fy), Color(0.02, 0.01, 0.02, 0.0), Color(0.02, 0.01, 0.02, 0.45), 8)
			draw_gradient_v(Rect2(0, 0, s.x, fy * 0.30), Color(0.02, 0.01, 0.02, 0.40), Color(0.02, 0.01, 0.02, 0.0), 8)
		_:
			pass   # "classic": the backdrop as painted, which is what has always shipped


func draw_venue_dressing(s: Vector2, vi: int, fy: float, glow: Color) -> void:
	# what the stage LOOKS OUT ON, per rung of the ladder. Dim, at the edges, and
	# behind a veil, so the centre stays clear for juggling.
	match vi:
		0:   # backyard: dusk stars, the old tree, a fence, the house with a lit window,
			# and (2026-07-27) the rest of a garden at dusk - a hedge along the back, the
			# washing still out on the line, fireflies over the grass
			# the last of the light along the horizon: this one move is what makes the
			# garden read as DUSK instead of as a dark field with things in it
			draw_gradient_v(Rect2(0.0, fy - 250.0, s.x, 250.0), Color(0.10, 0.09, 0.20, 0.0),
				Color(0.44, 0.25, 0.18, 0.55), 16)
			draw_stars(s, 20, 0.42)
			draw_hedge(s, fy - 2.0, s.x * 0.16, s.x * 0.60, 26.0)
			draw_tree(Vector2(s.x * 0.09, fy + 2.0), 1.0)
			draw_fence(s, fy - 2.0, s.x * 0.60, s.x * 0.97)
			draw_house(Vector2(s.x * 0.88, fy + 2.0), 132.0, 108.0)
			draw_washing_line(Vector2(s.x * 0.085, fy - 128.0), Vector2(s.x * 0.34, fy - 112.0), fy)
		1:   # street corner: the cold city behind one warm lamp. The skyline gets its
			# own heavy night veil: lit windows read as distant, never as clutter or a
			# fight with the text that floats over them (Louis). The STREET itself is
			# drawn after that veil (2026-07-27), so the corner the act is actually
			# standing on reads at full strength: a shuttered shopfront under its awning,
			# the lamp, and the busker's own kit stacked beside it.
			draw_moon(Vector2(s.x * 0.87, s.y * 0.13), 20.0)
			draw_stars(s, 26, 0.38)
			draw_city_row(s, fy)
			draw_rect(Rect2(0, 0, s.x, fy), Color(0.03, 0.04, 0.09, 0.85))
			draw_shopfront(Vector2(s.x * 0.86, fy), 250.0, 132.0)
			draw_streetlamp(Vector2(s.x * 0.26, fy), fy)
			draw_crate(Vector2(s.x * 0.16, fy), 34.0, 26.0)
			draw_crate(Vector2(s.x * 0.20, fy), 26.0, 18.0)
		2:   # small theatre: velvet wings and a valance frame the stage, a hung velvet
			# back wall behind it (2026-07-27 - the middle of the room was a flat void),
			# and a gilded proscenium arch over the whole picture.
			# 2026-07-27 (Louis: "the small theater in particular looks bland"): it had
			# drapes and an arch and nothing else, while the Backyard next door has a
			# tree, a fence, a house AND a washing line. So it gets the furniture a real
			# little theatre has - boxes either side, sconces burning on the piers, and a
			# row of footlights along the lip - all of it at the EDGES, because the
			# middle of this picture belongs to the props.
			draw_curtain_wall(s, fy, s.y * 0.06, Color(0.21, 0.045, 0.065), 26)
			draw_theatre_wings(s, fy)
			draw_theatre_boxes(s, fy)
			draw_proscenium(s, fy)
			draw_footlights(s, fy)
		3:   # circus: the big-top canopy overhead and a string of lanterns
			draw_circus_canopy(s)
			draw_lantern_string(Vector2(-10.0, s.y * 0.20), Vector2(s.x + 10.0, s.y * 0.24))
		4:   # championship: a competition hall - raked stands along the back, a lighting
			# truss overhead, the board keeping score high in the dark, and the banners
			# (2026-07-27: it was four banners, a flat 8px rectangle and a few stars)
			draw_tiers(s, fy - 4.0, 3, Color(0.30, 0.42, 0.66), 0.9)
			draw_truss(s, s.y * 0.085, Color(0.62, 0.78, 1.0))
			draw_scoreboard(Vector2(s.x * 0.5, s.y * 0.19), 250.0, 74.0, Color(0.55, 0.78, 1.0), s.y * 0.085 + 18.0)
			for bx in [s.x * 0.06, s.x * 0.16, s.x * 0.84, s.x * 0.94]:
				draw_banner(Vector2(bx, s.y * 0.10), Color(0.3, 0.5, 0.9))
		5:   # world arena: a vast bowl of warm crowd-lights and roaming beams
			draw_tiers(s, fy - 4.0, 4, Color(0.44, 0.32, 0.56), 1.0)
			draw_truss(s, s.y * 0.06, Color(1.0, 0.84, 0.6))
			draw_jumbotron(Vector2(s.x * 0.31, s.y * 0.155), 140.0, 82.0, glow)
			draw_jumbotron(Vector2(s.x * 0.69, s.y * 0.155), 140.0, 82.0, glow)
			for i in 110:
				var seed := float(i) * 17.7
				var x := s.x * 0.5 + (fposmod(sin(seed) * 99.0, 1.0) - 0.5) * s.x
				var y := fy - 30.0 - fposmod(cos(seed) * 71.0, 1.0) * s.y * 0.34
				if absf(x - s.x * 0.5) < s.x * 0.17 and y > s.y * 0.3:
					continue   # keep the juggling window clear
				var a := 0.25 + 0.35 * sin(atick() * 0.05 + seed)
				# 110 of these a frame: squares at 1.6px are the same two pixels of light
				draw_rect(Rect2(x - 1.6, y - 1.6, 3.2, 3.2), Color(1.0, 0.82, 0.52, clampf(a, 0.08, 0.6)))
			for k in 2:
				var ang := sin(atick() * 0.008 + float(k) * 2.6) * 0.55
				var src := Vector2(s.x * (0.22 + 0.56 * float(k)), -20.0)
				var dir := Vector2(sin(ang) * 0.6, 1.0).normalized()
				var perp := Vector2(-dir.y, dir.x) * 30.0
				draw_colored_polygon(PackedVector2Array([src, src + dir * 900.0 + perp, src + dir * 900.0 - perp]),
					Color(glow.r, glow.g, glow.b, 0.05))
		_:   # The Midnight Show (2026-07-18) and anything past it: the SAME procedural
			# placement as the World Arena above (same seed formula, so the two still
			# feel like kin), but a scattered handful of lights and no roaming search
			# beams - venue_data's spot (0.015, half the Backyard's) and near-black suit
			# already ask for a genuinely dark house, and reusing the World Arena's full
			# 110-light bowl wholesale here (the old catch-all, before this arm existed)
			# undercut that: a bonus venue built to make the Glow-in-the-Dark Kit matter
			# was reading exactly as bright as the venue it is the reward for beating.
			for i in 18:
				var seed := float(i) * 17.7
				var x := s.x * 0.5 + (fposmod(sin(seed) * 99.0, 1.0) - 0.5) * s.x
				var y := fy - 30.0 - fposmod(cos(seed) * 71.0, 1.0) * s.y * 0.34
				if absf(x - s.x * 0.5) < s.x * 0.17 and y > s.y * 0.3:
					continue   # keep the juggling window clear
				# brighter and a touch larger than they were: at 0.24 peak alpha on a
				# 2.8px square these were below the threshold where a light reads as a
				# light at all, which is what left the house looking merely under-exposed
				var a := 0.30 + 0.34 * sin(atick() * 0.05 + seed)
				draw_circle(Vector2(x, y), 2.1, Color(1.0, 0.86, 0.58, clampf(a, 0.10, 0.66)))
				draw_glow(Vector2(x, y), 13.0, Color(1.0, 0.84, 0.55, clampf(a * 0.32, 0.03, 0.20)))
			# ...and the things that say WHICH dark room this is (2026-07-27), all kept
			# faint enough that the Glow-in-the-Dark Kit still has a job: the house
			# clock at midnight, the candles the room is lit by (foreground), and the
			# tall window the moon comes through - the one source of light in here that
			# is not a flame, and the reason the boards have a pale slab lying on them.
			draw_wall_clock(Vector2(s.x * 0.5, s.y * 0.13), 30.0, Color(0.55, 0.95, 0.68))
			# clear of the left HUD rail (which reaches x 318) and of the juggling window
			draw_moon_window(Vector2(s.x * 0.30, s.y * 0.30), 84.0, 190.0, fy)


func draw_stage_light(s: Vector2, fy: float, vi: int, glow: Color, spot: float) -> void:
	# WHAT IS LEFT WHERE THE PODIUM WAS: light, and nothing that pretends to be scenery.
	#
	# The apron this replaces drew boards, a nosing, a panelled front face, panel joints and a
	# skirting rail - about eighty lines of carpentry, all of it laid over a floor the backdrop
	# painting had already painted. Louis, seeing it: "the player always stands on some vector
	# drawn stage, which i don't like". He is right, and the honest fix is to stop drawing it
	# rather than to draw it better. Going to look was the whole job: the Small Theatre paints
	# warm boards, the Circus its sawdust ring, the Championship a marked floor, the World
	# Arena the pitch, the Street Corner cobbles. They were under the apron all along.
	#
	# The two things kept are both LIGHT and both react to the run, which is exactly the rule
	# draw_backdrop has always used for what may and may not be baked into a painting:
	#   - the warm wash where the spotlight pool lands on the floor, which grows with `spot`;
	#   - the footlights, once the career reaches a ticketed room, which flicker.
	# Neither describes a surface, so neither can contradict whatever floor the painting shows.
	var ap := float(ART_PIXEL)
	# THE POOL FADES IN AS WELL AS OUT, and the venue that proved it needed to is the one
	# whose light is not warm (2026-08-15). This was a single gradient starting at fy-10 at
	# full strength and falling away forward, so its TOP was a hard step from nothing to
	# 0.10+spot in one row. At six houses the glow is a warm orange or amber within a few
	# points of the boards it lands on and the step is invisible. The Midnight Show's glow is
	# Color(0.40, 0.92, 0.62) - a saturated mint, and deliberately so, because that is the
	# room the Glow Kit exists for - laid over warm brown floorboards. Measured on a capture,
	# the floor went (77,54,51) to (80,74,64) between two adjacent rows and then on to green:
	# a hard horizontal line straight across the stage, with warm wood above it and cold wood
	# below. It reads as a rendering seam, not as light.
	#
	# A light pool has no edge, so the fix is to give it the missing half rather than to dim
	# it: it ramps up over the 24px behind the standing line, peaks where the light actually
	# lands, and falls away forward exactly as before. Nothing changes at any warm venue,
	# which is the point - this only ever showed where the light and the floor disagreed.
	draw_gradient_v(Rect2(0, fy - 34.0, s.x, 24.0),
		Color(glow.r, glow.g, glow.b, 0.0), Color(glow.r, glow.g, glow.b, 0.10 + spot), 8)
	draw_gradient_v(Rect2(0, fy - 10.0, s.x, 44.0),
		Color(glow.r, glow.g, glow.b, 0.10 + spot), Color(glow.r, glow.g, glow.b, 0.0), 10)
	if vi >= 2:
		for i in 12:
			var lx := s.x * (float(i) + 0.5) / 12.0
			var fl := 0.6 + 0.4 * sin(atick() * 0.05 + float(i) * 1.7)
			# a lamp is a glow and a hot core, not a housing: a drawn hood would be the
			# vector stage coming back one prop at a time
			draw_glow_pix(Vector2(lx, fy + ap), 18.0, Color(glow.r, glow.g, glow.b, 0.20 * fl))
			fill_disc_pix(Vector2(lx, fy + ap), ap * 1.5, Color(1.0, 0.85, 0.55, 0.75 * fl))



func draw_venue_foreground(s: Vector2, vi: int, fy: float, glow: Color) -> void:
	# the NEAR field, drawn after the veil and after the stage floor (2026-07-27), so
	# the few things the act is standing among read at full strength while everything
	# in draw_venue_dressing stays pushed back into the depth. Edge-weighted, and
	# never inside the juggling window.
	# THREE DRAWN THINGS LEFT HERE WHEN THE PODIUM WENT, AND THEY ARE GONE NOW (2026-08-14):
	# a band of vector grass at the Backyard, a stroked kerb line at the Street Corner, and two
	# candles standing at the edges of the Midnight Show. Each was scenery, each is painted in
	# the backdrop it sat on - the lawn, the kerb, and a whole room of candlelit tables - so
	# each was a second, cruder copy in front of a better one, exactly like the drawn crowd.
	# The Midnight Show's pair was the plainest tell: the painting has candles ON TABLES and
	# these two stood in mid-air beside them.
	#
	# What stays is what is LIGHT or what is the ACT'S OWN: the fireflies over the lawn and
	# the mist lying on the boards. Same rule as everywhere else on this screen.
	#
	# AND THE BUSKER'S HAT IS GONE TOO (2026-08-15, Louis: "remove the begging hat from the
	# street performance"). It was the last survivor of the list above and it survived on a
	# technicality - it is the act's own object rather than scenery, which is a true sentence
	# and the wrong test. What it actually put on the screen was a hat lying on the pavement
	# to collect coins, twelve pixels from where the player is juggling, in a game whose
	# currency is FLOWERS THROWN BY A CROWD. It said the Street Corner is where you beg, and
	# every other room says you are booked. The economy is the same at all seven houses;
	# the picture should be too.
	match vi:
		0:   # the fireflies over the lawn
			for i in 9:
				var seed := float(i) * 31.7
				var fx := fposmod(sin(seed) * 411.0, 1.0) * s.x
				if absf(fx - s.x * 0.5) < 210.0:
					continue
				var fyy := fy - 30.0 - fposmod(cos(seed) * 271.0, 1.0) * 150.0
				var drift := Vector2(sin(atick() * 0.008 + seed) * 16.0, cos(atick() * 0.011 + seed) * 11.0)
				var pulse := clampf(0.35 + 0.65 * sin(atick() * 0.03 + seed * 2.0), 0.0, 1.0)
				soft_disc(Vector2(fx, fyy) + drift, 10.0, Color(0.9, 1.0, 0.5, 0.09 * pulse), 8)
				soft_disc(Vector2(fx, fyy) + drift, 2.4, Color(0.95, 1.0, 0.6, 0.95 * pulse), 8)
		6:   # the mist lying on the boards
			for i in 3:
				var mx := s.x * (0.22 + 0.28 * float(i))
				var drift := sin(atick() * 0.004 + float(i) * 2.1) * 26.0
				fill_ellipse(Vector2(mx + drift, fy + 4.0), 190.0, 13.0, Color(0.35, 0.85, 0.55, 0.07))


func draw_moon_window(c: Vector2, w: float, h: float, fy: float) -> void:
	# a tall arched window with the moon behind it, and the slab of moonlight it lays
	# across the boards. Cool and dim on purpose: it gives The Midnight Show a source
	# and a shape without lighting the room the Glow Kit exists to survive.
	var cool := Color(0.62, 0.86, 0.95)
	var top := c.y - h * 0.5
	var bot := c.y + h * 0.5
	var pts := PackedVector2Array()
	for i in 11:   # the arch
		var a := lerpf(PI, TAU, float(i) / 10.0)
		pts.append(Vector2(c.x + cos(a) * w * 0.5, top + w * 0.5 + sin(a) * w * 0.5))
	pts.append(Vector2(c.x + w * 0.5, bot))
	pts.append(Vector2(c.x - w * 0.5, bot))
	# these alphas are set to survive draw_backdrop's 0.42 veil, which the dressing is
	# drawn behind: at the value that looked right in isolation the window vanished
	draw_colored_polygon(pts, Color(cool.r, cool.g, cool.b, 0.14))
	draw_glow(Vector2(c.x, top + w * 0.55), w * 0.95, Color(cool.r, cool.g, cool.b, 0.26))
	# the frame: a mullion and two transoms, which is what makes it read as a WINDOW
	draw_line(Vector2(c.x, top + 6.0), Vector2(c.x, bot), Color(0.05, 0.07, 0.07, 0.9), 3.0)
	for k in 2:
		var ly := lerpf(top + w * 0.62, bot, (float(k) + 1.0) / 3.0)
		draw_line(Vector2(c.x - w * 0.5, ly), Vector2(c.x + w * 0.5, ly), Color(0.05, 0.07, 0.07, 0.9), 3.0)
	draw_line(Vector2(c.x - w * 0.5, bot), Vector2(c.x + w * 0.5, bot), Color(0.05, 0.07, 0.07, 0.9), 4.0)
	# the light on the floor: the same opening, sheared, as if cast
	draw_colored_polygon(PackedVector2Array([
		Vector2(c.x - w * 0.5, bot), Vector2(c.x + w * 0.5, bot),
		Vector2(c.x + w * 1.15, fy), Vector2(c.x + w * 0.05, fy)]),
		Color(cool.r, cool.g, cool.b, 0.10))


func draw_hedge(s: Vector2, y: float, x0: float, x1: float, h: float) -> void:
	# a garden hedge: overlapping dark discs along a run, so the backyard has a back
	var c := Color(0.08, 0.13, 0.08)
	var x := x0
	while x <= x1:
		var bump := h * (0.75 + 0.25 * sin(x * 0.06))
		draw_circle(Vector2(x, y - bump * 0.35), bump * 0.7, c)
		x += h * 0.42


func draw_washing_line(a: Vector2, b: Vector2, post_y: float) -> void:
	# the washing still out at dusk: a sagging line with two sheets stirring on it.
	# The sheets go down FIRST and the line over them, with a peg at each corner, so
	# the cloth hangs FROM the rope instead of floating near it. Both ends are TIED to
	# something (the tree at one end, this post at the other) - a rope beginning and
	# ending in mid-air was the whole reason the first version read as two grey boxes.
	draw_rect(Rect2(b.x - 2.5, b.y, 5.0, post_y - b.y), Color(0.15, 0.12, 0.10))
	draw_rect(Rect2(b.x - 9.0, b.y - 3.0, 18.0, 4.0), Color(0.15, 0.12, 0.10))
	for k in 2:
		var t := 0.30 + 0.34 * float(k)
		var top := a.lerp(b, t)
		top.y += sin(t * PI) * 12.0
		var sway := sin(atick() * 0.012 + float(k) * 2.0) * 5.0
		var col := Color(0.80, 0.76, 0.66, 0.72) if k == 0 else Color(0.72, 0.68, 0.66, 0.66)
		draw_colored_polygon(PackedVector2Array([
			top + Vector2(-13.0, 0.0), top + Vector2(13.0, 0.0),
			top + Vector2(15.0 + sway, 44.0), top + Vector2(-11.0 + sway, 44.0)]), col)
		draw_circle(top + Vector2(-11.0, 0.0), 2.2, Color(0.55, 0.42, 0.28))
		draw_circle(top + Vector2(11.0, 0.0), 2.2, Color(0.55, 0.42, 0.28))
	var n := 10
	for i in n:
		var t0 := float(i) / float(n)
		var t1 := float(i + 1) / float(n)
		var p0 := a.lerp(b, t0)
		var p1 := a.lerp(b, t1)
		p0.y += sin(t0 * PI) * 12.0
		p1.y += sin(t1 * PI) * 12.0
		draw_line(p0, p1, Color(0.42, 0.36, 0.30), 1.4)


func draw_shopfront(base: Vector2, w: float, h: float) -> void:
	# the shuttered shop the busker set up outside: a dark front, a striped awning, and
	# one warm window still lit inside it
	draw_rect(Rect2(base.x - w * 0.5, base.y - h, w, h), Color(0.09, 0.08, 0.10))
	var wy := base.y - h * 0.62
	draw_rect(Rect2(base.x - w * 0.32, wy, w * 0.40, h * 0.30), Color(1.0, 0.72, 0.34, 0.20))
	draw_rect(Rect2(base.x - w * 0.32, wy, w * 0.40, h * 0.30), Color(0.35, 0.24, 0.14), false, 2.0)
	var ay := base.y - h * 0.80
	var n := 7
	for i in n:
		var x0 := base.x - w * 0.5 + w * float(i) / float(n)
		var x1 := base.x - w * 0.5 + w * float(i + 1) / float(n)
		var col := Color(0.42, 0.13, 0.14) if i % 2 == 0 else Color(0.60, 0.56, 0.50)
		draw_colored_polygon(PackedVector2Array([
			Vector2(x0, ay), Vector2(x1, ay), Vector2(x1 + 6.0, ay + 26.0), Vector2(x0 + 6.0, ay + 26.0)]), col)
	draw_line(Vector2(base.x - w * 0.5 + 6.0, ay + 26.0), Vector2(base.x + w * 0.5 + 6.0, ay + 26.0),
		Color(0.20, 0.10, 0.09), 2.0)


func draw_crate(base: Vector2, w: float, h: float) -> void:
	# a wooden crate: the busker's own kit, stacked where the pitch is
	var body := Color(0.24, 0.17, 0.11)
	draw_rect(Rect2(base.x - w * 0.5, base.y - h, w, h), body)
	draw_rect(Rect2(base.x - w * 0.5, base.y - h, w, h), Color(0.34, 0.25, 0.16), false, 1.5)
	draw_line(Vector2(base.x - w * 0.5, base.y - h), Vector2(base.x + w * 0.5, base.y),
		Color(0.34, 0.25, 0.16), 1.2)


func draw_curtain_wall(s: Vector2, fy: float, top: float, base: Color, n: int) -> void:
	# a hung velvet back wall: alternating folds, kept very low in contrast so the
	# middle of the room has TEXTURE without ever competing with a prop crossing it
	var w := s.x / float(n)
	for i in n:
		var k := 0.5 + 0.5 * sin(float(i) * 1.9)
		var m := 0.62 + 0.52 * k
		draw_rect(Rect2(float(i) * w, top, w + 1.0, fy - top), Color(base.r * m, base.g * m, base.b * m))
	# the hem, where the cloth meets the boards
	draw_rect(Rect2(0.0, fy - 7.0, s.x, 7.0), Color(base.r * 0.45, base.g * 0.45, base.b * 0.45))


func draw_proscenium(s: Vector2, fy: float) -> void:
	# the gilded arch the whole picture hangs in: two piers and a shallow crown, with
	# a warm inner edge, drawn over the wings so it frames them too
	var gold := Color(0.72, 0.54, 0.26)
	var gold_hi := Color(0.94, 0.76, 0.42)
	var pw := s.x * 0.028
	var top := s.y * 0.11
	for side in 2:
		var x := 0.0 if side == 0 else s.x - pw
		draw_rect(Rect2(x, top, pw, fy - top), gold.darkened(0.45))
		draw_rect(Rect2(x + (pw - 4.0 if side == 0 else 0.0), top, 4.0, fy - top), gold)
		for k in 6:
			var yy := lerpf(top + 20.0, fy - 20.0, float(k) / 5.0)
			draw_circle(Vector2(x + pw * 0.5, yy), 3.4, gold_hi)
	draw_rect(Rect2(0.0, top - 12.0, s.x, 14.0), gold.darkened(0.45))
	draw_rect(Rect2(0.0, top, s.x, 4.0), gold)
	for k in 13:
		var cx2 := s.x * (float(k) + 0.5) / 13.0
		draw_circle(Vector2(cx2, top - 5.0), 3.4, gold_hi)


func draw_tiers(s: Vector2, fy: float, rows: int, col: Color, lit: float) -> void:
	# raked stands behind the stage: banked rows of seats climbing away, each row a
	# little darker and a little further back. Read as a full house from the front.
	for r in range(rows, 0, -1):
		var t := float(r) / float(rows)
		var y := fy - 14.0 - t * s.y * 0.20
		var hgt := s.y * 0.20 * t / float(rows) + 10.0
		var shade := 0.30 + 0.22 * (1.0 - t)
		draw_rect(Rect2(0.0, y, s.x, hgt), Color(col.r * shade, col.g * shade, col.b * shade))
		draw_line(Vector2(0.0, y), Vector2(s.x, y), Color(col.r, col.g, col.b, 0.22 * lit), 1.0)
		# heads along the front of the tier
		var n := 14 - r * 2
		for i in n:
			var hx := s.x * (float(i) + 0.5) / float(n) + float(r) * 9.0
			var a := 0.20 * lit * (1.0 - 0.15 * t)
			soft_disc(Vector2(fposmod(hx, s.x), y + 3.0), 4.0 - t * 1.2, Color(col.r + 0.3, col.g + 0.3, col.b + 0.3, a), 8)


func draw_truss(s: Vector2, y: float, col: Color) -> void:
	# a lighting truss across the top of the room: two chords, a zigzag web between
	# them, and the lamps hanging off it (the source the spotlight cone comes from)
	var dark := Color(col.r * 0.22, col.g * 0.22, col.b * 0.24)
	draw_rect(Rect2(0.0, y, s.x, 3.0), dark)
	draw_rect(Rect2(0.0, y + 15.0, s.x, 3.0), dark)
	var step := 64.0
	var x := 0.0
	var up := true
	while x < s.x:
		draw_line(Vector2(x, y + (2.0 if up else 16.0)), Vector2(x + step, y + (16.0 if up else 2.0)), dark, 2.0)
		up = not up
		x += step
	for i in 7:
		var lx := s.x * (float(i) + 0.5) / 7.0
		draw_colored_polygon(PackedVector2Array([
			Vector2(lx - 7.0, y + 18.0), Vector2(lx + 7.0, y + 18.0),
			Vector2(lx + 5.0, y + 30.0), Vector2(lx - 5.0, y + 30.0)]), dark)
		var fl := 0.6 + 0.4 * sin(atick() * 0.04 + float(i) * 1.3)
		soft_disc(Vector2(lx, y + 31.0), 4.0, Color(col.r, col.g, col.b, 0.55 * fl), 8)
		soft_disc(Vector2(lx, y + 31.0), 13.0, Color(col.r, col.g, col.b, 0.07 * fl), 10)


func draw_scoreboard(c: Vector2, w: float, h: float, col: Color, hang_y: float) -> void:
	# the board keeping score, high in the dark: a housing, a dot-matrix face, and a
	# slow shimmer travelling across it. Abstract on purpose - a real number up there
	# would be a second HUD competing with the rail that already carries the score.
	draw_rect(Rect2(c.x - w * 0.5 - 6.0, c.y - h * 0.5 - 6.0, w + 12.0, h + 12.0), Color(0.07, 0.08, 0.11))
	draw_rect(Rect2(c.x - w * 0.5 - 6.0, c.y - h * 0.5 - 6.0, w + 12.0, h + 12.0), Color(col.r, col.g, col.b, 0.22), false, 2.0)
	draw_rect(Rect2(c.x - w * 0.5, c.y - h * 0.5, w, h), Color(0.03, 0.04, 0.07))
	var cols := 15
	var rows := 4
	for i in cols:
		for j in rows:
			var px := c.x - w * 0.5 + w * (float(i) + 0.5) / float(cols)
			var py := c.y - h * 0.5 + h * (float(j) + 0.5) / float(rows)
			var wave := sin(float(i) * 0.5 - atick() * 0.03) * 0.5 + 0.5
			var on := fposmod(sin(float(i) * 12.9 + float(j) * 78.2) * 43758.5, 1.0) > 0.55
			var a := (0.30 + 0.45 * wave) if on else 0.05
			# SQUARE lamps: a dot matrix board really is square lamps, and 132 rects a
			# frame batch into almost nothing where 132 circles did not
			draw_rect(Rect2(px - 2.0, py - 2.0, 4.0, 4.0), Color(col.r, col.g, col.b, a))
	# hung off the truss above it: two visible hangers, so the board reads as rigged
	# into the room rather than as a panel floating in the middle of the frame
	for sgn in [-1.0, 1.0]:
		var hx: float = c.x + sgn * w * 0.32
		draw_line(Vector2(hx, hang_y), Vector2(hx, c.y - h * 0.5 - 6.0), Color(0.10, 0.11, 0.14), 3.0)


func draw_jumbotron(c: Vector2, w: float, h: float, col: Color) -> void:
	# a big screen either side of the arena, showing the act back to the back rows:
	# a bright frame, a soft picture, and the light it throws into the room
	draw_circle(c, w * 0.8, Color(col.r, col.g, col.b, 0.03))
	draw_rect(Rect2(c.x - w * 0.5 - 5.0, c.y - h * 0.5 - 5.0, w + 10.0, h + 10.0), Color(0.06, 0.05, 0.08))
	draw_rect(Rect2(c.x - w * 0.5, c.y - h * 0.5, w, h), Color(col.r * 0.18, col.g * 0.16, col.b * 0.20))
	# a suggestion of the performer on the screen, plus scanline shimmer
	draw_circle(Vector2(c.x, c.y - h * 0.12), h * 0.13, Color(col.r, col.g, col.b, 0.30))
	draw_colored_polygon(PackedVector2Array([
		Vector2(c.x - h * 0.22, c.y + h * 0.42), Vector2(c.x - h * 0.13, c.y + h * 0.02),
		Vector2(c.x + h * 0.13, c.y + h * 0.02), Vector2(c.x + h * 0.22, c.y + h * 0.42)]),
		Color(col.r, col.g, col.b, 0.22))
	for j in 9:
		var ly := c.y - h * 0.5 + h * (float(j) + 0.5) / 9.0
		draw_line(Vector2(c.x - w * 0.5, ly), Vector2(c.x + w * 0.5, ly), Color(0.0, 0.0, 0.0, 0.10), 1.0)
	var sh := fposmod(atick() * 0.004, 1.0)
	draw_rect(Rect2(c.x - w * 0.5, c.y - h * 0.5 + h * sh, w, 6.0), Color(1.0, 1.0, 1.0, 0.04))
	draw_rect(Rect2(c.x - w * 0.5 - 5.0, c.y - h * 0.5 - 5.0, w + 10.0, h + 10.0), Color(col.r, col.g, col.b, 0.28), false, 2.0)


func draw_wall_clock(c: Vector2, r: float, col: Color) -> void:
	# the house clock at The Midnight Show, reading exactly midnight. Dim by design:
	# this is the venue built to make the Glow-in-the-Dark Kit matter.
	draw_circle(c, r * 1.5, Color(col.r, col.g, col.b, 0.025))
	icon_disc(c, r, Color(0.05, 0.07, 0.06, 0.9), Color(col.r, col.g, col.b, 0.30), 2.0)
	for i in 12:
		var a := TAU * float(i) / 12.0
		var d := Vector2(sin(a), -cos(a))
		draw_line(c + d * (r * 0.82), c + d * (r * 0.94), Color(col.r, col.g, col.b, 0.22), 1.4)
	draw_line(c, c + Vector2(0.0, -r * 0.62), Color(col.r, col.g, col.b, 0.42), 2.0)   # both hands
	draw_line(c, c + Vector2(0.0, -r * 0.86), Color(col.r, col.g, col.b, 0.42), 1.6)   # ...at twelve
	draw_circle(c, 2.2, Color(col.r, col.g, col.b, 0.45))


# draw_candle WAS DELETED HERE (2026-08-14) with its two call sites in draw_venue_foreground:
# the Midnight Show's backdrop paints a room full of candles standing on its tables, and these
# two stood in the air beside them. See the note at the top of draw_venue_foreground.


func draw_theatre_wings(s: Vector2, fy: float) -> void:
	# red velvet wings at both edges and a swagged valance across the top
	var ww := s.x * 0.085
	for side in [0.0, 1.0]:
		var x0 := 0.0 if side == 0.0 else s.x - ww
		draw_gradient_h(Rect2(x0, 0, ww, fy), Color(0.30, 0.05, 0.08) if side == 0.0 else Color(0.13, 0.02, 0.04),
			Color(0.13, 0.02, 0.04) if side == 0.0 else Color(0.30, 0.05, 0.08), 8)
		for k in 4:
			var fx := x0 + ww * (float(k) + 0.5) / 4.0
			draw_rect(Rect2(fx - 2.0, 0, 4.0, fy), Color(0.09, 0.015, 0.03, 0.8))
	var vh := s.y * 0.075
	draw_rect(Rect2(0, 0, s.x, vh), Color(0.30, 0.05, 0.08))
	for i in 9:
		var cx := s.x * (float(i) + 0.5) / 9.0
		draw_arc(Vector2(cx, vh * 0.2), s.x / 18.0, 0.35, PI - 0.35, 18, Color(0.14, 0.02, 0.04), vh * 0.5, true)
	draw_line(Vector2(0, vh + 2.0), Vector2(s.x, vh + 2.0), Color(0.85, 0.65, 0.3, 0.5), 2.0)


func draw_theatre_boxes(s: Vector2, fy: float) -> void:
	# A BOX either side, tucked against the wings above head height: a gilded balcony
	# rail on a draped front, a dark opening behind it, and two or three silhouetted
	# heads leaning on the rail. This is the single thing that turns "a stage with
	# curtains" into "a stage in a ROOM with people in it", and it costs a dozen draws.
	var ww := s.x * 0.085
	var bw := s.x * 0.105
	var by := s.y * 0.20
	var bh := s.y * 0.20
	for side in [0.0, 1.0]:
		var bx := ww - bw * 0.16 if side == 0.0 else s.x - ww - bw * 0.84
		# the opening: a recess with a lit velvet back. It has to be LIGHTER than the
		# curtain wall behind it, not darker - a dark rectangle on a dark drape is a
		# hole, and the people in it disappear with it (the same mistake the money hat's
		# cutaway interior had to be rescued from)
		draw_rect(Rect2(bx, by, bw, bh), Color(0.09, 0.03, 0.045, 0.98))
		draw_gradient_v(Rect2(bx + 3.0, by + 3.0, bw - 6.0, bh * 0.62), Color(0.34, 0.09, 0.11),
			Color(0.13, 0.03, 0.05), 8)
		draw_glow(Vector2(bx + bw * 0.5, by + bh * 0.34), bw * 0.62, Color(1.0, 0.72, 0.36, 0.10))
		# the people in it, leaning on the rail - silhouetted AGAINST that lit back
		for hcount in 3:
			var hx := bx + bw * (0.26 + 0.24 * float(hcount))
			var hy := by + bh * 0.50 + sin(atick() * 0.02 + float(hcount) * 1.7 + side * 2.0) * 1.4
			draw_rect(Rect2(hx - bw * 0.085, hy + bw * 0.02, bw * 0.17, bw * 0.12), Color(0.07, 0.03, 0.04))
			draw_circle(Vector2(hx, hy), bw * 0.062, Color(0.07, 0.03, 0.04))
		# the box front: a draped panel under a gilded rail, with a swag along it
		draw_rect(Rect2(bx, by + bh * 0.60, bw, bh * 0.40), Color(0.24, 0.05, 0.07))
		draw_rect(Rect2(bx, by + bh * 0.58, bw, 3.0), Color(0.78, 0.60, 0.30))
		for k in 4:
			var sx := bx + bw * (float(k) + 0.5) / 4.0
			draw_arc(Vector2(sx, by + bh * 0.62), bw / 8.0, 0.3, PI - 0.3, 12, Color(0.80, 0.62, 0.32, 0.55), 2.0, true)
		draw_rect(Rect2(bx, by, bw, bh), Color(0.55, 0.42, 0.22, 0.45), false, 2.0)
		# a sconce burning on the pier beside the box
		var sc_x := bx + (bw + 12.0 if side == 0.0 else -12.0)
		var sc_y := by + bh * 0.30
		var fl := 0.75 + 0.25 * sin(atick() * 0.07 + side * 3.0)
		draw_glow(Vector2(sc_x, sc_y), 34.0, Color(1.0, 0.70, 0.34, 0.16 * fl))
		draw_rect(Rect2(sc_x - 2.0, sc_y, 4.0, 16.0), Color(0.62, 0.48, 0.24))
		draw_circle(Vector2(sc_x, sc_y - 4.0), 5.0, Color(1.0, 0.78, 0.40, 0.85 * fl))
		draw_circle(Vector2(sc_x, sc_y - 5.5), 2.4, Color(1.0, 0.96, 0.80, 0.95 * fl))


func draw_footlights(s: Vector2, fy: float) -> void:
	# the row of shielded lamps along the lip of the stage, throwing UP. Every real
	# theatre has them and they are the reason a stage performer is lit from below at
	# all - so this also quietly explains the warm underlight the whole scene uses.
	# they sit ABOVE the floor line, not on it: the boards are painted after the
	# dressing, so anything drawn at fy is buried under them
	var n := 11
	var ly := fy - 13.0
	for i in n:
		var lx := s.x * (float(i) + 0.5) / float(n)
		var fl := 0.72 + 0.28 * sin(atick() * 0.05 + float(i) * 0.9)
		draw_glow(Vector2(lx, ly - 4.0), 34.0, Color(1.0, 0.74, 0.36, 0.13 * fl))
		# the shield, a little hood open toward the stage
		draw_colored_polygon(PackedVector2Array([
			Vector2(lx - 7.0, ly + 7.0), Vector2(lx + 7.0, ly + 7.0),
			Vector2(lx + 5.0, ly - 1.0), Vector2(lx - 5.0, ly - 1.0)]), Color(0.22, 0.14, 0.10))
		draw_circle(Vector2(lx, ly - 1.0), 3.6, Color(1.0, 0.80, 0.42, 0.9 * fl))
		draw_circle(Vector2(lx, ly - 1.0), 1.7, Color(1.0, 0.97, 0.86, fl))


func draw_circus_canopy(s: Vector2) -> void:
	# striped tent cloth fanning down from the peak of the frame
	var top := Vector2(s.x * 0.5, -s.y * 0.24)
	var n := 12
	var hemy := s.y * 0.15
	for i in n:
		var a0 := lerpf(-s.x * 0.62, s.x * 0.62, float(i) / float(n))
		var a1 := lerpf(-s.x * 0.62, s.x * 0.62, float(i + 1) / float(n))
		var col := Color(0.42, 0.11, 0.12) if i % 2 == 0 else Color(0.45, 0.42, 0.38)
		draw_colored_polygon(PackedVector2Array([top,
			Vector2(s.x * 0.5 + a0, hemy + absf(a0) * 0.06),
			Vector2(s.x * 0.5 + a1, hemy + absf(a1) * 0.06)]), col)
	for i in n + 1:
		var hx := s.x * 0.5 + lerpf(-s.x * 0.62, s.x * 0.62, float(i) / float(n))
		draw_circle(Vector2(hx, hemy + absf(hx - s.x * 0.5) * 0.06), 3.0, Color(0.85, 0.7, 0.4, 0.5))


#endregion

#region JUGGLER FIGURE DRAWING
func draw_juggler(s: Vector2) -> void:
	var cx := s.x * 0.5
	# THE COSTUME IS CHOSEN, NOT ASSUMED (the tailor). Defaults to the stage he is standing
	# on, which is what this always did.
	var v := costume_palette()
	var skin := Color(0.87, 0.64, 0.45)
	var hair := Color(0.28, 0.16, 0.11)
	var suit: Color = v["suit"]         # costume changes with the venue
	var suit_dk: Color = v["suit_dk"]
	var vest: Color = v["vest"]
	var collar: Color = v["collar"]
	var accent: Color = v["glow"]
	# THE WHOLE COSTUME IS THE KIT (2026-07-27, Louis: "i want the glow in the dark
	# costume to look way better: it should be a costume that is pretty much completely
	# glow in the dark"). It used to be six strips of tape laid over a near-black suit,
	# which said "this juggler has some tape on him", not "this juggler glows".
	#
	# Done by RECOLOURING AT SOURCE rather than by paint-overs: swap the four costume
	# colours here and every piece the wardrobe already draws - lapels, cummerbund,
	# buttons, cuffs, tails, trouser stripe - comes out in phosphor, in its right shape,
	# for free. Drawing a second glowing figure on top would have meant maintaining two
	# copies of the same costume and risking the one thing that must never drift (the
	# figure's stance and proportions). The values are still a LADDER - deep phosphor
	# suit, brighter vest, near-white collar - because a costume lit to one flat green
	# is a silhouette, not a costume. Skin and hair stay their own colours: the man is
	# not glowing, his clothes are.
	if glow_suit_lit():
		suit = Color(0.20, 0.72, 0.40)
		suit_dk = Color(0.10, 0.42, 0.24)
		vest = Color(0.78, 1.0, 0.86)
		collar = Color(0.90, 1.0, 0.94)
		accent = Color(0.70, 1.0, 0.80)
	var button := Color(0.34, 0.20, 0.11)

	# the eight-head canon, so the in-play juggler reads as a real adult person:
	# head one eighth of the height, the crotch
	# at the vertical midpoint, a drawn-in waist. H is the head unit off the floor line.
	var floor_y := stage_floor_y()
	var H := fig_stage_H(s)

	# body language: the feet stay planted but the trunk BREATHES, and a fresh catch
	# is absorbed with a soft knee-dip of the whole upper body, so the figure reads
	# as a performer riding the rhythm instead of a stand for two arms
	var dip := 1.2 + sin(float(tick) * 0.03) * 1.4
	for hh in [LEFT, RIGHT]:
		var cfd := tick - int(catch_flash[hh])
		if cfd >= 0 and cfd < 12:
			dip = maxf(dip, 5.0 * (1.0 - float(cfd) / 12.0))

	var ys := fig_ys(cx, floor_y, H, dip)
	var hip_y: float = ys["hip"]
	var knee_y: float = ys["knee"]
	var waist_y: float = ys["waist"]
	var chest_y: float = ys["chest"]
	var shoulder_y: float = ys["shoulder"]
	var head: Vector2 = ys["head"]
	var head_r: float = ys["head_r"]

	# a soft ground shadow so the figure stands ON the stage instead of floating (drawn
	# BEFORE the spin transform, so it stays put on the ground while the body turns)
	draw_shadow(Vector2(cx, floor_y + 2.0), 96.0)
	# ...and, wearing the Kit, the light the costume is throwing OFF. This is what makes
	# the recolour above read as EMITTING rather than as a man in a green suit: a lit
	# thing spills onto its surroundings, and without that spill any colour is just
	# paint. Two pools, torso and legs, drawn under the body so nothing is washed out.
	if glow_suit_lit():
		var bfl := 0.88 + 0.12 * sin(atick() * 0.05)
		draw_glow(Vector2(cx, (shoulder_y + hip_y) * 0.5), 5.4 * H, Color(GLOW_PHOS.r, GLOW_PHOS.g, GLOW_PHOS.b, 0.30 * bfl))
		draw_glow(Vector2(cx, (hip_y + floor_y) * 0.5), 3.4 * H, Color(GLOW_PHOS.r, GLOW_PHOS.g, GLOW_PHOS.b, 0.20 * bfl))

	# a live Spin turns the WHOLE figure about its vertical axis. A 2D pirouette is faked
	# by scaling the body width by cos(turn angle) about the centreline: full width facing
	# front, a thin sliver at the profile, mirrored width facing away. facing_back then
	# swaps the face for the back of the head. In sequence this reads as a real turn.
	# --charback: hold the away-facing pose so char/torso_back_* and char/head_back can be
	# derived. Mid-Spin is otherwise a handful of frames out of a whole turn, which is not
	# something a reference capture can reliably land on. No width scale is applied: the
	# art wants the figure at full width, and the game applies the pirouette's squash
	# itself at draw time.
	var facing_back := _charback and _charref
	var spin_on := spinning()
	var painted_turn := spin_on and fig_design_on() and fig_spin_on()
	var sx := 1.0                                 # body width scale: 1 front, ~0 profile, -1 back
	if spin_on and not painted_turn:
		# THE SQUASH IS THE FALLBACK NOW, not the mechanism. It is still exactly right for
		# the traced juggler, who is drawn in code and has no other view of himself; a
		# painted performer has eight, so see draw_figure_spin.
		var ang := fig_spin_turn() * TAU          # exactly one full turn across the spin
		sx = cos(ang)
		facing_back = sx < 0.0
		if absf(sx) < 0.14:                        # never collapse fully to a line at the profile
			sx = 0.14 if sx >= 0.0 else -0.14
		draw_set_transform(Vector2(cx * (1.0 - sx), 0.0), 0.0, Vector2(sx, 1.0))

	# THE BODY, drawn by the ONE renderer every screen shares (2026-08-06, Louis: "make
	# sure that the character, objects etc look the same everywhere in the game, from
	# titlescreen to shop, to performance"). Everything from the trousers up to the hat
	# used to exist TWICE - once here and once in draw_mini_juggler - and the second copy
	# had never been carried across to the sprite seam, so the tailor's mirror and the
	# skills preview were still showing a smooth vector man while the stage showed a
	# pixel-art one. Two copies of a figure is exactly what the wardrobe pass refused to
	# write and it was already here. See draw_figure_body.
	#
	# gaze_track (F9 experiment): aim the eyes at whichever prop is due to land soonest -
	# the very ball hand_target already has its (empty) hand travelling out to meet. Just
	# a scan of `balls`, no different in spirit from hand_target's own `inc` search. It
	# stays with the CALLER rather than moving into the shared renderer, because it is the
	# one thing on the figure that reads the live simulation - a mirror has no next catch.
	var gaze := Vector2.ZERO
	if exp_on("gaze_track") and not facing_back:
		var watch: Ball = null
		for b in balls:
			if b.state == STATE_FLIGHT and (watch == null or b.land_tick < watch.land_tick):
				watch = b
		if watch != null:
			gaze = flight_pos(watch) - head
	draw_figure_body(cx, H, ys,
		{"suit": suit, "suit_dk": suit_dk, "vest": vest, "collar": collar,
			"accent": accent, "skin": skin, "hair": hair, "button": button},
		facing_back, spin_on, sx, gaze)
	if spin_on and not painted_turn:                                       # back to the body width-scale for the arms
		draw_set_transform(Vector2(cx * (1.0 - sx), 0.0), 0.0, Vector2(sx, 1.0))

	# arms follow the hands via a 2-bone solve, so the choreography animates
	# (their shoulder roots ride the same body dip as the trunk). The wardrobe's cuff
	# is drawn INSIDE draw_arm, on the solved wrist, so it can never float free of the
	# arm the way a body-relative guess does.
	# the cuff is the venue's OWN collar colour, never a fixed white: the Midnight
	# Show's whole point is a costume that nearly vanishes, and a hard white cuff
	# would light the performer straight back up
	var cuff := collar
	var sleeve := suit
	# THE ANIMATION HAS ITS OWN ARMS, so the IK ones must not be drawn over them. This is
	# the line that actually answers "these old overlapping arms look awful": with a strip
	# loaded, draw_arm is not called at all and the two crossing capsules are simply gone.
	# The HANDS still are (draw_hand below), because a hand holds props and shows a catch
	# flash, and both of those are gameplay feedback rather than anatomy.
	if fig_anim_live():
		draw_hand(LEFT)
		draw_hand(RIGHT)
		return
	if fig_design_on():
		# THE ARMS ARE THE DESIGN'S OWN CLOTH. They are drawn live rather than painted, so
		# without this a generated performer wears his coat on his body and the venue's
		# costume colour on his sleeves - the exact seam this whole feature exists to
		# avoid. fit_char_design.py samples both colours off the painting before it cuts
		# the arms off, which is the only moment they still exist to be sampled.
		sleeve = fig_design_col("sleeve", suit)
		cuff = fig_design_col("cuff", collar)
	draw_arm(shoulder_pos(LEFT) + Vector2(0, dip), hpos[LEFT], LEFT, skin, sleeve, cuff)
	draw_arm(shoulder_pos(RIGHT) + Vector2(0, dip), hpos[RIGHT], RIGHT, skin, sleeve, cuff)

	# hands (and any held balls) on top of the arms
	draw_hand(LEFT)
	draw_hand(RIGHT)

	# THE PIPING, over the now-glowing costume. These were the whole effect once (six
	# strips of tape on a near-black suit); with the costume itself in phosphor they do
	# the job good piping does on real evening dress - they pick out the shoulder line,
	# the cummerbund and the outseam, so the figure has EDGES at a distance instead of
	# being one bright mass. Brighter than the cloth they sit on, or they vanish into it.
	if glow_suit_lit():
		# ONLY the trouser outseams are left of the old tape. The two horizontal runs
		# (across the shoulders, round the waist) were struck straight across the figure
		# rather than along any seam, so against a costume that now glows by itself they
		# read as bars laid over the man. The two arm runs were worse: they were drawn
		# shoulder-to-HAND as one straight chord while the arm itself bends at the elbow,
		# so the line left the sleeve and crossed open air - a wire, not piping. The
		# sleeve is lit cloth now and needs no help; the bare forearm reading as skin is
		# correct, because he is wearing a glowing costume, not covered in phosphor.
		#
		# AND THE LEG RUN WAS MAKING THE ARMS' OWN MISTAKE (2026-07-28, Louis: "make the
		# glow in the dark legs look better"). It was hip -> floor as ONE straight chord
		# while the leg is two tapering capsules with a knee between them: measured against
		# the shapes actually drawn above, the seam started 0.13H inside the thigh and
		# finished 0.03H OUTSIDE the calf, so a line meant to be a seam left the cloth and
		# ended in open air beside the ankle. It is a POLYLINE now, with a vertex at the
		# knee, and every x is derived from the capsule centres and half-widths right
		# there in the leg block rather than eyeballed - the thigh is 0.46H wide about
		# cx±0.40H, the calf 0.30H about cx±0.34H, so the outer face is 0.63H then 0.49H
		# then 0.42H, and the seam sits just inside each.
		#
		# A TURN-UP AT THE ANKLE is the other half of the fix, and it is the mark that
		# gives the leg an END. A single stripe down a limb reads as a stick; a bright band
		# across the hem reads as a trouser over a shoe, which is what is actually there.
		var seam_l := PackedVector2Array([
			Vector2(cx - 0.50 * H, hip_y + 0.02 * H),
			Vector2(cx - 0.40 * H, knee_y),
			Vector2(cx - 0.35 * H, floor_y - 0.22 * H)])
		var seam_r := PackedVector2Array([
			Vector2(cx + 0.50 * H, hip_y + 0.02 * H),
			Vector2(cx + 0.40 * H, knee_y),
			Vector2(cx + 0.35 * H, floor_y - 0.22 * H)])
		draw_glow_seam(seam_l, 2.0, 1.0)
		draw_glow_seam(seam_r, 2.0, 1.0)
		# ...and the turn-up sits at whatever the trouser's real hem is: at the ankle bare,
		# or at the top of a boot shaft when the wardrobe has put one there. A band drawn
		# across the middle of a boot is a band drawn on the wrong garment.
		var hem_y := floor_y - (0.54 if wearing("boots") else 0.21) * H
		for hemx in [-0.34 * H, 0.34 * H]:
			draw_glow_seam(PackedVector2Array([
				Vector2(cx + hemx - 0.15 * H, hem_y),
				Vector2(cx + hemx + 0.15 * H, hem_y)]), 2.4, 0.9)
	# done with the (possibly spinning) figure: return to screen space, then lay the
	# sweeping motion streaks over the top so the turn reads as fast
	if spin_on:
		draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
		draw_spin_streaks(Vector2(cx, (shoulder_y + hip_y) * 0.5))


func fig_ys(cx: float, floor_y: float, H: float, dip: float) -> Dictionary:
	# THE EIGHT-HEAD CANON, in one place. Head one eighth of the height, the crotch at the
	# vertical midpoint, a drawn-in waist - which is what makes the juggler read as a real
	# adult rather than a game mascot, and is the single thing about him that must never
	# drift. It was written out twice (draw_juggler and draw_mini_juggler) with the same
	# seven numbers copied by hand, which is a stance waiting to be reshaped by a typo in
	# a screen nobody was looking at.
	#
	# `dip` is the body language - a breath, plus a knee-absorb on a fresh catch - and it
	# rides the trunk in DECREASING amounts down the body (full at the shoulders, a
	# quarter at the hips, none at the knees) because that is how a standing person
	# absorbs: the feet stay planted. A preview passes 0 and gets the same figure at rest.
	return {
		"floor": floor_y,
		"hip": floor_y - 4.0 * H + dip * 0.25,
		"knee": floor_y - 2.0 * H,
		"waist": floor_y - 5.0 * H + dip * 0.55,
		"chest": floor_y - 6.0 * H + dip * 0.8,
		"shoulder": floor_y - 6.72 * H + dip,
		"head": Vector2(cx, floor_y - 7.5 * H + dip),
		"head_r": 0.52 * H,
	}


const FIG_HAND_LINE := 4.099   # head units from the resting hand line down to the floor.
                               # PV_FLOOR / PV_HEAD, kept as a PROPORTION rather than the
                               # two preview pixel constants, so it still means the same
                               # thing after fig_scale_H has snapped H to another size.


func fig_stage_H(s: Vector2) -> float:
	# The head unit the STAGE figure is drawn at, and therefore the size every char/*
	# sprite was traced at. Every other screen's figure is a whole multiple of this.
	return s.y * 0.056


func fig_scale_H(want: float) -> float:
	# SNAP A WANTED FIGURE HEIGHT TO ONE THE SPRITES CAN ACTUALLY BE DRAWN AT.
	#
	# The body is per-region sprites (art_blit_regions), authored by tracing the figure at
	# the stage's own H. art_blit_size then FITS that texture to whatever box it is given,
	# so a caller that picks its H by fitting a panel - which is exactly what the tailor's
	# mirror did, solving k from the panel height and landing on 1.148x the stage size -
	# gets each source pixel drawn across 2.3 screen pixels. Some rows come out two
	# pixels tall and some three, and the whole man crawls and shimmers. It is the one
	# failure pixel art cannot survive, and it is invisible in the code that causes it.
	#
	# So the ratio to the stage figure is snapped to a multiple of a HALF. A half is legal
	# and a quarter is not, and that is arithmetic rather than taste: the stage draws one
	# art pixel as ART_PIXEL (2) screen pixels, so a half-size figure draws it as 1 and a
	# one-and-a-half-size figure as 3 - both whole numbers. 1.25x would be 2.5 and is the
	# mush this exists to prevent. The caller gets a figure a little off the size it asked
	# for, and a crisp one; the alternative is the size it asked for and a shimmering one.
	var base := fig_stage_H(get_viewport_rect().size)
	var ratio := maxf(round(want / maxf(base, 0.001) * 2.0) * 0.5, 0.5)
	return base * ratio


func fig_preview_k(want: float) -> float:
	# THE k A CALLER WILL ACTUALLY GET, so it can place the hands and the floor in
	# agreement with the body it is about to be handed. The tailor solves its k from the
	# panel height and then uses that same k for PV_FLOOR and PV_OUTER; if only the body
	# were snapped, the hands would stay out at the unsnapped reach and the arms would
	# come out 15% too long - which is precisely what happened on the first attempt, and
	# it reads as a different, lankier man rather than as a scaling bug.
	return fig_scale_H(PV_HEAD * want) / PV_HEAD


func draw_figure_body(cx: float, H: float, ys: Dictionary, cols: Dictionary,
		facing_back: bool, spin_on: bool, sx: float, gaze: Vector2,
		px: float = ART_PIXEL, want_l: float = -1.0, want_r: float = -1.0) -> void:
	# THE PERFORMER, AND THERE IS ONLY ONE OF HIM. Trousers, boots, neck, jacket, the
	# wardrobe pass, the head and whatever is on it - everything between the floor and the
	# top hat, for every screen in the game. The arms and hands are the caller's, because
	# only the stage has a live simulation to put them anywhere interesting.
	#
	# WHY IT IS A FUNCTION AND NOT A SECOND COPY. This block was duplicated into
	# draw_mini_juggler when the preview was written, and the two then drifted for exactly
	# as long as the fork has existed: draw_juggler was moved onto the sprite seam
	# (art_blit_regions for the torso and legs, a traced head, a rasterised arm) and the
	# copy was not. The result was a game whose main character was pixel art in the act
	# and smooth vector shapes in the tailor's mirror, in the one room whose entire
	# purpose is showing you what you look like.
	#
	# EVERY LENGTH IS A MULTIPLE OF H, so the same code serves both sizes. What it does
	# NOT do is let a caller pick H freely - see fig_scale_H: a region sprite blitted at a
	# fractional number of screen pixels per art pixel is mush, and that is the one thing
	# pixel art cannot survive.
	var floor_y: float = ys["floor"]
	# A GENERATED DESIGN REPLACES THIS WHOLE FUNCTION with one picture. It goes first, so
	# nothing below it can half-apply: the wardrobe's hat, the boots and the costume regions
	# are all things a painted figure already has, and drawing them over it would be a man
	# wearing two coats. The arms and hands are still the caller's, and still the game's.
	if fig_design_on():
		# A LIVE SPIN IS A PAINTED TURNAROUND, NOT A SQUASH (2026-08-15, Louis: "use
		# pixellab to animate the spin animation"). It goes before everything else the
		# design branch does, because for the third of a second the turn lasts the frame IS
		# the figure: the hat, the glasses and the helmet all hang off head landmarks
		# measured on the FRONT view, and there is no honest place to put a top hat on a
		# man seen from behind. They come back the moment he faces forward again.
		if spin_on and fig_spin_on():
			draw_figure_spin(cx, floor_y, venue_figure_tint(), px, fig_spin_turn())
			return
		# A PAINTED FIGURE IS A FIXED-SIZE SPRITE and used to ignore `H` completely, so a
		# PREVIEW asking for a small performer got a full stage-sized one that ran straight
		# out of its panel - which is most of why the skills screen's mini juggler looked
		# wrong. `px` is screen pixels per art pixel: ART_PIXEL (2) on stage, and 1 for a
		# preview, which is HALF SIZE EXACTLY and therefore still lossless. Nothing between
		# is offered, because nothing between is a whole number of screen pixels.
		draw_figure_design(cx, floor_y, venue_figure_tint(), px, want_l, want_r)
		# A DESIGN CANNOT WEAR THE COSTUME, BUT IT CAN WEAR A CROWN. The coat is painted, so
		# the wardrobe's jacket/waistcoat/boots have nothing to attach to - but the hat, the
		# helmet and the glasses sit on a head, and the fitter measured where that is. This
		# matters because THE TAILOR IS A SHOP: it says "trying it on" under the mirror, and
		# a mirror that shows nothing when you buy a top hat is not a style limitation, it
		# is a broken screen. The crown is drawn in the design's own accent so it belongs to
		# the outfit rather than to the venue.
		var fh := fig_design_height(px)
		var head_c := Vector2(cx, floor_y - (1.0 - float(fig_design.get("head_cy", 0.06))) * fh)
		var head_rr := float(fig_design.get("head_r", 0.055)) * fh
		var acc := fig_design_col("cuff", cols["accent"])
		if wearing("glasses") and not facing_back:
			draw_worn_glasses(head_c, head_rr, acc)
		if wearing("hat"):
			draw_top_hat(head_c, head_rr, fig_design_col("sleeve", cols["suit_dk"]), acc, acc)
		elif wearing("helmet"):
			draw_worn_helmet(head_c, head_rr, acc, acc)
		return
	var hip_y: float = ys["hip"]
	var knee_y: float = ys["knee"]
	var waist_y: float = ys["waist"]
	var chest_y: float = ys["chest"]
	var shoulder_y: float = ys["shoulder"]
	var head: Vector2 = ys["head"]
	var head_r: float = ys["head_r"]
	var suit: Color = cols["suit"]
	var suit_dk: Color = cols["suit_dk"]
	var vest: Color = cols["vest"]
	var collar: Color = cols["collar"]
	var accent: Color = cols["accent"]
	var skin: Color = cols["skin"]
	var hair: Color = cols["hair"]
	var button: Color = cols["button"]
	# legs: a narrow pelvis, thighs tapering to the knee, calves to the ankle, shoes
	var shoe := Color(0.20, 0.12, 0.09)
	# THE TROUSERS ARE THEIR OWN RUNG OF THE LADDER (2026-07-28, Louis: "make the glow in
	# the dark legs look better"). They were drawn in `suit_dk` - which is the JACKET's
	# shadow, picked as a shadow, and under the Kit that put the legs at 0.10/0.42/0.24
	# against a vest at 0.78/1.0/0.86. The man's whole lower half was therefore the
	# darkest thing on a costume whose entire selling point is that it glows, which is
	# why the legs read as two stumps with a bright line down each. The value ladder in
	# the recolour above covers suit/vest/collar and never had a trouser rung; it does now.
	var trouser := suit_dk
	if glow_suit_lit():
		trouser = Color(0.17, 0.60, 0.34)
	# SEAM: pelvis + both legs, one region, tinted with the live trouser colour. The box is
	# derived from the same constants the capsules below use - the widest point is the
	# pelvis at +/-0.62H, and the lowest is the shin capsule's bottom cap, which reaches
	# 0.2H past its endpoint at floor_y - 0.16H.
	var leg_top := hip_y - 0.3 * H
	var leg_box := Rect2(cx - 0.62 * H, leg_top, 1.24 * H, (floor_y + 0.05 * H) - leg_top)
	if not art_blit_regions("char/legs", leg_box, [["trouser", trouser]]):
		draw_colored_polygon(PackedVector2Array([   # pelvis
			Vector2(cx - 0.62 * H, hip_y - 0.3 * H), Vector2(cx + 0.62 * H, hip_y - 0.3 * H),
			Vector2(cx + 0.56 * H, hip_y + 0.12 * H), Vector2(cx - 0.56 * H, hip_y + 0.12 * H)]), trouser)
		draw_capsule(Vector2(cx - 0.4 * H, hip_y), Vector2(cx - 0.34 * H, knee_y), 0.46 * H, 0.3 * H, trouser)
		draw_capsule(Vector2(cx - 0.34 * H, knee_y), Vector2(cx - 0.32 * H, floor_y - 0.16 * H), 0.3 * H, 0.2 * H, trouser)
		draw_capsule(Vector2(cx + 0.4 * H, hip_y), Vector2(cx + 0.34 * H, knee_y), 0.46 * H, 0.3 * H, trouser)
		draw_capsule(Vector2(cx + 0.34 * H, knee_y), Vector2(cx + 0.32 * H, floor_y - 0.16 * H), 0.3 * H, 0.2 * H, trouser)
	if wearing("boots"):
		# WARDROBE: STAGE BOOTS replace the two flat shoe ellipses - see draw_stage_boot
		draw_stage_boot(Vector2(cx - 0.34 * H, floor_y), H, -1.0, shoe, collar, accent)
		draw_stage_boot(Vector2(cx + 0.34 * H, floor_y), H, 1.0, shoe, collar, accent)
	else:
		fill_ellipse(Vector2(cx - 0.34 * H, floor_y - 0.1 * H), 0.52 * H, 0.2 * H, shoe)
		fill_ellipse(Vector2(cx + 0.34 * H, floor_y - 0.1 * H), 0.52 * H, 0.2 * H, shoe)

	# neck: a short skin column from just under the jaw down past the collar line, so a
	# real (short) neck shows between the head and the coat instead of the head sitting
	# straight on the shoulders
	draw_colored_polygon(PackedVector2Array([
		Vector2(cx - 0.18 * H, head.y + head_r - 0.05 * H), Vector2(cx + 0.18 * H, head.y + head_r - 0.05 * H),
		Vector2(cx + 0.23 * H, shoulder_y + 0.14 * H), Vector2(cx - 0.23 * H, shoulder_y + 0.14 * H)]), skin)

	# jacket: one tapered silhouette (sloped shoulders, a drawn-in waist, a slight hip
	# flare). Its neckline sits at the shoulders (not up near the chin) so the neck shows.
	# SEAM: the whole torso, per costume region. The box spans the jacket silhouette's own
	# extremes - +/-0.92H at the shoulder line, from shoulder_y - 0.04H down to
	# hip_y + 0.15H - so it is derived from the polygon below rather than measured off a
	# screenshot. FRONT AND BACK ARE SEPARATE KEY SETS for the same reason head/head_back
	# are: mid-spin the plain back of the coat is a different picture, not a mirrored one.
	var torso_top := shoulder_y - 0.04 * H
	var torso_box := Rect2(cx - 0.92 * H, torso_top, 1.84 * H, (hip_y + 0.15 * H) - torso_top)
	var torso_regions: Array = ([["suit", suit], ["collar", collar], ["vest", vest],
			["button", button]] if not facing_back else [["suit", suit], ["collar", collar]])
	if not art_blit_regions("char/torso_back" if facing_back else "char/torso", torso_box, torso_regions):
		draw_colored_polygon(PackedVector2Array([
			Vector2(cx - 0.92 * H, shoulder_y + 0.1 * H), Vector2(cx - 0.30 * H, shoulder_y - 0.04 * H),
			Vector2(cx + 0.30 * H, shoulder_y - 0.04 * H), Vector2(cx + 0.92 * H, shoulder_y + 0.1 * H),
			Vector2(cx + 0.8 * H, chest_y), Vector2(cx + 0.5 * H, waist_y), Vector2(cx + 0.66 * H, hip_y + 0.15 * H),
			Vector2(cx - 0.66 * H, hip_y + 0.15 * H), Vector2(cx - 0.5 * H, waist_y), Vector2(cx - 0.8 * H, chest_y)]), suit)
		# (the round shoulder caps are gone: they read as epaulettes poking above the
		# jacket line. The polygon's own sloped corner is the shoulder now.)
		draw_circle(Vector2(cx - 0.34 * H, chest_y), 0.5 * H, Color(1.0, 0.95, 0.85, 0.05))   # soft chest sheen

		# front-of-body detailing (collar V and the buttoned waistcoat) only shows while the
		# figure faces the crowd; mid-spin, facing away, the plain back of the coat is seen
		if not facing_back:
			draw_colored_polygon(PackedVector2Array([
				Vector2(cx - 0.28 * H, shoulder_y - 0.02 * H), Vector2(cx, chest_y + 0.22 * H), Vector2(cx - 0.05 * H, shoulder_y - 0.02 * H)]), collar)
			draw_colored_polygon(PackedVector2Array([
				Vector2(cx + 0.28 * H, shoulder_y - 0.02 * H), Vector2(cx, chest_y + 0.22 * H), Vector2(cx + 0.05 * H, shoulder_y - 0.02 * H)]), collar)
			draw_colored_polygon(vest_shape(cx, H, shoulder_y, waist_y, hip_y), vest)
			for bi in 3:
				draw_circle(Vector2(cx, shoulder_y + 0.82 * H + float(bi) * 0.42 * H), 0.06 * H, button)
		else:
			# a plain collar band across the back of the neck
			draw_colored_polygon(PackedVector2Array([
				Vector2(cx - 0.28 * H, shoulder_y - 0.02 * H), Vector2(cx + 0.28 * H, shoulder_y - 0.02 * H),
				Vector2(cx + 0.24 * H, shoulder_y + 0.1 * H), Vector2(cx - 0.24 * H, shoulder_y + 0.1 * H)]), collar)

	# THE WARDROBE is a purely additive pass over the finished torso - it cannot touch
	# the IK, the hand targets, prop layering or any sim value. It goes on HERE, above
	# the jacket but BELOW the head and the arms, so the arms still pass in front of the
	# coat and a held Columns middle ball (which rests at stage_center, i.e. over the
	# hip) is never painted over.
	draw_performer_polish(cx, H, shoulder_y, chest_y, waist_y, hip_y, knee_y, floor_y,
		suit, suit_dk, vest, collar, accent, facing_back)

	# head: a full head of hair framing the crown and temples. Facing the crowd, the skin
	# face sits over it; facing away mid-spin, the back of the head is all hair, which is
	# what sells the turn. The head keeps its full ROUND size all through a turn (a head
	# reads round from every angle), so it is drawn OUTSIDE the body's width-scale,
	# otherwise it would squash to a thin oval at the profile.
	if spin_on:
		draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	draw_head(head, head_r, hair, skin, facing_back, gaze)
	if wearing("glasses") and not facing_back:
		draw_worn_glasses(head, head_r, accent)
	# WARDROBE: the TOP HAT goes on after the head and OUTSIDE the body's width-scale,
	# for the same reason the head is - a hat reads round from every angle, and squashed
	# to the profile's 0.14 it would be a vertical bar balanced on his skull. It is the
	# last thing drawn on the figure's upper half, so it sits over the hair rather than
	# under the fringe. THE HELMET SHARES THE SAME SPOT (2026-07-29): a head only wears
	# one crown, so a player who owns both simply sees whichever he actually put on.
	if wearing("hat"):
		draw_top_hat(head, head_r, suit_dk, vest, accent)
	elif wearing("helmet"):
		draw_worn_helmet(head, head_r, vest, accent)


func draw_performer_polish(cx: float, h: float, shoulder_y: float, chest_y: float,
		waist_y: float, hip_y: float, knee_y: float, floor_y: float,
		suit: Color, suit_dk: Color, vest: Color, collar: Color, accent: Color,
		facing_back: bool) -> void:
	# EXPERIMENTS / performer_polish: evening dress, drawn the way the rest of this
	# figure is drawn - filled SHAPES pinned to the body's own landmarks, in the
	# venue's own palette. The two earlier passes hung thin decorative STROKES over
	# the jacket instead (a cream V that read as a necklace, two cuff dashes floating
	# in mid-air nowhere near the moving arms), which is what "it just looks awful"
	# was about. Rules that keep this good: every mark either butts against a shape
	# the base figure already draws (the collar wedges, the shoulder seam, the trouser
	# outline) or rides a solved joint; nothing is smaller than a couple of px at
	# 720p; and the cuffs live in draw_arm, not here, because only draw_arm knows
	# where the wrist actually ended up.
	# lapel silk is the suit's OWN deep shade, barely lifted - not suit.lightened(),
	# which washes a crimson jacket out to pink and reads as a shawl, not tailoring
	var satin := suit_dk.lightened(0.08)
	var seam := suit_dk.darkened(0.20)         # tailoring seams: the suit, in shadow
	var linen := collar                        # shirt front/pocket square: the SAME cloth
											   # the base figure's collar wedges use, so a
											   # venue that dims its costume (the Midnight
											   # Show) dims the wardrobe with it
	var tie := Color(0.13, 0.09, 0.11)         # near-black, so it reads on any venue suit

	# a satin stripe down the outside of each trouser leg, following the leg's own
	# taper so it sits ON the cloth at every point. It is the JACKET's shade on the
	# trouser's darker one - the lapel silk has no contrast to give here, since the
	# trousers are already cut from it.
	#
	# A POLYLINE WITH THE KNEE IN IT, for the reason spelled out at the glow seam: this
	# was hip -> ankle as one straight chord over a leg that is two capsules with a bend
	# between them, so it crossed off the thigh's outer face and finished outside the
	# calf. Both seams now read the same three x values off the leg block's own capsule
	# geometry, and there is one description of where a trouser seam runs.
	var stripe := Color(suit.r, suit.g, suit.b, 0.65)
	for side in [-1.0, 1.0]:
		draw_polyline(PackedVector2Array([
			Vector2(cx + side * 0.50 * h, hip_y + 0.02 * h),
			Vector2(cx + side * 0.40 * h, knee_y),
			Vector2(cx + side * 0.35 * h, floor_y - 0.22 * h)]), stripe, 2.0)

	# WARDROBE: THE TAILCOAT (6,000). Drawn before the facing_back branch, because tails
	# are the one garment that shows MORE from behind - a Spin that hid them would be the
	# frame where the piece disappears.
	#
	# THE TAILS SWING OUT, AND THAT IS WHAT MAKES THEM READ AS TAILS. First attempt hung
	# them straight down from the hip flare, and on screen the pair read as a frock coat -
	# or worse, a dressing gown: they were as wide as the thigh, sat directly over it, and
	# fell to mid-shin, so there was no frame in which anything separated a tail from a
	# trouser. Measured against the leg block, that was inevitable rather than unlucky. The
	# thigh's outer face is at 0.63h and the calf's at 0.49h, so a panel drawn between 0.34h
	# and 0.74h is ON the leg for its whole length.
	#
	# So they FLARE: the top stays on the coat's own hip flare, and the hem swings out to
	# 0.86h - well clear of the 0.49h leg - which reads as two tails with daylight round
	# them AND is what tails actually do on a man who is moving. They end at the back of the
	# knee, which is where a tailcoat's do. Nothing here widens the figure: 0.86h is inside
	# the jacket's own 0.92h shoulder, let alone the arms' 2.5h reach.
	if wearing("coat"):
		for side in [-1.0, 1.0]:
			draw_colored_polygon(PackedVector2Array([
				Vector2(cx + side * 0.32 * h, hip_y - 0.18 * h),   # under the waist, inboard
				Vector2(cx + side * 0.68 * h, hip_y - 0.02 * h),   # out to the coat's hip flare
				Vector2(cx + side * 0.86 * h, knee_y - 0.04 * h),  # the hem, swung clear of the leg
				Vector2(cx + side * 0.72 * h, knee_y + 0.10 * h),  # the tail's point
				Vector2(cx + side * 0.52 * h, knee_y - 0.16 * h),  # ...and the inner hem, higher
				Vector2(cx + side * 0.36 * h, hip_y + 0.06 * h),
			]), suit)
			# the vent: a seam up the inner edge, which is what separates two tails from
			# one skirt. Without it the pair reads as a single dark apron behind the legs.
			draw_line(Vector2(cx + side * 0.38 * h, hip_y + 0.02 * h),
				Vector2(cx + side * 0.56 * h, knee_y - 0.10 * h), Color(seam.r, seam.g, seam.b, 0.75), 1.6)
			# ...and the cut-away front edge, the mark that says tailcoat rather than
			# frock coat: a satin sweep from the waist out to the flare.
			draw_line(Vector2(cx + side * 0.30 * h, waist_y + 0.10 * h),
				Vector2(cx + side * 0.66 * h, hip_y + 0.04 * h), Color(satin.r, satin.g, satin.b, 0.85), 2.2)

	if facing_back:
		# facing away mid-Spin: a centre seam and a shoulder yoke, so the back of the
		# coat still reads as a tailored garment rather than a flat slab of colour
		draw_line(Vector2(cx, shoulder_y + 0.34 * h), Vector2(cx, hip_y + 0.10 * h), Color(seam.r, seam.g, seam.b, 0.6), 1.8)
		draw_line(Vector2(cx - 0.60 * h, shoulder_y + 0.30 * h), Vector2(cx + 0.60 * h, shoulder_y + 0.30 * h), Color(seam.r, seam.g, seam.b, 0.45), 1.5)
		return

	# SHIRT FRONT: the base figure draws its collar as two thin wedges with plain
	# jacket showing BETWEEN them, which under a bow tie reads as a red necktie
	# hanging out of the collar. Filling that gap turns the same two wedges into one
	# proper dress shirt for the tie to sit on.
	var apex := Vector2(cx, chest_y + 0.22 * h)
	draw_colored_polygon(PackedVector2Array([
		Vector2(cx - 0.062 * h, shoulder_y - 0.02 * h), Vector2(cx + 0.062 * h, shoulder_y - 0.02 * h), apex,
	]), linen)

	# WARDROBE: THE SEQUIN WAISTCOAT (12,000), the late-game money piece, so it had better
	# look like it cost twelve thousand. Drawn BEFORE the lapels on purpose: the vest top
	# (shoulder+0.52h) sits above the lapel's tip (chest+0.38h), so the two overlap, and a
	# waistcoat painted over its own lapels is the tell of art applied in the wrong order.
	#
	# A SEQUIN IS A DISC THAT CATCHES LIGHT, so the field is discs and the light is TIME:
	# every sequin runs its own phase and a couple are near-white on any given frame, which
	# is what a spangled front does under a spotlight. Two things keep it from becoming
	# noise. The dots are 0.055h (~2.2px at 720p) and no smaller - below that they land in
	# the sub-pixel band the round props were flattened to escape, and a shimmering torso
	# would be the same bug wearing a waistcoat. And there are fifteen of them, in a brick
	# offset rather than a grid: a square lattice at this size reads as a printed pattern.
	# A SEQUIN'S COLOUR IS THE LIGHT, NOT THE CLOTH, and the first pass got that backwards.
	# It tinted the dots toward `accent`, which at the Small Theatre is a warm orange - the
	# same hue as the waistcoat under them - so fifteen sequins were drawn and not one was
	# visible. Under the Glow Suit it was worse: accent 0.70/1.0/0.80 on a vest of
	# 0.78/1.0/0.86 is the same colour twice. **Metal reads by LIGHTNESS, never by hue**, so
	# the dots are pale house gold (the tone the footlights, the coin and the flowers
	# already share, so it is still the venue's own light) and the field they sit on is
	# pulled a quarter of the way DOWN toward the jacket's shade to give them something to
	# be bright against.
	if wearing("vest"):
		var seq_field := Color(vest.r * 0.80, vest.g * 0.78, vest.b * 0.76)
		draw_colored_polygon(vest_shape(cx, h, shoulder_y, waist_y, hip_y), seq_field)
		var top := shoulder_y + 0.62 * h
		var spangle := Color(lerpf(1.0, accent.r, 0.30), lerpf(0.95, accent.g, 0.30), lerpf(0.76, accent.b, 0.30))
		for row in 5:
			var ry := top + float(row) * 0.34 * h
			var cols := 3 if row % 2 == 0 else 2
			for col in cols:
				var rx := cx + (float(col) - (float(cols) - 1.0) * 0.5) * 0.19 * h
				# each sequin's own phase, off its position, so the front twinkles rather
				# than pulsing as one sheet
				var tw := 0.5 + 0.5 * sin(float(atick()) * 0.09 + float(row) * 1.7 + float(col) * 2.9)
				var c := Color(1, 1, 0.94) if tw > 0.88 else Color(spangle.r, spangle.g, spangle.b, 0.62 + 0.34 * tw)
				draw_circle(Vector2(rx, ry), 0.055 * h, c)

	# PEAKED LAPELS. Their inner edge is exactly the outer edge of the collar wedges
	# the base figure already draws (shoulder line -> the V's apex at chest+0.22h), so
	# the satin FRAMES the shirt instead of crossing it. The peak sits at the chest,
	# where a real lapel is widest.
	for side in [-1.0, 1.0]:
		draw_colored_polygon(PackedVector2Array([
			Vector2(cx + side * 0.28 * h, shoulder_y - 0.02 * h),   # inner, on the collar
			apex,                                                    # down the collar's edge
			Vector2(cx + side * 0.08 * h, chest_y + 0.38 * h),       # the tip, just past the V
			Vector2(cx + side * 0.54 * h, chest_y - 0.04 * h),       # the peak
			Vector2(cx + side * 0.40 * h, shoulder_y - 0.01 * h),    # back up to the shoulder seam
		]), satin)

	# BOW TIE at the throat, where the neck column meets the jacket's neckline - not
	# adrift on the chest. Two wings and a knot, ~19px wide at 720p.
	for side in [-1.0, 1.0]:
		draw_colored_polygon(PackedVector2Array([
			Vector2(cx + side * 0.24 * h, shoulder_y - 0.07 * h),
			Vector2(cx + side * 0.24 * h, shoulder_y + 0.13 * h),
			Vector2(cx + side * 0.03 * h, shoulder_y + 0.03 * h),
		]), tie)
	draw_circle(Vector2(cx, shoulder_y + 0.03 * h), 0.055 * h, Color(accent.r, accent.g, accent.b, 0.9))

	# BREAST POCKET + SQUARE on the wearer's left (the crowd's right), sitting BELOW
	# the lapel's peak and inside the jacket's own edge, so neither the satin above it
	# nor the coat's outline ever clips it
	draw_line(Vector2(cx + 0.40 * h, chest_y + 0.34 * h), Vector2(cx + 0.68 * h, chest_y + 0.27 * h), Color(seam.r, seam.g, seam.b, 0.7), 2.0)
	draw_colored_polygon(PackedVector2Array([
		Vector2(cx + 0.44 * h, chest_y + 0.33 * h), Vector2(cx + 0.64 * h, chest_y + 0.28 * h),
		Vector2(cx + 0.53 * h, chest_y + 0.13 * h),
	]), linen)


# THE WARDROBE, ON THE MAN (2026-07-28). The five costume pieces were buyable, persisted,
# buffing and icon'd for a whole session before anyone put them on him - Louis's list
# opened with exactly that. Every one obeys the three rules the polish pass was built on,
# because they are the rules that stopped two earlier attempts from looking awful:
#   (1) filled SHAPES, never thin decorative strokes - a stroke reads as jewellery;
#   (2) every mark butts against something the base figure already draws (the hair's
#       crown, the coat's hip flare, the leg capsules' outer face) or rides a solved
#       joint (the glove sits on the hand the IK put there, like the cuff before it);
#   (3) every colour comes out of the venue's own palette, so the Midnight Show's
#       deliberately-vanishing costume is not lit back up by a hard white boot.
# And the standing rule above all of them: **the figure is settled. A hat goes on the
# head that is there; the head does not move to fit the hat.**

func vest_shape(cx: float, h: float, shoulder_y: float, waist_y: float, hip_y: float) -> PackedVector2Array:
	# ONE WAISTCOAT OUTLINE. The base figure draws the plain vest and the wardrobe's
	# sequin pass draws a spangled one over it in the same place - which is precisely the
	# situation where two copies of a shape drift apart and leave a rim of the old colour
	# showing along one edge. Both read this.
	var top := shoulder_y + 0.52 * h
	return PackedVector2Array([
		Vector2(cx - 0.30 * h, top), Vector2(cx + 0.30 * h, top),
		Vector2(cx + 0.28 * h, waist_y), Vector2(cx + 0.36 * h, hip_y - 0.10 * h),
		Vector2(cx - 0.36 * h, hip_y - 0.10 * h), Vector2(cx - 0.28 * h, waist_y)])


func draw_top_hat(head: Vector2, r: float, silk: Color, band: Color, accent: Color) -> void:
	# WARDROBE: THE TOP HAT (4,000). What makes a top hat a top hat is one ratio - a crown
	# about as tall as the head is wide, over a brim wider than the head - and it has to be
	# read at 21px of head radius from the stalls, so the crown is 1.5r tall and the brim
	# 1.5r to each side. Any shorter and it is a bowler; any taller and the figure is a
	# chimney, which at this scale happens fast.
	#
	# IT SITS ON THE HAIR, NOT ON THE SKULL. draw_hair_back swells to about 1.15r above
	# centre, so the brim rides at -0.78r: low enough to cover the hairline the way a worn
	# hat does, high enough to leave the brows (-0.30r) and the whole face clear. The one
	# thing this must never do is push the head down to make room.
	# SEAM: the hat is one object at one ratio, so it is one sprite. Sized off head radius
	# exactly as the drawing below is, so a sprite cannot make the crown taller or the brim
	# wider than the settled figure allows.
	if art_blit_size("char/hat_top", head + Vector2(0.0, -r * 1.53), Vector2(r * 3.0, r * 2.3)):
		return
	var brim_y := head.y - r * 0.78
	var crown_top := brim_y - r * 1.50
	var lit := silk.lightened(0.16)
	var dark := silk.darkened(0.35)
	# the crown, flaring very slightly toward the top the way a silk hat blocks
	draw_colored_polygon(PackedVector2Array([
		Vector2(head.x - r * 0.96, brim_y + r * 0.06), Vector2(head.x + r * 0.96, brim_y + r * 0.06),
		Vector2(head.x + r * 1.04, crown_top), Vector2(head.x - r * 1.04, crown_top)]), silk)
	# ...its lit face. A silk hat's whole character is that it shines, and a flat-filled
	# crown at this size is a black rectangle - the sheen is what makes it a material.
	draw_colored_polygon(PackedVector2Array([
		Vector2(head.x - r * 0.62, brim_y), Vector2(head.x - r * 0.14, brim_y),
		Vector2(head.x - r * 0.18, crown_top), Vector2(head.x - r * 0.66, crown_top)]), lit)
	# the flat top, as an ellipse, so the hat reads as a cylinder seen slightly from below
	fill_ellipse(Vector2(head.x, crown_top), r * 1.04, r * 0.17, lit)
	# the grosgrain band round the base of the crown, in the waistcoat's own cloth
	draw_colored_polygon(PackedVector2Array([
		Vector2(head.x - r * 0.97, brim_y + r * 0.04), Vector2(head.x + r * 0.97, brim_y + r * 0.04),
		Vector2(head.x + r * 0.99, brim_y - r * 0.30), Vector2(head.x - r * 0.99, brim_y - r * 0.30)]), band)
	draw_circle(Vector2(head.x + r * 0.72, brim_y - r * 0.13), r * 0.10, accent)   # the band's pin
	# the brim, over the crown's foot: an ellipse for the top face and a darker sliver
	# under it, which is what gives the brim thickness instead of a painted-on line
	fill_ellipse(Vector2(head.x, brim_y + r * 0.12), r * 1.52, r * 0.26, dark)
	fill_ellipse(Vector2(head.x, brim_y + r * 0.04), r * 1.50, r * 0.24, silk)
	fill_ellipse(Vector2(head.x, brim_y - r * 0.02), r * 1.34, r * 0.14, lit)


func draw_worn_glasses(head: Vector2, r: float, accent: Color) -> void:
	# WARDROBE: GLASSES (2026-07-29). The only piece in the rack that never went on the
	# man - `wearing("glasses")` gated a catch bonus and nothing else, so trying them on
	# in the tailor's mirror changed nothing to look at, which is exactly what Louis's
	# "it doesn't register on the juggler" was seeing. Same shape language as the shop's
	# own glasses card (two glazed lenses in a real frame), in units of head radius
	# instead of the card's fixed pixels, so it reads at either figure's size. Frame is
	# a neutral tortoiseshell - a real accessory's own material, not a venue tint - and
	# the lens catches a sliver of the venue's accent the way the hat's band pin does.
	# SEAM. THE BOX IS THE VECTOR'S OWN EXTENT, AND IT WAS NOT (fixed 2026-08-15). This blit
	# used to ask for a box 0.8r tall centred at -0.06r, so the sprite's top edge landed at
	# -0.46r. draw_top_hat's brim reaches down to -0.40r. The two overlapped by 0.06r on every
	# screen, which is why the geared performer had NO FOREHEAD: the hat brim sat straight down
	# on the lenses with not one pixel of skin between them, and at 21px of head radius that
	# turns the whole upper face into one dark smear. The drawing below never had the problem -
	# its lenses top out at -0.34r - so the sprite path was contradicting the fallback it is
	# supposed to be indistinguishable from, which is the tell for this class of bug.
	#
	# THE OTHER HALF OF IT IS A STRETCH, and it is what made the overlap. The sprite is 22x7,
	# an aspect of 3.14; the box asked for 2.1r x 0.8r, an aspect of 2.63. That is the art
	# drawn 20% TALLER than it was authored - so the top edge climbed into the brim, and at the
	# same time some rows were drawn two screen pixels tall and some three, which is the one
	# thing this project's density lock exists to prevent.
	#
	# So the WIDTH is left alone at 2.1r, deliberately: that is what makes the blit an exact
	# two screen pixels per art pixel at the stage figure's radius, and moving it would trade
	# one resampling bug for another. Only the height is corrected, to the sprite's own aspect
	# (2.1 * 7/22 = 0.668). The ink then tops out about three screen pixels clear of the brim,
	# which is a forehead - not much of one, but a real one, and the same one the drawing below
	# has always had.
	if art_blit_size("char/glasses", head + Vector2(0.0, -r * 0.02), Vector2(r * 2.1, r * 0.668)):
		return
	var frame := Color(0.16, 0.12, 0.09)
	var lr := r * 0.30
	var w := maxf(1.1, r * 0.075)
	for sgn in [-1.0, 1.0]:
		var lc := head + Vector2(sgn * r * 0.40, -r * 0.04)
		icon_disc(lc, lr, Color(accent.r, accent.g, accent.b, 0.22), frame, w)
		draw_line(lc + Vector2(-lr * 0.35, -lr * 0.30), lc + Vector2(lr * 0.10, lr * 0.15),
			Color(1.0, 1.0, 1.0, 0.30), maxf(0.8, r * 0.05))
		draw_line(lc + Vector2(sgn * lr, -r * 0.05), head + Vector2(sgn * r * 0.85, -r * 0.10), frame, w)
	draw_line(head + Vector2(-r * 0.10, -r * 0.04), head + Vector2(r * 0.10, -r * 0.04), frame, w)


func draw_worn_helmet(head: Vector2, r: float, cap_c: Color, accent: Color) -> void:
	# WARDROBE: THE ENERGY HELMET, ON HIS HEAD (2026-07-29) - the same reasoning as the
	# glasses above and the same fix. It is the shop card's own object (a cap, a can
	# either side, a straw running to the mouth), scaled off head radius the way the
	# top hat is. Mutually exclusive with the Top Hat at the call site - a player owns
	# both crowns but a head only wears one - so this never fights it for the same space.
	if art_blit_size("char/helmet", head + Vector2(0.0, -r * 0.55), Vector2(r * 3.2, r * 1.8)):
		return   # SEAM
	var cap := head + Vector2(0.0, -r * 0.60)
	var can_w := r * 0.34
	var can_h := r * 1.10
	for sgn in [-1.0, 1.0]:
		var can := cap + Vector2(sgn * r * 1.25, r * 0.05)
		var body := Color(0.86, 0.33, 0.24)
		draw_rect(Rect2(can.x - can_w, can.y - can_h * 0.5, can_w * 2.0, can_h), body)
		draw_rect(Rect2(can.x - can_w, can.y - can_h * 0.5, can_w * 0.5, can_h), Color(1.0, 0.58, 0.48, 0.55))
		draw_rect(Rect2(can.x + can_w * 0.6, can.y - can_h * 0.5, can_w * 0.4, can_h), Color(0.0, 0.0, 0.0, 0.26))
		fill_ellipse(Vector2(can.x, can.y - can_h * 0.5), can_w, can_w * 0.36, Color(0.84, 0.86, 0.90))
		draw_rect(Rect2(can.x - can_w, can.y - r * 0.10, can_w * 2.0, r * 0.10), Color(1.0, 0.85, 0.4, 0.85))
		var s0 := can + Vector2(-sgn * can_w * 0.4, -can_h * 0.5)
		var s1 := head + Vector2(sgn * r * 0.35, r * 0.55)
		draw_line(s0, s1, Color(0.92, 0.94, 0.98, 0.9), maxf(1.2, r * 0.09))
		var bead := fposmod(atick() * 0.012 + (0.5 if sgn > 0.0 else 0.0), 1.0)
		draw_circle(s1.lerp(s0, bead), r * 0.09, Color(1.0, 0.86, 0.42, 0.9))
	var dome := PackedVector2Array()
	for k in 13:
		var a := lerpf(PI, TAU, float(k) / 12.0)
		dome.append(cap + Vector2(cos(a), sin(a)) * (r * 0.95))
	draw_colored_polygon(dome, cap_c)
	draw_arc(cap, r * 0.7, PI * 1.12, PI * 1.62, 10, Color(1.0, 1.0, 1.0, 0.22), r * 0.28, true)
	fill_ellipse(cap + Vector2(0.0, r * 0.02), r * 1.05, r * 0.18, Color(cap_c.r * 0.7, cap_c.g * 0.7, cap_c.b * 0.7))
	draw_circle(cap + Vector2(0.0, -r * 0.92), r * 0.12, accent)   # the crown's own button, its one bright mark


func draw_stage_boot(at: Vector2, H: float, side: float, leather: Color, spat: Color,
		accent: Color) -> void:
	# WARDROBE: STAGE BOOTS, third pass (2026-07-29, Louis: "make the boots and gloves look
	# better tho"). The previous one had the right PARTS - shaft, toe cap, heel, spat strap -
	# and still read as a lump, and the reason is worth writing down because it applies to any
	# small object: **it had no ankle.** Every shape was a straight-sided slab stacked on the
	# next, so the boot was a column on a wedge; a real boot narrows sharply at the ankle and
	# swells again at the calf, and that single waist is what the eye reads as "boot" before it
	# reads any of the details.
	#
	# Also new: a proper turned-down CUFF at the top, a stacked heel with visible layers, and a
	# sole that runs past the upper as a welt. Everything is still in units of H inside a
	# mirrored transform, so one description serves both feet at any figure size.
	# SEAM: `side` is -1 or +1 and the drawing below mirrors through the transform, so the
	# sprite mirrors through a negative width - one boot asset serves both feet, which is
	# also how the procedural version stays one description.
	if art_blit_size("char/boot", at + Vector2(0.0, -H * 0.33),
			Vector2(side * H * 0.48, H * 0.62)):
		return
	var hide := Color(minf(leather.r * 1.75 + 0.05, 1.0), minf(leather.g * 1.65 + 0.03, 1.0),
		minf(leather.b * 1.50 + 0.02, 1.0))
	var lit := Color(minf(hide.r * 1.34, 1.0), minf(hide.g * 1.30, 1.0), minf(hide.b * 1.26, 1.0))
	var dark := Color(leather.r * 0.68, leather.g * 0.68, leather.b * 0.70)
	var cuff := Color(minf(hide.r * 1.12, 1.0), minf(hide.g * 1.06, 1.0), minf(hide.b * 1.00, 1.0))
	draw_set_transform(at, 0.0, Vector2(side * H, H))
	# THE SHAFT, WITH AN ANKLE. Six points down each side rather than two: wide at the calf,
	# pinched at -0.30, wide again over the instep.
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.205, -0.560), Vector2(0.175, -0.560),
		Vector2(0.158, -0.430), Vector2(0.128, -0.300),
		Vector2(0.150, -0.190), Vector2(0.168, -0.100),
		Vector2(-0.190, -0.100), Vector2(-0.172, -0.190),
		Vector2(-0.150, -0.300), Vector2(-0.182, -0.430)]), hide)
	# the lit front of the shaft, following the same waist so it can never cross the outline
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.030, -0.556), Vector2(0.150, -0.556),
		Vector2(0.134, -0.430), Vector2(0.106, -0.300),
		Vector2(0.128, -0.190), Vector2(0.144, -0.104),
		Vector2(-0.020, -0.104), Vector2(-0.016, -0.190),
		Vector2(-0.014, -0.300), Vector2(-0.024, -0.430)]), lit)
	# THE CUFF, turned down over the top: a band a little wider than the shaft, in a paler
	# leather. It is what stops the boot ending in a cut edge.
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.222, -0.610), Vector2(0.192, -0.610),
		Vector2(0.180, -0.526), Vector2(-0.210, -0.526)]), cuff)
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.222, -0.610), Vector2(0.192, -0.610),
		Vector2(0.188, -0.588), Vector2(-0.218, -0.588)]), lit)
	# the foot: a heel seat at the back, a long vamp, a toe that lifts off the boards
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.245, -0.045), Vector2(-0.205, -0.116), Vector2(0.060, -0.132),
		Vector2(0.235, -0.086), Vector2(0.318, -0.032), Vector2(0.300, -0.008),
		Vector2(-0.245, -0.008)]), hide)
	draw_colored_polygon(PackedVector2Array([   # the toe cap: patent, the one part that shines
		Vector2(0.118, -0.010), Vector2(0.300, -0.010), Vector2(0.318, -0.034),
		Vector2(0.222, -0.092)]), lit)
	draw_line(Vector2(0.118, -0.012), Vector2(0.150, -0.104), Color(dark.r, dark.g, dark.b, 0.7), 0.012)
	# the WELT, running a touch past the upper all the way round - the ridge every real
	# leather sole has, and the mark that says the boot is built rather than moulded
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.262, -0.010), Vector2(0.318, -0.010), Vector2(0.312, 0.014), Vector2(-0.268, 0.014)]), dark)
	# a STACKED heel: three thin layers, which is what a heel is and what one block is not
	for hl in 3:
		var hy := 0.010 - float(hl) * 0.036
		draw_colored_polygon(PackedVector2Array([
			Vector2(-0.258 + float(hl) * 0.004, hy), Vector2(-0.132, hy),
			Vector2(-0.132, hy - 0.032), Vector2(-0.254 + float(hl) * 0.004, hy - 0.032)]),
			dark if hl % 2 == 0 else Color(dark.r * 1.35, dark.g * 1.35, dark.b * 1.30))
	# THE SPAT: one pale strap buttoned across the shaft's waist, which is also the narrowest
	# place on the boot - a strap belongs where a boot is actually cinched.
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.158, -0.268), Vector2(0.138, -0.286), Vector2(0.142, -0.352), Vector2(-0.166, -0.334)]), spat)
	draw_line(Vector2(-0.160, -0.276), Vector2(0.140, -0.294), Color(0, 0, 0, 0.16), 0.010)
	draw_circle(Vector2(-0.098, -0.308), 0.032, accent)
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


# THE HEAD, second version (2026-07-28, Louis: "another improved face for the juggler:
# a nicer mouth and hair. right now they just look too artificial"). Behind the F9
# `face_v2` switch, ON, so the two can be held against each other live.
#
# WHAT WAS ACTUALLY ARTIFICIAL, because it was not the amount of detail. Three things,
# and each is one mark:
#   - the HAIR was `draw_circle(head + up, r * 1.12)`: a brown disc behind a tan disc.
#     A haircut is a SILHOUETTE - a crown that is not perfectly round, temples that come
#     down past the eye line, a hairline that parts on one side - and none of those is a
#     strand. Strands would be the wrong answer anyway: at 21px they land in the
#     sub-pixel band the round props were flattened to get out of, and they shimmer.
#   - the MOUTH was a three-point polyline of even thickness. Godot has no round caps,
#     so it had square ends: a drawn line lying on a face rather than a pair of lips.
#     Every mouth here is a filled SHAPE built from the same four numbers.
#   - the EYES were two dots and a white speck, which reads as printed on. What makes an
#     eye look like an eye at this size is the LID above it - and the lid is also what
#     closes on a wince, so one mark carries the expression too.
#
# DETAIL IS A FUNCTION OF RADIUS, the same rule draw_coin learned the hard way: the
# stage head is r ~= 21px but the Skills preview's is 11.5, so brows, lids and the nose
# appear at r >= 10 and teeth only at r >= 14, where there is room for them to be teeth
# rather than a white band filling the mouth. Nothing here moves the head, the stance or
# any proportion - the figure is settled and a face pass must never reshape it.
func draw_head(head: Vector2, r: float, hair: Color, skin: Color, facing_back: bool, gaze: Vector2 = Vector2.ZERO) -> void:
	# THE ONE HEAD, at whatever radius the caller has. The stage figure and the Skills
	# preview's little performer each used to draw their own - same intent, different
	# code, and the preview's had already drifted to a bare arc for a mouth and no
	# fringe at all. A face is exactly the kind of thing two copies of go quietly out of
	# step, so there is one now and the preview simply passes a smaller r.
	#
	# SEAM: two keys, because a head seen from behind is a different picture and not a
	# mirrored one. `r` is the caller's, so a sprite is fitted to the radius the figure
	# already has - the stance and proportions are settled and art must not renegotiate
	# them. The 2.6r box leaves room for the hair silhouette, which swells past the skull.
	if art_blit_size("char/head_back" if facing_back else "char/head", head,
			Vector2(r, r) * 2.6, 0.0, Color.WHITE):
		return
	draw_hair_back(head, r, hair)
	if facing_back:
		# ALL HAIR, no nape (2026-07-27, Louis: "during spin, the back of the players
		# head should be entirely hair: brown"). A skin patch used to sit at the bottom
		# of the skull to suggest a neck, but the neck is already drawn below the head as
		# its own column - so what the patch actually read as, mid-turn, was the face
		# still half showing from behind.
		draw_circle(head, r, hair)
		return
	draw_circle(head, r, skin)                                        # face over the hair
	draw_circle(head + Vector2(-r * 0.26, -r * 0.08), r * 0.52, Color(1.0, 0.86, 0.6, 0.10))   # cheek highlight
	draw_hair_front(head, r, hair)   # the hairline goes UNDER the features...
	draw_face_v2(head, r, hair, gaze) # ...and the brows come with the face


func draw_hair_back(head: Vector2, r: float, hair: Color) -> void:
	# the outer silhouette, drawn behind the face disc: a shell over the skull that comes
	# down PAST the temples on both sides, swelling unevenly so the crown is not a
	# circle. The unevenness is the whole difference between hair and a helmet.
	var pts := PackedVector2Array()
	for i in 25:
		var a := -0.30 + (PI + 0.60) * (float(i) / 24.0)   # right temple, over the crown, left temple
		var swell := 1.05 + 0.06 * sin(a) + 0.045 * sin(a * 2.0 + 0.6)
		pts.append(head + Vector2(cos(a) * r * swell, -sin(a) * r * swell))
	# ...and closed across the nape, bowed rather than straight: three points on one line
	# is the degenerate case Godot's triangulator is fussy about (see the helmet brim).
	pts.append(head + Vector2(-r * 0.92, r * 0.34))
	pts.append(head + Vector2(0.0, r * 0.44))
	pts.append(head + Vector2(r * 0.92, r * 0.34))
	draw_colored_polygon(pts, hair)


func draw_hair_front(head: Vector2, r: float, hair: Color) -> void:
	# THE HAIRLINE, the single mark that turns a brown shell into a haircut. A side
	# parting: a short sweep up from the left temple to the part, then one long sweep
	# across the brow that comes to a POINT on the right. The point matters - a fringe
	# ending on a flat edge reads as a wig, one ending level reads as a bowl cut.
	var pts := PackedVector2Array()
	for i in 17:
		var a := 0.08 + (PI - 0.16) * (float(i) / 16.0)   # over the top of the face disc
		pts.append(head + Vector2(cos(a) * r * 1.03, -sin(a) * r * 1.03))
	pts.append(head + Vector2(-r * 0.99, r * 0.08))    # left temple, down past the eye line
	pts.append(head + Vector2(-r * 0.62, -r * 0.32))   # up the short side...
	pts.append(head + Vector2(-r * 0.20, -r * 0.64))   # ...to the part, high on the crown
	pts.append(head + Vector2(r * 0.22, -r * 0.48))    # the long sweep starts down
	pts.append(head + Vector2(r * 0.72, -r * 0.24))    # ...and comes to its point
	pts.append(head + Vector2(r * 0.99, r * 0.04))     # right temple
	draw_colored_polygon(pts, hair)
	if r >= 13.0:
		# ONE sheen band over the crown, up and to the left - the same direction the
		# cheek highlight already claims, and the direction the spotlight actually is.
		# (The round props refuse a highlight because their light genuinely changes as
		# they fly; a head under a follow spot is the case where the claim holds.)
		var sh := PackedVector2Array()
		for i in 9:
			var a := PI * 0.40 + PI * 0.32 * (float(i) / 8.0)
			sh.append(head + Vector2(cos(a), -sin(a)) * r * 1.00)
		for i in 9:
			var a := PI * 0.40 + PI * 0.32 * (1.0 - float(i) / 8.0)
			sh.append(head + Vector2(cos(a), -sin(a)) * r * 0.84)
		var g := hair.lightened(0.30)
		draw_colored_polygon(sh, Color(g.r, g.g, g.b, 0.5))


func mouth_shape(c: Vector2, hw: float, lift: float, top_bow: float, bot_bow: float) -> PackedVector2Array:
	# A MOUTH AS A CLOSED LENS between two bowed edges. Corners sit at (+/-hw, lift) and
	# each edge sags from there by its own bow (positive is DOWNWARD, so a smile is two
	# downward bows and a grimace two upward ones). Four numbers describe every
	# expression, which is the point: they are read from one place, so the lips, the
	# opening, the teeth and the lower-lip highlight are all the same curve at different
	# offsets and can never come apart from each other.
	# The two corners are emitted ONCE, by the top edge - both bows vanish there, so
	# sampling the bottom edge corner-to-corner as well would stack duplicate vertices.
	var pts := PackedVector2Array()
	for i in 11:
		var t := float(i) / 10.0
		pts.append(c + Vector2(-hw + 2.0 * hw * t, lift + top_bow * (1.0 - pow(2.0 * t - 1.0, 2.0))))
	for i in range(9, 0, -1):
		var t := float(i) / 10.0
		pts.append(c + Vector2(-hw + 2.0 * hw * t, lift + bot_bow * (1.0 - pow(2.0 * t - 1.0, 2.0))))
	return pts


func draw_face_v2(head: Vector2, r: float, hair_tone: Color, gaze: Vector2 = Vector2.ZERO) -> void:
	var mood := face_mood()
	# EYES. THREE MARKS AND NO MORE, because that is all a 21px head has room for: one
	# dark almond, one catchlight, one brow above it. The first attempt also drew an
	# upper LID, and it was the wrong instinct at this scale - a near-black cap sitting
	# on a near-black eye does not read as a fold, it just makes the eye taller, and
	# together with a brow that was too low the two merged into a single dark block. The
	# eye SQUEEZES on a wince instead, which is what a real squint is and costs nothing.
	var ex := r * 0.34
	var ey := 0.0
	var ew := r * 0.15
	var eh := r * 0.12
	if mood == -1:
		eh = r * 0.05
	elif mood == 1:
		eh = r * 0.10
	# gaze_track (F9 experiment): BOTH marks slide together, a hair's width, toward
	# whatever the caller says is worth watching (draw_juggler points this at the
	# soonest-landing airborne prop - the same one hand_target already has the empty
	# hand reaching for). `gaze` only ever carries a DIRECTION here, never a distance -
	# the caller's own magnitude is thrown away and replaced with this fixed, tiny
	# budget, because "three marks and no more" (above) means there is no sclera for a
	# pupil to swim around in: the whole eye must glance as one shape, and a glance a
	# real head could not physically make is worse than no glance at all.
	var look := gaze.normalized() * r * 0.055 if gaze.length_squared() > 0.0001 else Vector2.ZERO
	# TYPED, not bare: an untyped array literal makes every element a Variant, and
	# arithmetic on one infers nothing - which is the "cannot infer the type" parse error
	# --check-only does not report and only a real run surfaces.
	for sgn: float in [-1.0, 1.0]:
		var c := head + Vector2(sgn * ex, ey) + look
		fill_ellipse(c, ew, eh, Color(0.16, 0.10, 0.08))
		if eh > r * 0.07:
			# the catchlight goes up and LEFT, with the cheek highlight and the hair
			# sheen: three marks claiming three different lights is what makes a face
			# look assembled rather than lit
			draw_circle(c + Vector2(-ew * 0.32, -eh * 0.30), maxf(0.8, r * 0.045), Color(1, 1, 1, 0.85))
	if r >= 10.0:
		# BROWS as filled tapers - heavier at the inner end, thinning outward, which is
		# what a brow does. Their height is set by the gap they have to leave: the eye's
		# top edge is at -eh, the fringe's hairline comes down to about -0.35r over the
		# outer end, and the brow has to sit clearly between the two at every mood.
		var by := -r * 0.30
		var inner_dy := (r * 0.09 if mood == -1 else (-r * 0.04 if mood == 1 else 0.0))
		var outer_dy := (-r * 0.03 if mood == -1 else (-r * 0.08 if mood == 1 else 0.0))
		var th := r * 0.070
		# hair's own colour, not the eye's: a brow as dark as a pupil is the other half
		# of what made the two read as one mark
		var brow := hair_tone.darkened(0.12)
		for sgn: float in [-1.0, 1.0]:
			var ix := sgn * (ex - r * 0.15)
			var ox := sgn * (ex + r * 0.20)
			draw_colored_polygon(PackedVector2Array([
				head + Vector2(ix, by + inner_dy - th),
				head + Vector2(ox, by + outer_dy - th * 0.45),
				head + Vector2(ox, by + outer_dy + th * 0.35),
				head + Vector2(ix, by + inner_dy + th)]), brow)
		# A NOSE IS A SHADOW, not an outline: one narrow plane down the shaded side, in
		# the skin's own family and half transparent, so it stays a soft plane on a
		# bright stage instead of becoming a black mark on a dark one. Narrow matters -
		# a wide one is a snout.
		draw_colored_polygon(PackedVector2Array([
			head + Vector2(-r * 0.01, r * 0.04),
			head + Vector2(r * 0.09, r * 0.23),
			head + Vector2(-r * 0.08, r * 0.23)]), Color(0.60, 0.39, 0.28, 0.42))
	# THE MOUTH: lips first as one shape, then the opening inside them, then the light
	# on the lower lip. Nothing here is a stroke.
	var mc := Vector2(head.x, head.y + r * 0.44)
	var hw := r * 0.31
	var lift := 0.0
	var top_bow := r * 0.05
	var bot_bow := r * 0.12
	var open := false
	if mood == 1:
		# EASY DOES IT (2026-07-28, Louis: "the smile is a bit creepy, go easy on that
		# part"). The first version dropped the jaw - corners up, middle 0.40r down, a
		# band of teeth inside - and a wide open mouth with visible teeth on a face this
		# simplified does not read as delight, it reads as a rictus. There are no eyes
		# doing the other half of the work at 21px, so the mouth has to carry the mood
		# on its own and a mouth carrying it ALONE must stay small. Lifted corners and a
		# barely parted lip is a smile; anything more is a grin.
		hw = r * 0.32
		lift = -r * 0.045         # corners up, which is where a smile actually lives
		top_bow = r * 0.09
		bot_bow = r * 0.19        # ...and only just parted
		open = true
	elif mood == -1:
		hw = r * 0.26
		lift = r * 0.06           # corners down
		top_bow = -r * 0.10       # ...and the middle up: a grimace, and a narrow one
		bot_bow = -r * 0.02
	var lip_lift := lift - r * 0.03
	draw_colored_polygon(mouth_shape(mc, hw * 1.06, lip_lift, top_bow - r * 0.03, bot_bow + r * 0.05),
		Color(0.58, 0.28, 0.25))
	if open:
		# the parted lip, and NO TEETH. A white band inside the mouth was tried and is
		# exactly what tipped the smile into a grin - see the mood == 1 note above.
		draw_colored_polygon(mouth_shape(mc, hw, lift, top_bow, bot_bow), Color(0.34, 0.14, 0.14))
	if r >= 10.0:
		draw_colored_polygon(mouth_shape(mc, hw * 0.86, lip_lift, bot_bow + r * 0.05, bot_bow + r * 0.12),
			Color(0.98, 0.74, 0.60, 0.45))


func draw_spin_streaks(center: Vector2) -> void:
	var prog := 1.0 - clampf(float(spin_until - tick) / float(SPIN_TICKS), 0.0, 1.0)   # 0 at start, 1 at end
	# curved motion streaks sweeping around the body, flattened to read as a turn
	var base_a := prog * TAU * 2.0
	for k in 3:
		var a0 := base_a + float(k) * (TAU / 3.0)
		var pts := PackedVector2Array()
		for j in 9:
			var a := a0 + float(j) * 0.10
			var rr := 66.0 - float(k) * 7.0
			pts.append(center + Vector2(cos(a) * rr, sin(a) * rr * 0.55))
		draw_polyline(pts, Color(1.0, 0.85, 0.5, 0.34 - 0.07 * float(k)), 3.0)


func fill_ellipse(c: Vector2, rx: float, ry: float, col: Color) -> void:
	var pts := PackedVector2Array()
	for i in 20:
		var a := TAU * float(i) / 20.0
		pts.append(c + Vector2(cos(a) * rx, sin(a) * ry))
	draw_colored_polygon(pts, col)


func mitt_shape(c: Vector2, rx: float, ry: float, thumb_ang: float, thumb_amt: float) -> PackedVector2Array:
	# ONE SILHOUETTE, thumb included - not a triangle glued onto a circle (2026-07-31,
	# Louis: "the gloves still look horrible" - the shape they had bolted a separate
	# 5-point thumb polygon onto the palm ellipse, which never reads as one hand no
	# matter how the seam is dressed). `thumb_amt` 0 gives back a plain ellipse; >0
	# bulges the SAME outline toward `thumb_ang` with a bell falloff, so the palm and
	# the thumb are one continuous edge with nowhere for the two pieces to disagree.
	var pts := PackedVector2Array()
	for i in 20:
		var a := TAU * float(i) / 20.0
		var d := absf(angle_difference(a, thumb_ang))
		var bump := thumb_amt * exp(-pow(d / 0.85, 2.0))
		pts.append(c + Vector2(cos(a) * rx * (1.0 + bump), sin(a) * ry * (1.0 + bump)))
	return pts


# --- PERFORMANCE: what actually costs, MEASURED (2026-07-27) ------------------
# The first version of this helper replaced `draw_circle` with a hand-built low-poly
# polygon, on the theory that primitives were the cost. Measured with --fps, that made
# the crowd 30% SLOWER (760us a frame against 550us): what dominates this renderer is
# the PER-CALL overhead of a GDScript->engine draw, plus the PackedVector2Array each
# hand-built polygon allocates. Vertex count barely registers. So the rule for this
# file is: use ENGINE primitives (draw_circle / draw_rect / draw_line), and optimise by
# making FEWER CALLS, never by making cheaper-looking ones. All this wrapper adds now is
# the early-out that matters - a fully transparent glow costs nothing at all.
func soft_disc(c: Vector2, r: float, col: Color, _seg: int = 0) -> void:
	if col.a <= 0.004 or r <= 0.0:
		return   # invisible: never pay for it (the whole point of this wrapper)
	draw_circle(c, r, col)


# THE GLOW, as one textured quad (2026-07-27). Every soft light in this game used to be
# a STACK of flat discs at low alpha - the stage light pool was 26 of them, the street
# lamp 6, a torch 4 - which cost one draw call each and, once the stack was thinned for
# performance, showed its steps as visible rings around the performer. A radial gradient
# texture, generated in code at startup like everything else here, is one draw call, has
# no steps at any size, and can be tinted per use. Use draw_glow for any soft pool of
# light; use soft_disc/draw_circle only where a defined edge is wanted.
var _glow_tex: GradientTexture2D = null

func glow_texture() -> GradientTexture2D:
	if _glow_tex != null:
		return _glow_tex
	var g := Gradient.new()
	# a bright core that falls away fast, then a long faint skirt - the shape a real
	# lamp throws, and the shape the old 26-disc stack was approximating
	g.offsets = PackedFloat32Array([0.0, 0.30, 0.62, 1.0])
	g.colors = PackedColorArray([Color(1, 1, 1, 1.0), Color(1, 1, 1, 0.45),
		Color(1, 1, 1, 0.12), Color(1, 1, 1, 0.0)])
	var t := GradientTexture2D.new()
	t.gradient = g
	t.fill = GradientTexture2D.FILL_RADIAL
	t.fill_from = Vector2(0.5, 0.5)
	t.fill_to = Vector2(1.0, 0.5)
	t.width = 128
	t.height = 128
	_glow_tex = t
	return _glow_tex


func draw_glow(c: Vector2, r: float, col: Color) -> void:
	if col.a <= 0.004 or r <= 0.0:
		return
	draw_texture_rect(glow_texture(), Rect2(c.x - r, c.y - r, r * 2.0, r * 2.0), false, col)


const GLOW_PIX_STEPS := 4     # concentric bands; more reads as a smooth blur again

func draw_glow_pix(c: Vector2, r: float, col: Color, grid: float = 0.0) -> void:
	# THE SAME SOFT POOL, ON THE ART GRID (2026-08-05, Louis: "the glow around the balls
	# looks strange"). draw_glow stretches a 128px radial gradient texture, which is
	# exactly right for a big stage wash and exactly wrong at prop scale: around a 12px
	# ball it is a blurry disc with a soft edge, sitting in a frame where everything else
	# steps in clean 2px blocks. Blur at that size does not read as light, it reads as a
	# smudge - the same tell the arms had before draw_capsule_pix.
	#
	# So a prop's glow is CONCENTRIC BANDS instead, quantised to the art grid the way
	# pixel artists have always drawn a lamp: a few nested discs, each one brighter than
	# the last. Radii snap to whole art pixels so the bands cannot land mid-block, and
	# each band is filled one draw_rect per art row, which is what gives it hard stepped
	# edges rather than the antialiased rim draw_circle would.
	#
	# The alpha per band follows the same curve glow_texture uses, so a charged prop is
	# as BRIGHT as it was - only its edge changed. Four bands is the whole budget: at
	# five or more the steps are close enough together to read as a gradient again, which
	# is the thing being fixed.
	if col.a <= 0.004 or r <= 0.0:
		return
	var gap := grid if grid > 0.0 else float(ART_PIXEL)
	for i in GLOW_PIX_STEPS:
		var t := float(i) / float(GLOW_PIX_STEPS)          # 0 outermost .. -> innermost
		var br := snappedf(r * (1.0 - t * 0.72), gap)
		if br < gap:
			continue
		# matches glow_texture's fall-off: a bright core dropping away fast, then a skirt
		var a := col.a * (0.14 + 0.86 * pow(t, 1.7))
		fill_disc_pix(c, br, Color(col.r, col.g, col.b, a), gap)


func fill_disc_pix(c: Vector2, r: float, col: Color, grid: float = 0.0) -> void:
	# a filled circle rasterised onto the art grid, one draw_rect per art row - the same
	# technique as draw_capsule_pix, and here for the same reason: draw_circle antialiases
	# its rim, and a soft rim is what makes a 12px glow look like a smudge.
	#
	# `grid` IS FOR THE PREVIEWS, and it is not optional cleverness. The Skills panel draws the
	# performer at fig_preview_px() - one screen pixel per art pixel, exactly HALF the stage's
	# ART_PIXEL - so a prop snapped to 2 beside him is drawn at twice his own resolution, and
	# a 6.5px ball comes out a visibly chunkier object than the man holding it. A rasteriser
	# that hard-codes ART_PIXEL is only correct on screens drawn at ART_PIXEL.
	var ap := grid if grid > 0.0 else float(ART_PIXEL)
	var y0 := snappedf(c.y - r, ap)
	var rows := int(ceil((r * 2.0) / ap))
	for i in rows + 1:
		var y := y0 + float(i) * ap
		# sample each row at its CENTRE, not its top edge, or the disc sits half a row high
		var dy := (y + ap * 0.5) - c.y
		if absf(dy) > r:
			continue
		var half := sqrt(maxf(0.0, r * r - dy * dy))
		var x0 := snappedf(c.x - half, ap)
		var w := snappedf(half * 2.0, ap)
		if w >= ap:
			draw_rect(Rect2(x0, y, w, ap), col)


func icon_disc(c: Vector2, r: float, fill: Color, ring: Color, ring_w: float = 2.0) -> void:
	# THE ROUND BADGE every menu row wears, on the art grid.
	#
	# It was a draw_circle with a draw_arc laid over it, and both antialias their rim - so
	# the last soft curves left in the UI were sitting on the most-repeated piece of chrome
	# in the game: the day hub's four actions, the pause menu, settings, the shop's rows, the
	# skills list. Measured with scripts/check_pixel_grid.py, these discs and the text were
	# the only things still off-grid on a day-hub frame; the panels behind them had already
	# been converted and were clean.
	#
	# One point, ten call sites - the same leverage soft_card has, and the reason this is a
	# named helper rather than two lines repeated at each of them.
	fill_disc_pix(c, r, fill)
	draw_ring_pix(c, r, ring_w, ring)


func draw_arc_pix(c: Vector2, r: float, thick: float, b0: float, b1: float, col: Color) -> void:
	# ONE BAND OF THE CROWD DIAL, rasterised onto the art grid.
	#
	# draw_arc(..., antialiased) is a polyline with soft edges, and on the gauge that shows
	# twice over: the band's rim is a grey fringe, and where two zones meet the two fringes
	# blend into a third colour that belongs to neither. A fuel gauge is exactly the kind of
	# instrument whose whole job is to have crisp, countable zones.
	#
	# ANALYTIC SPANS, NOT A PER-PIXEL TEST. For each art row the annulus contributes at most
	# two x-intervals - solve the two circles - and the sector's two rays cut the row at
	# x = dy / tan(angle), which is monotonic across the dial's own domain. So the whole band
	# costs one pass over about thirty rows instead of a few thousand atan2 calls a frame.
	#
	# DOMAIN: PI <= b0 < b1 <= TAU, i.e. the upper half in Godot's y-down space, which is the
	# half a dial sweeps. That is not a general arc routine and does not pretend to be.
	var ap := float(ART_PIXEL)
	var ro := r + thick * 0.5
	var ri := maxf(0.0, r - thick * 0.5)
	var y0 := snappedf(c.y - ro, ap)
	var rows := int(ceil(ro / ap)) + 2
	for i in rows:
		var y := y0 + float(i) * ap
		var dy := (y + ap * 0.5) - c.y
		if dy > 0.0 or absf(dy) > ro:
			continue
		var xo := sqrt(maxf(0.0, ro * ro - dy * dy))
		var xi := sqrt(maxf(0.0, ri * ri - dy * dy))
		# the sector, as an x range on this row. tan goes to zero at both ends of the
		# domain, which is a HORIZONTAL ray - the limit is the correct infinity, not an
		# error, so it is clamped to the row rather than guarded against.
		var lo := ray_x(dy, b0, -ro)
		var hi := ray_x(dy, b1, ro)
		for seg in ([[-xo, -xi], [xi, xo]] if xi > 0.0 else [[-xo, xo]]):
			var a := maxf(float(seg[0]), lo)
			var b := minf(float(seg[1]), hi)
			if b - a < ap * 0.5:
				continue
			var sx := snappedf(c.x + a, ap)
			var sw := snappedf(b - a, ap)
			if sw >= ap:
				draw_rect(Rect2(sx, y, sw, ap), col)


func ray_x(dy: float, ang: float, far: float) -> float:
	# where the ray at `ang` crosses the horizontal line dy, relative to the centre. `far` is
	# what to return when the ray is horizontal and never crosses at all.
	var t := tan(ang)
	if absf(t) < 1e-6:
		return far
	return dy / t


func draw_spoke_pix(c: Vector2, ang: float, r0: float, r1: float, w: float, col: Color) -> void:
	# A RADIAL RUN OF ART PIXELS: the needle, the zone ticks and the peak pin.
	#
	# All three were antialiased polygons or draw_lines, and the needle was the worst thing
	# in the HUD - a smooth white blade with a soft grey edge, sitting on a dial the player
	# is asked to read at a glance. Stepped, it looks like an instrument.
	#
	# Width TAPERS from w at the hub to one art pixel at the tip, which is what made the
	# original a blade rather than a stick, and is free here.
	var ap := float(ART_PIXEL)
	var d := Vector2(cos(ang), sin(ang))
	var perp := Vector2(-d.y, d.x)
	var steps := int(ceil((r1 - r0) / ap)) + 1
	for i in steps + 1:
		var t := float(i) / float(maxi(1, steps))
		var at := c + d * lerpf(r0, r1, t)
		var half := maxf(ap * 0.5, lerpf(w, ap, t) * 0.5)
		var n := int(ceil(half * 2.0 / ap))
		for k in n:
			var off := (float(k) - float(n - 1) * 0.5) * ap
			draw_rect(Rect2(art_snap(at + perp * off), Vector2(ap, ap)), col)


func fill_poly_pix(pts: PackedVector2Array, col: Color) -> void:
	"""Any polygon, filled on the art grid: one draw_rect per art row, even-odd rule.

	THE POINTS ARE IN SCREEN SPACE, and that is the whole reason this exists rather than a
	`_cap_px` unit-space fill like the card art uses. A flame rides a TUMBLING prop, so its
	local frame is rotated - and a grid snapped in a rotated frame is not the art grid, it is
	a rotated lattice that crawls as the prop turns. The art grid is a property of the screen.
	So the caller transforms its shape itself and this fills the result where the pixels are."""
	if pts.size() < 3:
		return
	var ap := float(ART_PIXEL)
	var ymin := INF
	var ymax := -INF
	for p: Vector2 in pts:
		ymin = minf(ymin, p.y)
		ymax = maxf(ymax, p.y)
	if not (ymax > ymin):
		return
	var y0 := snappedf(ymin, ap)
	var n := pts.size()
	for i in int(ceil((ymax - ymin) / ap)) + 2:
		var y := y0 + float(i) * ap
		var yc := y + ap * 0.5          # sample each row at its CENTRE, as every pix helper does
		var xs: Array[float] = []
		for k in n:
			var a: Vector2 = pts[k]
			var b: Vector2 = pts[(k + 1) % n]
			if (a.y <= yc) == (b.y <= yc):
				continue                # this edge does not cross this row
			xs.append(a.x + (yc - a.y) / (b.y - a.y) * (b.x - a.x))
		if xs.size() < 2:
			continue
		xs.sort()
		var j := 0
		while j + 1 < xs.size():
			var xa := snappedf(xs[j], ap)
			var xb := snappedf(xs[j + 1], ap)
			if xb - xa >= ap:
				draw_rect(Rect2(xa, y, xb - xa, ap), col)
			j += 2


func fill_flame_pix(pos: Vector2, ang: float, sc: float, base: Vector2, h: float, w: float,
		sway: float, col: Color, phase: float = 0.0) -> void:
	# one layer of a flame, mapped out of the prop's local frame and filled on the art grid
	var local := flame_shape(base, h, w, sway, phase)
	var out := PackedVector2Array()
	out.resize(local.size())
	for i in local.size():
		out[i] = pos + local[i].rotated(ang) * sc
	fill_poly_pix(out, col)


func draw_ring_pix(c: Vector2, r: float, w: float, col: Color, grid: float = 0.0) -> void:
	# a hollow circle on the art grid: the same row solve as fill_disc_pix run twice, so the
	# ring's own inner edge is as hard as its outer one. draw_arc(..., TAU) antialiases both.
	# `grid`: see fill_disc_pix - a preview draws at half the stage's art pixel.
	var ap := grid if grid > 0.0 else float(ART_PIXEL)
	var ro := r + w * 0.5
	var ri := maxf(0.0, r - w * 0.5)
	var y0 := snappedf(c.y - ro, ap)
	for i in int(ceil(ro * 2.0 / ap)) + 2:
		var y := y0 + float(i) * ap
		var dy := (y + ap * 0.5) - c.y
		if absf(dy) > ro:
			continue
		var xo := sqrt(maxf(0.0, ro * ro - dy * dy))
		var xi := sqrt(maxf(0.0, ri * ri - dy * dy))
		for seg in ([[-xo, -xi], [xi, xo]] if xi > 0.0 else [[-xo, xo]]):
			var sx := snappedf(c.x + float(seg[0]), ap)
			var sw := snappedf(float(seg[1]) - float(seg[0]), ap)
			if sw >= ap:
				draw_rect(Rect2(sx, y, sw, ap), col)


func face_mood() -> int:
	# -1 wince (just dropped), 0 calm, 1 pleased (on a streak). Shared by the mouth and
	# the wardrobe pass's brows so the two can never disagree about the expression.
	if tick - last_drop_tick < 45:
		return -1
	return 1 if streak >= 3 else 0


func draw_capsule(a: Vector2, b: Vector2, wa: float, wb: float, col: Color) -> void:
	# a tapered limb: a quad from half-width wa at a to wb at b, with rounded caps.
	# This reads as a real arm instead of a flat stick line.
	var d := b - a
	var L := d.length()
	var ra := wa * 0.5
	var rb := wb * 0.5
	if L < 0.001:
		draw_circle(a, maxf(ra, rb), col)
		return
	var n := Vector2(-d.y, d.x) / L
	draw_colored_polygon(PackedVector2Array([a + n * ra, b + n * rb, b - n * rb, a - n * ra]), col)
	draw_circle(a, ra, col)
	draw_circle(b, rb, col)


const LIMB_BANDS := 4        # value steps across a limb, matching the body regions'
const LIMB_FLOOR := 0.64     # and their floor, so a sleeve and its torso agree
const LIMB_LIGHT_U := -0.42  # and their light

# THE ARMS FOLLOW THE CHOSEN LOOK, and they have to. The torso and legs are SPRITES, so a
# character variant swaps their files; the arms are RASTERISED LIVE (see draw_capsule_pix -
# a limb stretches every frame, so it cannot be a sprite) and would otherwise keep the
# default shading while the body changed under them. A "volume" jacket with a "classic"
# sleeve attached to it is worse than either look on its own, and it is the exact failure
# the LIMB_* constants were written to prevent between the torso and the sleeve.
#
# The numbers are the same profiles as LOOKS in scripts/shade_char_regions.py. Two
# tables, not one, because one lives in Python and one in GDScript - keep them in step.
func limb_prof() -> Array:
	match variant("character"):
		"volume": return [5, 0.46, -0.48]
		"inked":  return [3, 0.74, -0.40]
		_:        return [LIMB_BANDS, LIMB_FLOOR, LIMB_LIGHT_U]


func limb_bands() -> int:
	return int(limb_prof()[0])


func limb_shade(col: Color, u: float) -> Color:
	# One band of a lit cylinder, quantised. Shares its floor and its light direction with
	# scripts/shade_char_regions.py on purpose: the sleeve is the same cloth as the torso
	# under the same lamp, and two different light directions on one costume is more
	# obviously wrong than no shading at all was.
	var prof := limb_prof()
	var bands := int(prof[0])
	var fl := float(prof[1])
	var lu := float(prof[2])
	var lam := clampf(cos(u * (PI * 0.5) - lu * (PI * 0.5)) * 0.5 + 0.5, 0.0, 1.0)
	var q := floorf(lam * float(bands))
	q = clampf(q, 0.0, float(bands - 1))
	var f := fl + (1.0 - fl) * (q / float(bands - 1))
	return Color(col.r * f, col.g * f, col.b * f, col.a)


func draw_capsule_pix(a: Vector2, b: Vector2, wa: float, wb: float, col: Color) -> void:
	# THE SAME CAPSULE, RASTERISED ONTO THE ART GRID. One draw_rect per art row.
	#
	# WHY THIS EXISTS AND WHY IT IS NOT A SPRITE. The arms were the last part of the
	# figure off the grid, and it showed: with the torso, head and hands sprited, the
	# body stepped in clean 2px blocks while the arms kept smooth 1px diagonals, which is
	# the exact tell that says "vector art pretending to be pixel art".
	#
	# A sprite cannot fix it. draw_arm's bones are `maxf(46.0, reach * 0.56)`, so the
	# segments STRETCH with reach every frame, and a fixed sprite stretched to a variable
	# length is distortion rather than animation. Pre-rendering a rotation bank does not
	# help either, because the bank would have to be two-dimensional - angle by length.
	#
	# So the shape stays procedural and only its RASTERISATION changes. Filling by art row
	# gives genuine 2px quantisation at any angle and any length, with no assets, and it
	# tracks the IK exactly because it IS the IK.
	#
	# The span per row is the union of the two end discs and the connecting quad - which
	# is what draw_capsule actually draws, and deliberately not the convex hull of the two
	# discs. The quad uses a perpendicular offset rather than the true tangent, so the hull
	# would be very slightly fatter at the taper and the two versions would not A/B.
	#
	# Cost is one rect per art row (about 35 for an upper arm) against the two calls the
	# polygon version spends. Measured against the file's ~5us-per-call guidance that is
	# well under a millisecond for the whole figure, and it is only used on the arms.
	var ra := wa * 0.5
	var rb := wb * 0.5
	var d := b - a
	var L := d.length()
	var n := (Vector2(-d.y, d.x) / L) if L > 0.001 else Vector2.ZERO
	# the quad's four corners, in order, so consecutive pairs are its edges
	var q := [a + n * ra, b + n * rb, b - n * rb, a - n * ra]

	var top := minf(a.y - ra, b.y - rb)
	var bot := maxf(a.y + ra, b.y + rb)
	var y := floorf(top / ART_PIXEL) * ART_PIXEL
	while y < bot:
		var cy := y + ART_PIXEL * 0.5      # sample the row's CENTRE, not its top edge
		var lo := INF
		var hi := -INF
		for i in 2:
			var c: Vector2 = a if i == 0 else b
			var r: float = ra if i == 0 else rb
			var dy := cy - c.y
			if absf(dy) < r:
				var hw := sqrt(r * r - dy * dy)
				lo = minf(lo, c.x - hw)
				hi = maxf(hi, c.x + hw)
		if L > 0.001:
			for i in 4:
				var p: Vector2 = q[i]
				var s: Vector2 = q[(i + 1) % 4]
				if (p.y <= cy and s.y > cy) or (s.y <= cy and p.y > cy):
					var t := (cy - p.y) / (s.y - p.y)
					var x := p.x + (s.x - p.x) * t
					lo = minf(lo, x)
					hi = maxf(hi, x)
		if hi > lo:
			var x0 := floorf(lo / ART_PIXEL) * ART_PIXEL
			var x1 := ceilf(hi / ART_PIXEL) * ART_PIXEL
			# SHADED ACROSS THE LIMB, not across the screen row (2026-08-05, Louis: the
			# player looks flat). With the torso and legs carrying form, a flat arm was
			# the last thing on the figure with no volume in it at all.
			#
			# The coordinate that matters is the PERPENDICULAR distance from the limb's
			# own axis, never the position along the row - an arm reaching sideways has
			# rows that run ALONG it, and shading those would light the elbow differently
			# from the wrist. `perp` is linear in x at fixed y, so the exact x where each
			# band begins can be solved rather than sampled, and the near-horizontal case
			# falls out for free: n.x goes to zero, perp stops varying across the row, and
			# the row is one flat rect again at the cost it always was.
			var R := maxf(0.001, (ra + rb) * 0.5)
			var base := (cy - a.y) * n.y - 0.0
			if absf(n.x) < 0.02:
				var u0 := clampf((base - a.x * 0.0) / R, -1.0, 1.0)
				draw_rect(Rect2(x0, y, x1 - x0, ART_PIXEL), limb_shade(col, u0))
				y += ART_PIXEL
				continue
			# walk the band boundaries in x, clipped to this row's span
			var xs := PackedFloat32Array([x0])
			var nb := limb_bands()
			for k in nb - 1:
				var thr := -1.0 + 2.0 * float(k + 1) / float(nb)
				var xk := a.x + (thr * R - base) / n.x
				if xk > x0 and xk < x1:
					xs.append(xk)
			xs.append(x1)
			xs.sort()
			for i in xs.size() - 1:
				var sx := snappedf(xs[i], float(ART_PIXEL))
				var ex := snappedf(xs[i + 1], float(ART_PIXEL))
				if ex <= sx:
					continue
				var um := clampf(((sx + ex) * 0.5 - a.x) * n.x / R + base / R, -1.0, 1.0)
				draw_rect(Rect2(sx, y, ex - sx, ART_PIXEL), limb_shade(col, um))
		y += ART_PIXEL


func draw_arm(shoulder: Vector2, hand: Vector2, h: int, skin: Color, sleeve: Color,
		cuff: Color = Color(0, 0, 0, 0)) -> void:
	var bend := 1.0 if h == LEFT else -1.0            # elbows bow outward
	# bones scale to the reach (a touch over half each), so the elbow keeps the SAME
	# gentle bend whether the hand is out catching or tucked in holding a ball. Fixed
	# bones over-folded the close pose into a chicken wing.
	var reach := (hand - shoulder).length()
	var bone := maxf(46.0, reach * 0.56)
	var elbow := solve_elbow(shoulder, hand, bone, bone, bend)
	var wrist := hand + (elbow - hand).normalized() * 7.0   # forearm stops just short of the palm
	# THE SLEEVE RUNS TO THE WRIST (2026-07-29, Louis: "i believe a juggler has his costume
	# arms reach until his arms, not elbows. The only skin i should see are the hands (if not
	# wearing gloves) and the face"). He is right about the costume and right about the
	# picture: a performer in evening dress has no bare forearm, and the two skin-coloured
	# capsules were reading as rolled-up shirtsleeves on a man wearing a tailcoat. The whole
	# arm is cloth now, and the only skin below the collar is the hand itself.
	# draw_capsule_pix, not draw_capsule: same shape, rasterised onto the art grid so the
	# arms step in the same 2px blocks the sprited torso does. See draw_capsule_pix for
	# why this is a rasteriser change and not a sprite.
	draw_capsule_pix(shoulder, elbow, 19.0, 14.0, sleeve)  # upper arm, tapering to the elbow
	draw_capsule_pix(elbow, wrist, 13.0, 10.0, sleeve)     # forearm, same cloth, to the wrist
	draw_capsule_pix(elbow, elbow, 14.0, 14.0, sleeve)     # elbow joint (a capsule of zero length)
	if cuff.a > 0.0:
		# WARDROBE pass only (performer_polish): the jacket sleeve runs on down the
		# forearm and finishes in a shirt cuff, leaving bare wrist and hand for the
		# catch to read against. Anchored to the SOLVED elbow/wrist, so it tracks the
		# real arm at every frame instead of guessing a body-relative spot.
		var cs := elbow.lerp(wrist, 0.58)
		var ce := elbow.lerp(wrist, 0.76)
		draw_capsule_pix(elbow, cs, 13.5, 11.5, sleeve)
		draw_capsule_pix(cs, ce, 12.0, 11.5, cuff)


# two-bone IK: places the elbow so it sits exactly l1 from shoulder a and l2 from
# hand b, by treating a/b/elbow as a triangle and solving it with the law of
# cosines (x = how far along a->b the elbow's foot falls, hgt = its perpendicular
# height off that line). `bend` (+1/-1) picks which side of the a->b line the
# elbow bows to, since the triangle alone has two mirror-image solutions.
func solve_elbow(a: Vector2, b: Vector2, l1: float, l2: float, bend: float) -> Vector2:
	var ab := b - a
	var dist := clampf(ab.length(), 0.001, l1 + l2 - 0.001)
	var dir := ab / ab.length() if ab.length() > 0.001 else Vector2.DOWN
	var x := (dist * dist + l1 * l1 - l2 * l2) / (2.0 * dist)
	var hgt := sqrt(maxf(l1 * l1 - x * x, 0.0))
	var perp := Vector2(-dir.y, dir.x) * bend
	return a + dir * x + perp * hgt


func owns_any(piece: String) -> bool:
	# do you own THIS GARMENT in any house's cut at all. Used by the legacy save keys and by
	# nothing that scores - a garment you own but are not wearing buys you nothing now.
	for st in MAX_VENUE + 1:
		if owns_wear(piece, st):
			return true
	return false


func wear_key(piece: String, stage: int) -> String:
	return "%s:%d" % [piece, stage]


func owns_wear(piece: String, stage: int) -> bool:
	return owned_wear.has(wear_key(piece, stage))


# THE TAILOR'S MIRROR SHOWS WHAT THE CURSOR IS ON (2026-07-29, Louis: "i want when hovering
# over something it to be equipped - on the left, not actually selecting it to use, just to
# show"). Rather than thread a "pretend this is worn" argument through draw_juggler and every
# garment it draws, the mirror sets this pair for the duration of ONE figure and worn_stage
# answers with it. It is draw-time only and always restored, exactly like the wordmark's
# `_cap_a`, so nothing outside that one call can see a garment the player is not wearing -
# and in particular nothing that SCORES can, since costume_set_bonus reads wear_matches,
# which reads worn_stage.
var _fit_piece := ""
var _fit_stage := -1

func worn_stage(piece: String) -> int:
	# which STAGE'S cut of this piece is on him, or -1 for none. A piece can only be worn if
	# it is also owned - a save that loses a purchase (it cannot, but the invariant is cheap)
	# can never leave him wearing something he does not have.
	if piece == _fit_piece:
		return _fit_stage
	var s := int(worn_piece.get(piece, -1))
	return s if s >= 0 and owns_wear(piece, s) else -1


func wearing(id: String) -> bool:
	# IS IT ON HIM. Every drawing asks this and every BUFF asks it too, now that the tailor is
	# a real loadout (Louis: "I'd rather the tailor be a real loadout: buffs follow wearing").
	# A LESSON IS PLAIN, ALWAYS (2026-07-29, Louis: "without any special things or props").
	# Every wardrobe piece and its buff route through this one function, so refusing here
	# is the whole fix: nothing bought with a real career's flowers should ever show up
	# (or help) in a first-timer's tutorial, and a returning player's own lesson (a new
	# prop, a new trick) should look and play the same for everyone taking it.
	if tut_active:
		return false
	# --chargear: the wardrobe seam keys (hat, glasses, helmet, boots, gloves) can only be
	# REACHED when the piece is actually worn, so a reference pass with an empty wardrobe
	# derives nothing for them and the miss looks like a broken script. This forces every
	# piece on for the isolated figure render only, and it is gated on _charref as well as
	# its own flag so it can never affect a real career.
	if _chargear and _charref:
		# --charhide names one piece to leave OFF. Some garments are mutually exclusive in
		# the drawing - a top hat wins over a helmet - so with everything worn the loser's
		# seam key is never reached and its art can never be derived. Hiding the winner is
		# the only way to photograph it.
		return id != _charhide
	return worn_stage(id) >= 0


func wear_matches(piece: String) -> bool:
	# ...AND IS IT THE RIGHT ONE FOR TONIGHT. This is the whole of Louis's set mechanic: a
	# garment cut for the house you are playing works, one cut for another house is just
	# clothes. `cur_venue` rather than the tailor's chosen suit, because the point is to dress
	# FOR the room.
	return worn_stage(piece) == cur_venue()


func wear_category(piece: String) -> String:
	# THE SLOT A GARMENT OCCUPIES (2026-07-30, Louis: "you shouldn't be able to put multiple
	# clothes of the same category on at once ... headwear: either a hat or the drinking
	# cap"). Every piece is its own category except the two that share the top of the head -
	# a performer cannot wear a top hat and the Energy Helmet at once, however well both are
	# cut for tonight. Singleton categories cost nothing to declare and mean the rest of the
	# tailor (the exclusivity rule, the set-completion count) never has to special-case the
	# head: "one piece per category" is the one rule, everywhere.
	return "head" if piece == "hat" or piece == "helmet" else piece


func wear_categories() -> Array:
	var seen: Array = []
	for p in WEAR_PIECES:
		var c := wear_category(p)
		if not seen.has(c):
			seen.append(c)
	return seen


func wear_category_matches(cat: String) -> bool:
	# is SOME piece in this slot on, and cut for tonight - the category-level wear_matches.
	for p in WEAR_PIECES:
		if wear_category(p) == cat and wear_matches(p):
			return true
	return false


func wear_category_label(cat: String) -> String:
	# the rack's own group heading, only ever drawn over a category with more than one
	# member - see the loop in draw_tailor.
	return "HEADWEAR" if cat == "head" else cat.to_upper()


func wear_clear_category(piece: String) -> void:
	# takes off every OTHER garment sharing this one's slot, so putting a piece on can never
	# leave two occupying the same category - the enforcement half of wear_category. Called
	# right before a piece is actually worn (tailor_wear, tailor_buy, try_outfit_tonight).
	var cat := wear_category(piece)
	for p2 in WEAR_PIECES:
		if p2 != piece and wear_category(p2) == cat:
			worn_piece.erase(p2)


func wear_normalize() -> void:
	# A LOADED SAVE CAN PREDATE THE RULE (2026-07-30) - either an old tailor save written
	# before categories existed, or the pre-tailor migration a few lines up in
	# load_progress, which sets every owned piece's flag straight from a flat bool with no
	# notion of a slot at all. Keep only the first match per category (WEAR_PIECES order)
	# and drop the rest, so a loaded save can never show a performer wearing a top hat and
	# the Energy Helmet at once.
	var claimed: Array = []
	for p in WEAR_PIECES:
		if worn_stage(p) < 0:
			continue
		var c := wear_category(p)
		if claimed.has(c):
			worn_piece.erase(p)
		else:
			claimed.append(c)


func costume_set_bonus() -> float:
	# HOW MUCH OF TONIGHT'S SET YOU ARE ACTUALLY WEARING, as a score multiplier. Every matching
	# CATEGORY pays (not every piece - the head is one slot, not two), and the full set pays
	# best, a little more than the sum of its parts so that completing one is a real goal
	# rather than a rounding error.
	var cats := wear_categories()
	var n := 0
	for c in cats:
		if wear_category_matches(c):
			n += 1
	if n <= 0:
		return 1.0
	var m := 1.0 + SET_PIECE_BONUS * float(n)
	if n >= cats.size():
		m *= SET_FULL_BONUS
	return m


func costume_palette() -> Dictionary:
	# WHICH STAGE'S COSTUME HE IS IN. -1 means the one he is standing on, which is what the
	# game did before the tailor existed and is still the default. A chosen suit is clamped
	# to what this career has actually reached, so a save that loses reputation (or a demo
	# build's venue cap) can never leave him in a costume he has no right to.
	if _charid:
		# --charid: paint every costume region a unique flat colour so a render becomes a
		# REGION ID MAP. This is how the per-region body sprites are cut: which pixels are
		# "suit" and which are "vest" is a question the game can answer exactly, and asking
		# it is far better than sampling a normal render and hoping two similar browns
		# separate cleanly. The values are deliberately saturated primaries no costume
		# would ever contain, so classification is an equality test rather than a nearest
		# match, and they carry alpha 1 so nothing blends into an ambiguous in-between.
		return {
			"suit": Color(1, 0, 0), "suit_dk": Color(0, 1, 0), "vest": Color(0, 0, 1),
			"collar": Color(1, 1, 0), "glow": Color(1, 0, 1), "shoe": Color(0, 1, 1),
			"trouser": Color(1, 0.5, 0), "button": Color(0.5, 0, 1),
		}
	if outfit_suit >= 0:
		return venue_data(clampi(outfit_suit, 0, venue_index()))
	return venue_data(cur_venue())


func suit_name(i: int) -> String:
	return String(venue_data(i)["name"])


func wear_cost(piece: String, stage: int) -> int:
	# what this garment costs IN THIS HOUSE'S CUT. The base is the piece's own worth and the
	# multiplier is the house's - see WEAR_STAGE_COST. Rounded to a readable figure rather
	# than left at 1,417, because a shop price with three significant figures reads as a price
	# and one with four reads as an accident.
	var base := float(wear_piece_def(piece).get("cost", 0))
	var m: float = WEAR_STAGE_COST[clampi(stage, 0, WEAR_STAGE_COST.size() - 1)]
	var raw := base * m
	var step := 100.0 if raw < 5000.0 else 500.0
	return int(round(raw / step) * step)


func wear_piece_def(piece: String) -> Dictionary:
	# ONE ROW PER GARMENT: what it is called, what it costs, and what wearing it does. The cost
	# is per STAGE cut, so a full wardrobe for one house is the sum of these and a full wardrobe
	# for every house is seven times that - which is the late-game money sink the economy wanted.
	match piece:
		# `gear` is the id draw_gear_icon knows this object by, which is not always the
		# piece's own id - the glow SUIT's picture is filed under "glow_suit" because the shop
		# once sold a tape and a kit beside it.
		"glasses": return {"name": "Glasses",          "gear": "glasses", "cost": GLASSES_COST,       "note": "+%d%% to every off-Perfect catch" % int(GLASSES_CATCH_BONUS * 100.0)}
		"gloves":  return {"name": "Silk Gloves",      "gear": "gloves", "cost": GLOVES_COST,        "note": "a club's forgiveness on every prop"}
		"boots":   return {"name": "Stage Boots",      "gear": "boots", "cost": BOOTS_COST,         "note": "every throw costs one less stamina"}
		"hat":     return {"name": "Top Hat",          "gear": "hat", "cost": HAT_COST,           "note": "better tributes, more often"}
		"coat":    return {"name": "Tailcoat",         "gear": "coat", "cost": COAT_COST,          "note": "the crowd warms %d%% faster" % int(round((COAT_WARM - 1.0) * 100.0))}
		"vest":    return {"name": "Sequin Waistcoat", "gear": "vest", "cost": VEST_COST,          "note": "+%d%% flowers thrown" % int(round((VEST_RATE - 1.0) * 100.0))}
		"helmet":  return {"name": "Energy Helmet",    "gear": "helmet", "cost": ENERGY_HELMET_COST, "note": "drinks pour themselves as you run dry"}
		"glow":    return {"name": "Glow Suit",        "gear": "glow_suit", "cost": GLOW_SUIT_COST,     "note": "you glow on a dark stage instead of vanishing into it"}
	return {"name": piece, "cost": 0, "note": ""}


func tailor_buy(piece: String, stage: int) -> void:
	var d := wear_piece_def(piece)
	var cost := wear_cost(piece, stage)
	if owns_wear(piece, stage) or money < cost:
		if money < cost:
			set_day_msg("not enough %s  -  %s asks %s" % [coin_word(), String(d["name"]), commafy(cost)])
			play_sfx("whiff", -10.0)
		return
	if not confirm_spend("wear_%s_%d" % [piece, stage], cost, false):
		return
	money -= cost
	owned_wear.append(wear_key(piece, stage))
	wear_clear_category(piece)     # ONE PIECE PER CATEGORY - see wear_category
	worn_piece[piece] = stage      # a thing you just bought goes straight on. Nobody buys a hat
								   # to leave it in a box.
	save_progress()
	play_sfx("money", -6.0)


func tailor_wear(piece: String, stage: int) -> void:
	# WEAR IT, OR TAKE IT OFF. Pressing the cut you are already wearing removes it, which is
	# the only way to go bare-headed and is worth having: a piece cut for the wrong house is
	# not merely useless, it is a slot you could be scoring with.
	if not owns_wear(piece, stage):
		tailor_buy(piece, stage)
		return
	if int(worn_piece.get(piece, -1)) == stage:
		worn_piece.erase(piece)
	else:
		wear_clear_category(piece)   # ONE PIECE PER CATEGORY - a hat and the Energy Helmet
									  # can never both be on him (see wear_category)
		worn_piece[piece] = stage
	save_progress()
	play_sfx("ui2", -13.0)


func try_outfit_tonight() -> void:
	# THE WHOLE SET, IN ONE PRESS (2026-07-29): the rack's own version of the shop's "B
	# buys the whole shortfall" (try_top_up). Buying one piece at a time, one Enter each,
	# is fine for trying things on but a poor way to dress for a house you already know
	# you want fully kitted - and unlike props, a set is several DIFFERENT prices, so this
	# buys cheapest first, stopping the moment the purse cannot take the next one, rather
	# than either refusing outright or leaving the purse a strange amount short of a
	# piece it could have covered by skipping to the next-cheapest one instead. Anything
	# already owned for tonight but not yet worn (a cut bought on an earlier visit) is
	# put on too, at no cost - the same as pressing Enter on it directly.
	#
	# ONE PIECE PER CATEGORY (2026-07-30): the head slot now has two candidates (hat,
	# helmet), so this can no longer just walk every piece and buy whatever is affordable -
	# that would dress him in both at once, which is exactly the thing wear_category exists
	# to stop. It picks the best candidate PER CATEGORY first: whichever is already owned
	# for tonight if either is (free beats a fresh purchase every time), else the cheaper
	# of the two to buy.
	var st := cur_venue()
	var pick: Dictionary = {}   # category -> the one piece chosen to fill it tonight
	for c in wear_categories():
		if wear_category_matches(c):
			continue   # already dressed for tonight in this slot
		var options: Array = []
		for p in WEAR_PIECES:
			if wear_category(p) == c:
				options.append(p)
		options.sort_custom(func(a, b):
			var oa := owns_wear(a, st)
			var ob := owns_wear(b, st)
			return wear_cost(a, st) < wear_cost(b, st) if oa == ob else oa)
		pick[c] = options[0]
	var to_buy: Array = []
	var spent := 0
	for c2 in pick:
		var p := String(pick[c2])
		if owns_wear(p, st):
			continue
		var cost := wear_cost(p, st)
		if spent + cost > money:
			continue
		to_buy.append(p)
		spent += cost
	var to_wear: Array = []
	for c3 in pick:
		var p2 := String(pick[c3])
		if owns_wear(p2, st) and worn_stage(p2) != st:
			to_wear.append(p2)
	if to_buy.is_empty() and to_wear.is_empty():
		set_day_msg("already dressed for %s tonight" % suit_name(st))
		play_sfx("whiff", -10.0)
		return
	if not to_buy.is_empty():
		if not confirm_spend("outfit_%d" % st, spent, true):
			return
		money -= spent
		for p3 in to_buy:
			owned_wear.append(wear_key(p3, st))
			wear_clear_category(p3)
			worn_piece[p3] = st
	for p4 in to_wear:
		wear_clear_category(p4)
		worn_piece[p4] = st
	save_progress()
	if to_buy.is_empty():
		set_day_msg("the rest of tonight's set is on")
		play_sfx("ui2", -13.0)
	else:
		set_day_msg("%d piece%s for %s  -  %s %s" % [to_buy.size(), "" if to_buy.size() == 1 else "s",
			suit_name(st), commafy(spent), coin_word()])
		play_sfx("money", -6.0)


func tailor_input(kc: int) -> void:
	# ONE GRID, AND ONLY ONE (2026-07-29, Louis: "remove the full costumes"). There used to be
	# a SUIT column beside the rack, choosing which house's base costume the performer wore,
	# and it was the source of his other complaint here - "if i select for example the backyard
	# costume, it won't let me equip special parts of other ones". It always did equip them;
	# what it did not do was SHOW them, because the mirror was drawn in the chosen suit's
	# colours and a waistcoat from another house is nearly invisible against the wrong palette.
	# A control that appears to refuse is worse than one that does, so the whole column is
	# gone: the costume follows the stage you are playing, which is what it did before the
	# picker existed, and the rack is the screen.
	#
	# The garment down the side, the house across the top. Up/Down walk the garments,
	# Left/Right the houses, Enter wears or buys whatever the cursor is on.
	outfit_suit = -1
	var n := WEAR_PIECES.size()
	match kc:
		KEY_TAB, KEY_ESCAPE:
			tailor_open = false
			play_sfx("ui", -13.0)
		KEY_UP, KEY_W:
			tailor_sel = (tailor_sel + n - 1) % n
			play_sfx("ui", -15.0)
		KEY_DOWN, KEY_S:
			tailor_sel = (tailor_sel + 1) % n
			play_sfx("ui", -15.0)
		KEY_LEFT, KEY_A:
			tailor_stage = maxi(tailor_stage - 1, 0)
			play_sfx("ui", -15.0)
		KEY_RIGHT, KEY_D:
			tailor_stage = mini(tailor_stage + 1, venue_index())
			play_sfx("ui", -15.0)
		KEY_ENTER, KEY_KP_ENTER:
			tailor_wear(WEAR_PIECES[clampi(tailor_sel, 0, WEAR_PIECES.size() - 1)],
				clampi(tailor_stage, 0, venue_index()))
		KEY_B, KEY_SPACE:
			# OUTFIT THE WHOLE SET FOR TONIGHT, in one press - the rack's own version of
			# the shop's "B buys the whole shortfall". KEY_SPACE for the pad, same reason
			# the shop takes it: X routes to Space outside live play.
			try_outfit_tonight()


func glove_cloth() -> Color:


	# the silk gloves' cloth, resolved the same way every other wardrobe colour is: the
	# venue's shirt/collar tone, swapped for phosphor when the Glow Suit is lit. It lives
	# in its own function because draw_hand is reached without the palette in hand, and
	# the alternative - re-deriving a white in there - is exactly how a piece ends up
	# lighting a stage that was built to stay dark.
	if glow_suit_lit():
		return Color(0.90, 1.0, 0.94)
	return venue_data(cur_venue())["collar"]


func draw_mitt(pos: Vector2, close: float, inward: float) -> void:
	# ONE HAND, EVERYWHERE. The mitt and the silk glove, at the figure's real proportions,
	# for the stage, the tailor's mirror and the skills preview alike. It is split out of
	# draw_hand because only the stage has props to rest in the palm afterwards - the shape
	# of the hand itself has never been screen-specific and should not have been written
	# twice. `inward` is +1 for the LEFT hand and -1 for the RIGHT: it mirrors one asset
	# onto both sides and points the thumb toward the body, the same convention the rack
	# icon uses.
	# a clean rounded mitt with NO fingers (Louis: they looked bad and are not
	# needed): a palm disc with a soft cup that stretches up a little to receive
	# when open and settles round when closed
	var sk := Color(0.87, 0.63, 0.43)
	# WARDROBE: SILK GLOVES (2,500). The one piece with nowhere to live but here - a glove
	# is the hand, so it is a RECOLOUR of the mitt plus a wrist opening, not a shape laid
	# over it. That also means it cannot come adrift: the hand is wherever the IK put it,
	# and this draws the same ellipse the bare hand does.
	#
	# The cloth is the venue's own collar/shirt colour, for the reason the cuff already
	# uses it - a hard white glove would light the Midnight Show's vanishing costume
	# straight back up, and these are dress gloves, not surgical ones.
	var gloved := wearing("gloves")
	if gloved:
		sk = glove_cloth()
	var openf := 1.0 - close
	# --charopen: hold the hand OPEN for a reference render. The open and closed mitts
	# are separate seam keys, and which one a capture reaches depends on where hclose
	# happens to be on that tick - so without this the open variants come out empty and
	# it looks like the deriver failed rather than like the frame simply had shut hands.
	if _charopen and _charref:
		openf = 1.0
	var stretch := lerpf(0.0, 6.0, openf)
	var mitt_c := pos + Vector2(inward * openf * 1.5, -stretch * 0.5)
	# SEAM, and the first place the remaster will want an AnimatedSprite2D rather than a
	# still. The hand OPENS AND CLOSES continuously (`close` is a float, not a flag) and
	# that motion is how the no-crossing choreography reads, so a single frame would lose
	# real information. Two keys and a threshold is the honest still-image approximation;
	# when the art is ready, swap this pair for a strip indexed by `close` and nothing
	# outside this function changes. `inward` mirrors one asset onto both hands.
	# The catch glow above stays procedural on purpose: it is gameplay FEEDBACK, not
	# artwork, and it has to keep reading identically while the art is in flux.
	# The GLOVED key is separate because a glove is a different object, not a tint - the
	# procedural version below already treats it that way (its own outline, its own hem and
	# stitching), so the art must be allowed to as well.
	var mitt_key := ("char/glove_" if gloved else "char/hand_") + ("open" if openf > 0.5 else "closed")
	var mitt_art := art_blit_size(mitt_key, mitt_c,
		Vector2(inward * 23.0, 23.0 + stretch * 2.0), 0.0, sk)
	# NOTE the deliberate absence of an early `return` here: this function still has to draw
	# the props RESTING IN THE PALM further down, and "a prop in a hand is drawn in that
	# hand, with no exceptions" is a standing rule of this file. Only the MITT is replaced.
	if not mitt_art:
		if gloved:
			# SILK GLOVES, third pass (2026-07-31, Louis: "the gloves still look horrible on the
			# player and in the tailor"). The second pass added a thumb, which was the right
			# instinct - a glove has a shape a bare hand does not - but drew it as its own
			# 5-point polygon glued to the palm ellipse, so the two pieces never quite agreed at
			# the seam and it read as a blob with a fin on it. mitt_shape draws the thumb as a
			# bulge in the SAME outline the palm is, one continuous edge, no seam to disagree at.
			draw_colored_polygon(mitt_shape(mitt_c, 11.5, 11.5 + stretch, inward * -1.15, 0.62), sk)
		else:
			fill_ellipse(mitt_c, 11.5, 11.5 + stretch, sk)
		draw_circle(pos + Vector2(0, -2), 8.0, Color(1.0, 0.82, 0.55, 0.12))
		if gloved:
			var hem := sk.darkened(0.18)
			var seam := sk.darkened(0.30)
			# ONE stitch line along the thumb ridge - the bulge itself now says "glove", so this
			# is the seam a real one would show there, not three lines pretending to be several
			draw_line(pos + Vector2(inward * 5.4, -1.6), pos + Vector2(inward * 11.6, -9.0),
				Color(seam.r, seam.g, seam.b, 0.5), 1.1)
			# the wrist opening: a band with a scalloped lower edge and a button at the side,
			# which is what a dress glove closes with
			var wy := pos.y + 7.2
			draw_colored_polygon(PackedVector2Array([
				Vector2(pos.x - 10.4, wy - 3.4), Vector2(pos.x + 10.4, wy - 3.4),
				Vector2(pos.x + 9.0, wy + 4.4), Vector2(pos.x + 3.4, wy + 2.2),
				Vector2(pos.x, wy + 5.6), Vector2(pos.x - 3.4, wy + 2.2),
				Vector2(pos.x - 9.0, wy + 4.4)]), hem)
			draw_line(Vector2(pos.x - 10.0, wy - 2.6), Vector2(pos.x + 10.0, wy - 2.6), Color(1, 1, 1, 0.30), 1.3)
			draw_circle(Vector2(pos.x + inward * 7.4, wy + 0.6), 1.5, Color(seam.r, seam.g, seam.b, 0.85))
			# the silk's own sheen: one small filled highlight, up and left like every other
			# light on this stage
			fill_ellipse(pos + Vector2(-3.6, -4.6 - stretch * 0.4), 4.2, 2.8, Color(1, 1, 1, 0.30))

func draw_hand(h: int) -> void:
	var pos: Vector2 = fig_hand_pos(h)
	var close: float = hclose[h]
	var inward := 1.0 if h == LEFT else -1.0          # +x points toward centre for L

	# catch glow
	var g := 0.0
	var cf := tick - int(catch_flash[h])
	if cf >= 0 and cf < 14:
		g = 1.0 - float(cf) / 14.0
	if g > 0.0:
		draw_circle(pos, 20.0 + g * 12.0, Color(1.0, 0.82, 0.45, 0.35 * g))

	# THE MITT, drawn by the one hand renderer every screen shares - see draw_mitt. It
	# used to live inline here, which meant the tailor's mirror (the room whose entire
	# job is showing a garment) drew its own plain circle for a hand and its own
	# hand-tuned lump for a glove, at proportions that agreed with neither.
	#
	# ...unless the figure is ANIMATED, in which case the hands are painted into the frame
	# and a mitt on top is a second hand growing out of the first. The catch glow above and
	# the held props below still draw: those are gameplay feedback, not anatomy, and they
	# have to keep reading identically whatever the figure is made of.
	# ...OR when the painted arm could not reach this far, which in practice means a columns
	# hand standing under a central lane (see fig_palm_far). The prop is drawn on its lane
	# because that is where it is; without this there is a catch ring and a ball hanging in
	# open air with the performer's hands somewhere else entirely.
	if fig_anim_live():
		# ...OR the painted arm could not reach this far, which in practice means a columns
		# hand standing under a central lane (see fig_palm_far). The prop is drawn on its lane
		# because that is where it is; without a hand there, the catch ring and the ball hang
		# in open air while the performer's hands are somewhere else entirely.
		# ...but NOT during a painted turn. That fallback blits the performer's own hand cut
		# out of the FRONT view, so laying it over a body seen edge-on or from behind is a
		# front-facing palm stuck to his back. Held props below still draw, because where a
		# prop is remains a fact about the simulation however the man is facing.
		if fig_palm_far(h) and not (spinning() and fig_spin_on()):
			draw_figure_palm(h, pos)
	else:
		draw_mitt(pos, close, inward)

	# held ball(s) rest in the palm - INCLUDING the Columns middle ball, which used to be
	# drawn at stage centre while held. That was a fix for an older hand placement: the
	# ball was put where it would launch from, because the hand was not there. Now the
	# hand goes to its own column (hand_target) and stops just outside the torso, so a
	# middle ball drawn at centre would be the thing floating free of the hand instead.
	# A prop in a hand is drawn in that hand, with no exceptions - that is the rule that
	# stops these two ever disagreeing again.
	# --charref draws the figure to be traced into sprites, and a prop resting in the palm
	# would be cropped into the hand sprite along with the hand. This is the ONLY place the
	# reference mode touches the figure, and it removes an object rather than changing one.
	var st: Array = [] if _charref else stack(h)
	for i in st.size():
		var bp := pos
		# THE ONE CASE "drawn in that hand, no exceptions" (above) still needs a beat of
		# help: Full-Hand-Catch (`set_catch_full`, an accessibility setting, OFF by
		# default) lets a second ball land into a hand that is still holding the first -
		# and hand_target deliberately never eases that hand toward an incoming ball
		# while it holds one (2026-07-27, see hand_target), so the newly-caught ball's
		# last FLIGHT frame is out at its true landing point while this, its first HELD
		# frame, is back at the hand's held/throw position. A hard cut between those two
		# reads as a teleport. This is not the old bug (a ball parked somewhere and left
		# there) - it settles to `pos` well inside a tenth of a second and only ever
		# triggers for the ball that was JUST added on top of an already-full hand.
		if i == st.size() - 1 and st.size() > 1:
			var settle := clampf(float(tick - catch_flash[h]) / CATCH_SETTLE_TICKS, 0.0, 1.0)
			if settle < 1.0:
				bp = flight_pos(st[i]).lerp(pos, 1.0 - (1.0 - settle) * (1.0 - settle))   # ease-out
		draw_prop(st[i], bp + Vector2(0, -3 - float(i) * 6.0))


func draw_targets() -> void:
	# a landing ring brightens as a catch nears, and its COLOUR teaches the timing,
	# all within the game's warm gold family (Louis: no green on stage): faint gold
	# on approach, bright gold while the press would land Good, a white flash inside
	# the Perfect band, dimming amber once the moment is slipping late.
	if encore_on("fright"):
		return   # Stage Fright: the lights are in your eyes, no landing markers at all
	var wp := perfect_window()
	# when two balls are both bound for the same hand (a fast fountain/columns feed,
	# or just a high count), only the SOONEST one gets a landing ring - a hand can
	# only catch one at a time, so a second ring there is clutter, not information
	# (mirrors the tutorial timing-ring fix)
	var soonest: Array[Ball] = [null, null]
	for b in balls:
		if b.state != STATE_FLIGHT:
			continue
		var dd := b.land_tick - tick
		if dd < -MISS_GRACE or dd >= 46:
			continue
		var h := clampi(b.to_hand, 0, 1)
		if soonest[h] == null or dd < soonest[h].land_tick - tick:
			soonest[h] = b
	for h in [LEFT, RIGHT]:
		var b: Ball = soonest[h]
		if b == null:
			continue
		var dd := b.land_tick - tick
		var t := clampf(1.0 - float(maxi(dd, 0)) / 46.0, 0.0, 1.0)
		var adiff := absi(dd)
		var r := 22.0 * prop_scale(b.kind)
		# a clacked ball (hard mode) catches ONLY inside the Perfect window
		# (same frames as normal): its ring stays warning-hot outside it, so
		# the taught timing never lies about what will actually catch
		# ON THE ART GRID. This ring is the single most-looked-at thing on the stage - it is
		# the timing cue the whole game is played off - and it was the last antialiased circle
		# in front of the player, sitting over crisp props and a crisp performer.
		if adiff <= wp:
			draw_ring_pix(b.to_pos, r, 5.0, Color(1.0, 1.0, 0.9, 0.95))
			fill_disc_pix(b.to_pos, r * 0.55, Color(1.0, 0.95, 0.7, 0.25))
		elif adiff <= good_window():
			draw_ring_pix(b.to_pos, r, 4.0, Color(1.0, 0.88, 0.5, 0.9))
		elif adiff <= late_window() and dd < 0:
			draw_ring_pix(b.to_pos, r, 3.0, Color(0.9, 0.62, 0.35, 0.7))
		else:
			draw_ring_pix(b.to_pos, r, 2.0 + 3.0 * t, Color(1.0, 0.9, 0.5, 0.14 + 0.5 * t))


func _btb_behind(b: Ball) -> bool:
	# a Behind-the-Back ball spends the first stretch of its flight hidden BEHIND
	# the figure (it was released behind the body), then pops out past the
	# shoulder. Behind = early in the flight AND still over the torso; once it
	# drifts wide or crests, it draws in front like everything else.
	if b.trick != TR_BTB:
		return false
	var span := maxi(1, b.land_tick - b.launch_tick)
	var p := clampf(float(tick - b.launch_tick) / float(span), 0.0, 1.0)
	return p < 0.35 and absf(flight_pos(b).x - stage_center().x) < 90.0


#endregion

#region PROP DRAWING
func draw_balls_in_flight(behind: bool = false) -> void:
	# two passes (see the play draw): the `behind` pass runs BEFORE the juggler
	# so a Behind-the-Back throw genuinely disappears behind the body
	for b in balls:
		if b.state == STATE_FLIGHT:
			if _btb_behind(b) != behind:
				continue
			# BLACKOUT, rebuilt 2026-07-27 (Louis's own call, picked over two alternatives).
			# THE CHALLENGE IS SIMPLY THAT THE ROOM IS DARK. A prop is its glow-in-the-dark
			# self for the WHOLE flight - same look on the rise, at the apex and on the way
			# down - and nothing about it changes partway.
			#
			# What this replaces, and why: the lights used to be cut at BLACKOUT_CUT (0.68
			# of the flight), swapping a full-colour prop for a shapeless afterglow in a
			# single frame. Two things were wrong with it. The switch was abrupt - the
			# object visibly changed colour mid-air - and there is no good place to put
			# such a switch, because any threshold is a cliff. Louis: "perhaps you should
			# even just make the challenge entirely: the objects are hard to see, because
			# it is dark. then you don't need to fade." Which is the better design: no
			# cliff, no cross-fade to tune, one honest rule, and the encore text can now
			# say exactly what happens.
			#
			# The SHAPE is kept for everyone, deliberately. Handing the non-Kit player a
			# shapeless glow for a whole flight would be juggling blind, which was tried
			# and rejected once already as "way too difficult" (Louis) - and it was only
			# ever survivable before because the rise was fully lit. The Glow Kit is now
			# the difference between a prop you can READ and one you can only find (see
			# `lit`), which is a better thing to sell than a mercy on one Encore. A TORCH
			# is still the exception the Encore is built around: it carries its own fire.
			if encore_on("blackout"):
				var dark_pos := flight_pos(b)
				# **AND AN UNLIT PROP IS NOW SIMPLY NOT THERE** (2026-07-29, Louis: "make
				# normal objects (not glow in the dark) completely invisible - so it is
				# possible, but incredibly hard to juggle"). It used to be drawn at
				# BLACKOUT_UNLIT, a dim silhouette, which is the compromise this entry's
				# earlier paragraphs argue for. He has overruled it, and the reason the
				# overrule is safe is the new ownership gate: Blackout cannot roll at all
				# until you own three glowing balls or torches (see encore_pool), so nobody
				# meets this challenge without the answer to it already in the bag. What
				# used to be a mercy is now the price of admission.
				# A TORCH IS THE EXCEPTION AND ONLY HALF AN EXCEPTION: the flame and its
				# glow are always visible, because fire is fire, but the HANDLE under it
				# vanishes with everything else unless the torch itself is a glowing one.
				if b.kind == PROP_TORCHES:
					draw_flame_in_dark(b, dark_pos)
					if prop_glows(b.kind):
						draw_glow_in_dark(dark_pos, b.color, b.kind, prop_scale(b.kind),
							prop_spin_angle(b), 1.0)
				elif prop_glows(b.kind):
					draw_glow_in_dark(dark_pos, b.color, b.kind, prop_scale(b.kind),
						prop_spin_angle(b), 1.0)
				continue
			draw_trail(b)
			var pos := flight_pos(b)
			draw_prop(b, pos)
			if pos.y < -8.0:
				# a fully HELD High Toss climbs clean out of the frame for a beat: a
				# small chevron pointing up tracks the ball's x so the player never
				# loses the prop, only sees it leave. It sits just BELOW the top-centre
				# HUD (the mode title and Applause meter live on the frame edge itself,
				# and a crossing toss spends its apex right over them). Fades in with
				# how far above the frame the ball is, so a barely-cresting throw
				# does not flicker it.
				var above := clampf((-8.0 - pos.y) / 40.0, 0.0, 1.0)
				var mc := Color(b.color.r, b.color.g, b.color.b, 0.35 + 0.5 * above)
				var mx := pos.x
				draw_colored_polygon(PackedVector2Array([
					Vector2(mx - 7.0, 67.0), Vector2(mx + 7.0, 67.0), Vector2(mx, 58.0)]), mc)
				draw_rect(Rect2(mx - 1.0, 70.0, 2.0, 9.0), Color(mc.r, mc.g, mc.b, mc.a * 0.45))


func draw_trail(b: Ball) -> void:
	# the comet tail behind a flying prop: longer for higher throws, its colour
	# cooling toward a pale blue with height, so a risky throw is visibly risky
	var n := b.trail.size()
	if n < 2:
		return
	var cool := clampf(b.height * 0.5, 0.0, 0.6)
	var base := b.color.lerp(Color(0.72, 0.82, 1.0), cool)
	var sc := prop_scale(b.kind)
	# A path that DOUBLES BACK cannot be one ribbon, and one pattern makes that the
	# normal case: a Column goes straight up and straight down the same line, so the
	# offset that builds the strip flips to the other side at the apex and the polygon
	# ties itself in a bow. Godot's triangulator refuses it, once per prop per frame -
	# the other half of the "Invalid polygon data" spam (the first half was crowded
	# samples, fixed at the sampler in update_sim). A retracing tail has no width to
	# show anyway, so it falls back to a plain stroked line: no triangulation, one draw
	# call either way, and on screen the difference is a column's tail losing a taper
	# nobody could have seen on a 6px-wide vertical path.
	for i in range(1, n - 1):
		if (b.trail[i] - b.trail[i - 1]).dot(b.trail[i + 1] - b.trail[i]) < 0.0:
			draw_polyline(b.trail, Color(base.r, base.g, base.b, 0.16), 3.0 * sc, true)
			return
	# ONE tapered ribbon with a per-vertex alpha ramp, not one circle per sample. A
	# trail runs to 16 samples and a big set has seven props in the air, so the old way
	# was up to 112 draw calls a frame for the comet tails alone - measured at roughly
	# half of everything the props cost. The shape it draws is the same comet: it
	# widens toward the head and fades out toward the tail, just built as a strip.
	var pts := PackedVector2Array()
	var cols := PackedColorArray()
	pts.resize(n * 2)
	cols.resize(n * 2)
	for i in n:
		var f := float(i + 1) / float(n)   # 0 tail .. 1 head
		var w := (1.4 + 5.2 * f) * sc
		var d: Vector2
		if i == 0:
			d = b.trail[1] - b.trail[0]
		elif i == n - 1:
			d = b.trail[n - 1] - b.trail[n - 2]
		else:
			d = b.trail[i + 1] - b.trail[i - 1]
		if d.length_squared() < 0.0001:
			d = Vector2.RIGHT
		var perp := Vector2(-d.y, d.x).normalized() * w
		var c := Color(base.r, base.g, base.b, 0.20 * f * f)
		pts[i] = b.trail[i] + perp                 # one side, tail to head...
		cols[i] = c
		pts[n * 2 - 1 - i] = b.trail[i] - perp     # ...and back down the other
		cols[n * 2 - 1 - i] = c
	draw_polygon(pts, cols)


func draw_charge_gauges() -> void:
	# while THROW is held, a slim gauge grows beside that hand: warm gold is a snappy
	# controlled throw, amber buys airtime, red is the wild top. The old green start
	# and the apex preview line across the stage are gone per Louis's note (the green
	# lines on every throw); the gauge alone teaches height control.
	for h in [LEFT, RIGHT]:
		if not charging[h] or stack(h).is_empty():
			continue
		var hold := clampi(tick - int(charge_start[h]), 0, HOLD_MAX)
		var f := float(hold) / float(HOLD_MAX)
		var pos: Vector2 = fig_hand_pos(h)
		var gx := pos.x + (-30.0 if h == LEFT else 30.0) - 3.0
		var gh := 52.0
		var gy := pos.y + 10.0
		draw_rect(Rect2(gx, gy - gh, 6.0, gh), Color(0.08, 0.05, 0.06, 0.75))
		var col := Color(1.0, 0.86, 0.5).lerp(Color(1.0, 0.68, 0.3), clampf(f * 1.6, 0.0, 1.0))
		if f > 0.78:
			col = col.lerp(Color(1.0, 0.35, 0.3), (f - 0.78) / 0.22)
		draw_rect(Rect2(gx, gy - gh * f, 6.0, gh * f), col)
		draw_rect(Rect2(gx - 1.0, gy - gh * 0.78, 8.0, 1.5), Color(1.0, 0.9, 0.7, 0.7))


func draw_flame_in_dark(b: Ball, pos: Vector2) -> void:
	# Blackout's one concession: no blackout argues with fire. What goes dark on a
	# torch is the WOOD - the handle and the comet trail - and what is left is the
	# exact flame draw_torch renders in the light, at the torch's own scale and still
	# tumbling at its own rate, so the cut reads as the handle being swallowed rather
	# than the prop swapping to a different, smaller sprite. Bringing torches to a
	# Blackout night is the game knowledge this is here to reward.
	var sc := prop_scale(b.kind)
	# the pool of light the fire throws. It is centred on the prop's TRUE position
	# (the flame itself rides out on the tumble), so the catch point stays legible.
	draw_circle(pos, 30.0 * sc, Color(1.0, 0.52, 0.18, 0.07))
	draw_circle(pos, 16.0 * sc, Color(1.0, 0.60, 0.24, 0.10))
	draw_torch_flame(pos, prop_spin_angle(b), sc)


const GLOW_PHOS := Color(0.62, 1.0, 0.72)   # the Kit's phosphor: a cool green-white that
											# reads as CHARGED rather than merely bright,
											# and never collides with a venue's own palette

func fire_clock() -> float:
	# EVERY FIRE IN THE GAME READS ITS TIME FROM HERE, so one switch stops all of them
	# together (2026-07-28, Louis: "i want you to put a toggle for fire motion on and
	# off"). Frozen, a flame keeps its size, its colours and its shape - it simply stops
	# being rebuilt, which is the whole cost of it. Returning a CONSTANT rather than
	# skipping the draw is what keeps a stopped torch plainly a lit torch.
	return atick() if exp_on("fire_motion") else FIRE_STILL_T


func warm_room(amount: float) -> void:
	# EVERY WAY THE CROWD WARMS GOES THROUGH HERE. It was six separate
	# `applause = minf(1.0, applause + x)` lines, which is fine until something needs to
	# scale all of them at once - and the TAILCOAT does. One choke point also means the
	# decay is the only other thing touching `applause`, so "what can raise the room?" has
	# a single answer. Losses are deliberately NOT routed through it: a coat that softened
	# the drop as well as speeding the climb would be two buffs wearing one price.
	applause = minf(1.0, applause + amount * (COAT_WARM if wearing("coat") else 1.0))
	# ONCE YOU HAVE HAD THEM, THEY WILL NOT THROW TOMATOES (2026-07-29, Louis: "the public
	# may only throw tomatoes if the performer never entered the green public, else the
	# people already got what they came for and are happy enough"). A one-way latch, on the
	# same FLOWER_GREEN line the flower economy already uses, so "the meter went green" means
	# one thing everywhere. It is reset per act in start_run, never mid-act - the whole point
	# is that the room remembers the good part of the night even after it goes wrong.
	if applause >= FLOWER_GREEN:
		won_the_room = true


func prop_glows(kind: int = -1) -> bool:
	# do the props IN HAND carry phosphor? You need a glowing one for every object you are
	# fielding: eight balls and three glowing ones is eight ordinary balls, because the two
	# would be indistinguishable in the air and the pattern is what you are reading.
	var k := prop_type if kind < 0 else kind
	return k < glow_count.size() and glow_count[k] >= num_balls


func can_juggle_glowing() -> bool:
	# ...and could this save field a glowing routine AT ALL - the gate Blackout hangs on
	# (Louis: "at least 3 glow in the dark balls or torches"). Deliberately the two props he
	# named: balls are the cheap answer everyone can reach and torches are the spectacular
	# one, and between them no player is ever locked out or handed it for nothing.
	return glow_count[PROP_BALLS] >= MIN_BALLS or glow_count[PROP_TORCHES] >= MIN_BALLS


func glow_props_lit() -> bool:
	# phosphor only shows where it would actually matter - a dark stage - which is the
	# rule the prop halos already follow (Louis: a glow that is always on is just a
	# colour, and stops meaning anything)
	return prop_glows() and is_dark_context()


func glow_suit_lit() -> bool:
	# ...and it has to be ON HIM, not merely owned. This is the ONE piece where "wearing"
	# genuinely changes what the player sees on a dark stage, which is why the tailor lists
	# it beside the others rather than treating the Kit as scenery.
	return wearing("glow") and is_dark_context()


func draw_glow_in_dark(pos: Vector2, col: Color, kind: int = -1, sc: float = 1.0,
		ang: float = 0.0, lit: float = 1.0) -> void:
	# THE KIT, on stage (2026-07-27, Louis: it "needs a lot of love"). It used to be two
	# flat circles - a coloured dot with a white dot inside - which said WHERE a prop was
	# and nothing else, so paying for it bought a pair of pixels.
	#
	# Now it is a real phosphorescent prop: a wide soft bloom, the prop's OWN SILHOUETTE
	# in charged green over it, and a hot core inside that. Because the silhouette is the
	# real one, a glowing ring still reads as a ring and a glowing club as a club - the
	# whole point of buying the thing is that the pattern stays legible in the dark, and
	# a cascade of identical dots is not a legible pattern.
	#
	# `ang` IS THE PROP'S OWN TUMBLE, and forgetting to pass it was a real bug (2026-07-27,
	# Louis: "the clubs stop turning when descending"). This called glow_silhouette with a
	# hard-coded 0.0 while the function has always taken an angle and used it for the
	# three spinning props - so the moment the lights took a club it snapped upright and
	# froze there for the rest of the fall. `lit` is how strongly the prop is charged:
	# the Glow Kit is the difference between a prop you can read and one you can only
	# find, which is what 60,000 buys now that the shape itself never goes away.
	var fl := (0.85 + 0.15 * sin(float(tick) * 0.4 + pos.x * 0.05)) * lit
	var phos := Color(lerpf(GLOW_PHOS.r, col.r, 0.25), lerpf(GLOW_PHOS.g, col.g, 0.25), lerpf(GLOW_PHOS.b, col.b, 0.25))
	draw_glow_pix(pos, 26.0 * sc, Color(phos.r, phos.g, phos.b, 0.30 * fl))
	if kind >= 0:
		glow_silhouette(pos, kind, sc, ang, Color(phos.r, phos.g, phos.b, 0.85 * fl))
	# the hot white centre is the single biggest reason an uncharged prop was easy to
	# track, so it is the KIT'S: a bright point that says exactly where, for the player
	# who paid for one. Without it the prop is its own dim phosphor and nothing else.
	if lit >= 0.99:
		fill_disc_pix(pos, 3.4 * sc, Color(1.0, 1.0, 1.0, 0.55 * fl))   # the Kit's hot core, on the grid


func glow_silhouette(pos: Vector2, kind: int, sc: float, ang: float, col: Color) -> void:
	# a prop's SHAPE in one flat phosphor colour. Deliberately not draw_club / draw_knife:
	# those paint their own reds and steels, and a charged club coming out crimson kills
	# the whole illusion the Kit is selling. What matters here is the outline, because
	# that is what lets a player tell a club from a ring in the dark.
	match kind:
		PROP_RINGS:
			draw_ring_prop(pos, col, sc)
		PROP_EGGS:
			# FLAT, deliberately: this function's whole contract is the prop's shape in
			# one phosphor tone. Routing it through draw_egg painted the art pass's rim
			# (and, before that, its highlights) into the glow, and a dark edge on a
			# charged prop reads as a hole punched in the bloom rather than as an object.
			ovoid(pos, 9.0 * sc, 12.0 * sc, col)
		PROP_CLUBS:
			draw_set_transform(pos, ang, Vector2.ONE * sc)
			if exp_on("club_v2"):
				# ONE polygon for the whole club, which is both cheaper than the old three
				# shapes and the only version that matches what the lit stage draws. This
				# function's contract is the prop's OUTLINE in one phosphor tone, so a
				# silhouette that disagrees with the lit one is the one bug it can have:
				# in the dark the outline is all a player has to tell a club from a ring.
				draw_colored_polygon(club_shape(CLUB_BUTT_Y, CLUB_NOSE_Y, 0.0, -1.0, 1.0), col)
			else:
				draw_line(Vector2(0, 14), Vector2(0, -4), col, 3.6)
				draw_colored_polygon(PackedVector2Array([
					Vector2(-2.6, -2), Vector2(2.6, -2), Vector2(6, -16), Vector2(-6, -16)]), col)
				draw_circle(Vector2(0, -16.5), 6.0, col)
			draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
		PROP_KNIVES:
			draw_set_transform(pos, ang, Vector2.ONE * sc)
			draw_colored_polygon(PackedVector2Array([
				Vector2(0, -26), Vector2(2.6, -18), Vector2(3.4, 2), Vector2(-3.4, 2), Vector2(-2.6, -18)]), col)
			draw_line(Vector2(0, 4.0), Vector2(0, 12.5), col, 5.0)
			draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
		PROP_CHAINSAW:
			# body and bar as two blocks: in the dark the only thing that has to survive
			# is "long thing with a fat end", which is what tells it from a club
			draw_set_transform(pos, ang, Vector2.ONE * sc)
			draw_colored_polygon(PackedVector2Array([
				Vector2(-CSAW_BODY_W, CSAW_BODY_TOP), Vector2(CSAW_BODY_W, CSAW_BODY_TOP),
				Vector2(CSAW_BODY_W, CSAW_BODY_BOT), Vector2(-CSAW_BODY_W, CSAW_BODY_BOT)]), col)
			draw_line(Vector2(0, CSAW_BODY_TOP), Vector2(0, CSAW_TIP - 2.0), col, CSAW_BAR_W * 2.0)
			draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
		_:
			draw_circle(pos, BALL_RADIUS_PX * sc, col)   # flat, same reason as the egg


func draw_glow_seam(pts: PackedVector2Array, w: float, a: float) -> void:
	# the Kit's piping on the PERFORMER: the same phosphor, run along one seam of the
	# costume so the juggler is a readable shape in the dark instead of a hole in it.
	# Three passes - a wide soft skirt, a mid body, a tight near-white core - which is
	# what makes a line look LIT rather than merely pale. Two passes was the old count and
	# it gave a bright line with a faint aura; the middle rung is what turns that into a
	# glow, for one more call per seam.
	#
	# A POLYLINE, not a pair of endpoints (2026-07-28). The old signature took a flat
	# array read two at a time, which meant every seam was a straight chord - and a
	# straight chord cannot follow a limb that bends. `draw_polyline` joins the segments
	# for free and is still one call per pass, so a seam with a knee in it costs exactly
	# what a straight one did.
	if pts.size() < 2:
		return
	var fl := 0.86 + 0.14 * sin(float(atick()) * 0.32)
	draw_polyline(pts, Color(GLOW_PHOS.r, GLOW_PHOS.g, GLOW_PHOS.b, 0.16 * a * fl), w * 3.4)
	draw_polyline(pts, Color(GLOW_PHOS.r, GLOW_PHOS.g, GLOW_PHOS.b, 0.42 * a * fl), w * 1.8)
	draw_polyline(pts, Color(0.92, 1.0, 0.95, 0.85 * a * fl), w)


func draw_prop(b: Ball, pos: Vector2) -> void:
	# A PROP IN THE HAND IS IN THE SAME DARK ROOM (2026-07-27, Louis: "in the hand the
	# balls are their original color again, which shouldn't happen"). The flight path had
	# its own Blackout branch; this one - which every HELD prop goes through, and the
	# fallen ones too - did not, so a ball turned green in the air and back to red the
	# instant it was caught. Handled at the top, before any of the halo work below, since
	# none of that applies when the house is dark.
	if encore_on("blackout"):
		var bsc := prop_scale(b.kind)
		if b.kind == PROP_TORCHES:
			draw_flame_in_dark(b, pos)   # fire is fire, in the hand as in the air
			if prop_glows(b.kind):
				draw_glow_in_dark(pos, b.color, b.kind, bsc, prop_spin_angle(b), 1.0)
		elif prop_glows(b.kind):
			draw_glow_in_dark(pos, b.color, b.kind, bsc, prop_spin_angle(b), 1.0)
		return
	var sc := prop_scale(b.kind)   # the prop's TRUE size, always: only the hitbox
								   # (prop_hit_scale) ever shrinks - on a big load, or
								   # always a bit for rings (mostly hollow rim)
	# ONLY A FLAME GLOWS, AND IT GLOWS AT THE FLAME (2026-07-28, Louis: "remove the glow
	# from the objects except the torch, whose glow should be centered around the flame").
	#
	# The halo was already dark-stages-only (2026-07-27) but it was still on EVERY prop,
	# tinted with that prop's own colour - which is a claim that a lacquered club or a
	# painted ball emits light, and nothing on this stage does except fire. Worse, it was
	# centred on `pos`, and `pos` is the prop's SIM origin: for a torch that is the grip,
	# about 25 units below the fire, so the one prop that genuinely glows was the one
	# whose glow sat in the wrong place - a warm pool round the performer's hand with a
	# flame burning outside it.
	#
	# So the ambient halo is gone for every other prop, and the torch gets the real thing:
	# `torch_fire_center` puts the pool where the fire actually is - straight above the wick,
	# since the flame is drawn upright at every angle - so it tracks the tumble instead of
	# orbiting the handle. Cheaper as well as truer - one glow quad
	# on the torches instead of one disc per prop.
	#
	if b.kind == PROP_TORCHES:
		var dk := stage_darkness()
		if dk > 0.02:
			var fl := 0.90 + 0.10 * sin(fire_clock() * 0.5 + pos.x * 0.03)
			draw_glow(torch_fire_center(pos, prop_spin_angle(b), sc), 40.0 * sc,
				Color(1.0, 0.58, 0.20, 0.34 * dk * fl))
	if glow_props_lit() and b.kind != PROP_TORCHES:
		# THE GLOW KIT, earning its price on any dark stage rather than only inside a
		# Blackout: the prop is charged, so it carries its own soft bloom wherever the
		# house lights are poor. Torches are exempt - they are already the thing this
		# is imitating, and a phosphor bloom on a flame reads as a bug.
		var gfl := 0.85 + 0.15 * sin(float(tick) * 0.4 + pos.x * 0.05)
		draw_glow_pix(pos, 24.0 * sc, Color(GLOW_PHOS.r, GLOW_PHOS.g, GLOW_PHOS.b, 0.26 * gfl))
	if b.trick >= 0:
		# a trick throw carries a warm glowing ring so the crowd (and player) reads it as special
		var pulse := 0.5 + 0.5 * sin(float(tick) * 0.35)
		draw_arc(pos, (23.0 + 3.0 * pulse) * sc, 0.0, TAU, 26, Color(1.0, 0.86, 0.5, 0.5), 2.5, true)
		# a FALL-OFF, not a slab: a flat 14% disc the width of a hand reads as a stain on
		# the stage rather than as light coming off the prop, which is what it did before
		# and what a hard pixel edge only made more obvious
		draw_glow_pix(pos, 17.0 * sc, Color(1.0, 0.85, 0.5, 0.30))
	draw_prop_body(b, pos, prop_spin_angle(b), sc)


func draw_prop_body(b: Ball, pos: Vector2, ang: float, sc: float) -> void:
	# THE STAGE DRAWS THE SAME OBJECT THE SHOP DOES (2026-07-28, Louis: "i want the rich
	# props ... both toggles may be on standard and then removed from F9"). There is one
	# picture of each prop now; `halo` is the only thing the stage drops, and only because
	# it has its own light for a dark house.
	#
	# THE SQUASH LIVES HERE, ABOVE THE SWITCH, deliberately. It is MOTION, not artwork, so
	# both sides of the toggle have to get it - otherwise flipping the experiment would
	# change how the props FEEL as well as how they look, and an A/B that moves two things
	# at once answers neither question.
	if b.kind == PROP_EGGS or b.kind == PROP_BALLS:
		# squash and stretch: a fast round prop elongates slightly along its motion,
		# which makes the arc feel alive at zero cost to readability
		var k := 0.0
		var vang := 0.0
		if b.state == STATE_FLIGHT:
			# analytic, never differenced off the SPACED comet trail - see flight_vel
			# for what that sampling did to this (it is the whole jitter bug)
			var vel := flight_vel(b)
			k = clampf(vel.length() * 0.055, 0.0, 0.22)
			vang = vel.angle()
		draw_set_transform(pos, vang, Vector2(1.0 + k, 1.0 - k))
		draw_prop_rich(b.kind, Vector2.ZERO, b.color, ang, sc, false)
		draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
		return
	draw_prop_rich(b.kind, pos, b.color, ang, sc, false)   # shape, not light

# THE ROUND PROPS ARE FLAT, and that is a decision, not a shortcut (2026-07-27, Louis:
# "get rid of the 'light' and 'shadows' of both", and "i don't like the dark border on
# the balls: i prefer their original solid colors ... also when held in hands").
#
# THREE ATTEMPTS WERE REJECTED before this, and the reason is worth keeping because it
# applies to any prop added later. A painted highlight and a shadow crescent are a CLAIM
# ABOUT WHERE THE LIGHT IS. On a stage whose lighting genuinely changes - venue palettes,
# Blackout, the Glow Kit, the spotlight pool - that claim is wrong most of the time, and
# a wrong specular is exactly what makes flat art look cheap. Worse, all three attempts
# built the claim out of 1-2px features (a crescent that is the GAP between two
# near-equal circles, a 1px panel seam, a 1.3px hot point), and a sub-pixel feature on a
# moving object shimmers frame to frame however well it is drawn.
#
# SO: state the SHAPE, never the lighting. A ball is one flat disc of its own colour. An
# egg is one ovoid - pinched at the top only, because a symmetric ellipse is a pill and
# the asymmetry is the entire character of the shape. Both hold in the hand as well as
# in the air, so one branch covers both.
#
# ONE EARLIER LESSON STILL BINDS, for anything that ever does want shading: never shade
# with draw_arc at a large width. A thick arc is an annulus SEGMENT with square ends, so
# instead of light falling off it produces a hard-edged wedge stuck to the ball - a
# pac-man bite - and Godot has no round line caps, so a partial thick arc cannot be soft
# at any colour or alpha. Shade only with shapes that have NO ENDS.
#
# The other half of "looks bad in the air" was never an art problem at all - see
# flight_vel for the trail-sampling bug that was actually causing the jitter.
#
# NO CALLER SINCE 2026-07-30, and it is the fifth member of the set `draw_club`'s note names
# (with draw_egg, draw_knife, draw_torch and draw_club itself) - the flat version of a prop
# that the rich version superseded. Its last two callers were UI: the menu cascade and the
# tutorial's starting-kit panel, both of which were still showing the pre-`cap_ball` disc
# while the stage beside them drew the seamed one. Delete the five together or keep the five
# together. The doctrine above is NOT dead with it - `cap_ball`'s own note builds directly on
# it, and the ban on painted highlights and sub-pixel features still governs every prop.
func draw_ball_shape(pos: Vector2, col: Color, sc: float) -> void:
	draw_circle(pos, BALL_RADIUS_PX * sc, col)


func ovoid(c: Vector2, w: float, h: float, col: Color) -> void:
	# an EGG outline: pinched toward the top, full toward the bottom. A symmetric
	# ellipse is a pill; this asymmetry is the entire character of the shape.
	var pts := PackedVector2Array()
	for i in 29:
		var a := TAU * float(i) / 28.0
		var taper := 1.0 - 0.20 * clampf(-sin(a), 0.0, 1.0)
		pts.append(c + Vector2(cos(a) * w * taper, sin(a) * h))
	draw_colored_polygon(pts, col)


func draw_egg(pos: Vector2, col: Color, sc: float) -> void:
	ovoid(pos, 9.0 * sc, 12.0 * sc, col)


func draw_ring_prop(pos: Vector2, col: Color, sc: float) -> void:
	# CONCENTRIC ONLY - the one round prop that keeps its modelling, and the exception
	# proves the rule above. A ring must stay an annulus (the hole has to read as a
	# hole), so every band here is a FULL circle - dark tube, body, bright inner edge -
	# and none of them has an end that could read as a cut, nor a direction that could
	# be wrong under a different stage light. It is cross-section, not illumination.
	# THINNED to match the sprite (2026-08-07, Louis: "the juggle rings are too thick"). The
	# OUTER radius is unchanged at 14.5 - it is what the prop's extent means to the collision
	# audit - and only the tube inside it narrows, exactly as make_round_props.py did to the
	# analytic model the sprite comes from. The procedural fallback has to follow, or --procart
	# stops being an honest A/B of the same object.
	var r := 12.9 * sc
	var w := 3.2 * sc
	draw_arc(pos, r, 0.0, TAU, 32, Color(col.r * 0.46, col.g * 0.45, col.b * 0.50), w, true)
	draw_arc(pos, r - w * 0.14, 0.0, TAU, 32, col, w * 0.60, true)
	draw_arc(pos, r - w * 0.30, 0.0, TAU, 32, col.lightened(0.38), w * 0.22, true)


# THE CLUB IS ONE PROFILE TABLE (2026-07-30, F9 `club_v2`; Louis: the clubs want improving).
# Three functions draw a club - draw_club on stage and as the wordmark's crossbar, cap_club on
# the shop card, glow_silhouette in the dark - and each carried its own copy of the shape. That
# is how all three came to keep the same leftover mark: `draw_circle(Vector2(0, -16.5), 6.0)`,
# a disc as wide as the whole body. In cap_club it sits 2 units PROUD of the tapered bulb whose
# own comment says it replaced the old cone, so the careful profile underneath was never the
# silhouette anybody saw - what read was a fat head on a stick, which is the mallet Louis is
# looking at. Deleting a duplicated mark in one of three copies fixes one picture out of three,
# so the shape moves into a table and the three become one.
#
# Half-widths up the club, butt first, in the same local units every club drawer already uses.
# THE RATIO IS THE READ: the body runs from the collar at +2 to the nose at -22.5 (24.5 long)
# and never passes 4.1 half-width, so it is 3:1, which is a real club. The old bulb was 21 long
# by 4.2 (2.5:1) with that 6-unit disc on top of it - an onion, however carefully the rest was
# drawn. The width holds from -14 to -17 rather than peaking at a point, because the first pass
# at this table peaked at -15 and fell away over four units, which came out a bullet: what makes
# the top of a club read is a DOME, i.e. a stretch at full width and then a quick round-off. The
# 4.1 is also a deliberate 0.7 clear of the knife's 3.4 - the two heavy props are told apart in
# the air by mass as much as by shape, and at 3.7 the club was the same width as the knife.
# The two ENDS carry the rest: a club has a KNOB (a bulb with a waist under it, so
# the hand has something to hold against) and a NOSE (a rounded point, not a flat cap and not
# a ball). Because a half-width is a function of height, the outline is a simple polygon at
# every slice by construction - it cannot self-intersect, which is the failure mode this file
# has now paid for three times.
#
# THE TWO ENDS ARE THE CLUB'S WHOLE EXTENT, and this is now the only place they live. They were
# also `CAP_CLUB_KNOB` / `CAP_CLUB_TIP` out in the capsule layout for one day, because the club
# was the A's crossbar and the letter had to know how long it was. A ball replaced it on
# 2026-07-30, so that copy is deleted and a prop's measurements sit beside the prop again.
const CLUB_PROF := [
	[17.8, 0.0], [17.1, 1.75], [15.6, 2.80], [14.1, 2.45], [13.0, 1.50],   # the knob, and its waist
	[10.5, 1.42], [6.0, 1.56], [2.0, 1.86],                                # the handle, barely flaring
	[-1.5, 2.45], [-5.0, 3.15], [-8.5, 3.72], [-11.5, 4.02],               # ...swelling into the body
	[-14.0, 4.10], [-17.0, 4.02], [-19.0, 3.74],                           # widest at -14, held to -17
	[-20.6, 3.20], [-21.7, 2.40], [-22.3, 1.40], [-22.5, 0.0],             # then the dome
]
const CLUB_BUTT_Y := 17.8     # the knob's far edge
const CLUB_NOSE_Y := -22.5    # ...and the nose's, so the club's whole extent is these two
const CLUB_LEN := CLUB_BUTT_Y - CLUB_NOSE_Y   # 40.3, and the wordmark's A is built off it
const CLUB_COLLAR_Y := 2.0    # where the pale handle gives way to the coloured body
const CLUB_BAND_Y := -11.0    # the decorated band round the body, the mark that says "juggling club"


func club_hw(y: float) -> float:
	# the club's half-width at a height, interpolated from CLUB_PROF. Sampling one table is
	# what lets the pale handle, the coloured body, the shop's shaded side and its lacquer
	# stripe all be slices of the SAME object rather than four sets of hand-picked numbers
	# that agree until one of them is edited.
	var n := CLUB_PROF.size()
	if y >= float(CLUB_PROF[0][0]) or y <= float(CLUB_PROF[n - 1][0]):
		return 0.0
	for i in n - 1:
		var y0 := float(CLUB_PROF[i][0])
		var y1 := float(CLUB_PROF[i + 1][0])
		if y <= y0 and y >= y1:
			var t := 0.0 if is_equal_approx(y0, y1) else (y0 - y) / (y0 - y1)
			return lerpf(float(CLUB_PROF[i][1]), float(CLUB_PROF[i + 1][1]), t)
	return 0.0


var _club_cache := {}

func club_shape(y_hi: float, y_lo: float, inset: float, x0f: float, x1f: float,
		cut_hi := false, cut_lo := false) -> PackedVector2Array:
	# EVERY MARK ON A CLUB COMES OUT OF THIS ONE FUNCTION, which is what stops the shop's club
	# and the stage's club from drifting into two different objects again. It returns a closed
	# polygon bounded between two heights (`y_hi` toward the knob, `y_lo` toward the nose) and
	# between two FRACTIONS of the club's own half-width at each height. So the full silhouette
	# is (-1, 1), the shop's shaded side is (0.30, 1) and its lacquer stripe is (-0.80, -0.42) -
	# and not one of them can cross the outline, because all three are measured off it.
	#
	# `inset` pulls the whole thing inward from the silhouette, which is how the flat version
	# gets a rim that is dark THE WHOLE WAY ROUND without claiming a light direction (the round-
	# props rule): fill the outline dark, then fill an inset copy in the prop's own colour.
	# Offsetting a finished polygon is fiddly and can fold it through itself; offsetting a
	# PROFILE cannot, because a half-width is one number and an end is another.
	#
	# `cut_hi` / `cut_lo` mark an end that BUTTS against a neighbouring slice rather than being
	# a real end of the club. A cut is never pulled in - the pale handle and the red body have
	# to keep meeting exactly however thick the rim gets, or a gap opens at the collar.
	# BAKED ONCE, because a club's geometry does not depend on the tick. This is the chainsaw's
	# lesson (`_saw_bake`) met from the easy side: there, every saw is the same local geometry AT
	# A GIVEN TICK and the bake has to be redone each frame; here it never changes at all, so the
	# first club of the session pays for every club afterwards.
	#
	# MEASURED, seven clubs at the World Arena, same seeded act, back to back on a quiet machine:
	# the old club 4.5ms a frame, this one 4.7ms WITH the cache and 7.8ms WITHOUT it. So the cache
	# is not a tidiness argument, it is the difference between a 4% cost for the new shape and a
	# 72% one. Five slices per club at ~186 club_hw samples each, every sample scanning the
	# profile, is about 12,000 GDScript loop iterations a frame - which is what interpreted
	# geometry costs, and exactly why the chainsaw's numbers are written down too.
	#
	# The cache is keyed on the arguments and the callers all pass constants, so it settles at a
	# handful of entries. It is bounded anyway: `inset` is derived from the draw scale in the flat
	# version, and a scale that varied continuously would otherwise mint a key per frame forever.
	# NOTHING MAY MUTATE WHAT THIS HANDS BACK - it is the cached array itself, not a copy.
	var key := "%.2f|%.2f|%.2f|%.2f|%.2f|%d%d" % [y_hi, y_lo, inset, x0f, x1f,
		1 if cut_hi else 0, 1 if cut_lo else 0]
	if _club_cache.has(key):
		return _club_cache[key]
	if _club_cache.size() > 64:
		_club_cache.clear()
	var top := y_lo + (0.0 if cut_lo else inset)
	var bot := y_hi - (0.0 if cut_hi else inset)
	if bot - top < 0.05:
		_club_cache[key] = PackedVector2Array()
		return _club_cache[key]
	var steps := clampi(int((bot - top) / 1.1), 6, 30)
	var pts := PackedVector2Array()
	for i in steps + 1:                            # up the outer edge...
		var y := lerpf(bot, top, float(i) / float(steps))
		_club_push(pts, Vector2(maxf(club_hw(y) - inset, 0.0) * x1f, y))
	for i in range(steps, -1, -1):                 # ...and back down the inner one
		var y2 := lerpf(bot, top, float(i) / float(steps))
		_club_push(pts, Vector2(maxf(club_hw(y2) - inset, 0.0) * x0f, y2))
	if pts.size() > 2 and pts[0].distance_to(pts[pts.size() - 1]) < 0.04:
		pts.remove_at(pts.size() - 1)
	_club_cache[key] = pts
	return pts


func _club_push(pts: PackedVector2Array, p: Vector2) -> void:
	# append unless it lands on the previous point. Both ends of the club taper to a half-width
	# of zero, so the outer and inner walks meet there and would otherwise hand the triangulator
	# a duplicated vertex at the nose and another at the knob.
	if pts.size() > 0 and pts[pts.size() - 1].distance_to(p) < 0.04:
		return
	pts.append(p)


func draw_club_v2(pos: Vector2, ang: float, sc: float) -> void:
	# THE STAGE CLUB, flat, four fills. Same rule the round props were rebuilt on: one flat
	# body inside a rim that is darker all the way round, because a painted highlight is a
	# claim about where the light is and this stage's light genuinely moves. The club gets
	# something the balls cannot have, though, and it does most of the work here: a two-tone
	# SILHOUETTE. A pale handle against a coloured body says "club" before any of the shading
	# an earlier pass tried to put on it, and it survives every venue palette because neither
	# tone is pretending to be light.
	draw_set_transform(pos, ang, Vector2.ONE * sc)
	var body_raw := Color(0.90, 0.35, 0.38)
	var band_raw := Color(0.96, 0.92, 0.85)
	# THE RIM IS 1.6px ON SCREEN, converted into local units, and CAPPED. `ball_rim`'s floor
	# stops it thinning into the band where a 1px feature shimmers on a moving object; the cap
	# is the other end of the same problem - at a small `sc` the conversion asks for 3 local
	# units, which is wider than the handle's own half-width, and the club would come out as
	# solid rim with a thread of colour in it.
	var rim := clampf(1.6 / maxf(sc, 0.05), 0.30, 1.15)
	draw_colored_polygon(club_shape(CLUB_COLLAR_Y, CLUB_NOSE_Y, 0.0, -1.0, 1.0, true),
		ca(Color(body_raw.r * 0.50, body_raw.g * 0.30, body_raw.b * 0.34)))
	draw_colored_polygon(club_shape(CLUB_COLLAR_Y, CLUB_NOSE_Y, rim, -1.0, 1.0, true),
		ca(body_raw))
	# THE HANDLE TAKES NO RIM OF ITS OWN, deliberately. Its half-width is 1.42 units at the
	# waist, so a rim thick enough not to shimmer eats it from both sides at once - and it does
	# not need one: the rim exists to give a ROUND prop an edge where it has no other, and a
	# cream handle already has an edge against both the red body it butts into and every stage
	# this game has. Fewer marks, and none of them in the shimmering band.
	draw_colored_polygon(club_shape(CLUB_BUTT_Y, CLUB_COLLAR_Y, 0.0, -1.0, 1.0, false, true),
		ca(band_raw))
	# the ferrule at the collar, a little proud of the profile: the join between two materials
	# is a real feature of a real club and it is also what hides the seam between two fills
	var cw := club_hw(CLUB_COLLAR_Y)
	draw_line(Vector2(-cw - 0.5, CLUB_COLLAR_Y), Vector2(cw + 0.5, CLUB_COLLAR_Y),
		ca(Color(band_raw.r * 0.88, band_raw.g * 0.85, band_raw.b * 0.80)), 2.2)
	# ...and the decorated band, DETAIL AS A FUNCTION OF SCALE the way draw_coin's milling is:
	# at a small sc it is under 2px of paint across a moving object, which is the shimmer this
	# file keeps paying for, so below that it simply is not there.
	if sc >= 0.85:
		var bw := maxf(club_hw(CLUB_BAND_Y) - rim, 0.0)
		draw_line(Vector2(-bw, CLUB_BAND_Y), Vector2(bw, CLUB_BAND_Y),
			ca(Color(band_raw.r, band_raw.g, band_raw.b, 0.92)), 2.4)
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


func draw_club(pos: Vector2, ang: float, sc: float) -> void:
	# NO CALLER SINCE 2026-07-30, and that is recorded rather than left to be discovered. Its one
	# caller was the wordmark's A crossbar, which is a ball now; the stage and the shop both draw
	# `cap_club` through `draw_prop_rich`. It is kept because `draw_egg`, `draw_knife`,
	# `draw_torch` and (since 2026-07-30) `draw_ball_shape` are in exactly the same state - the
	# flat version of a prop that the rich version superseded - and the uncalled-function sweep
	# has been reporting that family for some time. Delete the five together or keep the five
	# together; one of them going alone is how a set of siblings quietly stops being a set.
	# NOTE that deleting this one is not free: `draw_club_v2` has no other caller, and it is
	# half of a LIVE F9 experiment whose other two readers (glow_silhouette, cap_club) are
	# still wired up. Anyone doing the cull has to settle club_v2 first.
	if exp_on("club_v2"):
		draw_club_v2(pos, ang, sc)
		return
	# EVERY COLOUR PASSES THROUGH ca() (2026-07-29), because the club is now the A's
	# crossbar in the wordmark and the mark fades in and out as one thing. `ca` is the
	# identity outside a mark, so the stage pays nothing for this - and drawing a SECOND
	# club here for the logo would break the file's own rule that a prop has one shape.
	draw_set_transform(pos, ang, Vector2.ONE * sc)
	var body := ca(Color(0.90, 0.35, 0.38))
	var band := ca(Color(0.96, 0.92, 0.85))
	# PROPORTION (2026-07-27): the body runs longer and the head narrower than it did.
	# At 7 units of head against 14 of body the club was as wide as it was long above
	# the grip, which read as a LOLLIPOP - never more so than blown up on a shop card.
	# A real club is roughly three times as long as it is wide, which is what this is.
	draw_line(Vector2(0, 14), Vector2(0, -4), band, 3.6)   # handle
	draw_circle(Vector2(0, 15), 2.8, band)                 # knob
	draw_colored_polygon(PackedVector2Array([              # tapered body
		Vector2(-2.6, -2), Vector2(2.6, -2), Vector2(6, -16), Vector2(-6, -16),
	]), body)
	draw_circle(Vector2(0, -16.5), 6.0, body)              # rounded head
	draw_line(Vector2(-2.8, -2.4), Vector2(2.8, -2.4), ca(Color(0.98, 0.92, 0.86, 0.8)), 2.0)   # collar
	# THE HEAD IS FLAT, WITH A RIM (2026-07-29, Louis: the clubs "have a weird circle on
	# them"). There was a pale pink disc inside the head, meant as a soft sheen, and it read
	# as exactly what he called it: a circle stuck on the club. It is the same mistake the
	# round props were rebuilt to escape two days earlier and the entry above it even says
	# so - a painted highlight is a claim about where the light is, and this one was a
	# 2.3-unit disc at 45% alpha sitting on a 6-unit head, which is far too big to read as a
	# specular and far too small to read as shading. `ball_rim`'s rule instead: one flat body
	# inside a rim that is darker THE WHOLE WAY ROUND, which has no direction, states a solid
	# edge, and survives every palette the venues throw at it.
	draw_arc(Vector2(0, -16.5), 5.3, 0.0, TAU, 20, ca(Color(body.r * 0.72, body.g * 0.62, body.b * 0.64)), 1.4)
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


func draw_knife(pos: Vector2, ang: float, sc: float) -> void:
	# A LONGER BLADE (2026-07-27, Louis). The old one was 18 units of blade over 8 of
	# grip - a stubby dagger. A juggling knife is mostly blade: this one runs 26 over 9,
	# tapers from a broad ricasso to a real point, and carries a fuller (the groove down
	# the middle) plus a bright ground edge, so it reads as a KNIFE at prop size and as
	# something sharp on the shop card. Same origin and same overall balance point, so
	# nothing about spin, hitbox or layering changes.
	draw_set_transform(pos, ang, Vector2.ONE * sc)
	var steel := Color(0.80, 0.85, 0.92)
	var steel_dk := Color(0.55, 0.60, 0.68)
	var edge := Color(1.0, 1.0, 1.0, 0.95)
	var handle := Color(0.30, 0.20, 0.14)
	var handle_hi := Color(0.44, 0.30, 0.20)
	draw_colored_polygon(PackedVector2Array([              # blade: point, belly, ricasso
		Vector2(0, -26), Vector2(2.6, -18), Vector2(3.4, 2), Vector2(-3.4, 2), Vector2(-2.6, -18),
	]), steel)
	draw_colored_polygon(PackedVector2Array([              # the fuller, a shade darker
		Vector2(0, -21), Vector2(1.2, -16), Vector2(1.2, 0), Vector2(-1.2, 0), Vector2(-1.2, -16),
	]), steel_dk)
	# THE GROUND EDGE, as a polygon rather than a stroked line (2026-07-27, Louis: "the
	# point is a bit too thick... it sticks out a tiny amount"). A 1.4-wide line ending
	# ON the tip straddles the centreline there, so half its width hung outside the
	# blade's own silhouette and blunted the point by a fraction. Built as a sliver that
	# runs down the outer edge and CONVERGES to the same vertex the blade does, it
	# cannot overhang at any scale: the point is exactly as sharp as the polygon says.
	draw_colored_polygon(PackedVector2Array([
		Vector2(0, -26), Vector2(-2.6, -18), Vector2(-3.4, 2),      # down the cutting edge
		Vector2(-2.1, 2), Vector2(-1.4, -17.6),                     # ...and back up, inset
	]), edge)
	draw_line(Vector2(-4.4, 3.0), Vector2(4.4, 3.0), Color(0.62, 0.64, 0.70), 3.0)   # guard
	draw_line(Vector2(0, 4.0), Vector2(0, 12.5), handle, 5.0)   # grip
	draw_line(Vector2(-1.4, 5.0), Vector2(-1.4, 11.5), handle_hi, 1.4)
	draw_circle(Vector2(0, 13.2), 2.4, Color(0.62, 0.64, 0.70))  # pommel
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


# THE CHAINSAW (2026-07-28, Louis: "make it actually move around and work"). Local units
# match the other long props - the handle end is at positive y, the business end at
# negative - so nothing about spin, hand slotting, hitboxes or layering needed a special
# case. They are named constants because the blackout silhouette draws from the same
# numbers, and a second hand-written copy of a prop's shape is exactly how the Glow Kit's
# clubs came to stop turning.
const CSAW_BODY_TOP := -2.0    # where the engine block starts...
const CSAW_BODY_BOT := 15.0    # ...and where the rear handle ends
const CSAW_BODY_W := 5.4       # half-width of the block
const CSAW_TIP := -30.0        # the far end of the guide bar
const CSAW_BAR_W := 2.6        # half-width of the bar
const CSAW_TEETH := 18         # links drawn round the bar. Raised from 13 on 2026-07-30:
                               # the loop gained the nose arc, so the same count would have
                               # spread the same links over a longer path.
                               # THE COST OF THIS PROP is here:
							   # one link is one quad, and at fifteen props in the air that
							   # is ~200 shapes a frame. They go through the _soup_*
							   # batcher, so the whole chain of one saw is ONE draw call
							   # (see THE FLOWER PILE for why that ratio is the thing that
							   # matters, not the vertex count)
const CSAW_CHAIN_RATE := 0.22  # how fast the chain travels, in links per tick


func _soup_poly(pts: PackedVector2Array, col: Color) -> void:
	# a convex filled polygon into the batch: the centroid, then its own ring as the fan.
	# Convex only, which every shape that uses it is - a fan from the centroid of a
	# concave shape would spill outside it.
	if pts.size() < 3:
		return
	var c := Vector2.ZERO
	for q in pts:
		c += q
	c /= float(pts.size())
	var ring := PackedVector2Array(pts)
	ring.append(pts[0])
	_soup_fan(c, ring, col)


func draw_chainsaw(pos: Vector2, ang: float, sc: float, rich: bool = false) -> void:
	# ONE DRAW CALL PER SAW, AND ONE BUILD PER FRAME (2026-07-28, Louis: "check for lag
	# tho" - and he was right to ask). Measured at seven saws at the World Arena, which is
	# the worst case the game can reach:
	#     eleven immediate-mode shapes each   449 calls   3.0ms
	#     batched, but rebuilt per prop       383 calls   3.0ms   <- calls down, time flat
	#     batched and baked once per frame    383 calls   2.6ms
	# The middle row is the trap this codebase already wrote down for the flower pile and
	# then walked into again: cost is the NUMBER of calls times ~5us, so batching wins -
	# but building the triangles in GDScript costs about as much as the calls it saves, so
	# doing it once per PROP gives the saving straight back. Every saw is the same local
	# geometry at the same tick (the transform is the only difference), so the bake is
	# shared and the per-prop work is a single emit.
	_saw_bake()
	draw_set_transform(pos, ang, Vector2.ONE * sc)
	RenderingServer.canvas_item_add_triangle_array(get_canvas_item(), _saw_idx, _saw_pts, _saw_cols)
	if rich:
		# the shop card can afford the exhaust and a heat shimmer off the block
		var ct := atick()
		for i in 5:
			var ph := fposmod(ct * 0.012 + float(i) * 0.2, 1.0)
			draw_circle(Vector2(CSAW_BODY_W * 0.9 + ph * 5.0, 2.0 - ph * 16.0),
				1.2 + ph * 3.4, Color(0.62, 0.60, 0.58, (1.0 - ph) * 0.22))
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


var _torch_pts := PackedVector2Array()
var _torch_cols := PackedColorArray()
var _torch_idx := PackedInt32Array()
var _torch_baked := false

func _torch_bake() -> void:
	# THE TORCH HANDLE in local units, baked ONCE for the whole session. Every number here
	# is a constant - the haft is waisted, the cord is wound, the ferrules are brass, the
	# wick is charred - and none of it depends on the tick, the prop or the venue, which is
	# exactly why it can be baked harder than the chainsaw's chain can (see _saw_bake, which
	# has to rebuild whenever the clock moves because its chain travels).
	#
	# THE HANDLE RUNS THE FULL LENGTH the stage torch's does - TORCH_WICK to TORCH_BUTT - so
	# this is the same object with more on it, never a differently-proportioned one.
	#
	# `ca()` is deliberately NOT used in here. A bake is shared by every torch in the frame,
	# and `_cap_a` is a per-drawing fade (the wordmark's, a fallen prop's), so folding it
	# into baked vertex colours would let one faded torch fade all of them - and would defeat
	# the bake besides, since the colours would have to be rebuilt whenever the alpha moved.
	# A torch that needs to fade is drawn under a modulate, not baked at a lower alpha.
	if _torch_baked:
		return
	_torch_baked = true
	_soup_clear()
	_soup_poly(PackedVector2Array([          # a turned haft: waisted, not a bar
		Vector2(-2.1, 0.0), Vector2(2.1, 0.0), Vector2(2.4, 6.0), Vector2(1.9, 11.0),
		Vector2(2.3, TORCH_BUTT), Vector2(-2.3, TORCH_BUTT), Vector2(-1.9, 11.0), Vector2(-2.4, 6.0)]),
		Color(0.26, 0.17, 0.12))
	_soup_poly(PackedVector2Array([          # the lit side of the haft
		Vector2(-2.1, 0.2), Vector2(-0.9, 0.2), Vector2(-0.8, 11.0), Vector2(-1.1, TORCH_BUTT - 0.2),
		Vector2(-2.3, TORCH_BUTT - 0.2), Vector2(-1.9, 11.0)]), Color(0.40, 0.27, 0.18))
	for gy in [2.4, 4.4, 6.4, 8.4, 10.4, 12.4]:        # the cord it is bound with
		_soup_line(Vector2(-2.3, gy), Vector2(2.3, gy + 0.4), 0.7, Color(0.14, 0.09, 0.07, 0.75))
		_soup_line(Vector2(-2.3, gy + 0.8), Vector2(2.3, gy + 1.2), 0.5, Color(0.62, 0.45, 0.28, 0.30))
	for by in [-0.4, 1.4]:                             # the brass ferrule under the head
		_soup_poly(PackedVector2Array([Vector2(-2.6, by), Vector2(2.6, by),
			Vector2(2.6, by + 1.3), Vector2(-2.6, by + 1.3)]), Color(0.60, 0.47, 0.26))
		_soup_line(Vector2(-2.2, by + 0.35), Vector2(2.2, by + 0.35), 0.4, Color(1.0, 0.90, 0.66, 0.55))
	_soup_poly(PackedVector2Array([          # the soaked wick, charred at the top
		Vector2(-2.2, -3.4), Vector2(2.2, -3.4), Vector2(1.8, -0.2), Vector2(-1.8, -0.2)]),
		Color(0.24, 0.19, 0.16))
	for wy in [-2.9, -2.1, -1.3, -0.5]:
		_soup_line(Vector2(-2.0, wy), Vector2(2.0, wy + 0.25), 0.35, Color(0.10, 0.08, 0.07, 0.75))
	_torch_pts = _soup_pts.duplicate()
	_torch_cols = _soup_cols.duplicate()
	_torch_idx = _soup_idx.duplicate()


func _saw_bake() -> void:
	# the whole saw in local units: bar, running chain, engine block, vents, handle.
	# Rebuilt only when the tick has moved, because the chain is the only part that
	# changes and it changes with the clock, not with which saw is being drawn.
	# ...and the same trap the other way round. cine_tick only advances OUTSIDE ST_PLAY,
	# so keying the bake on it froze the chain solid the moment an act started - the one
	# state the prop exists for. atick() is the clock that runs in both.
	if _saw_tick == int(atick()):
		return
	_saw_tick = int(atick())
	var t := atick()
	_soup_clear()
	var body := Color(0.94, 0.55, 0.12)
	var body_dk := Color(0.62, 0.32, 0.06)
	var steel := Color(0.72, 0.76, 0.84)
	var steel_dk := Color(0.38, 0.42, 0.50)
	# THE GUIDE BAR, first so the engine block sits over its root. Its tip vertex has to
	# land exactly on `span` below - the same "up one side, round the nose, back down the
	# other" turnaround the chain's own perimeter walk uses (Louis: "make sure it reaches
	# until the point where the teeth turn around") - not on the CSAW_TIP constant, which
	# is 2 units short of it: the chain already walks past the drawn steel to get there.
	var bar_tip := CSAW_TIP - 2.0   # == `span`, computed again below for the chain path
	_soup_poly_feathered(PackedVector2Array([
		Vector2(-CSAW_BAR_W, 2.0), Vector2(CSAW_BAR_W, 2.0),
		Vector2(CSAW_BAR_W * 0.72, bar_tip + 1.6), Vector2(0.0, bar_tip),
		Vector2(-CSAW_BAR_W * 0.72, bar_tip + 1.6)]), steel_dk, 0.4)
	_soup_poly(PackedVector2Array([
		Vector2(-CSAW_BAR_W * 0.46, 1.0), Vector2(CSAW_BAR_W * 0.46, 1.0),
		Vector2(CSAW_BAR_W * 0.30, bar_tip + 3.0), Vector2(-CSAW_BAR_W * 0.30, bar_tip + 3.0)]), steel)
	# THE CHAIN, and it really travels. Each link walks the bar's perimeter - up one
	# side, round the nose, back down the other - on a phase that advances every tick, so
	# the teeth are visibly MOVING rather than a texture painted on the edge. One draw
	# call for the lot.
	# THE CHAIN GOES ROUND THE NOSE TOO (2026-07-30, Louis: "the very end needs some more
	# teeth. right now only the sides have teeth, the end should also have them"). The old
	# loop was two straight runs and a fold: `u < 0.5` picked a side and `v` walked the bar,
	# so a link teleported from the top of one side to the top of the other and the nose - the
	# part of a chainsaw everybody pictures - was bare steel. It is a real PERIMETER walk now:
	# up the right side, round the nose sprocket, back down the left, with distance measured in
	# the same units all the way round so the links stay evenly spaced through the turn instead
	# of bunching in it.
	var run := t * CSAW_CHAIN_RATE
	var span := bar_tip                            # the true tip the bar was just drawn to
	var side_len := absf(span - 2.0)
	var nose_len := PI * CSAW_BAR_W
	var total := side_len * 2.0 + nose_len
	for i in CSAW_TEETH:
		var d := fposmod((float(i) + run) / float(CSAW_TEETH), 1.0) * total
		var at := Vector2.ZERO
		var nrm := Vector2.ZERO
		var tang := Vector2.ZERO
		if d < side_len:                            # up the right side
			at = Vector2(CSAW_BAR_W, lerpf(2.0, span, d / side_len))
			nrm = Vector2(1.0, 0.0)
			tang = Vector2(0.0, -1.0)
		elif d < side_len + nose_len:               # round the nose, right to left over the tip
			var th := -PI * (d - side_len) / nose_len
			nrm = Vector2(cos(th), sin(th))
			at = Vector2(0.0, span) + nrm * CSAW_BAR_W
			tang = Vector2(sin(th), -cos(th))
		else:                                       # ...and back down the left
			at = Vector2(-CSAW_BAR_W, lerpf(span, 2.0, (d - side_len - nose_len) / side_len))
			nrm = Vector2(-1.0, 0.0)
			tang = Vector2(0.0, 1.0)
		# a tooth leans the way it is travelling, which is what makes the direction read.
		# A tooth is SMALL: at 1.9 long and 1.9 wide they read as the teeth of a comb stuck
		# in a ruler; a real chain's cutters barely stand proud of the bar, and the movement
		# is what sells it, not the size.
		_soup_line(at, at + nrm * 1.25 + tang * 1.1, 1.5, steel)
	# the nose sprocket, so the chain has something to go round - centred on the same
	# turnaround point (span) the chain and the bar's own tip now agree on
	_soup_ellipse(Vector2(0.0, span), CSAW_BAR_W * 0.55, CSAW_BAR_W * 0.55, 0.0, 10, steel_dk)
	# THE ENGINE BLOCK: a real casing with a pull cord, vents and a rear handle
	_soup_poly_feathered(PackedVector2Array([
		Vector2(-CSAW_BODY_W, CSAW_BODY_TOP), Vector2(CSAW_BODY_W, CSAW_BODY_TOP),
		Vector2(CSAW_BODY_W * 1.05, 7.0), Vector2(CSAW_BODY_W * 0.72, CSAW_BODY_BOT),
		Vector2(-CSAW_BODY_W * 0.72, CSAW_BODY_BOT), Vector2(-CSAW_BODY_W * 1.05, 7.0)]), body, 0.45)
	_soup_poly(PackedVector2Array([                              # the lit side
		Vector2(-CSAW_BODY_W, CSAW_BODY_TOP + 0.3), Vector2(-CSAW_BODY_W * 0.30, CSAW_BODY_TOP + 0.3),
		Vector2(-CSAW_BODY_W * 0.30, CSAW_BODY_BOT - 0.4), Vector2(-CSAW_BODY_W * 0.70, CSAW_BODY_BOT - 0.4),
		Vector2(-CSAW_BODY_W * 1.02, 7.0)]), Color(1.0, 0.72, 0.30))
	for vy in [1.2, 3.2, 5.2]:                                    # cooling vents
		_soup_line(Vector2(-2.6, vy), Vector2(2.6, vy), 0.9, body_dk)
	_soup_poly(PackedVector2Array([                               # the top handle bar
		Vector2(-CSAW_BODY_W * 1.35, 8.6), Vector2(CSAW_BODY_W * 1.30, 8.6),
		Vector2(CSAW_BODY_W * 1.30, 10.4), Vector2(-CSAW_BODY_W * 1.35, 10.4)]), Color(0.18, 0.16, 0.16))
	_soup_ellipse(Vector2(CSAW_BODY_W * 0.55, -0.4), 1.5, 1.5, 0.0, 8, Color(0.20, 0.18, 0.18))
	# THE FRONT HANDLE (2026-07-30, Louis: "Perhaps also add a handle to them"). The saw had a
	# rear grip and nothing to hold with the other hand, which is the bar every photograph of a
	# chainsaw shows: a loop rising off the near side of the casing, arcing over the top of the
	# engine and coming down the far side. Drawn as a stroked path rather than a filled shape
	# because it IS a bar - a tube seen side-on - and it has to read as something you could put
	# a hand through, which means the gap under the arc has to stay open.
	var grip := Color(0.16, 0.15, 0.15)
	var grip_hi := Color(0.42, 0.40, 0.40)
	var bow := PackedVector2Array([
		Vector2(-CSAW_BODY_W * 0.95, 9.6), Vector2(-CSAW_BODY_W * 1.62, 5.6),
		Vector2(-CSAW_BODY_W * 1.30, 1.2), Vector2(-CSAW_BODY_W * 0.10, -0.6),
		Vector2(CSAW_BODY_W * 1.02, 1.4)])
	for k in bow.size() - 1:
		_soup_line(bow[k], bow[k + 1], 2.0, grip)
		_soup_line(bow[k] + Vector2(-0.5, -0.5), bow[k + 1] + Vector2(-0.5, -0.5), 0.6, grip_hi)
	_saw_pts = _soup_pts.duplicate()
	_saw_cols = _soup_cols.duplicate()
	_saw_idx = _soup_idx.duplicate()


func draw_torch(pos: Vector2, ang: float, sc: float, rich: bool = false) -> void:
	draw_set_transform(pos, ang, Vector2.ONE * sc)
	var handle := Color(0.24, 0.16, 0.12)
	draw_line(Vector2(0, TORCH_BUTT), Vector2(0, TORCH_WICK + 1.0), handle, 4.0)
	if rich:
		# the shop's torch is a still object on a card, so it can afford the wick
		# wrapping and the char line the flying one cannot
		draw_line(Vector2(0, 1), Vector2(0, -3), Color(0.14, 0.10, 0.09), 5.0)
		draw_line(Vector2(-2.5, 8), Vector2(2.5, 8), Color(0.38, 0.26, 0.18), 1.6)
		draw_line(Vector2(-2.5, 11), Vector2(2.5, 11), Color(0.38, 0.26, 0.18), 1.6)
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	draw_torch_flame(pos, ang, sc, rich)


# a flame's OUTLINE, half of it: wide at the base, pinched at the waist, curling to a
# point. Written as fractions of (width, height) so one profile serves the 22px flame on
# a flying torch and the big one on a shop card. The old flame was two triangles.
# ONE TORCH, ONE SET OF DIMENSIONS (2026-07-28, Louis: "the flame is a bit too big with
# the lush version, keep the size, just make a bigger part handle" and "make absolutely
# sure that the prettier 'shop' version of an object is just more detailed and not
# different than the basic version"). He is right on both counts and they were the same
# bug: the capsule torch had been drawn freehand at its own proportions, so it stood 49
# units tall against the stage torch's 39 with a flame that was 63% of the whole object.
# A real juggling torch is mostly HANDLE. These are the numbers both versions build from
# now, so the shop can only ever add detail inside the same silhouette.
const FIRE_STILL_T := 137.0  # the phase every flame freezes at with fire motion off -
							  # picked because the flicker and the lean are both near
							  # their middle there, so a still fire looks like a fire
							  # caught mid-burn rather than one at a stretched extreme
const TORCH_BUTT := 16.0    # the handle's far end
const TORCH_WICK := -3.0    # where the fire starts
# A TORCH SPINS ABOUT ITS MIDDLE, NOT ITS HEAD (2026-07-30, Louis: "make the torch swing
# around its center, not the flame"). The local origin is the WICK - it has to be, because the
# fire is built up from it and the sim throws the prop by its grip - so a torch turned about
# the origin pivoted around the one point a real one never does, and read as a flame with a
# stick being whirled beneath it. This is the offset from that origin to the middle of the
# handle; `cap_torch` moves its transform's origin by it so the geometry turns about the
# balance point while `p` still means what it always meant to the sim.
const TORCH_MID := (TORCH_WICK + TORCH_BUTT) * 0.5
const TORCH_FLAME_H := 22.0 # ...and how far it reaches above that
const TORCH_FLAME_W := 4.4  # its peak half-width
const FLAME_PROFILE := [Vector2(0.00, 0.00), Vector2(0.52, -0.07), Vector2(0.62, -0.26),
	Vector2(0.47, -0.48), Vector2(0.27, -0.70), Vector2(0.11, -0.87), Vector2(0.00, -1.00)]

func flame_shape(base: Vector2, h: float, w: float, sway: float,
		phase: float = 0.0) -> PackedVector2Array:
	# the profile up one side and back down the other, with the tip LEANING: a flame
	# bends more the further it is from the wick, which is what sells it as burning
	#
	# THE TWO SIDES BREATHE INDEPENDENTLY (2026-08-15, Louis: "a better flame animation").
	# Every layer used to share one `sway` and one width, so the whole silhouette leaned as a
	# rigid shape and scaled as a rigid shape - a flame-shaped object being waved, rather than
	# something burning. Fire does not do that: its edges are driven by turbulence that is not
	# correlated left to right, so the SHAPE has to change and not just its angle.
	#
	# One extra sine per side is the whole cost, and it is free at the call sites because it
	# reads the clock here rather than being threaded through fill_flame_pix. The rates are
	# deliberately incommensurate with each other and with the flicker in draw_torch_flame
	# (0.37 / 0.43 against 0.5 / 1.31 / 0.29 / 0.71), so nothing in the fire ever repeats on a
	# beat the eye can find - which is the difference between "flickering" and "pulsing".
	# `phase` is what stops the three nested layers deforming as one. They already differ in
	# lean (the callers scale `sway` down for the inner ones), but sharing a width wobble made
	# them a single silhouette drawn three times in three colours - the heart never crossed
	# the body's edge, so the fire had no internal motion at all. A per-layer offset costs
	# nothing and is what makes the core visibly lick out of the flame and back.
	var t := fire_clock() + phase
	var wr := w * (1.0 + 0.20 * sin(t * 0.37) + 0.08 * sin(t * 1.07))
	var wl := w * (1.0 + 0.20 * sin(t * 0.43 + 2.1) + 0.08 * sin(t * 0.91 + 0.7))
	# ...and the tip wanders a little further than the lean alone would take it. `p.y * p.y`
	# already weights the lean toward the tip; this adds a slow independent drift so the very
	# top of the flame is never exactly over the middle of the wick.
	var lick := 0.18 * w * sin(t * 0.23 + 1.3)
	var pts := PackedVector2Array()
	for i in FLAME_PROFILE.size():
		var p: Vector2 = FLAME_PROFILE[i]
		pts.append(base + Vector2(p.x * wr + (sway + lick) * p.y * p.y, p.y * h))
	for j in range(FLAME_PROFILE.size() - 2, 0, -1):
		var q: Vector2 = FLAME_PROFILE[j]
		pts.append(base + Vector2(-q.x * wl + (sway + lick) * q.y * q.y, q.y * h))
	return pts


func draw_torch_flame(pos: Vector2, ang: float, sc: float, rich: bool = false) -> void:
	# the FIRE only, no handle. Split out so Blackout's dark stretch can draw the very
	# same flame the lit torch draws (same size, same tumble, same flicker) instead of
	# a second, smaller hand-written one - the two used to disagree, and a torch
	# visibly shrank to about half size the instant the lights went.
	# REBUILT 2026-07-27 (Louis: "the torch can use a better flame look, which doesn't
	# lag in gameplay, but looks great in the shop"): a real flame silhouette in three
	# nested layers - body, heart, white core - each on its own flicker and lean, so it
	# WRITHES instead of pulsing. In play that is three polygons, one more than the two
	# flat triangles it replaces; `rich` adds the aura, the embers and the pool of light
	# for the shop card, where nothing is moving and the cost is paid once.
	var t := fire_clock()
	var fl := 1.0 + 0.16 * sin(t * 0.5) + 0.07 * sin(t * 1.31)     # two-rate flicker
	var sway := 2.2 * sin(t * 0.29) + 0.9 * sin(t * 0.71)          # the lean
	var base := Vector2(0.0, TORCH_WICK)
	var fw := TORCH_FLAME_W / 0.62      # flame_shape's profile peaks at 0.62 of `w`
	# ...on the art grid, the same as the sprite torch's live fire - see fill_poly_pix. The
	# shop card and the Blackout stretch both come through here, and both are pixel art.
	if rich:
		fill_flame_pix(pos, ang, sc, base, TORCH_FLAME_H * 1.22 * fl, fw * 1.30, sway * 1.2,
			Color(1.0, 0.32, 0.06, 0.35))
	fill_flame_pix(pos, ang, sc, base, TORCH_FLAME_H * fl, fw, sway, Color(1.0, 0.44, 0.10, 0.95))
	fill_flame_pix(pos, ang, sc, base, TORCH_FLAME_H * 0.68 * fl, fw * 0.68, sway * 0.7,
		Color(1.0, 0.72, 0.20, 0.95), 11.0)
	fill_flame_pix(pos, ang, sc, base + Vector2(0.0, -1.0), TORCH_FLAME_H * 0.39 * fl, fw * 0.42,
		sway * 0.35, Color(1.0, 0.96, 0.72, 0.95), 23.0)
	if rich:
		# embers climb off the tip - in WORLD space, not the prop's, since smoke rises
		# whatever angle the torch is held at
		var tipw := pos + Vector2(sway * 0.8, -24.0 * sc).rotated(ang)
		for i in 4:
			var ef := fposmod(t * 0.006 + float(i) * 0.25, 1.0)
			var ex := sin(t * 0.05 + float(i) * 2.1) * 4.0 * sc
			draw_circle(tipw + Vector2(ex, -ef * 20.0 * sc), (1.7 - ef * 1.1) * sc,
				Color(1.0, 0.7, 0.3, 0.8 * (1.0 - ef)))
	# the light the fire throws. In play this is the one thing that matters about a
	# torch, so it is drawn only where it can be SEEN - a dark house, or a shop card.
	var dk := 1.0 if rich else stage_darkness()
	if dk > 0.02:
		draw_glow(torch_fire_center(pos, ang, sc), (54.0 if rich else 42.0) * sc,
			Color(1.0, 0.60, 0.22, 0.34 * dk))


func torch_pivot(p: Vector2, ang: float, sc: float) -> Vector2:
	# where to put the transform's origin so the handle turns about TORCH_MID while the point
	# the sim calls `p` stays exactly where it was. Shared, because the fire and its glow have
	# to be placed off the SAME shifted frame - offset one and not the other and the flame
	# detaches from the wick on every tumble.
	return p - Vector2(0.0, TORCH_MID).rotated(ang) * sc


func torch_fire_anchor(p: Vector2, ang: float, sc: float) -> Vector2:
	# the wick's world position, in the pivoted frame: where the fire starts and the embers
	# leave from
	return torch_pivot(p, ang, sc) + Vector2(0.0, TORCH_WICK).rotated(ang) * sc


func torch_fire_center(pos: Vector2, ang: float, sc: float) -> Vector2:
	# WHERE THE FIRE ACTUALLY IS, in world space, for anything that has to be centred on
	# it rather than on the prop (2026-07-28). `pos` is the sim origin, i.e. the grip;
	# the wick sits at TORCH_WICK above it and the flame's visible mass a little over a
	# third of its height above that.
	#
	# The rise is NOT rotated, and as of 2026-07-30 that is simply true rather than a
	# compromise: the flame is drawn upright at every angle (see cap_torch), so the pool of
	# light it casts sits straight above the wick. It used to be rotated by
	# `ang * CAP_FLAME_UPRIGHT` to track a flame that leaned 80% of the way back to vertical.
	# The wick itself comes from the same `torch_fire_anchor` the fire is drawn at, so the
	# light cannot drift off the thing emitting it.
	var wick := torch_fire_anchor(pos, ang, sc)
	var rise := TORCH_FLAME_H * 0.38 * sc
	return wick + Vector2(0.0, -rise)


func prop_spin_angle(b: Ball) -> float:
	# how far a tumbling prop has turned through its flight. Shared by the lit prop and
	# Blackout's bare flame, so a torch's fire keeps turning at exactly the rate it was
	# turning at before the handle went dark.
	#
	# THE TURN COUNT IS THE THROW'S OWN HEIGHT (2026-07-28, Louis: "the low arc should
	# only make the clubs, knives and torches turn once - that should be standard for low
	# throws"). It was a flat two tumbles for EVERY throw, which is why a flat little pass
	# spun as hard as a full lob: same two turns crammed into a fifth of the airtime, so
	# the low throws were the ones that read as spinning wildly. One turn at the tap
	# floor, two at a full-height throw, and on up from there - the prop's rotation now
	# tells you how big the throw was, which is the whole point of watching it turn.
	if not bool(PROPS[b.kind]["spins"]) or b.state != STATE_FLIGHT:
		return 0.0
	if b.flat:
		return 0.0   # a horizontal pass crosses upright and does not turn at all
	# ...AND IT LANDS ON A WHOLE NUMBER OF THEM (2026-07-28, Louis: "the clubs, torches
	# and knives should not snap into place when catching: they should be pretty much
	# vertical when they are caught and not pretty much horizontal"). The turn count was
	# `1 + height` with height a CONTINUOUS 0..1.8, so a prop finished its flight at an
	# arbitrary angle - very often side-on - and then the held prop is drawn upright, so
	# the last frame of the catch was a visible snap. Rounding to a whole number costs
	# nothing the feature was for: the throw's size still decides how many times it goes
	# over (one at a tap, two at a full throw, three past that), and now every one of
	# them ENDS where it started, handle down, which is how a club is actually caught.
	var span := maxi(1, b.land_tick - b.launch_tick)
	var p := clampf(float(tick - b.launch_tick) / float(span), 0.0, 1.0)
	var turns := maxf(1.0, round(1.0 + clampf(b.height, 0.0, 1.8)))
	return b.spin_dir * p * TAU * turns


# the shop icon's two per-prop numbers (2026-07-27). The old icon simply blew the raw
# stage shape up 2.6x about the origin the SIM uses, which is a hand position, not the
# middle of the object - so a club floated high in its card, a torch sat low, and every
# prop came out the same nominal size whatever it actually is (Louis: the icons are
# subpar). `mag` gives the six a shared optical weight while keeping a mild heavier-is-
# bigger hierarchy; `off` is the y of the shape's own centre in its local units, so the
# icon can be hung on its middle instead of on its grip.
# ...AND BOTH NUMBERS MOVE WHEN THE SHAPE DOES (2026-07-28). Giving the club its real
# 2.3:1 body took its nose from y -17.1 to -21, so the object grew four units taller and
# its own centre shifted from -1.05 to -3.0. Leaving `off` alone would have hung the longer
# club by the same point as the short one - i.e. high in its card again, the exact fault
# this table exists to fix - and leaving `mag` alone would have run it past the hairline
# under the goods. **A prop's silhouette and its two icon numbers are one edit.**
const PROP_ICON_MAG := [3.00, 2.80, 2.40, 1.78, 1.90, 1.72, 1.30]
const PROP_ICON_OFF := [0.0, 0.0, 0.0, -4.2, -5.2, -8.0, -2.0]

func draw_prop_icon(kind: int, pos: Vector2, mag: float = 1.0, live: bool = false) -> void:
	# the prop as SHOP GOODS: the very same shape the stage draws (never a second art
	# style for the same object), set in a small lit niche with a shadow under it, hung
	# on its own centre, and tilted the way a prop reads in the air rather than standing
	# to attention. `live` breathes the selected card's icon - a spinning prop turns, a
	# ball bobs - so the cursor has something to land on.
	var col := prop_color(kind)
	var sc: float = PROP_ICON_MAG[kind] * mag
	var spins := bool(PROPS[kind]["spins"])
	var ang := 0.0
	if spins:
		ang = -0.34 + (0.34 * sin(atick() * 0.016) if live else 0.0)
	var bob := (sin(atick() * 0.022) * 3.0) if live and not spins else 0.0
	var at := pos + Vector2(0.0, bob) - Vector2(0.0, PROP_ICON_OFF[kind] * sc).rotated(ang)
	# the niche: a soft pool of the prop's OWN colour behind it, and a contact shadow
	draw_glow(pos, 54.0 * mag, Color(col.r, col.g, col.b, 0.16))
	fill_ellipse(pos + Vector2(0.0, 42.0 * mag), 26.0 * mag, 6.0 * mag, Color(0.0, 0.0, 0.0, 0.32))
	if kind == PROP_TORCHES:
		# fire lights its own corner of the shop
		draw_glow(at + Vector2(0.0, -11.0 * sc), 44.0 * mag, Color(1.0, 0.62, 0.22, 0.30))
	# THE GOODS GET THE GOOD VERSION. Nothing on this card is moving fast and there are
	# never more than a handful on screen, so the shop can afford the picture the stage
	# cannot - which is the right way round for a card whose whole job is to make you
	# want the thing on it.
	#
	# SEAM: A SECOND, LARGER SPRITE PER PROP, and this is the correction to the first
	# pass rather than an extra. The stage draws a club 13x64 screen px, which is 6x32 at
	# this density - that is geometry, not a choice, and no art skill puts more pixels
	# there. But this card magnifies the SAME sprite by an integer zoom (up to 5x for a
	# ball, 2x for a club, off PROP_ICON_MAG x the card's own `mag`), so a 6x32 club
	# becomes a 6x32 image blown up, not a detailed one. Blocky on a card whose job is to
	# sell the object.
	#
	# So prop_big/* is authored at CARD size (a club is 48x96) and blitted at zoom 1, one
	# source pixel to ART_PIXEL screen px, letting the art decide the size instead of the
	# magnification formula. These are the assets PixelLab is genuinely good at: big
	# enough to be worth generating, and never in flight where the silhouette has to be
	# read at speed.
	#
	# The tint rule is draw_prop_rich's, restated rather than inherited, because this
	# call bypasses it: only the ROUND props take the colour, so those are authored
	# greyscale; club, knife, torch and chainsaw carry their own paint.
	var big_tinted := not (kind in [PROP_CLUBS, PROP_KNIVES, PROP_TORCHES, PROP_CHAINSAW])
	# CENTRED ON `pos`, NOT ON `at` - the sprite must not inherit the procedural drawing's
	# geometry corrections. PROP_ICON_OFF exists because draw_prop_rich hangs each shape
	# from a point that is not its visual middle (a club's grip, a torch's shaft), and it
	# is scaled by `sc`, which for a torch on a full-size card is 2.96 - so the sprite was
	# being shoved ~24px down on top of the card's own 6% push, and the club and the torch
	# hung out through the bottom of their cards. A prop_big sprite is already tight-cropped
	# and centred on its own content, so the only correction it wants is the bob.
	#
	# This is the seam quietly undoing a fit rule, which is the failure mode to watch for
	# whenever a sprite replaces a drawing: draw_shop_card computes `mag` from the space
	# actually left, expressly so a prop cannot "grow out through its own card", and that
	# `mag` only ever reached the procedural path.
	var bkey := "prop_big/" + str((PROPS[kind] as Dictionary)["name"]).to_lower()
	if art_blit(bkey, pos + Vector2(0.0, bob), 1.0, ang, col if big_tinted else Color.WHITE):
		# A CARD IS A STILL PORTRAIT OF AN OBJECT, AND FIRE IS NOT AN OBJECT. Same seam, same
		# fix as the stage torch: the sprite is the handle and the flame is drawn live over it,
		# so a torch burns wherever it is shown - the shop, the skills preview, anywhere else
		# that reaches this one function.
		if kind == PROP_TORCHES:
			draw_sprite_torch_flame(bkey, "card", pos + Vector2(0.0, bob), ang, 1.0, 1)
		return
	draw_prop_rich(kind, at, col, ang, sc)


#endregion

#region HUD HELPERS & KEY-HINT LABELS
# the two shared StyleBoxFlats soft_card re-dresses (see the note inside it)
var _sb_card := _new_card_sb()

func _new_card_sb() -> StyleBoxFlat:
	var sb := StyleBoxFlat.new()
	sb.anti_aliasing = true
	return sb


func soft_card(r: Rect2, fill: Color, border: Color, border_w: float = 1.0, radius: float = 9.0, shadow: float = 12.0) -> void:
	# THE shared card look (2026-07-26 UI pass): a rounded, softly shadowed, anti-aliased
	# panel drawn via StyleBoxFlat in one call. Rounded corners + a real drop shadow are
	# what lift the whole UI off the flat-coloured-rectangle look that read as cheap.
	#
	# ONE COLOUR PER CARD (2026-07-30, Louis: "each selected window has a certain horizontal
	# line of color change, i don't like that; just choose one color, not two"). There used to
	# be a `top_sheen` overlay - a lighter StyleBoxFlat across the top 42%, faking the gradient
	# StyleBoxFlat cannot fill. The trouble is that a box has an EDGE: the "gradient" was two
	# flat tones meeting at a hard horizontal line 42% down the card, which on a lit menu row
	# reads as a seam across it rather than as glass. A fake gradient made of two rectangles is
	# not a gradient, it is a stripe - the same lesson `draw_spotlight_cone` learned when its
	# flat wedge became per-vertex alpha, except here the honest answer is simply one tone.
	# PERFORMANCE (2026-07-27): the two StyleBoxFlats are made ONCE and re-dressed per
	# call, never allocated per card per frame. draw_style_box bakes its geometry at the
	# call, so a shared, mutated instance draws exactly what a fresh one would - and a
	# busy screen (the shop deals sixteen of these, the HUD several a frame at 120Hz)
	# stops churning two objects per card through the allocator.
	# ...AND IT IS DRAWN ON THE ART GRID NOW (2026-08-07). Everything above still holds; what
	# changed is the rasteriser. StyleBoxFlat rounds its corners with an antialiased arc and
	# blurs its shadow, and those were the last smooth curves in the HUD - a crisp bitmap
	# number sitting inside a soft vector frame, on every panel, on every screen. This is the
	# highest-leverage pixel fix in the file precisely because soft_card is shared: forty-odd
	# call sites, from the shop's sixteen cards to the rail, all corrected at one point.
	draw_card_pix(r, fill, border, border_w, radius, shadow)


# A digital quarter-circle, per radius: how far row i of a corner is inset from the edge.
# Cached because the same handful of radii are asked for hundreds of times a frame.
var _pix_corner: Dictionary = {}


func pix_corner(radius_art: int) -> PackedInt32Array:
	# THE STAIRCASE A ROUNDED CORNER BECOMES when it has to land on whole pixels.
	#
	# Sampled at each row's CENTRE, which is the same rule draw_capsule_pix learned the hard
	# way: sampling a row's top edge biases every span upward and a near-flat curve shifts by
	# a whole pixel. The result at radius 4 is the classic 2-1-1-0 step, which is what a pixel
	# artist draws by hand - not a coincidence, it is what a circle actually is at that size.
	if _pix_corner.has(radius_art):
		return _pix_corner[radius_art]
	var out := PackedInt32Array()
	var rr := float(radius_art)
	for i in radius_art:
		var dy := rr - (float(i) + 0.5)
		var dx := sqrt(maxf(0.0, rr * rr - dy * dy))
		out.append(clampi(radius_art - int(round(dx)), 0, radius_art))
	_pix_corner[radius_art] = out
	return out


func draw_card_pix(r: Rect2, fill: Color, border: Color, border_w: float,
		radius: float, shadow: float) -> void:
	# One rounded card, in whole art pixels: a hard offset shadow, a stepped fill, and a
	# one-pixel ring that follows the same steps.
	#
	# DRAWN AS ROWS, not as a mask. The middle of the card is a single rect and only the
	# corner rows need their own, so a panel costs about (2 * radius + 1) draw calls however
	# big it is - cheaper than the StyleBoxFlat it replaces, which had to build an
	# antialiased arc and a blurred shadow every frame.
	var p := art_snap(r.position)
	var q := art_snap(r.position + r.size)
	var w := q.x - p.x
	var h := q.y - p.y
	if w < ART_PIXEL * 2.0 or h < ART_PIXEL * 2.0:
		return
	var rows := int(h / ART_PIXEL)
	var rad := clampi(int(round(radius / ART_PIXEL)), 0, mini(rows / 2, int(w / ART_PIXEL) / 2))
	var ins := pix_corner(rad)

	# how far row i is inset on each side (art px)
	var inset := func(i: int) -> int:
		if i < rad:
			return ins[i]
		if i >= rows - rad:
			return ins[rows - 1 - i]
		return 0

	# THE SHADOW IS A HARD OFFSET COPY, not a blur. A blurred shadow is a gradient of
	# partial alpha, i.e. the one thing this density cannot represent - it came out as a
	# grey fringe a pixel or two wide that read as a smudge round every panel rather than
	# as depth. One art pixel down and right, at the same alpha, is what a pixel artist
	# does and it reads as more solid, not less.
	if shadow > 0.0:
		var so := ART_PIXEL
		for i in rows:
			var d := float(inset.call(i)) * ART_PIXEL
			draw_rect(Rect2(p.x + d + so, p.y + float(i) * ART_PIXEL + so,
				w - d * 2.0, ART_PIXEL), Color(0.0, 0.0, 0.0, 0.38))

	for i in rows:
		var d := float(inset.call(i)) * ART_PIXEL
		draw_rect(Rect2(p.x + d, p.y + float(i) * ART_PIXEL, w - d * 2.0, ART_PIXEL), fill)

	if border_w <= 0.0 or border.a <= 0.0:
		return
	# THE RING follows the same staircase. Each row contributes its own left and right edge,
	# widened to bridge whatever step its neighbours make - without that bridge the corner
	# comes out as a dotted diagonal, because two rows offset by a pixel share no column.
	var bw := maxf(ART_PIXEL, round(border_w / ART_PIXEL) * ART_PIXEL)
	for i in rows:
		var d := float(inset.call(i)) * ART_PIXEL
		var y := p.y + float(i) * ART_PIXEL
		if i == 0 or i == rows - 1:
			draw_rect(Rect2(p.x + d, y, w - d * 2.0, ART_PIXEL), border)
			continue
		var nb := maxf(float(inset.call(i - 1)), float(inset.call(i + 1))) * ART_PIXEL
		var e := maxf(bw, nb - d + ART_PIXEL)
		draw_rect(Rect2(p.x + d, y, e, ART_PIXEL), border)
		draw_rect(Rect2(p.x + w - d - e, y, e, ART_PIXEL), border)


func hud_panel(r: Rect2, glow: bool = false, tutorial_focus: bool = false) -> void:
	# a soft dark card with an ember hairline, so HUD numbers sit on something
	# instead of floating loose over the stage. `glow` breathes the hairline -
	# for a SELECTED menu row, so the cursor reads alive, not just lit; every
	# other (static, always-on) card leaves it off and looks exactly as before.
	if tutorial_focus:
		var fp := 0.70 + 0.30 * sin(float(cine_tick) * 0.08)
		soft_card(r, Color(0.06, 0.035, 0.05, 0.76), Color(1.0, 0.86, 0.42, fp), 3.0, 9.0, 10.0)
	elif glow:
		var pulse := 0.5 + 0.5 * sin(float(cine_tick) * 0.08)
		soft_card(r, Color(0.06, 0.035, 0.05, 0.62), Color(0.98, 0.74, 0.44, lerpf(0.34, 0.62, pulse)), 1.6, 9.0, 10.0)
	else:
		soft_card(r, Color(0.05, 0.03, 0.045, 0.58), Color(0.9, 0.6, 0.35, 0.26), 1.0, 9.0, 9.0)


func hud_card(r: Rect2, accent := Color(0.95, 0.66, 0.4, 0.30), tutorial_focus: bool = false) -> void:
	# the rail cards (Phase 2 HUD): a touch more opaque than hud_panel so text stays
	# readable over a busy stage. All live HUD lives in the LEFT and RIGHT rails now, never
	# over the centre where the props fly.
	#
	# THE ACCENT BAR IS GONE (2026-07-30, Louis: "remove the weird colored horizontal line on
	# the top of the item cards ... if there is another location with that weird horizontal bar
	# near the top of the card, get rid of it"). It was a 2px rect of the card's accent colour
	# just inside the top edge, meant as Balatro-ish chunk. It reads as a coloured RULE laid
	# across the card - a line the eye has to account for and which means nothing - and because
	# hud_card is shared it was doing that on the shop's seven prop cards, the gear cards, the
	# sheet's cards AND every rail card at once. The accent still identifies the card: it is the
	# BORDER colour, which is the whole outline rather than one arbitrary edge.
	var pulse := 0.70 + 0.30 * sin(float(cine_tick) * 0.08)
	soft_card(r, Color(0.075, 0.045, 0.06, 0.88),
		Color(1.0, 0.86, 0.42, pulse) if tutorial_focus else Color(accent.r, accent.g, accent.b, 0.5),
		3.0 if tutorial_focus else 1.0, 9.0, 12.0)


func draw_goal_stem(box: Rect2, frac: float, over: float, marks: PackedFloat32Array, accent: Color,
		live: bool = true) -> void:
	# THE GOAL, quietly, because the flowers on the boards are doing the loud work.
	# A growing STEM with a bud at its tip and a notch at each goal line: the same
	# concave curve and the same information as the money hat, in a fifth of the space
	# and in the flowers' own language, so the rail does not compete with the stage.
	#
	# REDRAWN 2026-07-31, Louis: "they should be yellow and look like they sprout from
	# the [stem], not just a flower icon floating next to the line that indicates the
	# next subgoal (remove those lines)... I'd prefer if there were multiple subgoals:
	# two on the stengel as right now, and then one or two on the top: the flower
	# changes color when getting a higher score: make this take a bit longer and give
	# bonusses. (give the flower a beautiful look if they should get a standing ovation,
	# because they made no drops)." Four changes from what was here before:
	#   - the goal-line ticks are gone outright.
	#   - every subgoal flower is tier 2 (gold rose - the tier that IS yellow in
	#     FLOWER_TIERS) and carries its own `stem` (draw_flower's own cut-stem-and-leaf,
	#     oriented back at the main stalk) instead of floating unattached beside the line.
	#   - ONE extra waypoint blooms between the last real subgoal and the final goal - a
	#     purely visual marker, not a fourth NUM_GOALS entry - and pays a small one-time
	#     warm_room() the moment it is first reached (stem_mid_bonus_given).
	#   - past the final goal the bloom stays posy (purple) for the first stretch of
	#     overflow and only turns gold rose past STEM_OVER_GOLD_AT, itself paying one
	#     warm_room() the moment it does (stem_gold_bonus_given) - "take a bit longer"
	#     read as a real staged transition, not an instant colour swap the moment score
	#     crosses the line.
	var x := box.position.x + box.size.x * 0.5
	var base := box.position.y + box.size.y
	var h := box.size.y * clampf(frac, 0.0, 1.0)
	var stem := Color(0.45, 0.70, 0.40)
	# the unclimbed part of the stem is a visible TRACK, not a hairline: the goal has to
	# read as a distance still to go, the same job the hat's empty crown did
	draw_rect(Rect2(x - 3.0, box.position.y, 6.0, box.size.y), Color(0.20, 0.17, 0.18, 0.85))
	draw_rect(Rect2(x - 3.0, box.position.y, 6.0, box.size.y), Color(0.42, 0.36, 0.34, 0.5), false, 1.0)
	if h > 1.0:
		draw_rect(Rect2(x - 3.0, base - h, 6.0, h), stem)
	# TWO FLOWERS AND TWO LEAVES ON EACH SIDE, ALTERNATING (2026-07-31, Louis, exactly
	# that). Both are laid out from ONE ladder so the alternation cannot drift: going up
	# the stalk it reads leaf, flower, leaf, flower, leaf, flower, leaf, flower, with every
	# item on the opposite side to the one below it. Flower k takes side (k even -> right),
	# so the four flowers land 2 right and 2 left; leaf k takes the opposite, so the four
	# leaves do the same. The old leaf rule ("one every 30px of fill") could not do this -
	# it put as many leaves as the bar was tall, all evenly spaced, with no relationship to
	# the flowers at all.
	#
	# WHERE THE FOUR FLOWERS SIT. Two of them ARE the real subgoals (`marks`, i.e. goals 1
	# and 2). The other two are visual waypoints filling the two gaps below them - half way
	# to the first goal, and half way between the first and the second - so the climb has
	# something to show for itself in the stretches that are otherwise bare stalk. A
	# waypoint pays a small one-time warm_room() when it is first reached; it is not a
	# fourth NUM_GOALS entry and does not touch scoring.
	#
	# NOTHING SITS ABOVE THE LAST REAL GOAL, deliberately. The third and final goal is the
	# BLOOM at the tip (Louis: "the final subgoal, the third one, should be the big flower on
	# the top"), and that bloom opens to 7.0 * STEM_BLOOM_SC * FLOWER_REACH = ~28px of petal
	# - more than a fifth of the whole 148px track. A fourth flower up there is inside it.
	# Tried it that way first and the two shapes overlapped exactly as the arithmetic says.
	var fmarks: Array[float] = []
	var is_goal: Array[bool] = []
	if marks.size() > 0:
		var prev_m := 0.0
		for m in marks:
			fmarks.append((prev_m + float(m)) * 0.5)   # the waypoint in the gap below it
			is_goal.append(false)
			fmarks.append(float(m))
			is_goal.append(true)
			prev_m = float(m)
	for fi in fmarks.size():
		var m: float = fmarks[fi]
		var fdir := 1.0 if fi % 2 == 0 else -1.0
		# THE LEAF BELOW THIS FLOWER, on the other side: halfway down to the flower under it
		# (or to the root, for the first one), so the two never crowd each other.
		var prev: float = fmarks[fi - 1] if fi > 0 else 0.0
		var lm := (prev + m) * 0.5
		if frac >= lm:
			var ly := base - box.size.y * clampf(lm, 0.0, 1.0)
			var lv := PackedVector2Array()
			for k in 9:
				var t := TAU * float(k) / 8.0
				lv.append(Vector2(x - fdir * 10.0, ly) + Vector2(cos(t) * 10.0, sin(t) * 4.4).rotated(-fdir * -0.35))
			draw_colored_polygon(lv, Color(stem.r, stem.g, stem.b, 0.9))
		if frac < m:
			continue
		# A SUBGOAL SPROUTS FROM THE STEM, NOT BESIDE IT: the flower head sits out at its
		# usual distance, but its own stem (draw_flower's `stem` arg) is aimed straight
		# back at the main stalk, so the two read as one plant rather than a flower that
		# happens to be floating near a line - and that stem is what Louis asked for when
		# he said the flower should "have a small stem, like a thin leaf". draw_flower puts
		# a little leaf halfway along it for free.
		var my := base - box.size.y * clampf(m, 0.0, 1.0)
		var fp := Vector2(x + fdir * STEM_FLOWER_OUT, my - 5.0)
		var back := Vector2(x, my) - fp
		draw_flower(fp, 2, STEM_FLOWER_SC, back.angle() - PI * 0.5, 0.95, back.length() / STEM_FLOWER_SC)
		if live and not is_goal[fi] and (stem_way_given & (1 << fi)) == 0:
			stem_way_given |= 1 << fi
			warm_room(0.03)
	# THE BUD OPENS as the goal comes in, and the bloom is deliberately much BIGGER than
	# the bud was (2026-07-27, Louis: "a bigger flower when done, making it more clear
	# that you have reached the desired score"). A bud at 7px quietly becoming a flower
	# at 8px is not an event; tripling it, lighting it, and putting a ring of petals out
	# past the stem's own width is. Past the FINAL goal it opens again, gold, and keeps
	# growing with the overflow - so the rail says "cleared" and then "still climbing".
	var bud := Vector2(x, base - maxf(h, 4.0))
	# A STANDING-OVATION TRACK GETS A VISIBLY BETTER FLOWER (Louis: "give the flower a
	# beautiful look if they should get a standing ovation, because they made no drops").
	# `dropped` is live during the act - the same counter the results card's own ovation
	# bonus reads at the end - so this simply asks the same question early and draws for
	# it, rather than waiting to find out.
	var flawless := dropped == 0
	if over > 0.0:
		# every size here is a named constant because the rail's takings column is placed
		# off STEM_BLOOM_REACH, which is derived from them - grow the bloom and the text
		# beside it moves out of the way on its own (see draw_hud's `col_x`)
		draw_glow(bud, 40.0 + 22.0 * over, Color(accent.r, accent.g, accent.b, 0.28 + 0.24 * over))
		for i in 6:                                    # petals shed round a finished act
			var sa := atick() * 0.02 + TAU * float(i) / 6.0
			draw_flower(bud + Vector2(cos(sa), sin(sa)) * (STEM_SHED_R + STEM_SHED_GROW * over), 0, STEM_SHED_SC, sa, 0.5)
		# PURPLE IS THE THIRD SUBGOAL, YELLOW IS THE REAL ONE (2026-07-31, Louis: "the final
		# subgoal - the third one - should be the big flower on top being purple, and the
		# actual goal should be the big flower on top changing from purple to yellow"). So
		# the top bloom carries the last two steps of the whole climb on its own, in colour
		# and nothing else: posy (FLOWER_TIERS[1], purple) the moment the third and final
		# NUM_GOALS entry falls, and gold rose (FLOWER_TIERS[2], the yellow one) once the
		# score has gone STEM_OVER_GOLD_AT past it. Each pays its own one-time warm_room().
		var gold := true
		if gold and live and not stem_gold_bonus_given:
			stem_gold_bonus_given = true
			warm_room(0.05)
		draw_flower(bud, 2, STEM_BLOOM_SC + 0.45 + STEM_BLOOM_GROW * over, atick() * 0.01, 1.0)
		draw_flower(bud, 0, 1.10 + 0.20 * over, -atick() * 0.014, 0.98)
		if flawless:
			for i in 5:
				var ta := atick() * 0.015 + TAU * float(i) / 5.0
				draw_star4(bud + Vector2(cos(ta), sin(ta)) * (18.0 + 4.0 * over),
					2.4 + 0.6 * sin(atick() * 0.1 + float(i)), Color(1.0, 0.96, 0.72, 0.85))
	elif frac >= 0.999:
		draw_glow(bud, 32.0, Color(1.0, 0.86, 0.45, 0.26))
		if flawless:
			draw_glow(bud, 48.0, Color(1.0, 0.98, 0.85, 0.22 + 0.10 * sin(atick() * 0.08)))
			for i in 5:
				var ta2 := atick() * 0.015 + TAU * float(i) / 5.0
				draw_star4(bud + Vector2(cos(ta2), sin(ta2)) * 16.0, 2.2, Color(1.0, 0.97, 0.78, 0.8))
		draw_flower(bud, 2, 3.6, atick() * 0.008, 1.0)
		draw_flower(bud, 0, 1.10, -atick() * 0.012, 0.98)
	else:
		# still a bud - and it swells as the goal nears, so the change is a growth and
		# not a swap
		var swell := 1.0 + 0.45 * clampf(frac, 0.0, 1.0)
		fill_ellipse(bud, 5.0 * swell, 7.5 * swell, Color(0.55, 0.72, 0.45))
		fill_ellipse(bud + Vector2(-1.4, -1.6) * swell, 2.0 * swell, 3.0 * swell, Color(0.72, 0.86, 0.58, 0.8))


func draw_star4(c: Vector2, r: float, col: Color) -> void:
	# a four-point sparkle: a filled star, because two crossed LINES of equal length and
	# width read as a plus sign, not a glint - which is exactly how the first attempt at
	# a sparkling gold rose came out
	var i := r * 0.26
	draw_colored_polygon(PackedVector2Array([
		c + Vector2(0.0, -r), c + Vector2(i, -i), c + Vector2(r, 0.0), c + Vector2(i, i),
		c + Vector2(0.0, r), c + Vector2(-i, i), c + Vector2(-r, 0.0), c + Vector2(-i, -i),
	]), col)


func draw_meter(x: float, y: float, w: float, h: float, frac: float, fill: Color, label := "") -> void:
	# a labelled progress bar used across the rails (target / crowd / stamina / xp).
	# Rounded track and fill with a soft top highlight on the fill, so it reads like a
	# lit bar rather than a plain block.
	#
	# ON THE ART GRID, through the same stepped-corner rasteriser every panel uses. These
	# were three antialiased StyleBoxFlats - and unlike a panel's corner, a bar's cap is a
	# HALF-CIRCLE at the very end of a bright shape against a dark track, which is where a
	# soft edge shows most. Note the styleboxes were also allocated fresh on every call,
	# three per bar per frame; soft_card had already learned that lesson and this had not.
	var rad := minf(h * 0.5, 7.0)
	draw_card_pix(Rect2(x, y, w, h), Color(0.16, 0.11, 0.09, 0.9),
		Color(0.0, 0.0, 0.0, 0.55), 1.0, rad, 0.0)
	var fw := w * clampf(frac, 0.0, 1.0)
	if fw > 2.0:
		draw_card_pix(Rect2(x, y, fw, h), fill, Color(0, 0, 0, 0), 0.0, rad, 0.0)
		# a faint lighter sheen across the top of the fill for a lit, rounded look. Square
		# at the bottom, so it stays a sheen ON the bar rather than a second bar inside it:
		# the top half only, with the cap radius kept at the top corners.
		draw_card_pix(Rect2(x, y, fw, h * 0.5), Color(1.0, 1.0, 1.0, 0.16),
			Color(0, 0, 0, 0), 0.0, rad, 0.0)
	if label != "":
		draw_string(game_font(), Vector2(x + 8, y + h - 4.0), label, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(10), Color(0.08, 0.04, 0.03, 0.85))


func draw_drop_marks(x: float, y: float, lim: int, used: int) -> void:
	# THE DROPS YOU HAVE LEFT (redrawn 2026-07-27, Louis: "a cooler and more fitting
	# icon"). A downward triangle said "down" and nothing else. Each pip is now the
	# thing itself: a PROP still in the air, falling, with the streak of the fall behind
	# it - and once it is spent, the prop is gone and what is left is where it landed,
	# a dark smear on the boards. So the row reads as "two still catchable, one on the
	# floor" at a glance, which is exactly what the number means.
	for i in lim:
		var cxm := x + float(i) * 24.0
		var spent := i < used
		if spent:
			# landed: a dull mark on the boards, and the two chips that bounced off it
			fill_ellipse(Vector2(cxm, y + 11.0), 8.0, 2.8, Color(0.42, 0.26, 0.24, 0.75))
			draw_rect(Rect2(cxm - 9.5, y + 8.0, 2.0, 2.0), Color(0.42, 0.26, 0.24, 0.6))
			draw_rect(Rect2(cxm + 7.5, y + 7.0, 2.0, 2.0), Color(0.42, 0.26, 0.24, 0.6))
		else:
			var last := (lim - used) == 1
			var c := Color(0.98, 0.62, 0.34)
			if last:
				# the final one you can afford: it flashes, and it falls a little faster
				c = Color(1.0, 0.42, 0.30, 0.75 + 0.25 * sin(float(tick) * 0.28))
			var fall := 1.6 * sin(float(tick) * 0.05 + float(i) * 1.1)
			var pc := Vector2(cxm, y + 6.0 + fall)
			draw_line(pc + Vector2(0.0, -9.0), pc + Vector2(0.0, -3.0), Color(c.r, c.g, c.b, c.a * 0.35), 3.0)
			draw_line(pc + Vector2(0.0, -6.0), pc + Vector2(0.0, -2.0), Color(c.r, c.g, c.b, c.a * 0.6), 4.0)
			draw_circle(pc, 4.6, c)
			draw_circle(pc + Vector2(-1.4, -1.4), 1.6, Color(1.0, 0.95, 0.85, c.a * 0.85))


const GAUGE_ZONES := [
	# where the needle sits and what that MEANS, from empty to full: the same four
	# bands a fuel or temperature gauge uses, so the reading is understood before it is
	# read. The thresholds are the fraction each band ENDS at.
	# VIBRANT (2026-07-27, Louis). These were mixed down toward the warm stage palette
	# and came out dusty - a fuel gauge is signage, not scenery, and it is the one
	# instrument that has to be read in a glance while both hands are busy. Each band is
	# now near-saturated and the four are pushed apart in hue, so which one the needle is
	# in registers peripherally instead of needing a look.
	{"to": 0.25, "col": Color(1.00, 0.18, 0.16)},   # the room is leaving
	{"to": 0.50, "col": Color(1.00, 0.52, 0.08)},   # restless
	{"to": 0.78, "col": Color(1.00, 0.87, 0.12)},   # with you
	{"to": 1.00, "col": Color(0.24, 0.94, 0.38)},   # won over
]
const GAUGE_LIT := 1.0    # a band the needle has passed: full strength
const GAUGE_DIM := 0.34   # ...and one it has not. Was 0.22, which read as switched off

func gauge_color(frac: float) -> Color:
	for z in GAUGE_ZONES:
		if frac <= float(z["to"]):
			return Color(z["col"])
	return Color(GAUGE_ZONES[GAUGE_ZONES.size() - 1]["col"])


func draw_gauge(c: Vector2, r: float, frac: float, peak: float, label: String, font: Font) -> void:
	# A DIAL, not a bar (2026-07-27, Louis: "the public satisfaction should be a gaming
	# meter, like a fuel meter: a half circle with green, yellow and red"). The crowd's
	# patience is the one number in the game you watch the way you watch a fuel gauge -
	# it only ever falls unless you feed it - so it gets the instrument that means that.
	# The band is coloured by ZONE (see GAUGE_ZONES) rather than by lerping one colour,
	# because a driver reads "I am in the red" from where the needle IS, not from a hue.
	frac = clampf(frac, 0.0, 1.0)
	var a0 := PI          # 180 degrees: empty, hard left
	var a1 := TAU         # 360: full, hard right
	# THE WHOLE INSTRUMENT IS ON THE ART GRID (2026-08-07). Every shape below used to be an
	# antialiased primitive - draw_arc for the bands, draw_line for the ticks, two smooth
	# polygons for the needle, draw_circle for the hub - and it sat in the left rail beside
	# crisp bitmap numbers looking like a screenshot of a different game. See draw_arc_pix
	# and draw_spoke_pix; the shapes and the sizes are unchanged, only the rasteriser.
	# the dial face, then each zone as one thick arc over it
	draw_arc_pix(c, r, 13.0, a0, a1, Color(0.05, 0.04, 0.05, 0.85))
	var from := 0.0
	for z in GAUGE_ZONES:
		var to := float(z["to"])
		var zc: Color = z["col"]
		var lit := frac >= from - 0.001   # zones already passed burn bright, the rest are dim
		draw_arc_pix(c, r, 11.0, lerpf(a0, a1, from), lerpf(a0, a1, to),
			Color(zc.r, zc.g, zc.b, GAUGE_LIT if lit else GAUGE_DIM))
		from = to
	# ticks at every zone edge, so the bands read as a scale and not as decoration
	for z2 in GAUGE_ZONES:
		draw_spoke_pix(c, lerpf(a0, a1, float(z2["to"])), r - 8.0, r + 8.0, 2.0,
			Color(0.06, 0.05, 0.05, 0.9))
	# the best the room ever got this act: a bright pin left standing on the dial
	if peak > 0.0:
		draw_spoke_pix(c, lerpf(a0, a1, clampf(peak, 0.0, 1.0)), r - 9.0, r + 9.0, 2.0,
			Color(1.0, 0.97, 0.85, 0.75))
	# THE NEEDLE: a tapered blade off a hub, with a counterweight behind the pivot
	var na := lerpf(a0, a1, frac)
	var tipc := gauge_color(frac)
	# a dark under-blade first, so the white needle reads against a lit zone too
	draw_spoke_pix(c, na, -7.0, r + 3.0, 10.0, Color(0.08, 0.06, 0.07, 0.85))
	draw_spoke_pix(c, na, -6.0, r + 1.0, 6.0, Color(1.0, 0.96, 0.90))
	fill_disc_pix(c, 5.6, Color(0.10, 0.08, 0.09))
	fill_disc_pix(c, 3.2, tipc)
	# the readout goes BELOW the hub: the needle sweeps the upper half only, so this is
	# the one spot on the instrument it can never cross (it did, over the number)
	if label != "":
		draw_string(font, Vector2(c.x - r, c.y + 18.0), label, HORIZONTAL_ALIGNMENT_CENTER, r * 2.0, ps(14),
			Color(tipc.r, tipc.g, tipc.b, 0.95))
	# in the red, the band itself pulses: the one number in the game that kills a set
	if frac <= float(GAUGE_ZONES[0]["to"]):
		var warn := 0.35 + 0.35 * sin(float(tick) * 0.16)
		draw_arc_pix(c, r, 11.0, a0, lerpf(a0, a1, float(GAUGE_ZONES[0]["to"])),
			Color(1.0, 0.35, 0.28, warn))


func fit_text(font: Font, text: String, w: float, size: int) -> String:
	# THE one-line overflow guard. draw_string's `width` argument does not shorten text,
	# it CLIPS it mid-glyph, which is how a hub card ended up reading "LEARN - Overthrow
	# (ne". This trims to the width and marks the trim, so a long name degrades into
	# something readable instead of something broken (Louis, 2026-07-26: no text should
	# ever leave its container). Returns the text untouched when it already fits, which
	# is the normal case, so this costs nothing on the vast majority of draws.
	if w <= 0.0 or font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(size)).x <= w:
		return text
	var cut := text
	while cut.length() > 1:
		cut = cut.substr(0, cut.length() - 1)
		if font.get_string_size(cut + "...", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(size)).x <= w:
			return cut.strip_edges() + "..."
	return "..."


func fit_size(font: Font, text: String, w: float, want: int, low: int = 10) -> int:
	# the largest size from `want` down to `low` at which text fits w. For the places
	# where shrinking reads better than trimming: a title built by joining two names
	# ("TORCHES  REVERSE CASCADE"), where an ellipsis would eat one of them.
	var sz := want
	while sz > low and font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(sz)).x > w:
		sz -= 1
	return sz


func draw_fit_string(font: Font, pos: Vector2, text: String, align: int, w: float, size: int, col: Color) -> void:
	# draw_string, but the text is shortened to fit `w` first instead of being clipped.
	# Use this for anything whose length is DATA (a venue name, a trick name, a prop
	# name, a save-slot title) rather than a fixed string the layout was built around.
	draw_string(font, pos, fit_text(font, text, w, size), align, w, ps(size), col)


func draw_wrap_fit(font: Font, text: String, box: Rect2, size_in: int, col: Color, align := HORIZONTAL_ALIGNMENT_LEFT) -> float:
	# THE block-text overflow guard, the paragraph half of what fit_text does for one
	# line: wrap into a BOX and draw only the lines that fit its HEIGHT, marking the
	# last one when there was more. Use it wherever a description sits above something
	# else on a card - the shop's gear text used to run straight down through its own
	# price plate as soon as it wrapped to a second line. Returns the height used.
	#
	# The size is quantised ONCE here so the line height, the wrap width and the drawn
	# glyphs all agree. Wrapping at one size and drawing at another is exactly how a
	# paragraph overflows a box it was measured to fit - see ps().
	var size := ps(size_in)
	var lines := _wrap_lines(font, text, box.size.x, size)
	var lh := float(size) + 4.0
	var room := maxi(1, int(floor((box.size.y + 3.0) / lh)))
	var shown := mini(lines.size(), room)
	var y := box.position.y + font.get_ascent(ps(size))
	for i in shown:
		var ln := lines[i]
		if i == room - 1 and lines.size() > room:
			ln = fit_text(font, ln + " ...", box.size.x, size)
		draw_string(font, Vector2(box.position.x, y), ln, align, box.size.x, ps(size), col)
		y += lh
	return float(shown) * lh


func _wrap_lines(font: Font, text: String, w: float, size: int) -> PackedStringArray:
	# word-wrap a line to a width, WITHOUT drawing it. Split out so the Encore card can
	# size itself to its own description before drawing it: the card used to be a fixed
	# 66px, which fits two lines, and any three-line challenge (Blackout's, for one) had
	# its last line drawn straight through the card's bottom edge.
	var out := PackedStringArray()
	var line := ""
	for word in text.split(" "):
		var test := word if line == "" else line + " " + word
		if line != "" and font.get_string_size(test, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(size)).x > w:
			out.append(line)
			line = word
		else:
			line = test
	if line != "":
		out.append(line)
	return out


func _wrap_text(font: Font, text: String, x: float, y: float, w: float, size: int, col: Color) -> void:
	var ly := y
	for line in _wrap_lines(font, text, w, size):
		draw_string(font, Vector2(x, ly), line, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(size), col)
		ly += float(size) + 4.0


func pad_active() -> bool:
	# hints follow whichever device spoke most recently, so a keyboard player
	# never sees pad glyphs and a pad player never hunts for key names
	return _pad_last and pad_dev() >= 0


func k_catch() -> Array[String]:
	# the catch keycap labels for whichever device is active (remap-aware).
	# Pad labels follow Louis's own layout: triggers catch, bumpers throw.
	if pad_active():
		return ["LT", "RT"]
	return [OS.get_keycode_string(K_LC), OS.get_keycode_string(K_RC)]


func k_throw() -> Array[String]:
	if pad_active():
		return ["LB", "RB"]
	return [OS.get_keycode_string(K_LT), OS.get_keycode_string(K_RT)]


func k_pause() -> Array[String]:
	if pad_active():
		return ["B"]
	return ["Esc"]


func k_finish() -> Array[String]:
	# the "I am done here" key: take a bow on stage, advance a lesson, leave
	# practice. On a pad that is A - the bottom face button is Enter (Louis's
	# 2026-07-18 swap; A used to be Escape).
	if pad_active():
		return ["A"]
	return ["Enter"]


func k_sheet() -> Array[String]:
	# the character-sheet key: Tab on a keyboard, Y on a pad (swapped from X)
	if pad_active():
		return ["Y"]
	return ["Tab"]


func k_restart() -> Array[String]:
	# the practice re-deal: R on a keyboard, dpad-left on a pad (Louis)
	if pad_active():
		return ["◀"]
	return ["R"]


func k_shop() -> Array[String]:
	# the shop: S on a keyboard, dpad-down on a pad (Louis)
	if pad_active():
		return ["▼"]
	return ["S"]


func k_object() -> Array[String]:
	# switch the prop: O on a keyboard, dpad-up on a pad (Louis)
	if pad_active():
		return ["▲"]
	return ["O"]


func k_pattern() -> Array[String]:
	# switch the pattern: P on a keyboard, dpad-right on a pad (Louis)
	if pad_active():
		return ["▶"]
	return ["P"]


func k_trick() -> Array[String]:
	# remap-aware: PAD_TRICK defaults to X (swapped from Y) but can be rebound
	if pad_active():
		return [pad_button_glyph(PAD_TRICK)]
	return [OS.get_keycode_string(K_TRICK)]


func k_cycle() -> Array[String]:
	# remap-aware: PAD_CYCLE previously had no pad button at all (2026-07-18 fix)
	if pad_active():
		return [pad_button_glyph(PAD_CYCLE)]
	return [OS.get_keycode_string(K_CYCLE)]


func k_count() -> Array[String]:
	# the load-count step keys (down, then up): not one of the six remappable
	# actions, so not remap-aware, only device-aware. 1/2 on keyboard (2026-07-18:
	# replaced one-key-per-count, which ran out of number row once the cap passed
	# eleven; then Minus/Equal themselves were replaced same day - Louis: "bad
	# choices" - since 1 and 2 sit unclaimed during live play, the shop/sheet/
	# pause screens that also read the number row all being separate, gated
	# handlers); Back/R3 on a pad, which previously had no way at all to change
	# the count mid-performance.
	if pad_active():
		return ["Back", "R3"]
	return ["1", "2"]


func draw_keycap(font: Font, x: float, y: float, label: String) -> float:
	# a small keyboard-key box; returns its width so hints can chain
	var w := maxf(21.0, font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(12)).x + 11.0)
	# SEAM: the CAP only. The width above and the label below are LAYOUT and must not move
	# when art arrives - every hint row in the game chains off this return value, and a key
	# hint whose text stopped fitting its box would be a legibility regression, not a
	# restyle. So the sprite is stretched to the box the text asked for, never the reverse.
	if not art_blit_rect("ui/keycap", Rect2(x, y, w, 19.0)):
		draw_rect(Rect2(x, y, w, 19.0), Color(0.15, 0.10, 0.10, 0.92))
		draw_rect(Rect2(x, y, w, 19.0), Color(0.85, 0.65, 0.4, 0.45), false, 1.0)
	draw_string(font, Vector2(x, y + 14.0), label, HORIZONTAL_ALIGNMENT_CENTER, w, ps(12), Color(1.0, 0.9, 0.7))
	return w


func draw_hints_row(font: Font, cx: float, y: float, items: Array) -> void:
	# items: [[keys: Array, action: String], ...] drawn centred as keycaps + labels
	var total := 0.0
	for it in items:
		for k in it[0]:
			total += maxf(21.0, font.get_string_size(String(k), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(12)).x + 11.0) + 3.0
		total += font.get_string_size(String(it[1]), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13)).x + 22.0
	total -= 22.0
	var x := cx - total * 0.5
	for it in items:
		for k in it[0]:
			x += draw_keycap(font, x, y, String(k)) + 3.0
		x += 3.0
		draw_string(font, Vector2(x, y + 14.0), String(it[1]), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13), Color(0.82, 0.74, 0.62, 0.9))
		x += font.get_string_size(String(it[1]), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13)).x + 16.0


func score_text(v: float) -> String:
	return TOSSA_FORMAT.score_text(v)


func mult_text(v: float) -> String:
	return TOSSA_FORMAT.mult_text(v)


func commafy(n: int) -> String:
	return TOSSA_FORMAT.commafy(n)


func draw_hud(font: Font, s: Vector2) -> void:
	# THE HUD (rebuilt Balatro-style, Louis): the whole live state lives in a LEFT rail
	# (the contest - set, target, crowd, drops, the Encore) and a RIGHT rail (you - the
	# multiplier, stamina, purse, reputation, level). The CENTRE stays clear, because that
	# is where the props actually fly; nothing legible sits in their path any more.
	var performing := mode == MODE_PERFORM
	var gold := Color(1.0, 0.86, 0.45)
	var warm := Color(0.86, 0.76, 0.62)
	var dim := Color(0.72, 0.65, 0.56)

	# slow motion reads on screen: a cool veil + a quiet label, tucked low so it never
	# fights the rails or the stage
	var slow := slow_amount()
	if slow > 0.005:
		draw_rect(Rect2(0, 0, s.x, s.y), Color(0.55, 0.72, 1.0, 0.03 + 0.09 * slow))
		var stext := "SLOW  %d%%" % int(round(slow * 100.0))
		if pie_active:
			stext += "   (pie)"
		if _frames < chain_until:
			stext += "   thick time %ds" % int(ceil(float(chain_until - _frames) / 120.0))
		draw_text_shout(font, Vector2(0, s.y - 96.0), stext, HORIZONTAL_ALIGNMENT_CENTER, s.x, 15, Color(0.75, 0.9, 1.0, 0.9))

	# THE COLLAPSE, as it happens: the act is coming down and the player is told the one
	# reason WHY while the props are still in the air, which is the moment it lands
	# emotionally (Louis). The results card repeats the same words afterwards, so the
	# verdict never changes between the fall and the paperwork. Sits high, clear of the
	# hands at 0.57 and of the props tumbling past them.
	if collapsing:
		var cft := fail_text()
		if String(cft[0]) != "":
			var cy := s.y * 0.22
			draw_text_shout(font, Vector2(0, cy), String(cft[0]), HORIZONTAL_ALIGNMENT_CENTER, s.x, 30, Color(1.0, 0.45, 0.35))
			draw_multiline_string(font, Vector2(s.x * 0.25, cy + 28.0), String(cft[1]),
				HORIZONTAL_ALIGNMENT_CENTER, s.x * 0.5, ps(14), 2, Color(0.96, 0.82, 0.74, 0.92))

	# ============================ LEFT RAIL: the contest ============================
	var LX := 18.0
	var LW := 300.0
	if performing and not results_open:
		# --- the act header: venue, THE ACT, and one dot per goal reached ---
		hud_card(Rect2(LX, 16, LW, 52), Color(0.95, 0.66, 0.4, 0.30), show_guide_step == 0)
		draw_fit_string(font, Vector2(LX + 14, 40), String(venue_data(run_venue)["name"]), HORIZONTAL_ALIGNMENT_LEFT, LW - 80.0, 18, gold)
		var setline := "THE ACT"
		if purist:
			setline += "   PURIST"
		draw_string(font, Vector2(LX + 14, 60), setline, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(12), warm)
		if sprint_active:
			draw_string(font, Vector2(LX + 126, 60), "SPRINT  " + sprint_clock_text(), HORIZONTAL_ALIGNMENT_RIGHT, LW - 140.0, ps(12), Color(0.72, 0.92, 1.0))
		for i in NUM_GOALS:
			var dotc := Vector2(LX + LW - 20.0 - float(NUM_GOALS - 1 - i) * 18.0, 34.0)
			if i < goals_hit:
				draw_circle(dotc, 6.0, gold)
			else:
				draw_circle(dotc, 5.0, Color(0.35, 0.28, 0.24, 0.8))

		# --- the GOALS card: the hero. The score on the left, THE HAT on the right. ---
		# Louis, 2026-07-27: the requirement should be a thing that fills, "a sort of hat
		# of money being filled", with real effects once it overflows. The old horizontal
		# meter is gone; the hat carries the same information on the same concave curve.
		var target := next_goal()
		var tcard_y := 78.0
		var tcard_h := 196.0
		hud_card(Rect2(LX, tcard_y, LW, tcard_h), Color(1.0, 0.82, 0.4, 0.4), show_guide_step == 2)
		draw_string(font, Vector2(LX + 14, tcard_y + 24), "SCORE", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(12), Color(0.85, 0.72, 0.55))
		draw_string(title_font(), Vector2(LX + 14, tcard_y + 56), score_text(score), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(26), Color(1.0, 0.94, 0.76))
		# the record chase, top-right of the card
		if run_venue >= 0 and run_venue < rec_table().size() and rec_table()[run_venue] > 0:
			if record_broken:
				var ra := 0.7 + 0.3 * sin(float(tick) * 0.12)
				draw_string(font, Vector2(LX + 14, tcard_y + 78), "NEW RECORD", HORIZONTAL_ALIGNMENT_LEFT, 140.0, ps(11), Color(1.0, 0.86, 0.42, ra))
			else:
				draw_string(font, Vector2(LX + 14, tcard_y + 78), "best  %s" % score_text(rec_table()[run_venue]), HORIZONTAL_ALIGNMENT_LEFT, 140.0, ps(11), dim)
		# THE HAT runs the WHOLE act - zero to the final goal - with a mark on the crown
		# at each goal line, so where you are and what is left both read at a glance. It
		# rises on the same concave curve (goal_bar_pos) the horizontal meter used, so
		# nothing about the PACING of an act changed here, only the picture of it.
		var g_final := goal_for(run_venue, NUM_GOALS - 1)
		var tfrac := goal_bar_pos(score, g_final)
		var marks := PackedFloat32Array()
		for gi in NUM_GOALS - 1:
			marks.append(goal_bar_pos(goal_for(run_venue, gi), g_final))
		var over := 0.0 if score <= g_final else clampf((score - g_final) / maxf(g_final, 1.0), 0.0, 1.0)
		# THE CROWD SHOWS THE GOAL, so the rail does not have to (Louis). A money hat
		# that filled up used to live here; the pile of flowers at the juggler's feet
		# says the same thing far better, on the stage itself, where the player is
		# already looking. The rail keeps only what the stage cannot say: the climb
		# toward the goal as a slim stem, and TONIGHT'S TAKINGS, which the hat never
		# showed at all.
		# ...stopping clear of the cash-in line along the card's bottom edge
		# ...and while the first show's guide is explaining this exact thing, the stem SHOWS
		# what it does instead of being pointed at (2026-07-31, Louis: "emphasize the flower
		# in a better way - instead of a dumb circle around it, make it fill up very fast and
		# run out again at the same speed; that shows how the meter is supposed to fill up
		# repeatedly"). `live` is false for the demo so the waypoint and gold bonuses cannot
		# fire off an animation.
		if show_guide_step < 0 or show_guide_step >= 2:
			var gdemo := guide_stem_demo()
			if gdemo >= 0.0:
				draw_goal_stem(Rect2(LX + 152.0, tcard_y + 12.0, 34.0, 148.0), gdemo, 0.0, marks,
					Color(venue_data(run_venue)["glow"]), false)
			else:
				draw_goal_stem(Rect2(LX + 152.0, tcard_y + 12.0, 34.0, 148.0), tfrac, over, marks,
					Color(venue_data(run_venue)["glow"]))
		# THE TAKINGS COLUMN STARTS CLEAR OF THE BLOOM (2026-07-27, Louis: the flower
		# overlapped the word TONIGHT). The stem's bud sits on the centre line of the
		# box above (its x + half its 34px width), and past the final goal it opens
		# into a flower whose petals reach STEM_BLOOM_REACH - deliberately out past
		# that box - so anything drawn nearer than that is inside the celebration
		# rather than beside it. The column is anchored off the reach itself, not a
		# hand-picked x, so growing the bloom later moves the text out of its way.
		var col_x := LX + 152.0 + 17.0 + STEM_BLOOM_REACH + 7.0
		var col_w := LW - 8.0 - (col_x - LX)     # to the card's own right margin
		var fc := Color(0.98, 0.60, 0.72)
		draw_string(font, Vector2(col_x, tcard_y + 30.0), "TONIGHT", HORIZONTAL_ALIGNMENT_LEFT, col_w, ps(11), Color(0.85, 0.72, 0.66))
		draw_flower(Vector2(col_x + 9.0, tcard_y + 58.0), 0, 1.7, -PI * 0.5, 0.95)
		# the night's take SHRINKS to fit, never trims: fit_text would render a good
		# night's 12,400 as "12,4...", and a truncated number is not a number
		var take := commafy(run_flowers)
		var take_x := col_x + 23.0
		draw_string(title_font(), Vector2(take_x, tcard_y + 66.0), take, HORIZONTAL_ALIGNMENT_LEFT, -1,
			ps(fit_size(title_font(), take, LX + LW - 8.0 - take_x, 24, 14)), fc)
		# and how the room is FEELING, in the one word the pile is saying
		# ...in the SAME bands the crowd dial is coloured in, so the word and the
		# needle can never disagree about whether flowers are coming
		var mood := "waiting"
		var mc := Color(0.70, 0.66, 0.62)
		if applause <= TOMATO_RED:
			mood = "turning on you"
			mc = Color(1.0, 0.45, 0.38)
		elif applause >= 0.92:
			mood = "on their feet"
			mc = Color(0.75, 0.95, 0.72)
		elif applause >= FLOWER_GREEN:
			mood = "throwing flowers"
			mc = Color(0.65, 0.92, 0.62)
		elif applause >= 0.50:
			mood = "with you"
			mc = Color(0.96, 0.86, 0.42)
		elif applause >= FLOWER_FLOOR:
			mood = "restless"
			mc = Color(0.96, 0.62, 0.30)
		# the mood is a phrase, and the longest of them ("throwing flowers") is wider
		# than the column the bloom leaves - so it steps down a size or two rather
		# than losing the word that carries the meaning
		draw_string(font, Vector2(col_x, tcard_y + 90.0), mood, HORIZONTAL_ALIGNMENT_LEFT, col_w,
			ps(fit_size(font, mood, col_w, 12, 10)), mc)
		# the ask, and the gamble, in the card's left column beside the hat
		var goal_head := "FIRST GOAL"
		if goals_hit >= NUM_GOALS:
			goal_head = "ALL CLEARED"
		elif goals_hit > 0:
			goal_head = "NEXT GOAL"
		draw_string(font, Vector2(LX + 14, tcard_y + 110), goal_head, HORIZONTAL_ALIGNMENT_LEFT, 140.0, ps(11), Color(0.85, 0.72, 0.55))
		if goals_hit < NUM_GOALS:
			# THE NUMBER, and then - only while it matters - THE CLOCK. A goal banks on both
			# gates (see GOAL_MIN_S), and a bar sitting full with nothing happening is the one
			# failure a hidden gate always causes: the player concludes the game is broken.
			# So the moment the score passes the bar, the target line becomes a countdown and
			# says plainly what is being waited for.
			var clock_left := goal_clock_left(goals_hit)
			if score >= target and clock_left > 0.0:
				var cp := 0.65 + 0.35 * sin(float(tick) * 0.12)
				draw_fit_string(font, Vector2(LX + 14, tcard_y + 134), "%.1fs" % clock_left,
					HORIZONTAL_ALIGNMENT_LEFT, 132.0, 20, Color(0.72, 0.95, 0.68, cp))
				draw_string(font, Vector2(LX + 14, tcard_y + 150), "number beaten  -  hold the set",
					HORIZONTAL_ALIGNMENT_LEFT, 150.0, ps(10), Color(0.72, 0.95, 0.68, 0.85))
			else:
				draw_fit_string(font, Vector2(LX + 14, tcard_y + 134), score_text(target), HORIZONTAL_ALIGNMENT_LEFT, 132.0, 20, Color(1.0, 0.88, 0.5))
				if clock_left > 0.0:
					# ...and before the number is beaten, the clock is still worth showing,
					# quietly, so nobody is surprised by it later
					draw_string(font, Vector2(LX + 14, tcard_y + 150), "opens in %.0fs" % clock_left,
						HORIZONTAL_ALIGNMENT_LEFT, 150.0, ps(10), Color(0.78, 0.72, 0.62, 0.75))
		else:
			draw_string(font, Vector2(LX + 14, tcard_y + 132), "the record is all", HORIZONTAL_ALIGNMENT_LEFT, 132.0, ps(12), Color(1.0, 0.88, 0.5))
		if goals_hit > 0:
			# from the first goal on, spell out the gamble: a collapse strips the score
			# back to the last goal's value (goal_for(goals_hit-1)), so everything earned
			# ABOVE that is what you are risking by pushing on - true even after all three
			# goals, while you chase a record (the old "every point is yours" was wrong).
			var banked := goal_for(run_venue, mini(goals_hit, NUM_GOALS) - 1)
			draw_fit_string(font, Vector2(LX + 14, tcard_y + 158), "risking  %s" % score_text(maxf(0.0, score - banked)),
				HORIZONTAL_ALIGNMENT_LEFT, 136.0, 12, Color(1.0, 0.72, 0.55))
		# the standing offer: from the first goal on, the cash-in is always open
		if goals_hit >= 1:
			var pl := 0.7 + 0.3 * sin(float(tick) * 0.14)
			draw_fit_string(font, Vector2(LX + 14, tcard_y + tcard_h - 12.0), "%s or catch them all:  cash in  %s" % [String(k_finish()[0]), score_text(score)],
				HORIZONTAL_ALIGNMENT_LEFT, LW - 28.0, 11, Color(0.75, 0.95, 0.7, pl))
		else:
			# This is an actionable instruction, not decoration.  At 10px it was the
			# least readable line in the whole score card at the shipped 1280x720.
			draw_string(font, Vector2(LX + 14, tcard_y + tcard_h - 12.0), "%s: bow out" % String(k_finish()[0]), HORIZONTAL_ALIGNMENT_RIGHT, LW - 28.0, ps(12), Color(0.82, 0.76, 0.66, 0.88))

		# --- the CROWD (patience clock) and the DROP limit ---
		var ccard_y := 286.0
		# THE DIAL CLEARS ITS OWN TITLE (2026-07-27, Louis: it must not overlap the word
		# CROWD). The instrument is wider than the arc: the peak pin stands proud to
		# r + 9, so at the old r 48 on a centre 74 down it reached y+65, while the
		# 12pt label sits on a baseline of y+22 and hangs to about y+25. They were
		# crossing by several pixels whenever the act had a peak worth marking. The
		# dial is a little smaller and sits lower, and the card grew to keep the
		# readout under the hub off its own bottom border.
		var ccard_h := 116.0
		hud_card(Rect2(LX, ccard_y, LW, ccard_h), Color(0.95, 0.5, 0.4, 0.35), show_guide_step == 3)
		draw_string(font, Vector2(LX + 14, ccard_y + 22), "THE CROWD", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(12), Color(0.9, 0.72, 0.62))
		# the DIAL on the left, the drops you have left on the right
		draw_gauge(Vector2(LX + 80.0, ccard_y + 82.0), 44.0, applause, peak_applause,
			"%d%%" % int(round(applause * 100.0)), font)
		draw_string(font, Vector2(LX + 164.0, ccard_y + 52.0), "DROPS LEFT", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(12), Color(1.0, 0.72, 0.64, 0.92))
		draw_drop_marks(LX + 178.0, ccard_y + 68.0, drop_limit(), dropped)

		# --- the CHALLENGE condition, live for the whole act when one was rolled ---
		if not encores.is_empty():
			# ONE CARD PER CHALLENGE, stacked (2026-07-29): a Purist night can carry four at
			# once, and one card listing four names with four descriptions run together is
			# unreadable. Each keeps its own box and its own height, and the box still grows
			# to whatever its description wraps to (36 of chrome plus a 15px line each) so a
			# longer challenge is never clipped by its own border.
			var ec := Color(1.0, 0.55, 0.42)
			# ...and the stack sits under the crowd card, whose own height is a variable
			# (the dial is taller than the bar it replaced), so this follows it
			var eay := ccard_y + ccard_h + 8.0
			# THE COLUMN HAS A FLOOR AND THE STACK DID NOT KNOW ABOUT IT (2026-08-13).
			#
			# The note above is careful that each card grows to fit its OWN description, "so a
			# longer challenge is never clipped by its own border" - and that part works. What
			# nothing checked is the TOTAL: four cards at 66-81px each, under a 116px crowd card,
			# run off the bottom of the screen. Measured on a four-stat Purist night at the
			# Midnight Show, the fourth card lands underneath draw_routine_hud's own panel and the
			# two sets of text print through each other. Now that Purist stats are PLAYER-PICKED
			# rather than only house-rolled, four at once is something somebody chooses rather
			# than a rare roll, so this is reachable in ordinary play.
			#
			# COMPACT IS NAME-ONLY, and the description is the right thing to drop - not a smaller
			# font, which this density cannot afford, and not a shorter wrap, which truncates
			# mid-sentence. The full text was already read once on the establishing card
			# immediately before the act; what the live HUD owes the player mid-run is WHICH
			# challenges are on, not what they mean again. One box per challenge survives either
			# way, which was the whole point of splitting them up in the first place.
			var e_floor := s.y - 88.0 - 8.0    # draw_routine_hud's panel top, less a gap
			var e_hi: Array[float] = []
			var e_tot := 0.0
			for e in encores:
				if e < 0 or e >= ENCORES.size():
					continue
				var eln := _wrap_lines(font, String(ENCORES[e]["desc"]), LW - 28, 11).size()
				e_hi.append(36.0 + 15.0 * float(maxi(eln, 2)))
				e_tot += e_hi[e_hi.size() - 1] + 6.0
			var e_tight := eay + e_tot > e_floor
			var ei := 0
			for e in encores:
				if e < 0 or e >= ENCORES.size():
					continue
				var edesc := String(ENCORES[e]["desc"])
				var ehh := 32.0 if e_tight else e_hi[ei]
				ei += 1
				hud_card(Rect2(LX, eay, LW, ehh), Color(ec.r, ec.g, ec.b, 0.5))
				draw_fit_string(font, Vector2(LX + 14, eay + 22.0), String(ENCORES[e]["name"]).to_upper(), HORIZONTAL_ALIGNMENT_LEFT, LW - 28.0, 14, ec)
				if not e_tight:
					_wrap_text(font, edesc, LX + 14, eay + 40.0, LW - 28, 11, Color(0.9, 0.82, 0.72, 0.9))
				eay += ehh + 6.0
	elif not performing:
		# training: no contest, just the mode. The prop and pattern are NOT repeated
		# here (Louis: no redundancy) - the routine card at the foot of the stage
		# owns them, along with the keys that switch them.
		var nb := next_ball_strength()
		hud_card(Rect2(LX, 16, LW, 94.0 if nb > 0 else 74.0))
		var tl := "PRACTICE" + ("   -   DEBUG" if debug_mode else "")
		draw_string(font, Vector2(LX + 14, 40), tl, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(16), Color(0.72, 0.82, 0.9))
		draw_string(font, Vector2(LX + 14, 60), "no crowd, no pay", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(12), warm)
		# the count keys, said once here; the bottom-left card counts the load itself
		draw_string(font, Vector2(LX + 14, 78), "%s  %s  step the count" % [String(k_count()[0]), String(k_count()[1])], HORIZONTAL_ALIGNMENT_LEFT, -1, ps(11), Color(0.72, 0.66, 0.56, 0.85))
		if nb > 0:
			draw_string(font, Vector2(LX + 14, 94), "next ball at Strength %d" % nb, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(11), Color(0.72, 0.66, 0.56, 0.85))

	# ============================ RIGHT RAIL: you ============================
	# hidden during the results panel so it never lingers, dimmed, beside the card
	if not results_open:
		var RW := 264.0
		var RX := s.x - 18.0 - RW
		# STATE: only what actually moves or matters DURING a run (Louis: the play
		# HUD is not a character sheet). Stamina drains live, so it stays; unspent
		# stat points are actionable (Tab), so they get one pulsing line. Gold,
		# Reputation, and the LV/XP bar never change mid-run - they live in the
		# day hub, the sheet, and the results card instead of being repeated here.
		var pts_row := points > 0
		hud_card(Rect2(RX, 16, RW, 66.0 if pts_row else 48.0), Color(0.95, 0.66, 0.4, 0.30), show_guide_step == 1)
		var sx := RX + 14.0
		var sw := RW - 28.0
		var sfrac := clampf(stamina / maxf(1.0, stamina_max), 0.0, 1.0)
		# a colorblind pass (Still open): the green-to-red lerp below was the one
		# unverified spot, since the number readout beside it is small and easy to
		# miss mid-set. Under STAM_LOW the label itself now says so and pulses, a
		# second, non-color signal right where the eye already is (Louis's pattern
		# elsewhere: the last drop mark and the capped streak label both do the same).
		var stam_low := sfrac < STAM_LOW
		var stam_a := 0.55 + 0.45 * sin(float(tick) * 0.3) if stam_low else 0.85
		draw_string(font, Vector2(sx, 38), "STAMINA  -  LOW" if stam_low else "STAMINA", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(11), Color(1.0, 0.55, 0.42, stam_a) if stam_low else Color(0.85, 0.9, 0.85, 0.85))
		draw_string(font, Vector2(sx + sw - 80.0, 38), "%d / %d" % [int(round(stamina)), int(stamina_max)], HORIZONTAL_ALIGNMENT_RIGHT, 80.0, ps(11), Color(0.85, 0.9, 0.85, 0.85))
		var stcol := Color(0.55, 0.80, 0.6)
		if stam_low:
			stcol = stcol.lerp(Color(0.95, 0.35, 0.25), clampf((STAM_LOW - sfrac) / STAM_LOW, 0.0, 1.0))
		draw_meter(sx, 44, sw, 11.0, sfrac, stcol)
		if pts_row:
			var pa := 0.75 + 0.25 * sin(float(tick) * 0.08)
			draw_string(font, Vector2(sx, 74), "+%d stat point%s  -  %s" % [points, "" if points == 1 else "s", k_sheet()[0]], HORIZONTAL_ALIGNMENT_LEFT, -1, ps(12), Color(0.7, 0.95, 0.7, pa))

	# a freshly unlocked trick announces itself, non-blocking, only while juggling
	# the small in-play toast now only runs AFTER the card has had its say, so an unlock
	# is announced once by the card and then quietly reinforced where the hands are
	if not tut_active and running and trick_unlock >= 0 and tick - trick_unlock_tick < 360 \
			and ucard_kind < 0:
		draw_trick_unlock_banner(font, s)
	# trick feedback line, tucked LOW under the performer so it never sits in the arcs
	if not tut_active and trick_msg != "" and tick - trick_msg_tick < 90:
		var ta := clampf(1.0 - float(tick - trick_msg_tick) / 90.0, 0.0, 1.0)
		draw_text_shout(font, Vector2(s.x * 0.5 - 200, s.y - 128.0), trick_msg, HORIZONTAL_ALIGNMENT_CENTER, 400, 17, Color(1.0, 0.88, 0.55, ta))
	# the loaded-trick readout (bottom-right corner, out of the way). Lessons draw
	# their own corner card from _draw's lesson branch - draw_hud never runs there.
	if not tut_active and not results_open and not unlocked_tricks().is_empty():
		draw_trick_hud(font, s)
	# the routine readout (bottom-left): the object and pattern in play, and the keys
	# that switch them - live mid-performance now, not just in practice (Louis)
	if not tut_active and not results_open:
		draw_routine_hud(font, s)

	if not tut_active and not results_open:
		# THE STRENGTH WARNING IS A WALL NOW, NOT A WARNING (2026-07-29). It used to read
		# "TOO WEAK ... throws sag low and wild", which described the old deficit model:
		# you could always throw, it just came out badly. Under the new rule the load is
		# simply not liftable, so the line says what is true and what would fix it.
		if strength < prop_req():
			draw_text_shout(font, Vector2(0, s.y - 112.0), "TOO HEAVY  -  %d %s needs Strength %d" % [num_balls, String(cur_prop()["name"]).to_upper(), prop_req()], HORIZONTAL_ALIGNMENT_CENTER, s.x, 13, Color(1.0, 0.55, 0.4))
		if not started:
			var verb := "perform" if performing else "practise"
			var pa2 := 0.75 + 0.25 * sin(float(tick) * 0.06)
			# k_throw(), not a hand-typed label: a pad throws with the BUMPERS (LB/RB),
			# and "L2/R2" (this used to read, wrongly - trigger-style names, which are
			# the CATCH buttons) would have sent a pad player's fingers to the wrong pair
			var kt := k_throw()
			var tnames := "( %s or %s )" % [kt[0], kt[1]]
			draw_text_shout(font, Vector2(0, s.y * 0.22), "press a THROW  %s  to %s" % [tnames, verb],
				HORIZONTAL_ALIGNMENT_CENTER, s.x, 21, Color(1.0, 0.86, 0.55, pa2))
			draw_text_shout(font, Vector2(0, s.y * 0.22 + 26.0), "bookings and rest live in the day  -  Esc, then End the session",
				HORIZONTAL_ALIGNMENT_CENTER, s.x, 14, Color(0.85, 0.75, 0.6, 0.8))
		elif not running:
			# training keeps the plain end-of-run line (a booking goes straight to results)
			draw_text_shout(font, Vector2(0, s.y * 0.20), "ROUND OVER", HORIZONTAL_ALIGNMENT_CENTER, s.x, 40, Color(1.0, 0.5, 0.4))
			draw_text_shout(font, Vector2(0, s.y * 0.20 + 40), "best streak %s   XP +%s   -   R goes again, Enter ends the session" % [commafy(best_streak), commafy(run_xp)], HORIZONTAL_ALIGNMENT_CENTER, s.x, 19, Color(0.9, 0.82, 0.7))


#endregion

#region RESULTS CARD, PAUSE MENU, TRICK/ROUTINE HUD
func _result_row(font: Font, lx: float, rx: float, y: float, label: String, value: String, vc: Color, a: float = 1.0) -> void:
	if a <= 0.0:
		return
	var slide := (1.0 - a) * 10.0
	draw_string(font, Vector2(lx + slide, y), label, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(18), Color(0.78, 0.72, 0.66, a))
	draw_string(font, Vector2(rx - 300.0 + slide, y), value, HORIZONTAL_ALIGNMENT_RIGHT, 300.0, ps(18), Color(vc.r, vc.g, vc.b, a))


func results_age() -> int:
	return tick - results_tick if results_tick >= 0 else 999


func results_anim_sfx() -> void:
	# the results card's little sound story, run from the physics tick (draw code
	# must never play audio): soft ticks under the score count-up, the stamp thud,
	# and the record fanfare with a confetti drop
	var age := results_age()
	if age > 8 and age <= 54 and age % 5 == 0:
		play_sfx("count", -22.0, 1.0 + float(age) * 0.004)
	if age >= 64 and not results_stamped:
		results_stamped = true
		play_sfx("stamp", -8.0)
		if results_record:
			play_sfx("record", -7.0)
			var s := get_viewport_rect().size
			spawn_parts(Vector2(s.x * 0.5, s.y * 0.5 - 240.0), Color(1.0, 0.85, 0.45), 20, 2.8, "confetti")
			spawn_parts(Vector2(s.x * 0.5 - 200.0, s.y * 0.5 - 220.0), Color(0.72, 0.86, 0.95), 12, 2.4, "confetti")
			spawn_parts(Vector2(s.x * 0.5 + 200.0, s.y * 0.5 - 220.0), Color(0.95, 0.55, 0.45), 12, 2.4, "confetti")


func draw_ovation(font: Font, s: Vector2) -> void:
	# THE ROOM ON ITS FEET, and nothing else on screen. Deliberately not a card: a card
	# is a receipt, and this is the moment before the receipt - the only thing the player
	# should be doing is watching the flowers come down. The words fade IN over the first
	# third and hold, so the rain is what arrives first and the caption follows it.
	var age := float(OVATION_TICKS - ovation_left)
	var a := clampf(age / 40.0, 0.0, 1.0) * clampf(float(ovation_left) / 30.0, 0.0, 1.0)
	var pulse := 1.0 + 0.03 * sin(age * 0.09)
	var y := s.y * 0.24
	draw_glow(Vector2(s.x * 0.5, y + 14.0), s.x * 0.34, Color(1.0, 0.72, 0.36, 0.16 * a))
	draw_text_shout(font, Vector2(0, y), "STANDING OVATION", HORIZONTAL_ALIGNMENT_CENTER, s.x,
		int(round(40.0 * pulse)), Color(1.0, 0.90, 0.56, a))
	draw_text_shout(font, Vector2(0, y + 34.0), "not one drop, all night", HORIZONTAL_ALIGNMENT_CENTER,
		s.x, 16, Color(0.96, 0.80, 0.66, a * 0.95))
	if ovation_bonus > 0:
		var bx := s.x * 0.5
		var by := y + 68.0
		var txt := "+%s" % commafy(ovation_bonus)
		var tw := font.get_string_size(txt, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(26)).x
		draw_text_shout(font, Vector2(bx - tw * 0.5 - 12.0, by), txt, HORIZONTAL_ALIGNMENT_LEFT, tw + 4.0,
			26, Color(1.0, 0.72, 0.80, a))
		draw_coin_mark(Vector2(bx + tw * 0.5 + 2.0, by - 8.0), 9.0, Color(1, 1, 1, a), true)


func draw_results(font: Font, s: Vector2) -> void:
	# the end-of-performance card: the grade, the numbers, the pay and rep swing, and
	# the venue record to chase. It REVEALS itself: rows slide in one by one while
	# the score counts up, then the grade stamps down. Anticipation is the payoff.
	var age := results_age()
	var card_a := clampf(float(age) / 14.0, 0.0, 1.0)
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.04, 0.02, 0.03, 0.82 * card_a))
	var pw := 580.0
	var ph := 500.0   # tall enough that the footer hints breathe below the XP row
	var px := s.x * 0.5 - pw * 0.5
	var py := s.y * 0.5 - ph * 0.5 + (1.0 - card_a) * 24.0
	soft_card(Rect2(px, py, pw, ph), Color(0.12, 0.07, 0.08, 0.98 * card_a), Color(0.9, 0.6, 0.35, 0.5 * card_a), 2.0, 16.0, 22.0 * card_a)
	if card_a < 1.0:
		return
	var lx := px + 34.0
	var rx := px + pw - 34.0

	# header: the night's outcome and venue; the grade badge stamps in later
	var complete := goals_hit >= NUM_GOALS
	var htag := "THE ACT  -  ALL THREE GOALS" if complete else ("THE ACT  -  %d of %d goals" % [goals_hit, NUM_GOALS])
	var htc := Color(1.0, 0.86, 0.45) if complete else Color(0.9, 0.72, 0.55)
	draw_string(font, Vector2(lx, py + 40.0), htag, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(15), htc)
	draw_string(title_font(), Vector2(lx, py + 74.0), String(venue_data(run_venue)["name"]), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(30), Color(1.0, 0.86, 0.5))
	# WHY the night ended, right under its name, whenever it did not end in a win: the
	# card used to show only what was scored and left the player to guess the cause.
	# The grade badge sits far right, so this line has the left of the card to itself.
	var ft := fail_text()
	if sprint_active and complete:
		draw_string(font, Vector2(lx, py + 96.0), "SPRINT TIME  " + sprint_clock_text(), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13), Color(0.72, 0.92, 1.0))
	elif not complete and String(ft[0]) != "":
		draw_string(font, Vector2(lx, py + 96.0), String(ft[0]), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13), Color(1.0, 0.55, 0.42))
	if age >= 64:
		var k := clampf(float(age - 64) / 9.0, 0.0, 1.0)
		var sc := 1.0 + 1.1 * (1.0 - k) * (1.0 - k)   # stamps down from large to rest
		var g := run_grade()
		var gc := grade_color(g)
		var bc := Vector2(rx - 42.0, py + 56.0)
		draw_set_transform(bc, -0.06 * (1.0 - k), Vector2(sc, sc))
		draw_circle(Vector2.ZERO, 42.0, Color(gc.r, gc.g, gc.b, 0.14 * k + 0.06))
		draw_arc(Vector2.ZERO, 42.0, 0.0, TAU, 40, gc, 3.0, true)
		draw_string(font, Vector2(-42.0, 21.0), g, HORIZONTAL_ALIGNMENT_CENTER, 84.0, ps(58), gc)
		draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	draw_line(Vector2(lx, py + 104.0), Vector2(rx, py + 104.0), Color(0.9, 0.6, 0.35, 0.3), 1.0)

	# stat rows, each fading in a beat after the last; the score value counts up
	var t_count := clampf(float(age - 8) / 46.0, 0.0, 1.0)
	var eased := 1.0 - pow(1.0 - t_count, 3.0)
	var shown_score := score * eased
	var ra := func(i: int) -> float: return clampf(float(age - 10 - i * 7) / 10.0, 0.0, 1.0)
	var y := py + 140.0
	var rowh := 40.0
	_result_row(font, lx, rx, y, "Booking score", score_text(shown_score), Color(1.0, 0.92, 0.72), ra.call(0))
	if age > 54:
		var rec := "NEW VENUE RECORD" if results_record else "best here   %s" % score_text(rec_table()[run_venue])
		if purist:
			rec = "PURIST  -  " + rec
		var recc := Color(1.0, 0.86, 0.42) if results_record else Color(0.68, 0.62, 0.54)
		if results_record:
			recc.a = 0.7 + 0.3 * sin(float(tick) * 0.1)
		draw_string(font, Vector2(rx - 300.0, y + 15.0), rec, HORIZONTAL_ALIGNMENT_RIGHT, 300.0, ps(13), recc)
	y += rowh + 8.0
	var pct := int(round(100.0 * run_clean()))
	_result_row(font, lx, rx, y, "Caught  /  Dropped", "%d  /  %d    (%d%%)" % [caught, dropped, pct], Color(0.86, 0.9, 0.82), ra.call(1)); y += rowh
	_result_row(font, lx, rx, y, "Best streak", str(best_streak), Color(0.9, 0.82, 0.6), ra.call(2)); y += rowh
	# the trick total is a SCORE, so it gets the same thousands separators the booking
	# score two rows above it has (it read "+42600" beside "951,875")
	var tval := "%d   (+%s)" % [tricks_landed, commafy(trick_score)] if trick_score > 0 else str(tricks_landed)
	_result_row(font, lx, rx, y, "Tricks landed", tval, Color(0.93, 0.8, 0.99), ra.call(3)); y += rowh
	draw_line(Vector2(lx, y - 6.0), Vector2(rx, y - 6.0), Color(0.9, 0.6, 0.35, 0.2), 1.0)
	_result_row(font, lx, rx, y + 20.0, "Pay", "+%s %s" % [commafy(last_pay), coin_word()], Color(1.0, 0.86, 0.45), ra.call(4)); y += rowh
	var rsign := "+" if last_rep_delta >= 0 else ""
	var rcol := Color(0.7, 0.95, 0.7) if last_rep_delta >= 0 else Color(1.0, 0.55, 0.45)
	_result_row(font, lx, rx, y + 20.0, "Reputation", "%s%d    %s" % [rsign, last_rep_delta, rep_tier()], rcol, ra.call(5)); y += rowh
	_result_row(font, lx, rx, y + 20.0, "XP gained", "+%s" % commafy(run_xp), Color(0.82, 0.9, 0.7), ra.call(6)); y += rowh

	# ...and the reason spelled out, in the clear space above the footer: the headline
	# by the venue name says WHAT happened, this says what to do about it. Last to
	# arrive, so it reads as the card's closing word rather than competing with the
	# count-up. A complete booking has no reason to give (nothing failed).
	# the slot is the gap between the last row and the footer, and it is drawn as a BOX
	# so a long line stops inside it instead of running down into the footer
	var word_box := Rect2(px + 34.0, py + ph - 74.0, pw - 68.0, 36.0)
	if first_show_reaction != "" and age > 74:
		# THE FIRST SHOW'S CLOSING REACTION (2026-07-31, Louis) takes this slot over
		# everything else it would normally hold - it is a one-time event, and outranks
		# the ordinary fail/coach lines below for exactly this one card.
		draw_wrap_fit(font, first_show_reaction, word_box, 13, Color(1.0, 0.9, 0.72, 0.9), HORIZONTAL_ALIGNMENT_CENTER)
	elif not complete and String(ft[1]) != "" and age > 74:
		draw_wrap_fit(font, String(ft[1]), word_box, 12, Color(0.86, 0.72, 0.64, 0.85), HORIZONTAL_ALIGNMENT_CENTER)
	elif not set_collapsed and age > 74:
		# a survived act (all goals, or a chosen bow) gets a coaching line in the same
		# closing-word slot - what to work on next, drawn from this night's real numbers
		var coach := coach_text()
		if coach != "":
			draw_wrap_fit(font, coach, word_box, 12, Color(0.74, 0.86, 0.72, 0.85), HORIZONTAL_ALIGNMENT_CENTER)

	# footer: how to continue, breathing gently once everything is revealed. every
	# slot in this footer has a real pad button - the pad footer names only
	# buttons it can actually press, via the remap-aware k_* hint helpers.
	if age > 80:
		var fa := 0.7 + 0.3 * sin(float(tick) * 0.05)
		var foot := ""
		if pending_win:
			# the top stage just fell: the first key rolls into the victory screen
			foot = "you have conquered the final stage  -  any key"
		elif too_tired():
			# the reason R will not work, in words, right where the player looks
			foot = "too tired to go again  -  %s back to the day, then sleep" % String(k_finish()[0])
		else:
			var kgo := String(k_trick()[0]) if pad_active() else "R"
			var kshop := String(k_shop()[0])
			var ksheet := String(k_sheet()[0])
			var kmenu := String(k_finish()[0])
			foot = "%s  go again      %s  shop      %s  back to the day" % [kgo, kshop, kmenu]
			if points > 0:
				foot = "%s  go again      %s  +%d point%s      %s  shop      %s  back to the day" % [kgo, ksheet, points, "" if points == 1 else "s", kshop, kmenu]
		draw_string(font, Vector2(px, py + ph - 26.0), foot, HORIZONTAL_ALIGNMENT_CENTER, pw, ps(15), Color(0.86, 0.78, 0.64, fa))


func draw_pause_screen(font: Font, s: Vector2) -> void:
	# the one call site every screen uses to open the pause menu, same seam as
	# draw_sheet_screen/draw_settings_screen (see there). pause_input/pause_activate
	# (pause_sel 0..2) own the behaviour; this side is only the picture.
	draw_pause_cards(font, s)


func draw_pause_cards(font: Font, s: Vector2) -> void:
	# THE PAUSE MENU as three colour-coded cards, in the same pause_sel order
	# pause_activate already drives (shipped 2026-07-27, no longer a variant) - purely a
	# different picture, colour-coded by what each option actually does (calm to
	# resume, warm to step out, warning-red to quit), the same card language as the
	# shop/sheet/settings-cards alternate.
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.04, 0.02, 0.03, 0.74))
	var pw := 400.0
	var ph := 336.0
	var px := s.x * 0.5 - pw * 0.5
	var py := s.y * 0.5 - ph * 0.5
	soft_card(Rect2(px, py, pw, ph), Color(0.10, 0.06, 0.075, 0.99), Color(0.9, 0.6, 0.35, 0.5), 2.0, 18.0, 26.0)
	draw_string(title_font(), Vector2(px, py + 46.0), "PAUSED", HORIZONTAL_ALIGNMENT_CENTER, pw, ps(28), Color(1.0, 0.86, 0.5))
	draw_ornament(px + pw * 0.5, py + 62.0, 120.0, Color(0.82, 0.62, 0.34, 0.7))

	var opts := [
		{"name": "Resume", "note": "right where it froze", "col": Color(0.55, 0.88, 0.52), "icon": "play"},
		{"name": "Restart this step" if tut_active else "End the session", "note": "a fresh tutorial deal" if tut_active else "back to the day hub", "col": Color(0.96, 0.76, 0.4), "icon": "back"},
		{"name": "Quit Game", "note": "close " + GAME_TITLE, "col": Color(0.92, 0.42, 0.36), "icon": "quit"},
	]
	var cw := pw - 44.0
	var cx := px + 22.0
	var ch := 58.0
	var gap := 12.0
	var oy := py + 92.0
	for i in opts.size():
		var o: Dictionary = opts[i]
		var sel: bool = i == pause_sel
		var cy := oy + float(i) * (ch + gap)
		var ac: Color = o["col"]
		var fillc := Color(ac.r * 0.18, ac.g * 0.18, ac.b * 0.18, 0.95) if sel else Color(0.11, 0.08, 0.09, 0.85)
		soft_card(Rect2(cx, cy, cw, ch), fillc, Color(ac.r, ac.g, ac.b, 0.9 if sel else 0.3), 2.0 if sel else 1.0, 11.0, 10.0)
		# an icon disc on the left says what the option DOES at a glance
		var ic := Vector2(cx + 34.0, cy + ch * 0.5)
		icon_disc(ic, 16.0, Color(ac.r, ac.g, ac.b, 0.22),
			Color(ac.r, ac.g, ac.b, 0.9 if sel else 0.55), 2.0)
		match String(o["icon"]):
			"play":
				draw_colored_polygon(PackedVector2Array([ic + Vector2(-5, -7), ic + Vector2(-5, 7), ic + Vector2(8, 0)]), ac)
			"back":
				draw_line(ic + Vector2(7, 0), ic + Vector2(-6, 0), ac, 2.5)
				draw_polyline(PackedVector2Array([ic + Vector2(-1, -6), ic + Vector2(-7, 0), ic + Vector2(-1, 6)]), ac, 2.5)
			"quit":
				draw_line(ic + Vector2(-6, -6), ic + Vector2(6, 6), ac, 2.5)
				draw_line(ic + Vector2(6, -6), ic + Vector2(-6, 6), ac, 2.5)
		draw_fit_string(font, Vector2(cx + 62.0, cy + 26.0), String(o["name"]), HORIZONTAL_ALIGNMENT_LEFT, cw - 78.0, 18, Color(1.0, 0.95, 0.85) if sel else Color(0.86, 0.81, 0.74))
		draw_fit_string(font, Vector2(cx + 62.0, cy + 44.0), String(o["note"]), HORIZONTAL_ALIGNMENT_LEFT, cw - 78.0, 11, Color(0.76, 0.71, 0.64, 0.85))
	var pfoot2 := "up / down  -  A selects  -  B resumes" if pad_active() else "up / down  -  Enter  -  Esc resumes"
	draw_string(font, Vector2(px, py + ph - 22.0), pfoot2, HORIZONTAL_ALIGNMENT_CENTER, pw, ps(12), Color(0.72, 0.66, 0.6))


func exp_on(id: String) -> bool:
	# THE ONE PLACE AN EXPERIMENT IS READ. Every reader used to call experiments.get()
	# with its own hand-written fallback, and one of them (flowers_on) said `false` while
	# the declaration said `true` - harmless only for exactly as long as the key is never
	# missing, which is not a property anything guarantees. One accessor with one default
	# cannot disagree with itself. Every experiment in EXPERIMENT_DEFS is a candidate for
	# shipping, so the default here is ON, matching the `experiments` declaration.
	return bool(experiments.get(id, true))


func variant_def(id: String) -> Dictionary:
	for d: Dictionary in VARIANT_DEFS:
		if String(d["id"]) == id:
			return d
	return {}


func variant(id: String) -> String:
	# THE ONE PLACE A VARIANT IS READ, for the same reason exp_on exists: a reader that
	# writes its own fallback is a reader that can disagree with the declaration. Returns
	# the OPTION KEY ("classic", "volume", ...) rather than an index, so a caller reads as
	# prose and a reordered list cannot silently change what it means. Out of range - an
	# old settings file naming an option since removed - falls back to option 0, which is
	# always the shipped default.
	var d := variant_def(id)
	if d.is_empty():
		return "classic"
	var opts: Array = d["opts"]
	var i := int(art_variants.get(id, 0))
	if i < 0 or i >= opts.size():
		i = 0
	return String((opts[i] as Dictionary)["key"])


func draw_debug_panel() -> void:
	# EXPERIMENTS (F9): a small, always-on-top list of alternate screens/behaviours
	# that can be flipped on without ever touching the code - see debug_panel_input
	# and EXPERIMENT_DEFS. Computes its own font/size like _draw_state_fade does,
	# since it draws on top of whatever screen _draw_screen already drew this frame.
	var s := get_viewport_rect().size
	var font := game_font()
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.02, 0.01, 0.03, 0.55))
	var pw := 620.0
	# A ROW GROWS INTO THE SPACE THE LIST IS NOT USING. A flat 80 was tuned for four
	# entries and trimmed the two longest descriptions at that; with one entry left it
	# would waste most of the card and still trim. Dividing a fixed budget by the count
	# means a short list explains itself properly and a long one still fits on screen.
	#
	# A DESIGN ROW IS TALLER THAN AN EXPERIMENT ROW because it carries a whole row of
	# options under its name, and the options are the thing being chosen between - the
	# name alone ("The performer") says nothing about what pressing right will do.
	var nv := VARIANT_DEFS.size()
	var rows := nv + EXPERIMENT_DEFS.size()
	# THE BUDGET IS THE SCREEN, not a tuned constant. The old 380 was picked when the list
	# was four entries long; at nine rows it overflowed the window by 32px and cut the last
	# experiment's state off the bottom. Solving row_h from the space actually available
	# means adding a tenth row can never do that again.
	const PANEL_CHROME := 116.0     # title, two section captions and the footer hint
	const VROW_EXTRA := 26.0        # a design row's option pills and hint line
	var budget := s.y - 24.0 - PANEL_CHROME - VROW_EXTRA * float(nv)
	var row_h := clampf(budget / float(maxi(rows, 1)), 46.0, 150.0)
	var vrow_h := row_h + VROW_EXTRA
	var ph := PANEL_CHROME + vrow_h * float(nv) + row_h * float(EXPERIMENT_DEFS.size())
	var px := s.x * 0.5 - pw * 0.5
	var py := s.y * 0.5 - ph * 0.5
	soft_card(Rect2(px, py, pw, ph), Color(0.07, 0.09, 0.13, 0.98), Color(0.5, 0.8, 1.0, 0.6), 2.0, 16.0, 22.0)
	draw_string(font, Vector2(px, py + 34.0), "DESIGNS AND EXPERIMENTS", HORIZONTAL_ALIGNMENT_CENTER, pw, ps(22), Color(0.7, 0.9, 1.0))
	draw_string(font, Vector2(px, py + 54.0), "debug build only  -  never reaches a release export", HORIZONTAL_ALIGNMENT_CENTER, pw, ps(11), Color(0.55, 0.65, 0.7))
	var ry := py + 76.0
	draw_string(font, Vector2(px + 20.0, ry), "THE LOOK", HORIZONTAL_ALIGNMENT_LEFT, pw - 40.0, ps(11), Color(0.5, 0.72, 0.85))
	ry += 12.0
	for i in nv:
		var vdef: Dictionary = VARIANT_DEFS[i]
		var vid := String(vdef["id"])
		var opts: Array = vdef["opts"]
		var cur := clampi(int(art_variants.get(vid, 0)), 0, opts.size() - 1)
		var sel := i == debug_panel_sel
		if sel:
			draw_rect(Rect2(px + 10.0, ry - 4.0, pw - 20.0, vrow_h - 8.0), Color(0.5, 0.8, 1.0, 0.10))
			draw_rect(Rect2(px + 10.0, ry - 4.0, pw - 20.0, vrow_h - 8.0), Color(0.5, 0.8, 1.0, 0.5), false, 1.5)
		draw_fit_string(font, Vector2(px + 20.0, ry + 16.0), String(vdef["name"]), HORIZONTAL_ALIGNMENT_LEFT,
			pw - 260.0, 15, Color(1.0, 0.95, 0.8) if sel else Color(0.8, 0.78, 0.72))
		# THE OPTIONS AS A ROW OF PILLS, not a single "2/3". The whole panel exists so a
		# choice can be made by eye, and a counter tells you where you are without ever
		# telling you what the alternatives were - so a look never gets tried once.
		var ox := px + pw - 24.0
		for j in range(opts.size() - 1, -1, -1):
			var o: Dictionary = opts[j]
			var oname := String(o["name"])
			var ow := font.get_string_size(oname, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(12)).x + 16.0
			ox -= ow
			var live := j == cur
			if live:
				draw_rect(Rect2(ox, ry + 2.0, ow, 20.0), Color(0.5, 0.8, 1.0, 0.22 if sel else 0.12))
				draw_rect(Rect2(ox, ry + 2.0, ow, 20.0), Color(0.6, 0.86, 1.0, 0.8 if sel else 0.4), false, 1.0)
			draw_string(font, Vector2(ox, ry + 17.0), oname, HORIZONTAL_ALIGNMENT_CENTER, ow, ps(12),
				Color(1.0, 0.97, 0.88) if live else Color(0.5, 0.5, 0.52))
			ox -= 6.0
		draw_string(font, Vector2(px + 20.0, ry + 36.0), String((opts[cur] as Dictionary)["hint"]),
			HORIZONTAL_ALIGNMENT_LEFT, pw - 40.0, ps(11), Color(0.72, 0.82, 0.62))
		draw_wrap_fit(font, String(vdef["desc"]), Rect2(px + 20.0, ry + 44.0, pw - 40.0, vrow_h - 52.0), 10, Color(0.62, 0.6, 0.58))
		ry += vrow_h
	draw_string(font, Vector2(px + 20.0, ry), "BEHAVIOUR", HORIZONTAL_ALIGNMENT_LEFT, pw - 40.0, ps(11), Color(0.5, 0.72, 0.85))
	ry += 12.0
	for i in EXPERIMENT_DEFS.size():
		var edef: Dictionary = EXPERIMENT_DEFS[i]
		var eid := String(edef["id"])
		var on := exp_on(eid)
		var esel := (i + nv) == debug_panel_sel
		if esel:
			draw_rect(Rect2(px + 10.0, ry - 4.0, pw - 20.0, row_h - 8.0), Color(0.5, 0.8, 1.0, 0.10))
			draw_rect(Rect2(px + 10.0, ry - 4.0, pw - 20.0, row_h - 8.0), Color(0.5, 0.8, 1.0, 0.5), false, 1.5)
		var namecol := Color(1.0, 0.95, 0.8) if esel else Color(0.8, 0.78, 0.72)
		draw_fit_string(font, Vector2(px + 20.0, ry + 16.0), String(edef["name"]), HORIZONTAL_ALIGNMENT_LEFT, pw - 140.0, 15, namecol)
		var statecol := Color(0.55, 0.95, 0.55) if on else Color(0.7, 0.6, 0.55)
		draw_string(font, Vector2(px + pw - 100.0, ry + 16.0), "ON" if on else "off", HORIZONTAL_ALIGNMENT_RIGHT, 80.0, ps(15), statecol)
		draw_wrap_fit(font, String(edef["desc"]), Rect2(px + 20.0, ry + 26.0, pw - 40.0, row_h - 34.0), 10, Color(0.62, 0.6, 0.58))
		ry += row_h
	draw_string(font, Vector2(px, py + ph - 20.0), "up / down picks  -  left / right changes a look  -  Enter  -  F9 / Esc closes", HORIZONTAL_ALIGNMENT_CENTER, pw, ps(12), Color(0.6, 0.68, 0.72))


#region SKILL CARDS - the Balatro-style deck
# ONE CARD PER SKILL, PLUS ONE BACK PER KIND (2026-07-28, Louis: "make a design for the
# trick card (in general) and the pattern card (in general) and then for each trick and
# pattern a personal design card: the same way balatro has its jokers. Make the designs fun
# and perhaps a bit funny / joking").
#
# The joke on each face is HIS, verbatim, and that matters more than it looks: a picture
# chosen by the person who names the skill is a picture that reads. Spin is a ballerina.
# Behind the Back is two people talking behind your back. High Toss is something absurdly
# tall. Cascade is a waterfall and Reverse Cascade is that same waterfall upside down.
# Columns is a Greek temple. Shower is a shower; Half Shower is a very SMALL shower.
# Tennis is a tennis racket.
#
# WHY THESE ARE NOT `draw_skill_preview`. That function draws the skill's true choreography
# off the sim's own road data, and it is still what the Skills screen shows once a skill is
# yours - it is the better ANSWER to "how does this work". But it is a diagram, and every
# diagram of a juggling pattern looks like every other one: arcs over a little man. A card
# you are dealt has a different job. It has to be worth turning over, and it has to be
# recognisable across a room, which is what a pun drawn large gets you and a correct
# trajectory plot does not.
#
# THREE RULES, all inherited from passes that were paid for elsewhere in this file:
#   * Every art function draws in UNIT SPACE - a box from -0.5 to 0.5 with the origin in
#     the middle - inside a transform the dispatcher sets. One uniform scale, so circles
#     stay circles at any card size and a line width means the same thing on the unlock
#     card (344px) and the Skills screen (140px). Art functions must NEVER call
#     draw_set_transform themselves: Godot REPLACES the transform rather than composing,
#     so an inner call silently throws the card's own scale away.
#   * No text inside the art. Under a scaled transform a font is scaled too, which is how
#     you get a 3px-tall word or a 40px one depending on the caller. Anything that has to
#     be read is drawn by the caller, outside the transform.
#   * Filled SHAPES, not decorative strokes, and nothing whose feature size lands under
#     about 1.5px at the smallest place the card is drawn - the same shimmer band the round
#     props and the juggler's face were both rebuilt to get out of.
const CARD_TRICK_COL := Color(1.0, 0.84, 0.42)      # warm gold: a flourish
const CARD_PATTERN_COL := Color(0.82, 0.70, 0.98)   # cool violet: a shape

func card_kind_col(is_trick: bool) -> Color:
	return CARD_TRICK_COL if is_trick else CARD_PATTERN_COL


func card_field(is_trick: bool) -> Color:
	# the paper each kind is printed on: a deep version of its own accent, so a trick card
	# and a pattern card are telling apart at a glance even face down, from the colour
	# alone, before any of the marks on them are legible
	return Color(0.16, 0.11, 0.06) if is_trick else Color(0.12, 0.10, 0.18)


# WHERE THE CORNER INDEX SITS, as named numbers, because a neighbour has to be placed off them.
# The Skills screen prints the skill's name across the foot of its card, and "REVERSE CASCADE"
# at full width runs straight into the bottom-right pip - so that name's width is measured off
# CARD_PIP_KEEP rather than off a number somebody once eyeballed. Same rule the goal stem's
# bloom established: the amount by which a mark claims space belongs next to the mark.
const CARD_PIP_PAD := 19.0
const CARD_PIP_R := 5.6
const CARD_PIP_KEEP := (CARD_PIP_PAD + CARD_PIP_R) * 2.0   # width both indices take off a row

func draw_card_pip(c: Vector2, is_trick: bool, r: float, col: Color) -> void:
	# THE INDEX MARK, the same one its own back is built round: a trick is a flourish, so its
	# mark is the four-point sparkle this file already uses to mean exactly that; a pattern is
	# a shape that repeats, so its mark is a closed ring. Nothing here names the SKILL - a
	# face-down card still gives nothing away, which is the whole point of the flip.
	if is_trick:
		draw_star4(c, r, col)
	else:
		draw_arc(c, r * 0.80, 0.0, TAU, 18, col, maxf(1.0, r * 0.32), true)


func draw_card_frame_v2(r: Rect2, is_trick: bool, a: float, lift: float = 1.0) -> void:
	# THE CARD, with the one thing it was missing: AN INDEX IN ITS CORNERS. The old frame was a
	# rounded body, a keyline and an inset second line, which is a well-made PANEL - and a panel
	# is what it read as, because the corners were empty. Every printed card in the world puts a
	# small mark in two opposite corners, and it is what the eye uses to decide it is holding a
	# card rather than looking at a box with a picture in it. Two marks, diagonally opposite,
	# the way a real index is placed so either end of the card can be read.
	var kc := card_kind_col(is_trick)
	var f := card_field(is_trick)
	soft_card(r, Color(f.r, f.g, f.b, 0.99 * a), Color(kc.r, kc.g, kc.b, 0.85 * a),
		2.5 * lift, 14.0 * lift, 22.0)
	var inset := 7.0 * lift
	draw_rect(Rect2(r.position.x + inset, r.position.y + inset,
		r.size.x - inset * 2.0, r.size.y - inset * 2.0), Color(kc.r, kc.g, kc.b, 0.22 * a),
		false, maxf(1.0, lift))
	# A SQUASHED CARD GETS NO INDEX. The unlock card's flip is drawn by narrowing the rect, so
	# mid-turn the two corners are a few pixels apart and two marks that belong at the edges
	# would collide over the middle of the card. 0.45 is comfortably under a card at rest
	# (344/520 = 0.66) and comfortably over the 0.34 squash the face is drawn from at all.
	if r.size.x < r.size.y * 0.45:
		return
	var pr := CARD_PIP_R * lift
	var pad := CARD_PIP_PAD * lift
	var pc := Color(kc.r, kc.g, kc.b, 0.62 * a)
	draw_card_pip(Vector2(r.position.x + pad, r.position.y + pad), is_trick, pr, pc)
	draw_card_pip(Vector2(r.position.x + r.size.x - pad, r.position.y + r.size.y - pad),
		is_trick, pr, pc)


func draw_card_art_window(r: Rect2, is_trick: bool, a: float, lift := 1.0) -> void:
	# THE PICTURE HANGS IN A FRAME, and that is the mark that was doing the most damage by its
	# absence. The illustration was drawn straight onto the paper, so the art had no edge for the
	# eye to read it against and the empty corners of the art box looked like unfinished card
	# rather than deliberate margin - which is most of why the face read as three quarters of a
	# card. A recessed plate, one shade off the paper, a hairline round it, and a pool of the
	# kind's own colour behind the subject so it sits IN something.
	#
	# No drop shadow: this plate is sunk INTO the card, and a shadow under it would claim it was
	# lying on top - the same wrong claim the money hat's cutaway interior had to avoid.
	var kc := card_kind_col(is_trick)
	var f := card_field(is_trick)
	soft_card(r, Color(f.r * 0.52, f.g * 0.52, f.b * 0.60, 0.96 * a),
		Color(kc.r, kc.g, kc.b, 0.34 * a), 1.0 * lift, 10.0 * lift, 0.0)
	draw_glow(r.get_center() + Vector2(0.0, r.size.y * 0.06), minf(r.size.x, r.size.y) * 0.60,
		Color(kc.r, kc.g, kc.b, 0.13 * a))


func draw_card_frame(r: Rect2, is_trick: bool, a: float, lift: float = 1.0) -> void:
	if exp_on("card_v2"):
		draw_card_frame_v2(r, is_trick, a, lift)
		return
	# THE CARD ITSELF, shared by every face and both backs so the deck looks like a deck.
	# Rounded body in the kind's own paper, a bright keyline, and an inset second line -
	# which is the mark that makes a rectangle read as a printed card rather than a panel.
	#
	# SEAM: two keys, skill vs trick, matching the one thing the frame encodes. `a` rides
	# in as the tint's alpha so the deal/flip animations keep fading the frame exactly as
	# they do now. NOT sized off the art: cards are laid out by the screens that own them,
	# and `lift` (the hover raise) scales the rect, so the sprite follows the rect.
	if art_blit_rect("ui/card_trick" if is_trick else "ui/card_skill", r, Color(1, 1, 1, a)):
		return
	var kc := card_kind_col(is_trick)
	soft_card(r, Color(card_field(is_trick).r, card_field(is_trick).g, card_field(is_trick).b, 0.99 * a),
		Color(kc.r, kc.g, kc.b, 0.85 * a), 2.5 * lift, 14.0 * lift, 22.0)
	var inset := 7.0 * lift
	draw_rect(Rect2(r.position.x + inset, r.position.y + inset,
		r.size.x - inset * 2.0, r.size.y - inset * 2.0), Color(kc.r, kc.g, kc.b, 0.22 * a), false, maxf(1.0, lift))


func _card_rosette(c: Vector2, k: float, kc: Color, amul: float, spin: float) -> void:
	# the trick back's mark: two rings of rays on opposite spins. Split out of the back so the
	# same rosette can be struck three times down the card at three sizes - which is how an
	# ornamental card back fills its height without inventing a second motif for the job.
	# ON THE ART GRID: the origin snapped so the pitch means the real grid, and the pitch
	# published so the rays land on it. The rays are polygons and were never antialiased,
	# but at this scale one screen pixel of stair step is HALF an art pixel - detail at
	# twice the density of everything around it, which reads as a soft edge.
	_cap_px = cap_grid(k)
	draw_set_transform(art_snap(c), spin, Vector2.ONE * k)
	for ring in 2:
		var n := 12 if ring == 0 else 8
		var r0 := 0.14 + 0.13 * float(ring)
		var r1 := 0.26 + 0.15 * float(ring)
		for i in n:
			var ang := TAU * float(i) / float(n) + (0.0 if ring == 0 else 0.22)
			var dir := Vector2(cos(ang), sin(ang))
			var wid := 0.030 if ring == 0 else 0.020
			var perp := Vector2(-dir.y, dir.x) * wid
			draw_colored_polygon(PackedVector2Array([dir * r0 + perp, dir * r1, dir * r0 - perp]),
				ca(Color(kc.r, kc.g, kc.b, (0.30 if ring == 0 else 0.20) * amul)))
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	_cap_px = 0.0


func draw_skill_card_back_v2(r: Rect2, is_trick: bool, a: float, lift: float = 1.0) -> void:
	# THE BACK, on the same materials as the face (2026-07-30). Its contract is unchanged and it
	# is the whole reason the card exists: you have earned A TRICK, or A PATTERN, and nothing on
	# it may hint at which one - no prop, no silhouette, no arc belonging to any single skill.
	#
	# What was wrong was composition, not concept. One motif sat in the middle of 520px of bare
	# paper, so the back was a medallion floating in a void where the face is a framed picture,
	# and the two sides did not look like one card. Now the field is the SAME recessed plate the
	# picture hangs in, and the motif fills it: the rosette struck three times down the card, big
	# in the middle and small above and below, which is how an ornamental back has always filled
	# its height - one mark, three sizes, rather than a second idea.
	#
	# AND THE LATTICE WAS LEAVING THE CARD. Its odd rows were laid out at
	# `x = -0.315 + col * 0.21 + 0.105` in units of min(w, h), so the far arc reached 0.52 of a
	# card whose half-width is 0.5 - measured 7px out through the right-hand border, on a screen
	# whose standing rule is that nothing leaves its container. Rows are computed off the PLATE
	# now and cannot reach past it. The old rows were also nine-point polylines with square ends
	# alternating up and down, which met at visible kinks: what read on screen was five rows of
	# wavy line with chevrons punched into them, not a weave. One continuous sine per row, phase
	# flipped row to row, gives the interlock honestly and has no joints to show.
	draw_card_frame(r, is_trick, a, lift)
	var kc := card_kind_col(is_trick)
	var f := card_field(is_trick)
	# THE PLATE LEAVES ROOM FOR THE TWO THINGS THAT ARE NOT THE FIELD: the kind pill rides the
	# card's top edge and "press any key to turn it over" sits at its foot, and both are drawn
	# after this. A plate run to a symmetric inset put the prompt down ON the field instead of on
	# the paper margin where it belongs, so the two ends are inset by different amounts on purpose.
	var plate := Rect2(r.position.x + 17.0 * lift, r.position.y + 40.0 * lift,
		r.size.x - 34.0 * lift, r.size.y - 70.0 * lift)
	if plate.size.x < 8.0 or plate.size.y < 8.0:
		return
	soft_card(plate, Color(f.r * 0.52, f.g * 0.52, f.b * 0.60, 0.96 * a),
		Color(kc.r, kc.g, kc.b, 0.30 * a), 1.0 * lift, 9.0 * lift, 0.0)
	var c := plate.get_center()
	var k := minf(plate.size.x, plate.size.y)
	_cap_a = a
	if is_trick:
		var t := float(atick()) * 0.006
		_card_rosette(c, k, kc, 1.0, t)
		for sgn: float in [-1.0, 1.0]:
			_card_rosette(c + Vector2(0.0, sgn * plate.size.y * 0.335), k * 0.42, kc, 0.72, -t * 0.7)
		fill_disc_pix(c, k * 0.105, ca(Color(kc.r, kc.g, kc.b, 0.30)))
		fill_disc_pix(c, k * 0.075, ca(Color(f.r * 1.6, f.g * 1.6, f.b * 1.6, 0.95)))
		draw_star4(c, k * 0.062, ca(Color(kc.r, kc.g, kc.b, 0.85)))
	else:
		# the weave: continuous waves, every other row in antiphase, so consecutive rows bow
		# toward and away from each other and the eye reads the interlock. No single wave here
		# is any pattern's road - which is the constraint the whole back is built under.
		var rows := 7
		var pad := 14.0 * lift
		var x0 := plate.position.x + pad
		var x1 := plate.position.x + plate.size.x - pad
		var step := plate.size.y / float(rows + 1)
		for row in rows:
			var y := plate.position.y + step * float(row + 1)
			var phase := 0.0 if row % 2 == 0 else PI
			var pts := PackedVector2Array()
			for sg in 33:
				var u := float(sg) / 32.0
				pts.append(Vector2(lerpf(x0, x1, u), y + sin(u * TAU * 1.75 + phase) * step * 0.40))
			draw_polyline(pts, ca(Color(kc.r, kc.g, kc.b, 0.24)), maxf(1.0, 1.7 * lift))
		fill_disc_pix(c, k * 0.095, ca(Color(f.r * 1.35, f.g * 1.35, f.b * 1.45, 0.98)))
		fill_disc_pix(c, k * 0.085, ca(Color(kc.r, kc.g, kc.b, 0.22)))
		draw_ring_pix(c, k * 0.062, maxf(ART_PIXEL, 1.5 * lift), ca(Color(kc.r, kc.g, kc.b, 0.75)))
		fill_disc_pix(c, k * 0.026, ca(Color(kc.r, kc.g, kc.b, 0.8)))
	_cap_a = 1.0


func draw_skill_card_back(r: Rect2, is_trick: bool, a: float, lift: float = 1.0) -> void:
	if exp_on("card_v2"):
		draw_skill_card_back_v2(r, is_trick, a, lift)
		return
	# THE BACK. This is the whole of what the player is told when the card is dealt: you
	# have earned A TRICK, or A PATTERN. Nothing on it may hint at which one - so no prop,
	# no arc, no silhouette that belongs to any single skill.
	#
	# What separates the two backs is what the two KINDS are. A trick is a flourish, one
	# gesture, so its back is a rosette: rays from a centre, turning. A pattern is a shape
	# that repeats, so its back is a LATTICE of interlocking arcs - the weave itself,
	# abstracted, going nowhere in particular.
	draw_card_frame(r, is_trick, a, lift)
	var kc := card_kind_col(is_trick)
	var k := minf(r.size.x, r.size.y)
	var c := r.get_center()
	_cap_a = a
	draw_set_transform(c, 0.0, Vector2.ONE * k)
	if is_trick:
		# the rosette: two rings of rays on opposite spins, so the back is alive without
		# any of it being a thing
		var t := float(atick()) * 0.006
		for ring in 2:
			var n := 12 if ring == 0 else 8
			var r0 := 0.14 + 0.13 * float(ring)
			var r1 := 0.26 + 0.15 * float(ring)
			for i in n:
				var ang := t * (1.0 if ring == 0 else -0.7) + TAU * float(i) / float(n)
				var dir := Vector2(cos(ang), sin(ang))
				var wid := 0.030 if ring == 0 else 0.020
				var perp := Vector2(-dir.y, dir.x) * wid
				draw_colored_polygon(PackedVector2Array([
					dir * r0 + perp, dir * r1, dir * r0 - perp]),
					ca(Color(kc.r, kc.g, kc.b, 0.30 if ring == 0 else 0.20)))
		draw_circle(Vector2.ZERO, 0.105, ca(Color(kc.r, kc.g, kc.b, 0.30)))
		draw_circle(Vector2.ZERO, 0.075, ca(Color(card_field(true).r * 1.6, card_field(true).g * 1.6, card_field(true).b * 1.6, 0.95)))
		# a star in the middle - the same four-point sparkle the money hat's glints use,
		# because it is the one mark in this game that already means "a flourish"
		draw_star4(Vector2.ZERO, 0.062, ca(Color(kc.r, kc.g, kc.b, 0.85)))
	else:
		# the lattice: rows of arcs, every other row offset, alternate rows leaning the
		# other way. Read together they interlock, which is what a weave IS - and no
		# single arc in it is any pattern's road.
		for row in 5:
			var y := -0.42 + float(row) * 0.21
			var off := 0.0 if row % 2 == 0 else 0.105
			for col in 4:
				var x := -0.315 + float(col) * 0.21 + off
				var up := (row + col) % 2 == 0
				var pts := PackedVector2Array()
				for sg in 9:
					var u := float(sg) / 8.0
					var bow := sin(u * PI) * (0.072 if up else -0.072)
					pts.append(Vector2(lerpf(x - 0.10, x + 0.10, u), y + bow))
				draw_polyline(pts, ca(Color(kc.r, kc.g, kc.b, 0.26)), 0.016)
		draw_circle(Vector2.ZERO, 0.085, ca(Color(card_field(false).r * 1.7, card_field(false).g * 1.7, card_field(false).b * 1.7, 0.96)))
		draw_arc(Vector2.ZERO, 0.062, 0.0, TAU, 28, ca(Color(kc.r, kc.g, kc.b, 0.75)), 0.014, true)
		draw_circle(Vector2.ZERO, 0.026, ca(Color(kc.r, kc.g, kc.b, 0.8)))
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	_cap_a = 1.0


func draw_skill_card_art(r: Rect2, is_trick: bool, idx: int, a: float) -> void:
	# THE FACE'S PICTURE, dispatched by the skill's own id - never by its index, which is
	# the fragility that had the shop drawing a helmet for the chainsaw and the seventh
	# prop buying glasses. Removing Overthrow on the very day these were drawn is exactly
	# the event an index-keyed table gets wrong.
	# the window goes down BEFORE the range check, so a card whose skill has been removed from
	# the table still shows an empty frame rather than a hole where its picture should be
	var box := r
	if exp_on("card_v2"):
		draw_card_art_window(r, is_trick, a)
		# ...AND THE PICTURE IS DRAWN INSIDE THE WINDOW, not up against it. A framed rect has
		# ROUNDED corners; the Shower's water is a full-width block and the Temple's floor
		# another, so both ran flush into the frame and clipped visibly across the curve of the
		# bottom two corners. Shrinking the box the art is measured in fixes every card at once
		# and needs no card to know it is in a frame - which matters, because the same nine
		# illustrations are also drawn without one when the experiment is off.
		box = r.grow(-minf(r.size.x, r.size.y) * 0.055)
	var tab: Array = TRICKS if is_trick else PATTERNS
	if idx < 0 or idx >= tab.size():
		return
	var id := String((tab[idx] as Dictionary)["id"])
	var k := minf(box.size.x, box.size.y)
	# REVERSE CASCADE IS CASCADE, UPSIDE DOWN, and it is drawn that way rather than
	# redrawn (Louis: "the upside down waterfall picture"). A negative y scale is the whole
	# implementation, which also guarantees the two cards are the same joke told twice -
	# if the waterfall is ever improved, its reflection improves with it.
	var flip := -1.0 if id == "rcasc" else 1.0
	# THE PAINTED ILLUSTRATION, if there is one (2026-08-07, Louis: "the cards still look
	# awful"). The drawings below stay as the seam's fallback, exactly as the traced juggler
	# does behind the showman - delete a ui/card_* line from the manifest and that card goes
	# back to being drawn. Reverse Cascade still borrows the Cascade's picture and still
	# flips it, which is the whole joke.
	# ...MEASURED AGAINST `r`, NOT THE INSET BOX. The 5.5% inset above exists because the
	# DRAWINGS run full-bleed - the Shower's water and the Temple's floor are solid blocks that
	# clipped visibly across the frame's rounded corners. A painted illustration carries its own
	# transparent margin, so it does not need the inset; and it cannot afford it either, since
	# the art is authored at exactly the window's size and any shrink drops it below the whole
	# 2x scale art_blit_fit insists on, silently falling back to the drawing.
	var akey := "ui/card_" + ("cascade" if id == "rcasc" else id)
	if art_bank.has(akey):
		# ONCE A CARD HAS A PAINTING, IT NEVER SHOWS THE DRAWING AGAIN - not even for a frame.
		# The unlock card fades in and TURNS OVER (a horizontal squash), so both its alpha and
		# its width are in motion: gating on either one meant the vector fallback flickered
		# through mid-animation, which is worse than any single frame being imperfect. Alpha
		# rides the tint, and a box too narrow for the picture simply shows nothing - the card
		# is edge-on at that moment and there is nothing to read anyway.
		var tint := Color(1.0, 1.0, 1.0, a)
		if flip > 0.0:
			art_blit_fit(akey, r, tint)
		else:
			# upside down, about the box's own centre so the picture cannot drift as it turns
			var c0 := art_snap(r.get_center())
			draw_set_transform(c0, 0.0, Vector2(1.0, -1.0))
			art_blit_fit(akey, Rect2(r.position - c0, r.size), tint)
			draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
		return
	_cap_a = a
	# THE ORIGIN IS SNAPPED FIRST, and that is the precondition for everything the cap_*
	# helpers do: they land a unit coordinate on the art grid by rounding it to a multiple of
	# ART_PIXEL / k, which is only the art grid if the point the whole space hangs from is on
	# it too. Snap the origin, publish the pitch, and every circle and ribbon inside the
	# illustration rasterises like the rest of the game.
	_cap_px = cap_grid(k)
	draw_set_transform(art_snap(box.get_center()), 0.0, Vector2(k, k * flip))
	match id:
		"spin":       card_art_spin()
		"btb":        card_art_btb()
		"high":       card_art_high()
		"cascade":    card_art_waterfall()
		"rcasc":      card_art_waterfall()
		"columns":    card_art_temple()
		"shower":     card_art_duck(false)
		"halfshower": card_art_duck(true)
		"tennis":     card_art_racket()
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	# the arrow that says which way the water is going, drawn AFTER the flip is undone so
	# it is never itself upside down
	if id == "rcasc":
		# smaller and pushed out to the margin: at its first size it was as wide as a
		# stream and sat on top of one, so the card read as four falls and an arrow rather
		# than three and a note
		var up := box.get_center() + Vector2(k * 0.425, k * 0.03)
		draw_colored_polygon(PackedVector2Array([
			up + Vector2(0.0, -k * 0.15), up + Vector2(k * 0.033, -k * 0.095),
			up + Vector2(k * 0.012, -k * 0.095), up + Vector2(k * 0.012, k * 0.13),
			up + Vector2(-k * 0.012, k * 0.13), up + Vector2(-k * 0.012, -k * 0.095),
			up + Vector2(-k * 0.033, -k * 0.095)]), ca(Color(0.72, 0.92, 1.0, 0.70)))
	_cap_a = 1.0
	_cap_px = 0.0


func card_art_spin() -> void:
	# SPIN = A BALLERINA, ALONE (2026-07-29, Louis: "i want the ballerina alone (no spin
	# animation or anything else, just a detailed ballerina)"). The sweep arcs, the airborne
	# prop and the sparkle are all gone: they were saying "this is a spin" a second time, in a
	# weaker voice, and the one thing a card face has to do is be a picture. Everything spent
	# on them is spent on HER instead - a bodice with a seam, a tutu of three plates, a real
	# arabesque line, pointe shoes with ribbons.
	#
	# NOTHING ON THIS CARD MOVES. That is the standing rule for the whole deck now: a still
	# illustration reads as a printed card, and an animated one reads as a screen.
	var skin := ca(Color(0.94, 0.76, 0.60))
	var skin_sh := ca(Color(0.84, 0.63, 0.48))
	var tulle := ca(Color(0.99, 0.72, 0.82))
	var tulle_mid := ca(Color(0.96, 0.58, 0.72))
	var tulle_lo := ca(Color(0.84, 0.40, 0.57))
	var bodice := ca(Color(0.93, 0.44, 0.61))
	var hair := ca(Color(0.36, 0.21, 0.14))
	# THE SUPPORTING LEG, straight from hip to pointe, and the working leg lifted behind in
	# arabesque. The line from her raised foot through the hip to the fingertips is what makes
	# a ballerina drawing read; everything else is costume.
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.030, 0.030), Vector2(0.026, 0.030), Vector2(0.022, 0.190),
		Vector2(0.014, 0.300), Vector2(-0.012, 0.300), Vector2(-0.018, 0.190)]), skin)
	draw_colored_polygon(PackedVector2Array([   # the pointe shoe, blocked at the toe
		Vector2(-0.016, 0.294), Vector2(0.020, 0.294), Vector2(0.024, 0.352),
		Vector2(0.010, 0.376), Vector2(-0.008, 0.372), Vector2(-0.014, 0.340)]), tulle_lo)
	for rb: float in [-1.0, 1.0]:   # the ribbons, crossed at the ankle
		cap_seg(Vector2(rb * 0.004, 0.296), Vector2(rb * 0.052, 0.238), tulle_lo, 0.012)
	# LIMBS ARE CAPSULES, NOT HAND-WRITTEN POLYGONS, and that is a correctness rule rather
	# than a shortcut. The first version drew each arm and the raised leg as one eight-point
	# outline - out along the top edge, back along the bottom - and at the shoulder the two
	# edges CROSSED: measured, the outgoing edge sat at y -0.153 where the returning one sat
	# at -0.136 and the order flipped by x -0.044. Godot refuses a self-intersecting polygon
	# silently, so the arms simply did not draw and the log filled with "Invalid polygon data,
	# triangulation failed" - one per frame, which is exactly the signature this file already
	# records for a static shape. `draw_capsule` is a tapered quad with rounded caps built
	# from a normal, so it cannot fold through itself at any width.
	draw_capsule(Vector2(0.020, 0.058), Vector2(0.250, 0.166), 0.086, 0.044, skin_sh)
	draw_colored_polygon(PackedVector2Array([
		Vector2(0.246, 0.150), Vector2(0.300, 0.162), Vector2(0.306, 0.184),
		Vector2(0.250, 0.184)]), tulle_lo)
	# THE TUTU: three plates, darkest underneath. One soft ellipse is a skirt; the stack is
	# what makes it stiff, and stiffness is the whole silhouette of classical ballet.
	cap_ell(Vector2(0.0, 0.070), 0.250, 0.052, tulle_lo)
	cap_ell(Vector2(0.0, 0.044), 0.238, 0.058, tulle_mid)
	cap_ell(Vector2(0.0, 0.018), 0.216, 0.062, tulle)
	# the bodice, boned: a narrow taper with a centre seam and a sweetheart neckline
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.056, 0.030), Vector2(0.056, 0.030), Vector2(0.046, -0.120),
		Vector2(0.026, -0.150), Vector2(0.0, -0.136), Vector2(-0.026, -0.150),
		Vector2(-0.046, -0.120)]), bodice)
	cap_seg(Vector2(0.0, -0.130), Vector2(0.0, 0.026), ca(Color(0.78, 0.32, 0.50)), 0.010)
	# ARMS IN THIRD ARABESQUE: one reaching forward and up along the line of the raised leg,
	# one held back. Tapering polygons, never arcs - an arc has constant width and square ends,
	# which at this size is a coat hanger rather than an arm.
	# the forward arm, in two capsules so it bends at the elbow the way an arm does
	draw_capsule(Vector2(-0.040, -0.112), Vector2(-0.140, -0.208), 0.062, 0.048, skin)
	draw_capsule(Vector2(-0.140, -0.208), Vector2(-0.244, -0.306), 0.048, 0.030, skin)
	cap_disc(Vector2(-0.250, -0.312), 0.020, skin)               # the hand
	# ...and the one held back, lower and behind, which is what makes it an arabesque rather
	# than a shrug
	draw_capsule(Vector2(0.044, -0.104), Vector2(0.166, -0.052), 0.058, 0.044, skin_sh)
	draw_capsule(Vector2(0.166, -0.052), Vector2(0.268, 0.008), 0.044, 0.028, skin_sh)
	cap_disc(Vector2(0.274, 0.014), 0.019, skin_sh)
	# head, neck, and the bun - the second-cheapest ballerina cue after the tutu
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.020, -0.158), Vector2(0.020, -0.158), Vector2(0.018, -0.196), Vector2(-0.018, -0.196)]), skin)
	cap_disc(Vector2(0.0, -0.236), 0.056, skin)
	draw_colored_polygon(PackedVector2Array([   # the hair, drawn flat to the skull
		Vector2(-0.056, -0.246), Vector2(-0.034, -0.288), Vector2(0.020, -0.294),
		Vector2(0.054, -0.262), Vector2(0.048, -0.230), Vector2(-0.046, -0.222)]), hair)
	cap_disc(Vector2(0.062, -0.272), 0.032, hair)
	cap_disc(Vector2(0.070, -0.280), 0.014, ca(Color(0.46, 0.29, 0.20)))
	# the two marks that make a face at 0.05 of a card: a lowered lash line and a small mouth
	cap_seg(Vector2(-0.030, -0.242), Vector2(-0.014, -0.240), ca(Color(0.28, 0.18, 0.14)), 0.010)
	cap_seg(Vector2(0.014, -0.240), Vector2(0.030, -0.242), ca(Color(0.28, 0.18, 0.14)), 0.010)
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.012, -0.212), Vector2(0.012, -0.212), Vector2(0.0, -0.200)]), ca(Color(0.80, 0.34, 0.42)))


func card_art_btb() -> void:
	# BEHIND THE BACK = A HAND OF CARDS HELD BEHIND THE BACK (2026-07-29, Louis: "design
	# something else for behind the back, i don't like this one (entirely different concept)").
	#
	# The gossip version was three figures and a whisper cloud, and it needed all three to say
	# one thing. This is the same idiom - something kept behind your back - with nothing in the
	# picture but the gesture: a torso from behind, one arm round it, and a fan of playing
	# cards in the hidden hand. It reads at a glance, it is funny in the dry way a card up the
	# sleeve is funny, and it belongs to a card GAME, which the deck this sits in already is.
	var coat := ca(Color(0.34, 0.26, 0.36))
	var coat_lo := ca(Color(0.24, 0.18, 0.27))
	var skin := ca(Color(0.90, 0.72, 0.56))
	var card_face := ca(Color(0.96, 0.94, 0.88))
	var card_edge := ca(Color(0.62, 0.58, 0.54))
	# the back of him: shoulders, a nape, and a centre seam so it reads as a coat from behind
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.300, 0.470), Vector2(-0.246, 0.070), Vector2(-0.120, -0.030),
		Vector2(0.120, -0.030), Vector2(0.246, 0.070), Vector2(0.300, 0.470)]), coat)
	cap_seg(Vector2(0.0, -0.020), Vector2(0.0, 0.460), coat_lo, 0.016)
	draw_colored_polygon(PackedVector2Array([   # the collar
		Vector2(-0.104, -0.026), Vector2(0.104, -0.026), Vector2(0.086, 0.026), Vector2(-0.086, 0.026)]), coat_lo)
	cap_disc(Vector2(0.0, -0.118), 0.108, skin)
	draw_colored_polygon(PackedVector2Array([   # all hair: this is the back of a head
		Vector2(-0.110, -0.106), Vector2(-0.092, -0.208), Vector2(0.0, -0.242),
		Vector2(0.092, -0.208), Vector2(0.110, -0.106), Vector2(0.0, -0.076)]), ca(Color(0.22, 0.15, 0.11)))
	# THE ARM ROUND THE BACK - the whole gesture, so it gets the biggest shape on the card
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.248, 0.096), Vector2(-0.300, 0.180), Vector2(-0.268, 0.286),
		Vector2(-0.148, 0.324), Vector2(-0.040, 0.320), Vector2(-0.036, 0.264),
		Vector2(-0.150, 0.264), Vector2(-0.226, 0.234), Vector2(-0.238, 0.166)]), coat_lo)
	cap_disc(Vector2(-0.014, 0.292), 0.050, skin)
	# THE FAN OF CARDS in that hand, splayed. Drawn last so it sits clear of the body, and
	# angled outward so the fan reads as a fan rather than as a stack.
	for k in 5:
		var a := -0.72 + float(k) * 0.30
		var d := Vector2(sin(a), -cos(a))
		var s := Vector2(cos(a), sin(a))
		var root := Vector2(0.006, 0.300)
		draw_colored_polygon(PackedVector2Array([
			root + s * 0.030, root - s * 0.030,
			root - s * 0.044 + d * 0.210, root + s * 0.044 + d * 0.210]), card_face)
		cap_seg(root - s * 0.030, root - s * 0.044 + d * 0.210, card_edge, 0.008)
	# one pip on the nearest card, which is what stops the fan reading as a hand of blank paper
	draw_colored_polygon(PackedVector2Array([
		Vector2(0.086, 0.176), Vector2(0.114, 0.208), Vector2(0.086, 0.240), Vector2(0.058, 0.208)]),
		ca(Color(0.78, 0.22, 0.26)))


func card_art_high() -> void:
	# HIGH TOSS = A VERY TALL BUILDING (2026-07-29, Louis: "For high toss, i want a big
	# building: eg: the eiffel tower or tower of pisa"). A leaning tower is the better of his
	# two for one reason: it is unmistakable in silhouette at any size, where a lattice tower
	# needs its lattice to be legible or it is a triangle. It also happens to be funny beside a
	# trick about throwing things badly high.
	#
	# NOTHING MOVES AND THERE IS NO PROP ON IT. The old version had a dotted trail, a cloud, a
	# bird and a ball drifting at the top; the brief is a building.
	var stone := ca(Color(0.90, 0.86, 0.76))
	var stone_sh := ca(Color(0.72, 0.68, 0.58))
	var stone_dk := ca(Color(0.52, 0.49, 0.42))
	var sky_lo := ca(Color(0.36, 0.30, 0.40, 0.30))
	# a hint of sky behind it, so the tower has something to be tall against
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.50, -0.50), Vector2(0.50, -0.50), Vector2(0.50, 0.30), Vector2(-0.50, 0.30)]), sky_lo)
	# THE LEAN is the whole joke, so it is generous: about 9 degrees, which reads instantly
	# and still leaves the tower standing on its own base.
	var lean := 0.155
	# EIGHT STOREYS OF COLONNADE. The arcade is what makes it Pisa rather than a chimney, and
	# it is drawn as real columns - a filled band with gaps - not as scored lines, because at
	# this size a line is a scratch and a gap is architecture.
	for st in 8:
		var t := float(st) / 7.0
		var y0 := 0.300 - t * 0.680
		var y1 := y0 - 0.086
		var dx := lean * t
		var w := 0.148 - t * 0.012
		draw_colored_polygon(PackedVector2Array([
			Vector2(-w + dx, y0), Vector2(w + dx, y0), Vector2(w + dx, y1), Vector2(-w + dx, y1)]), stone)
		# the shaded right face, so the drum is a cylinder
		draw_colored_polygon(PackedVector2Array([
			Vector2(w * 0.48 + dx, y0), Vector2(w + dx, y0), Vector2(w + dx, y1), Vector2(w * 0.48 + dx, y1)]), stone_sh)
		# the columns of the arcade, cut out of the middle of the band
		if st > 0:
			for cix in 5:
				var cxp := -w * 0.78 + float(cix) * (w * 1.56 / 4.0) + dx
				draw_colored_polygon(PackedVector2Array([
					Vector2(cxp - 0.010, y0 - 0.014), Vector2(cxp + 0.010, y0 - 0.014),
					Vector2(cxp + 0.010, y1 + 0.014), Vector2(cxp - 0.010, y1 + 0.014)]), stone_dk)
		# the cornice between storeys - a thin lighter lip, which is what separates them
		draw_colored_polygon(PackedVector2Array([
			Vector2(-w - 0.014 + dx, y1), Vector2(w + 0.014 + dx, y1),
			Vector2(w + 0.010 + dx, y1 - 0.016), Vector2(-w - 0.010 + dx, y1 - 0.016)]), stone_sh)
	# the belfry: narrower, open, with its bell
	var by := 0.300 - 0.680 - 0.086
	var bdx := lean
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.104 + bdx, by), Vector2(0.104 + bdx, by),
		Vector2(0.092 + bdx, by - 0.092), Vector2(-0.092 + bdx, by - 0.092)]), stone)
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.040 + bdx, by - 0.006), Vector2(0.040 + bdx, by - 0.006),
		Vector2(0.034 + bdx, by - 0.074), Vector2(-0.034 + bdx, by - 0.074)]), stone_dk)
	draw_colored_polygon(PackedVector2Array([   # the bell, hanging in the opening
		Vector2(-0.020 + bdx, by - 0.062), Vector2(0.020 + bdx, by - 0.062),
		Vector2(0.014 + bdx, by - 0.026), Vector2(-0.014 + bdx, by - 0.026)]), ca(Color(0.72, 0.58, 0.28)))
	# the base, which stays put while the rest leans - that contrast is what sells the tilt
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.196, 0.300), Vector2(0.196, 0.300), Vector2(0.216, 0.372), Vector2(-0.216, 0.372)]), stone_sh)
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.30, 0.372), Vector2(0.30, 0.372), Vector2(0.32, 0.428), Vector2(-0.32, 0.428)]), stone_dk)
	# ...and the ground it stands on, so the lean has a vertical to be measured against
	draw_rect(Rect2(-0.50, 0.428, 1.0, 0.072), ca(Color(0.30, 0.26, 0.22)))


func card_art_waterfall() -> void:
	# CASCADE = A WATERFALL, and Reverse Cascade is this drawing flipped (see the dispatcher).
	# THIRD ATTEMPT (2026-07-29, Louis: "The waterfalls look horrible, try again with more
	# attention to detail"), and the two failures were the same failure: I kept drawing the
	# WATER and treating the rock as a container for it. A waterfall is a landscape. What makes
	# one look like a photograph is depth - a far wall, a near wall, and the fall between them -
	# and layered strata, because rock at a cliff face is visibly bedded in horizontal courses.
	# Neither of those is about the water at all.
	#
	# So: a lit sky slot at the back, a shadowed gorge, bedded strata on both walls, ONE fall
	# with a real lip and a spreading curtain, mist where it lands, and two foreground boulders
	# to close the frame. Nothing moves.
	var sky := ca(Color(0.44, 0.52, 0.58))
	var far := ca(Color(0.30, 0.32, 0.33))
	var rock := ca(Color(0.26, 0.24, 0.23))
	var rock_lo := ca(Color(0.17, 0.16, 0.16))
	var rock_hi := ca(Color(0.38, 0.35, 0.31))
	var moss := ca(Color(0.24, 0.34, 0.22))
	var water := ca(Color(0.72, 0.86, 0.94, 0.92))
	var water_hi := ca(Color(0.93, 0.97, 1.0, 0.95))
	var water_lo := ca(Color(0.48, 0.68, 0.84, 0.92))
	var pool := ca(Color(0.20, 0.40, 0.54))
	var mist := ca(Color(0.90, 0.95, 1.0, 0.16))
	# the slot of sky the gorge opens onto - the brightest thing on the card, so everything
	# else reads as being in shadow
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.50, -0.50), Vector2(0.50, -0.50), Vector2(0.50, -0.34), Vector2(-0.50, -0.34)]), sky)
	# the FAR wall, lighter and less contrasty: aerial perspective, which is what puts it behind
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.50, -0.34), Vector2(0.50, -0.34), Vector2(0.50, 0.10), Vector2(-0.50, 0.10)]), far)
	for b in 4:
		var by := -0.30 + float(b) * 0.100
		cap_seg(Vector2(-0.50, by), Vector2(0.50, by + 0.012), ca(Color(0.22, 0.24, 0.25)), 0.014)
	# THE TWO NEAR WALLS, bedded. Each course is a filled band with a slightly different tone
	# and an irregular lower edge - strata, not stripes.
	for side: float in [-1.0, 1.0]:
		var inner := 0.150
		var outer := 0.50
		for c in 6:
			var y0 := -0.34 + float(c) * 0.098
			var y1 := y0 + 0.098
			var jag := 0.026 * (1.0 if c % 2 == 0 else -1.0)
			var tone := rock if c % 2 == 0 else rock_lo
			draw_colored_polygon(PackedVector2Array([
				Vector2(side * outer, y0), Vector2(side * (inner + jag), y0 + 0.014),
				Vector2(side * (inner - jag * 0.6), y1), Vector2(side * outer, y1)]), tone)
			# a lit top edge on every other course - the light comes from the sky slot above
			if c % 2 == 0:
				cap_seg(Vector2(side * outer, y0 + 0.004), Vector2(side * (inner + jag), y0 + 0.018),
					rock_hi, 0.012)
		# moss on the wet inner lip, which is the one colour note that says these rocks are wet
		draw_colored_polygon(PackedVector2Array([
			Vector2(side * inner, -0.20), Vector2(side * (inner + 0.052), -0.16),
			Vector2(side * (inner + 0.040), 0.10), Vector2(side * inner, 0.06)]), moss)
	# THE LIP: the ledge the water leaves from, drawn as a solid overhanging slab so the fall
	# has somewhere to come out of rather than starting in mid-air
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.20, -0.34), Vector2(0.20, -0.34), Vector2(0.19, -0.28), Vector2(-0.19, -0.28)]), rock_hi)
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.19, -0.28), Vector2(0.19, -0.28), Vector2(0.17, -0.245), Vector2(-0.17, -0.245)]), rock_lo)
	# THE FALL, spreading as it drops: a curtain, with vertical striations of three brightnesses
	# because falling water separates into ropes rather than staying a sheet
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.168, -0.252), Vector2(0.168, -0.252), Vector2(0.212, 0.232), Vector2(-0.212, 0.232)]), water)
	for r in 7:
		var u := (float(r) / 6.0) * 2.0 - 1.0
		var xt := u * 0.150
		var xb := u * 0.192
		var wdt := (0.020 if r % 2 == 0 else 0.012)
		draw_colored_polygon(PackedVector2Array([
			Vector2(xt - wdt, -0.250), Vector2(xt + wdt, -0.250),
			Vector2(xb + wdt * 1.3, 0.230), Vector2(xb - wdt * 1.3, 0.230)]),
			water_hi if r % 3 == 0 else water_lo)
	# the crest, where the sheet is still glassy before it breaks up
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.170, -0.256), Vector2(0.170, -0.256), Vector2(0.176, -0.212), Vector2(-0.176, -0.212)]), water_hi)
	# THE POOL, with a curved surface, and the mist where the fall lands - that white haze is
	# the single mark that makes water look like it is arriving with force
	var surf := PackedVector2Array()
	for s in 17:
		var t := float(s) / 16.0
		surf.append(Vector2(lerpf(-0.50, 0.50, t), 0.232 - 0.030 * sin(t * PI)))
	surf.append(Vector2(0.50, 0.50))
	surf.append(Vector2(-0.50, 0.50))
	draw_colored_polygon(surf, pool)
	for mz in 5:
		cap_ell(Vector2(0.0, 0.222 - float(mz) * 0.020), 0.30 - float(mz) * 0.030,
			0.070 - float(mz) * 0.009, mist)
	for f in 9:
		var fx := -0.30 + float(f) * 0.075
		cap_disc(Vector2(fx, 0.226 + 0.014 * sin(float(f) * 1.9)),
			0.030 - 0.008 * float(f % 3), ca(Color(0.95, 0.98, 1.0, 0.75)))
	# the ripple rings spreading out from the impact
	for rr in 3:
		var ryv := 0.290 + float(rr) * 0.052
		cap_seg(Vector2(-0.20 - float(rr) * 0.08, ryv), Vector2(0.20 + float(rr) * 0.08, ryv),
			ca(Color(0.70, 0.88, 1.0, 0.26)), 0.010)
	# FOREGROUND BOULDERS, darkest of all, closing the bottom corners. They are what turn a
	# flat elevation into a view of somewhere.
	for side2: float in [-1.0, 1.0]:
		draw_colored_polygon(PackedVector2Array([
			Vector2(side2 * 0.50, 0.500), Vector2(side2 * 0.50, 0.330),
			Vector2(side2 * 0.360, 0.300), Vector2(side2 * 0.250, 0.360),
			Vector2(side2 * 0.230, 0.500)]), rock_lo)
		cap_seg(Vector2(side2 * 0.480, 0.340), Vector2(side2 * 0.350, 0.316), rock, 0.014)


func card_art_temple() -> void:
	# COLUMNS = A GREEK TEMPLE (Louis kept this one and asked only for it to be still: "i want
	# the greek temple without balls or moving parts"). The four props that used to bob on top
	# are gone; what was spent on them goes into the architecture instead - real entasis on the
	# shafts, a proper three-band entablature, and steps that are steps.
	var stone := ca(Color(0.89, 0.85, 0.75))
	var stone_lo := ca(Color(0.68, 0.64, 0.55))
	var shade := ca(Color(0.44, 0.41, 0.36))
	var deep := ca(Color(0.28, 0.26, 0.24))
	# the crepidoma: three steps, each wider than the one above, which is what a temple stands
	# on and what a single slab never reads as
	for k in 3:
		var t := float(k)
		draw_colored_polygon(PackedVector2Array([
			Vector2(-0.40 - t * 0.038, 0.286 + t * 0.052), Vector2(0.40 + t * 0.038, 0.286 + t * 0.052),
			Vector2(0.40 + t * 0.038, 0.338 + t * 0.052), Vector2(-0.40 - t * 0.038, 0.338 + t * 0.052)]),
			stone_lo if k % 2 == 0 else stone)
	# the cella wall behind the colonnade, so the gaps between columns are DARK rather than
	# transparent - that shadow is most of what makes a portico read as deep
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.34, -0.170), Vector2(0.34, -0.170), Vector2(0.34, 0.286), Vector2(-0.34, 0.286)]), deep)
	# SIX COLUMNS with entasis - a real one swells slightly at a third of its height. Drawn as
	# a profile polygon rather than a rectangle, because the swell is the difference between a
	# column and a post.
	for i2 in 6:
		var x := -0.315 + float(i2) * 0.126
		var prof := [[0.286, 0.052], [0.160, 0.055], [0.010, 0.053], [-0.110, 0.047], [-0.170, 0.043]]
		var pts := PackedVector2Array()
		for e in prof:
			pts.append(Vector2(x - float(e[1]), float(e[0])))
		for k2 in range(prof.size() - 1, -1, -1):
			pts.append(Vector2(x + float(prof[k2][1]), float(prof[k2][0])))
		draw_colored_polygon(pts, stone)
		# two flutes, filled bands rather than lines so they survive at card-back size
		for f in 2:
			var fx := x - 0.024 + float(f) * 0.048
			draw_colored_polygon(PackedVector2Array([
				Vector2(fx - 0.008, 0.280), Vector2(fx + 0.008, 0.280),
				Vector2(fx + 0.008, -0.164), Vector2(fx - 0.008, -0.164)]), stone_lo)
		# the capital - an echinus and an abacus, the two blocks that stop a shaft looking cut
		draw_colored_polygon(PackedVector2Array([
			Vector2(x - 0.046, -0.170), Vector2(x + 0.046, -0.170),
			Vector2(x + 0.062, -0.196), Vector2(x - 0.062, -0.196)]), stone)
		draw_colored_polygon(PackedVector2Array([
			Vector2(x - 0.066, -0.196), Vector2(x + 0.066, -0.196),
			Vector2(x + 0.066, -0.222), Vector2(x - 0.066, -0.222)]), stone_lo)
	# THE ENTABLATURE in its three real bands - architrave, frieze with triglyphs, cornice.
	# The triglyphs are the mark that says "Doric" and they cost three rectangles.
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.400, -0.222), Vector2(0.400, -0.222), Vector2(0.400, -0.268), Vector2(-0.400, -0.268)]), stone)
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.400, -0.268), Vector2(0.400, -0.268), Vector2(0.400, -0.322), Vector2(-0.400, -0.322)]), stone_lo)
	for tg in 7:
		var tx2 := -0.336 + float(tg) * 0.112
		draw_colored_polygon(PackedVector2Array([
			Vector2(tx2 - 0.020, -0.272), Vector2(tx2 + 0.020, -0.272),
			Vector2(tx2 + 0.020, -0.318), Vector2(tx2 - 0.020, -0.318)]), shade)
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.430, -0.322), Vector2(0.430, -0.322), Vector2(0.430, -0.362), Vector2(-0.430, -0.362)]), stone)
	# the pediment, with its tympanum sunk into it
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.452, -0.362), Vector2(0.452, -0.362), Vector2(0.0, -0.478)]), stone_lo)
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.330, -0.378), Vector2(0.330, -0.378), Vector2(0.0, -0.462)]), shade)
	draw_colored_polygon(PackedVector2Array([   # the raking cornice, a lighter lip along the rake
		Vector2(-0.452, -0.362), Vector2(0.0, -0.478), Vector2(0.0, -0.496), Vector2(-0.470, -0.372)]), stone)
	draw_colored_polygon(PackedVector2Array([
		Vector2(0.452, -0.362), Vector2(0.0, -0.478), Vector2(0.0, -0.496), Vector2(0.470, -0.372)]), stone)


func card_art_duck(baby: bool) -> void:
	# SHOWER = A DUCK, HALF SHOWER = A BABY DUCK (2026-07-29, Louis: "i want a baby duck for
	# half shower and a adult duck for shower, nothing else on the images"). The bathroom is
	# gone entirely - the tiles, the plumbing, the spray - and the duck he liked is now the
	# whole picture on both cards, at two ages.
	#
	# THE JOKE IS THE PROPORTIONS, NOT THE SIZE. Drawing the same duck at 0.5 scale would give
	# a distant duck, not a young one: a duckling has a BIGGER head against its body, a
	# shorter neck, a stubbier bill and no tail to speak of. Those four numbers are what `baby`
	# changes, so the pair reads as parent and chick rather than as near and far.
	var body_w := 0.300 if not baby else 0.230
	var body_h := 0.215 if not baby else 0.180
	var head_r := 0.115 if not baby else 0.118      # the same head on a smaller bird
	var neck := 0.150 if not baby else 0.060
	var bill_l := 0.135 if not baby else 0.092
	var yolk := ca(Color(1.0, 0.83, 0.26))
	var yolk_lo := ca(Color(0.90, 0.68, 0.16))
	var yolk_hi := ca(Color(1.0, 0.93, 0.58))
	var bill := ca(Color(0.98, 0.58, 0.14))
	var bill_lo := ca(Color(0.86, 0.44, 0.10))
	var cy := 0.130 if not baby else 0.165
	# THE BODY, an egg lying down rather than a circle: a duck's back is long and its breast
	# is deep, and a round body reads as a chick toy at any age.
	cap_ell(Vector2(0.0, cy), body_w, body_h, yolk)
	cap_ell(Vector2(-body_w * 0.18, cy - body_h * 0.22), body_w * 0.70, body_h * 0.58, yolk_hi)
	# the folded wing - one shape, and the only mark that says the body has feathers on it
	draw_colored_polygon(PackedVector2Array([
		Vector2(-body_w * 0.36, cy - body_h * 0.10), Vector2(body_w * 0.10, cy - body_h * 0.34),
		Vector2(body_w * 0.52, cy + body_h * 0.06), Vector2(body_w * 0.06, cy + body_h * 0.30),
		Vector2(-body_w * 0.30, cy + body_h * 0.18)]), yolk_lo)
	cap_seg(Vector2(-body_w * 0.20, cy + body_h * 0.10), Vector2(body_w * 0.34, cy + body_h * 0.02),
		ca(Color(0.80, 0.58, 0.12, 0.55)), 0.010)
	# the tail, which an adult has and a duckling barely does
	if not baby:
		draw_colored_polygon(PackedVector2Array([
			Vector2(body_w * 0.82, cy - 0.030), Vector2(body_w * 1.10, cy - 0.086),
			Vector2(body_w * 1.06, cy + 0.020), Vector2(body_w * 0.80, cy + 0.036)]), yolk_lo)
	# the neck and head, up and to the left
	var hc := Vector2(-body_w * 0.62, cy - neck - head_r * 0.55)
	draw_colored_polygon(PackedVector2Array([
		Vector2(-body_w * 0.30, cy - body_h * 0.52), Vector2(-body_w * 0.86, hc.y + head_r * 0.60),
		Vector2(-body_w * 0.36, hc.y + head_r * 0.66), Vector2(-body_w * 0.02, cy - body_h * 0.44)]), yolk)
	cap_disc(hc, head_r, yolk)
	cap_disc(hc + Vector2(-head_r * 0.24, -head_r * 0.28), head_r * 0.62, yolk_hi)
	# THE BILL: a wedge with a shorter lower mandible under it. A single triangle is a beak
	# and belongs on a sparrow; the two-part flat bill is the whole species.
	draw_colored_polygon(PackedVector2Array([
		hc + Vector2(-head_r * 0.62, -0.014), hc + Vector2(-head_r * 0.62 - bill_l, 0.006),
		hc + Vector2(-head_r * 0.62 - bill_l * 0.92, 0.036), hc + Vector2(-head_r * 0.50, 0.036)]), bill)
	draw_colored_polygon(PackedVector2Array([
		hc + Vector2(-head_r * 0.62, 0.030), hc + Vector2(-head_r * 0.62 - bill_l * 0.80, 0.034),
		hc + Vector2(-head_r * 0.62 - bill_l * 0.74, 0.052), hc + Vector2(-head_r * 0.52, 0.050)]), bill_lo)
	cap_disc(hc + Vector2(-head_r * 0.30, -head_r * 0.16), head_r * 0.155, ca(Color(0.16, 0.12, 0.10)))
	cap_disc(hc + Vector2(-head_r * 0.34, -head_r * 0.22), head_r * 0.058, ca(Color(1, 1, 1, 0.85)))
	# ...and the water it sits on, which is one flat band and the only thing on the card that
	# is not the duck. Without it the bird is floating in the middle of a rectangle.
	var wl := cy + body_h * 0.52
	draw_colored_polygon(PackedVector2Array([
		Vector2(-0.50, wl), Vector2(0.50, wl), Vector2(0.50, 0.50), Vector2(-0.50, 0.50)]),
		ca(Color(0.34, 0.58, 0.78, 0.75)))
	cap_seg(Vector2(-0.50, wl), Vector2(0.50, wl), ca(Color(0.70, 0.88, 1.0, 0.60)), 0.014)
	for rp in 3:
		var rr := 0.10 + float(rp) * 0.085
		cap_seg(Vector2(-rr - 0.10, wl + 0.040 + float(rp) * 0.036),
			Vector2(rr + 0.10, wl + 0.040 + float(rp) * 0.036), ca(Color(0.70, 0.88, 1.0, 0.22)), 0.010)


func card_art_racket() -> void:
	# TENNIS = A TENNIS RACKET (2026-07-29, Louis: "your tennis racket looks ugly and the ball
	# shouldn't move (and also looks bad)"). Rebuilt upright rather than on the diagonal, which
	# fixes most of what was ugly about it: the angled version had to be built out of two
	# rotated basis vectors, so its throat, grip and butt cap were all approximations of shapes
	# that are trivially drawn square-on, and the strings crossed the frame wherever the
	# arithmetic drifted. Upright, the stringbed is a real grid inside a real oval, the throat
	# is a genuine Y, and every edge is exact.
	#
	# The ball is STILL and off to one side, at rest on the ground with the racket - it was
	# bobbing with a motion streak behind it, which is the animation this deck no longer has.
	var frame := ca(Color(0.94, 0.84, 0.32))
	var frame_lo := ca(Color(0.64, 0.54, 0.18))
	var grip := ca(Color(0.26, 0.22, 0.24))
	var grip_hi := ca(Color(0.42, 0.36, 0.38))
	var strung := ca(Color(0.95, 0.95, 0.91, 0.80))
	var hx := -0.06
	var hy := -0.185
	var rx := 0.190
	var ry := 0.245
	# THE HEAD, as a ring: the outer oval filled, then the stringbed, then the inner rim over
	# the strings - so no string can ever cross the frame, which is what a stringbed drawn on
	# top always ends up doing.
	var ring := PackedVector2Array()
	for i2 in 41:
		var t := TAU * float(i2) / 40.0
		ring.append(Vector2(hx + cos(t) * rx, hy + sin(t) * ry))
	draw_colored_polygon(ring, frame)
	var hole := PackedVector2Array()
	for i3 in 41:
		var t2 := TAU * float(i3) / 40.0
		hole.append(Vector2(hx + cos(t2) * (rx - 0.028), hy + sin(t2) * (ry - 0.030)))
	draw_colored_polygon(hole, ca(Color(0.13, 0.11, 0.16)))
	# the strings: mains and crosses, clipped by eye to the oval so none pokes out
	for m in 7:
		var u := (float(m) / 6.0) * 2.0 - 1.0
		var sx := hx + u * (rx - 0.040)
		var h := sqrt(maxf(1.0 - u * u, 0.0)) * (ry - 0.036)
		cap_seg(Vector2(sx, hy - h), Vector2(sx, hy + h), strung, 0.009)
	for n in 9:
		var v := (float(n) / 8.0) * 2.0 - 1.0
		var sy := hy + v * (ry - 0.036)
		var w := sqrt(maxf(1.0 - v * v, 0.0)) * (rx - 0.040)
		cap_seg(Vector2(hx - w, sy), Vector2(hx + w, sy), strung, 0.009)
	var rim := PackedVector2Array()
	for i4 in 41:
		var t3 := TAU * float(i4) / 40.0
		rim.append(Vector2(hx + cos(t3) * (rx - 0.014), hy + sin(t3) * (ry - 0.015)))
	draw_polyline(rim, frame_lo, 0.020)
	# THE THROAT: two arms out of the grip to the bottom of the head, with the gap between them
	# left open. A solid triangle there is a frying pan.
	for sgn: float in [-1.0, 1.0]:
		draw_colored_polygon(PackedVector2Array([
			Vector2(hx + sgn * 0.030, hy + ry + 0.150), Vector2(hx + sgn * 0.062, hy + ry + 0.150),
			Vector2(hx + sgn * 0.150, hy + ry - 0.010), Vector2(hx + sgn * 0.104, hy + ry - 0.020)]), frame)
	# the handle, wrapped in slanted bands, with a butt cap
	var g0 := Vector2(hx, hy + ry + 0.140)
	var g1 := Vector2(hx, hy + ry + 0.430)
	draw_colored_polygon(PackedVector2Array([
		g0 + Vector2(0.050, 0.0), g0 - Vector2(0.050, 0.0),
		g1 - Vector2(0.062, 0.0), g1 + Vector2(0.062, 0.0)]), grip)
	for i5 in 7:
		var t4 := float(i5) / 6.0
		var p := g0.lerp(g1, t4)
		cap_seg(p - Vector2(0.056, 0.014), p + Vector2(0.056, -0.014), grip_hi, 0.010)
	draw_colored_polygon(PackedVector2Array([
		g1 + Vector2(0.072, -0.004), g1 - Vector2(0.072, 0.004),
		g1 + Vector2(-0.066, 0.034), g1 + Vector2(0.066, 0.034)]), frame_lo)
	# THE BALL, at rest beside it: a felt sphere with the seam that makes it a tennis ball and
	# not an orange. Two arcs, and the nap along the top edge.
	var bp := Vector2(0.300, 0.318)
	cap_disc(bp, 0.112, ca(Color(0.78, 0.92, 0.30)))
	cap_disc(bp + Vector2(-0.026, -0.030), 0.082, ca(Color(0.86, 0.96, 0.44)))
	draw_arc(bp + Vector2(0.098, 0.0), 0.108, PI * 0.60, PI * 1.40, 18, ca(Color(0.99, 1.0, 0.94)), 0.016, true)
	draw_arc(bp - Vector2(0.098, 0.0), 0.108, -PI * 0.40, PI * 0.40, 18, ca(Color(0.99, 1.0, 0.94)), 0.016, true)


#endregion


func ucard_deferred() -> bool:
	# NEVER MID-PERFORMANCE (2026-08-05, Louis: a run must not be interrupted by an
	# unlock). The card is not a toast - it HALTS THE WORLD (see the ucard branch in
	# _physics_process, which advances only cine_tick and the hands) and it EATS the next
	# two keypresses. Landing that on a live run is the worst possible moment: every prop
	# in the air freezes, the streak the player was building is interrupted by a modal,
	# and the two keys it swallows are the throw and catch they were in the middle of.
	#
	# And it really could land there. add_xp() calls announce_unlocks(), and XP is awarded
	# per CATCH and per landed trick - so crossing a level mid-run dealt a card instantly.
	return game_state == ST_PLAY and running and not results_open


func deal_ucard(kind: int, idx: int) -> void:
	# DEAL ONE. Every place that grants a skill goes through here so the card's three
	# clocks can never be half-set: `ucard_tick` starts the pop-in, `ucard_flip` at -1
	# means it is still face down, and `ucard_out_tick` at -1 means it has not been
	# dismissed. Setting two of the three by hand at each call site is exactly how a card
	# ends up arriving already turned over.
	#
	# It is also the single choke point for the deferral above, which is why that check
	# lives here rather than at the three grant sites: the skill is still OWNED the moment
	# it is earned (announce_unlocks has already done that, and the small trick banner
	# still says so live), and only the CARD waits for the performance to end.
	if ucard_deferred():
		ucard_queue.append([kind, idx])
		return
	ucard_kind = kind
	ucard_idx = idx
	ucard_tick = atick()
	ucard_flip = -1.0
	ucard_out_tick = -1.0


func draw_unlock_card(font: Font, s: Vector2) -> void:
	# THE UNLOCK CARD, rebuilt around the FLIP (2026-07-28). It arrives face DOWN - all it
	# says is that a trick, or a pattern, has been earned - waits for a press, TURNS OVER,
	# and only then names what is on it. That sequence is the feature Louis asked for:
	# "just show that you unlock something: a trick card or a pattern card, but not which
	# one." The roll happened when the card was dealt (deal_skill_card), so the flip is a
	# reveal and not a decision.
	#
	# THE TURN IS DRAWN AS A HORIZONTAL SQUASH, which is the honest 2D reading of a card
	# rotating about its vertical axis - the same trick draw_juggler's Spin uses on the
	# body, and for the same reason: cos(angle) is the projected width, so the card thins
	# to nothing at the halfway point and swells back out with the other side showing.
	# Done by RESIZING THE RECT rather than by draw_set_transform, because the faces set
	# their own transform for their unit space and an outer one would be replaced, not
	# composed - the trap that is written down at the top of the card region.
	if ucard_kind < 0:
		return
	var age := atick() - ucard_tick
	if age < 0.0:
		return
	var is_trick := ucard_kind == 0
	var d: Dictionary = TRICKS[ucard_idx] if is_trick else PATTERNS[ucard_idx]
	# pop in, then WAIT (2026-07-27, Louis: it waits for a keypress rather than timing
	# out). It holds for as long as it takes - the sim is held with it, see
	# _physics_process - and only starts leaving once `ucard_out_tick` is stamped.
	var grow := 1.0
	var a := 1.0
	if age < UCARD_IN:
		var t := age / UCARD_IN
		var e := 1.0 - pow(1.0 - t, 3.0)          # ease-out cubic
		grow = 0.74 + 0.32 * e - 0.06 * sin(PI * e)
		a = clampf(t * 1.8, 0.0, 1.0)
	if ucard_out_tick >= 0.0:
		a = clampf(1.0 - (atick() - ucard_out_tick) / UCARD_OUT, 0.0, 1.0)
		grow = 1.0 + 0.05 * (1.0 - a)
		if a <= 0.0:
			return
	# how far through the turn, and therefore which side is facing the room
	var turn := 0.0
	if ucard_flip >= 0.0:
		turn = clampf((atick() - ucard_flip) / UCARD_FLIP, 0.0, 1.0)
	var showing_face := turn >= 0.5
	# the projected width. Floored at a sliver rather than allowed to reach zero, for the
	# same reason the Spin's body width is: a card of literally no width is a degenerate
	# polygon, and the frame's rounded corners have nothing to be rounded on.
	var squash := absf(cos(turn * PI))
	if ucard_flip >= 0.0 and turn < 1.0:
		squash = maxf(squash, 0.06)
	elif turn >= 1.0:
		squash = 1.0
	var kindcol := card_kind_col(is_trick)
	# SIZED AROUND THE ART, not guessed. The face's picture wants a near-square box - it is
	# drawn in unit space off the SMALLER side - and the words underneath want a fixed
	# stack. 344x520 is what the Skills preview taught: at the 176 an earlier card tried,
	# a figure stood straight through the lid.
	var cw := 344.0 * grow
	var ch := 520.0 * grow
	var cx := s.x * 0.5
	var cy := s.y * 0.46
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.02, 0.015, 0.03, 0.62 * a))
	# the burst behind it: soft pools that breathe, so the card sits in light. Drawn at the
	# card's FULL width whatever the turn - the light in the room does not thin out because
	# the card is edge-on, and squashing it made the flip look like a wipe.
	var br := 0.5 + 0.5 * sin(atick() * 0.05)
	draw_glow(Vector2(cx, cy), cw * 1.25, Color(kindcol.r, kindcol.g, kindcol.b, 0.20 * a))
	draw_glow(Vector2(cx, cy), cw * (0.85 + 0.06 * br), Color(kindcol.r, kindcol.g, kindcol.b, 0.16 * a))
	# rays, because a dealt card in a game like this arrives lit from behind
	if exp_on("card_v2"):
		# A BEAM STARTS BEHIND THE CARD AND DIES TO NOTHING (2026-07-30). The old rays were
		# twelve draw_lines of CONSTANT width 6 running from radius 0.42cw out to 0.92cw. The
		# card's own half-width is 0.5cw, so at the sides every ray BEGAN in mid-air, 25px clear
		# of the card - and a constant-width line with square ends that starts nowhere, ends
		# nowhere and never changes brightness is a stick. Twelve brown sticks scattered round a
		# card is what was actually on screen, and it was the ugliest thing in the frame.
		#
		# Two fixes, both about what light is. Every wedge now starts at the card's CENTRE, so
		# the whole base of it is hidden and only the part that escapes the card is ever seen -
		# a beam cannot have a visible beginning if its beginning is behind the thing emitting
		# it. And it TAPERS TO ZERO ALPHA at the tip via per-vertex colour, so it has no end
		# either. One draw_polygon each, which matters: the draw_glow note in CLAUDE.md measured
		# stacking low-alpha shapes to fake a gradient at 30% slower, and banding once thinned.
		#
		# The lengths are deliberately uneven. A rectangular card is 0.5cw to its sides but
		# 0.756cw to its top and bottom, so one length makes the vertical rays stubs while the
		# horizontal ones run long; spreading them keeps each one longer than it is wide.
		#
		# AND THE FIRST PASS AT THIS OVERSHOT, which is worth writing down because it is the
		# obvious failure of fixing an underlit thing: 18 wedges at 0.17 alpha and 1.1cw long
		# stopped being backlight and became a cartoon explosion - a hard spiky star bigger than
		# the card, drawing the eye away from the picture the card exists to show. Twelve, at
		# 0.10, reaching about the card's own diagonal. The job of this light is to lift the card
		# off the stage behind it, not to be looked at.
		var warm := Color(kindcol.r, kindcol.g, kindcol.b, 0.10 * a)
		var gone := Color(kindcol.r, kindcol.g, kindcol.b, 0.0)
		var cols := PackedColorArray([warm, warm, gone])
		var mid := Vector2(cx, cy)
		for i in 12:
			var ang := atick() * 0.0022 + TAU * float(i) / 12.0
			var dir := Vector2(cos(ang), sin(ang))
			var perp := Vector2(-dir.y, dir.x) * cw * 0.080
			var len := cw * (0.88 + 0.13 * sin(atick() * 0.021 + float(i) * 1.7))
			draw_polygon(PackedVector2Array([mid + perp, mid - perp, mid + dir * len]), cols)
	else:
		for i in 12:
			var ang := atick() * 0.004 + TAU * float(i) / 12.0
			var dir := Vector2(cos(ang), sin(ang))
			var p0 := Vector2(cx, cy) + dir * cw * 0.42
			var p1 := Vector2(cx, cy) + dir * cw * (0.92 + 0.10 * sin(atick() * 0.03 + float(i)))
			draw_line(p0, p1, Color(kindcol.r, kindcol.g, kindcol.b, 0.10 * a), 6.0 * grow)
	var vw := cw * squash
	var r := Rect2(cx - vw * 0.5, cy - ch * 0.5, vw, ch)
	if not showing_face:
		draw_skill_card_back(r, is_trick, a, grow)
	else:
		draw_card_frame(r, is_trick, a, grow)
		# ...and the face, but only once the card is wide enough to hold a picture. Between
		# about edge-on and a third open there is no room for art, and drawing it into a
		# 20px slot is not a card turning, it is a smear.
		if squash > 0.34:
			# A CARD IS MOSTLY PICTURE (2026-07-30). At 250 of 520 the art took 48% of the face
			# and the words under it needed about 100, which left a THIRD of the card empty -
			# and empty in the worst place, a band of bare paper between the description and
			# the footer. Every real card in this genre spends its height on the illustration
			# and gives the text exactly the strip it needs. 292 is 56%, and the description
			# is then CENTRED in what is left rather than pinned to the top of it, so a
			# one-line skill (the Shower's) and a three-line one (the Spin's) both sit in the
			# middle of the same block instead of one of them leaving a hole under itself.
			var v2 := exp_on("card_v2")
			var art := Rect2(r.position.x + 14.0 * grow, r.position.y + (42.0 if v2 else 44.0) * grow,
				vw - 28.0 * grow, (292.0 if v2 else 250.0) * grow)
			draw_skill_card_art(art, is_trick, ucard_idx, a)
			# the name, sized to fit whatever it is called
			var namew := vw - 30.0 * grow
			var nm := String(d["name"]).to_upper()
			var nsz := fit_size(title_font(), nm, namew, int(maxf(10.0, 27.0 * grow)), 11)
			draw_string(title_font(), Vector2(r.position.x + 15.0 * grow, art.position.y + art.size.y + 34.0 * grow),
				nm, HORIZONTAL_ALIGNMENT_CENTER, namew, ps(nsz), Color(1.0, 0.96, 0.86, a))
			draw_ornament(cx, art.position.y + art.size.y + 46.0 * grow, vw * 0.52,
				Color(kindcol.r, kindcol.g, kindcol.b, 0.7 * a))
			# what it actually does, wrapped into the room that is left above the footer
			var dtop := art.position.y + art.size.y + 58.0 * grow
			var dbox := Rect2(r.position.x + 18.0 * grow, dtop, vw - 36.0 * grow,
				r.position.y + ch - (46.0 if v2 else 34.0) * grow - dtop)
			var dsz := int(maxf(8.0, 12.0 * grow))
			if v2:
				# centred in its own block, measured with the same wrapper that will draw it -
				# never with a guess at how many lines a description runs to
				var nlines := _wrap_lines(font, String(d["desc"]), dbox.size.x, dsz).size()
				var used := float(nlines) * (float(dsz) + 4.0)
				var slack := maxf((dbox.size.y - used) * 0.5, 0.0)
				dbox.position.y += slack
				dbox.size.y -= slack
			draw_wrap_fit(font, String(d["desc"]), dbox, dsz, Color(0.88, 0.83, 0.75, 0.95 * a),
				HORIZONTAL_ALIGNMENT_CENTER if v2 else HORIZONTAL_ALIGNMENT_LEFT)
			draw_string(font, Vector2(r.position.x, r.position.y + ch - 30.0 * grow),
				"SKILLS shows you how" if is_trick else "P switches patterns in training",
				HORIZONTAL_ALIGNMENT_CENTER, vw, ps(int(maxf(8.0, 11.0 * grow))), Color(0.72, 0.68, 0.62, 0.9 * a))
	# THE KIND PILL rides on top of both sides, because it is the one thing that is true
	# either way round: a trick card is a trick card face up or face down. It is what the
	# face-down card says INSTEAD of a name, so it drops the word NEW and simply names the
	# kind until the turn is done.
	if squash > 0.30:
		var pillw := 128.0 * grow * squash
		var pill := Rect2(cx - pillw * 0.5, r.position.y + 13.0 * grow, pillw, 22.0 * grow)
		draw_rect(pill, Color(kindcol.r, kindcol.g, kindcol.b, 0.20 * a))
		draw_rect(pill, Color(kindcol.r, kindcol.g, kindcol.b, 0.75 * a), false, 1.0)
		var pilltxt := ("TRICK CARD" if is_trick else "PATTERN CARD") if not showing_face \
			else ("NEW TRICK" if is_trick else "NEW PATTERN")
		draw_string(font, Vector2(pill.position.x, pill.position.y + 16.0 * grow),
			pilltxt, HORIZONTAL_ALIGNMENT_CENTER, pillw,
			ps(fit_size(font, pilltxt, pillw - 6.0, int(maxf(8.0, 12.0 * grow)), 7)),
			Color(kindcol.r, kindcol.g, kindcol.b, a))
	# THE FACE-DOWN CARD HAS TO SAY WHAT IT IS WORTH TURNING OVER FOR, or a player who
	# does not yet know the mechanic reads a blank card and a "press any key" and learns
	# nothing from the moment. One line, under the card, outside the frame so the flip
	# never squashes the lettering.
	if ucard_flip < 0.0:
		draw_string(font, Vector2(0.0, cy + ch * 0.5 + 26.0 * grow),
			"a skill you do not have yet  -  turn it over", HORIZONTAL_ALIGNMENT_CENTER, s.x,
			ps(int(maxf(9.0, 13.0 * grow))), Color(0.82, 0.76, 0.68, 0.9 * a))
	# ...and the prompt, which only appears once the card will actually listen. Pulsed,
	# because a card that waits forever has to say so or it reads as a freeze. It names
	# the two different things the two presses do.
	var armed := (ucard_flip < 0.0 and age >= UCARD_ARM) \
		or (ucard_flip >= 0.0 and turn >= 1.0 and atick() - ucard_flip >= UCARD_FLIP + UCARD_READ)
	if ucard_out_tick < 0.0 and armed:
		var pa := 0.55 + 0.45 * sin(atick() * 0.09)
		draw_string(font, Vector2(r.position.x, r.position.y + ch - 13.0 * grow),
			"press any key to turn it over" if ucard_flip < 0.0 else "press any key",
			HORIZONTAL_ALIGNMENT_CENTER, vw,
			ps(int(maxf(7.0, (10.0 if ucard_flip < 0.0 else 12.0) * grow))),
			Color(kindcol.r, kindcol.g, kindcol.b, pa * a))


func draw_trick_unlock_banner(font: Font, s: Vector2) -> void:
	# a small, non-intrusive toast: it names the skill and points to the SKILLS
	# screen for how to use it, instead of the old page-wide how-to card. The
	# loaded skill also appears in the trick HUD at the foot of the stage.
	var age := tick - trick_unlock_tick
	var a := 1.0
	if age < 16:
		a = float(age) / 16.0
	elif age > 300:
		a = clampf(float(360 - age) / 60.0, 0.0, 1.0)
	if a <= 0.0:
		return
	var t: Dictionary = TRICKS[trick_unlock]
	var bw := 336.0
	var bx := s.x * 0.5 - bw * 0.5
	var by := s.y * 0.17
	var glow := 0.5 + 0.5 * sin(float(tick) * 0.11)
	draw_rect(Rect2(bx, by, bw, 40.0), Color(0.10, 0.06, 0.08, 0.86 * a))
	draw_rect(Rect2(bx, by, bw, 40.0), Color(1.0, 0.82, 0.45, (0.34 + 0.28 * glow) * a), false, 1.5)
	draw_fit_string(font, Vector2(bx, by + 18.0), "NEW SKILL   %s" % String(t["name"]).to_upper(), HORIZONTAL_ALIGNMENT_CENTER, bw - 20.0, 16, Color(1.0, 0.88, 0.52, a))
	draw_string(font, Vector2(bx, by + 33.0), "how to use it lives in  SKILLS", HORIZONTAL_ALIGNMENT_CENTER, bw, ps(11), Color(0.82, 0.76, 0.66, 0.85 * a))


func draw_trick_hud(font: Font, s: Vector2) -> void:
	# the loaded one-shot: which trick Space is carrying, and whether it is primed.
	# READY burns gold so the player always knows the next throw is the trick shot.
	# Sits bottom-RIGHT, mirroring the venue/prop card bottom-left, so the two share
	# the foot of the stage evenly instead of the trick card floating mid-screen.
	var un := unlocked_tricks()
	var sel := trick_sel
	if tut_active and tut_id.begins_with("trick_"):
		sel = trick_by_id(tut_id.substr(6))   # a lesson shows ITS trick, gate or no gate
	elif sel < 0 or not trick_unlocked(sel):
		sel = int(un[0])
	if sel < 0:
		return
	var kind := String(TRICKS[sel]["kind"])
	var label := String(TRICKS[sel]["name"]).to_upper()
	var hot := false
	if kind == "arm" and trick_primed:
		label += "  -  READY"
		hot = true
	elif kind == "toggle" and toggle_on == sel:
		label += "  -  ON"
		hot = true
	elif toggle_on >= 0:
		# a toggle is RUNNING while the player has cycled the selection to a different
		# trick (ROADMAP 12c). Cycling never stops a toggle - only a second Space does -
		# but the old HUD dimmed this whole line and buried the still-ON toggle in a
		# small lowercase aside, so it read as "my trick switched off". Lead with the
		# running toggle, loud and gold, and demote the mere selection to the aside, so
		# "what is ON" always wins the eye over "what is loaded".
		label = "%s  -  ON   (%s next)" % [String(TRICKS[toggle_on]["name"]).to_upper(),
			String(TRICKS[sel]["name"])]
		hot = true
	var lc := Color(1.0, 0.86, 0.5) if hot else Color(0.72, 0.66, 0.78, 0.85)
	var pw := 330.0
	var px := s.x - 18.0 - pw    # mirror of the venue card's left margin
	var cx := px + pw * 0.5
	# The cards occupy the otherwise-unused strip above the frame.  Giving the
	# controls another 10px lets their text use the first comfortably readable
	# pixel-font rung rather than squeezing it into a 12px baseline.
	hud_panel(Rect2(px, s.y - 88.0, pw, 70.0), false, show_guide_step == 4)
	# no "TRICK -" prefix (the hints row already says trick, and the routine card
	# opposite carries no prefix either), and the title shrinks to FIT the card -
	# "BEHIND THE BACK - ON (High Toss next)" used to run off the right edge
	var fs := 16
	while fs > 11 and font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(fs)).x > pw - 24.0:
		fs -= 1
	draw_string(font, Vector2(px + 12.0, s.y - 62.0), label, HORIZONTAL_ALIGNMENT_CENTER, pw - 24.0, ps(fs), lc)
	var items: Array = []
	var use := ""
	match kind:
		"live":
			use = "spin"
			if spinning():
				use = "turning..."
		"toggle":
			use = "switch off" if toggle_on == sel else "switch on"
		_:
			use = "wave off" if trick_primed else "one throw"
	items.append([k_trick(), use])
	if un.size() > 1:
		items.append([k_cycle(), "switch trick"])
	draw_hints_row(font, cx, s.y - 38.0, items)


func draw_routine_hud(font: Font, s: Vector2) -> void:
	# bottom-LEFT mirror of the trick readout: the OBJECT and PATTERN in play, and
	# under them a LIVE count of where every prop is - left hand, in the air, right
	# hand - updating throw by throw (Louis: that beats a row of key hints here; the
	# O and P keys still work, and the lessons and Skills screen teach them).
	var pw := 330.0
	var px := 18.0
	var cx := px + pw * 0.5
	hud_panel(Rect2(px, s.y - 88.0, pw, 70.0))
	var oname := String(cur_prop()["name"]).to_upper()
	var pname := String(PATTERNS[pattern]["name"]).to_upper()
	var ocol := ball_color(0) if prop_type == PROP_BALLS else prop_color(prop_type)
	# object name in its own colour, pattern name warm, centred together as the title
	# the two names are one centred title, so it SHRINKS to fit the card rather than
	# running out past both edges on the longest pairing (TORCHES + REVERSE CASCADE)
	var tsz := fit_size(font, oname + "    " + pname, pw - 24.0, 16, 11)
	var otext := oname + "    "
	var ow := font.get_string_size(otext, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(tsz)).x
	var jw := ow + font.get_string_size(pname, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(tsz)).x
	var jx := cx - jw * 0.5
	draw_string(font, Vector2(jx, s.y - 62.0), oname, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(tsz), ocol)
	draw_string(font, Vector2(jx + ow, s.y - 62.0), pname, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(tsz), Color(0.86, 0.76, 0.62))
	var colw := pw / 3.0
	var cy := s.y - 26.0
	var hand_c := Color(0.92, 0.84, 0.7)
	draw_string(font, Vector2(px, cy), "left hand  %d" % _stack_l.size(), HORIZONTAL_ALIGNMENT_CENTER, colw, ps(16), hand_c)
	draw_string(font, Vector2(px + colw, cy), "in the air  %d" % balls_airborne(), HORIZONTAL_ALIGNMENT_CENTER, colw, ps(16), Color(0.7, 0.85, 1.0))
	draw_string(font, Vector2(px + colw * 2.0, cy), "right hand  %d" % _stack_r.size(), HORIZONTAL_ALIGNMENT_CENTER, colw, ps(16), hand_c)


#endregion

#region CHARACTER SHEET SCREEN


func draw_sheet_screen(font: Font, s: Vector2) -> void:
	# the ONE call site every screen uses to open "the sheet" (Tab). It was the switch
	# between the classic four cards and the growth columns while both existed; the
	# columns won and the classic version is gone, so this is now just the seam - keep
	# opening the sheet through it, and a future second picture costs one line here
	# rather than a hunt through every screen that can open it.
	draw_talent_tree(font, s)


func stat_cap(which: String) -> int:
	match which:
		"str": return STR_CAP
		"end": return END_CAP
		"spd": return SPEED_CAP
		_: return ACC_CAP


func stat_milestones(which: String) -> Array[Dictionary]:
	# THE one list of what a stat's points actually BUY. Every reader of it - the growth
	# columns' pips, the "next point buys" line - uses this and nothing else, so no two
	# places on screen can disagree about what a point is worth.
	#
	# Every entry is a threshold the GAME ITSELF gates on, read out of the real tables
	# (PATTERNS/TRICKS' own acc/str fields, PROP_STR_UNIT) or computed from the real
	# real formula - never a decorative number. Louis, 2026-07-27: Speed had a line
	# saying what its points do and the others did not, so nobody could tell what
	# Accuracy or Strength were for.
	var cap := stat_cap(which)
	var by_val: Dictionary = {}
	# WHICH VALUES NAME A SKILL, tracked as it is built (2026-07-30). `stat_pips` thins this
	# list for display and a skill must never be the entry it drops: "Half Shower" is why a
	# player is looking at the Accuracy track at all, where "+3 catch frames" is one rung of a
	# ladder that has five of them.
	var skill_at: Dictionary = {}
	var add := func(v: int, s: String, is_skill := false) -> void:
		if v <= 0 or v > cap:
			return
		by_val[v] = String(by_val.get(v, "")) + (", " if by_val.has(v) else "") + s
		if is_skill:
			skill_at[v] = true
	# the skills each stat gates, straight from their own tables. EVERY stat is asked
	# now, not just acc/str: the tricks carry Speed and Endurance walls since 2026-07-27
	# and a wall nobody can see is a wall nobody plans around.
	for p in PATTERNS:
		if p.has(which):
			add.call(int(p[which]), String(p["name"]), true)
	for t in TRICKS:
		if t.has(which):
			add.call(int(t[which]), String(t["name"]), true)
	match which:
		"acc":
			# THE TWO FOCUS STAGES, and they no longer overlap: 101-150 is the stamina
			# discount, 151-200 is the timing, five frames one at a time.
			add.call(100, "Focus: less stamina")
			add.call(150, "cheapest throws")
			for f in range(1, FOCUS_WINDOW_MAX + 1):
				add.call(150 + f * int(FOCUS_WINDOW_PER), "+%d catch frame%s" % [f, "" if f == 1 else "s"])
		"str":
			# WHAT RAW MUSCLE OPENS, straight off the one rule (PROP_STR_UNIT x count) rather
			# than the old BALL_GATES table. Only the prop IN HAND is listed, because the
			# answer is different for every prop now - fifteen balls is 15 points and fifteen
			# chainsaws is 195, and a single ladder cannot say both. The shop cards carry each
			# prop's own arithmetic at the point of choice.
			var unit := prop_str_unit()
			for n in range(MIN_BALLS, MAX_BALLS_HARD + 1):
				add.call(unit * n, "%d %s" % [n, prop_plural()])
			# ...AND WHAT A HEAVIER PROP WOULD ASK, which is what puts anything at all in the top
			# of this track (2026-07-30). The count ladder for the prop IN HAND covers the bottom
			# of it and nothing else - a full fifteen clubs is Strength 60 of 200, fifteen balls
			# is 15 - so however the pips were thinned, Strength stayed a cluster at the foot with
			# one mark at the ceiling. That is not a display problem, it is missing content: the
			# reason to push Strength past a full set of what you hold is to hold something
			# HEAVIER, and it is the same rule (PROP_STR_UNIT x count) either way, so the numbers
			# are as real as the ones below them. With clubs in hand this adds 15 knives at 90,
			# 15 torches at 120 and 15 chainsaws at 195, and the track finally reads end to end.
			# Only heavier props, and only their FULL set: one row per prop, never a second
			# thirteen-rung ladder.
			for pk in PROPS.size():
				if prop_str_unit(pk) > unit:
					add.call(prop_str_unit(pk) * MAX_BALLS_HARD,
						"%d %s" % [MAX_BALLS_HARD, prop_plural(pk)])
			add.call(STR_CAP - STR_FRAME_LAST, "+1 catch frame")
		"end":
			# no named skill: labelled with the stamina pool it reaches, which IS the effect
			for frac in [0.25, 0.5, 0.75, 1.0]:
				var ev := int(round(float(cap) * frac))
				add.call(ev, "%d stamina" % int(round(100.0 + 9.0 * float(ev))))
		"spd":
			# every whole percent of slow motion is its own step: SPEED_PER_PCT points buys
			# one, and it accrues CONTINUOUSLY (see slow_target) - a point is never wasted
			# waiting for a milestone, the pips just mark where the number ticks over
			for pct in [2, 5, 10, 15, 20]:
				add.call(pct * SPEED_PER_PCT, "%d%% slow" % pct)
	var out: Array[Dictionary] = []
	var vals := by_val.keys()
	vals.sort()
	for v in vals:
		out.append({"val": int(v), "label": String(by_val[v]), "skill": skill_at.has(int(v))})
	# THE SYNTHETIC "MAX" ONLY EARNS A ROW IF IT IS CLEAR OF THE LAST REAL ONE. Strength's top
	# milestone is the catch frame at STR_CAP - STR_FRAME_LAST, which is 195 against a cap of
	# 200: two rows five points apart, drawn as two pips five PIXELS apart at the top of the
	# track. "MAX" says nothing the track's own ceiling does not already say, so where it would
	# crowd a real milestone it simply is not added.
	if out.is_empty() or float(cap) - float(out[out.size() - 1]["val"]) >= float(cap) * STAT_PIP_GAP:
		out.append({"val": cap, "label": "MAX", "skill": false})
	return out


const STAT_PIP_GAP := 0.075   # the closest two PIPS may sit, as a fraction of the stat's cap.
							  # 15 points of 200 is 16px on the growth column's track, and a
							  # label needs 15 of those - so this is really the label's spacing
							  # floor promoted to where the pips are chosen, rather than left
							  # to the drawing to paper over after the fact.

func stat_pips(which: String) -> Array[Dictionary]:
	# THE MILESTONES A COLUMN DRAWS, which is deliberately not all of them (2026-07-30, Louis:
	# the stat milestones "look ugly and cramped ... the rest you should choose what to show or
	# not"). Strength offers one threshold per count from 3 to 15 of the prop in hand, and with
	# clubs that is thirteen pips inside the bottom 30% of the track: measured, a solid smear of
	# white dots with four labels next to it, because the DRAWING already had a 15px spacing
	# floor for labels and none at all for the pips it drew them beside. That mismatch is the
	# whole bug - the screen was quietly admitting the list was too dense for the space and then
	# drawing it anyway.
	#
	# What survives, in order of priority:
	#   - anything that names a SKILL. That is what a player is climbing toward.
	#   - the TOP milestone, so the ceiling always has a mark. If it lands within the gap of a
	#     kept non-skill row, it takes that row's place rather than crowding it.
	#   - a full set of the prop in hand (Strength's most aspirational number).
	#   - whatever else clears STAT_PIP_GAP from the last row kept.
	#
	# THIS LIST MUST NEVER ANSWER "WHAT DOES MY NEXT POINT BUY", and that is the reason it is a
	# second function rather than a filter inside stat_milestones. Thin the list the "next: X at
	# N (+M)" line reads and the screen starts lying about the game: with clubs at Strength 20
	# the true next threshold is 24 for a sixth club, and a thinned list would report 28 for a
	# seventh. The pips are a summary; that line is a fact.
	var full := stat_milestones(which)
	if full.size() <= 2:
		return full
	var cap := stat_cap(which)
	var min_gap := maxf(float(cap) * STAT_PIP_GAP, 1.0)
	var top_val := int(full[full.size() - 1]["val"])
	# the prop in hand fielded in full - Strength only, since it is the one stat whose rows are
	# counts rather than effects
	var keep_val := -1
	if which == "str":
		keep_val = prop_str_unit() * MAX_BALLS_HARD
	var out: Array[Dictionary] = []
	var last := -1.0e9
	for nd: Dictionary in full:
		var v := int(nd["val"])
		var must := bool(nd.get("skill", false)) or v == top_val or v == keep_val
		if not must and float(v) - last < min_gap:
			continue
		# a forced row that would crowd the previous one REPLACES it, unless that previous row
		# is a skill - a named skill outranks a count and outranks the word MAX
		if must and out.size() > 0 and float(v) - last < min_gap \
				and not bool(out[out.size() - 1].get("skill", false)):
			out[out.size() - 1] = nd
			last = float(v)
			continue
		out.append(nd)
		last = float(v)
	return out


func talent_nodes(which: String) -> Array[Dictionary]:
	return stat_milestones(which)   # the tree and the sheet read the same list


func draw_talent_tree(font: Font, s: Vector2) -> void:
	# THE STAT SCREEN (shipped 2026-07-27; it replaced a set of four flat cards): four
	# GROWTH COLUMNS that fill upward as you invest, each milestone pip a REAL PATTERNS/
	# TRICKS threshold. Same sheet_sel / invest() / caps as the classic sheet - only the
	# picture differs, so the two can never disagree on what a point is worth.
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.03, 0.02, 0.035, 0.9))
	var pw := minf(1080.0, s.x - 48.0)
	var ph := minf(662.0, s.y - 26.0)
	var px := s.x * 0.5 - pw * 0.5
	var py := s.y * 0.5 - ph * 0.5
	soft_card(Rect2(px, py, pw, ph), Color(0.09, 0.07, 0.115, 0.99), Color(0.55, 0.72, 0.95, 0.5), 2.0, 18.0, 26.0)
	var tx := px + 40.0
	var innerw := pw - 80.0

	# ---- header: title, purse, level + xp, and the points banner ----
	draw_string(title_font(), Vector2(tx, py + 50.0), "JUGGLER", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(30), Color(1.0, 0.86, 0.55))
	draw_string(font, Vector2(tx + 156.0, py + 48.0), "TALENT TREE", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13), Color(0.6, 0.82, 1.0))
	draw_purse(font, px + pw - 40.0, py + 50.0)
	draw_string(font, Vector2(px, py + 70.0), "Rep %s   %s" % [commafy(reputation), rep_tier()], HORIZONTAL_ALIGNMENT_RIGHT, pw - 40.0, ps(12), Color(0.82, 0.72, 0.85))
	var need := xp_to_next(level)
	var xf := clampf(float(xp) / float(maxi(1, need)), 0.0, 1.0)
	draw_string(font, Vector2(tx, py + 93.0), "LEVEL %d" % level, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(18), Color(1.0, 0.9, 0.6))
	var xbx := tx + 118.0
	var xbw := innerw - 118.0
	draw_meter(xbx, py + 81.0, xbw, 15.0, xf, Color(0.92, 0.72, 0.36))
	draw_text_shout(font, Vector2(xbx, py + 92.0), "%s / %s xp" % [commafy(xp), commafy(need)], HORIZONTAL_ALIGNMENT_CENTER, xbw, 11, Color(1.0, 0.96, 0.85))
	var by0 := py + 110.0
	# MASTERY OUTRANKS THE POINTS BANNER, because a capped juggler can be holding points
	# and there is nothing left to put them in: capping the last stat with a couple in
	# hand leaves them banked until the next level-up converts the lot. Asking that
	# player to "press a column's number" is an instruction that does nothing.
	if all_stats_capped():
		var mt := "MASTERY  -  every stat at its ceiling. New levels now pay %s." % coin_word()
		if points > 0:
			mt = "MASTERY  -  every stat at its ceiling. Your %d point%s turn%s to %s at the next level." % [
				points, "" if points == 1 else "s", "s" if points == 1 else "", coin_word()]
		draw_fit_string(font, Vector2(tx, by0 + 22.0), mt, HORIZONTAL_ALIGNMENT_CENTER, innerw, 13, Color(1.0, 0.88, 0.55))
	elif points > 0:
		var pa := 0.72 + 0.28 * sin(float(Time.get_ticks_msec()) * 0.006)
		soft_card(Rect2(tx, by0, innerw, 32.0), Color(0.22, 0.17, 0.06, 0.45 + 0.2 * pa), Color(1.0, 0.86, 0.45, 0.75), 1.5, 9.0, 6.0)
		# NO "PRESS A COLUMN'S NUMBER" ANY MORE (2026-07-31, Louis: the 1-4 shortcuts are
		# gone from input, "but the windows that shows to use them aren't gone yet" - this
		# banner was one of them, still promising a press that does nothing).
		draw_string(font, Vector2(tx, by0 + 22.0), "%d POINT%s TO SPEND  -  Left / Right, then Enter" % [points, "" if points == 1 else "S"], HORIZONTAL_ALIGNMENT_CENTER, innerw, ps(15), Color(1.0, 0.92, 0.7))
	else:
		draw_string(font, Vector2(tx, by0 + 22.0), "Skill sets your score; stats ease the climb. The next point comes with the next level.", HORIZONTAL_ALIGNMENT_CENTER, innerw, ps(13), Color(0.75, 0.7, 0.62))

	# ---- four growth columns ----
	var branches := [
		{"id": "acc", "name": "ACCURACY",  "val": accuracy,  "cap": ACC_CAP,   "col": Color(0.55, 0.78, 1.0),  "role": "off-Perfect catches"},
		{"id": "str", "name": "STRENGTH",  "val": strength,  "cap": STR_CAP,   "col": Color(0.97, 0.55, 0.42), "role": "prop weight & loft"},
		{"id": "end", "name": "ENDURANCE", "val": endurance, "cap": END_CAP,   "col": Color(0.55, 0.85, 0.62), "role": "stamina pool"},
		{"id": "spd", "name": "SPEED",     "val": speed,     "cap": SPEED_CAP, "col": Color(0.82, 0.70, 0.97), "role": "slow-motion"},
	]
	var gap := 16.0
	var colw := (innerw - gap * 3.0) / 4.0
	var coly := by0 + 46.0
	var colh := py + ph - 92.0 - coly
	for bi in branches.size():
		var b: Dictionary = branches[bi]
		var active := bi == sheet_sel
		var bcol: Color = b["col"]
		var val := int(b["val"])
		var cap := int(b["cap"])
		var cx := tx + float(bi) * (colw + gap)
		var frac := clampf(float(val) / float(maxi(1, cap)), 0.0, 1.0)
		# the column card: tinted and brighter-bordered when it is the active branch
		var cardfill := Color(bcol.r * 0.14, bcol.g * 0.14, bcol.b * 0.16, 0.92) if active else Color(0.11, 0.09, 0.12, 0.85)
		soft_card(Rect2(cx, coly, colw, colh), cardfill, Color(bcol.r, bcol.g, bcol.b, 0.9 if active else 0.28), 2.0 if active else 1.0, 13.0, 14.0)
		# name, role, current value
		draw_string(title_font(), Vector2(cx, coly + 32.0), String(b["name"]), HORIZONTAL_ALIGNMENT_CENTER, colw, ps(17), bcol if active else Color(bcol.r, bcol.g, bcol.b, 0.82))
		draw_string(font, Vector2(cx, coly + 50.0), String(b["role"]), HORIZONTAL_ALIGNMENT_CENTER, colw, ps(11), Color(0.72, 0.68, 0.62))
		draw_string(title_font(), Vector2(cx, coly + 98.0), str(val), HORIZONTAL_ALIGNMENT_CENTER, colw, ps(42), Color(1.0, 0.95, 0.82))
		# the vertical GROWTH track: fills from the bottom up to val/cap, milestone pips
		# at the real thresholds, the next one pulsing while a point is unspent
		var trk_w := 15.0
		# the track sits LEFT of centre, not on it (2026-07-27, Louis: "make sure their
		# descriptions are readable also and not cut off"). Centred, every pip label had
		# less than half the column to live in and the useful half of each one was
		# ellipsed away - "Focus: cheaper stam...". At 32% across, the labels get roughly
		# 60% of the width and the whole ladder reads.
		var trk_x := cx + colw * 0.32 - trk_w * 0.5
		var trk_top := coly + 122.0
		var trk_bot := coly + colh - 76.0
		var trk_h := maxf(20.0, trk_bot - trk_top)
		var trbg := StyleBoxFlat.new()
		trbg.bg_color = Color(0.15, 0.11, 0.10, 0.92)
		trbg.set_corner_radius_all(int(trk_w * 0.5))
		trbg.border_color = Color(0.0, 0.0, 0.0, 0.5)
		trbg.set_border_width_all(1)
		trbg.anti_aliasing = true
		draw_style_box(trbg, Rect2(trk_x, trk_top, trk_w, trk_h))
		var fh := trk_h * frac
		if fh > 2.0:
			var trf := StyleBoxFlat.new()
			trf.bg_color = bcol
			trf.set_corner_radius_all(int(trk_w * 0.5))
			trf.anti_aliasing = true
			draw_style_box(trf, Rect2(trk_x, trk_bot - fh, trk_w, fh))
		# TWO LISTS, AND THEY ARE NOT THE SAME LIST (2026-07-30 - see stat_pips). `nodes` is the
		# complete truth and drives the "next: X at N (+M)" line under the track, because that
		# line is a fact about the game. `pips` is the thinned ladder that gets drawn, because
		# thirteen count thresholds do not fit in 215px however honest they are.
		var nodes := talent_nodes(String(b["id"]))
		var pips := stat_pips(String(b["id"]))
		var next_i := -1
		for ni in nodes.size():
			if int(nodes[ni]["val"]) > val:
				next_i = ni
				break
		# ...and the pip that PULSES is the next unreached one on the drawn ladder, which is not
		# always the same threshold. It is not labelled "next" - it just shows which way the
		# track is heading - and the exact figure sits immediately under it either way.
		var next_pip := -1
		for ni in pips.size():
			if int(pips[ni]["val"]) > val:
				next_pip = ni
				break
		var last_label_y := 1.0e9   # pips are labelled top-down with a spacing floor
		for ni in pips.size():
			var nd: Dictionary = pips[ni]
			var nf := clampf(float(nd["val"]) / float(maxi(1, cap)), 0.0, 1.0)
			var ppos := Vector2(trk_x + trk_w * 0.5, trk_bot - trk_h * nf)
			var reached: bool = val >= int(nd["val"])
			var isnext := ni == next_pip
			if reached:
				draw_circle(ppos, 5.0, Color(1.0, 1.0, 0.96, 0.95))
			else:
				icon_disc(ppos, 4.5, Color(0.09, 0.08, 0.10, 1.0),
					Color(bcol.r, bcol.g, bcol.b, 0.95 if isnext else 0.45), 2.0)
				if isnext and active and points > 0:
					var pp := 0.5 + 0.5 * sin(float(tick) * 0.15)
					draw_arc(ppos, 7.0 + 3.0 * pp, 0.0, TAU, 18, Color(bcol.r, bcol.g, bcol.b, 0.55 * (1.0 - pp)), 2.0, true)
			# EVERY pip carries its label now (2026-07-27, Louis: Accuracy and Strength
			# needed "the milestones like speed... that way the player knows what their
			# points are doing"). They used to be bare on acc/str because their old
			# labels were skill names at thresholds too close together to print; now
			# stat_milestones gives them real EFFECTS too (the Focus stages, the props
			# and counts Strength opens), and a spacing floor keeps a crowded column -
			# Strength carries twelve ball gates - from printing through itself. The
			# list is walked from the FOOT of the track upward, so the nearest
			# thresholds always win the space and only distant ones are ever dropped.
			if String(nd["label"]) != "" and last_label_y - ppos.y >= 15.0:
				last_label_y = ppos.y
				var plc := Color(0.9, 0.87, 0.78) if reached else (Color(bcol.r, bcol.g, bcol.b, 0.95) if isnext else Color(0.64, 0.61, 0.56, 0.85))
				# the width is measured to the CARD's inner edge, not half the column:
				# the track sits centred, so a label starting at its right side has
				# only (colw/2 - the track's own half-width - padding) to live in
				draw_fit_string(font, Vector2(trk_x + trk_w + 7.0, ppos.y + 4.0), String(nd["label"]), HORIZONTAL_ALIGNMENT_LEFT, cx + colw - 8.0 - (trk_x + trk_w + 7.0), 10, plc)
		# what the NEXT point in this column works toward - a named skill for acc/str, the
		# effect it reaches for end/spd (their pips are effect-labelled above). Uniform now.
		var nl1 := ""
		var nl2 := ""
		if next_i >= 0:
			nl1 = "next: %s" % (String(nodes[next_i]["label"]) if String(nodes[next_i]["label"]) != "" else "the cap")
			nl2 = "at %d  (+%d)" % [int(nodes[next_i]["val"]), int(nodes[next_i]["val"]) - val]
		else:
			nl1 = "at the cap"
		draw_string(font, Vector2(cx + 6.0, trk_bot + 16.0), nl1, HORIZONTAL_ALIGNMENT_CENTER, colw - 12.0, ps(11), Color(0.86, 0.82, 0.74))
		if nl2 != "":
			draw_string(font, Vector2(cx + 6.0, trk_bot + 31.0), nl2, HORIZONTAL_ALIGNMENT_CENTER, colw - 12.0, ps(11), Color(0.66, 0.62, 0.58))
		# the invest plate at the foot of the column
		var can := points > 0 and val < cap
		var pl := Rect2(cx + colw * 0.5 - 48.0, coly + colh - 40.0, 96.0, 30.0)
		soft_card(pl, Color(0.15, 0.22, 0.12, 0.92) if can else Color(0.11, 0.08, 0.09, 0.7), Color(0.55, 0.85, 0.5, 0.6) if can else Color(0.5, 0.45, 0.42, 0.3), 1.0, 7.0, 5.0)
		# THE PLATE NAMES ENTER, NOT A NUMBER, AND ONLY ON THE ACTIVE COLUMN (2026-07-31,
		# Louis: the 1-4 shortcuts are gone, "increase only by selecting with arrows and
		# pressing enter"). A keycap on every column used to promise each could be invested
		# in directly by its own number; only the SELECTED column can take a press now, so
		# only it gets a keycap - the same affordance a focused control shows anywhere else.
		if active and can:
			draw_keycap(font, pl.position.x + 9.0, pl.position.y + 6.0, String(k_finish()[0]))
		draw_string(font, Vector2(pl.position.x, pl.position.y + 20.0), ("+1" if can else ("MAX" if val >= cap else "-")), HORIZONTAL_ALIGNMENT_RIGHT, pl.size.x - 12.0, ps(15), Color(0.8, 0.96, 0.74) if can else Color(0.62, 0.57, 0.52, 0.85))

	# ---- the active branch's effect, spelled out, and the footer keys ----
	var eff := ""
	match String(branches[sheet_sel]["id"]):
		"acc": eff = "ACCURACY: off-Perfect catches hold more often. Past 100 it becomes Focus - a wider Perfect window and cheaper stamina."
		"str": eff = "STRENGTH: heavier props fly cleaner and sit steadier in the hand, and higher object counts open up."
		"end": eff = "ENDURANCE: raises your maximum stamina, the fuel every throw and catch spends."
		"spd": eff = "SPEED: bends the whole act toward slow motion, so every catch window stretches (capped at 25%)."
	var dy := py + ph - 62.0
	draw_string(font, Vector2(tx, dy), eff, HORIZONTAL_ALIGNMENT_CENTER, innerw, ps(12), Color(0.82, 0.79, 0.72))
	if debug_mode:
		# the legend has to NAME the hold, or the fast path is a secret. And it says
		# coin_word(), never a literal "gold": the purse beside it reads "flowers", and
		# this file's own rule is that a typed currency name is a bug waiting for the
		# switch to be flipped. Through draw_fit_string because it is now long enough to
		# reach the panel edge, and draw_string CLIPS rather than shortens.
		draw_fit_string(font, Vector2(tx, dy + 16.0),
			"DEBUG  1/2/3/4 up  Q/W/E/R dn  M/N %s (hold: x%s)  ,/. rep" % [coin_word(), commafy(MONEY_HOLD_STEP)],
			HORIZONTAL_ALIGNMENT_CENTER, innerw, 12, Color(0.6, 0.9, 1.0))
	var th_items: Array = [[["Stick"] if pad_active() else ["Left", "Right"], "branch"]]
	if points > 0:
		th_items.append([k_finish(), "invest"])
	th_items.append([k_sheet(), "resume"])
	draw_hints_row(font, px + pw * 0.5, py + ph - 34.0, th_items)

func draw_purse(font: Font, right_x: float, y: float) -> void:
	# the gold readout every spending screen shares: a coin, the number, and a flash
	# whenever gold just changed hands (paired with the "money" jingle)
	var fl := clampf(1.0 - float(int(Time.get_ticks_msec()) - shop_buy_ms) / 450.0, 0.0, 1.0)
	var fs := 24 + int(round(6.0 * fl))
	var gc := Color(1.0, 0.86, 0.45).lerp(Color(1.0, 0.98, 0.85), fl)
	# THE MARK IS THE UNIT (2026-07-27, Louis: "the currency in shop should not be f but
	# the flower icon"). The drawn coin/flower already sits beside this number, so the
	# trailing letter was naming the currency a second time - "50,582 f" next to a
	# flower. The icon says it better than an abbreviation can, and it stays correct
	# when the economy switches.
	var txt := commafy(money)
	var tw := font.get_string_size(txt, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(fs)).x
	# amount THEN mark, same order as the price plates below it - a shop that asked
	# "20 flowers" while the purse answered "flowers 50,582" read as two currencies.
	# The mark grows a touch with the flash too, so money changing hands is felt on the
	# object and not only on the number beside it.
	var mr := 10.0 + 1.5 * fl
	draw_string(font, Vector2(right_x - tw - mr * 2.0 - 8.0, y), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(fs), gc)
	draw_coin_mark(Vector2(right_x - mr, y - 8.0), mr, Color(1.0, 0.84, 0.4), true)


func draw_price_plate(font: Font, r: Rect2, keylabel: String, price: String, afford: bool,
		free_word: String = "") -> void:
	# the buy strip at the foot of a shop card: the KEY on the left is the button, the
	# price on the right is the ask. Green means it can happen, dim red means not yet.
	#
	# `free_word` is for the cards that are not a purchase at all - the doors between the
	# two rooms, once the fee is paid. "0" beside a flower mark is not free, it is a price
	# of nothing, and a player reads it as a bug.
	var bg := Color(0.16, 0.22, 0.13, 0.9) if afford else Color(0.16, 0.09, 0.09, 0.85)
	var line := Color(0.55, 0.85, 0.5, 0.55) if afford else Color(0.7, 0.35, 0.3, 0.4)
	var cc := Color(0.78, 0.96, 0.72) if afford else Color(0.85, 0.5, 0.45)
	draw_rect(r, bg)
	draw_rect(r, line, false, 1.0)
	# THE PLATE KNOWS HOW MUCH ROOM IS LEFT, and it did not before (2026-07-28). Both the
	# key and the price were placed from their own edge - the key from the left, the price
	# from the right - with nothing measuring the gap between them, and it worked only
	# because the plate had always been wide. The eighth gear card took a card to 121px,
	# and "12,000" at 16pt drew straight through the keycap beside it: the shop showed
	# "7|12,000" as one run of digits, which is a price nobody can read. `kw` is measured
	# and everything to the right of it fits in what is left.
	var kw := draw_keycap(font, r.position.x + 8.0, r.position.y + r.size.y * 0.5 - 9.5, keylabel)
	var room := r.size.x - kw - 26.0
	# the price is a NUMBER FOLLOWED BY the currency's own MARK, never a letter - "20
	# flowers", the way an amount is actually said (2026-07-27, Louis: the flower comes
	# after the price). Right-aligned as a unit: the mark's outer edge sits on the
	# margin and the digits are measured back from it, because `price` is data and can
	# run to "60,000".
	var baseline := r.position.y + r.size.y * 0.5 + 6.0
	if free_word != "":
		draw_fit_string(font, Vector2(r.position.x + kw + 14.0, baseline), free_word,
			HORIZONTAL_ALIGNMENT_RIGHT, room, fit_size(font, free_word, room, 15, 9), cc)
		return
	# A NUMBER SHRINKS, IT NEVER TRIMS - this file's own rule, and a price is the purest
	# case of it: "12,0..." is not a price. fit_size hands back the largest size the digits
	# fit at, floored low enough that even the 121px card keeps them whole.
	var mr := 7.0
	var psz := fit_size(font, price, room - mr * 2.0 - 5.0, 16, 9)
	var mx := r.position.x + r.size.x - 12.0 - mr
	var pw := font.get_string_size(price, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(psz)).x
	draw_string(font, Vector2(mx - mr - 5.0 - pw, baseline), price, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(psz), cc)
	draw_coin_mark(Vector2(mx, baseline - 5.5), mr, cc, true)


func draw_gear_icon(id: String, c: Vector2, cc: Color, _sel: bool = false) -> void:
	# every piece of gear, drawn as the OBJECT it is rather than as a glyph: the pie
	# especially, which was a bare triangle and read as a torch flame next to the torch
	# card. Everything is built from the same filled-shape language the rest of the game's
	# art uses - no thin decorative strokes standing in for a thing (the lesson the
	# performer wardrobe pass paid for).
	#
	# KEYED BY ID, not by row number (2026-07-28). It used to match on 0..3, which is the
	# same fragility the shop's buy keys had: the moment the gear list grew past four and
	# split across two rooms, an index meant a different object in each room.
	#
	# SEAM: keyed by the same `id`, for the same reason - "ui/gear_pie" cannot drift onto
	# the wrong row the way "the third icon" can.
	if art_blit_size("ui/gear_" + id, c, Vector2(40.0, 40.0), 0.0, cc):
		return
	match id:
		"glasses":   # GLASSES: two glazed lenses in a real frame, with temples going back
			for sgn in [-1.0, 1.0]:
				var lc := c + Vector2(sgn * 15.0, 0.0)
				icon_disc(lc, 13.0, Color(cc.r, cc.g, cc.b, 0.20), cc, 2.0)
				draw_line(lc + Vector2(-6.0, 4.0), lc + Vector2(-1.0, -3.0), Color(1.0, 1.0, 1.0, 0.22), 2.2)
				draw_line(lc + Vector2(sgn * 13.0, -2.0), lc + Vector2(sgn * 21.0, -8.0), cc, 2.4)
			draw_line(c + Vector2(-3.0, -2.0), c + Vector2(3.0, -2.0), cc, 3.0)
		"pie":   # UNCLE DAN'S PIE: a real slice - golden crust along the wide edge, a
			# baked filling inside, and two curls of steam coming off it
			var apex := c + Vector2(0.0, 24.0)
			var fill := PackedVector2Array([apex])
			var top := PackedVector2Array([apex])
			for k in 15:
				var a := lerpf(-2.44, -0.70, float(k) / 14.0)
				fill.append(apex + Vector2(cos(a), sin(a)) * 40.0)
			for k in 15:
				var a2 := lerpf(-2.44, -0.70, float(k) / 14.0)
				top.append(apex + Vector2(cos(a2), sin(a2)) * 33.0)
			draw_colored_polygon(fill, Color(0.76, 0.48, 0.20))     # the crust edge
			draw_colored_polygon(top, Color(0.93, 0.68, 0.28))      # the baked top
			for k in 3:
				var a3 := lerpf(-2.05, -1.09, float(k) / 2.0)
				draw_circle(apex + Vector2(cos(a3), sin(a3)) * 22.0, 2.0, Color(0.70, 0.40, 0.16))
			for sgn2 in [-1.0, 1.0]:
				var sx: float = c.x + sgn2 * 12.0
				for k in 4:
					var t := float(k) / 3.0
					draw_circle(Vector2(sx + sin(t * 4.0 + atick() * 0.03) * 3.0, c.y - 26.0 - t * 11.0),
						2.4 - t * 1.2, Color(1.0, 0.95, 0.88, 0.20 - t * 0.14))
		"glow_kit", "glow_tape", "glow_suit":   # GLOW KIT: the card IS the preview, so it shows what the Kit actually buys -
			# a whole charged SET, mid-weave, in the dark. One glowing ball said "a
			# ball, but green"; three different props lit at once says "your pattern
			# stays readable", which is the thing being sold.
			# THE THREE GLOW CARDS MUST NOT LOOK THE SAME. They sell different things -
			# the props, the costume, or both - and three identical previews on one row
			# is a shop that cannot be read. Tape shows a charged SET, the suit shows the
			# performer, and the Kit shows the set with him standing in it.
			var gfl := 0.86 + 0.14 * sin(atick() * 0.06)
			if id != "glow_tape":
				# THE SUIT, NOT A STICK MAN (redrawn 2026-07-28, Louis: the glow-in-the-dark
				# suit looked strange). It was a head, a box and four LINES - which is a
				# figure, but the thing being sold is a COSTUME, and a costume has to have
				# tailoring in it or the card is indistinguishable from any other little
				# green man. It is the wardrobe's own garment now, in phosphor: sloped
				# shoulders, a jacket that draws in at the waist, a lighter waistcoat down
				# the front, the trouser seams that are the actual signature of the lit
				# costume on stage, and the bloom underneath that makes it read as EMITTING
				# rather than as a man painted green.
				var fc := c + Vector2(-28.0 if id == "glow_kit" else 0.0, 6.0)
				draw_glow(fc, 34.0, Color(GLOW_PHOS.r, GLOW_PHOS.g, GLOW_PHOS.b, 0.34 * gfl))
				var gp3 := Color(GLOW_PHOS.r * 0.62, GLOW_PHOS.g * 0.78, GLOW_PHOS.b * 0.66, 0.95 * gfl)
				var gp_hi := Color(0.86, 1.0, 0.90, 0.95 * gfl)
				draw_colored_polygon(PackedVector2Array([                            # the trousers
					Vector2(fc.x - 6.5, fc.y + 2.0), Vector2(fc.x + 6.5, fc.y + 2.0),
					Vector2(fc.x + 5.5, fc.y + 20.0), Vector2(fc.x + 1.5, fc.y + 20.0),
					Vector2(fc.x, fc.y + 9.0), Vector2(fc.x - 1.5, fc.y + 20.0),
					Vector2(fc.x - 5.5, fc.y + 20.0)]), gp3)
				for sgn5: float in [-1.0, 1.0]:                                      # the outseams
					draw_line(fc + Vector2(sgn5 * 5.4, 3.0), fc + Vector2(sgn5 * 4.4, 19.0), gp_hi, 1.4)
				draw_colored_polygon(PackedVector2Array([                            # the jacket
					Vector2(fc.x - 9.5, fc.y - 12.0), Vector2(fc.x - 3.0, fc.y - 14.0),
					Vector2(fc.x + 3.0, fc.y - 14.0), Vector2(fc.x + 9.5, fc.y - 12.0),
					Vector2(fc.x + 7.0, fc.y - 3.0), Vector2(fc.x + 8.5, fc.y + 4.0),
					Vector2(fc.x - 8.5, fc.y + 4.0), Vector2(fc.x - 7.0, fc.y - 3.0)]), gp3)
				draw_colored_polygon(PackedVector2Array([                            # the waistcoat
					Vector2(fc.x - 3.0, fc.y - 12.0), Vector2(fc.x + 3.0, fc.y - 12.0),
					Vector2(fc.x + 2.6, fc.y + 3.0), Vector2(fc.x - 2.6, fc.y + 3.0)]), gp_hi)
				for sgn6: float in [-1.0, 1.0]:                                      # the sleeves
					draw_colored_polygon(PackedVector2Array([
						fc + Vector2(sgn6 * 8.0, -11.0), fc + Vector2(sgn6 * 15.0, -18.0),
						fc + Vector2(sgn6 * 17.0, -15.0), fc + Vector2(sgn6 * 9.5, -5.0)]), gp3)
				draw_circle(fc + Vector2(0.0, -18.5), 5.0, Color(0.90, 0.72, 0.56, 0.95))   # his own face
				if id == "glow_suit":
					return
			var lay := [
				[Vector2(-26.0, 12.0), PROP_BALLS, 1.5],
				[Vector2(2.0, -22.0), PROP_RINGS, 1.15],
				[Vector2(28.0, 8.0), PROP_CLUBS, 1.0],
			] if id == "glow_tape" else [
				[Vector2(14.0, -14.0), PROP_BALLS, 1.1],
				[Vector2(30.0, 6.0), PROP_CLUBS, 0.9],
			]
			for e in lay:
				var gp: Vector2 = c + (e[0] as Vector2)
				draw_glow(gp, 30.0 * float(e[2]), Color(GLOW_PHOS.r, GLOW_PHOS.g, GLOW_PHOS.b, 0.34 * gfl))
			for e2 in lay:
				var gp2: Vector2 = c + (e2[0] as Vector2)
				var gsc: float = float(e2[2])
				glow_silhouette(gp2, int(e2[1]), gsc, 0.5, Color(GLOW_PHOS.r, GLOW_PHOS.g, GLOW_PHOS.b, 0.9 * gfl))
				draw_circle(gp2, 3.2 * gsc, Color(1.0, 1.0, 1.0, 0.6 * gfl))
		"gloves":   # SILK GLOVES, fourth pass (2026-07-31, Louis: "the gloves still look
			# horrible ... in the tailor" too). The previous pass fixed the stage glove by
			# giving the thumb and the palm ONE outline instead of two glued-together
			# shapes (mitt_shape, see draw_hand) - this icon had its own separate hand-fit
			# version of the same idea and the same flaw. Drawing the actual mitt_shape()
			# here instead is also the standing rule stated two passes ago and then not
			# followed: "a shop icon that does not match the thing you buy is a small lie."
			var pad := c + Vector2(0.0, -2.0)
			draw_colored_polygon(mitt_shape(pad, 13.0, 13.0, -1.15, 0.62), cc)
			draw_line(pad + Vector2(-6.4, -6.8), pad + Vector2(-14.6, -16.4), Color(0.40, 0.36, 0.34, 0.42), 1.2)
			# the cuff: scalloped along its lower edge, which is the one detail that says
			# "dress glove" instead of "work glove"
			draw_colored_polygon(PackedVector2Array([
				pad + Vector2(-14.0, 11.0), pad + Vector2(14.0, 11.0), pad + Vector2(13.0, 17.0),
				pad + Vector2(6.5, 20.0), pad + Vector2(0.0, 17.0), pad + Vector2(-6.5, 20.0),
				pad + Vector2(-13.0, 17.0)]), Color(cc.r * 0.74, cc.g * 0.74, cc.b * 0.74))
			draw_line(pad + Vector2(-13.5, 11.5), pad + Vector2(13.5, 11.5), Color(1, 1, 1, 0.22), 1.4)
		"boots":   # STAGE BOOTS (redrawn 2026-07-28). It is the SAME boot draw_stage_boot
			# puts on the performer now - shaft, toe cap, heel block, and the two spat straps
			# with their buttons - because a shop icon that does not match the thing you buy
			# is a small lie the player finds out about on the next stage. Side-on here, since
			# a card has the width for it and a profile is the clearer read of a boot.
			var lit2 := Color(minf(1.0, cc.r * 1.34), minf(1.0, cc.g * 1.30), minf(1.0, cc.b * 1.26))
			var sole := Color(0.16, 0.13, 0.12)
			draw_colored_polygon(PackedVector2Array([   # the shaft
				Vector2(c.x - 8.0, c.y - 18.0), Vector2(c.x + 6.0, c.y - 18.0),
				Vector2(c.x + 7.0, c.y + 2.0), Vector2(c.x - 9.0, c.y + 2.0)]), cc)
			draw_colored_polygon(PackedVector2Array([   # the foot, toe forward
				Vector2(c.x - 9.0, c.y + 2.0), Vector2(c.x + 7.0, c.y + 2.0),
				Vector2(c.x + 14.0, c.y + 7.0), Vector2(c.x + 18.0, c.y + 13.0),
				Vector2(c.x - 9.0, c.y + 13.0)]), cc)
			draw_colored_polygon(PackedVector2Array([   # the patent toe cap
				Vector2(c.x + 7.0, c.y + 13.0), Vector2(c.x + 18.0, c.y + 13.0),
				Vector2(c.x + 14.0, c.y + 7.0), Vector2(c.x + 8.0, c.y + 5.0)]), lit2)
			draw_rect(Rect2(c.x - 10.0, c.y + 12.5, 29.0, 4.0), sole)                 # the sole
			draw_rect(Rect2(c.x - 10.0, c.y + 5.0, 6.0, 8.0), sole)                   # the heel
			for sy2 in [-14.0, -6.0]:                                                 # the spat straps
				draw_rect(Rect2(c.x - 8.5, c.y + sy2, 15.0, 4.0), Color(0.92, 0.90, 0.84))
				draw_circle(Vector2(c.x - 4.0, c.y + sy2 + 2.0), 1.6, Color(0.86, 0.70, 0.34))
			draw_line(Vector2(c.x + 4.5, c.y - 16.0), Vector2(c.x + 5.5, c.y + 1.0), Color(1, 1, 1, 0.20), 2.0)
		"hat":   # TOP HAT: a tall crown, a band, and a brim seen slightly from above
			draw_colored_polygon(PackedVector2Array([
				Vector2(c.x - 10.0, c.y + 5.0), Vector2(c.x + 10.0, c.y + 5.0),
				Vector2(c.x + 11.0, c.y - 16.0), Vector2(c.x - 11.0, c.y - 16.0)]), cc)
			fill_ellipse(Vector2(c.x, c.y - 16.0), 11.0, 3.2,
				Color(minf(1.0, cc.r * 1.5 + 0.06), minf(1.0, cc.g * 1.5 + 0.06), minf(1.0, cc.b * 1.5 + 0.06)))
			draw_rect(Rect2(c.x - 10.5, c.y - 2.0, 21.0, 6.0), Color(0.88, 0.72, 0.34))   # the band
			fill_ellipse(Vector2(c.x, c.y + 7.0), 19.0, 5.0, Color(cc.r * 0.82, cc.g * 0.82, cc.b * 0.82))
			draw_line(Vector2(c.x - 9.0, c.y - 13.0), Vector2(c.x - 9.0, c.y + 2.0), Color(1, 1, 1, 0.16), 2.4)
		"coat":   # TAILCOAT (redrawn 2026-07-28, Louis: it looked strange - and it did: one
			# polygon with a notch cut in the bottom, which at icon size read as a purple
			# letter W or a bat). A coat needs THREE separate masses to be a coat: a torso
			# with sloped shoulders, a cutaway front hem at the waist, and two TAILS hanging
			# BELOW it with real daylight between them. Drawn as separate shapes so the gap
			# is a gap rather than a notch, which is the whole difference.
			var satin2 := Color(minf(1.0, cc.r * 1.6 + 0.08), minf(1.0, cc.g * 1.6 + 0.08), minf(1.0, cc.b * 1.6 + 0.08))
			for sgn4: float in [-1.0, 1.0]:                                 # the two tails, hanging
				draw_colored_polygon(PackedVector2Array([
					Vector2(c.x + sgn4 * 4.5, c.y + 3.0), Vector2(c.x + sgn4 * 15.0, c.y + 3.0),
					Vector2(c.x + sgn4 * 13.5, c.y + 19.0), Vector2(c.x + sgn4 * 9.0, c.y + 21.0),
					Vector2(c.x + sgn4 * 5.5, c.y + 15.0)]), Color(cc.r * 0.93, cc.g * 0.93, cc.b * 0.93))
			draw_colored_polygon(PackedVector2Array([                       # the body, cut away at the waist
				Vector2(c.x - 16.0, c.y - 13.0), Vector2(c.x - 6.0, c.y - 16.0),
				Vector2(c.x + 6.0, c.y - 16.0), Vector2(c.x + 16.0, c.y - 13.0),
				Vector2(c.x + 14.0, c.y + 4.0), Vector2(c.x - 14.0, c.y + 4.0)]), cc)
			for sgn5: float in [-1.0, 1.0]:                                 # the satin lapels
				draw_colored_polygon(PackedVector2Array([
					Vector2(c.x + sgn5 * 2.5, c.y - 15.0), Vector2(c.x + sgn5 * 12.0, c.y - 14.0),
					Vector2(c.x + sgn5 * 8.0, c.y - 1.0), Vector2(c.x + sgn5 * 1.5, c.y - 3.0)]), satin2)
			draw_colored_polygon(PackedVector2Array([                       # the shirt front between them
				Vector2(c.x - 2.0, c.y - 15.0), Vector2(c.x + 2.0, c.y - 15.0),
				Vector2(c.x + 1.5, c.y - 2.0), Vector2(c.x - 1.5, c.y - 2.0)]), Color(0.94, 0.92, 0.86))
			draw_colored_polygon(PackedVector2Array([                       # the bow tie
				Vector2(c.x - 5.5, c.y - 17.0), Vector2(c.x, c.y - 14.5), Vector2(c.x + 5.5, c.y - 17.0),
				Vector2(c.x + 5.5, c.y - 12.5), Vector2(c.x, c.y - 14.0), Vector2(c.x - 5.5, c.y - 12.5)]),
				Color(0.14, 0.10, 0.12))
			draw_circle(Vector2(c.x, c.y + 1.5), 1.8, Color(0.92, 0.82, 0.5))
		"vest":   # SEQUIN WAISTCOAT (redrawn 2026-07-28). The old shape was a shield - flat
			# across the top, tapering to a point - so it read as a crest, and the sequins
			# were scattered on a sunflower spiral, which is a pattern nothing sewn has. A
			# waistcoat has SHOULDER STRAPS with a V between them, a straight buttoned front,
			# and a pointed hem; the sequins sit in offset ROWS, the way they are actually
			# stitched, and there is nothing on the V, because that is where the shirt shows.
			draw_colored_polygon(PackedVector2Array([
				Vector2(c.x - 13.0, c.y - 15.0), Vector2(c.x - 4.0, c.y - 15.0),
				Vector2(c.x, c.y - 4.0), Vector2(c.x + 4.0, c.y - 15.0),
				Vector2(c.x + 13.0, c.y - 15.0), Vector2(c.x + 11.5, c.y + 9.0),
				Vector2(c.x, c.y + 19.0), Vector2(c.x - 11.5, c.y + 9.0)]), cc)
			for row2 in 4:                                                  # the sequins, in rows
				var ry2 := c.y - 5.0 + float(row2) * 5.6
				var ncol := 3 if row2 % 2 == 0 else 2
				for col2 in ncol:
					var rx2 := c.x + (float(col2) - (float(ncol) - 1.0) * 0.5) * 6.4
					var tw := 0.5 + 0.5 * sin(atick() * 0.05 + float(row2) * 1.7 + float(col2) * 2.3)
					draw_circle(Vector2(rx2, ry2), 1.9, Color(1.0, 0.98, 0.86, 0.32 + 0.58 * tw))
			for by2 in [-1.0, 5.0, 11.0]:                                   # the button line
				draw_circle(Vector2(c.x, c.y + by2), 1.1, Color(0.24, 0.20, 0.14, 0.75))
		"backroom", "frontroom":
			# THE DOOR. A curtained doorway, and which way it faces is the whole
			# information: the back room's curtain is parted onto a dark red gap you can
			# see through, the front room's is drawn nearly closed. Same object, opposite
			# states, so the pair reads as a way IN and a way OUT rather than two doors.
			var through := id == "backroom"
			var jamb := Color(0.30, 0.22, 0.18)
			var gapw := 11.0 if through else 3.0
			draw_rect(Rect2(c.x - 22.0, c.y - 22.0, 44.0, 44.0), jamb)              # the frame
			draw_rect(Rect2(c.x - gapw, c.y - 19.0, gapw * 2.0, 41.0),
				Color(0.10, 0.03, 0.04) if through else Color(0.14, 0.06, 0.07))    # the dark beyond
			if through:
				# a warm sliver of the room past the curtain: what makes it a way through
				draw_rect(Rect2(c.x - 3.0, c.y - 17.0, 6.0, 37.0), Color(0.85, 0.42, 0.22, 0.35))
			for sgn6 in [-1.0, 1.0]:
				# each half of the velvet, gathered: wider at the top where it hangs from
				# the rail, drawn back to the jamb at the bottom the way a tied curtain is
				draw_colored_polygon(PackedVector2Array([
					Vector2(c.x + sgn6 * 22.0, c.y - 19.0), Vector2(c.x + sgn6 * gapw, c.y - 19.0),
					Vector2(c.x + sgn6 * (gapw + 4.0), c.y + 6.0), Vector2(c.x + sgn6 * 22.0, c.y + 22.0)]), cc)
				draw_line(Vector2(c.x + sgn6 * (gapw + 2.0), c.y - 17.0),
					Vector2(c.x + sgn6 * (gapw + 5.0), c.y + 18.0), Color(1, 1, 1, 0.12), 2.0)
			draw_rect(Rect2(c.x - 23.0, c.y - 23.0, 46.0, 5.0), Color(0.52, 0.40, 0.20))   # the rail
			if not has_backroom and through:
				# the 16+ plate nailed to the jamb, which is the joke and also the gate
				draw_rect(Rect2(c.x + 6.0, c.y + 4.0, 17.0, 13.0), Color(0.90, 0.86, 0.78))
				draw_string(game_font(), Vector2(c.x + 7.0, c.y + 15.0), "16", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(11),
					Color(0.55, 0.10, 0.10))
		"drinks":
			# ENERGY DRINKS, and the point of this icon is that it is NOT the helmet
			# (2026-07-28, Louis: the hat "should be distinct from energy drinks"). One
			# card used to serve both and drew the hat for both, so the thing you buy ten
			# of looked exactly like the thing you buy once. This is the CANS: three of
			# them, banded, no cap and no straws anywhere.
			for k in 3:
				var can2 := c + Vector2(-19.0 + float(k) * 19.0, 2.0 + (2.0 if k == 1 else 0.0))
				var body2 := Color(0.86, 0.33, 0.24) if k != 1 else Color(0.92, 0.40, 0.28)
				draw_rect(Rect2(can2.x - 7.0, can2.y - 15.0, 14.0, 29.0), body2)
				draw_rect(Rect2(can2.x - 7.0, can2.y - 15.0, 3.4, 29.0), Color(1.0, 0.58, 0.48, 0.55))
				draw_rect(Rect2(can2.x + 4.2, can2.y - 15.0, 2.8, 29.0), Color(0.0, 0.0, 0.0, 0.26))
				fill_ellipse(Vector2(can2.x, can2.y - 15.0), 7.0, 2.5, Color(0.84, 0.86, 0.90))
				draw_rect(Rect2(can2.x - 7.0, can2.y - 3.0, 14.0, 3.2), Color(1.0, 0.85, 0.4, 0.85))
				# the pull ring, the one mark that says "can" rather than "tin"
				draw_arc(Vector2(can2.x + 1.6, can2.y - 15.4), 2.2, 0.0, TAU, 10, Color(0.70, 0.72, 0.76), 1.1, true)
		_:   # ENERGY-DRINK HELMET: the hat it actually is - a cap with a can either
			# side and a straw running round to the mouth
			# ...given the same lighting rule the props just got: cylinders that read as
			# cylinders (a lit edge and a shaded one, not a flat rectangle), a peaked
			# cap with a brim, and a bead climbing each straw so the thing looks in use
			var cap := c + Vector2(0.0, 4.0)
			for sgn3 in [-1.0, 1.0]:
				var can := cap + Vector2(sgn3 * 27.0, -1.0)
				var body := Color(0.86, 0.33, 0.24)
				draw_rect(Rect2(can.x - 7.5, can.y - 13.0, 15.0, 26.0), body)
				draw_rect(Rect2(can.x - 7.5, can.y - 13.0, 3.6, 26.0), Color(1.0, 0.58, 0.48, 0.55))   # lit edge
				draw_rect(Rect2(can.x + 4.4, can.y - 13.0, 3.1, 26.0), Color(0.0, 0.0, 0.0, 0.26))     # shaded edge
				fill_ellipse(Vector2(can.x, can.y - 13.0), 7.5, 2.6, Color(0.84, 0.86, 0.90))          # the rim, seen slightly from above
				fill_ellipse(Vector2(can.x, can.y + 13.0), 7.5, 2.4, Color(0.0, 0.0, 0.0, 0.30))
				draw_rect(Rect2(can.x - 7.5, can.y - 2.0, 15.0, 3.4), Color(1.0, 0.85, 0.4, 0.85))     # the label band
				# the straw stays on its OWN side and comes down to the mouth: crossing
				# them at the centre drew a plain white X over the cap
				var s0 := can + Vector2(-sgn3 * 3.0, -13.0)
				var s1 := cap + Vector2(sgn3 * 8.0, 14.0)
				draw_line(s0, s1, Color(0.92, 0.94, 0.98, 0.9), 2.6)
				draw_line(s0, s1, Color(1.0, 1.0, 1.0, 0.45), 1.0)
				var bead := fposmod(atick() * 0.012 + (0.5 if sgn3 > 0.0 else 0.0), 1.0)
				draw_circle(s1.lerp(s0, bead), 1.8, Color(1.0, 0.86, 0.42, 0.9))                       # a mouthful on its way up
			var dome := PackedVector2Array()
			for k in 17:
				var a4 := lerpf(PI, TAU, float(k) / 16.0)
				dome.append(cap + Vector2(cos(a4), sin(a4)) * 19.0)
			draw_colored_polygon(dome, cc)
			# the key light across the crown, and the brim that makes it a CAP
			draw_arc(cap, 14.0, PI * 1.12, PI * 1.62, 12, Color(1.0, 1.0, 1.0, 0.22), 7.0, true)
			# THE BRIM WAS A BOWTIE (fixed 2026-07-27). Its four corners were listed
			# out of perimeter order - the 2nd and 4th were swapped - so edge 0 crossed
			# edge 2 and Godot's triangulator refused the whole polygon. That is the
			# ENTIRE source of the shop's "Invalid polygon data, triangulation failed"
			# spam: one failure every frame the shop was open (the count came back as
			# exactly `shotat - 1` at three different frames, which is what pinned it to
			# a static shape rather than anything animated). It also meant the brim
			# never drew at all, so the hat had been missing the very part the comment
			# says makes it a cap. Corners now run the perimeter in order.
			draw_colored_polygon(PackedVector2Array([
				cap + Vector2(-16.0, 1.0), cap + Vector2(-15.0, 4.0), cap + Vector2(-4.0, 8.5), cap + Vector2(10.0, 8.0)]),
				Color(cc.r * 0.62, cc.g * 0.62, cc.b * 0.62))
			fill_ellipse(cap + Vector2(0.0, 1.0), 22.0, 4.0, Color(cc.r * 0.7, cc.g * 0.7, cc.b * 0.7))
			draw_circle(cap + Vector2(0.0, -19.0), 3.0, Color(cc.r * 0.55, cc.g * 0.55, cc.b * 0.55))


#endregion

#region SHOP SCREEN
func draw_tailor(font: Font, s: Vector2) -> void:
	# THE TAILOR: a mirror on the left, the choices on the right. The mirror is the whole
	# point of the screen - every other way of presenting a wardrobe (a grid of icons, a
	# list of names) makes the player imagine the result, and the one thing this screen can
	# do that the shop cannot is SHOW it.
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.04, 0.02, 0.03, 0.88))
	var pw := minf(1120.0, s.x - 60.0)
	var ph := minf(684.0, s.y - 24.0)
	var px := s.x * 0.5 - pw * 0.5
	var py := s.y * 0.5 - ph * 0.5
	soft_card(Rect2(px, py, pw, ph), Color(0.12, 0.07, 0.08, 0.98), Color(0.9, 0.6, 0.35, 0.5), 2.0, 16.0, 22.0)
	draw_string(title_font(), Vector2(px + 40.0, py + 50.0), "THE TAILOR", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(30), Color(1.0, 0.86, 0.55))
	# THE ONE SENTENCE THIS SCREEN MUST GET RIGHT. It is a loadout now (Louis reversed the
	# cosmetic-only call), which means taking a piece off costs you its bonus - and the trap I
	# was avoiding when I made it cosmetic is real, so the screen states the rule and the live
	# set bonus states the consequence. A player who dresses badly should be able to SEE that
	# they have, on this screen, before the act.
	draw_string(font, Vector2(px + 40.0, py + 82.0),
		"what you wear is what you get. A piece cut for tonight's house pays; the same piece cut for another is only clothes.",
		HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13), Color(0.82, 0.75, 0.64))
	draw_purse(font, px + pw - 40.0, py + 52.0)
	# the live read: how much of tonight's set is actually on him. Counted by CATEGORY, not by
	# raw piece (2026-07-30) - the head is one slot now, not two, so "the full set" means one
	# piece per slot, not literally every piece in WEAR_PIECES at once (see wear_category).
	var setb := costume_set_bonus()
	var wear_cats := wear_categories()
	var setn := 0
	for c0 in wear_cats:
		if wear_category_matches(c0):
			setn += 1
	draw_string(font, Vector2(px + pw - 460.0, py + 82.0),
		"tonight at %s:  %d of %d pieces  ·  score x%.2f" % [suit_name(cur_venue()), setn, wear_cats.size(), setb],
		HORIZONTAL_ALIGNMENT_RIGHT, 420.0, ps(13),
		Color(0.75, 0.95, 0.70) if setn > 0 else Color(0.86, 0.62, 0.52))
	draw_line(Vector2(px + 40.0, py + 100.0), Vector2(px + pw - 40.0, py + 100.0), Color(0.9, 0.6, 0.35, 0.3), 1.0)

	# ---------------- THE MIRROR ----------------
	var mw := 360.0
	var mirror := Rect2(px + 40.0, py + 124.0, mw, ph - 200.0)
	soft_card(mirror, Color(0.075, 0.05, 0.055, 0.97), Color(0.9, 0.6, 0.35, 0.34), 1.0, 12.0, 14.0)
	var pal := costume_palette()
	var mglow: Color = pal["glow"]
	var mcx := mirror.position.x + mirror.size.x * 0.5
	var mfy := mirror.position.y + mirror.size.y - 54.0
	# a pool of light and a lit floor, the same marks the skill preview's little stage makes -
	# so the figure is standing somewhere rather than floating on a panel.
	#
	# THE CONE IS GONE HERE TOO (2026-08-15). The skills preview dropped its identical
	# triangle on 2026-08-13 and this one was left behind, which is the whole reason it is
	# worth a note: the two panels are described as sharing "the same three marks", so a fix
	# to one of them has to be a fix to both or the shared description quietly stops being
	# true. Everything that note says applied here twice over. Measured on a Circus capture,
	# the wedge lifted the mirror's near-black card from 0.075 to 0.129 - it does not read as
	# light at that level, it reads as a hard-edged arrow with two straight diagonals running
	# from the top of the panel down past the performer's shoulders, pointing at him. And it
	# had no source: this is a dressing room, the card above him is unbroken, and the game's
	# standing rule since the stage cones came out is that light must name something the
	# picture actually contains. The pool at his feet says "he is lit" without drawing a shape,
	# which is exactly what the stages themselves now do.
	draw_glow(Vector2(mcx, mfy), mw * 0.38, Color(mglow.r, mglow.g, mglow.b, 0.18))
	draw_preview_floor(Rect2(mirror.position + Vector2(1.0, 0.0), mirror.size - Vector2(2.0, 1.0)),
		mfy, mglow)
	# HE BREATHES AND HIS HANDS DRIFT, because a costume is worn by a person: a figure
	# frozen in a T-pose is a mannequin, and the wardrobe was drawn to sit on a body that
	# moves. Cheap - two sines - and it uses the mirror's own idle hand positions rather
	# than the live sim's, so nothing here can touch a run in progress.
	# HE FILLS THE MIRROR. The preview scale exists to fit a figure into a 356px box beside
	# a diagram; here the figure IS the screen, and at PV_HEAD he stood about 180px tall in
	# a 480px panel - a doll in a wardrobe, with the sequins and the spat straps this room
	# exists to show off both under two pixels. `k` is solved from the panel rather than
	# picked: the canon is eight heads plus the hat's own reach above it.
	var t := float(atick())
	# ...snapped through fig_preview_k, so the hands below are placed for the body that
	# will actually be drawn. The mirror keeps a little more air above his hat than the
	# solved fit wanted; that is the price of a crisp figure and it is worth paying in the
	# one room whose whole job is looking closely at him.
	var k := fig_preview_k(clampf((mirror.size.y - 96.0) / (PV_FLOOR + PV_HEAD * 4.2), 1.0, 2.6))
	# `o` IS THE HAND LINE, not the head - that is the preview's own convention (the floor
	# sits PV_FLOOR below it), and reading it as the head is what put his arms up over his
	# shoulders in a V on the first try. Hands rest AT the line, out at the catch point,
	# with a little drift so he is a person standing rather than a mannequin on a pole.
	# ...and the hand line is solved BACK FROM THE BOARDS (fig_preview_drop), not guessed at
	# PV_FLOOR * k. The mirror draws its own floor at mfy and the figure is a fixed-size
	# painting: with k solved from the panel this put his boots 86px above the boards, which is
	# the tailor's half of Louis's "he's often floating". The one screen built for looking at
	# him closely was the worst offender.
	var o := Vector2(mcx, mfy - fig_preview_drop(k) + 3.0 * sin(t * 0.018))
	var hl := o + Vector2(-PV_OUTER * k, 4.0 * sin(t * 0.021 + 1.2) * k)
	var hr := o + Vector2(PV_OUTER * k, 4.0 * sin(t * 0.021) * k)
	# HE IS WEARING WHATEVER THE CURSOR IS ON, for this one figure only. See _fit_piece: it
	# is a draw-time override on worn_stage, set here and restored immediately, so the mirror
	# can show a garment the player has not equipped (or even bought) without anything that
	# scores ever seeing it. Nothing is committed until Enter.
	var hover: String = WEAR_PIECES[clampi(tailor_sel, 0, WEAR_PIECES.size() - 1)]
	var hover_st := clampi(tailor_stage, 0, venue_index())
	var already := worn_stage(hover) == hover_st
	if not already:
		_fit_piece = hover
		_fit_stage = hover_st
	draw_mini_juggler(o, hl, hr, 0.0, k)
	_fit_piece = ""
	_fit_stage = -1
	var wornname := "%s, %s cut" % [String(wear_piece_def(hover)["name"]), suit_name(hover_st)]
	draw_fit_string(font, Vector2(mirror.position.x, mirror.position.y + mirror.size.y - 34.0),
		wornname, HORIZONTAL_ALIGNMENT_CENTER, mirror.size.x, 13, Color(1.0, 0.88, 0.55))
	draw_fit_string(font, Vector2(mirror.position.x, mirror.position.y + mirror.size.y - 16.0),
		"worn" if already else "trying it on", HORIZONTAL_ALIGNMENT_CENTER, mirror.size.x, 11,
		Color(0.66, 0.92, 0.66) if already else Color(0.80, 0.74, 0.66))

	# ---------------- THE RACK (the SUIT column that used to sit here is gone - see
	# tailor_input for why) ----------------
	var cx2 := px + 40.0 + mw + 40.0
	var hy := py + 146.0
	var y0 := hy + 34.0
	# ---------------- THE RACK: one row per garment, one column per house ----------------
	# EVERY PIECE IS BOUGHT AND EVERY PIECE HAS SEVEN CUTS (2026-07-29). A list of on/off
	# toggles cannot express that, so the rack is a GRID: the garment down the side, the house
	# across the top. A cell is a swatch in that house's own colours - owned or not, worn or
	# not - which means the whole wardrobe, what it costs and what still matches tonight are
	# one glance rather than eight screens.
	var tonight := cur_venue()
	var cellw := 26.0
	var rowh2 := 40.0
	draw_string(font, Vector2(cx2, hy), "THE RACK", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(15), Color(0.95, 0.8, 0.55, 0.9))
	# the house headings, with TONIGHT'S marked - the only column that pays
	for st in venue_index() + 1:
		var hx := cx2 + 160.0 + float(st) * cellw
		var hc := Color(1.0, 0.86, 0.5) if st == tonight else Color(0.62, 0.56, 0.50)
		draw_string(font, Vector2(hx - 6.0, hy), str(st + 1), HORIZONTAL_ALIGNMENT_CENTER, cellw, ps(12), hc)
		if st == tonight:
			draw_rect(Rect2(hx - 13.0, hy + 6.0, cellw - 4.0, 2.0), Color(1.0, 0.86, 0.5, 0.7))
	# EVERY ROW IS DIVIDED INTO ITS CATEGORY (2026-07-30, Louis: "make sure it's all divided
	# into categories and make the player choose: eg headwear: either a hat or the drinking
	# cap"). Only "head" has more than one member today, but this is written off
	# wear_category so a future pair (say two rival eyewear pieces) groups itself the same
	# way with no new drawing code. `y_cursor` replaces the flat `y0 + j2 * rowh2`: a group of
	# more than one earns a small label and a little extra headroom to draw it in, everything
	# else falls through unchanged.
	var cat_count := {}
	for p0 in WEAR_PIECES:
		var c0 := wear_category(p0)
		cat_count[c0] = int(cat_count.get(c0, 0)) + 1
	var y_cursor := y0
	var prev_cat := ""
	for j2 in WEAR_PIECES.size():
		var piece: String = WEAR_PIECES[j2]
		var pdef := wear_piece_def(piece)
		var cat2 := wear_category(piece)
		if cat2 != prev_cat:
			if int(cat_count.get(cat2, 1)) > 1:
				draw_fit_string(font, Vector2(cx2, y_cursor - 20.0), "%s  -  choose one" % wear_category_label(cat2),
					HORIZONTAL_ALIGNMENT_LEFT, 300.0, 10, Color(0.85, 0.72, 0.45, 0.75))
				y_cursor += 12.0
			prev_cat = cat2
		var ry2 := y_cursor
		y_cursor += rowh2
		var rowsel := tailor_sel == j2
		if rowsel:
			soft_card(Rect2(cx2 - 12.0, ry2 - 22.0, 160.0 + float(venue_index() + 1) * cellw + 16.0, 34.0),
				Color(1.0, 0.85, 0.45, 0.07), Color(1.0, 0.88, 0.5, 0.40), 1.2, 8.0, 8.0)
		var wst := worn_stage(piece)
		var nc3 := Color(1.0, 0.9, 0.6) if rowsel else (Color(0.88, 0.82, 0.70) if wst >= 0 else Color(0.62, 0.57, 0.52))
		# EVERY ROW CARRIES ITS OWN OBJECT (2026-07-29, Louis: "it's not obvious what the
		# glowsuit button does"). He is right, and a name is a poor answer for a garment: a
		# rack of eight text labels is a list, and a list is the one thing a wardrobe should
		# never be. `draw_gear_icon` already draws each of these as the thing it is - it was
		# built for the shop cards these rows replaced - so the picture is free and the two
		# can never drift.
		# ...at a THIRD of the size they were drawn for. draw_gear_icon has no scale argument
		# (it was written for a 152px shop card), so the transform wraps the call rather than
		# the function growing a parameter every caller would then have to pass. Safe here
		# because none of these icons sets its own transform - the two that do, the props,
		# are not on this screen.
		# 0.5 NOW, AND IT HAD TO BE (2026-08-13). The old 0.42 was set by the WIDEST vector
		# icon rather than the average one - the glasses span ±28 units and the helmet ±40 (two
		# cans and a cap), so at 0.62 they reached 17 and 25px from centre and ran straight
		# through the name beside them, "Energy Helme" with a can sitting on the t.
		#
		# Seven of the eight are SPRITES now, and that changes the constraint completely: a
		# sprite is a uniform 40x40 units whatever it depicts, so at 0.5 the widest icon reaches
		# 10px into an 18px gutter and the helmet cannot overhang anything. What 0.42 could not
		# do is be SHARP - it is 16.8 screen pixels of a 40 unit source, a fractional resample,
		# and at this density that is the one thing pixel art does not survive. 0.5 is exactly
		# half: one screen pixel per art pixel, lossless, and the only value between "full size"
		# and "gone" that is a whole number of them. Same rule as fig_scale_H's halves.
		draw_set_transform(Vector2(cx2 + 12.0, ry2 - 5.0), 0.0, Vector2.ONE * 0.5)
		draw_gear_icon(String(pdef.get("gear", piece)), Vector2.ZERO, Color(nc3.r, nc3.g, nc3.b, 1.0), rowsel)
		draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
		draw_fit_string(font, Vector2(cx2 + 30.0, ry2), String(pdef["name"]), HORIZONTAL_ALIGNMENT_LEFT, 116.0, 14, nc3)
		for st2 in venue_index() + 1:
			var sx2 := cx2 + 160.0 + float(st2) * cellw - 13.0
			var box := Rect2(sx2, ry2 - 13.0, cellw - 6.0, 17.0)
			var sv := venue_data(st2)
			var owned2 := owns_wear(piece, st2)
			# GLOVES AND BOOTS KEEP THEIR OWN COLOUR (Louis: "the gloves can stay white and
			# the boots brown"), so their swatch shows the cloth they are actually made of
			# rather than a house tint that will never appear on the figure.
			var swatch: Color = Color(0.93, 0.92, 0.88) if piece == "gloves" \
				else (Color(0.42, 0.26, 0.17) if piece == "boots" else Color(sv["suit"]))
			if owned2:
				draw_rect(box, swatch)
				if wst == st2:
					draw_rect(box, Color(1.0, 0.92, 0.55), false, 2.0)   # WORN
			else:
				draw_rect(box, Color(swatch.r * 0.26, swatch.g * 0.26, swatch.b * 0.26, 0.75))
				draw_rect(box, Color(0.55, 0.50, 0.45, 0.45), false, 1.0)
			if rowsel and tailor_stage == st2:
				draw_rect(Rect2(box.position.x - 3.0, box.position.y - 3.0, box.size.x + 6.0, box.size.y + 6.0),
					Color(1.0, 0.88, 0.5, 0.95), false, 1.6)
	# ---------------- TOTAL BONUSES, on the right of the rack (2026-07-29, Louis: "show
	# total gained stats from the outfit on the right side of the rack"). The rack itself
	# only ever spells out ONE row at a time - whichever the cursor is sitting on; this is
	# the other half, everything actually ON him right now, all at once, so a player never
	# has to walk every row just to remember what their own outfit is doing for them.
	# Fixed past the rack's own MAXIMUM extent (seven house columns), so it never has to
	# shuffle sideways as Reputation opens more houses and the rack grows under it.
	var sumx := cx2 + 160.0 + 7.0 * cellw + 40.0
	var sumw := px + pw - 40.0 - sumx
	if sumw > 130.0:
		var worn_list: Array = []
		for p3 in WEAR_PIECES:
			if wearing(p3):
				worn_list.append(p3)
		var sumh := 34.0 + maxf(1.0, float(worn_list.size())) * 32.0
		soft_card(Rect2(sumx, hy - 12.0, sumw, sumh), Color(0.08, 0.06, 0.07, 0.92), Color(0.9, 0.6, 0.35, 0.30), 1.0, 10.0, 10.0)
		draw_wrap_fit(font, "WHAT IT'S DOING FOR YOU", Rect2(sumx + 14.0, hy - 2.0, sumw - 28.0, 30.0), 12,
			Color(0.95, 0.8, 0.55, 0.9))
		if worn_list.is_empty():
			draw_wrap_fit(font, "nothing worn yet - buy a piece from the rack and wear it",
				Rect2(sumx + 14.0, hy + 20.0, sumw - 28.0, 40.0), 12, Color(0.70, 0.65, 0.60))
		else:
			var sy := hy + 24.0
			for p4 in worn_list:
				var d4 := wear_piece_def(p4)
				# a piece cut for tonight's house is highlighted the same gold the set-bonus
				# line above uses; one cut for another house still pays its OWN buff (every
				# wearing() check below is unconditional on the venue - see the buff call
				# sites), so it is dimmed rather than greyed out entirely
				var match4 := wear_matches(p4)
				var nc4 := Color(1.0, 0.9, 0.6) if match4 else Color(0.80, 0.76, 0.68)
				draw_fit_string(font, Vector2(sumx + 14.0, sy), String(d4["name"]), HORIZONTAL_ALIGNMENT_LEFT, sumw - 28.0, 13, nc4)
				draw_fit_string(font, Vector2(sumx + 14.0, sy + 16.0), String(d4["note"]), HORIZONTAL_ALIGNMENT_LEFT, sumw - 28.0, 11,
					Color(0.78, 0.90, 0.72) if match4 else Color(0.60, 0.64, 0.58))
				sy += 32.0

	# the selected cell, spelled out: what it is, what it does, and what it costs or is worth
	var detw := pw - 40.0 - mw - 80.0    # the rack column's own width, now that it is the only one
	if true:
		var pc: String = WEAR_PIECES[clampi(tailor_sel, 0, WEAR_PIECES.size() - 1)]
		var pdf := wear_piece_def(pc)
		var stg := clampi(tailor_stage, 0, venue_index())
		var owned3 := owns_wear(pc, stg)
		var fy2 := y_cursor + 8.0   # the loop's own final cursor, so an extra group header pushes this down too
		draw_string(font, Vector2(cx2, fy2), "%s  -  %s cut" % [String(pdf["name"]), suit_name(stg)],
			HORIZONTAL_ALIGNMENT_LEFT, detw, ps(14), Color(1.0, 0.88, 0.55))
		draw_string(font, Vector2(cx2, fy2 + 20.0), String(pdf["note"]), HORIZONTAL_ALIGNMENT_LEFT, detw, ps(12),
			Color(0.78, 0.90, 0.72))
		if not owned3:
			var pcost := wear_cost(pc, stg)
			var afford2 := money >= pcost
			draw_string(font, Vector2(cx2, fy2 + 40.0), "buy for %s" % commafy(pcost),
				HORIZONTAL_ALIGNMENT_LEFT, detw, ps(13),
				Color(0.78, 0.96, 0.72) if afford2 else Color(0.90, 0.55, 0.48))
		elif worn_stage(pc) == stg:
			draw_string(font, Vector2(cx2, fy2 + 40.0), "worn  -  press again to take it off",
				HORIZONTAL_ALIGNMENT_LEFT, detw, ps(13), Color(0.80, 0.75, 0.68))
		else:
			draw_string(font, Vector2(cx2, fy2 + 40.0), "owned  -  press to wear it",
				HORIZONTAL_ALIGNMENT_LEFT, detw, ps(13), Color(0.80, 0.75, 0.68))
		# SHARING A SLOT, SPELLED OUT (2026-07-30, Louis: "make the player choose"): only ever
		# shown for a category with a rival in it, so the one pair that competes (hat, helmet)
		# says so right where the player is about to press Enter on one of them.
		if int(cat_count.get(wear_category(pc), 1)) > 1:
			var rivals: Array = []
			for pr in WEAR_PIECES:
				if pr != pc and wear_category(pr) == wear_category(pc):
					rivals.append(String(wear_piece_def(pr)["name"]))
			draw_string(font, Vector2(cx2, fy2 + 60.0), "shares a slot with the %s  -  wearing one takes off the other" % ", ".join(rivals),
				HORIZONTAL_ALIGNMENT_LEFT, detw, ps(12), Color(0.78, 0.72, 0.62))

	draw_hints_row(font, px + pw * 0.5, py + ph - 40.0,
		[[["Up", "Down"], "garment"], [["Left", "Right"], "house"], [["Enter"], "wear it"],
		 [["B"], "outfit tonight's set"], [["Tab"], "leave"]])


func draw_shop(font: Font, s: Vector2) -> void:
	# the SHOP, dealt as CARDS (Louis: Balatro look - big cards, clean zones, the buy
	# key printed on every card). One zone of five prop cards, one zone of gear, the
	# purse always big top-right.
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.04, 0.02, 0.03, 0.9))
	var pw := minf(1120.0, s.x - 60.0)
	var ph := minf(696.0, s.y - 24.0)
	var px := s.x * 0.5 - pw * 0.5
	var py := s.y * 0.5 - ph * 0.5
	soft_card(Rect2(px, py, pw, ph), Color(0.10, 0.06, 0.075, 0.99), Color(0.9, 0.6, 0.35, 0.55), 2.0, 16.0, 22.0)

	var tx := px + 40.0
	var innerw := pw - 80.0
	draw_string(title_font(), Vector2(tx, py + 52.0), "SHOP", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(34), Color(1.0, 0.86, 0.55))
	# WHICH ROOM, said in the header rather than left to be inferred from the goods
	# ...and it no longer has to teach a hotkey. The C hint lived here because C was the
	# only way through the curtain; the door is a card on the gear row now and explains
	# itself where every other purchase does.
	var sub := "to juggle N of a prop, own N of them"
	draw_string(font, Vector2(tx + 118.0, py + 50.0), sub, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13),
		Color(0.95, 0.72, 0.55) if shop_room == SHOP_ROOM_BACK else Color(0.75, 0.68, 0.6))
	draw_purse(font, px + pw - 40.0, py + 52.0)

	# ---------------- PROPS ----------------
	if shop_grid_on():
		draw_shop_grid(font, tx, py, innerw, strip_y_for(py, ph))
	else:
		draw_shop_row(font, tx, py, innerw)
	draw_shop_tail(font, px, py, pw, ph, tx, innerw)


# the single row's own two numbers, named because draw_shop_tail places the gear row off them
const SHOP_ROW_TOP := 110.0
const SHOP_ROW_H := 282.0

func strip_y_for(py: float, ph: float) -> float:
	return py + ph - 92.0    # where the detail strip starts; the goods have to stop above it


func draw_shop_grid(font: Font, tx: float, py: float, innerw: float, strip_y: float) -> void:
	# THE GOODS, DEALT AS A GRID (2026-07-30, F9 `shop_v2`; Louis asked for the shop to look
	# better). What was wrong was not the card, it was the ROOM. Seven cards in one row across
	# 1,040px gives each one 141px, so the object you are buying was drawn at about 60px in the
	# top fifth of a tall card - the smallest thing on a screen whose entire job is to make you
	# want it - while the panel's whole lower half sat empty because the gear row it was sized
	# for no longer has anything in it.
	#
	# Two rows of four turn 141px into 251 and the dead band into goods. And at that width the
	# card reads ACROSS rather than down: a big PORTRAIT niche on the left with the prop shown
	# properly, its numbers in a column beside it, the price along the foot. That is the template
	# the file already worked out for wide gear cards, applied to the props now that they have
	# the width for it. Everything on it is what was on it before - own, ready, Str per object,
	# the count you could field, the exponent, the set meter, the buy key - so nothing has to be
	# relearned; the same facts are simply legible.
	var room_props := shop_props()
	var np := room_props.size()
	var cols := shop_grid_cols()
	var rows := int(ceil(float(np) / float(cols)))
	var gap := 12.0
	var band_top := py + 112.0
	var band_h := (strip_y - 20.0) - band_top
	var ch := minf((band_h - gap * float(rows - 1)) / float(rows), 300.0)
	var cw := minf((innerw - gap * float(cols - 1)) / float(cols), 300.0)
	draw_string(font, Vector2(tx, py + 96.0), "PROPS",
		HORIZONTAL_ALIGNMENT_LEFT, -1, ps(14), Color(0.95, 0.8, 0.55, 0.9))
	var hover_card := Rect2()
	var hover_prop := -1
	for ci in np:
		var i: int = room_props[ci]
		var row := ci / cols
		var col := ci % cols
		# A SHORT LAST ROW IS CENTRED. Seven over four leaves three, and three cards left-aligned
		# under four reads as a card having failed to draw rather than as a row of three.
		var in_row := mini(cols, np - row * cols)
		var row_w := cw * float(in_row) + gap * float(in_row - 1)
		var cx0 := tx + (innerw - row_w) * 0.5 + float(col) * (cw + gap)
		var cy0 := band_top + float(row) * (ch + gap) - (6.0 if ci == shop_sel else 0.0)
		var cr := Rect2(cx0, cy0, cw, ch)
		draw_shop_prop_card(font, i, cr, ci == shop_sel)
		if ci == shop_sel:
			hover_card = cr
			hover_prop = i
	# LAST, so it may cover a neighbour but never the card it describes - see draw_shop_hover
	if hover_prop >= 0:
		draw_shop_hover(font, hover_prop, hover_card, get_viewport_rect().size)


func shop_stat_rows(i: int) -> Array:
	# THE THREE FACTS ABOUT A PROP, and only three (2026-07-30, Louis: "To know more about it
	# (the strength, max number of objects you can juggle with, owned) you should hover over
	# it"). Score came off the card entirely - it is a reward, not a stat you shop by, and the
	# detail strip below already names what each prop is FOR in words.
	#
	# STRENGTH IS PER OBJECT AGAIN ("change str for 3 into strength (and then divide the number
	# by 3)"), which is the honest reading of the number: `PROP_STR_UNIT` is a property OF THE
	# PROP, where "Str for 3" was a property of the prop and tonight's count together and
	# changed under the player when they stepped the count. The count-dependent answer is the
	# row below it, which is the one a player actually acts on.
	return [
		["Strength", "%d" % prop_str_unit(i), Color(0.86, 0.80, 0.72)],
		["max objects", "%d" % max_count(i), Color(0.72, 0.88, 0.70) if max_count(i) >= MIN_BALLS else Color(0.95, 0.6, 0.45)],
		["Owned", "%d" % prop_count[i], Color(0.75, 0.9, 0.72) if prop_count[i] >= num_balls else Color(0.95, 0.68, 0.35)],
	]


func draw_stat_rows(font: Font, x: float, w: float, y0: float, step: float, rows: Array, size: int) -> void:
	# a stat list drawn as a TABLE - every label on one left edge, every value on one right
	# edge - because a list of numbers is only readable if the numbers line up; that alignment
	# is what makes it a list rather than three more sentences.
	# The LABEL may shorten (it is a phrase, and its meaning survives an ellipsis); the VALUE
	# never does, because an ellipsised number is not a number - it shrinks through fit_size
	# instead, which is this file's own rule for anything the player reads as an amount.
	for ri in rows.size():
		var row: Array = rows[ri]
		var lab := String(row[0])
		var val := String(row[1])
		var vs := fit_size(font, val, w * 0.55, size, 9)
		var vw: float = font.get_string_size(val, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(vs)).x
		var ry := y0 + float(ri) * step
		var ind: float = 14.0 if lab.begins_with("max ") else 0.0
		draw_fit_string(font, Vector2(x + ind, ry), lab, HORIZONTAL_ALIGNMENT_LEFT,
			maxf(20.0, w - ind - vw - 8.0), size, Color(0.68, 0.62, 0.56))
		draw_string(font, Vector2(x, ry), val, HORIZONTAL_ALIGNMENT_RIGHT, w, ps(vs), row[2])


func draw_enter_arrow(x: float, y0: float, y1: float, run: float, col: Color) -> void:
	# THE ENTER SYMBOL, drawn rather than typed (2026-07-30, Louis: "add a line that puts a
	# arrow from the strength line towards this one (like an enter symbol)"). It is a
	# CONSEQUENCE mark: the max-objects row is what the Strength row leads to, and an arrow
	# turning out of one line into the next is the shortest way to say so.
	# Drawn, because the game's UI font is not guaranteed to carry an arrow glyph and a
	# missing one renders as a tofu box in the middle of a stat list - the same reason every
	# other mark in this file (the coin, the crescent, the star) is geometry and not a
	# character.
	draw_line(Vector2(x, y0), Vector2(x, y1), col, 1.6)
	draw_line(Vector2(x, y1), Vector2(x + run, y1), col, 1.6)
	# THE HEAD HAS TO OUTWEIGH THE SHAFT or the mark reads as the letter L, which is what the
	# first one did at a 3.4px head on a 7px run - the same "detail is a function of size"
	# trap draw_coin records, met on a glyph instead of an icon.
	var tip := Vector2(x + run + 4.6, y1)
	draw_colored_polygon(PackedVector2Array([
		tip, tip + Vector2(-4.6, -3.4), tip + Vector2(-4.6, 3.4)]), col)


func draw_shop_hover(font: Font, i: int, card: Rect2, s: Vector2) -> void:
	# THE STATS, IN A WINDOW BESIDE THE CARD (2026-07-30, Louis: "make sure that window doesn't
	# overlap with the hovered object. It is allowed to overlap with other objects, because it
	# should be directly to the right or to the left of the hovered card, depending on which
	# side of the screen has more room to display").
	#
	# The rule is a comparison, not a constant: whichever side of the SCREEN has more room
	# takes the panel, so the leftmost column opens right and the rightmost opens left without
	# either being special-cased. It is drawn AFTER every card - that is what buys the licence
	# to cover a neighbour, and it is the whole reason the popup lives in the grid rather than
	# in the card function that would draw it mid-row and be painted over by the next card.
	var rows := shop_stat_rows(i)
	var w := 176.0
	var h := 44.0 + float(rows.size()) * 21.0 + 8.0
	var room_l := card.position.x
	var room_r := s.x - card.end.x
	var x := (card.end.x + 14.0) if room_r >= room_l else (card.position.x - 14.0 - w)
	# ...and it is clamped to the screen VERTICALLY only. Clamping x too would let it slide
	# back over the card it is describing, which is the one thing it may never cover.
	var y := clampf(card.get_center().y - h * 0.5, 12.0, s.y - h - 12.0)
	var box := Rect2(x, y, w, h)
	soft_card(box, Color(0.10, 0.065, 0.085, 0.98), Color(1.0, 0.86, 0.5, 0.75), 1.6, 11.0, 16.0)
	var nm := String(PROPS[i]["name"])
	draw_string(font, Vector2(x, y + 26.0), nm, HORIZONTAL_ALIGNMENT_CENTER, w,
		ps(fit_size(font, nm, w - 20.0, 18, 12)), Color(1.0, 0.88, 0.6))
	draw_line(Vector2(x + 14.0, y + 36.0), Vector2(x + w - 14.0, y + 36.0), Color(1.0, 0.86, 0.5, 0.22), 1.0)
	var lx := x + 16.0
	var rw := w - 32.0
	var y0 := y + 56.0
	draw_stat_rows(font, lx, rw, y0, 21.0, rows, 12)
	# the arrow, from the Strength row down into the one it decides. `max objects` is indented
	# past it so the turn has somewhere to land.
	draw_enter_arrow(lx + 4.0, y0 + 4.0, y0 + 17.0, 4.0, Color(0.92, 0.78, 0.50, 0.85))


func draw_shop_prop_card(font: Font, i: int, r: Rect2, sel: bool) -> void:
	# THE CARD IS THE OBJECT (2026-07-30, Louis: "I want the entire card to be the objects
	# picture. Right above it should be a small cardlike window with its price").
	#
	# What came off: the name, the "ready" badge, the four stat rows, the set meter and the
	# buy-key plate. What is left is the thing you are buying, as big as the card will carry,
	# and what it costs. That is the whole of a shop stall - **you do not read a market stall,
	# you look at it** - and the numbers a buyer needs before committing are one hover away in
	# `draw_shop_hover` rather than printed seven times over whether or not anyone is asking.
	# The prop was previously drawn at about 60px inside a niche taking a fifth of the card;
	# it is now the card.
	var pcol := prop_color(i)
	var cost := int(PROPS[i]["cost"])
	var afford := money >= cost
	if sel:
		soft_card(r, Color(pcol.r * 0.19, pcol.g * 0.18, pcol.b * 0.19, 0.97),
			Color(1.0, 0.88, 0.5, 0.95), 2.5, 11.0, 18.0)
	else:
		hud_card(r, Color(pcol.r, pcol.g, pcol.b, 0.45))
	# THE PRICE, in its own small window at the top. Bigger than any number on the old card
	# and centred, because on a stall the price IS the second thing you look at - and it is a
	# number, so it goes through fit_size and never through fit_text.
	var price := commafy(cost)
	var psz := fit_size(font, price, r.size.x * 0.46, 21, 11)
	var pwid: float = font.get_string_size(price, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(psz)).x
	var mr := 7.0
	var chw := minf(pwid + mr * 2.0 + 30.0, r.size.x - 24.0)
	var chh := 30.0
	var chip := Rect2(r.position.x + r.size.x * 0.5 - chw * 0.5, r.position.y + 9.0, chw, chh)
	soft_card(chip, Color(0.06, 0.04, 0.05, 0.92),
		Color(0.55, 0.85, 0.5, 0.55) if afford else Color(0.7, 0.35, 0.3, 0.45), 1.2, 8.0, 6.0)
	var pcol_t := Color(1.0, 0.92, 0.62) if afford else Color(0.86, 0.52, 0.46)
	draw_string(font, Vector2(chip.position.x + 13.0, chip.position.y + chh * 0.5 + float(psz) * 0.36),
		price, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(psz), pcol_t)
	draw_coin_mark(Vector2(chip.end.x - 13.0 - mr, chip.position.y + chh * 0.5), mr, Color(1, 1, 1, 1), true)
	# ...and the goods, filling everything under it. `mag` comes off the space actually left
	# rather than a fixed number, so the same card body works at the grid's 250px and at the
	# fallback row's 141 without a prop growing out through its own card.
	var pic := Rect2(r.position.x + 6.0, chip.end.y + 4.0, r.size.x - 12.0, r.end.y - chip.end.y - 12.0)
	var mag := clampf(minf(pic.size.x / 132.0, pic.size.y / 106.0), 0.62, 1.72)
	draw_prop_icon(i, pic.get_center() + Vector2(0.0, pic.size.y * 0.06), mag, sel)


func draw_shop_row(font: Font, tx: float, py: float, innerw: float) -> void:
	# ---------------- PROPS: one card per prop, in one row ----------------
	# THE ROW FITS WHATEVER PROPS HOLDS. It was `(innerw - gap * 5) / 6`, so the seventh
	# prop (the chainsaw) was laid out at a sixth of the width and drew its whole card
	# out through the panel's right border and off the screen. Both terms come off the
	# count now. This row is the reason a prop CATEGORY system is the right next move:
	# past about eight cards there is no width left, whatever the arithmetic says.
	draw_string(font, Vector2(tx, py + 96.0), "PROPS",
		HORIZONTAL_ALIGNMENT_LEFT, -1, ps(14), Color(0.95, 0.8, 0.55, 0.9))
	var room_props := shop_props()
	var np := room_props.size()
	var gap := 14.0 if np <= 6 else 10.0
	var cw := (innerw - gap * float(np - 1)) / float(np)
	var ch := SHOP_ROW_H
	var y0 := py + SHOP_ROW_TOP
	var hover_card := Rect2()
	var hover_prop := -1
	for ci in np:
		var i: int = room_props[ci]   # balls included: every prop is bought stock now (Louis)
		var sel := ci == shop_sel
		# the SELECTED card lifts off the row, the same cursor every card screen uses.
		# ONE CARD BODY FOR BOTH LAYOUTS (2026-07-30): this loop used to carry its own copy of
		# the card - a differently-worded, differently-placed twin of the grid's - which is the
		# duplication that cost a whole render pass when the stat table landed in the fallback
		# and nothing moved on screen. `draw_shop_prop_card` sizes its picture off the rect it
		# is handed, so a 141px row card and a 250px grid card are the same drawing.
		var cx0 := tx + float(ci) * (cw + gap)
		var cy0 := y0 - (6.0 if sel else 0.0)
		var cr := Rect2(cx0, cy0, cw, ch)
		draw_shop_prop_card(font, i, cr, sel)
		if sel:
			hover_card = cr
			hover_prop = i
	if hover_prop >= 0:
		draw_shop_hover(font, hover_prop, hover_card, get_viewport_rect().size)


func draw_shop_tail(font: Font, px: float, py: float, pw: float, ph: float, tx: float, innerw: float) -> void:
	# GEAR, the detail strip and the key row: everything below the goods, and identical whether
	# the props were dealt as a grid or as the old single row. Split out when the grid arrived so
	# the two layouts cannot drift apart in the parts they share - which is most of the screen.
	# The gear row's own top is computed from the single row's numbers because a non-empty gear
	# row is exactly the case shop_grid_on() refuses (see there), so the row is what is above it.
	var y0 := py + SHOP_ROW_TOP
	var ch := SHOP_ROW_H
	# ---------------- GEAR: one card per row of shop_gear(), laid out to fit ----------
	# TWO TEMPLATES, chosen by how many there are. Up to four, a gear card is wide and
	# short and reads ACROSS - object left in a lit disc, words right, price along the
	# foot. Past four (the back room carries seven) that layout has under 150px of card
	# and the words have nowhere to go, so it switches to the narrow PORTRAIT template
	# the prop cards already prove works at that width, and the description moves to the
	# detail strip at the foot, which is showing the selected item anyway.
	var glist := shop_gear()
	var gn := glist.size()
	var gy := y0 + ch + 30.0
	if gn > 0:   # ...and no header over an empty row: the gear cards all became clothing or,
		# in the Glow Tape's case, per-prop stock, so the row is usually empty now
		draw_string(font, Vector2(tx, gy), "GEAR", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(14), Color(0.95, 0.8, 0.55, 0.9))
	# A GEAR CARD HAS A MAXIMUM WIDTH. With the clothes gone the row holds ONE item, and
	# `innerw / 1` stretched that card across the whole panel - a single object floating in
	# 1,040px of empty card, which reads as a bug rather than as a shop with one thing left
	# in it. Capped at the width four cards used to get, and the row centres what it has.
	var ggap := 14.0 if gn <= 4 else 10.0
	var gw := minf((innerw - ggap * float(gn - 1)) / float(gn), 260.0)
	var grow_w := gw * float(gn) + ggap * float(gn - 1)
	var gx0 := tx + (innerw - grow_w) * 0.5
	var wide := gn <= 4
	var gh := 152.0
	var gy0 := gy + 14.0
	for i in gn:
		var e: Dictionary = glist[i]
		var gsel := shop_sel == shop_gear0() + i
		var cx0 := gx0 + float(i) * (gw + ggap)
		var cc: Color = e["col"]
		var gcost := int(e["cost"])
		var owned := bool(e["owned"])
		var gcount := int(e.get("count", 0))
		if gsel:
			soft_card(Rect2(cx0, gy0, gw, gh), Color(cc.r * 0.17, cc.g * 0.17, cc.b * 0.17, 0.96),
				Color(1.0, 0.88, 0.5, 0.95), 2.5, 11.0, 18.0)
		else:
			hud_card(Rect2(cx0, gy0, gw, gh), Color(cc.r, cc.g, cc.b, 0.4))
		var plate_top := gy0 + gh - 46.0
		if wide:
			draw_glow(Vector2(cx0 + 46.0, gy0 + 52.0), 40.0, Color(cc.r, cc.g, cc.b, 0.16))
			draw_gear_icon(String(e["id"]), Vector2(cx0 + 46.0, gy0 + 52.0), cc, gsel)
			var txw := gw - 104.0
			draw_fit_string(font, Vector2(cx0 + 92.0, gy0 + 40.0), String(e["name"]), HORIZONTAL_ALIGNMENT_LEFT, txw,
				fit_size(font, String(e["name"]), txw, 17, 12), Color(1.0, 0.88, 0.6))
			draw_wrap_fit(font, String(e["desc"]), Rect2(cx0 + 92.0, gy0 + 50.0, txw, plate_top - gy0 - 58.0), 11,
				Color(0.75, 0.68, 0.6))
		else:
			draw_glow(Vector2(cx0 + gw * 0.5, gy0 + 44.0), 34.0, Color(cc.r, cc.g, cc.b, 0.16))
			draw_gear_icon(String(e["id"]), Vector2(cx0 + gw * 0.5, gy0 + 44.0), cc, gsel)
			draw_fit_string(font, Vector2(cx0, gy0 + 88.0), String(e["name"]), HORIZONTAL_ALIGNMENT_CENTER, gw,
				fit_size(font, String(e["name"]), gw - 10.0, 15, 10), Color(1.0, 0.88, 0.6))
		if owned:
			draw_string(font, Vector2(cx0, gy0 + gh - 20.0), "OWNED", HORIZONTAL_ALIGNMENT_CENTER, gw, ps(15), Color(0.6, 0.9, 0.6))
		else:
			if gcount > 0:
				draw_string(font, Vector2(cx0, gy0 + 22.0), "own %d" % gcount, HORIZONTAL_ALIGNMENT_RIGHT, gw - 12.0, ps(12), Color(0.75, 0.9, 0.72))
			draw_price_plate(font, Rect2(cx0 + 10.0, plate_top, gw - 20.0, 38.0),
				"", commafy(gcost), money >= gcost,
				"walk through" if gcost == 0 else "")

	# ---------------- detail strip: the SELECTED item explained in a sentence ----------------
	# this is where a prop's IDENTITY lives (its signature edge), so the small cards stay
	# uncluttered and the player still learns why they would pick one prop over another. A
	# recent warning (can't afford, etc.) takes the strip over instead - it is more urgent
	# and just as transient, so the two never fight for the same row.
	var strip_y := py + ph - 92.0
	var strip := Rect2(px + 30.0, strip_y, pw - 60.0, 40.0)
	var noted := shop_msg != "" and int(Time.get_ticks_msec()) - shop_msg_ms < 5000
	var warn := noted and shop_msg_warn
	soft_card(strip, Color(0.10, 0.05, 0.05, 0.85) if warn else Color(0.08, 0.05, 0.06, 0.82),
		Color(1.0, 0.5, 0.4, 0.5) if warn else Color(0.9, 0.6, 0.35, 0.3), 1.0, 9.0, 8.0)
	if noted:
		draw_string(font, Vector2(strip.position.x, strip_y + 25.0), shop_msg, HORIZONTAL_ALIGNMENT_CENTER, strip.size.x, ps(13),
			Color(1.0, 0.66, 0.5) if warn else Color(0.72, 0.95, 0.68))
	else:
		var detail := ""
		var detail_head := ""
		if shop_sel < shop_gear0():
			var pk: int = shop_props()[shop_sel]
			detail_head = String(PROPS[pk]["name"])
			detail = String(PROPS[pk]["trait"])
			# ...and what a GLOWING set of them would cost, since this is the only place in
			# the game that sells one, and the card itself is full to its foot.
			var gown := glow_count[pk] if pk < glow_count.size() else 0
			detail += "   [G] glowing: own %d, %s each" % [gown, commafy(glow_cost(pk))]
		else:
			var gi := shop_sel - shop_gear0()
			var gl := shop_gear()
			if gi >= 0 and gi < gl.size():
				detail_head = String(gl[gi]["name"])
				detail = String(gl[gi]["desc"])
		if detail != "":
			draw_string(font, Vector2(strip.position.x + 16.0, strip_y + 25.0), detail_head, HORIZONTAL_ALIGNMENT_LEFT, 156.0, ps(15), Color(1.0, 0.86, 0.55))
			draw_string(font, Vector2(strip.position.x + 180.0, strip_y + 25.0), detail, HORIZONTAL_ALIGNMENT_LEFT, strip.size.x - 196.0, ps(13), Color(0.85, 0.8, 0.7))

	# ---------------- footer: the keys ----------------
	if pad_active():
		draw_hints_row(font, px + pw * 0.5, py + ph - 38.0,
			[[["Stick"], "choose"], [k_finish(), "buy one"], [["X"], "the set"], [["G"], "glowing"], [k_sheet(), "leave"]])
	else:
		draw_hints_row(font, px + pw * 0.5, py + ph - 38.0,
			[[["Left", "Right"], "choose"], [["Enter"], "buy one"], [["B"], "the set"],
			 [["G"], "glowing"], [["Tab"], "leave"]])


#endregion

#region SKILLS SCREEN
func _skills_row(font: Font, x: float, y: float, w: float, ename: String, req: Dictionary, unlocked: bool, sel: bool) -> void:
	# one entry in the Skills reference: name on the left, a ready / gate badge
	# on the right, and a soft highlight when it is the selected entry.
	#
	# A LOCKED ENTRY GIVES NOTHING AWAY (2026-07-28, Louis: "hide the tricks and patterns
	# until they are unlocked"). It used to print the skill's real name and the exact bar it
	# sat behind, which is a complete table of contents for a deck that is now supposed to
	# be a surprise - and it would be a LIE besides, since crossing that particular bar no
	# longer hands you that particular skill. So an unowned row is a row of pips and a
	# "locked" badge, and the count of them is the only real information on offer: how many
	# are left. `req` is still taken because an owned row is unchanged, and because
	# hiding a name is exactly the kind of thing that wants one call site.
	if sel:
		# the same raised, rounded card the shop and the day hub use for a cursor -
		# a flat outlined rectangle was the last bare draw_rect on this screen
		soft_card(Rect2(x - 12.0, y - 23.0, w, 38.0), Color(1.0, 0.85, 0.45, 0.09),
			Color(1.0, 0.88, 0.5, 0.55), 1.5, 8.0, 10.0)
	var nc := Color(1.0, 0.9, 0.6) if sel else (Color(0.86, 0.8, 0.68) if unlocked else Color(0.55, 0.5, 0.46))
	if not unlocked:
		# a little face-down card and a row of dots where the name was. The card mark is
		# the same object the unlock deals, so the row and the reward speak the same
		# language: what is behind this is a card you have not turned over.
		var kc := card_kind_col(bool(req.get("kind", "") != ""))
		draw_rect(Rect2(x, y - 12.0, 11.0, 15.0), Color(kc.r * 0.35, kc.g * 0.35, kc.b * 0.35, 0.85))
		draw_rect(Rect2(x, y - 12.0, 11.0, 15.0), Color(kc.r, kc.g, kc.b, 0.55), false, 1.0)
		for di in 4:
			draw_circle(Vector2(x + 24.0 + float(di) * 13.0, y - 5.0), 2.6, Color(0.55, 0.50, 0.46, 0.9))
		# right edge pulled 12px inside the row, or it sits exactly ON the selection
		# highlight's border - which the narrower columns made visible
		draw_string(font, Vector2(x + w - 88.0, y), "locked", HORIZONTAL_ALIGNMENT_RIGHT, 64.0, ps(12), Color(0.66, 0.58, 0.52))
		return
	# NO "ready" BADGE ANY MORE, and dropping it is what let the columns narrow enough for the
	# card to have a home. It was there to distinguish an owned skill from a locked one back
	# when both printed their real name; now a locked row is visibly a face-down card and the
	# word "locked", so "ready" was being printed on every other row to say the one thing the
	# absence of a card back already said. The 76px it occupied goes to the name, which is why
	# "Reverse Cascade" fits at 196 where it was ellipsising at 268.
	draw_fit_string(font, Vector2(x, y), ename, HORIZONTAL_ALIGNMENT_LEFT, w - 14.0, 17, nc)


# --- SKILL PREVIEWS (Skills screen) -------------------------------------------
# Every skill - trick OR pattern - gets the same picture now: a miniature stage with
# the juggler standing on it, the flight ROADS drawn as ghost arcs behind him, and
# props running that skill's real choreography on a loop. It is not the sim (it never
# reads or writes `balls`, `pattern` or `tick`, so it is safe to animate from any
# screen), but its geometry is DERIVED from the sim's, which is what makes it read as
# THIS skill instead of a generic bouncing loop:
#   * PV_OUTER / PV_INNER are outer_pos / inner_pos at PV_K scale,
#   * PV_ARC is one tap throw's true peak (BASE_AIR * ARC_PER_AIR) at that scale, and
#     a leg's DURATION rides its height exactly as airtime does in flight_pos,
#   * the figure is draw_juggler's own eight-head canon, same head unit, same stance,
#   * every leg is read off do_throw's actual rules: a plain throw leaves INNER and
#     lands OUTER, an over-the-top lob leaves OUTER and lands on over_top_land_slot,
#     the Shower's feed hand snaps SHOWER_FEED-flat, Columns rides columns_x lanes,
#     and Behind the Back releases from behind the FAR hip (drawn behind the body,
#     the same _btb_behind cut the real one uses).
# What was here before was two dots bouncing in a 176x130 box - no figure, no roads,
# no hands, and nothing at all for the four TRICKS (Louis: "awful / wrong or not even
# there"). Everything a preview draws is bounded by construction (see draw_skill_
# preview's `inner` rect): a prop that would leave the frame is not clipped mid-shape,
# it fades and hands over to a top-edge marker, which is what the real High Toss does.
const PV_K := 0.55            # preview px per stage px (PV_OUTER / outer_pos's own 100)
const PV_OUTER := 55.0        # the catch point (outer_pos, 100px out) at preview scale
const PV_INNER := 29.7        # the throw point (inner_pos, 54px out) at preview scale
const PV_HEAD := 22.2         # draw_juggler's head unit H at preview scale
const PV_FLOOR := 91.0        # the floor line, below the hand line (4.11 head units)
# The brightest a preview panel's own floor may be lit, on its strongest channel. Set just
# under the performer's own lit coat (measured 0.42) so the boards can never out-shine the
# figure standing on them - see draw_preview_floor, where the lift is a multiplier and the
# pale-floored houses would otherwise carry it past this on their own.
const PV_FLOOR_MAX := 0.38
const PV_ARC := 99.3          # peak px of a height-1.0 throw: BASE_AIR * ARC_PER_AIR, scaled
const PV_TIME := 1.15         # seconds a height-1.0 throw hangs. Real time is 0.7s; the
                              # preview runs ~1.6x slow so the shape is readable (Louis)
const PV_CARRY := 0.30        # seconds a hand carries a caught prop to its launch point
const PV_LANE := 39.6         # Columns' OUTER lane at preview scale. The preview runs the
							   # pattern at three objects, where columns_x puts the two side
							   # lanes 72px off centre and the third up the middle line, so
							   # this is that 72 x PV_K. It is a lane POSITION now, not the
							   # old fixed 44px spacing, because the spacing is a function of
							   # the count (columns_step) and 44 is only its widest value
const PV_HIGH := 1.5          # an over-the-top lob (OVER_TOP_MIN) as a multiple of a tap
const PV_SHOWER_HIGH := 1.6   # SHOWER_MIN's taller high road
const PV_FEED := 0.34         # the Shower's flat, fast feed pass (SHOWER_FEED)
const PV_BTB_DROP := 14.3     # how far below the hand line a Behind-the-Back throw
                              # releases (do_throw's +26px), at preview scale


func pv_o(hand: int) -> Vector2:
	return Vector2(-PV_OUTER if hand == LEFT else PV_OUTER, 0.0)


func pv_i(hand: int) -> Vector2:
	return Vector2(-PV_INNER if hand == LEFT else PV_INNER, 0.0)


func pv_btb(hand: int) -> Vector2:
	# Behind the Back's release point: behind the FAR hip, a touch below the hand
	# line - do_throw's own lerp(centre, inner_pos(other), 0.75) at preview scale
	return Vector2((-PV_INNER if hand == LEFT else PV_INNER) * 0.75, PV_BTB_DROP)


func pv_throw(a: Vector2, b: Vector2, hgt: float, bhd := 0.0) -> Dictionary:
	# one leg of FLIGHT: the parabola flight_pos draws, hanging in proportion to its
	# height exactly as real airtime does. `bhd` is how far into the leg the prop is
	# still hidden behind the figure (_btb_behind's own 0.35 for a behind-the-back throw).
	return {"a": a, "b": b, "h": hgt, "d": PV_TIME * maxf(hgt, 0.25), "carry": false, "bhd": bhd}


func pv_carry(a: Vector2, b: Vector2, bhd := 0.0) -> Dictionary:
	# the hand's own carry, from where it caught the prop to where its next throw
	# leaves from: a short scoop along the hand line, not a flight
	return {"a": a, "b": b, "h": 0.0, "d": PV_CARRY, "carry": true, "bhd": bhd}


func pv_cascade_legs(hgt := 1.0, bhd := 0.0) -> Array:
	# THE weave, straight off do_throw: a plain throw leaves INNER, lands OUTER, and
	# the catching hand carries it back in before its own throw
	if bhd > 0.0:
		# ...and Behind the Back replaces both the carry and the launch: the hand
		# takes the prop round the back and releases it behind the opposite hip
		return [pv_throw(pv_btb(RIGHT), pv_o(RIGHT), hgt, bhd), pv_carry(pv_o(RIGHT), pv_btb(LEFT), 1.0),
				pv_throw(pv_btb(LEFT), pv_o(LEFT), hgt, bhd), pv_carry(pv_o(LEFT), pv_btb(RIGHT), 1.0)]
	return [pv_throw(pv_i(LEFT), pv_o(RIGHT), hgt), pv_carry(pv_o(RIGHT), pv_i(RIGHT)),
			pv_throw(pv_i(RIGHT), pv_o(LEFT), hgt), pv_carry(pv_o(LEFT), pv_i(LEFT))]


# one skill's whole choreography: a list of TRACKS, each a repeating leg cycle with N
# props spread evenly around it (the trick that turns one throw-catch cycle into a
# continuous multi-prop loop - a real 3-ball cascade is one L->R/R->L cycle with three
# balls a third of a cycle apart), plus the one line of text the box captions itself with.
func skill_preview(is_trick: bool, idx: int) -> Dictionary:
	if is_trick:
		match idx:
			TR_HIGH:
				# every throw sky high - it genuinely leaves the frame, and a top-edge
				# marker tracks it while it is gone, exactly as draw_balls_in_flight does
				return {"tracks": [{"legs": pv_cascade_legs(2.7), "n": 3, "mark": true}],
						"note": "every throw leaves the frame"}
			TR_BTB:
				return {"tracks": [{"legs": pv_cascade_legs(1.12, 0.35), "n": 3, "mark": true}],
						"note": "round the back, out past the far hip"}
			TR_SPIN:
				return {"tracks": [{"legs": pv_cascade_legs(1.6), "n": 3}],
						"note": "one full turn, caught blind", "spin": true}
			_:
				# Overthrow: ONE marked prop launched up and over the pattern (an
				# over-the-top road: out of the OUTER corner, down onto the inner slot),
				# while the other two keep the weave underneath it
				return {"tracks": [{"legs": pv_cascade_legs(), "n": 2},
						{"legs": [pv_throw(pv_o(LEFT), pv_i(RIGHT), 1.95), pv_carry(pv_i(RIGHT), pv_i(RIGHT)),
								  pv_throw(pv_i(RIGHT), pv_o(LEFT), 1.0), pv_carry(pv_o(LEFT), pv_o(LEFT))],
						 "n": 1, "mark": true}],
						"note": "one throw over the top of the rest"}
	match idx:
		COLUMNS:
			# three lanes on columns_x's own spacing: each prop rides straight up and
			# down its own line (a from == to leg - the parabola alone draws the bounce),
			# and the middle lane runs half a cycle out of phase with the outer two,
			# which is what makes the pattern read as columns and not as three balls
			var lanes: Array = []
			for k in 3:
				var lx := Vector2(float(k - 1) * PV_LANE, 0.0)
				lanes.append({"legs": [pv_throw(lx, lx, 1.15), pv_carry(lx, lx)], "n": 1,
							  "phase": 0.5 if k == 1 else 0.0})
			return {"tracks": lanes, "note": "3 objects - one lane each"}
		HALFSHOWER:
			# the low leg is HALFSHOWER_LOW itself, so the picture cannot drift from the
			# cap the sim throws at: it drew 0.95 of a tap while the sim now caps that
			# road at 0.65, which is the preview drawing the very overlap the cap exists
			# to prevent
			return {"tracks": [{"legs": [pv_throw(pv_o(RIGHT), pv_o(LEFT), PV_HIGH),
									pv_carry(pv_o(LEFT), pv_i(LEFT)),
									pv_throw(pv_i(LEFT), pv_o(RIGHT), HALFSHOWER_LOW)], "n": 3}],
					"note": "right over the top, left low"}
		SHOWER:
			return {"tracks": [{"legs": [pv_throw(pv_o(RIGHT), pv_o(LEFT), PV_SHOWER_HIGH),
									pv_carry(pv_o(LEFT), pv_i(LEFT)),
									pv_throw(pv_i(LEFT), pv_o(RIGHT), PV_FEED)], "n": 3}],
					"note": "one circle, one direction"}
		RCASC:
			# both hands over the top, so both launch from OUTER and both land INNER
			# (over_top_land_slot's complement rule) - the weave runs backward
			return {"tracks": [{"legs": [pv_throw(pv_o(LEFT), pv_i(RIGHT), PV_HIGH),
									pv_carry(pv_i(RIGHT), pv_o(RIGHT)),
									pv_throw(pv_o(RIGHT), pv_i(LEFT), PV_HIGH),
									pv_carry(pv_i(LEFT), pv_o(LEFT))], "n": 3}],
					"note": "both hands over the top"}
		TENNIS:
			# THE TWO LOW PROPS ALTERNATE, AND THE DEFAULT SPREAD CANNOT MAKE THEM
			# (2026-08-15). Two props evenly spread around the cascade's own two-throw cycle
			# land exactly half a cycle apart, and half a cycle is that cycle's mirror - so
			# they were thrown together, crested together as a pair above his head, and were
			# caught together, which reads as one object cut in two rather than as a weave
			# running under the marked prop. A quarter spaces all four throws (left, right,
			# left, right) evenly instead: measured on the preview's own numbers, the second
			# prop is in the catching hand at the instant the first is at its apex. See the
			# `spread` note in draw_skill_preview.
			return {"tracks": [{"legs": pv_cascade_legs(), "n": 2, "spread": 0.25},
					{"legs": [pv_throw(pv_o(LEFT), pv_o(RIGHT), PV_HIGH),
							  pv_throw(pv_o(RIGHT), pv_o(LEFT), PV_HIGH)], "n": 1, "mark": true}],
					"note": "one marked prop over the weave"}
		_:
			# Cascade, shown at 3: the crossing weave the pattern is named for. Its
			# even-count face (each hand keeping its own circle) is the same two roads
			# without the crossing, and the detail strip below says so in words.
			return {"tracks": [{"legs": pv_cascade_legs(), "n": 3}], "note": "3 objects - the crossing weave"}


func pv_total(legs: Array) -> float:
	var total := 0.0
	for leg in legs:
		total += float(leg["d"])
	return maxf(total, 0.001)


func pv_leg_pos(leg: Dictionary, p: float) -> Vector2:
	var pos: Vector2 = Vector2(leg["a"]).lerp(Vector2(leg["b"]), p)
	if bool(leg["carry"]):
		pos.y += 7.0 * sin(p * PI)   # the hand scoops as it carries
	else:
		pos.y -= 4.0 * float(leg["h"]) * PV_ARC * p * (1.0 - p)   # flight_pos's own parabola
	return pos


func pv_state(legs: Array, tsec: float) -> Dictionary:
	# where one prop is, and whether it is currently hidden behind the figure
	var total := pv_total(legs)
	var tloop := fposmod(tsec, total)
	var acc := 0.0
	for i in legs.size():
		var leg: Dictionary = legs[i]
		var dur := float(leg["d"])
		if i == legs.size() - 1 or tloop < acc + dur:
			var p := clampf((tloop - acc) / dur, 0.0, 1.0)
			# `carry` IS THE WHOLE POINT OF REPORTING THE LEG. A carry leg is the stretch a
			# prop spends IN A HAND, so it is the only thing that can tell the preview's
			# figure which hand is holding what - and without it the hands were guessed from
			# "is any prop within 34px of the hand line", which is true for none of them
			# through most of a cascade.
			return {"pos": pv_leg_pos(leg, p), "behind": p < float(leg["bhd"]),
					"carry": bool(leg["carry"]), "from": Vector2(leg["a"]), "to": Vector2(leg["b"])}
		acc += dur
	return {"pos": Vector2.ZERO, "behind": false, "carry": false,
			"from": Vector2.ZERO, "to": Vector2.ZERO}


func draw_mini_juggler(o: Vector2, hl: Vector2, hr: Vector2, turn: float, k: float = 1.0) -> void:
	# THE SAME PERFORMER AS THE STAGE, and now literally so (2026-08-06, Louis: "make sure
	# that the character ... look the same everywhere in the game, from titlescreen to
	# shop, to performance"). This function used to carry its own copy of the body - its
	# own jacket polygon, its own legs, its own arms, its own hands - and that copy was
	# never moved onto the sprite seam when draw_juggler was. The tailor's mirror and the
	# skills preview were therefore showing a smooth vector man with ball hands, next to a
	# stage showing a shaded pixel-art one, and the mirror is the one screen in the game
	# that exists purely to show you what you look like.
	#
	# What is left here is the three things that genuinely are this caller's business: how
	# big the figure is, where its hands are, and the Spin streaks. Everything else is
	# draw_figure_body, draw_arm and draw_mitt - the stage's own. draw_mini_arm went with
	# it: an arm at "preview scale" was a second set of limb widths for one body.
	#
	# `k` IS NOW A REQUEST, NOT A SCALE. See fig_scale_H: the body is per-region sprites,
	# and a sprite fitted to a box 1.148x its authored size draws some rows two screen
	# pixels tall and some three. The tailor solved exactly that k out of its panel
	# height. So the wanted size is snapped to a whole multiple of the stage figure, and
	# the layout gives a little instead of the art.
	# THE PAINTED PERFORMER GETS HALF SCALE HERE, and the layout is built from HIS height
	# rather than from the traced figure's head unit: those two are not the same man and the
	# preview was sized for the wrong one. fig_preview_px is 1 screen px per art px - exact,
	# lossless, and about half the stage figure, which is what a panel this size can hold.
	var px := fig_preview_px()
	var H := fig_scale_H(PV_HEAD * k)
	# THE HAND LINE IS THIS CALLER'S ORIGIN (`o`), not the head - reading it as the head is
	# what once put the arms up in a V. The floor sits FIG_HAND_LINE head units below it,
	# which is PV_FLOOR/PV_HEAD written as a proportion so it survives H being snapped.
	var floor_y := fig_preview_floor(o) if fig_anim_live() else (o.y + FIG_HAND_LINE * H)
	var ys := fig_ys(o.x, floor_y, H, 0.0)
	var v := costume_palette()
	var suit: Color = v["suit"]
	var suit_dk: Color = v["suit_dk"]
	var vest: Color = v["vest"]
	var collar: Color = v["collar"]
	var accent: Color = v["glow"]
	var skin := Color(0.87, 0.64, 0.45)
	var hair := Color(0.28, 0.16, 0.11)
	var button := Color(0.34, 0.20, 0.11)
	# THE GLOWING KIT REACHES THE MIRROR TOO. It is a costume, it is the most expensive
	# thing in the shop, and it used to be visible only on stage - so the one room built
	# for trying clothes on could not show the piece most worth trying on. Same five-colour
	# ladder draw_juggler recolours with, not a second set of numbers.
	if glow_suit_lit():
		suit = Color(0.20, 0.72, 0.40)
		suit_dk = Color(0.10, 0.42, 0.24)
		vest = Color(0.78, 1.0, 0.86)
		collar = Color(0.90, 1.0, 0.94)
		accent = Color(0.70, 1.0, 0.80)
	draw_shadow(Vector2(o.x, floor_y + 2.0), 2.38 * H)   # the stage's own 96px, in head units

	# a turn scales the body width by cos about the centreline, exactly as a live Spin
	# does on stage; the head and hat are drawn outside it by draw_figure_body itself.
	var sx := 1.0
	var facing_back := false
	# THE PREVIEW TURNS THE SAME WAY THE STAGE DOES. The Skills screen's Spin card is the
	# one place a player studies the trick before ever pressing the key, so a squashed
	# preview beside a painted stage turn would be teaching the wrong move. It cannot share
	# fig_spin_turn(): this figure has its own little clock (`turn`), which is exactly the
	# separation the preview's whole simulation exists for - so the frame is picked from
	# THAT, and only the frame picker is shared.
	var painted_turn := turn > 0.0 and fig_design_on() and fig_spin_on()
	if painted_turn:
		draw_figure_spin(o.x, floor_y, venue_figure_tint(), px, turn)
	elif turn > 0.0:
		sx = cos(turn * TAU)
		facing_back = sx < 0.0
		if absf(sx) < 0.16:
			sx = 0.16 if sx >= 0.0 else -0.16
		draw_set_transform(Vector2(o.x * (1.0 - sx), 0.0), 0.0, Vector2(sx, 1.0))

	# the arms answer THIS preview's hands, in the painted figure's own art pixels
	var wl := absf(hl.x - o.x) / px
	var wr := absf(hr.x - o.x) / px
	# A PAINTED TURN HAS ALREADY DRAWN THE WHOLE MAN, so the body and the arms below are
	# skipped rather than drawn over it. This is not only tidiness: draw_figure_body's own
	# spin branch reads fig_spin_turn(), which is the STAGE's clock, and this preview runs
	# on its own `turn`. Letting the call through would have the mirror show whatever the
	# live act is doing - usually nothing, so a frozen front view under moving streaks.
	if not painted_turn:
		draw_figure_body(o.x, H, ys,
			{"suit": suit, "suit_dk": suit_dk, "vest": vest, "collar": collar,
				"accent": accent, "skin": skin, "hair": hair, "button": button},
			facing_back, turn > 0.0, sx, Vector2.ZERO, px, wl, wr)
	if turn > 0.0 and not painted_turn:
		draw_set_transform(Vector2(o.x * (1.0 - sx), 0.0), 0.0, Vector2(sx, 1.0))
	# the stage's own arms and hands: draw_capsule_pix limbs shaded across their width, the
	# traced mitt, the real glove. `close` is 0 - a figure at rest holds its hands open,
	# which is also the pose that shows a glove best, and showing one is why this exists.
	# THE MIRROR SHOWS THE ANIMATED FIGURE TOO, arms and all. draw_figure_body has already
	# blitted a frame of the juggling strip, which carries its own painted arms - so drawing
	# the IK pair over it would put the very sausages Louis asked to be rid of back on the
	# one screen built for looking closely at him. There is nothing to add here at all.
	if not fig_anim_live() and not painted_turn:
		var pv_sleeve := fig_design_col("sleeve", suit) if fig_design_on() else suit
		var pv_cuff := fig_design_col("cuff", collar) if fig_design_on() else collar
		draw_arm(fig_shoulder(o.x, floor_y, H, LEFT, px), hl, LEFT, skin, pv_sleeve, pv_cuff)
		draw_arm(fig_shoulder(o.x, floor_y, H, RIGHT, px), hr, RIGHT, skin, pv_sleeve, pv_cuff)
		draw_mitt(hl, 0.0, 1.0)
		draw_mitt(hr, 0.0, -1.0)
	if turn > 0.0:
		draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
		# the same sweeping streaks the real Spin lays over the turn, so the little
		# figure reads as MOVING rather than as a squashed one
		var mid := Vector2(o.x, (float(ys["shoulder"]) + float(ys["hip"])) * 0.5)
		for si in 3:
			var rr := (16.0 + float(si) * 7.0) * k
			var a0 := turn * TAU + float(si) * 0.6
			draw_arc(mid, rr, a0, a0 + 1.5, 10, Color(1.0, 0.9, 0.65, 0.16), 1.6, true)


func draw_skill_preview(font: Font, box: Rect2, is_trick: bool, idx: int, ename: String,
		caption: bool = true) -> void:
	# the preview box: a little stage, the roads, the figure, the props. Everything is
	# bounded to `inner` by construction - the standing no-overflow rule applies to
	# drawings, not only to text.
	var data := skill_preview(is_trick, idx)
	var tracks: Array = data["tracks"]
	var v := venue_data(cur_venue())
	var glow: Color = v["glow"]
	# no top sheen on this one: soft_card's sheen ends in a straight horizontal cut
	# across the top 42%, which reads as a seam in the sky rather than as gloss
	soft_card(box, Color(0.075, 0.05, 0.055, 0.97), Color(0.9, 0.6, 0.35, 0.34), 1.0, 12.0, 14.0)
	var inner := Rect2(box.position + Vector2(9.0, 9.0), box.size - Vector2(18.0, 18.0))
	# THE HAND LINE, placed per skill rather than at a fixed height: a Cascade's arcs
	# crest just above the head and a Reverse Cascade's twice that, so one fixed baseline
	# either strands a low pattern in the bottom third of the box or pushes a high one
	# through the ceiling. The scene is measured (tallest arc + the figure below the
	# hands) and centred in whatever room is left, then clamped so the feet always stand
	# on the floor - a throw too tall to fit (a High Toss) is then EXACTLY the one that
	# leaves the frame, which is what that trick does anyway.
	var ceil_y := inner.position.y + 30.0
	var peak := 0.0
	for tr0 in tracks:
		for leg0 in tracks_legs(tr0):
			peak = maxf(peak, float(leg0["h"]) * PV_ARC)
	# ...measured with the FIGURE'S own hand-to-foot drop rather than PV_FLOOR, so the floor this
	# panel draws is the floor he is standing on. See fig_preview_drop: PV_FLOOR describes the
	# traced juggler, and the painted showman's boots sat 5px below the line drawn for them.
	var drop := fig_preview_drop()
	var room := inner.position.y + inner.size.y - ceil_y
	var slack := maxf(room - (peak + 7.0 + drop), 0.0)
	var o := Vector2(box.position.x + box.size.x * 0.5,
		clampf(ceil_y + peak + 7.0 + slack * 0.62, ceil_y, inner.position.y + inner.size.y - drop - 6.0))
	var fy := o.y + drop

	# the stage itself: a warm pool on the floor and a lit floor lip.
	#
	# THE CONE IS GONE (2026-08-13, and it is the same note Louis gave about the trick cards:
	# "just the image not the light from above"). It was a draw_colored_polygon triangle from
	# the top of the panel to the floor at alpha 0.05, which over a panel this dark does not
	# read as light at all - it reads as a hard-edged grey wedge behind the performer, with two
	# visible straight diagonals crossing the roads. The pool below him does the whole job of
	# saying "he is lit" without drawing a shape.
	draw_glow(Vector2(o.x, fy), box.size.x * 0.34, Color(glow.r, glow.g, glow.b, 0.16))
	# ...and the lip is WARM rather than the venue's glow. At a cold house (the Championship
	# is a blue-white room) that line came out pale blue - the one cold element on a panel of
	# crimson and gold, drawn straight across the middle of it.
	draw_preview_floor(inner, fy, Color(1.0, 0.78, 0.42))

	# THE ROADS: every leg's own parabola, drawn faint and behind everything, so the
	# pattern's SHAPE is legible in a still frame and not only in motion
	# ...inside the same ceiling the props respect, so no road ever runs through the
	# box's own caption line
	var road_box := Rect2(inner.position + Vector2(0.0, 30.0), inner.size - Vector2(0.0, 30.0))
	for tr in tracks:
		var road_c := Color(1.0, 0.86, 0.5, 0.30) if bool(tr.get("mark", false)) else Color(1.0, 0.82, 0.6, 0.16)
		for leg in tracks_legs(tr):
			if bool(leg["carry"]):
				continue
			# A ROAD IS A DOTTED TRAIL, NOT A LINE (2026-08-13). Drawn continuous it was a
			# 1.8px stroke running from the hand line up over the head, and the props sit at
			# the apexes of those strokes - so every ball read as the head of a lollipop and
			# the whole panel looked like three balls on wires rather than three in the air.
			# The same samples, drawn as separated dots, say "this is where it travels"
			# without ever drawing something that could be mistaken for a physical object.
			for k in 25:
				var p := o + pv_leg_pos(leg, float(k) / 24.0)
				if not road_box.has_point(p):
					continue
				# a road climbing out of the box FADES rather than stopping dead at
				# the ceiling: four hard-cut tall arcs (a High Toss) read as strings
				var a := clampf((p.y - ceil_y) / 46.0, 0.0, 1.0)
				if a <= 0.02:
					continue
				fill_disc_pix(p, 1.0, Color(road_c.r, road_c.g, road_c.b, road_c.a * a * 1.5),
					fig_preview_px())

	# where every prop is this instant
	var t := atick() / 120.0
	var props: Array = []
	var ci := 0
	for tr in tracks:
		var legs: Array = tracks_legs(tr)
		var n := int(tr["n"])
		var total := pv_total(legs)
		var marked := bool(tr.get("mark", false))
		var ph := float(tr.get("phase", 0.0))
		# HOW FAR APART CONSECUTIVE PROPS SIT ON THIS TRACK, as a fraction of the cycle.
		# `1/n` (spread them evenly) is right for three props and DEGENERATE for two: a
		# cascade cycle is two throws, so half a cycle is the pattern's own mirror, and two
		# props half a cycle apart are reflections of each other at every instant - they
		# leave together, peak together side by side above his head, and land together.
		# That is not a weave, it is a synchronous fountain, and it is what Tennis's low
		# pair had always drawn (Louis, 2026-08-15: "the tennis animation in the trick menu
		# should alternate his lower throws"). Four throws evenly spaced around a two-throw
		# cycle are a QUARTER apart, and at a quarter one prop is in the air while the other
		# is in the hand that just caught it - see TENNIS in skill_preview.
		var spread := float(tr.get("spread", 1.0 / float(n)))
		for i in n:
			var st := pv_state(legs, t + total * (ph + float(i) * spread))
			props.append({"pos": o + Vector2(st["pos"]), "col": ball_color(ci),
						  "behind": bool(st["behind"]), "mark": marked,
						  "carry": bool(st.get("carry", false)),
						  "from": Vector2(st.get("from", Vector2.ZERO))})
			ci += 1

	# THE HANDS ARE DRIVEN BY THE CARRY LEGS, not guessed from proximity (2026-08-13).
	#
	# What was here took "the nearest prop within 34px of the hand line, on this side, not
	# behind the body" and put the hand on it - and for most of a cascade that set is EMPTY,
	# because the props spend most of their loop in the air well above the hand line. So both
	# hands fell through to their default outer slot and stayed there: a symmetric, level,
	# palms-open T-pose, held while three balls sailed past it. Louis's "fix the players
	# juggling for each trick" is exactly this - the figure was not juggling at all, it was
	# standing still behind a pattern that happened to be animating.
	#
	# A CARRY LEG IS THE PROP IN THE HAND. It runs from the catch point to the throw point and
	# is the pattern's own statement of when a hand is holding something, so a hand placed on
	# its carried prop is right by construction, for every pattern and every trick, including
	# the ones whose carry dips below the hand line (Behind the Back) or rides a lane at dead
	# centre (Columns). Nothing here needs to know which pattern it is drawing.
	var hp := [o + Vector2(-PV_OUTER, 0.0), o + Vector2(PV_OUTER, 0.0)]
	var held := [false, false]
	for pr in props:
		if not bool(pr.get("carry", false)):
			continue
		var p: Vector2 = pr["pos"]
		# THE SIDE COMES FROM THE LEG'S OWN START, not from where the prop is this instant. A
		# carry crosses toward the centre and a Behind-the-Back one crosses past it, so reading
		# the live x hands the prop to the wrong arm halfway through every carry - which is a
		# hand that jumps across the body and back once per prop per loop.
		var h := LEFT if float(pr.get("from", Vector2.ZERO).x) < 0.0 else RIGHT
		if held[h]:
			continue
		held[h] = true
		hp[h] = p
	# a hand with nothing in it is on its way back out to meet the next catch, so it sits at
	# the outer slot - which is where it always sat, but now that is a STATE rather than the
	# only thing that ever happened.
	for pr in props:
		if bool(pr["behind"]) or bool(pr.get("carry", false)):
			continue
		var p2: Vector2 = pr["pos"]
		var dy := absf(p2.y - o.y)
		if dy > 22.0 or absf(p2.x - o.x) < 9.0:
			continue   # ...and never Columns' MIDDLE lane: that prop rests at stage
					   # centre, over the hip, and belongs to neither hand's reach
		var h2 := LEFT if p2.x < o.x else RIGHT
		if not held[h2]:
			# a prop about to land: the hand rises to meet it rather than waiting flat
			hp[h2] = Vector2(p2.x, o.y + clampf(p2.y - o.y, -10.0, 8.0))

	var spin := bool(data.get("spin", false))
	var turn := 0.0
	if spin:
		# one full turn per loop, held facing front either side of it, so the preview
		# reads as "a turn happens here" rather than as a body that never stops spinning
		var cyc := fposmod(t * 0.34, 1.0)
		turn = clampf((cyc - 0.2) / 0.45, 0.0, 1.0)
	for pr in props:
		if bool(pr["behind"]):
			pv_draw_prop(pr, inner)
	draw_mini_juggler(o, hp[LEFT], hp[RIGHT], turn)
	# A CARRIED PROP FOLLOWS THE PAINTED PALM, exactly as it does on stage (fig_hand_pos).
	# The arm bank only holds the reaches it holds, so the arm drawn for a wanted reach puts
	# its palm a pixel or two off the simulated hand - and at this size a ball floating two
	# pixels outside the fingers is the difference between holding it and not. Done AFTER
	# draw_mini_juggler because that is what chose the arm; asking before it would be asking
	# about a pose that had not been picked yet.
	if fig_anim_live() and not spin:
		var ppx := fig_preview_px()
		for pr in props:
			if not bool(pr.get("carry", false)):
				continue
			var hh := LEFT if float(pr.get("from", Vector2.ZERO).x) < 0.0 else RIGHT
			var sim: Vector2 = hp[hh]
			var palm := fig_preview_palm(o, hh, absf(sim.x - o.x) / ppx)
			if palm.x < INF and palm.distance_to(sim) <= FIG_PALM_MAX * ppx:
				pr["pos"] = palm
	for pr in props:
		if not bool(pr["behind"]):
			pv_draw_prop(pr, inner)

	# the caption: what this picture IS. Both halves go through draw_fit_string, since
	# both are DATA (a skill name, a per-skill note) - see the no-overflow rule.
	# SUPPRESSED on a short box (the unlock card): the caption sits at a fixed 16px from
	# the top, which on the Skills screen is clear sky above the figure but on the card's
	# shorter art ran straight across his head - the words fit their width perfectly and
	# were still unreadable, because overflow is not the only way text can collide. The
	# card names the skill underneath in 27pt anyway, so this would only repeat it.
	if not caption:
		return
	# TWO LINES, NOT TWO COLUMNS. Side by side each half got inner.size.x * 0.5 and the note
	# is a sentence - "round the back, out past the free hand" - so it shrank to its floor and
	# then TRUNCATED, which is the no-overflow rule being satisfied by cutting the words off.
	# There is clear sky here (the figure's head starts a hundred pixels down), so the note
	# takes its own line at the full width and fits whole.
	var head_w := inner.size.x - 24.0
	draw_fit_string(font, inner.position + Vector2(6.0, 16.0), ename.to_upper(),
		HORIZONTAL_ALIGNMENT_LEFT, head_w, 14, Color(1.0, 0.88, 0.58))
	draw_fit_string(font, inner.position + Vector2(6.0, 32.0), String(data["note"]),
		HORIZONTAL_ALIGNMENT_LEFT, head_w, 12, Color(0.78, 0.72, 0.62))


func tracks_legs(tr: Dictionary) -> Array:
	return tr["legs"]


func pv_draw_prop(pr: Dictionary, inner: Rect2) -> void:
	# one prop, and the guarantee that it never draws outside its own box: a prop on
	# its way out of the frame FADES over the last stretch and hands over to a marker
	# on the top edge (what draw_balls_in_flight does for a real High Toss), rather
	# than being clipped mid-shape or clamped into a pile against the border.
	var p: Vector2 = pr["pos"]
	var col: Color = pr["col"]
	var r := 6.5
	# the ceiling sits BELOW the caption line, so a prop on its way out never collides
	# with the box's own lettering on the way
	var ceil_y := inner.position.y + 30.0
	if p.y < ceil_y:
		var mx := clampf(p.x, inner.position.x + 10.0, inner.position.x + inner.size.x - 10.0)
		var my := ceil_y - 6.0
		draw_colored_polygon(PackedVector2Array([Vector2(mx, my - 5.0), Vector2(mx + 5.0, my + 3.0),
			Vector2(mx - 5.0, my + 3.0)]), Color(col.r, col.g, col.b, 0.75))
		return
	if p.x < inner.position.x + r or p.x > inner.position.x + inner.size.x - r:
		return
	var fade := clampf((p.y - ceil_y) / 26.0, 0.0, 1.0)
	# ON THE ART GRID, all of it. These were draw_circle and draw_arc - antialiased vector
	# shapes, in the one panel on the Skills screen whose whole job is to show the player what
	# the game looks like. Beside a figure made of hard 1px art they read as soft bubbles.
	# ...at the PREVIEW's grid, not the stage's - see fill_disc_pix's `grid`.
	var gp := fig_preview_px()
	if bool(pr["mark"]):
		# the same warm ring the sim puts on a trick throw
		draw_ring_pix(p, r + 3.5, 1.6, Color(1.0, 0.86, 0.5, 0.45 * fade), gp)
	draw_glow_pix(p, r + 5.0, Color(col.r, col.g, col.b, 0.22 * fade), gp)
	# A RIM, so the ball reads against ITSELF - not just against the backdrop (2026-07-31,
	# found while checking Columns: its middle lane rides the dead centreline, which is
	# exactly where the vest's own buttons sit, and a mid-tone ball that size in that spot
	# was reading as a fourth button, not a third object). A stroke this size costs nothing
	# on the two outer lanes, which never had the problem, and fixes the one that did
	# without special-casing Columns at all.
	draw_ring_pix(p, r + 1.0, 1.0, Color(0.05, 0.03, 0.03, 0.55 * fade), gp)
	fill_disc_pix(p, r, Color(col.r, col.g, col.b, fade), gp)
	var hi := col.lightened(0.4)
	fill_disc_pix(p + Vector2(-2.0, -2.0), 2.0, Color(hi.r, hi.g, hi.b, 0.9 * fade), gp)


func draw_skills(font: Font, s: Vector2) -> void:
	# the Skills reference: every trick and pattern, whether it is yours yet, and
	# the exact keys that pull it off. This is where the trimmed unlock toast now
	# sends the player to learn the how, so a live run is never buried in text.
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.04, 0.02, 0.03, 0.86))
	# three zones now (2026-07-27): TRICKS, PATTERNS, and a PREVIEW that is always
	# showing - the old layout had two half-width lists and tucked a small preview box
	# into the leftover space under the shorter one, which meant a TRICK had no preview
	# at all and a pattern's was 176x130. The panel widened to the shop's own 1120 to
	# pay for it, so no list lost a pixel.
	var pw := minf(1120.0, s.x - 60.0)
	var ph := minf(684.0, s.y - 24.0)
	var px := s.x * 0.5 - pw * 0.5
	var py := s.y * 0.5 - ph * 0.5
	soft_card(Rect2(px, py, pw, ph), Color(0.12, 0.07, 0.08, 0.98), Color(0.9, 0.6, 0.35, 0.5), 2.0, 16.0, 22.0)

	var kc_use := k_trick()[0]
	var kc_sel := k_cycle()[0]
	draw_string(title_font(), Vector2(px + 40.0, py + 50.0), "SKILLS", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(30), Color(1.0, 0.86, 0.55))
	draw_string(font, Vector2(px + 40.0, py + 84.0), "%s cycles which skill is loaded   -   %s uses it   -   patterns switch with P while you practise" % [kc_sel, kc_use], HORIZONTAL_ALIGNMENT_LEFT, -1, ps(13), Color(0.82, 0.75, 0.64))
	draw_string(font, Vector2(px + pw - 210.0, py + 50.0), "Level %d" % level, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(18), Color(1.0, 0.9, 0.6))
	# a plain hairline (the same quiet divider draw_results uses between its own
	# sections) so TRICKS / PATTERNS reads as a new section, not a third line of
	# the same paragraph the title started
	draw_line(Vector2(px + 40.0, py + 100.0), Vector2(px + pw - 40.0, py + 100.0), Color(0.9, 0.6, 0.35, 0.3), 1.0)

	# THE LISTS GIVE UP WIDTH THEY WERE NOT USING, so the card has somewhere to be
	# (2026-07-28 evening, Louis: "you should show the trick and pattern cards in the trick
	# and pattern menu"). The two columns were 268px each to hold names like "Reverse
	# Cascade" - which measures 132 - so nearly half of each was empty air. At 196 they still
	# fit the longest name with room for its badge, and the 176px they release is what turns
	# the preview zone into a zone that can hold a CARD and the choreography side by side.
	var nt := TRICKS.size()
	var col_l := px + 40.0
	var col_r := px + 258.0
	var colw := 196.0
	var row_h := 46.0
	var header_y := py + 136.0
	var y0 := header_y + 42.0
	# the headers sit well ABOVE the first row so the selection highlight (which
	# reaches ~23px above a row's baseline) never touches the TRICKS / PATTERNS label
	draw_string(font, Vector2(col_l, header_y), "TRICKS", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(15), Color(0.95, 0.8, 0.55, 0.9))
	draw_string(font, Vector2(col_r, header_y), "PATTERNS", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(15), Color(0.95, 0.8, 0.55, 0.9))
	for i in nt:
		var td: Dictionary = TRICKS[i]
		_skills_row(font, col_l, y0 + float(i) * row_h, colw, String(td["name"]), td, trick_unlocked(i), i == skills_sel)
	# patterns list in UNLOCK order (pattern_order), not raw array order: the raw
	# indices are frozen for old saves, so the tidy career ladder is sorted here
	var pord := pattern_order()
	for j in pord.size():
		var pd: Dictionary = PATTERNS[pord[j]]
		_skills_row(font, col_r, y0 + float(j) * row_h, colw, String(pd["name"]), pd, pattern_unlocked(pord[j]), (nt + j) == skills_sel)

	# the detail strip: the selected entry explained, with its exact controls
	var ename := ""
	var how := ""
	var desc := ""
	var req_line := ""
	var is_unlocked := true
	if skills_sel < nt:
		var td2: Dictionary = TRICKS[skills_sel]
		ename = String(td2["name"])
		desc = String(td2["desc"])
		req_line = skill_req_text(td2)
		is_unlocked = trick_unlocked(skills_sel)
		match String(td2["kind"]):
			"live":
				how = "%s loads it, then %s spins while %d or more are airborne. Catches score double while you spin blind." % [kc_sel, kc_use, int(td2["min_air"])]
			"toggle":
				how = "%s loads it, then %s switches it on, %s again switches it off. It reshapes every throw between." % [kc_sel, kc_use, kc_use]
			_:
				how = "%s loads it, then %s powers your NEXT throw. One press, one trick." % [kc_sel, kc_use]
	else:
		var pi2: int = pattern_order()[skills_sel - nt]
		var pd2: Dictionary = PATTERNS[pi2]
		ename = String(pd2["name"])
		desc = String(pd2["desc"])
		req_line = skill_req_text(pd2)
		is_unlocked = pattern_unlocked(pi2)
		how = "In practice, press P to switch patterns. This pattern multiplies a whole clean run by x%.2f, and the run itself is raised to the power of your load - %d %s is an exponent of %.1f right now." % [float(pd2["mult"]), num_balls, String(cur_prop()["name"]).to_lower(), float(num_balls) * prop_sig()]
		if pi2 == CASCADE:
			# true only of Cascade itself - this used to print unconditionally on
			# every pattern's card, so Columns/Tennis/etc. all falsely claimed it too
			how += " Cascade also changes shape with the ball count: crossing odd, same-hand even."

	# THE PREVIEW, third zone: whatever is selected, trick or pattern, running its own
	# choreography on a little stage of its own (see draw_skill_preview). Never empty.
	# THE CARD SITS BESIDE THE CHOREOGRAPHY, and the two are doing different jobs on purpose.
	# The card is the OBJECT you were dealt - the pun, the frame, the thing you would
	# recognise across a room - and until now it was only ever seen for the few seconds of
	# its own unlock, which is a lot of drawing for a moment that passes. The preview is the
	# DIAGRAM: the skill's real roads, off the sim's own numbers. Showing them together is
	# what makes this screen a hand of cards you can also read.
	var prev_x := px + 476.0
	var zone_w := px + pw - 40.0 - prev_x
	draw_string(font, Vector2(prev_x, header_y),
		"YOUR CARD" if is_unlocked else "NOT YET YOURS", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(15), Color(0.95, 0.8, 0.55, 0.9))
	var card_w := 232.0
	var card_h := 330.0
	var card_r := Rect2(prev_x, py + 152.0, card_w, card_h)
	var prev_box := Rect2(prev_x + card_w + 22.0, py + 152.0, zone_w - card_w - 22.0, 356.0)
	if is_unlocked:
		var is_tr := skills_sel < nt
		var sidx := skills_sel if is_tr else int(pattern_order()[skills_sel - nt])
		draw_card_frame(card_r, is_tr, 1.0)
		draw_skill_card_art(Rect2(card_r.position.x + 12.0, card_r.position.y + 26.0,
			card_w - 24.0, card_h - 74.0), is_tr, sidx, 1.0)
		var cnm := ename.to_upper()
		# the name gives the two corner indices their room (CARD_PIP_KEEP) and SHRINKS into what
		# is left rather than trimming, since a skill's name is the one thing this card says
		var nmw := card_w - 20.0 - (CARD_PIP_KEEP if exp_on("card_v2") else 0.0)
		draw_string(title_font(), Vector2(card_r.position.x + 10.0 + (card_w - 20.0 - nmw) * 0.5,
			card_r.position.y + card_h - 20.0), cnm, HORIZONTAL_ALIGNMENT_CENTER, nmw,
			ps(fit_size(title_font(), cnm, nmw - 6.0, 20, 10)), Color(1.0, 0.96, 0.86))
		draw_string(font, Vector2(prev_box.position.x, header_y), "HOW IT MOVES",
			HORIZONTAL_ALIGNMENT_LEFT, -1, ps(15), Color(0.95, 0.8, 0.55, 0.9))
		draw_skill_preview(font, prev_box, is_tr, sidx, ename)
	else:
		# THE CARD, FACE DOWN, IN THE SAME SLOT THE FACE USES. The preview is the one place on
		# this screen that could still have shown a locked pattern's whole road - it draws
		# the real choreography off the sim - so it shows the back of the card instead. Same
		# rect as the owned card so nothing moves when a skill is finally dealt: the picture
		# on the card changes and everything around it stays exactly where it was.
		draw_skill_card_back(card_r, skills_sel < nt, 1.0)
		draw_string(font, Vector2(card_r.position.x, card_r.position.y + card_h + 30.0),
			"not dealt yet", HORIZONTAL_ALIGNMENT_CENTER, card_w, ps(13), Color(0.78, 0.72, 0.64))

	# ...AND THE PROSE GOES TOO. Hiding the name while leaving its "how" and "desc" in the
	# box below would be the same spoiler with the label filed off: "In practice, press P to
	# switch patterns. Score multiplier x1.50" names Tennis to anyone who has read the
	# table once. A locked entry says what the SYSTEM is instead, which is the one thing a
	# player genuinely needs to know before they own anything.
	if not is_unlocked:
		how = "Tricks and patterns are DEALT, not chosen. Clear a wall - a level, a stat, a stage, a run of acts - and a card comes with it, face down."
		desc = "It is always one you do not already have, and every one left has the same chance. Turn it over to find out which."
		req_line = ""
	var how_w := pw - 92.0
	# the card is sized to what "how" and "desc" actually need (up to 2 lines each),
	# not a fixed guess - a pattern's "how" is one sentence longer than a trick's and
	# used to clip mid-word against a box sized for the shorter case. It is anchored
	# to its BOTTOM (a fixed gap above the footer) and grows upward, so a taller box
	# never encroaches on the footer no matter how much "how" needed to wrap.
	# measured with NO line cap (-1): a 2-line cap silently dropped a third line on the
	# longest entries, which is the same clip the comment above says was fixed once
	var how_h := font.get_multiline_string_size(how, HORIZONTAL_ALIGNMENT_LEFT, how_w, ps(13), -1).y
	var desc_h := font.get_multiline_string_size(desc, HORIZONTAL_ALIGNMENT_LEFT, how_w, ps(13), -1).y
	var box_h := 30.0 + how_h + 8.0 + desc_h + 12.0
	var box_bottom := py + ph - 44.0
	var box_top := box_bottom - box_h
	var dy := box_top + 6.0
	draw_rect(Rect2(px + 30.0, box_top, pw - 60.0, box_h), Color(0.08, 0.05, 0.06, 0.7))
	draw_rect(Rect2(px + 30.0, box_top, pw - 60.0, box_h), Color(0.9, 0.6, 0.35, 0.28), false, 1.0)
	draw_fit_string(font, Vector2(px + 46.0, dy + 18.0),
		ename.to_upper() if is_unlocked else ("AN UNDEALT TRICK" if skills_sel < nt else "AN UNDEALT PATTERN"),
		HORIZONTAL_ALIGNMENT_LEFT, pw - 560.0 if not is_unlocked else pw - 92.0, 19,
		Color(1.0, 0.88, 0.55) if is_unlocked else Color(0.72, 0.62, 0.55))
	if not is_unlocked:
		# HOW MANY ARE LEFT, not which. The old line printed this skill's exact wall, which
		# is both a spoiler and, since the deal is random now, untrue - crossing that wall
		# will hand you A card, not THIS one. The honest number is the count outstanding,
		# and it is right-aligned so it never collides with the name on the left.
		var left_n := skill_pool(skills_sel < nt).size()
		draw_string(font, Vector2(px + pw - 490.0, dy + 18.0),
			"%d %s still to be dealt" % [left_n, "trick" if left_n == 1 else "tricks"] if skills_sel < nt \
				else "%d %s still to be dealt" % [left_n, "pattern" if left_n == 1 else "patterns"],
			HORIZONTAL_ALIGNMENT_RIGHT, 444.0, ps(13), Color(0.85, 0.62, 0.5))
	# "how" (a pattern's own version can run to two sentences) wraps instead of clipping mid-word,
	# and "desc" is placed BELOW however tall "how" actually rendered, not at a fixed
	# offset, so the two never overlap regardless of how much "how" needed to wrap
	draw_multiline_string(font, Vector2(px + 46.0, dy + 42.0), how, HORIZONTAL_ALIGNMENT_LEFT, how_w, ps(13), -1, Color(0.9, 0.82, 0.66))
	draw_multiline_string(font, Vector2(px + 46.0, dy + 42.0 + how_h + 8.0), desc, HORIZONTAL_ALIGNMENT_LEFT, how_w, ps(13), -1, Color(0.78, 0.72, 0.64))

	var foot := "arrows browse      Enter  practise this skill      Esc to leave"
	if not is_unlocked:
		foot = "arrows browse      Esc to leave      (this one is still locked)"
	draw_string(font, Vector2(px, py + ph - 22.0), foot, HORIZONTAL_ALIGNMENT_CENTER, pw, ps(13), Color(0.74, 0.68, 0.6))


# -----------------------------------------------------------------------------
# Menu, save-slot, settings, and misc screens.
# -----------------------------------------------------------------------------

#endregion

#region DAY HUB SCREEN
func draw_day(font: Font, s: Vector2) -> void:
	# the day hub: the chosen venue's exterior breathes behind a veil while the
	# day's ledger and actions sit over it. The world is where you will play
	# tonight, which makes choosing a stage feel like standing in front of it.
	ext_center = true    # the stage's picture is the hub's centrepiece
	draw_venue_exterior(s, play_venue())
	ext_center = false
	# the hub darkens as the day's segments burn: DAY is open, NIGHT draws in,
	# DEEP NIGHT is nearly black and plainly the moment to sleep. seg_used runs
	# 0..SEG_PER_DAY (4 values for 3 named phases, see seg_name): the 4th entry
	# is "all segments spent", which just repeats DEEP NIGHT's darkness rather
	# than going darker still - there is nowhere further for the hub to dim to.
	var seg_dark: float = [0.0, 0.16, 0.32, 0.32][clampi(seg_used, 0, 3)]
	if seg_dark > 0.0:
		draw_rect(Rect2(0, 0, s.x, s.y), Color(0.01, 0.01, 0.04, seg_dark))
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.03, 0.02, 0.03, 0.52))
	draw_vignette(s, 0.55)
	draw_frame(s, 22.0, Color(0.82, 0.62, 0.34, 0.5))

	# header: which day it is, and how much of it is left told two ways below -
	# the seg_name() label (daylight / night / deep night) and the hub's own
	# background darkening (seg_dark, just above); the ornament here is only the
	# plain divider used under every screen title, not a segment counter
	draw_title_glow(font, s.y * 0.055, "DAY %d" % day, 40, Color(1.0, 0.88, 0.5), s)
	# THESE TWO RIDE OVER THE VENUE PICTURE, so they are outlined, not plain (2026-07-28).
	# The header sits on the live exterior - a lit skyline, a marquee, a floodlit bowl -
	# and a lit window landing behind a word swallows it whole: caught on a Street Corner
	# hub, where a window sat exactly between "stamina" and "lasts". The DAY number was
	# already safe (draw_title_glow carries its own), and the same rule the stage's
	# popups follow applies to anything else drawn over paint that moves.
	draw_text_shout(font, Vector2(0, s.y * 0.055 + 66.0), seg_name(), HORIZONTAL_ALIGNMENT_CENTER, s.x, 17, Color(0.9, 0.8, 0.62))
	draw_ornament(s.x * 0.5, s.y * 0.055 + 86.0, 170.0, Color(0.82, 0.62, 0.34, 0.85))
	# under the clock: what actually limits the day, said plainly (Louis: it was
	# unclear when and why the day was spent)
	var limit_line := "you can work while stamina lasts"
	if too_tired():
		limit_line = "stamina is spent  -  sleep to start tomorrow"
	draw_text_shout(font, Vector2(0, s.y * 0.055 + 112.0), limit_line, HORIZONTAL_ALIGNMENT_CENTER, s.x, 13, Color(1.0, 0.7, 0.5, 0.95) if too_tired() else Color(0.78, 0.74, 0.66, 0.95))

	# the ledger card: purse, reputation, stamina, and the road to the next meal
	# bonus. It sits high on the left so the stage picture keeps the middle.
	# three stacked cards in the same language as the action column on the right, each
	# with its own accent tab and icon disc: the ledger used to be bare text on one
	# panel with a flat rectangle for a stamina bar, which read as the oldest thing on
	# the screen next to the card menus everywhere else.
	var lw := 300.0
	var lx := 40.0
	var ly := s.y * 0.175
	var sfrac := clampf(stamina / maxf(1.0, stamina_max), 0.0, 1.0)
	var scol := Color(0.55, 0.80, 0.6)
	if sfrac < STAM_LOW:
		scol = scol.lerp(Color(0.95, 0.35, 0.25), clampf((STAM_LOW - sfrac) / STAM_LOW, 0.0, 1.0))
	var to_str := MEALS_PER_STR - (meals % MEALS_PER_STR)
	var ledger := [
		{"icon": "coin", "col": Color(0.98, 0.60, 0.72), "label": "PURSE",
		 "big": "%s %s" % [commafy(money), coin_word()], "note": "%d meal%s to the next point of Strength" % [to_str, "" if to_str == 1 else "s"]},
		{"icon": "star", "col": Color(0.84, 0.72, 0.92), "label": "REPUTATION",
		 "big": commafy(reputation), "note": rep_tier()},
	]
	for i in ledger.size():
		var e: Dictionary = ledger[i]
		var r := Rect2(lx, ly + float(i) * 80.0, lw, 72.0)
		var ec: Color = e["col"]
		soft_card(r, Color(0.07, 0.045, 0.06, 0.86), Color(ec.r, ec.g, ec.b, 0.30), 1.0, 11.0, 12.0)
		draw_rect(Rect2(r.position.x + 1.0, r.position.y + 12.0, 3.0, r.size.y - 24.0), Color(ec.r, ec.g, ec.b, 0.8))
		var eic := Vector2(r.position.x + 30.0, r.position.y + 34.0)
		draw_circle(eic, 14.0, Color(ec.r, ec.g, ec.b, 0.18))
		day_icon(String(e["icon"]), eic, ec)
		draw_string(font, Vector2(r.position.x + 54.0, r.position.y + 23.0), String(e["label"]), HORIZONTAL_ALIGNMENT_LEFT, lw - 68.0, ps(11), Color(0.74, 0.70, 0.64, 0.9))
		draw_fit_string(font, Vector2(r.position.x + 54.0, r.position.y + 45.0), String(e["big"]), HORIZONTAL_ALIGNMENT_LEFT, lw - 130.0, 18, ec)
		draw_fit_string(font, Vector2(r.position.x + 54.0, r.position.y + 62.0), String(e["note"]), HORIZONTAL_ALIGNMENT_LEFT, lw - 68.0, 11, Color(0.74, 0.70, 0.64, 0.9))
	var sr := Rect2(lx, ly + 160.0, lw, 72.0)
	soft_card(sr, Color(0.07, 0.045, 0.06, 0.86), Color(scol.r, scol.g, scol.b, 0.30), 1.0, 11.0, 12.0)
	draw_rect(Rect2(sr.position.x + 1.0, sr.position.y + 12.0, 3.0, sr.size.y - 24.0), Color(scol.r, scol.g, scol.b, 0.8))
	draw_string(font, Vector2(sr.position.x + 18.0, sr.position.y + 24.0), "STAMINA", HORIZONTAL_ALIGNMENT_LEFT, 120.0, ps(11), Color(0.80, 0.84, 0.80, 0.9))
	draw_string(font, Vector2(sr.position.x + lw - 108.0, sr.position.y + 24.0), "%d / %d" % [int(round(stamina)), int(stamina_max)], HORIZONTAL_ALIGNMENT_RIGHT, 90.0, ps(11), Color(0.80, 0.84, 0.80, 0.9))
	draw_meter(sr.position.x + 18.0, sr.position.y + 32.0, lw - 36.0, 12.0, sfrac, scol)
	draw_string(font, Vector2(sr.position.x + 18.0, sr.position.y + 62.0),
		"worn out  -  throws are getting wild" if sfrac < STAM_LOW else "rested enough to work",
		HORIZONTAL_ALIGNMENT_LEFT, lw - 36.0, ps(11), Color(1.0, 0.6, 0.45) if sfrac < STAM_LOW else Color(0.74, 0.70, 0.64, 0.9))
	# UNSPENT POINTS ARE THE ONE THING HERE THE PLAYER SHOULD ACT ON (2026-07-27, Louis:
	# "there should also be a more clear indicator that you have xp points to spend into
	# stats"). They were mentioned only in small print - one line in the play HUD and a
	# clause in the results footer - both of which sit next to numbers that are merely
	# information. This is a card of its own, in the ledger column where the player is
	# already reading their situation, and it BREATHES: nothing else on this screen
	# moves, so a slow pulse is unmissable without being loud. It appears only when
	# there is something to spend, so it can never become furniture.
	if points > 0:
		var pr := Rect2(lx, ly + 240.0, lw, 60.0)
		var pulse := 0.5 + 0.5 * sin(atick() * 0.055)
		var pc := Color(1.0, 0.86, 0.42)
		soft_card(pr, Color(0.13, 0.10, 0.04, 0.92), Color(pc.r, pc.g, pc.b, 0.35 + 0.5 * pulse), 1.5, 11.0, 12.0)
		draw_rect(Rect2(pr.position.x + 1.0, pr.position.y + 10.0, 3.0, pr.size.y - 20.0), Color(pc.r, pc.g, pc.b, 0.7 + 0.3 * pulse))
		var pic := Vector2(pr.position.x + 30.0, pr.position.y + 30.0)
		draw_circle(pic, 15.0, Color(pc.r, pc.g, pc.b, 0.14 + 0.14 * pulse))
		draw_star4(pic, 10.0, Color(pc.r, pc.g, pc.b, 0.85 + 0.15 * pulse))
		draw_fit_string(font, Vector2(pr.position.x + 54.0, pr.position.y + 27.0),
			"%d STAT POINT%s TO SPEND" % [points, "" if points == 1 else "S"],
			HORIZONTAL_ALIGNMENT_LEFT, lw - 68.0, 15, pc)
		draw_fit_string(font, Vector2(pr.position.x + 54.0, pr.position.y + 46.0),
			"%s opens the sheet" % String(k_sheet()[0]), HORIZONTAL_ALIGNMENT_LEFT, lw - 68.0, 11,
			Color(0.86, 0.80, 0.66, 0.9))

	# THE ACTIONS: a column of cards on the RIGHT edge, off the stage picture. Each card
	# carries its own explanation, so there is no detached tooltip block under the list
	# any more (Louis: those hover texts "look wrong / bad" - they were a bare wrapped
	# paragraph on a card of their own, jammed against the bottom frame). The SELECTED
	# card is the only one that grows: it brightens, shows its explanation, and on
	# PERFORM adds the live chase and the next-stage gate. Everything else stays a
	# one-line title, which is what keeps ten actions' worth of hub readable.
	var rows := day_rows()
	var aw := 360.0
	var ax := s.x - aw - 40.0
	var sub_w := aw - 74.0
	# measure first, lay out second: the column is centred on the actions area, so a
	# two-card drawer does not sit stranded at the top of a ten-card space
	var heights := PackedFloat32Array()
	var total_h := 0.0
	for i in rows.size():
		var h := day_card_height(font, rows[i], i == day_sel, sub_w)
		heights.append(h)
		total_h += h + 8.0
	# centre the column in the space between the header and the footer hints, so a
	# two-card drawer is not left stranded at the top of a ten-card-tall gap
	var band_top := s.y * 0.21
	var band_bot := s.y - 96.0
	var ay := maxf(band_top, band_top + ((band_bot - band_top) - total_h) * 0.5)
	if day_group != "":
		# a breadcrumb, so an open drawer never leaves the player wondering where they are
		var gc := day_group_col(day_group)
		draw_string(font, Vector2(ax + 4.0, ay - 13.0), day_group_name(day_group),
			HORIZONTAL_ALIGNMENT_LEFT, aw * 0.6, ps(13), Color(gc.r, gc.g, gc.b, 0.95))
		draw_string(font, Vector2(ax, ay - 13.0), "Esc  back", HORIZONTAL_ALIGNMENT_RIGHT, aw - 4.0, ps(12), Color(0.72, 0.66, 0.6, 0.8))
	var cy := ay
	for i in rows.size():
		day_draw_card(font, rows[i], Rect2(ax, cy, aw, heights[i]), i == day_sel, sub_w)
		cy += heights[i] + 8.0

	# transient feedback (a meal eaten, a spent day) fades after a few seconds
	if day_msg != "" and cine_tick - day_msg_tick < 300:
		var ma := clampf(1.0 - float(cine_tick - day_msg_tick - 220) / 80.0, 0.0, 1.0)
		draw_string(font, Vector2(0, s.y - 92.0), day_msg, HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(16), Color(1.0, 0.88, 0.55, ma))

	# the footer follows what the cursor is actually on: Left/Right picks the stage on
	# PERFORM (without this hint the < > around the venue name was the only cue a whole
	# venue ladder was there to walk), opens a drawer on a drawer card, and Escape means
	# "out of this drawer" rather than "leave the day" whenever one is open.
	var selid := String(rows[day_sel]["id"])
	var esc_note := "back" if day_group != "" else "menu"
	if pad_active():
		var hints := [[["Stick"], "choose"], [k_finish(), "open" if selid.begins_with("grp:") else "do it"], [k_sheet(), "sheet"], [k_pause(), esc_note]]
		if selid == "perform":
			hints.insert(1, [["Dpad"], "stage"])
		draw_hints_row(font, s.x * 0.5, s.y - 52.0, hints)
	else:
		var hints := [[["Up", "Down"], "choose"], [["Enter"], "open" if selid.begins_with("grp:") else "do it"], [["Tab"], "sheet"], [["Esc"], esc_note]]
		if selid == "perform":
			hints.insert(1, [["Left", "Right"], "stage"])
		draw_hints_row(font, s.x * 0.5, s.y - 52.0, hints)

	if day_anim != "":
		draw_day_anim(font, s)


func day_card_height(font: Font, r: Dictionary, sel: bool, sub_w: float) -> float:
	# a card is one title line until it is SELECTED, then it grows to fit exactly what
	# it has to say. Measured with max_lines -1, the same as day_draw_card draws it, so
	# a long explanation can never run past the bottom of its own card.
	if not sel:
		return 46.0
	var h := 42.0
	var perf := String(r["id"]) == "perform"
	if perf:
		h += 28.0                                   # the stage picker line
	h += font.get_multiline_string_size(String(r["sub"]), HORIZONTAL_ALIGNMENT_LEFT, sub_w, ps(12), -1).y + 10.0
	if not bool(r["ok"]) and String(r["why"]) != "":
		h += font.get_multiline_string_size(String(r["why"]), HORIZONTAL_ALIGNMENT_LEFT, sub_w, ps(12), -1).y + 4.0
	if perf:
		h += 20.0                                   # the record to chase
		if next_venue_rep() > 0:
			h += 18.0                               # ...and how the next stage opens
		h += font.get_multiline_string_size(next_unlock_hint(), HORIZONTAL_ALIGNMENT_LEFT, sub_w, ps(12), -1).y + 4.0
	return h


func day_draw_card(font: Font, r: Dictionary, box: Rect2, sel: bool, sub_w: float) -> void:
	var ok := bool(r["ok"])
	var ac: Color = r.get("col", Color(0.95, 0.7, 0.4))
	if not ok:
		ac = ac.lerp(Color(0.45, 0.42, 0.40), 0.65)
	var fill := Color(ac.r * 0.16, ac.g * 0.16, ac.b * 0.16, 0.94) if sel else Color(0.07, 0.045, 0.06, 0.82)
	soft_card(box, fill, Color(ac.r, ac.g, ac.b, 0.9 if sel else 0.26), 2.0 if sel else 1.0, 11.0, 12.0)
	var ic := Vector2(box.position.x + 32.0, box.position.y + 23.0)
	icon_disc(ic, 15.0, Color(ac.r, ac.g, ac.b, 0.20),
		Color(ac.r, ac.g, ac.b, 0.9 if sel else 0.45), 2.0)
	day_icon(String(r.get("icon", "")), ic, ac)
	var tx := box.position.x + 58.0
	var title_c := Color(1.0, 0.95, 0.86) if sel else Color(0.84, 0.79, 0.72)
	if not ok:
		title_c = Color(0.60, 0.56, 0.52)
	# a DRAWER card gets a chevron, so it reads as "opens into more". It claims its own
	# strip of the right edge, and the cost text stops short of it.
	var right := box.position.x + box.size.x - 14.0
	if bool(r.get("drawer", false)):
		var chx := right - 4.0
		var chy := box.position.y + 23.0
		draw_polyline(PackedVector2Array([Vector2(chx - 5.0, chy - 6.0), Vector2(chx + 1.0, chy), Vector2(chx - 5.0, chy + 6.0)]),
			Color(ac.r, ac.g, ac.b, 0.85 if sel else 0.4), 2.0)
		right -= 18.0
	var cost := String(r["cost"])
	var cost_w := 0.0
	if cost != "":
		cost_w = minf(120.0, font.get_string_size(cost, HORIZONTAL_ALIGNMENT_LEFT, -1, ps(12)).x + 8.0)
		draw_string(font, Vector2(right - cost_w, box.position.y + 28.0), cost,
			HORIZONTAL_ALIGNMENT_RIGHT, cost_w, ps(12), Color(0.88, 0.80, 0.64, 0.9) if ok else Color(0.58, 0.54, 0.5))
	draw_fit_string(font, Vector2(tx, box.position.y + 29.0), String(r["name"]), HORIZONTAL_ALIGNMENT_LEFT,
		right - cost_w - tx - 8.0, 17, title_c)
	if not sel:
		return
	var y := box.position.y + 42.0
	if String(r["id"]) == "perform":
		# the stage picker lives on the card, arrows showing which way the ladder can
		# still move (left to right, never wrapping), with the PURIST mark beside it
		var pv := play_venue()
		var pick := "%s%s%s" % ["<   " if pv > 0 else "", String(venue_data(pv)["name"]), "   >" if pv < venue_index() else ""]
		draw_string(font, Vector2(tx, y + 16.0), pick, HORIZONTAL_ALIGNMENT_LEFT, sub_w, ps(18), Color(1.0, 0.88, 0.52))
		if purist:
			draw_string(font, Vector2(box.position.x + box.size.x - 110.0, y + 16.0), "PURIST",
				HORIZONTAL_ALIGNMENT_RIGHT, 96.0, ps(11), Color(0.84, 0.72, 0.90))
		y += 28.0
	draw_multiline_string(font, Vector2(tx, y + font.get_ascent(ps(12))), String(r["sub"]),
		HORIZONTAL_ALIGNMENT_LEFT, sub_w, ps(12), -1, Color(0.86, 0.80, 0.70))
	y += font.get_multiline_string_size(String(r["sub"]), HORIZONTAL_ALIGNMENT_LEFT, sub_w, ps(12), -1).y + 10.0
	if not ok and String(r["why"]) != "":
		draw_multiline_string(font, Vector2(tx, y + font.get_ascent(ps(12))), String(r["why"]),
			HORIZONTAL_ALIGNMENT_LEFT, sub_w, ps(12), -1, Color(1.0, 0.66, 0.48))
		y += font.get_multiline_string_size(String(r["why"]), HORIZONTAL_ALIGNMENT_LEFT, sub_w, ps(12), -1).y + 4.0
	if String(r["id"]) == "perform":
		var vi := play_venue()
		var chase := "no record here yet  -  set one"
		if vi >= 0 and vi < rec_table().size() and rec_table()[vi] > 0:
			chase = "record to beat   %s" % score_text(rec_table()[vi])
		draw_string(font, Vector2(tx, y + 14.0), chase, HORIZONTAL_ALIGNMENT_LEFT, sub_w, ps(12), Color(0.96, 0.83, 0.52, 0.92))
		var nxt := next_venue_rep()
		if nxt > 0:
			draw_string(font, Vector2(tx, y + 32.0), "next stage at Rep %s  (you have %s)" % [commafy(nxt), commafy(reputation)],
				HORIZONTAL_ALIGNMENT_LEFT, sub_w, ps(12), Color(0.84, 0.74, 0.90, 0.92))
			y += 18.0
		draw_multiline_string(font, Vector2(tx, y + 14.0), next_unlock_hint(), HORIZONTAL_ALIGNMENT_LEFT, sub_w, ps(12), -1,
			Color(0.72, 0.92, 0.70, 0.94))


func crescent_points(c: Vector2, r: float, off: Vector2, ir: float) -> PackedVector2Array:
	# A TRUE CRESCENT: one disc's rim, then back along the rim of the disc that BITES
	# into it. That difference is the whole shape - two HORNS where the rims cross, and
	# a limb that swells at the belly and tapers to a point at each end.
	#
	# WHY NOT A THICK ARC, which is what the moon used to be (2026-07-28, Louis: "improve
	# the rest icon, it's just a C right now" - and he is describing the geometry exactly).
	# draw_arc's width is CONSTANT, so an arc is a ring with a gap cut in it: the same
	# thickness at the horns as at the belly, finished with two square caps. That is the
	# letter C, at any size, however it is coloured. A crescent has no constant width
	# anywhere, so no arc can be one.
	#
	# The other obvious answer - draw the disc, then overdraw the bite in the background
	# colour - is wrong here for a different reason: these icons sit on cards that do not
	# all share one background (and some are half transparent), so the bite has to be
	# honestly ABSENT rather than painted over.
	var b := c + off
	var d := off.length()
	var pts := PackedVector2Array()
	if d < 0.001 or d >= r + ir or d <= absf(r - ir):
		# the rims never cross: there are no horns, so there is no crescent to build.
		# Fall back to the plain disc rather than emitting a broken polygon (which Godot
		# would silently refuse to triangulate, drawing nothing at all).
		for i in 24:
			var a := TAU * float(i) / 24.0
			pts.append(c + Vector2(cos(a), sin(a)) * r)
		return pts
	# where the two rims cross, by the standard circle-circle intersection
	var m := (r * r - ir * ir + d * d) / (2.0 * d)
	var h := sqrt(maxf(0.0, r * r - m * m))
	var u := off / d
	var n := Vector2(-u.y, u.x)
	var p1 := c + u * m + n * h
	var p2 := c + u * m - n * h
	# the outer rim from horn to horn, taking the way round that stays OUTSIDE the bite
	var a1 := (p1 - c).angle()
	var sweep := (p2 - c).angle() - a1
	while sweep <= 0.0:
		sweep += TAU
	if b.distance_to(c + Vector2(cos(a1 + sweep * 0.5), sin(a1 + sweep * 0.5)) * r) < ir:
		sweep -= TAU
	for i in 21:
		var a := a1 + sweep * (float(i) / 20.0)
		pts.append(c + Vector2(cos(a), sin(a)) * r)
	# ...and back along the biting rim, taking the part of it that lies INSIDE the disc
	var b0 := (p2 - b).angle()
	var bsweep := (p1 - b).angle() - b0
	while bsweep <= 0.0:
		bsweep += TAU
	if c.distance_to(b + Vector2(cos(b0 + bsweep * 0.5), sin(b0 + bsweep * 0.5)) * ir) > r:
		bsweep -= TAU
	# THE HORNS ARE SHARED, SO THEY ARE ONLY EMITTED ONCE (fixed 2026-08-05). Both arcs
	# START and END on a horn: the outer one runs p1 -> p2 and the biting one runs p2 -> p1.
	# Walking both from end to end therefore listed p2 twice in a row and closed the ring on
	# a second copy of p1, giving two zero-length edges. Godot's ear-clipping triangulator
	# rejects that outright - "Invalid polygon data, triangulation failed" - and
	# draw_colored_polygon then draws NOTHING, silently. The REST icon on the day hub has
	# been an empty space this whole time, and the error was firing every single frame
	# (8,629 times in one short headless run) where nobody was reading the log.
	# Skipping the first and last point of the inner arc closes the ring exactly once.
	for i in range(1, 20):
		var a := b0 + bsweep * (float(i) / 20.0)
		pts.append(b + Vector2(cos(a), sin(a)) * ir)
	return pts


func day_icon(kind: String, c: Vector2, col: Color) -> void:
	# small vector marks for the hub's cards, drawn from primitives like the rest of
	# the art. Each one says what its row DOES at a glance, which is what lets the
	# collapsed cards get away with a title and nothing else.
	match kind:
		"star":
			var pts := PackedVector2Array()
			for i in 10:
				var a := -PI * 0.5 + TAU * float(i) / 10.0
				var rr := 8.0 if i % 2 == 0 else 3.6
				pts.append(c + Vector2(cos(a), sin(a)) * rr)
			draw_colored_polygon(pts, col)
		"loop":
			# PRACTICE: a loop with its arrowhead ON the end of the arc, pointing along
			# it (2026-07-27, Louis: the triangle was in the wrong place). It used to be
			# a fixed triangle floating off the top-right corner, unrelated to where the
			# arc actually stopped, which read as a stray shape rather than an arrow.
			var a0 := -2.2
			var a1 := 2.5
			draw_arc(c, 6.5, a0, a1, 18, col, 2.0, true)
			var tip := c + Vector2(cos(a1), sin(a1)) * 6.5
			var tang := Vector2(-sin(a1), cos(a1))            # forward along the arc
			var norm := Vector2(cos(a1), sin(a1))             # outward from the centre
			draw_colored_polygon(PackedVector2Array([
				tip + tang * 5.4, tip - tang * 1.6 + norm * 3.4, tip - tang * 1.6 - norm * 3.4]), col)
		"cal":
			draw_rect(Rect2(c.x - 7.0, c.y - 6.0, 14.0, 13.0), Color(col.r, col.g, col.b, 0.55))
			draw_rect(Rect2(c.x - 7.0, c.y - 6.0, 14.0, 4.0), col)
			draw_rect(Rect2(c.x - 3.5, c.y + 0.5, 3.0, 3.0), col)
		"plate":
			# A HOT MEAL: a fork and a table knife laid either side of a plate (Louis).
			# Two bare concentric rings said "target" far more than "dinner"; cutlery is
			# what makes a circle read as a plate, in any kitchen and at any size.
			draw_arc(c, 7.6, 0.0, TAU, 22, Color(col.r, col.g, col.b, 0.85), 1.5, true)
			draw_arc(c, 4.2, 0.0, TAU, 16, Color(col.r, col.g, col.b, 0.45), 1.2, true)
			var fx := c.x - 11.5
			draw_line(Vector2(fx, c.y - 1.0), Vector2(fx, c.y + 8.0), col, 1.6)          # fork handle
			for ti in 3:                                                                  # ...and its tines
				var tx2 := fx - 2.0 + float(ti) * 2.0
				draw_line(Vector2(tx2, c.y - 8.5), Vector2(tx2, c.y - 1.5), col, 1.1)
			draw_line(Vector2(fx - 2.2, c.y - 1.6), Vector2(fx + 2.2, c.y - 1.6), col, 1.4)
			var nx := c.x + 11.5                                                          # table knife
			draw_line(Vector2(nx, c.y + 1.0), Vector2(nx, c.y + 8.0), col, 1.6)
			draw_colored_polygon(PackedVector2Array([
				Vector2(nx - 1.8, c.y + 1.0), Vector2(nx + 1.8, c.y - 0.5),
				Vector2(nx + 1.2, c.y - 8.5), Vector2(nx - 1.8, c.y - 7.5)]), col)
		"bed":
			# REST, third attempt (2026-07-27, Louis: "the rest icon still looks weird").
			# A side-on bed at 18px is a pile of thin strokes that reads as a filing
			# tray however it is arranged - too many parts, none of them legible.
			#
			# So it is not a bed any more. It is a MOON with three z's, which is the
			# universal mark for sleep, survives being 16px wide, and needs exactly two
			# recognisable shapes. (The hub's REST DRAWER uses the same moon without the
			# z's, since a drawer is a place rather than an action.)
			var mc := c + Vector2(-2.0, 1.5)
			draw_glow(mc, 12.0, Color(col.r, col.g, col.b, 0.13))
			draw_colored_polygon(crescent_points(mc, 7.0, Vector2(4.4, -0.9), 6.2), col)
			for zi in 3:
				var zs := 5.0 - float(zi) * 1.4
				var zp := c + Vector2(4.5 + float(zi) * 3.4, -3.0 - float(zi) * 3.6)
				var zc := Color(col.r, col.g, col.b, 0.95 - 0.22 * float(zi))
				draw_line(zp + Vector2(-zs * 0.5, -zs * 0.5), zp + Vector2(zs * 0.5, -zs * 0.5), zc, 1.4)
				draw_line(zp + Vector2(zs * 0.5, -zs * 0.5), zp + Vector2(-zs * 0.5, zs * 0.5), zc, 1.4)
				draw_line(zp + Vector2(-zs * 0.5, zs * 0.5), zp + Vector2(zs * 0.5, zs * 0.5), zc, 1.4)
		"pie":
			# UNCLE DAN'S PIE (redrawn 2026-07-29, Louis: "i want there to be a good looking
			# visible icon of the pie"). It was a flat wedge with two lines across it, which
			# is a triangle wearing a hat - and a slice of pie is not a flat shape, it is a
			# WEDGE WITH DEPTH. What makes one recognisable is the CUT FACE: the tall filled
			# side you see because somebody has taken it out of a pie. So: a golden crimped
			# top, a dark filling below it on the cut face, a pastry base, and steam. The
			# depth is the whole read; the crimping is what says "baked".
			var crustc := Color(minf(1.0, col.r * 1.06), col.g * 0.84, col.b * 0.48)
			var crust_lo := Color(crustc.r * 0.72, crustc.g * 0.64, crustc.b * 0.40)
			var fill := Color(0.62, 0.28, 0.16)
			# the CUT FACE, front-on: a tall triangle standing on the base. Drawn first, so
			# the top crust laps over it.
			draw_colored_polygon(PackedVector2Array([
				c + Vector2(-8.4, 6.2), c + Vector2(8.4, 6.2),
				c + Vector2(6.6, -1.4), c + Vector2(-6.6, -1.4)]), fill)
			# the filling's own darker shadow along the bottom, so it is not one flat slab
			draw_colored_polygon(PackedVector2Array([
				c + Vector2(-8.4, 6.2), c + Vector2(8.4, 6.2),
				c + Vector2(7.8, 3.6), c + Vector2(-7.8, 3.6)]), Color(fill.r * 0.66, fill.g * 0.60, fill.b * 0.58))
			# the TOP CRUST, seen slightly from above: a wedge narrowing to the point of the
			# slice at the back, which is what gives the whole thing perspective
			draw_colored_polygon(PackedVector2Array([
				c + Vector2(-7.2, -0.6), c + Vector2(7.2, -0.6),
				c + Vector2(2.4, -7.6), c + Vector2(-2.4, -7.6)]), crustc)
			draw_line(c + Vector2(-4.8, -3.8), c + Vector2(4.8, -3.8), Color(crust_lo.r, crust_lo.g, crust_lo.b, 0.85), 1.2)
			# the crimped rim along the front edge - the row of thumb-pressed bumps a pie has
			for pi in 6:
				draw_circle(c + Vector2(-7.0 + float(pi) * 2.8, -0.4), 2.1, crustc)
				draw_circle(c + Vector2(-7.0 + float(pi) * 2.8, -1.2), 1.2, Color(crust_lo.r, crust_lo.g, crust_lo.b, 0.55))
			# the pastry base under the filling, and two curls of steam
			draw_colored_polygon(PackedVector2Array([
				c + Vector2(-8.8, 6.2), c + Vector2(8.8, 6.2),
				c + Vector2(8.2, 8.4), c + Vector2(-8.2, 8.4)]), crust_lo)
			for sg: float in [-1.0, 1.0]:
				for k in 3:
					var t := float(k) / 2.0
					draw_circle(c + Vector2(sg * 3.4 + sin(t * 3.4) * 1.6, -9.4 - t * 3.4),
						1.5 - t * 0.7, Color(1.0, 0.96, 0.90, 0.22 - t * 0.13))
		"tomato":
			draw_tomato(c, 1.35, 0.4, col.a)
		"egg":
			fill_ellipse(c, 5.5, 7.5, col)
		"coin":
			draw_coin_mark(c, 7.5, col)
		"book":
			# SKILLS: an OPEN book (Louis) - two leaves rising to a spine, a page edge on
			# each side and a few ruled lines. Two rectangles side by side read as a
			# domino, which is what it was.
			var spine := c + Vector2(0.0, -1.5)
			for sgn in [-1.0, 1.0]:
				draw_colored_polygon(PackedVector2Array([
					spine, spine + Vector2(sgn * 9.0, -2.2), spine + Vector2(sgn * 9.0, 6.6),
					spine + Vector2(0.0, 8.0)]), Color(col.r, col.g, col.b, 0.92 if sgn < 0.0 else 0.7))
				for li in 2:
					var ly := spine.y + 1.2 + float(li) * 2.6
					draw_line(Vector2(spine.x + sgn * 2.2, ly), Vector2(spine.x + sgn * 7.4, ly - sgn * 0.0),
						Color(0.10, 0.08, 0.10, 0.35), 0.9)
			draw_line(spine, spine + Vector2(0.0, 9.5), Color(col.r * 0.6, col.g * 0.6, col.b * 0.6), 1.6)
		"moon":
			# REST: a real crescent (see crescent_points), with the faint halo a moon has.
			# The halo is what stops a small pale shape reading as a clipping of
			# something else - a moon is a LIGHT, and a light spills.
			draw_glow(c + Vector2(1.0, 0.0), 15.0, Color(col.r, col.g, col.b, 0.15))
			draw_colored_polygon(crescent_points(c + Vector2(1.4, 0.0), 8.2, Vector2(5.2, -1.1), 7.2), col)
		"bag":
			draw_rect(Rect2(c.x - 7.5, c.y - 3.0, 15.0, 10.0), col)
			draw_arc(c + Vector2(0.0, -3.0), 4.5, PI, TAU, 12, col, 1.8, true)
		"hanger":
			# THE TAILOR: A DRESS FORM (2026-07-29, Louis: "the tailor icon ... looks bad").
			# It was a coat hanger, and a hanger at 18px is a triangle with a wire on it - I
			# even wrote in the comment that the whole read depended on the hook, which is a
			# confession that the shape was not doing the work. A dressmaker's dummy is the
			# better mark for the same idea: it is a torso, so it is instantly a HUMAN SHAPE
			# and instantly about clothes, and unlike a hanger nothing else in this game
			# looks remotely like one. The tape measure over the shoulder is the second cue
			# and costs one line.
			var form := col
			var form_lo := Color(col.r * 0.72, col.g * 0.72, col.b * 0.74)
			draw_colored_polygon(PackedVector2Array([   # the stand: a post on a round foot
				Vector2(c.x - 1.6, c.y + 3.0), Vector2(c.x + 1.6, c.y + 3.0),
				Vector2(c.x + 1.6, c.y + 8.0), Vector2(c.x - 1.6, c.y + 8.0)]), form_lo)
			fill_ellipse(Vector2(c.x, c.y + 9.0), 6.2, 1.9, form_lo)
			draw_colored_polygon(PackedVector2Array([   # the bust: shoulders, waist, hem
				Vector2(c.x - 7.4, c.y - 6.2), Vector2(c.x - 2.4, c.y - 8.4),
				Vector2(c.x + 2.4, c.y - 8.4), Vector2(c.x + 7.4, c.y - 6.2),
				Vector2(c.x + 5.0, c.y - 0.6), Vector2(c.x + 6.4, c.y + 3.4),
				Vector2(c.x - 6.4, c.y + 3.4), Vector2(c.x - 5.0, c.y - 0.6)]), form)
			draw_line(Vector2(c.x, c.y - 8.0), Vector2(c.x, c.y + 3.0), Color(0, 0, 0, 0.18), 1.1)
			# the tape measure, hung round the neck and down one side
			draw_line(Vector2(c.x - 4.6, c.y - 7.2), Vector2(c.x + 4.6, c.y - 7.2), Color(1.0, 0.86, 0.42, 0.95), 1.6)
			draw_line(Vector2(c.x + 4.6, c.y - 7.2), Vector2(c.x + 6.2, c.y + 1.0), Color(1.0, 0.86, 0.42, 0.95), 1.6)
		"drink":
			# ENERGY DRINKS in the rest drawer: a can, and the pull ring is what makes it
			# a can rather than a tin. Deliberately NOT the helmet's picture - the hat and
			# the cans are two objects and the shop had already been caught drawing one for
			# both (see draw_gear_icon "drinks").
			draw_rect(Rect2(c.x - 4.6, c.y - 8.0, 9.2, 16.0), col)
			draw_rect(Rect2(c.x - 4.6, c.y - 8.0, 2.4, 16.0), Color(1.0, 1.0, 1.0, 0.30))
			draw_rect(Rect2(c.x + 2.4, c.y - 8.0, 2.2, 16.0), Color(0.0, 0.0, 0.0, 0.24))
			fill_ellipse(Vector2(c.x, c.y - 8.0), 4.6, 1.7, Color(0.86, 0.88, 0.92))
			draw_rect(Rect2(c.x - 4.6, c.y - 1.4, 9.2, 2.4), Color(1.0, 0.88, 0.44, 0.9))
			draw_arc(Vector2(c.x + 1.1, c.y - 8.2), 1.5, 0.0, TAU, 8, Color(0.70, 0.72, 0.76), 0.9, true)
		"shop":
			# THE SHOP: a market STALL - a striped awning over a counter with something on
			# it. The shop row used to borrow the coin, which said "money" rather than
			# "the place you spend it", and now collides with the currency mark besides.
			draw_rect(Rect2(c.x - 8.5, c.y + 1.0, 17.0, 6.0), Color(col.r * 0.75, col.g * 0.72, col.b * 0.68))
			for si in 4:                                   # the awning, in stripes
				var sx := c.x - 9.0 + float(si) * 4.5
				draw_colored_polygon(PackedVector2Array([
					Vector2(sx, c.y - 5.0), Vector2(sx + 4.5, c.y - 5.0),
					Vector2(sx + 4.5, c.y - 0.5), Vector2(sx, c.y - 0.5)]),
					col if si % 2 == 0 else Color(1.0, 0.98, 0.92, 0.85))
			draw_line(Vector2(c.x - 9.5, c.y - 5.4), Vector2(c.x + 9.5, c.y - 5.4), col, 1.6)
			draw_line(Vector2(c.x - 8.0, c.y + 7.0), Vector2(c.x - 8.0, c.y + 9.0), Color(col.r * 0.7, col.g * 0.7, col.b * 0.7), 1.5)
			draw_line(Vector2(c.x + 8.0, c.y + 7.0), Vector2(c.x + 8.0, c.y + 9.0), Color(col.r * 0.7, col.g * 0.7, col.b * 0.7), 1.5)
		"spark":
			# LEARN SOMETHING NEW: a lit lamp, not a plus sign. Four equal crossed lines
			# is the sparkle trap draw_star4 exists to avoid, and it read as "add".
			draw_glow(c + Vector2(0.0, -2.0), 11.0, Color(col.r, col.g, col.b, 0.22))
			draw_circle(c + Vector2(0.0, -2.5), 5.6, col)
			draw_circle(c + Vector2(-1.6, -4.0), 2.0, Color(1.0, 1.0, 0.94, 0.75))
			draw_rect(Rect2(c.x - 3.0, c.y + 2.6, 6.0, 2.0), Color(col.r * 0.65, col.g * 0.65, col.b * 0.65))
			draw_rect(Rect2(c.x - 2.4, c.y + 5.0, 4.8, 1.8), Color(col.r * 0.55, col.g * 0.55, col.b * 0.55))
			for ri in 3:                                    # three short rays, off-centre
				var ra2 := -PI * 0.5 + (float(ri) - 1.0) * 0.85
				draw_line(c + Vector2(0.0, -2.5) + Vector2(cos(ra2), sin(ra2)) * 7.4,
					c + Vector2(0.0, -2.5) + Vector2(cos(ra2), sin(ra2)) * 10.2, Color(col.r, col.g, col.b, 0.7), 1.5)
		"back":
			draw_line(c + Vector2(7, 0), c + Vector2(-6, 0), col, 2.2)
			draw_polyline(PackedVector2Array([c + Vector2(-1, -6), c + Vector2(-7, 0), c + Vector2(-1, 6)]), col, 2.2)


func draw_day_anim(font: Font, s: Vector2) -> void:
	# the hub's little vignettes: a beat of picture before the ledger moves, so
	# eating, sleeping and shopping feel like moments instead of button presses
	var t := float(cine_tick - day_anim_start) / float(day_anim_len(day_anim))
	t = clampf(t, 0.0, 1.0)
	var ease_in := minf(t * 5.0, 1.0)
	match day_anim:
		"eat":
			var c := Vector2(s.x * 0.5, s.y * 0.52)
			hud_panel(Rect2(c.x - 170.0, c.y - 110.0, 340.0, 210.0))
			# the bowl, and a spoon that dips twice
			fill_ellipse(c + Vector2(0, 30.0), 74.0, 30.0, Color(0.55, 0.34, 0.2))
			fill_ellipse(c + Vector2(0, 22.0), 62.0, 18.0, Color(0.93, 0.72, 0.4))
			var dip := absf(sin(t * TAU * 2.0)) * 18.0
			draw_capsule(c + Vector2(44.0, -34.0 + dip), c + Vector2(58.0, -2.0 + dip), 5.0, 8.0, Color(0.8, 0.78, 0.75))
			# steam: three slow wisps climbing off the soup
			for w in 3:
				var wx := c.x - 30.0 + 30.0 * float(w)
				var pts := PackedVector2Array()
				for k in 9:
					var f := float(k) / 8.0
					pts.append(Vector2(wx + sin(f * 5.0 + t * 9.0 + float(w) * 2.0) * 7.0, c.y + 4.0 - f * (46.0 + 20.0 * t)))
				draw_polyline(pts, Color(1.0, 0.97, 0.9, 0.35 * ease_in * (1.0 - t * 0.5)), 2.5)
			draw_string(font, Vector2(c.x - 170.0, c.y + 82.0), "a hot meal", HORIZONTAL_ALIGNMENT_CENTER, 340.0, ps(16), Color(1.0, 0.9, 0.65, ease_in))
		"inn":
			# the world dims to sleep, a lit window and drifting z's carry it
			draw_rect(Rect2(0, 0, s.x, s.y), Color(0.01, 0.01, 0.03, 0.55 + 0.4 * t))
			var c := Vector2(s.x * 0.5, s.y * 0.46)
			draw_rect(Rect2(c.x - 60.0, c.y - 70.0, 120.0, 130.0), Color(0.16, 0.11, 0.08))
			draw_rect(Rect2(c.x - 48.0, c.y - 58.0, 96.0, 106.0), Color(1.0, 0.82, 0.45, 0.28 * (1.0 - t * 0.7)))
			draw_rect(Rect2(c.x - 3.0, c.y - 58.0, 6.0, 106.0), Color(0.16, 0.11, 0.08))
			draw_rect(Rect2(c.x - 48.0, c.y - 8.0, 96.0, 6.0), Color(0.16, 0.11, 0.08))
			for z in 3:
				var zt := fposmod(t * 2.2 + float(z) * 0.33, 1.0)
				var zp := c + Vector2(70.0 + zt * 46.0 + float(z) * 8.0, -30.0 - zt * 70.0)
				draw_string(font, zp, "z", HORIZONTAL_ALIGNMENT_LEFT, -1, ps(18 + z * 4), Color(0.9, 0.88, 0.8, (1.0 - zt) * 0.8))
			draw_string(font, Vector2(0, c.y + 110.0), "the day ends", HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(16), Color(0.9, 0.85, 0.7, ease_in))
		"pie":
			# UNCLE DAN'S PIE: the slice on its plate, and the hum that follows it - the
			# whole reason to eat one is the slow motion, so the picture says so
			var c := Vector2(s.x * 0.5, s.y * 0.52)
			hud_panel(Rect2(c.x - 170.0, c.y - 110.0, 340.0, 210.0))
			fill_ellipse(c + Vector2(0, 34.0), 78.0, 22.0, Color(0.80, 0.78, 0.75))
			# the slice, shrinking as it is eaten
			var eaten := clampf(t * 1.4, 0.0, 1.0)
			var half := 62.0 * (1.0 - 0.75 * eaten)
			draw_colored_polygon(PackedVector2Array([
				c + Vector2(-half, 26.0), c + Vector2(half, 26.0), c + Vector2(0.0, -56.0 * (1.0 - 0.6 * eaten))]),
				Color(0.92, 0.66, 0.30))
			for pi in 6:
				draw_circle(c + Vector2(-half + half * 2.0 * float(pi) / 5.0, 28.0), 5.0 * (1.0 - 0.5 * eaten), Color(0.98, 0.80, 0.46))
			# the hum: slow rings widening out of the slice as it goes down
			for ri in 3:
				var rt := fposmod(t * 1.1 + float(ri) * 0.33, 1.0)
				draw_arc(c, 30.0 + rt * 90.0, 0.0, TAU, 26, Color(0.75, 0.92, 1.0, (1.0 - rt) * 0.28 * ease_in), 2.0, true)
			draw_string(font, Vector2(c.x - 170.0, c.y + 82.0), "the world slows down", HORIZONTAL_ALIGNMENT_CENTER, 340.0, ps(16), Color(0.82, 0.94, 1.0, ease_in))
		"egg":
			# A RAW EGG: cracked over the mouth in one go, which is the joke
			var c := Vector2(s.x * 0.5, s.y * 0.52)
			hud_panel(Rect2(c.x - 170.0, c.y - 110.0, 340.0, 210.0))
			var tip := clampf(t * 2.0, 0.0, 1.0)
			var gap := 26.0 * tip
			# the two shell halves parting, the yolk sliding out between them
			fill_ellipse(c + Vector2(-gap, -20.0), 26.0, 20.0, Color(0.95, 0.92, 0.86))
			fill_ellipse(c + Vector2(gap, -20.0), 26.0, 20.0, Color(0.90, 0.87, 0.80))
			if tip > 0.25:
				var fall := (tip - 0.25) / 0.75
				fill_ellipse(c + Vector2(0.0, -10.0 + fall * 46.0), 13.0, 15.0, Color(1.0, 0.78, 0.24))
				fill_ellipse(c + Vector2(-3.0, -14.0 + fall * 46.0), 4.5, 5.0, Color(1.0, 0.92, 0.62, 0.8))
			draw_string(font, Vector2(c.x - 170.0, c.y + 82.0), "down in one", HORIZONTAL_ALIGNMENT_CENTER, 340.0, ps(16), Color(1.0, 0.9, 0.65, ease_in))
		"tomato":
			# A THROWN TOMATO, eaten anyway. The bite is the picture, and the little
			# bruise-coloured splash sells that it has been on the boards.
			var c := Vector2(s.x * 0.5, s.y * 0.52)
			hud_panel(Rect2(c.x - 170.0, c.y - 110.0, 340.0, 210.0))
			var bite := clampf((t - 0.25) / 0.6, 0.0, 1.0)
			draw_tomato(c + Vector2(0.0, -6.0), 6.5 * (1.0 - 0.35 * bite), 0.35, 1.0)
			if bite > 0.0:
				# the bite taken out of the top-right, in the panel's own colour
				draw_circle(c + Vector2(30.0 * (1.0 - 0.35 * bite), -30.0 * (1.0 - 0.35 * bite)), 17.0 * bite, Color(0.10, 0.07, 0.09))
			for si in 4:
				var st2 := fposmod(t * 1.6 + float(si) * 0.27, 1.0)
				draw_circle(c + Vector2(-46.0 + float(si) * 30.0, 44.0 + st2 * 16.0), 3.0 * (1.0 - st2), Color(0.82, 0.22, 0.20, (1.0 - st2) * 0.7 * ease_in))
			draw_string(font, Vector2(c.x - 170.0, c.y + 82.0), "still perfectly good", HORIZONTAL_ALIGNMENT_CENTER, 340.0, ps(16), Color(1.0, 0.82, 0.72, ease_in))


#endregion

#region MAIN MENU SCREEN
const MENU_FLOOR := 0.80     # where the stage lip sits, so the menu rows can stand ON it
# ONE ROW'S SIZE, named because THREE places measure off it: menu_rows draws with it, draw_menu
# sizes the block from it, and the block's clearance above the stage lip is half of it. Written as
# literals in two of those three for one commit, which is how a "lift it by half a card" note
# becomes a magic 27 sitting a hundred lines from the 54 it came from.
const MENU_ROW_H := 54.0
const MENU_ROW_GAP := 11.0
const MENU_ORN_LIFT := 20.0  # how far the gold divider sits ABOVE the first menu card. It used to
							 # hang 14px under the wordmark, which put it in the middle of the empty
							 # band between the two - Louis wants it tight to the menu instead.

# --- THE PROSCENIUM DRAPES -------------------------------------------------------------
# Every number the cloth is made of, together, because the picture is the BALANCE between
# them and a value edited on its own is how the three earlier passes went wrong.
const DRAPE_REACH := 0.150   # how far inward a leg reaches at its widest, x s.x
const DRAPE_FOLDS := 4.25    # fold periods across one leg. The .25 is load-bearing: it puts
							 # sin(phase) at exactly +1 on the leading edge, so the line the
							 # eye follows down the picture is a LIT crest and not whatever
							 # tone the arithmetic happened to land on.
const DRAPE_COLS := 30       # samples across a leg - this is the SHADING resolution
const DRAPE_ROWS := 44       # samples down it - this is the SILHOUETTE resolution. It was 20,
							 # and 20 straight segments across a curve that turns as hard as a
							 # tieback does is what the "small nicks" in the outline were: not
							 # aliasing, FACETING. The bake runs once, so rows are free.
const DRAPE_HEADER := 0.026  # the gathered heading over the rail, above the swags, x s.y
const DRAPE_SAG := 0.070     # how deep a swag hangs at its middle, x s.y
const DRAPE_SWAGS := 6       # swags across the pelmet
const DRAPE_BANDS := 6       # fold arcs nested inside one swag
# THE SILHOUETTE OF A TIED-BACK LEG, as (t down the leg, width as a fraction of REACH). A
# curtain is not a rectangle: it is pinned full width under the pelmet, billows a little
# below that, is PULLED BACK toward the wall at the tieback, then falls free and flares
# again to the boards. This table is the single source for that shape - `DRAPE_TIE_KEY`
# names the tieback row and the bow is placed off it, so the knot cannot drift away from
# the pinch it is supposed to be causing (the mistake the first bow made, hanging at the
# inner corner over the T and the A like a fishing rod propped against the letters).
const DRAPE_SILHOUETTE := [
	Vector2(0.00, 1.00), Vector2(0.19, 1.06), Vector2(0.56, 0.58),
	Vector2(0.80, 0.63), Vector2(1.00, 0.69)]
const DRAPE_TIE_KEY := 2
const DRAPE_DEEP := Color(0.098, 0.019, 0.030)   # the trough, near enough the back wall
const DRAPE_LIT := Color(0.545, 0.115, 0.142)    # the crest, full in the stage light
const DRAPE_GOLD := Color(0.86, 0.68, 0.33)
# THE BOW IS ITS OWN GOLD, brighter and far more saturated than the braid's. It is a small
# metal thing catching the spotlight against a big red field, and the braid's gold - which
# is deliberately faint, being a thread on cloth - came out as tan when a solid 40px shape
# was filled with it. Two different jobs, two colours.
const DRAPE_BOW := Color(1.00, 0.82, 0.38)
const DRAPE_BOW_DK := Color(0.63, 0.43, 0.15)

# The whole proscenium is STATIC - it depends on the viewport and on nothing else - so it
# is baked once into a triangle array and re-emitted for free every frame afterwards. That
# is the chainsaw's finding applied where it actually pays: batching only wins if the
# triangles are not rebuilt in GDScript each time, and here they never have to be.
var _drape_pts := PackedVector2Array()
var _drape_cols := PackedColorArray()
var _drape_idx := PackedInt32Array()
var _drape_for := Vector2.ZERO
var _drape_fy := -1.0   # BOTH inputs are in the cache key, not just the viewport. fy happens
						# to be derived from s today, so guarding on s alone would work - and
						# would silently serve a stale curtain the day a caller passes its own
						# floor line. A cache key that is only accidentally complete is a bug
						# with a date on it.


func drape_width(t: float) -> float:
	# the silhouette table read as a curve: find the span t falls in and ease across it.
	# Smoothstep and not a straight lerp, because hung cloth has no corners in it.
	var n := DRAPE_SILHOUETTE.size()
	for k in n - 1:
		var a: Vector2 = DRAPE_SILHOUETTE[k]
		var b: Vector2 = DRAPE_SILHOUETTE[k + 1]
		if t <= b.x or k == n - 2:
			return lerpf(a.y, b.y, smoothstep(a.x, b.x, t))
	return 1.0


func drape_sway(t: float) -> float:
	# THE LEADING EDGE'S OWN DRIFT, factored out because TWO things need it: the cloth
	# draws with it, and the tieback has to stop just short of it. Left inline once and the
	# strap overhung the curtain by 7px into open air, reading as a gold rod poking out of
	# the drape - the same class of mistake as the goal stem's bloom eating the word
	# TONIGHT, and the same fix. When one thing is placed against another, both read the
	# same number.
	# 3.8%, not the 5.5% it started at: velvet is HEAVY, and a leading edge that swings
	# further than this stops reading as a curtain and starts reading as a ribbon.
	return 1.0 + 0.038 * sin(t * 8.2 + 1.1)


func drape_velvet(phase: float, open: float, lift: float, warm: float) -> Color:
	# ONE LIGHT FOR THE WHOLE PROSCENIUM, and that is the entire difference between cloth
	# and a stack of shapes. A hanging drape is a corrugated sheet: its surface normal
	# swings inward and outward with every fold, so `sin(phase)` IS how much of the stage
	# light that patch of velvet is facing. Nothing in either leg or in the pelmet is a
	# tone picked by hand - every value comes out of this one function, which is why they
	# read as one piece of cloth hung in one room. The version this replaced picked a tone
	# per shape (`velvet if k % 2 == 0 else velvet_lo`), which is a decoration of a fold
	# rather than a fold, and it is why the old drapes read as stacked coins.
	#   `open` is how exposed to the room this patch is - distance from the wall on a leg,
	# distance from the gather on a swag. `lift` is the vertical light profile, `warm` the
	# footlights coming up off the boards.
	var l := sin(phase)
	# gamma-biased toward the dark end: velvet SWALLOWS light, so the trough is broad and
	# the lit side is a narrow rise out of it. A plain 0.5 + 0.5 * l gives corrugated plastic.
	var c := DRAPE_DEEP.lerp(DRAPE_LIT, pow(0.5 + 0.5 * l, 2.0))
	# the sheen: the one narrow bright line real velvet carries along the crest of a fold.
	# The exponent is high on purpose - widen it and the cloth turns to satin.
	var sh := pow(maxf(l, 0.0), 12.0) * 0.30
	var k := lift * lerpf(0.68, 1.10, open)
	return Color(
		clampf(c.r * k + sh + warm * 0.26, 0.0, 1.0),
		clampf(c.g * k + sh * 0.86 + warm * 0.13, 0.0, 1.0),
		clampf(c.b * k + sh * 0.62 + warm * 0.06, 0.0, 1.0))


func drape_leg(s: Vector2, fy: float, side: float) -> void:
	# ONE LEG, as a grid warped by the silhouette. `side` IS THE DIRECTION INWARD, not
	# which half of the screen - written the other way round once, and the left leg's inner
	# edge came out at x = -384, off screen, so only the pelmet drew.
	#
	# The corrugation is NOT a horizontal displacement, and that is worth saying out loud
	# because displacing it is the obvious move: a fold runs in DEPTH, toward the viewer,
	# and depth projects to nothing in a flat front view. So the folds live entirely in the
	# shading - and they still bend and gather correctly, because a fold sits at a fixed
	# fraction ACROSS the panel and the panel's own width changes down its length. Where
	# the tieback pinches the cloth the folds crowd together on their own, for the reason
	# real ones do, without a single line being placed by hand.
	var ex := 0.0 if side > 0.0 else s.x
	var reach := s.x * DRAPE_REACH
	var hem := s.y * 0.024
	var pos := PackedVector2Array()
	var col := PackedColorArray()
	for i in DRAPE_ROWS + 1:
		var t := float(i) / float(DRAPE_ROWS)
		var w := drape_width(t) * reach
		# dark up in the flies, brightest where the spotlight spills across the cloth,
		# falling away again at the boards. This profile is what stops a leg reading as an
		# extruded pattern - a fold pattern with no vertical story is wallpaper.
		var lift := 0.50 + 0.50 * sin(PI * clampf(t * 1.04 + 0.02, 0.0, 1.0))
		var warm := pow(clampf((t - 0.62) / 0.38, 0.0, 1.0), 2.2)   # the footlights
		for j in DRAPE_COLS + 2:
			# THE LAST COLUMN IS A FEATHER, not cloth. A triangle array gets no
			# antialiasing, so the leading edge - a long near-vertical curve - came out
			# visibly stair-stepped, which is the one thing on the finished screen that
			# still said "programmer art". Two pixels of the same colour falling to alpha 0
			# is what a hardware AA edge would have given, for two more triangles a row.
			var feather := j > DRAPE_COLS
			var u := minf(float(j), float(DRAPE_COLS)) / float(DRAPE_COLS)
			var ph := u * DRAPE_FOLDS * TAU
			# the leading edge of hung cloth is never a clean line - it sways as the folds
			# push it out. Eased in by u, so the wall side stays pinned to the screen edge.
			var sway := lerpf(1.0, drape_sway(t), u)
			# ...and the hem hangs LOWER in a trough than on a crest, which is the whole
			# reason a curtain has a scalloped bottom. pow(t, 4) keeps it to the last rows.
			var y := fy * t + hem * (0.5 - 0.5 * sin(ph)) * pow(t, 4.0)
			var cc := drape_velvet(ph, u, lift, warm)
			if feather:
				cc.a = 0.0
			pos.append(Vector2(ex + side * w * u * sway, y))
			col.append(cc)
	var stride := DRAPE_COLS + 2
	# THE FEATHER RUNS PERPENDICULAR TO THE EDGE, and getting that wrong is the other half of
	# the nicks. Offsetting it a flat 2.2px sideways is only a 2.2px feather where the edge
	# happens to be VERTICAL; where the silhouette turns hardest - right at the tieback, which
	# is exactly where the eye is - the edge is steeply slanted and the true perpendicular
	# width of that same offset collapses, so the softening thinned out precisely at the
	# corners that needed it. Measured off the neighbouring rows, so it follows whatever the
	# silhouette table says without being told about it.
	for i in DRAPE_ROWS + 1:
		var e := i * stride + DRAPE_COLS
		var a := pos[maxi(i - 1, 0) * stride + DRAPE_COLS]
		var b := pos[mini(i + 1, DRAPE_ROWS) * stride + DRAPE_COLS]
		var tan := b - a
		if tan.length_squared() < 0.0001:
			tan = Vector2(0.0, 1.0)
		var nrm := Vector2(tan.y, -tan.x).normalized()
		if nrm.x * side < 0.0:
			nrm = -nrm            # always the INWARD side, whichever way the edge is running
		pos[e + 1] = pos[e] + nrm * 2.2
	for i in DRAPE_ROWS:
		for j in DRAPE_COLS + 1:
			var a := i * stride + j
			var b := a + 1
			var c := a + stride
			var d := c + 1
			_soup_quad(pos[a], pos[b], pos[d], pos[c], col[a], col[b], col[d], col[c])


func drape_pelmet(s: Vector2) -> void:
	# THE BORDER: a gathered heading over the rail with a row of swags hanging off it.
	# A SWAG IS A FAN OF FOLDS - the note the second pass left behind was right, and the
	# reason that pass still failed is that it drew the fan as a few very dark triangles,
	# which reads as black spikes clawing inward. A fold is a GRADIENT across cloth, never
	# an outline and never a flat wedge; drawn as nested arcs shaded off one light they
	# converge at the pins because that is where the cloth is actually pinned.
	var hy := s.y * DRAPE_HEADER
	var sag := s.y * DRAPE_SAG
	# the heading, gathered onto the track: fine folds at a fixed pitch in PIXELS, because
	# a heading tape's pleats are a property of the cloth and not of the window.
	var hn := int(maxf(24.0, s.x / 26.0))
	for i in hn:
		var x0 := s.x * float(i) / float(hn)
		var x1 := s.x * float(i + 1) / float(hn)
		var p0 := (x0 / s.x) * float(hn) * TAU
		var p1 := (x1 / s.x) * float(hn) * TAU
		var ca := drape_velvet(p0, 0.55, 0.74, 0.0)
		var cb := drape_velvet(p1, 0.55, 0.74, 0.0)
		# darker where it tucks under the swags, so the two layers separate
		_soup_quad(Vector2(x0, 0.0), Vector2(x1, 0.0), Vector2(x1, hy), Vector2(x0, hy),
			ca, cb, cb.darkened(0.30), ca.darkened(0.30))
	var ov := s.x / float(DRAPE_SWAGS) * 0.17   # neighbours overlap, so no pin shows a seam
	var np := 20
	var nr := DRAPE_BANDS * 4                   # four samples per fold - enough to be smooth
	for m in DRAPE_SWAGS:
		var x0 := s.x * float(m) / float(DRAPE_SWAGS) - ov
		var x1 := s.x * float(m + 1) / float(DRAPE_SWAGS) + ov
		var pos := PackedVector2Array()
		var col := PackedColorArray()
		for r in nr + 2:
			var edge := r > nr                  # the feathered row - see drape_leg
			var q := minf(float(r), float(nr)) / float(nr)
			# one full fold per band, starting in a crease: trough, crest, trough.
			var ph := q * float(DRAPE_BANDS) * TAU - PI * 0.5
			var lift := lerpf(0.98, 0.66, q)    # the deeper arcs sink into their own shadow
			for c in np + 1:
				var p := float(c) / float(np)
				var bow := pow(sin(PI * p), 0.9)
				var cc := drape_velvet(ph, 0.28 + 0.72 * pow(bow, 0.6), lift, 0.0)
				if edge:
					cc.a = 0.0
				# EVERY ARC PINCHES TO THE PINS, which is what makes it a swag rather than
				# a scalloped rectangle - and it is why the swags have to overlap.
				pos.append(Vector2(lerpf(x0, x1, p), hy + sag * q * bow + (2.0 if edge else 0.0)))
				col.append(cc)
		for r in nr + 1:
			for c in np:
				var a := r * (np + 1) + c
				var b := a + 1
				var d := a + np + 1
				var e := d + 1
				_soup_quad(pos[a], pos[b], pos[e], pos[d], col[a], col[b], col[e], col[d])
		# the gold braid along the bottom arc, and the fringe hanging off it. Faint, and
		# deliberately so: a bright line along a curved hem reads as a fringe only at low
		# alpha, and any brighter it reads as a lightning bolt (the first pass's finding).
		var prev := Vector2.ZERO
		for c in np + 1:
			var p := float(c) / float(np)
			var pt := Vector2(lerpf(x0, x1, p), hy + sag * pow(sin(PI * p), 0.9))
			if c > 0:
				_soup_line(prev, pt, 2.2, Color(DRAPE_GOLD.r, DRAPE_GOLD.g, DRAPE_GOLD.b, 0.42))
			prev = pt
		# THE FRINGE IS A SILHOUETTE, NOT A TEXTURE. At 1.8px and 30% alpha the first one
		# was invisible on screen at any size - a strand that faint is below the threshold
		# where the eye assembles a row of them into an edge, the same finding the Midnight
		# Show's house lights left ("a lamp needs a halo or it is just a brighter rectangle").
		# Solid, wider, and hanging off the hem where it can be read against the dark wall.
		var fn := int((x1 - x0) / 9.0)
		for c in fn:
			var p := (float(c) + 0.5) / float(fn)
			var bow2 := pow(sin(PI * p), 0.9)
			var top := Vector2(lerpf(x0, x1, p), hy + sag * bow2 + 1.0)
			var ln := (9.0 + 4.0 * sin(float(c) * 2.1)) * (0.45 + 0.55 * bow2)
			var fa := 0.62 * bow2 + 0.14
			_soup_line(top, top + Vector2(0.0, ln), 2.6,
				Color(DRAPE_GOLD.r * 0.82, DRAPE_GOLD.g * 0.72, DRAPE_GOLD.b * 0.40, fa))
	# the pin between each pair of swags: cloth bunched into a knot, with a gold boss on it.
	# It hides the junction, which is exactly the job a real rosette does.
	for m in DRAPE_SWAGS + 1:
		var px := s.x * float(m) / float(DRAPE_SWAGS)
		for k in 5:
			var a := PI * (0.16 + 0.68 * float(k) / 4.0)
			var tip := Vector2(px + cos(a) * sag * 0.30, hy + sin(a) * sag * 0.62)
			_soup_line(Vector2(px, hy - 2.0), tip, 3.4,
				drape_velvet(float(k) * 1.9, 0.5, 0.80, 0.0))
		_soup_ellipse(Vector2(px, hy + 1.0), 5.2, 4.6, 0.0, 10, DRAPE_GOLD.darkened(0.22))
		_soup_ellipse(Vector2(px - 1.2, hy - 0.4), 2.4, 2.1, 0.0, 8, Color(1.0, 0.90, 0.58))


func drape_cord(ex: float, ty: float, band: float, side: float) -> void:
	# THE CORD GOES ALL THE WAY ROUND (2026-07-30, Louis: "it should be a bit lower and
	# completely surround the red drapes, they are what is holding the curtains / drapes to
	# the side"). The first one ran from the wall and STOPPED at the knot, which is why it
	# read as a stick pushed into the curtain rather than a tie holding it: a thing that
	# ends halfway across an object is lying on it, not around it. Three things say
	# "encircling", and all three matter:
	#   1. it crosses the WHOLE bundle and emerges on BOTH sides of the bow, so the eye
	#      joins the two halves into one cord passing behind the knot;
	#   2. it SAGS across the middle, because a band round a soft bundle follows the
	#      bundle's roundness - a dead-straight line is a rod every time;
	#   3. it CURLS AWAY at the leading edge, narrowing and darkening as it turns round the
	#      back, which is the only view you ever get of the far side of a loop.
	# ...and a shadow under it on the velvet, because the cloth is being squeezed.
	var n := 18
	# HOW FAR PAST THE RED IT REACHES, and this went wrong in both directions before it was
	# right (2026-07-30, Louis: "should extend inwards a bit more: just past the red, right now
	# it stops too early and doesn't seem to loop around the curtains"). At 1.10 it was a long
	# gold tongue hanging in the dark beside the curtain; cut back to 1.00 it stopped exactly ON
	# the edge, which reads as a cord that ends at the cloth rather than one that goes round it.
	# **A loop is only legible if a little of its FAR side shows**, and "a little" is the whole
	# specification: enough to turn, not enough to hang in the air. 1.065 is about 7px at 1280,
	# and it only reads as behind-the-drape because the overhang also dives, narrows to a point
	# and drops to a third of its brightness across those 7px - a bright, level, blunt stub the
	# same size would read as a peg sticking out.
	var over := 1.065
	var top := PackedVector2Array()
	var bot := PackedVector2Array()
	var dim := PackedFloat32Array()
	for k in n + 1:
		var u := float(k) / float(n) * over
		var wrap := clampf((u - 0.93) / 0.135, 0.0, 1.0)   # 0 across the front, 1 round the back
		var x := ex + side * band * u
		# the sag across the front, plus the dive as it turns round the edge
		# IT CURLS UP, AND IT DOES NOT COME TO A POINT (2026-07-30, Louis: "the golden string is
		# pointy, make sure it points upwards instead of down and make it less pointy by filling
		# in the string above the point/below it"). Two separate faults in one shape. Diving
		# DOWN put the end below the cord's own line, which is where a loose hanging tail would
		# be - so it read as a second, droopy tassel rather than as the cord turning behind the
		# drape; going UP is the near side of a loop rising over the bundle, which is the read
		# wanted. And tapering to 0.5px made a spike: a cord has THICKNESS all the way to where
		# it disappears, so it keeps most of it (2.6 of 4.6) and simply stops.
		var y := ty + 3.4 * sin(PI * minf(u, 1.0)) - 7.0 * wrap * wrap
		var h := lerpf(4.6, 2.6, wrap)
		top.append(Vector2(x, y - h))
		bot.append(Vector2(x, y + h))
		dim.append(wrap)
	# THE SHADOW IS ITS OWN PASS, and that is not tidiness. Emitted inside the segment loop
	# it lands AFTER the cord it belongs under, and the soup draws in append order - so
	# every segment's shadow was painted over the next segment's gold.
	for k in n:
		_soup_line(bot[k] + Vector2(0.0, 1.0), bot[k + 1] + Vector2(0.0, 1.0), 5.0,
			Color(0.0, 0.0, 0.0, 0.26 * (1.0 - dim[k])))
	for k in n:
		var f := 1.0 - 0.70 * dim[k]          # the back of the loop is in shadow
		var g := 1.0 - 0.70 * dim[k + 1]
		_soup_quad(top[k], top[k + 1], bot[k + 1], bot[k],
			DRAPE_BOW.darkened(1.0 - f), DRAPE_BOW.darkened(1.0 - g),
			DRAPE_BOW_DK.darkened(1.0 - g), DRAPE_BOW_DK.darkened(1.0 - f))


func drape_bow(p: Vector2, sc: float, side: float) -> void:
	# THE TIEBACK, at the pinch and not at the corner (2026-07-30, Louis: "a small golden
	# bowtie holding them to the side"). A tieback is a band round the gathered cloth with
	# a bow at the knot, so it belongs where the leg is narrowest - which is where the
	# silhouette table says it is, never a hand-picked y.
	# A FLAT FILL IS WHAT GIVES A SMALL OBJECT AWAY, and this bow proved it twice. The
	# first was four flat tan polygons; at 34px across that reads as cardboard, the two
	# loops merged into one lopsided egg because nothing separated them, and the strap ran
	# straight through the middle like a stick through it. Three fixes, in order of how
	# much each one bought: the loops are SHADED from the centre out (`_soup_fan_lit`, the
	# same free-gradient trick the cloth uses); they are pushed apart so a notch of velvet
	# shows between them, which is the only thing that says "two loops" rather than "a
	# blob"; and the strap now STOPS at the knot instead of crossing it.
	var lit := DRAPE_BOW.lightened(0.30)
	# a soft shadow first, so the bow sits ON the cloth rather than in it
	_soup_ellipse(p + Vector2(0.0, 0.18 * sc), sc * 1.55, sc * 0.72, 0.0, 12,
		Color(0.0, 0.0, 0.0, 0.30))
	# the two ribbon tails, under everything else - a cut ribbon end is NOTCHED, and at
	# this size that notch is the whole difference between a ribbon and a spike
	for tail: float in [-1.0, 1.0]:
		var dir := Vector2(tail * 0.30, 1.0).normalized()
		var nrm := Vector2(-dir.y, dir.x)
		var tip := p + dir * sc * 1.30
		var ring := PackedVector2Array([
			p - nrm * sc * 0.17, p + nrm * sc * 0.17,
			tip + nrm * sc * 0.26, tip - dir * sc * 0.15, tip - nrm * sc * 0.26,
			p - nrm * sc * 0.17])
		_soup_fan_lit(p.lerp(tip, 0.55), ring,
			DRAPE_BOW if tail * side > 0.0 else DRAPE_BOW_DK.lightened(0.10),
			DRAPE_BOW_DK)
	# THE LOOPS. Swept, not listed: what says "ribbon doubled back on itself" is the CURVE
	# of the outer edge, and the far one is the darker, so the bow has a front and a back.
	for wing: float in [-1.0, 1.0]:
		var ring := PackedVector2Array()
		for k in 17:
			var a := lerpf(-PI * 0.78, PI * 0.78, float(k) / 16.0)
			var rr := sc * (0.45 + 0.42 * cos(a * 0.62))   # full at the tip, pinched at the knot
			ring.append(p + Vector2(wing * (0.42 * sc + cos(a) * rr), sin(a) * rr * 0.78))
		ring.append(ring[0])
		var near := wing * side > 0.0
		_soup_fan_lit(p + Vector2(wing * 0.70 * sc, -0.06 * sc), ring,
			lit if near else DRAPE_BOW, DRAPE_BOW if near else DRAPE_BOW_DK)
	# the knot, sitting proud of both loops with its own little highlight
	_soup_ellipse(p, 0.30 * sc, 0.36 * sc, 0.0, 12, DRAPE_BOW_DK)
	_soup_ellipse(p + Vector2(-0.03 * sc, -0.03 * sc), 0.24 * sc, 0.29 * sc, 0.0, 12, DRAPE_BOW)
	# the highlight is a SHEEN, not a pearl - a hard white speck on a 5px knot reads as a
	# bead stuck to the bow, which is the coin's own "a lighter mark reads as something
	# stuck on rather than pressed in" finding at a different scale
	_soup_ellipse(p + Vector2(-0.09 * sc, -0.11 * sc), 0.11 * sc, 0.09 * sc, 0.0, 8,
		Color(1.0, 0.94, 0.72, 0.72))


func drape_bake(s: Vector2, fy: float) -> void:
	# Built through the SOUP helpers the flower pile already owns, then lifted out into the
	# drapes' own arrays - one vocabulary of shapes, one emit. Cleared at both ends because
	# the soup is a shared scratch buffer and nothing else may inherit half a curtain.
	_soup_clear()
	for side: float in [1.0, -1.0]:
		drape_leg(s, fy, side)
	drape_pelmet(s)       # over the legs: the border hangs in front of them in a real house
	var tie: Vector2 = DRAPE_SILHOUETTE[DRAPE_TIE_KEY]
	var reach := s.x * DRAPE_REACH
	for side: float in [1.0, -1.0]:
		var ex := 0.0 if side > 0.0 else s.x
		var ty := fy * tie.x
		# where the cloth's leading edge ACTUALLY is at the tieback row - width and sway,
		# read off the same two functions the curtain is drawn with. The strap stops at 94%
		# of it, so a sliver of velvet always shows past the gold.
		var band := reach * drape_width(tie.x) * drape_sway(tie.x)
		drape_cord(ex, ty, band, side)
		drape_bow(Vector2(ex + side * band * 0.52, ty), reach * 0.098, side)
	_drape_pts = _soup_pts.duplicate()
	_drape_cols = _soup_cols.duplicate()
	_drape_idx = _soup_idx.duplicate()
	_drape_for = s
	_drape_fy = fy
	_soup_clear()


func menu_drapes(s: Vector2, fy: float) -> void:
	# THE PROSCENIUM, rebuilt (2026-07-30, Louis: "fix my title screen curtains, they look
	# ai made and horrible"). They were a stack of `draw_circle`s down each edge with a
	# `draw_arc` tracing every rim, which is the tell exactly: the PRIMITIVE was visible
	# instead of the object. Six discs and six circular outlines, alternating tones picked
	# per shape rather than by any light, and not one vertical line in a thing that hangs.
	# Cloth falls, so it is a corrugated sheet under one lamp - see drape_velvet.
	if _drape_for != s or _drape_fy != fy or _drape_idx.is_empty():
		drape_bake(s, fy)
	RenderingServer.canvas_item_add_triangle_array(get_canvas_item(), _drape_idx, _drape_pts, _drape_cols)


func menu_house_light(s: Vector2, fy: float) -> void:
	# THE TITLE SCREEN'S LIGHT, AND THE LAST SPOTLIGHT CONE IN THE GAME IS OUT (2026-08-15).
	#
	# When the stage cones came out the rule they left behind was that light must name a
	# source the picture actually contains, and it was applied to the seven venues. It was
	# not applied HERE, on the screen every player sees first and longest - and this frame
	# is the worst case for it, not an exception. There is nothing above the curtain: the
	# velvet and its swags run clean off the top edge of `ui/menu_backdrop`, so a hard warm
	# triangle hung from y=0 is a beam out of the ceiling of a room with no ceiling in it.
	#
	# IT ALSO READ AS TWO. This is worth recording because it is a general trap and not a
	# quirk of one picture: a low-alpha wedge laid over VERTICAL folds is brightened by the
	# fold pattern underneath, so the pale cloth inside the beam reads as beam and the dark
	# fold down its middle reads as a gap between two of them. Measured on a capture, one
	# `draw_spotlight_cone` call - one triangle, apex at a single point - looked like a
	# crossed pair of follow-spots. Nothing was doubled anywhere in the code. **A soft beam
	# over a striped surface does not stay one beam.**
	#
	# WHAT REPLACES IT IS ALREADY PAINTED IN THE BAKE: the footlights along the stage lip.
	# They are real lamps in the picture, they are the light a house actually puts on its
	# own curtain, and they throw UP - so the wash rises off the boards and dies out before
	# the swags, which is both physically the right direction and compositionally the right
	# one, because it leaves the top corners dark for the drapes to sit in.
	#
	# The mark keeps its halo, a touch stronger than it was (0.13 -> 0.17) to buy back the
	# contrast the cone was providing behind it. A radial glow can do that without drawing
	# an edge, which was always the difference between these two shapes: the halo has no
	# geometry to notice, and the cone was nothing but geometry.
	draw_glow(Vector2(s.x * 0.5, s.y * 0.30), s.y * 0.52, Color(1.0, 0.70, 0.32, 0.17))
	var lift := s.y * 0.34
	draw_gradient_v(Rect2(0.0, fy - lift, s.x, lift),
		Color(1.0, 0.72, 0.34, 0.0), Color(1.0, 0.72, 0.34, 0.10), 12)


func menu_backdrop(s: Vector2) -> void:
	# THE HOUSE: the game's own stage, seen from the audience. A title screen's job is to say what
	# the game IS before a word is read, and this game is a performer walking out in front of a
	# room - so the room is here: hung velvet, swagged curtains across the top corners,
	# footlights along the lip, boards for the menu to stand on. What it replaced was a gradient,
	# one spotlight cone and a row of bulbs floating at the very bottom edge attached to nothing,
	# which is a lit VOID rather than a theatre.
	#
	# THREE OTHER PICTURES WERE BUILT AND ARE DELETED (2026-07-30, Louis: "remove the concepts
	# except the current one"). FIRELIGHT (no set, the mark's own light), NIGHT (the Midnight
	# Show's language, a roofline and lit windows) and THE CURTAIN, CLOSED were rendered to
	# store/concepts/ as `--menu N` variants, Louis picked this one, and the losers came out with
	# the selector - the same rule the F9 panel follows, where an experiment that wins leaves the
	# panel and the version it beat is deleted rather than left stranded behind a switch nobody
	# will ever flip. They are in git, and the renders are in the commit that added them.
	#
	# Every piece of this is furniture the stage already owns, which is the point: the title screen
	# should be a room this game already has, not a fifth art style.
	var fy := s.y * MENU_FLOOR
	# SEAM: the proscenium is a BAKED PICTURE (ui/menu_backdrop), because every layer of it
	# below is static - measured, the only thing in this whole function that moves is the
	# dust, which is why the dust alone stays procedural and is drawn on top. Nothing here
	# has to react to play the way a venue's spotlight cone does, so there is no reason for
	# the title screen to be redrawing a hundred polygons a frame either.
	#
	# It is the LAST vector picture on the most-seen screen in the game: measured 35%
	# off-grid by scripts/check_pixel_grid.py, the worst of all 32 screens, with crisp
	# pixel props sitting on smooth antialiased velvet. See scripts/pixelise_menu.py for
	# how the bake is made and why it dithers rather than banding flat.
	if art_blit_rect("ui/menu_backdrop", Rect2(Vector2.ZERO, s)):
		# THE BAKE IS SCENERY. THE LIGHT IS STILL LIVE - the same split draw_backdrop makes
		# for a venue, and for the same reason: a picture with its lighting painted in can
		# never be lit differently. Here it also earns its keep twice over, because the veil
		# is what buys the wordmark its contrast, and the sprite is a good deal brighter
		# than the drawing it replaced.
		draw_rect(Rect2(0, 0, s.x, fy), Color(0.04, 0.015, 0.025, 0.34))
		menu_house_light(s, fy)
		# THE APRON FALLS AWAY at the very front of the stage, which does two jobs. The
		# boards in the sprite are warm and bright - much brighter than the near-black
		# floor they replaced - and the key hint sits on them in plain grey with no
		# outline, so it had almost no contrast left. It also grounds the room: a lit
		# stage that runs at full brightness right off the bottom edge of the screen
		# reads as a wall, not a floor. Starts below the footlights so it dims the boards
		# and never the lamps.
		draw_gradient_v(Rect2(0, s.y - 54.0, s.x, 54.0),
			Color(0.03, 0.012, 0.02, 0.0), Color(0.03, 0.012, 0.02, 0.78), 10)
		draw_dust(s, 22, Color(1.0, 0.85, 0.55))
		return
	draw_gradient_v(Rect2(0, 0, s.x, s.y), Color(0.135, 0.058, 0.078), Color(0.045, 0.022, 0.032), 22)
	draw_curtain_wall(s, fy, 0.0, Color(0.150, 0.038, 0.055), 26)
	# THE VEIL, the same move draw_backdrop makes over a venue's set dressing and for the same
	# reason: this cloth is BEHIND the mark and has to lose to it. The first pass had the curtain
	# at 0.255 red with no veil, and the S's warm balls sat on warm cloth of nearly their own
	# value - the wordmark, the one thing on the screen that must read instantly, had the least
	# contrast on it.
	draw_rect(Rect2(0, 0, s.x, fy), Color(0.04, 0.015, 0.025, 0.34))
	menu_house_light(s, fy)
	# THE SWAGS GO IN FRONT OF THE VEIL AND THE LIGHT, where draw_theatre_boxes used to be (see
	# menu_drapes for why the boxes went). Order is the whole difference between cloth and a stain:
	# they are the proscenium, the nearest thing in the room, so the veil that pushes the back wall
	# behind the mark must not also wash them out, and the spotlight cone must not lie over them.
	menu_drapes(s, fy)
	draw_footlights(s, fy)
	# the boards, painted LAST over the dressing, with the warm lip draw_backdrop uses - anything
	# drawn at the floor line itself is buried under them, which is the trap the theatre's own
	# furniture note already records
	draw_rect(Rect2(0, fy, s.x, s.y - fy), Color(0.20, 0.105, 0.085))
	draw_gradient_v(Rect2(0, fy, s.x, 34.0), Color(1.0, 0.72, 0.34, 0.13), Color(1.0, 0.72, 0.34, 0.0), 8)
	draw_line(Vector2(0, fy), Vector2(s.x, fy), Color(1.0, 0.74, 0.36, 0.5), 3.0)
	for i in 9:   # plank seams, faint: texture without pattern
		var px2 := s.x * (float(i) + 0.5) / 9.0
		draw_line(Vector2(px2, fy + 2.0), Vector2(px2 + s.x * 0.04, s.y), Color(0.0, 0.0, 0.0, 0.10), 1.5)
	draw_dust(s, 22, Color(1.0, 0.85, 0.55))


func menu_rows(font: Font, s: Vector2, oy: float) -> void:
	# THE MENU AS CARDS, which is the part of this that is not taste (2026-07-30). Settings and
	# Pause were both rebuilt off bare `draw_string` rows into the shared card language in July,
	# for the reason written down there - a flat row of centred text reads as cheap next to the
	# shop and the sheet. The TITLE screen was the last one still doing it, on the screen that
	# makes the first impression. Same three options, same `menu_sel`, same `menu_input`: an icon
	# disc saying what the row does, the name, a line under it saying where it goes, and the lit
	# one raised on its own colour. Nothing here touches the list - `menu_options()` is still the
	# only place that decides what the rows ARE.
	# THE THREE ACCENTS ARE THE THEATRE'S, NOT A TRAFFIC LIGHT'S (2026-08-13). They were a
	# leaf green, a pale sky blue and a salmon - the generic go/neutral/stop triad, and the
	# only cold colours anywhere on a screen that is otherwise crimson drape, gold fringe and
	# warm footlight. On the one screen that makes the first impression, the menu read as a
	# different game's UI pasted over this game's proscenium.
	#
	# The replacements are the game's OWN language rather than three new colours: Play takes
	# CARD_TRICK_COL's warm gold, which is already what "the thing you came for" looks like
	# everywhere else here - the lit shop card, the lit skill, the selected venue. Settings
	# drops to a warm stone that reads as secondary without competing. Quit keeps a red,
	# pulled off salmon and onto the drapes' own crimson.
	#
	# Nothing about the LAYOUT moves: same rows, same menu_sel, same soft_card. A menu row is
	# still the shared card language; it is just printed in the house colours now.
	var dress := {
		"Play":     {"note": "take the stage", "col": CARD_TRICK_COL, "icon": "play"},
		"Settings": {"note": "sound, feel, controls", "col": Color(0.80, 0.73, 0.60), "icon": "dials"},
		"Quit":     {"note": "leave the theatre", "col": Color(0.86, 0.38, 0.34), "icon": "quit"},
	}
	var opts := menu_options()
	var cw := 340.0
	var ch := MENU_ROW_H
	var gap := MENU_ROW_GAP
	var cx0 := s.x * 0.5 - cw * 0.5
	for i in opts.size():
		var nm := String(opts[i])
		var d: Dictionary = dress.get(nm, {"note": "", "col": Color(0.9, 0.8, 0.6), "icon": "play"})
		var ac: Color = d["col"]
		var sel := i == menu_sel
		var cy := oy + float(i) * (ch + gap) - (3.0 if sel else 0.0)
		soft_card(Rect2(cx0, cy, cw, ch),
			Color(ac.r * 0.19, ac.g * 0.19, ac.b * 0.19, 0.94) if sel else Color(0.085, 0.055, 0.065, 0.80),
			Color(ac.r, ac.g, ac.b, 0.92 if sel else 0.28), 2.0 if sel else 1.0, 11.0, 12.0)
		var ic := Vector2(cx0 + 36.0, cy + ch * 0.5)
		icon_disc(ic, 16.0, Color(ac.r, ac.g, ac.b, 0.22),
			Color(ac.r, ac.g, ac.b, 0.9 if sel else 0.5), 2.0)
		match String(d["icon"]):
			"play":
				draw_colored_polygon(PackedVector2Array([
					ic + Vector2(-5, -7), ic + Vector2(-5, 7), ic + Vector2(8, 0)]), ac)
			"dials":
				# two sliders, which is what the settings screen's own pill toggles look like -
				# a cog would be a mark this game draws nowhere else
				for r2 in 2:
					var ry := ic.y - 4.0 + float(r2) * 8.0
					draw_line(Vector2(ic.x - 7.0, ry), Vector2(ic.x + 7.0, ry), Color(ac.r, ac.g, ac.b, 0.75), 1.6)
					draw_circle(Vector2(ic.x + (3.0 if r2 == 0 else -3.0), ry), 2.6, ac)
			"quit":
				draw_line(ic + Vector2(-6, -6), ic + Vector2(6, 6), ac, 2.5)
				draw_line(ic + Vector2(6, -6), ic + Vector2(-6, 6), ac, 2.5)
		draw_fit_string(font, Vector2(cx0 + 64.0, cy + 25.0), nm, HORIZONTAL_ALIGNMENT_LEFT,
			cw - 84.0, 20, Color(1.0, 0.96, 0.86) if sel else Color(0.87, 0.82, 0.75))
		draw_fit_string(font, Vector2(cx0 + 64.0, cy + 43.0), String(d["note"]),
			HORIZONTAL_ALIGNMENT_LEFT, cw - 84.0, 12,
			Color(ac.r, ac.g, ac.b, 0.95) if sel else Color(0.62, 0.58, 0.54))


func draw_menuref(s: Vector2) -> void:
	# --menuref: the title backdrop ALONE, at full size, with no wordmark, no menu cards,
	# no version stamp and NO DUST. It is the source pixelise_menu.py reduces.
	#
	# The dust is left out on purpose and is the reason this flag exists rather than just
	# cropping a --menu capture: it is the one moving layer, so baking a frame of it would
	# freeze twenty-two motes into the velvet forever, and they would then also be doubled
	# by the live layer drawn over the sprite.
	#
	# art_on is already false whenever a ref flag is set, so this photographs the DRAWING
	# and never a bake that is already replacing it - otherwise every re-run would reduce
	# its own previous output and the picture would soften a little each time.
	var fy := s.y * MENU_FLOOR
	draw_gradient_v(Rect2(0, 0, s.x, s.y), Color(0.135, 0.058, 0.078), Color(0.045, 0.022, 0.032), 22)
	draw_curtain_wall(s, fy, 0.0, Color(0.150, 0.038, 0.055), 26)
	# NO VEIL, NO CONE, NO GLOW HERE, unlike menu_backdrop's own order: those three are
	# LIGHT, and the seam draws them live over the sprite. Baking them would double them
	# on every future re-bake and freeze the one part of this picture that is allowed to
	# change. Scenery only, which is exactly the line --bgref draws for a venue.
	menu_drapes(s, fy)
	draw_footlights(s, fy)
	draw_rect(Rect2(0, fy, s.x, s.y - fy), Color(0.20, 0.105, 0.085))
	draw_gradient_v(Rect2(0, fy, s.x, 34.0), Color(1.0, 0.72, 0.34, 0.13), Color(1.0, 0.72, 0.34, 0.0), 8)
	draw_line(Vector2(0, fy), Vector2(s.x, fy), Color(1.0, 0.74, 0.36, 0.5), 3.0)
	for i in 9:
		var px2 := s.x * (float(i) + 0.5) / 9.0
		draw_line(Vector2(px2, fy + 2.0), Vector2(px2 + s.x * 0.04, s.y), Color(0.0, 0.0, 0.0, 0.10), 1.5)


func draw_menu(font: Font, s: Vector2) -> void:
	var cx := s.x * 0.5
	menu_backdrop(s)

	# THE TITLE, and everything under it placed off the MARK'S REAL BOTTOM rather than off
	# a guess (2026-07-28). The prop mark is a picture, not a line of type: the A's torch
	# handles hang below the baseline and its flames climb well above the cap line, so the
	# old `title y + 112` put the divider straight through the torches. mark_height() is
	# computed from the same MARK_RISE/MARK_DROP the drawing uses, so growing the mark
	# moves the divider instead of colliding with it.
	# NO CASCADE ABOVE IT ANY MORE. A small juggling loop used to arc over the title,
	# because the title was a static word and the screen needed something alive on it.
	# The mark IS alive now - two torches burning, embers leaving them - and a second
	# animated ornament directly above competes with it for the same attention. There is
	# also no room: at title size the mark starts a sixth of the way down the screen, and
	# the cascade was being clipped by the top edge. (draw_menu_cascade is still used by
	# the key art and the credits, where the mark is smaller and the room is there.)
	# AND THE MENU ROWS COME OFF IT TOO (2026-07-29). The divider and the subtitle were
	# already placed off mark_height(), which is exactly right, but the three options
	# underneath sat at a flat `s.y * 0.62` - so the moment the A grew, the subtitle was
	# drawn straight through the word Play. Half a layout computed and half of it guessed
	# is the same bug as guessing all of it, it just waits longer to show up.
	# THE ROWS STAND ON THE BOARDS. `oy` was a flat fraction of the screen with a mark_height()
	# floor under it; now the three cards are laid so their FEET land on the stage lip, which is
	# what makes them furniture in the room rather than text floating over a picture of one. Still
	# computed off mark_height() at the top end, so a taller A pushes them down instead of drawing
	# through them - the bug that rule exists for.
	# THE TAGLINE IS GONE (2026-07-30, Louis: "Remove 'a juggler's climb'"), on the capsule too.
	# THE MENU IS PLACED FIRST NOW, AND THE MARK IS CENTRED IN WHAT IS LEFT (2026-07-30, Louis: "i
	# like the tossa word, but move it down a little, so it's centered between the top of the
	# screen and the Play button. There shouldn't be much room between the yellow thin line and
	# the play button itself"). The order matters and it is the whole fix: the mark used to be
	# pinned at 0.10 of the screen with the rows hung off ITS bottom, so the mark could not be
	# centred against the rows without knowing where the rows were - and they depended on it. Rows
	# from the stage lip, mark centred above them, divider tucked up against the rows.
	var nrows := menu_options().size()
	var rows_h := MENU_ROW_H * float(nrows) + MENU_ROW_GAP * float(nrows - 1)
	# the rows stand ON the boards with their feet clear of the lip, not straddling it. The lip is a
	# bright 3px line with the footlights burning just above it, so a card crossing it gets a hot
	# line and a row of bulbs showing through its own bottom edge. The clearance is 16px plus HALF A
	# CARD (Louis: "move the titlescreen menu ... about half the height of one of those option
	# windows, such as Play") - written as MENU_ROW_H * 0.5 rather than as 27, so a taller row lifts
	# the block by the same proportion.
	var oy := s.y * MENU_FLOOR - rows_h - 16.0 - MENU_ROW_H * 0.5
	# ...and the title's mark is width-clamped, for the same reason the capsules are: MENU_MARK is a
	# pixel height chosen against a 1280-wide window, and the game does not promise to be 1280 wide.
	var msz := int(round(mark_fit_size(s, float(MENU_MARK))))
	# THE MARK SITS ON THE DIVIDER NOW, NOT CENTRED ABOVE IT (2026-07-30, Louis: "Tossa should be
	# moved down, until it sits right above the thin yellow line - don't move the yellow line
	# tho"). Centring the mark in the empty space above `oy` left a growing gap under it as the
	# mark shrank to fit a narrow window, which is the opposite of the ask: the DIVIDER is the
	# fixed point (still MENU_ORN_LIFT above the first card, untouched), and the mark is placed
	# a small gap above THAT instead.
	var divider_y := oy - MENU_ORN_LIFT
	var mark_top := maxf(divider_y - 16.0 - mark_height(float(msz)), 6.0)
	var mark_bot := mark_top + mark_height(float(msz))
	draw_wordmark(mark_top, msz, Color(1.0, 0.88, 0.5), s)
	draw_ornament(cx, divider_y, 300.0, Color(0.82, 0.62, 0.34, 0.85))
	menu_rows(font, s, oy)
	var mfoot := "Up / Down to choose    A to select" if pad_active() else "Up / Down to choose    Enter to select"
	draw_string(font, Vector2(0, s.y - 40.0), mfoot, HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(15), Color(0.7, 0.66, 0.6))
	if OS.is_debug_build():   # a build number is dev-only furniture - a shipped title
		draw_string(font, Vector2(s.x - 140.0, s.y - 34.0), "v0.9", HORIZONTAL_ALIGNMENT_RIGHT, 110.0, ps(12), Color(0.6, 0.55, 0.5, 0.7))   # screen never shows one

	draw_vignette(s, 0.5)
	# NO GOLD FRAME ON THE TITLE SCREEN (2026-07-30, Louis: "Why is there a thin light
	# brown rectangle around the titlepage?"). It is `draw_frame`, a decorative double border
	# with corner ticks that nine screens share - and on the other eight it is doing a real
	# job, giving a flat UI page an edge. This screen is not a page, it is a ROOM, and it now
	# has a proscenium: the pelmet across the top and a leg down each side ALREADY frame the
	# picture, in perspective, out of the set itself. A rectangle ruled over that is a second
	# frame around the first, which is why it read as a stray line rather than as decoration.


func _cascade_pos(t: float, i: int, count: int, hl: Vector2, hr: Vector2, T: float, peak: float) -> Vector2:
	var phase := fposmod(t + float(i) * (T * 2.0 / float(maxi(1, count))), T * 2.0)
	var seg := 0 if phase < T else 1
	var u := (phase - float(seg) * T) / T
	var frm := hl if seg == 0 else hr
	var to := hr if seg == 0 else hl
	var p := frm.lerp(to, u)
	p.y -= peak * 4.0 * u * (1.0 - u)   # a parabolic arc
	return p


func draw_menu_cascade(center: Vector2, sc: float) -> void:
	# a calm, high cascade: much slower than the gameplay demo, each ball trailing a
	# soft comet of faded echoes so the motion reads as elegant rather than busy
	var count := 3
	var T := 112.0                       # slow half-cycle (the gameplay demo uses 52)
	var peak := 104.0 * sc
	var spanx := 76.0 * sc
	var hl := center + Vector2(-spanx, 42.0 * sc)
	var hr := center + Vector2(spanx, 42.0 * sc)
	var t := float(cine_tick) * 0.5      # slow, graceful clock
	for i in count:
		var col := ball_color(i)
		for k in range(10, 0, -1):       # trail: faded echoes back along the path
			var pp := _cascade_pos(t - float(k) * 3.0, i, count, hl, hr, T, peak)
			var a := 0.11 * (1.0 - float(k) / 11.0)
			draw_circle(pp, (12.5 - 0.75 * float(k)) * sc, Color(col.r, col.g, col.b, maxf(a, 0.0)))
		# the shared ball - this motif sits directly under the wordmark on the key art and in
		# the credits, where the S's are made of `cap_ball`s, so a flat disc here put two
		# different balls in one picture
		cap_ball(_cascade_pos(t, i, count, hl, hr, T, peak), col, BALL_RADIUS_PX * 1.35)


func capsule_embers(c: Vector2, r: float, n: int, col: Color) -> void:
	# the fire's own litter: sparks climbing off a flame, sized down as they rise. Cheap,
	# and it is the thing that stops a big flame reading as a flat orange shape.
	for i in n:
		var t := fposmod(float(i) * 0.618, 1.0)
		var up := 0.15 + 1.05 * t
		var px := c.x + sin(float(i) * 2.3) * r * 0.42 * up
		var py := c.y - r * up
		var a := (1.0 - t) * col.a
		draw_circle(Vector2(px, py), maxf(1.0, r * 0.035 * (1.0 - t * 0.7)), Color(col.r, col.g, col.b, a))
		if i % 3 == 0:
			draw_star4(Vector2(px, py), r * 0.06 * (1.0 - t), Color(1.0, 0.95, 0.8, a * 0.8))


# CAPSULE-ONLY PROPS (2026-07-28, Louis: "add more details to the objects ... far more
# than in game is required, because that would make the gameplay laggy ... absolutely
# gorgeous objects that look amazing even when zooming in a lot"). These are deliberately
# extravagant: dozens of extra shapes per object, which is fine for ONE still frame and
# would be indefensible on fifteen props at 120Hz. Nothing in here is reachable from the
# stage - draw_ball_shape and friends are untouched and stay cheap.
#
# THE SCALE IS REAL (same session). A juggling ball is ~70mm, a ring ~320mm, a torch
# ~480mm, so a ball is a 4.6th of a ring and a 6.9th of a torch. The mark drew it at a
# 6.9th and a 9.6th - a pea beside them - and BOTH references independently said the ball
# should be about 1.44x bigger, which is CAP_BALL_R below. Louis spotted it by eye first.
const CAP_BALL_R := 0.119     # a ball's radius, in units of the mark's letter height
const CAP_S_R := 0.245        # the radius of each of the S's two loops. Up from 0.225 on
							   # 2026-07-30 (Louis: "You can add one extra ball to each S, in
							   # order to make it smoother and slightly larger") - the extra ball
							   # is what buys the room to grow the loop without the balls parting
							   # company, so the two halves of that note are one change.
							   # THE SPACING IS THE WHOLE POINT and it is arithmetic, not taste.
							   # A loop carries its balls over a 1.5PI arc, so the gap between
							   # neighbours is 1.5 * PI * CAP_S_R / (CAP_S_BALLS - 1) letter
							   # heights against a ball 2 * CAP_BALL_R across: at 6 balls and
							   # 0.245 that is 0.231 against 0.238, so they overlap by 3% and the
							   # eye follows one curve. At the old 5 and 0.225 it was 0.265
							   # against 0.238 - a visible gap between every pair, which is why
							   # each S read as a cluster of separate balls. Seven was tried once
							   # and closed the stroke into a solid ring instead.
const CAP_S_BALLS := 6    # ...of which the first of each loop and the last of the BOTTOM loop are
						   # not drawn, so five land on the top loop and four on the bottom. The
						   # dropped ones are the outer TIPS, where an S doubles back on itself and
						   # the balls crowd; the top loop keeps its last ball because that one is
						   # the WAIST where the two loops meet, not a tip, and dropping it from
						   # both loops (as happened until 2026-07-30) cuts the letter in half.
# THE KNIFE'S OWN MEASUREMENTS, so the layout never has to guess them. Local units, the
# same ones cap_knife draws in: the point is at -26 and the butt cap ends at +16.3.
const CAP_KNIFE_TIP := -26.0
const CAP_KNIFE_BUTT := 15.6   # the stage knife's own pommel edge (13.2 + its 2.4 radius)
const CAP_KNIFE_LEN := CAP_KNIFE_BUTT - CAP_KNIFE_TIP          # 42.3, tip to butt
const CAP_KNIFE_MID := (CAP_KNIFE_TIP + CAP_KNIFE_BUTT) * 0.5  # -4.85, the balance point
# THE CLUB'S FOUR MEASUREMENTS USED TO LIVE HERE and they are gone (2026-07-30): the club was
# the A's crossbar for one day, and a ball replaced it, so CAP_CLUB_KNOB / _TIP / _LEN / _MID
# had no reader left but each other. The club's own extent is `CLUB_BUTT_Y` / `CLUB_NOSE_Y`,
# beside the profile table that draws it, which is where a prop's measurements belong anyway -
# this block only ever existed because the LAYOUT needed them out here.
# THE A IS TWO CLUBS AND A DASH OF BALLS (2026-07-30, Louis). It was two TORCHES with a fire at
# the apex, and `CAP_TORCH_SHAFT` / `CAP_TORCH_SC` / `CAP_A_FIRE_SC` are deleted with them - three
# constants that between them tuned a flame this letter no longer has. Their history is in git and
# the short version is worth keeping, because it is why the letter is clubs now: a torch is 19
# units of handle under 22 of fire, so for three passes the strokes could not be lengthened
# without the flame growing with them, and every version read as a campfire rather than a letter.
# A club is all stroke and has a NOSE where a torch has a wick, so the apex is a point.
const CAP_A_LEAN := 0.46       # how far each of the A's strokes leans off vertical, radians. The
							   # two clubs MEET at their noses, so this angle and the club's own
							   # length together decide how wide the letter stands: any bigger and
							   # the A splays, any smaller and it is a candle. Unchanged from the
							   # torch version, which is why the letter's proportions did not move
							   # when the object inside it did.
const CAP_A_CLUB_SC := 0.0296  # 7% larger than the stage-fit scale. capsule_mark lowers their
							   # baseline by the same proportion, keeping the apex while the knobs
							   # reach the bottom of the neighbouring S.
const CAP_CROSSBAR_AT := 0.34  # how far up the strokes the crossbar sits, 0 knob, 1 nose
# THE CROSSBAR'S OWN SIZE CONSTANT IS GONE (2026-07-30). It was CAP_A_BALL, the ball's radius as
# a fraction of the gap between the strokes - which is exactly the wrong way round to size it. A
# ball in this mark is a BALL, so its radius is CAP_BALL_R like every other one, and the gap is
# bridged by using more of them. Its predecessor CAP_CROSSBAR_OVER (1.22) went the same way: a
# club had to reach PAST the strokes to be seen at all between two dark handles, and a row of
# round objects does not.
# THE PICTURE HAS A LIGHT SOURCE IN IT, so everything obeys it (2026-07-28, Louis: "a
# sharper image with everything on it that would be in real life"). Two torches burn at
# the right-hand end of the word. In a dark room that is the brightest thing in frame by
# far, so every prop to their left picks up a warm rim on its RIGHT side, and the steel -
# which is a mirror, and the one material here that shows its surroundings - picks up a
# whole warm band. Adding detail without adding this is what makes a still frame read as
# a row of stickers: the objects were beautifully drawn and lit by nothing.
const CAP_FIRE := Color(1.0, 0.58, 0.20)   # what the torches throw onto everything else
# THE MARK FADES AS ONE THING (2026-07-28). The wordmark is drawn on screens that fade it
# in and out - the credits roll it past, the final card fades it up - and the picture is
# made of sixty-odd separate shapes with their own alphas. Rather than thread an alpha
# argument through every prop and every highlight, `capsule_mark` sets this multiplier for
# the duration of one mark and every colour in the picture passes through `ca()`.
# It is a DRAW-TIME multiplier, never stored state: capsule_mark always restores it, so
# nothing drawn afterwards can inherit a half-faded mark.
var _cap_a := 1.0

# THE ART GRID, EXPRESSED IN THE CURRENT UNIT SPACE. The card art and the wordmark both draw
# in fractions of a size k under draw_set_transform(origin, 0, Vector2.ONE * k), so a screen-
# space snap is meaningless inside them - snapping to 2 would snap to two whole cards. What
# lands on the grid there is a multiple of ART_PIXEL / k, PROVIDED the transform's origin is
# itself art-snapped. Set it beside _cap_a whenever a unit space is entered; 0.0 means "not in
# one", and every helper below then falls back to its smooth original.
var _cap_px := 0.0

func ca(c: Color) -> Color:
	return Color(c.r, c.g, c.b, c.a * _cap_a) if _cap_a < 1.0 else c


func cap_grid(k: float) -> float:
	# the unit-space pitch for a space scaled by k, or 0 if k is too small to be worth it
	return (ART_PIXEL / k) if k > ART_PIXEL else 0.0


func cap_disc(c: Vector2, r: float, col: Color) -> void:
	# A FILLED CIRCLE IN UNIT SPACE, on the art grid - the same row-by-row rasteriser as
	# fill_disc_pix, but stepping in units of _cap_px instead of screen pixels.
	#
	# The card faces were full of draw_circle: eyes, hubs, berries, the ballerina's bun. Every
	# one of them antialiases its rim, and a soft rim is what stops a 20px circle reading as a
	# drawn shape and makes it read as a blur - beside polygons that are already hard-edged,
	# on the one screen the player stops to look at.
	if _cap_px <= 0.0:
		draw_circle(c, r, col)
		return
	var g := _cap_px
	var rows := int(ceil(r * 2.0 / g)) + 2
	var y0 := snappedf(c.y - r, g)
	for i in rows:
		var y := y0 + float(i) * g
		var dy := (y + g * 0.5) - c.y          # sample each row at its CENTRE
		if absf(dy) > r:
			continue
		var half := sqrt(maxf(0.0, r * r - dy * dy))
		var x0 := snappedf(c.x - half, g)
		var w := snappedf(half * 2.0, g)
		if w >= g:
			draw_rect(Rect2(x0, y, w, g), col)


func cap_ell(c: Vector2, rx: float, ry: float, col: Color) -> void:
	# ...and an ellipse, which is the same solve with the row scaled
	if _cap_px <= 0.0 or rx <= 0.0 or ry <= 0.0:
		fill_ellipse(c, rx, ry, col)
		return
	var g := _cap_px
	var rows := int(ceil(ry * 2.0 / g)) + 2
	var y0 := snappedf(c.y - ry, g)
	for i in rows:
		var y := y0 + float(i) * g
		var t := ((y + g * 0.5) - c.y) / ry
		if absf(t) > 1.0:
			continue
		var half := rx * sqrt(maxf(0.0, 1.0 - t * t))
		var x0 := snappedf(c.x - half, g)
		var w := snappedf(half * 2.0, g)
		if w >= g:
			draw_rect(Rect2(x0, y, w, g), col)


func cap_seg(a: Vector2, b: Vector2, col: Color, w: float = -1.0) -> void:
	# A THICK LINE IN UNIT SPACE, on the art grid. draw_line antialiases, and on a card these
	# are ribbons, seams and whiskers - the thin things, where a soft edge is all there is.
	#
	# Walked along the segment rather than scanned by row, because these are short and often
	# near-horizontal, and a row scan gives a near-horizontal line one enormous row.
	# argument order follows draw_line, so the substitution at the call sites is mechanical
	if _cap_px <= 0.0:
		draw_line(a, b, col, w)
		return
	var g := _cap_px
	if w <= 0.0:
		w = g
	var d := b - a
	var n := maxi(1, int(ceil(d.length() / (g * 0.5))))
	var perp := Vector2(-d.y, d.x).normalized() * (w * 0.5)
	for i in n + 1:
		var t := float(i) / float(n)
		var at := a + d * t
		var m := maxi(1, int(ceil(w / g)))
		for j in m:
			var o := (float(j) - float(m - 1) * 0.5) * g
			var pt := at + perp.normalized() * o if perp.length() > 0.0 else at
			draw_rect(Rect2(snappedf(pt.x, g), snappedf(pt.y, g), g, g), col)


func cap_warm_rim(p: Vector2, r: float, amt: float) -> void:
	# the torch-side rim on a round prop: an arc down its right edge, warm, faint.
	draw_arc(p, r * 0.90, -PI * 0.42, PI * 0.42, 20, ca(Color(CAP_FIRE.r, CAP_FIRE.g, CAP_FIRE.b, amt)),
		maxf(1.0, r * 0.15), true)


func mark_prop(key: String, pos: Vector2, ang: float, long_px: float, tint: Color,
		mid_local: float = 0.0) -> bool:
	# THE WORDMARK'S PROPS, FROM THE SAME ART AS THE SHOP CARD (2026-08-06, Louis: "the shop
	# designs for the objects are decent, use those everywhere! right now the titlescreen and
	# performance uses different ones").
	#
	# The stage was the easy half - prop/* is derived from prop_big/* now, so the objects in
	# the air already match the objects in the shop. The title screen was the third design:
	# capsule_mark draws cap_ball/cap_ring/cap_knife/cap_club DIRECTLY, bypassing the prop
	# seam entirely, so the logo kept the vector drawings after everything else became art.
	#
	# `long_px` is the extent the caller wants along the prop's LONG axis, which is the
	# measurement every letter in the mark is laid out from. The sprite is fitted to it and
	# its short axis follows the art's own aspect, so a letter's spine lands exactly where
	# the drawing would have put it.
	#
	# A FRACTIONAL FIT IS ACCEPTABLE **HERE AND ONLY HERE**, and that is not a lapse in the
	# no-fractional-scale rule: the mark is BAKED (--markref plus scripts/pixelise_mark.py)
	# and the bake reduces the whole composition to the art grid afterwards, so this render
	# is an intermediate that no player ever sees. Do not copy this into a live draw path.
	if not art_bank.has(key):
		return false
	var e: Dictionary = art_bank[key]
	var tex: Texture2D = e["tex"]
	var ts := Vector2(tex.get_size())
	if ts.x <= 0.0 or ts.y <= 0.0:
		return false
	var k := long_px / maxf(ts.x, ts.y)
	# `mid_local` IS THE WHOLE DIFFICULTY WITH THE T AND THE A. cap_knife and cap_club draw
	# from the GRIP, with the business end at negative local y - so the shape is NOT centred
	# on the point the caller passes, and the letters are laid out against that convention
	# (the T deliberately offsets by CAP_KNIFE_MID to hang its crossbar on the balance point
	# rather than on the guard). A sprite quad IS centred. Handing the same anchor to both
	# therefore slides the sprite by half a prop, which on a letterform is not a nudge - the
	# T's bar detaches from its stem. Passing the drawing's own midpoint puts the sprite's
	# centre exactly where the drawing's centre was, and every layout constant still holds.
	# `mid_local` arrives already scaled to pixels by the caller, since only the caller
	# knows which of the prop's own constants its layout was measured against.
	_art_quad(tex, pos + Vector2(0.0, mid_local).rotated(ang), ts * k * 0.5, ang, tint)
	return true


func cap_ball(p: Vector2, col_in: Color, r: float) -> void:
	# THE BALL IS A STITCHED THING, NOT A GLASS ONE (2026-07-28, Louis: the balls "still
	# look a bit strange"). This is the third attempt at a round prop and the first one
	# that resolves the argument the previous two were having, so the reasoning matters.
	#
	# THE ROUND PROPS ARE FLAT rule (2026-07-27) banned painted highlights, for a good
	# reason - a specular is a claim about where the light is, and this stage's light
	# genuinely moves - and then the RICH PROPS pass (2026-07-28) put the shop's lush
	# version on stage, which brought all of it straight back: a shaded disc, a bounce arc,
	# a broad white ellipse, a hot 1.2px core, two 0.6px panel seams and a warm rim wedge.
	# On a moving ball that reads as wet plastic, and half of those marks are inside the
	# sub-pixel band that shimmers frame to frame at r = 11.
	#
	# The way out is not more shading or less shading, it is a different SUBJECT. A juggling
	# ball is a matte sewn ball, and what makes one recognisable at 22px is its PANELS - a
	# feature of the object, true from every angle, no light source implied. So: one flat
	# body, three panels as filled shapes 2-3px wide, one broad soft sheen at low alpha
	# (a wide dim shape cannot shimmer the way a small bright one does), and a concentric
	# rim, which has no direction and therefore states an edge without claiming a lamp.
	# No hairlines, no hot point, no partial thick arc anywhere.
	# EVERY MARK CARRIES THE CALLER'S ALPHA (2026-07-30). The seam and the rim were rebuilt
	# as fresh `Color(r, g, b)` triples, which default to alpha 1 - so a ball asked to draw
	# at a third opacity came out as a faint disc wearing a fully opaque seam and a hard
	# black outline. Nothing exercised it while the only callers were the stage and the
	# shop, both of which pass opaque colours; it surfaced the moment the fading screens
	# (the save cards' dimmed empty slots, draw_tutdone's fade-in kit) were moved onto the
	# shared ball. `ca()` handles the wordmark's fade, `a` handles the caller's - they are
	# two different fades and both have to be applied.
	var a := col_in.a
	var col := ca(col_in)
	var panel := ca(Color(col_in.r * 0.84, col_in.g * 0.82, col_in.b * 0.86, a))
	draw_circle(p, r, col)
	# ONE SEAM, NOT THREE. The first pass drew three panels meeting at an off-centre hub -
	# geometrically how a three-panel ball is cut, and on screen a propeller: three chunky
	# spokes on a disc, which is a windmill or a citrus slice long before it is a ball. A
	# real juggling ball's read at 22px is a single curved seam wandering across it, so that
	# is what this is - one tapered band on an S-curve, widest in the middle, at low
	# contrast. It says "sewn" without adding a shape the eye tries to name.
	var seam := PackedVector2Array()
	var lo := PackedVector2Array()
	for i in 13:
		var u := float(i) / 12.0
		var sx := lerpf(-r * 0.94, r * 0.94, u)
		var sy := sin(u * PI * 2.0) * r * 0.34
		var wid := (0.5 + 0.5 * sin(u * PI)) * r * 0.11
		seam.append(Vector2(p.x + sx, p.y + sy - wid))
		lo.append(Vector2(p.x + sx, p.y + sy + wid))
	lo.reverse()
	seam.append_array(lo)
	draw_colored_polygon(seam, panel)
	# one broad, dim sheen - the diffuse fall-off a matte ball has, not a reflection
	fill_ellipse(p - Vector2(r * 0.22, r * 0.26), r * 0.58, r * 0.46, ca(Color(1, 1, 1, 0.10 * a)))
	# ...and the rim, all the way round, floored so it never enters the shimmering band
	draw_arc(p, r * 0.94, 0.0, TAU, 40, ca(Color(col_in.r * 0.46, col_in.g * 0.44, col_in.b * 0.48, a)),
		maxf(1.7, r * 0.13), true)


func cap_ring(c: Vector2, col_in: Color, R: float) -> void:
	var col := ca(col_in)
	# the ring as a real tube: a dark underside, the body, a bright top edge, a specular
	# sweep that follows the curve, and the grip tape a practice ring is wrapped with.
	# EVERY BAND IS A FULL CIRCLE and the hole is never filled, so you look straight
	# through it at the backdrop - which is the one thing a ring does that no other prop
	# here does, and the first thing a viewer checks without knowing they are checking.
	var w := R * 0.30                          # the tube's thickness
	var dark := ca(Color(col.r * 0.42, col.g * 0.46, col.b * 0.58))
	var lit := ca(Color(minf(col.r * 1.30 + 0.10, 1.0), minf(col.g * 1.26 + 0.10, 1.0), 1.0))
	draw_arc(c, R - w * 0.5, 0.0, TAU, 72, dark, w * 1.14, true)
	draw_arc(c, R - w * 0.5, 0.0, TAU, 72, col, w * 0.86, true)
	draw_arc(c, R - w * 0.18, 0.0, TAU, 72, ca(Color(0, 0, 0, 0.22)), w * 0.18, true)   # outer shadow line
	draw_arc(c, R - w * 0.86, 0.0, TAU, 72, lit, w * 0.20, true)                    # lit inner edge
	draw_arc(c, R - w * 0.5, PI * 1.05, PI * 1.75, 40, ca(Color(1, 1, 1, 0.42)), w * 0.34, true)   # specular sweep
	draw_arc(c, R - w * 0.5, PI * 0.15, PI * 0.70, 34, ca(Color(0, 0, 0, 0.20)), w * 0.30, true)   # underside
	# the torches again: a cool blue ring is where warm bounce shows most, so this is the
	# mark that ties the O to the A four letters away
	draw_arc(c, R - w * 0.5, -PI * 0.34, PI * 0.30, 26, ca(Color(CAP_FIRE.r, CAP_FIRE.g, CAP_FIRE.b, 0.30)), w * 0.52, true)
	for i in 8:                                  # tape wraps around the tube
		var a := TAU * float(i) / 8.0 + 0.22
		var d := Vector2(cos(a), sin(a))
		draw_line(c + d * (R - w * 0.96), c + d * (R - w * 0.04), ca(Color(1, 1, 1, 0.10)), maxf(1.0, R * 0.030))


func draw_prop_rich(kind: int, pos: Vector2, col: Color, ang: float, sc: float, halo: bool = true) -> void:
	# THE LUSH VERSION OF ANY PROP, in one place (2026-07-28, Louis: "you should use the
	# better looking visuals for those props in the shop also, and test them with F9 in
	# juggle sessions"). These were written for a single still capsule frame and are
	# deliberately extravagant - dozens of shapes per object where the stage draws a
	# handful. One dispatcher so the shop card and the F9 stage toggle can never show
	# different pictures of the same object.
	#
	# ...and BECAUSE it is one dispatcher, it is also the single seam for all seven props:
	# stage, shop card, tutorial kit panel and skills preview all arrive here, so one PNG
	# per prop replaces that prop EVERYWHERE at once.
	#
	# ONLY THE ROUND PROPS TAKE THE TINT, and the dispatcher below is the proof: cap_egg,
	# cap_ring and cap_ball are handed `col`, while cap_club, cap_knife, cap_torch and
	# draw_chainsaw are not - they carry their own painted palettes and ignore it. `col` is
	# ball_color(i), four colours cycled by INDEX and set on every prop regardless of kind,
	# so tinting a club by it would repaint the same club gold, orange, red or blue
	# depending on which slot it happened to be in. So: author ball/egg/ring WHITE and let
	# the game colour them, author club/knife/torch/chainsaw in their own finished colours.
	# stated as "everything EXCEPT the painted four", which is how the `_` fallthrough below
	# behaves - a prop added later with no branch of its own lands on cap_ball and is tinted
	var tinted := not (kind in [PROP_CLUBS, PROP_KNIVES, PROP_TORCHES, PROP_CHAINSAW])
	if art_blit_prop(kind, pos, sc, ang, col if tinted else Color.WHITE):
		return
	match kind:
		PROP_EGGS:     cap_egg(pos, col, sc)
		PROP_RINGS:    cap_ring(pos, col, 12.0 * sc)
		PROP_CLUBS:    cap_club(pos, ang, sc)
		PROP_KNIVES:   cap_knife(pos, ang, sc)
		# THE STAGE TORCH IS THE SHOP TORCH WITHOUT ITS LIGHT (2026-07-28, Louis: "the
		# torches deserve their better look like in the shop, but that doesn't mean they
		# have to be as crazily detailed, just the same look and not just a brown stick").
		# It was falling back to draw_torch, which is a brown LINE with a flame on it -
		# he is describing it exactly. Now both paths draw the same waisted haft, cord
		# binding, brass ferrule and charred wick; `halo` is the only difference, and it
		# only drops the two big glow quads, the widest aura layer and the embers.
		PROP_TORCHES:  cap_torch(pos, ang, sc, halo)
		PROP_CHAINSAW: draw_chainsaw(pos, ang, sc, true)
		_:             cap_ball(pos, col, BALL_RADIUS_PX * sc)


func cap_egg(p: Vector2, col_in: Color, sc: float) -> void:
	# the egg with everything a still frame can afford: the ovoid silhouette is still the
	# whole character of it, but here it gets the shading the stage refuses (see THE ROUND
	# PROPS ARE FLAT) plus the speckling a real shell has and a bounce off the boards.
	# REBUILT ON THE SAME REASONING AS THE BALL (2026-07-28, Louis: the eggs look strange).
	# It had eleven speckles at `w * 0.055` - 0.5px at the size an egg is actually drawn, so
	# floored to 0.7px, which is a hairline: not shell mottling but a scatter of dirt that
	# crawls as the egg tumbles. And it finished with cap_warm_rim, a thick PARTIAL arc,
	# which this file's own art note says never to shade with: a thick arc is an annulus
	# segment with square ends, so it puts a hard-edged bite on the shell rather than light.
	#
	# What says EGG at 24px is the SHAPE (the asymmetric ovoid, pinched at the top - that is
	# already right and untouched) plus a few real mottles. Five of them at w*0.13 are
	# 2.3px: visible, and too big to shimmer.
	var col := ca(col_in)
	var w := 9.0 * sc
	var h := 12.0 * sc
	ovoid(p, w, h, ca(Color(col.r * 0.66, col.g * 0.64, col.b * 0.61)))
	ovoid(p + Vector2(-w * 0.08, -h * 0.07), w * 0.91, h * 0.91, col)
	# the mottling: soft blotches, not flecks, and never on the outline where they would
	# break the silhouette the whole shape depends on
	for i in 5:
		var a := float(i) * 2.399
		var rr := sqrt(float(i) / 5.0) * 0.58
		var q := p + Vector2(cos(a) * w * rr, sin(a) * h * rr)
		fill_ellipse(q, w * 0.15, h * 0.10, ca(Color(0.70, 0.62, 0.50, 0.20)))
	# one broad dim sheen, the same diffuse mark the ball gets
	fill_ellipse(p + Vector2(-w * 0.24, -h * 0.30), w * 0.42, h * 0.26, ca(Color(1, 1, 1, 0.13)))


func cap_club_v2(p: Vector2, ang: float, sc: float) -> void:
	# THE SHOP CLUB (2026-07-30): the same silhouette the stage draws, out of the same table,
	# with the modelling a still object in a lit niche is allowed and a flying one is not. Every
	# mark is a slice of `club_shape`, so none of them can wander off the outline - which is the
	# specific way the old one broke. It had a correct tapered profile AND a 6-unit disc left on
	# top of it, and the disc won, because it was drawn last and 2 units wider on both sides.
	draw_set_transform(p, ang, Vector2.ONE * sc)
	var body := ca(Color(0.90, 0.35, 0.38))
	var body_dk := ca(Color(0.56, 0.18, 0.22))
	var band := ca(Color(0.96, 0.92, 0.85))
	var band_dk := ca(Color(0.70, 0.66, 0.60))
	# the handle, its shaded side taken as a fraction of the profile rather than as a second
	# tapered quad written out by hand
	draw_colored_polygon(club_shape(CLUB_BUTT_Y, CLUB_COLLAR_Y, 0.0, -1.0, 1.0, false, true), band)
	draw_colored_polygon(club_shape(CLUB_BUTT_Y, CLUB_COLLAR_Y, 0.0, 0.30, 1.0, false, true), band_dk)
	for gy: float in [4.4, 6.8, 9.2, 11.6]:      # the grip wrap
		var gw := club_hw(gy)
		draw_line(Vector2(-gw, gy), Vector2(gw, gy + 0.5), ca(Color(0.62, 0.58, 0.52, 0.55)), 0.7)
	draw_circle(Vector2(-0.7, 15.9), 1.4, ca(Color(1, 1, 1, 0.5)))   # the knob's own highlight
	# the body, then its shaded side down the same profile
	draw_colored_polygon(club_shape(CLUB_COLLAR_Y, CLUB_NOSE_Y, 0.0, -1.0, 1.0, true), body)
	draw_colored_polygon(club_shape(CLUB_COLLAR_Y, CLUB_NOSE_Y, 0.0, 0.34, 1.0, true), body_dk)
	# the lacquer stripe: a slice, so it follows the swell instead of running straight past it
	draw_colored_polygon(club_shape(-1.0, -19.0, 0.35, -0.80, -0.40, true, true),
		ca(Color(1, 1, 1, 0.22)))
	# THE DECORATED BAND, which is what a juggling club has where a bowling pin does not. Two
	# rings rather than one, close together: a single stripe reads as a defect in the paint and
	# a pair reads as decoration. Both are slices, so they end exactly at the silhouette.
	for by: float in [CLUB_BAND_Y, CLUB_BAND_Y - 3.2]:
		var w := club_hw(by)
		draw_line(Vector2(-w, by), Vector2(w, by), band, 2.1 if is_equal_approx(by, CLUB_BAND_Y) else 1.1)
	var cw := club_hw(CLUB_COLLAR_Y)
	draw_line(Vector2(-cw - 0.6, CLUB_COLLAR_Y), Vector2(cw + 0.6, CLUB_COLLAR_Y), band, 2.2)
	draw_line(Vector2(-cw - 0.4, CLUB_COLLAR_Y + 1.1), Vector2(cw + 0.4, CLUB_COLLAR_Y + 1.1), band_dk, 0.7)
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


func cap_club(p: Vector2, ang: float, sc: float) -> void:
	if exp_on("club_v2"):
		cap_club_v2(p, ang, sc)
		return
	# the club with a real body: the taper shaded down one side, a lacquered highlight
	# running the length of it, a wrapped grip and a knob that is a knob rather than a
	# disc. Same silhouette and the same proportions as the stage club - roughly three
	# times as long as it is wide above the grip, which is what stops it reading as a
	# lollipop - so nothing here promises a shape the game does not have.
	draw_set_transform(p, ang, Vector2.ONE * sc)
	var body := ca(Color(0.90, 0.35, 0.38))
	var body_dk := ca(Color(0.56, 0.18, 0.22))
	var band := ca(Color(0.96, 0.92, 0.85))
	var band_dk := ca(Color(0.70, 0.66, 0.60))
	draw_colored_polygon(PackedVector2Array([                      # the handle, tapered
		Vector2(-1.9, 14.0), Vector2(1.9, 14.0), Vector2(1.5, -3.0), Vector2(-1.5, -3.0)]), band)
	draw_colored_polygon(PackedVector2Array([                      # ...shaded down one side
		Vector2(0.5, 13.8), Vector2(1.9, 13.8), Vector2(1.5, -2.8), Vector2(0.6, -2.8)]), band_dk)
	for gy in [4.0, 6.4, 8.8, 11.2]:                               # the grip wrap
		draw_line(Vector2(-1.9, gy), Vector2(1.9, gy + 0.5), ca(Color(0.62, 0.58, 0.52, 0.55)), 0.7)
	draw_circle(Vector2(0, 15.0), 2.9, band)                       # the knob...
	draw_circle(Vector2(-0.7, 14.4), 1.5, ca(Color(1, 1, 1, 0.55)))   # ...and its highlight
	# THE BODY IS A BULB, NOT A CONE (2026-07-28, Louis: the club looks strange, "not the
	# handle per se"). It was a four-point trapezoid running ±2.6 at the neck out to ±6 at
	# the far end - so it got steadily WIDER all the way to a flat top, which is a megaphone.
	# A juggling club swells out of the neck, reaches its widest about two thirds along, and
	# then rounds off; the profile below is that curve, and the flat end is gone. The
	# silhouette is what a club IS at this size, so this is the mark worth spending points on.
	# THE RATIO, and it is the whole read. The first bulb ran 15 units long by 11.6 wide -
	# 1.3:1 - which is not a club, it is an onion, and it is why the shop card still looked
	# like a lollipop with a rounded top. A real club's body is about 2.3:1: it swells out of
	# the neck, holds its width through the middle third, and only then rounds off. Longer
	# AND narrower, both, or lengthening it alone just makes a bigger onion. (This shape is
	# shared with the stage, deliberately - one club - and touches no sim value: the hitbox
	# is prop_hit_scale off BALL_RADIUS_PX and never reads this polygon.)
	var prof := [   # [y, half-width] up the body, neck to nose
		[-2.0, 2.4], [-5.5, 3.5], [-9.0, 4.1], [-12.5, 4.2], [-15.5, 4.0],
		[-18.0, 3.4], [-19.8, 2.4], [-20.6, 1.2]]
	var bpts := PackedVector2Array()
	for e in prof:
		bpts.append(Vector2(-float(e[1]), float(e[0])))
	bpts.append(Vector2(0.0, -21.0))            # the nose, on the centre line
	for i in range(prof.size() - 1, -1, -1):
		bpts.append(Vector2(float(prof[i][1]), float(prof[i][0])))
	draw_colored_polygon(bpts, body)
	# ...and the shaded side, following the same profile so it can never cross the outline
	var spts := PackedVector2Array()
	for e2 in prof:
		spts.append(Vector2(float(e2[1]) * 0.34, float(e2[0])))
	spts.append(Vector2(0.0, -21.0))
	for i2 in range(prof.size() - 1, -1, -1):
		spts.append(Vector2(float(prof[i2][1]), float(prof[i2][0])))
	draw_colored_polygon(spts, body_dk)
	draw_circle(Vector2(0, -16.5), 6.0, body)                      # the head
	draw_circle(Vector2(1.9, -17.4), 4.6, body_dk)                 # ...shaded to match
	draw_circle(Vector2(-1.6, -17.2), 3.4, ca(Color(1.0, 0.58, 0.58, 0.55)))
	draw_colored_polygon(PackedVector2Array([                      # the lacquer stripe
		Vector2(-1.9, -3.0), Vector2(-0.9, -3.0), Vector2(-2.6, -16.4), Vector2(-4.0, -16.0)]),
		ca(Color(1, 1, 1, 0.28)))
	draw_line(Vector2(-2.9, -2.4), Vector2(2.9, -2.4), band, 2.2)  # the collar
	draw_line(Vector2(-2.9, -1.5), Vector2(2.9, -1.5), band_dk, 0.7)
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


func cap_knife(p: Vector2, ang: float, sc: float) -> void:
	# THE KNIFE, drawn from scratch rather than painted over the stage one (2026-07-28).
	# Overlaying detail on `draw_knife` was the earlier approach and it is why the blade
	# read as PAPER: the base shape is one flat fill of pale grey, and no amount of
	# detail on top changes the fact that the largest area in the object is a single
	# uniform tone. Steel is never uniform, and the reason is the whole point here -
	# **a polished blade is a MIRROR**, so what you see on it is not shading at all, it
	# is the room. In this room that means three bands running the length of the blade:
	# the dark ceiling, a bright band where the key light is, and a warm one low down
	# where two torches are burning four letters to the right.
	#
	# Local units are the stage knife's own so the layout maths is unchanged: blade -26
	# to +2, guard at 3, grip to 13.
	draw_set_transform(p, ang, Vector2.ONE * sc)
	var steel := ca(Color(0.66, 0.71, 0.80))
	var steel_lo := ca(Color(0.28, 0.32, 0.40))          # the dark room, reflected
	var steel_hi := ca(Color(0.94, 0.97, 1.0))           # the key light, reflected
	var brass := ca(Color(0.72, 0.58, 0.32))
	var wood := ca(Color(0.34, 0.21, 0.13))
	var wood_hi := ca(Color(0.50, 0.33, 0.20))
	var blade := PackedVector2Array([
		Vector2(0, -26), Vector2(2.6, -18), Vector2(3.4, 2), Vector2(-3.4, 2), Vector2(-2.6, -18)])
	draw_colored_polygon(blade, steel)
	# THE THREE REFLECTION BANDS, each a sliver running the blade's length and tapering
	# with it. They are what a mirror finish looks like; a gradient would look airbrushed.
	draw_colored_polygon(PackedVector2Array([                                  # dark, near the spine
		Vector2(0.35, -24.0), Vector2(2.2, -17.6), Vector2(2.9, 1.4),
		Vector2(1.5, 1.4), Vector2(1.0, -17.6)]), steel_lo)
	draw_colored_polygon(PackedVector2Array([                                  # the key light
		Vector2(-0.15, -23.0), Vector2(0.9, -17.4), Vector2(1.2, 1.2),
		Vector2(0.15, 1.2), Vector2(-0.5, -17.4)]), steel_hi)
	draw_colored_polygon(PackedVector2Array([                                  # the torches
		Vector2(2.25, -17.4), Vector2(3.1, 1.6), Vector2(2.35, 1.6), Vector2(1.8, -17.4)]),
		ca(Color(CAP_FIRE.r, CAP_FIRE.g, CAP_FIRE.b, 0.42)))
	# the fuller: a groove is a dark line with a LIT line under it, never one line alone
	draw_colored_polygon(PackedVector2Array([
		Vector2(0, -20.5), Vector2(0.85, -16), Vector2(0.85, 0), Vector2(-0.85, 0), Vector2(-0.85, -16)]),
		ca(Color(0.20, 0.23, 0.29, 0.75)))
	draw_line(Vector2(-0.85, -15.0), Vector2(-0.85, -0.5), ca(Color(1, 1, 1, 0.30)), 0.35)
	# THE GROUND EDGE as a sliver that converges on the blade's own point, so it can
	# never overhang it at any scale and the tip stays exactly as sharp as the polygon
	# says (2026-07-27, Louis: "the point is a bit too thick ... it sticks out a tiny
	# amount" - a stroked line ending ON the tip straddles the centreline there).
	draw_colored_polygon(PackedVector2Array([
		Vector2(0, -26), Vector2(-2.6, -18), Vector2(-3.4, 2),
		Vector2(-2.0, 2), Vector2(-1.3, -17.6)]), ca(Color(1, 1, 1, 0.92)))
	# a satin grain across the flat: a few faint scratches, which is what tells the eye
	# the surface is metal that has been used rather than a shape filled with grey
	for gy in [-21.0, -14.5, -8.0, -2.5]:
		draw_line(Vector2(-1.6, gy), Vector2(2.4, gy + 0.5), ca(Color(1, 1, 1, 0.10)), 0.28)
	# EVERYTHING BELOW THE BLADE STAYS INSIDE THE STAGE KNIFE'S OWN SILHOUETTE (2026-07-28,
	# Louis: "make absolutely sure that the prettier 'shop' version of an object is just
	# more detailed and not different than the basic version"). It was not: this version
	# had grown a brass bolster block and a butt cap that pushed it to 42.3 units against
	# the stage knife's 35, so the shop was advertising a longer knife than the game
	# throws. The guard, the grip and the pommel are now exactly where draw_knife puts
	# them - only what is drawn ON them is new.
	draw_line(Vector2(-4.4, 3.0), Vector2(4.4, 3.0), brass, 3.0)                # the guard
	draw_line(Vector2(-4.0, 2.3), Vector2(4.0, 2.3), ca(Color(1.0, 0.92, 0.70, 0.5)), 0.7)
	draw_colored_polygon(PackedVector2Array([                                   # the grip
		Vector2(-2.5, 4.0), Vector2(2.5, 4.0), Vector2(2.7, 8.0),
		Vector2(2.3, 12.5), Vector2(-2.3, 12.5), Vector2(-2.7, 8.0)]), wood)
	draw_colored_polygon(PackedVector2Array([                                   # its lit side
		Vector2(-2.5, 4.2), Vector2(-1.2, 4.2), Vector2(-1.1, 8.0), Vector2(-1.3, 12.3),
		Vector2(-2.3, 12.3), Vector2(-2.6, 8.0)]), wood_hi)
	for ry in [5.6, 9.6]:                                   # the pins the scales sit on
		draw_circle(Vector2(0, ry), 0.62, brass)
		draw_circle(Vector2(-0.18, ry - 0.18), 0.28, ca(Color(1.0, 0.94, 0.78, 0.9)))
	draw_circle(Vector2(0, 13.2), 2.4, brass)                                   # the pommel
	draw_circle(Vector2(-0.8, 12.6), 1.1, ca(Color(1.0, 0.94, 0.78, 0.75)))
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


const CAP_FLAME_STEPS := 26      # a still frame can afford a smooth silhouette; the stage
								 # flame's 7-point profile is what makes it look faceted
# THE FLAME NO LONGER LEANS AT ALL, so `CAP_FLAME_UPRIGHT` is deleted (2026-07-30, Louis:
# "do make sure the flame stays upright"). It was a partial straightening - 0.80 of the way
# back to vertical - and it existed for ONE caller: the wordmark's A, whose two leaning
# torches met at their wicks and needed flames that leaned with the strokes. The A is two
# clubs now and nothing in the mark burns, so the constant outlived its only beneficiary.
# The fire is drawn in an UNROTATED frame anchored at the wick instead (see cap_torch),
# which is both what Louis asked for and less code than the compromise it replaces.
								 # are, so it has to be re-derived whenever the letter moves.**

func cap_flame_shape(base: Vector2, h: float, w: float, sway: float, wob: float, ph: float) -> PackedVector2Array:
	# A FLAME SILHOUETTE THAT IS NOT A TRIANGLE (2026-07-28). The old capsule fire was
	# the stage's own 7-point profile blown up, and at capsule size those seven points
	# read as facets: an origami flame. Three things fix it and all three are shape, not
	# colour.
	#   (1) SMOOTH, and pinched at BOTH ends - a flame is narrow at the wick where the
	#       fuel is, widest about a third up, and drawn to a wisp at the tip. That is
	#       v^0.30 * (1-v)^0.55, normalised so the widest point is exactly w.
	#   (2) LEANING more the higher it goes (v^1.6), because the tip has had longer to be
	#       pushed by the air it is dragging up with it.
	#   (3) ASYMMETRIC, with the two sides wobbling on DIFFERENT phases. This is the one
	#       that matters most and the one the old profile could not do at all: a shape
	#       that is a mirror image of itself is a leaf, whatever its outline.
	var pts := PackedVector2Array()
	for side in [1.0, -1.0]:
		for i in CAP_FLAME_STEPS:
			var k := float(i) / float(CAP_FLAME_STEPS - 1)
			var v: float = k if side > 0.0 else 1.0 - k
			var hw := w * pow(maxf(v, 0.0001), 0.30) * pow(maxf(1.0 - v, 0.0001), 0.55) / 0.576
			hw *= 1.0 + wob * sin(v * 9.0 + ph + (0.0 if side > 0.0 else 2.4))
			pts.append(base + Vector2(side * hw + sway * pow(v, 1.6), -v * h))
	return pts


func cap_torch(p: Vector2, ang: float, sc: float, halo: bool = true, flame: bool = true,
		handle: bool = true) -> void:
	# `flame` false draws the HANDLE ONLY. The A's two torches meet at their wicks, so both
	# fires start from the same point and burn straight up (2026-07-29, Louis: "make sure the
	# flames are identical: fire goes straight up and they begin at the same point, so only
	# one flame should be drawn"). Two copies of the same flame at the same place is not a
	# bigger fire, it is the same fire drawn twice at double alpha with double the cost, and
	# any drift between them - a different lean, a different flicker phase - shows up as a
	# doubled edge. So the letter draws two handles and one flame.
	# ...AND `handle` false is the other half of that, added 2026-07-30 (Louis: "remove the
	# middle torch at the end (in A)"). The apex fire used to be a whole THIRD torch, placed so
	# its wick landed where the two strokes meet - which meant a complete upright handle hanging
	# down the middle of the letter, between the two leaning ones. That third handle is what he
	# was looking at. The flame needs a position and a scale, not a torch, so now it gets them.
	# THE TORCH, drawn from scratch: the fire is the brightest thing in the picture and
	# it was the weakest object in it, so it is built here rather than dressed up.
	#
	# WHAT A REAL FLAME HAS that the old one did not: a BLUE base (fuel burns blue where
	# it is richest and hottest, right at the wick - it is the single detail that most
	# says "this is burning" rather than "this is orange"), a smooth asymmetric
	# silhouette, layers that each lean and wobble on their OWN phase so the shape
	# writhes instead of pulsing, a white-hot heart, and embers that leave.
	#
	# ON atick(), NEVER tick (2026-07-28, Louis: "the flames are not burning in the
	# starting menu"). `tick` is the SIM clock and it does not advance outside ST_PLAY,
	# so on the title screen - the one place this fire is the largest thing on screen -
	# the flicker, the sway and the embers were all frozen at whatever value tick held.
	# atick() is the cosmetic clock that runs in every state and exists for exactly this.
	var t := fire_clock()
	var fl := 1.0 + 0.14 * sin(t * 0.5) + 0.06 * sin(t * 1.31)
	var sway := 2.0 * sin(t * 0.29) + 0.8 * sin(t * 0.71)
	# `halo` drops the two big translucent glow quads and the widest aura layer.
	#
	# A CORRECTION, AND THE MEASURING LESSON THAT CAME WITH IT (2026-07-28). This comment
	# used to claim a "fill rate cliff" - 145 fps down to 15 the moment seven torches went
	# rich - and cite it as evidence against this file's own draw-call rule. **That number
	# was an artefact and the conclusion was wrong.** Every measurement was taken in a
	# BACKGROUNDED window, and macOS throttles the presentation of an unfocused window, so
	# Engine.get_frames_per_second() collapsed while the game went on genuinely drawing:
	# the `draws/s` counter, taken inside _draw itself, read ~120 in the very same runs
	# that reported 15. Re-measured at 1920x1016 with FIFTEEN rich props: 3.2ms of draw
	# and 122 draws a second. There is no cliff.
	#
	# What is true: the rich torch costs ~2.1ms more CPU draw time than the flat one at
	# seven props (4.9ms against 2.8ms), which is real but comfortably inside a 120Hz
	# budget. `halo` stays because it is still the cheapest thing to drop and the stage
	# has its own light for a dark house anyway - not because of a cliff that never was.
	#
	# **The rule to keep: `draws/s` is the frame rate. `engine fps` means nothing unless
	# the window has focus.** Do not conclude anything from an fps number again without
	# checking the two against each other.
	if halo:
		# both pools hang off the FIRE's centre, never the grip - see torch_fire_center
		var glow_at := torch_fire_center(p, ang, sc)
		draw_glow(glow_at + Vector2(0, -7.0 * sc), 46.0 * sc, ca(Color(1.0, 0.46, 0.12, 0.30)))
		draw_glow(glow_at, 23.0 * sc, ca(Color(1.0, 0.72, 0.30, 0.26)))
	# --- the handle, first, so the fire sits over its top ---------------------------
	# ONE DRAW CALL FOR THE WHOLE HANDLE (2026-07-28), the same move `_saw_bake` already
	# makes and for the same measured reason. It was twenty-three immediate-mode shapes -
	# haft, lit side, twelve cord hairlines, two ferrules with their highlights, the wick
	# and four char lines - which at fifteen torches is 345 draw calls of a ~600-call frame,
	# on the one prop a player is most likely to be fielding fifteen of.
	#
	# It is bakeable because **the handle is the same local geometry for every torch and at
	# every tick**: nothing in it flickers, leans or turns - only the fire above it does. So
	# unlike the saw's chain there is not even a per-tick rebuild; it is built once, on the
	# first torch ever drawn, and every torch after that is a transform and an emit.
	# `draw_set_transform` applies to canvas_item_add_triangle_array, which is what makes
	# that possible at all.
	#
	# The cord hairlines are the part this most improves visually as well: at 0.55 and 0.35
	# units they were drawn well under a pixel at the size a torch actually flies, so they
	# shimmered on every tumble - the same sub-pixel band the round props and the juggler's
	# face were both rebuilt to escape. Baked as filled bands they hold still.
	_torch_bake()
	draw_set_transform(torch_pivot(p, ang, sc), ang, Vector2.ONE * sc)
	if handle:
		RenderingServer.canvas_item_add_triangle_array(get_canvas_item(), _torch_idx, _torch_pts, _torch_cols)
	if not flame:
		return
	# --- the fire ---------------------------------------------------------------------
	# A FLAME'S BASE FOLLOWS THE TORCH; ITS TIP GOES UP. Both halves of that matter here.
	# Drawing the fire in world space is physically the tidier idea and it wrecks the
	# letter: the A is two LEANING torches whose flames make its apex, and two vertical
	# flames on slanted handles read as "||" balanced on "/\". Drawing it fully in the
	# prop's frame is the other extreme - a torch held at 17 degrees burning at 17
	# degrees, which no fire does. So each layer gets a straightening term proportional
	# to its own HEIGHT and to the lean: the wick end sits square on the torch, the tip
	# comes back most of the way to true vertical, and the flame bends between them the
	# way a real one dragged upright by its own draught does.
	# THE FIRE IS DRAWN IN A FRAME THAT MOVES WITH THE TORCH AND NEVER TURNS WITH IT
	# (2026-07-30, Louis: "but do make sure the flame stays upright"). It used to be built
	# inside the rotated frame with a straightening term per layer (`CAP_FLAME_UPRIGHT`, 0.80),
	# a compromise that existed for ONE caller: the wordmark's A, whose two leaning torches met
	# at their wicks and needed their flames to lean with the strokes. The A is two clubs now
	# and nothing in the mark burns, so the compromise has no beneficiary left and the honest
	# answer is available - fire goes UP, at every angle, on every tumble. Resetting the
	# transform to the wick's world position with zero rotation is also simpler than the term
	# it replaces, and `sway` stops fighting a lean that is no longer there.
	draw_set_transform(torch_fire_anchor(p, ang, sc), 0.0, Vector2.ONE * sc)
	var wick := Vector2.ZERO
	# A FLAME IS TALL AND NARROW, and getting that ratio wrong is what turned the first
	# rebuild into two orange balloons. The width formula peaks at `w`, so `w` is a HALF
	# width and the shape is 2w across against h tall: at w 10.4 and h 30 that is 21 wide
	# by 30 high, which is a bulb, not a fire. Roughly 1:4 is what a torch actually
	# burns, and the layers have to differ in HEIGHT much more than in width or they
	# stack into one mass with no visible heart.
	# HEIGHTS AND WIDTHS ARE FRACTIONS OF THE SHARED FLAME, not free numbers. Written this
	# way after Louis: "the flame is a bit too big with the lush version, keep the size,
	# just make a bigger part handle" - the freehand version stood 49 units tall against
	# the stage torch's 39, with the fire 63% of the whole object. A juggling torch is
	# mostly handle, and now both versions agree on where the fire stops.
	var FH := TORCH_FLAME_H
	var FW := TORCH_FLAME_W
	var layers := [
			{"h": FH * 1.29, "w": FW * 1.31, "sw": 1.3, "wob": 0.16, "ph": 0.0, "col": ca(Color(1.0, 0.30, 0.05, 0.26))},
			{"h": FH, "w": FW, "sw": 1.0, "wob": 0.14, "ph": 1.1, "col": ca(Color(1.0, 0.42, 0.08, 0.92))},
			{"h": FH * 0.71, "w": FW * 0.74, "sw": 0.7, "wob": 0.12, "ph": 2.3, "col": ca(Color(1.0, 0.66, 0.16, 0.94))},
			{"h": FH * 0.45, "w": FW * 0.54, "sw": 0.45, "wob": 0.10, "ph": 3.4, "col": ca(Color(1.0, 0.88, 0.44, 0.95))},
			{"h": FH * 0.26, "w": FW * 0.34, "sw": 0.25, "wob": 0.08, "ph": 4.6, "col": ca(Color(1.0, 0.99, 0.90, 0.95))},
			# THE BLUE BASE, last and small, sitting ON the wick and nowhere else: the
			# richest and hottest part of a fuel flame, and the one detail that says
			# "burning" rather than "orange". It has to stay SMALL - blown up it is just
			# a blue blob at the bottom of the fire, which is what the first pass got.
			{"h": FH * 0.13, "w": FW * 0.43, "sw": 0.10, "wob": 0.05, "ph": 5.5, "col": ca(Color(0.42, 0.68, 1.0, 0.50))},
			{"h": FH * 0.07, "w": FW * 0.24, "sw": 0.0, "wob": 0.04, "ph": 6.1, "col": ca(Color(0.74, 0.90, 1.0, 0.50))}]
	if not halo:
		layers.remove_at(0)   # the wide faint aura is overdraw, not shape - see above
	for lay in layers:
		var lh: float = float(lay["h"]) * fl
		var lsway: float = sway * float(lay["sw"])
		draw_colored_polygon(cap_flame_shape(wick, lh, float(lay["w"]), lsway,
			float(lay["wob"]), float(lay["ph"])), Color(lay["col"]))
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	# the embers leaving it, in WORLD space: smoke rises however the torch is held
	var wpos := torch_fire_anchor(p, ang, sc)
	for i in (9 if halo else 0):
		var sd := float(i) * 12.9898
		var rise := fposmod(t * 0.010 + fposmod(sin(sd) * 43758.5, 1.0), 1.0)
		var ex := sin(sd * 2.1) * 8.0 * sc + sway * sc * 2.4 * rise
		var ey := -27.0 * sc - rise * 42.0 * sc
		var er := (0.85 + 0.9 * fposmod(cos(sd) * 12.9, 1.0)) * sc * (1.0 - 0.45 * rise)
		var ea := (1.0 - rise) * (1.0 - rise) * 0.95
		draw_circle(wpos + Vector2(ex, ey), er, ca(Color(1.0, 0.62 + 0.25 * rise, 0.22, ea)))


func cap_s_color(i: int) -> Color:
	# the S's own warm ramp, gold at the top of the stroke down to a deep red at its foot -
	# see the "S" branch for why the stage's four-colour set (which includes a cold blue)
	# cannot be used here
	var cols := [
		Color(1.0, 0.84, 0.38), Color(1.0, 0.72, 0.30), Color(1.0, 0.58, 0.24),
		Color(0.98, 0.45, 0.28), Color(0.94, 0.36, 0.34),
	]
	return cols[i % cols.size()]


func cap_nudge(i: int) -> Vector3:
	# one letter's x / y / scale from the tuning table, safely - the table is edited by
	# hand, so a name of a different length must not crash the picture
	if i < 0 or i >= CAP_NUDGE.size():
		return Vector3(0.0, 0.0, 1.0)
	return CAP_NUDGE[i]


func cap_letter_width(ch: String, gsz: float) -> float:
	# how much room one letter's marks actually need, so its neighbours sit clear of it -
	# the ring is measured by its OUTER edge, which is what Louis asked for
	# EVERY ONE OF THESE IS COMPUTED, not chosen (2026-07-29). The S used to claim 0.48,
	# which is the distance between its two loop CENTRES and ignores the ball hanging off
	# each side, so the two S's were drawn a whole ball-width closer together than they
	# looked and the pair read as one cluster. The A likewise: its width is now whatever
	# its two leaning shafts actually span.
	match ch:
		"T": return gsz * 0.86
		"O": return gsz * 1.00
		"S": return gsz * (CAP_S_R * 2.0 + CAP_BALL_R * 2.0)
		"A": return gsz * (CLUB_LEN * CAP_A_CLUB_SC * sin(CAP_A_LEAN) * 2.0 + 0.16)
		_: return gsz * 0.60


# HOW FAR THE MARK REACHES OUTSIDE ITS OWN LETTER HEIGHT, so a neighbour can be placed
# off a number rather than off a screenshot (the rule the goal stem's bloom already
# established). The letters are `size` tall and sit on a baseline; the A's torch FLAMES
# climb well above the cap line and its HANDLES hang below it, so the picture is a good
# deal taller than the lettering it is standing in for.
const MARK_RISE := 1.06   # above the baseline, in units of letter height
const MARK_DROP := 0.17   # ...and below it
# WHERE THE BAKED SPRITE'S TOP-LEFT CORNER GOES, in units of the letter height, measured
# from the reference render by scripts/pixelise_mark.py and reported by it on every bake.
# Only the ORIGIN lives here: the sprite's own texture supplies its extent (see
# capsule_mark), because a size copied into code is a size that can silently disagree with
# the art it is describing.
const MARK_BOX_X := 2.33333   # ...left of screen centre
const MARK_BOX_Y := 1.09976   # ...above the props' baseline
# THE WORD "PIXEL" IS GONE FROM THE LOCKUP (2026-08-08, Louis: "the titlescreen should not
# have PIXEL above tossa"). It was a band of type above the props, letter-spaced to their
# width, and with it go MARK_PREFIX / MARK_PREFIX_CAP and draw_mark_prefix - the mark is now
# exactly what capsule_mark's own comment always said it was, the whole name in props and no
# lettering at all. Every layout expression that added the prefix band has lost that term
# rather than gained a zero, so nothing is left describing a thing that is not drawn.
# THE PREFIX IS PART OF THE PICTURE, so it lives in these constants rather than being
# drawn by one caller. The mark spells MARK_WORD ("TOSSA") in props and cannot spell the
# game's actual name: capsule_mark builds glyphs out of juggling objects and knows exactly
# T, O, S and A, and P/I/X/E/L have no honest prop shape. So the lockup is the word PIXEL
# set in the pixel font, sitting above the five-prop mark and letter-spaced to its width.
#
# Putting it here and not at the title screen is the same doctrine the comment above
# states: a game has one logo. The title screen, the key art, the credits and all five
# store capsules go through capsule_mark, so they all get the prefix and none of them can
# drift. mark_height() and mark_cy_centred() both account for the band, which is what
# keeps everything a caller places underneath in the right place.
# RECOMPUTED 2026-07-30, when the A's torches became clubs and its fire went with them. The
# arithmetic is written out so the next change to the letter can redo it rather than guess:
#   rise = CLUB_LEN * cos(CAP_A_LEAN) * CAP_A_CLUB_SC = 40.3 * 0.8961 * 0.0277 = 1.000
#        (the noses, which are now the highest thing in the mark), taken to 1.06 for the club's
#        own width either side of the apex.
#   drop = the S's lowest ball's bottom edge, which is its loop centre plus a radius plus a ball:
#        -0.46 + 2 * CAP_S_R + CAP_BALL_R = -0.46 + 0.49 + 0.119 = 0.149, taken to 0.17.
# **THE RISE MORE THAN HALVED**, from 2.45, and that is the single biggest consequence of losing
# the fire: a flame at its flicker peak reached 1.42 letter heights above a wick that was already
# a letter height up, so for three passes the mark reserved two and a half letter heights of
# height for a picture whose LETTERS only ever filled one. Everything that places the mark reads
# mark_height() (the title screen, all five capsules, the credits, the key art), so the whole
# composition tightened up the moment this number came down - which is the reason those callers
# were made to read it in the first place.
# The drop HALVED because the A's torches now stand ON the baseline instead of hanging
# their butts a third of a letter below it, and the rise grew because the apex is a merged
# fire rather than two separate ones. Embers are deliberately allowed past the rise: they
# are sparse sparks and leaving the frame is the point of them.
const MENU_MARK := 168    # the title screen's letter height. The prop mark is far WIDER than the
						   # word it replaced (five objects and their gaps against five glyphs), so
						   # it is sized by the room it has to fill rather than by the point size
						   # of the text that used to sit here.
						   # UP FROM 108 ON 2026-07-30, and it is the fire's doing. The mark used
						   # to reserve 2.45 letter heights of vertical space for a flame at its
						   # flicker peak, so a letter height of 108 already ate 280px of a 720px
						   # screen and could not grow. With the A's torches gone the picture is
						   # 1.23 letter heights - it is nearly all LETTERS now - so the same
						   # 200-odd pixels of title buys a word half again as large. At 168 it
						   # runs about two thirds of the screen width, which is what a title
						   # wants; much past that and the T's knife tip reaches the gold frame.

func mark_width(size: float) -> float:
	# THE WHOLE WORD'S WIDTH at a given letter height, out of the same loop capsule_mark lays it
	# out with (see there). Factored out 2026-07-30 because a caller has to be able to ASK: the
	# mark is sized off the frame's HEIGHT everywhere, which is fine at 16:9 and wrong the moment
	# a slot is portrait - the 600x900 store capsule, rendered at 840x1006, put the mark's 865px
	# through an 840px frame and cut the T and the A off at the edges. Nothing had changed about
	# that slot: the letters had simply grown (a wider S), and a width nobody measured went over.
	var gap := size * CAP_GAP
	var total := -gap
	for i in MARK_WORD.length():
		total += cap_letter_width(MARK_WORD[i], size * cap_nudge(i).z) + gap
	return total


func mark_fit_size(s: Vector2, want: float, frac := 0.88) -> float:
	# the largest letter height at or under `want` whose whole word fits `frac` of the frame's
	# width. Width scales linearly with the letter height, so this is exact rather than a search -
	# the same job fit_size does for a line of text, and used for the same reason: a wordmark that
	# runs off the frame is worse than a slightly smaller one at every size.
	var w := mark_width(want)
	return want if w <= s.x * frac else want * (s.x * frac) / w


func mark_height(size: float) -> float:
	# the whole picture's height, prefix cap to handle butts
	return size * (MARK_RISE + MARK_DROP)


func mark_cy_centred(sy: float, size: float, at: float = CAP_Y) -> float:
	# THE MARK IS NOT CENTRED ON ITS LETTERING, so a caller that wants the whole picture in
	# the middle of a frame cannot simply hand capsule_mark the middle of that frame - which
	# is what all five store capsules did, and why the rebuilt A's flame ran straight off the
	# top edge. capsule_mark's `cy` is the middle of the LETTER BOX, and the picture reaches
	# MARK_RISE above the baseline against only MARK_DROP below it, so it is wildly
	# top-heavy. This converts "put the picture's own middle at `at`" into that letter-box
	# centre, off the same two constants the drawing uses.
	return sy * at + size * ((MARK_RISE - MARK_DROP) * 0.5 - 0.5)


func mark_glow(widths: Array[float], gap: float, x0: float, base0: float, size: float) -> void:
	# The soft blue bloom behind the mark's ring, placed off the SAME advance the letters
	# walk rather than off a fraction of the finished picture. That is the whole reason it
	# takes the measured widths as an argument: the O's centre is wherever the layout puts
	# it, and a bloom pinned to "38% across the logo" would come unstuck the first time a
	# letter was renudged - which is the drift the "a game has one logo" note warns about.
	var x := x0
	for i in MARK_WORD.length():
		var n := cap_nudge(i)
		if MARK_WORD[i] == "O":
			var ring_r := size * n.z * 0.50
			draw_glow(Vector2(x + n.x * size + ring_r, base0 + size * n.y - size * n.z * 0.46),
				ring_r * 1.30, ca(Color(0.45, 0.78, 1.0, 0.20)))
			return
		x += widths[i] + gap


func capsule_mark(s: Vector2, cy: float, size: float, alpha: float = 1.0) -> void:
	# THE WHOLE NAME IN PROPS, and no lettering at all (2026-07-28, Louis): the T is two
	# knives with the vertical one lying over the horizontal, the O is a ring, each S is a
	# line of balls following the letter's own two loops, and the A is two torches leaning
	# together, flames up, with nothing across them. Only the background changes between
	# the variants - the mark itself is identical in all five, which is what a wordmark is.
	#
	# Everything is measured before anything is drawn, because the ring has to clear its
	# neighbours by its OUTER edge (Louis) and a prop's advance is its real extent, not a
	# font metric. A prop's local origin is its GRIP with the business end at negative y,
	# which is what places every piece below.
	_cap_a = clampf(alpha, 0.0, 1.0)
	# SEAM: the mark BAKED to a sprite. The logo is the first thing a player sees and it was
	# the last smooth thing in the game - the props here are cap_ball/cap_ring/cap_knife/
	# cap_club drawn directly, bypassing the prop seam entirely, so every other object had
	# become pixels while the title screen stayed vector.
	#
	# It is baked rather than assembled from the prop sprites because the mark is a
	# composition, not a pile of props: the S's are lines of balls at tuned offsets and the
	# A is two leaning clubs. Re-deriving that from prop_big art would mean reproducing
	# capsule_mark's layout twice and letting the two drift, which is exactly the failure
	# the "a game has one logo" note above was written about.
	#
	# ONLY AT THE BAKED SIZE. The sprite is 396x106 authored against MENU_MARK, and the
	# offsets below are measured from the render, in units of the letter height. Any other
	# size would need a fractional scale, which is the one thing that reliably turns pixel
	# art back into mush, so every other caller - the credits at 52, a narrow window's
	# clamped title - correctly falls through to the drawing.
	# KEYED BY SIZE, because a baked sprite is only correct at the size it was baked at -
	# any other needs a fractional scale, and scaling pixel art DOWN is the one operation
	# that cannot be undone. The mark is drawn at four sizes (the title, a store capsule,
	# and two in the credits), so the bank holds one texture per size and a size with no
	# bake simply falls through to the drawing. The BOX is size-independent: those four
	# numbers are in units of the letter height, measured from the render by
	# scripts/pixelise_mark.py, so one set covers every size.
	var gap := size * CAP_GAP
	var widths: Array[float] = []
	var total := 0.0
	for i in MARK_WORD.length():
		var gsz := size * cap_nudge(i).z
		widths.append(cap_letter_width(MARK_WORD[i], gsz))
		total += widths[i] + gap
	total -= gap
	var x := s.x * 0.5 - total * 0.5
	var base0 := cy + size * 0.5                 # the mark's baseline
	# THE RING'S BLOOM IS LIVE, AND DELIBERATELY NOT IN THE BAKE. It used to be drawn inside
	# the "O" branch, which put it in the reference render - and the reducer's alpha is hard
	# (a pixel is ink or it is nothing), so a soft glow over the render's near-black
	# background baked as an OPAQUE navy disc. On screen that is not a bloom, it is a plug:
	# the ring stopped being a ring and became a lens with the curtain sealed off behind it.
	# Drawn here it sits under both the sprite and the drawing, and the hole stays a hole.
	if not _markref:
		mark_glow(widths, gap, x, base0, size)
	# THE EXTENT COMES FROM THE SPRITE, ONLY THE ORIGIN IS MEASURED. All four numbers
	# used to be constants copied out of pixelise_mark.py's report, and that is a trap
	# with a delay fuse: re-bake the mark after changing a prop and the sprite's size
	# changes with it, while the box does not. It happened - the ring became a real
	# annulus, the bake went from 4.71 to 4.64 letter-heights wide, and art_blit_rect
	# dutifully stretched 780 px of art across 792 px of box. A 1.5% stretch is every
	# pixel of the logo resampled, on the first screen of the game.
	if not _markref and int(roundf(size)) != MENU_MARK:
		var key := "ui/wordmark_%d" % int(roundf(size))
		var wsz := art_native_size(key)
		if wsz.x > 0.0:
			var box := Rect2(s.x * 0.5 - size * MARK_BOX_X, base0 - size * MARK_BOX_Y,
				wsz.x, wsz.y)
			if art_blit_rect(key, box, Color(1, 1, 1, _cap_a)):
				_cap_a = 1.0
				return
	for i in MARK_WORD.length():
		var ch := MARK_WORD[i]
		var n := cap_nudge(i)
		var size_l := size * n.z                 # this letter's own height
		var w: float = widths[i]
		var base := base0 + size * n.y
		var ring_r := size_l * 0.50
		var s_r := size_l * CAP_S_R              # radius of each of the S's two loops
		x += size * n.x
		match ch:
			"T":
				# the crossbar first, then the stem ON TOP of it - Louis: "the vertical
				# above the horizontal". Turned +PI/2 a knife's blade sweeps right and its
				# butt hangs left, so the bar reads point-outward like a thrown knife.
				#
				# EVERY NUMBER HERE COMES OFF CAP_KNIFE_LEN / CAP_KNIFE_MID, never a
				# literal. The knife grew a bolster and a butt cap in the 2026-07-28 pass
				# and got longer at the grip end; when its extent was written into this
				# layout as a bare 35 and an 8.5, that change silently made the crossbar
				# 28% too wide and hung it off-centre. A prop's own measurements belong
				# beside the prop.
				var bsc := w * 1.02 / CAP_KNIFE_LEN
				var ssc := size_l * 0.92 / CAP_KNIFE_LEN
				var top := base - size_l * 0.92
				# CENTRE THE BAR ON ITS OWN MIDDLE, not on its grip: anchoring by the
				# origin (which is the guard, not the balance point) hung the whole
				# crossbar to one side of the stem.
				var bar_at := Vector2(x + w * 0.5 + CAP_KNIFE_MID * bsc, top)
				if not mark_prop("prop_big/knife", bar_at, PI * 0.5, CAP_KNIFE_LEN * bsc,
						Color.WHITE, CAP_KNIFE_MID * bsc):
					cap_knife(bar_at, PI * 0.5, bsc)
				# ...and the stem stands ON the baseline: its butt is its lowest point.
				var stem_at := Vector2(x + w * 0.5, base - CAP_KNIFE_BUTT * ssc)
				if not mark_prop("prop_big/knife", stem_at, 0.0, CAP_KNIFE_LEN * ssc,
						Color.WHITE, CAP_KNIFE_MID * ssc):
					cap_knife(stem_at, 0.0, ssc)
			"O":
				var rc := Vector2(x + ring_r, base - size_l * 0.46)
				# (its bloom is drawn before the letters - see mark_glow)
				# THE O IS THE SHOP'S RING, not a second drawing of one - see mark_prop.
				# The round props are centre-pivoted and radially symmetric, so swapping the
				# art in cannot shift a letterform the way it could for the T's knives.
				if not mark_prop("prop_big/ring", rc, 0.0, ring_r * 2.0, ca(Color(0.45, 0.75, 0.95))):
					cap_ring(rc, ca(Color(0.45, 0.75, 0.95)), ring_r)
			"S":
				# an S is two loops: the top one sweeps from its right tip up over and down
				# to the waist, the bottom one carries on from the waist round to the left.
				# ONE WARM RAMP, not the four-colour juggling set (2026-07-29). The stage's
				# ball_color cycles gold, orange, red and a pale BLUE, and a cold ball
				# dropped into a warm letter reads as a different object that wandered in,
				# which broke the stroke twice per S. Gold through red keeps the two loops
				# reading as one continuous line, and the picture's light is firelight
				# anyway, so a blue ball was never lit by anything in frame.
				var cxs := x + s_r + size_l * CAP_BALL_R
				var c1 := Vector2(cxs, base - size_l * 0.46 - s_r)
				var c2 := Vector2(cxs, base - size_l * 0.46 + s_r)
				var br := size_l * CAP_BALL_R
				var nb := CAP_S_BALLS
				# THE WAIST BALL WAS MISSING FROM BOTH S's (2026-07-30, Louis: "the middle ball in
				# both s's are missing"). Each loop dropped its FIRST and LAST ball, which is right
				# at the two outer tips - that is where an S doubles back and the balls crowd. But
				# the top loop's last ball and the bottom loop's first ball are not tips at all:
				# they are the same point, the WAIST where the two loops meet, and dropping both
				# left the letter cut in half. The top loop now runs to its end (`range(1, nb)`,
				# angle -1.5PI, which is exactly s_r below c1 and therefore the waist) and the
				# bottom loop still starts at 1, so the waist gets one ball and never two.
				for j in range(1, nb):
					var a1 := lerpf(0.0, -1.5 * PI, float(j) / float(nb - 1))
					var p1 := c1 + Vector2(cos(a1), sin(a1)) * s_r
					if not mark_prop("prop_big/ball", p1, 0.0, br * 2.0, cap_s_color(j)):
						cap_ball(p1, cap_s_color(j), br)
				for j in range(1, nb - 1):
					var a2 := lerpf(-0.5 * PI, PI, float(j) / float(nb - 1))
					var p2 := c2 + Vector2(cos(a2), sin(a2)) * s_r
					if not mark_prop("prop_big/ball", p2, 0.0, br * 2.0, cap_s_color(j + nb)):
						cap_ball(p2, cap_s_color(j + nb), br)
			"A":
				# TWO CLUBS THAT MEET, AND A DASH OF BALLS ACROSS THEM (2026-07-30, Louis: "change the
				# two torches into clubs and change to four balls to the two middle balls for the dash of
				# the A"). The letter was two torch shafts with a fire at the apex, and the fire is what
				# it kept being read as - a bonfire, then a campfire, over three passes and two rebuilds.
				# **THE FIRE IS GONE WITH THE TORCHES**, which is the whole point of the change and worth
				# saying plainly: nothing in the mark burns any more. What that buys is a letter made of
				# the same four objects as the rest of the word - knives, a ring, balls, clubs - and an
				# apex that is a POINT, because a club has a nose where a torch has a wick with a flame
				# standing on it. If a flame is ever wanted back, it is one cap_torch call at `apex`.
				#
				# THE STROKES ARE PLACED EXACTLY AS THE TORCHES WERE, off the club's own two ends rather
				# than off any new number: knobs on the baseline at the outer corners, noses meeting on
				# the centre line. `CLUB_BUTT_Y` / `CLUB_NOSE_Y` are the club's extent and they live
				# beside the profile that draws it, so the letter cannot come apart if the club is
				# reshaped again - which is exactly what happened to it this morning.
				var csc := size_l * CAP_A_CLUB_SC
				var reach := CLUB_LEN * csc                 # knob to nose, in pixels
				var lean := CAP_A_LEAN
				var dx := reach * sin(lean)                 # how far out each knob stands
				var cxa := x + w * 0.5
				# the origin cap_club draws from is the GRIP, and the knob hangs CLUB_BUTT_Y below it
				# along the shaft, so each club is placed by where its KNOB has to land rather than by
				# where its origin happens to fall - the same trap the torch version already recorded.
				var club_base := base + size_l * 0.07
				var foot_l := Vector2(cxa - dx, club_base) - Vector2(0.0, CLUB_BUTT_Y).rotated(lean) * csc
				var foot_r := Vector2(cxa + dx, club_base) - Vector2(0.0, CLUB_BUTT_Y).rotated(-lean) * csc
				var bar_off := CLUB_BUTT_Y - CLUB_LEN * CAP_CROSSBAR_AT
				var bar_l := foot_l + Vector2(0.0, bar_off).rotated(lean) * csc
				var bar_r := foot_r + Vector2(0.0, bar_off).rotated(-lean) * csc
				var club_mid := (CLUB_BUTT_Y + CLUB_NOSE_Y) * 0.5 * csc
				if not mark_prop("prop_big/club", foot_l, lean, CLUB_LEN * csc, Color.WHITE, club_mid):
					cap_club(foot_l, lean, csc)
				if not mark_prop("prop_big/club", foot_r, -lean, CLUB_LEN * csc, Color.WHITE, club_mid):
					cap_club(foot_r, -lean, csc)
				# THE DASH IS THE TWO MIDDLE BALLS OF THE FOUR (2026-07-30, Louis). Four balls spanning
				# stroke to stroke made the crossbar a solid bar wedged into the letter; the two middle
				# ones leave daylight either side, which is what the crossbar of a stencilled A looks
				# like - a DASH floating in the counter rather than a beam bolted across it.
				#
				# Done by dropping the first and last of the row rather than by placing two balls at
				# hand-picked fractions, which is the same trick each S loop already uses on its tips:
				# the count still comes off the gap, so at any size the mark is drawn the dash stays two
				# ball-widths of daylight short of both strokes instead of drifting into them.
				# The count itself is INTERVALS PLUS ONE - sizing n to the span and then spreading n
				# balls across it divides the span into n-1 gaps, each wider than a ball, which is how an
				# earlier version came out as three balls with daylight between them rather than a bar.
				# Floored at 4 so there are always two left after the ends come off.
				var abr := size_l * CAP_BALL_R
				var bar_len := bar_l.distance_to(bar_r)
				var nab := clampi(int(round(bar_len / maxf(abr * 2.0 * 0.90, 0.001))) + 1, 4, 7)
				for j in range(1, nab - 1):
					var t := float(j) / float(nab - 1)
					var bp := bar_l.lerp(bar_r, t)
					var bc := cap_s_color(j + 1)
					if not mark_prop("prop_big/ball", bp, 0.0, abr * 2.0, bc):
						cap_ball(bp, bc, abr)
			_:
				pass
		x += w + gap - size * n.x
	_cap_a = 1.0   # always restored: nothing drawn after a mark inherits its fade


func capsule_one(font: Font, s: Vector2, k: float) -> void:
	# 1. STAGE LIGHT. The mark under the same shaft the game opens on.
	draw_gradient_v(Rect2(0, 0, s.x, s.y), Color(0.11, 0.05, 0.045), Color(0.02, 0.013, 0.017), 24)
	draw_spotlight_cone(s, s.x * 0.5, 0.30)
	draw_glow(Vector2(s.x * 0.5, s.y * 0.50), s.y * 0.72, Color(1.0, 0.62, 0.26, 0.20))
	var msz := mark_fit_size(s, s.y * CAP_SIZE)
	capsule_mark(s, mark_cy_centred(s.y, msz), msz)
	draw_vignette(s, 0.56)


func capsule_two(font: Font, s: Vector2, k: float) -> void:
	# 2. NOTHING AT ALL. Near-black, no light source, no frame: the props are the picture.
	draw_gradient_v(Rect2(0, 0, s.x, s.y), Color(0.035, 0.028, 0.032), Color(0.008, 0.007, 0.010), 20)
	var msz := mark_fit_size(s, s.y * CAP_SIZE)
	capsule_mark(s, mark_cy_centred(s.y, msz), msz)
	draw_vignette(s, 0.70)


func capsule_three(font: Font, s: Vector2, k: float) -> void:
	# 3. FIRELIGHT. The A's own torches given a room to light, and embers over everything.
	draw_gradient_v(Rect2(0, 0, s.x, s.y), Color(0.12, 0.045, 0.028), Color(0.018, 0.011, 0.013), 24)
	draw_glow(Vector2(s.x * 0.72, s.y * 0.46), s.y * 0.60, Color(1.0, 0.50, 0.18, 0.30))
	draw_glow(Vector2(s.x * 0.5, s.y * 0.50), s.y * 0.40, Color(1.0, 0.72, 0.32, 0.20))
	var msz := mark_fit_size(s, s.y * CAP_SIZE)
	capsule_mark(s, mark_cy_centred(s.y, msz), msz)
	capsule_embers(Vector2(s.x * 0.5, s.y * 0.44), s.y * 0.52, 30, Color(1.0, 0.70, 0.32, 0.5))
	draw_vignette(s, 0.58)


func capsule_four(font: Font, s: Vector2, k: float) -> void:
	# 4. THE CURTAIN. Hung velvet behind the mark, the way the Small Theatre dresses.
	draw_gradient_v(Rect2(0, 0, s.x, s.y), Color(0.10, 0.04, 0.055), Color(0.03, 0.014, 0.024), 20)
	draw_curtain_wall(s, s.y * 1.02, s.y * 0.02, Color(0.28, 0.065, 0.095), 26)
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.03, 0.012, 0.02, 0.35))
	draw_glow(Vector2(s.x * 0.5, s.y * 0.50), s.y * 0.70, Color(1.0, 0.72, 0.34, 0.18))
	var msz := mark_fit_size(s, s.y * CAP_SIZE)
	capsule_mark(s, mark_cy_centred(s.y, msz), msz)
	draw_vignette(s, 0.60)


func capsule_five(font: Font, s: Vector2, k: float) -> void:
	# 5. NIGHT. The cold one: a deep blue field and a sky behind, so the torches read as
	# the only warm thing in the frame.
	draw_gradient_v(Rect2(0, 0, s.x, s.y), Color(0.025, 0.045, 0.075), Color(0.008, 0.012, 0.022), 22)
	draw_stars(s, 46, 0.85)
	draw_glow(Vector2(s.x * 0.5, s.y * 0.50), s.y * 0.62, Color(0.35, 0.62, 1.0, 0.16))
	var msz := mark_fit_size(s, s.y * CAP_SIZE)
	capsule_mark(s, mark_cy_centred(s.y, msz), msz)
	draw_vignette(s, 0.62)


func draw_capsule_art(font: Font, s: Vector2) -> void:
	# dev only (--capsule): pure key-art for the Steam store, no UI chrome at all -
	# reuses the exact menu-screen visual language (same backdrop, ball motif,
	# wordmark, gold frame), just bigger and centred, since that composition is
	# already proven rather than inventing a new risk. Capture at the native
	# 1280x720 with `--capsule --shot <path> --shotat 30`, then centre-crop to
	# 1232x706 (2x Steam's 616x353 Main Capsule - same aspect, so no distortion):
	#   sips --cropToHeightWidth 706 1232 <path>
	var cx := s.x * 0.5
	# EVERY SIZE HERE SCALES (2026-07-27). The positions were already relative to `s`,
	# but the logo, ornament, subtitle, frame and bulbs were absolute pixels - so
	# rendering this at 2560x1440 for a crisp store asset produced a big backdrop with a
	# postage-stamp wordmark on it, and the only way to get a usable capsule was to
	# capture at 720p and upscale (soft, which is the one thing a storefront thumbnail
	# cannot afford). `k` off the SMALLER of the two axis ratios, so a portrait render
	# for the 600x900 library capsule cannot push the wordmark out through the sides.
	var k := minf(s.x / 1280.0, s.y / 720.0)
	# FIVE DIFFERENT PICTURES, not five dressings of one (2026-07-28, Louis asked for five
	# "very different and very intriguing" ones). `--capsule N` picks: 1 the silhouette in
	# the light, 2 the pattern itself as the whole image, 3 the six props as a collection
	# plate, 4 the theatre seen from the back of the house, 5 the Midnight Show's alley -
	# the one cold picture in the set. Every one of them draws its props and its performer
	# through the SAME functions the stage uses, so none of them can promise a look the
	# game does not have. `--capsule` with no number keeps the original.
	match _capsule_variant:
		1: capsule_one(font, s, k); return
		2: capsule_two(font, s, k); return
		3: capsule_three(font, s, k); return
		4: capsule_four(font, s, k); return
		5: capsule_five(font, s, k); return
	draw_gradient_v(Rect2(0, 0, s.x, s.y), Color(0.12, 0.055, 0.075), Color(0.03, 0.02, 0.03), 22)
	draw_spotlight_cone(s, cx, 0.16)
	for i in 20:
		var lx := s.x * (float(i) + 0.5) / 20.0
		var fl := 0.6 + 0.4 * sin(float(cine_tick) * 0.06 + float(i))
		draw_circle(Vector2(lx, s.y - 20.0 * k), 12.0 * k, Color(1.0, 0.7, 0.3, 0.09 * fl))
		draw_circle(Vector2(lx, s.y - 20.0 * k), 4.0 * k, Color(1.0, 0.72, 0.32, 0.65 * fl))
	draw_dust(s, 26, Color(1.0, 0.85, 0.55))
	# THE MARK IS BIGGER AND THE BLOCK IS CENTRED (2026-07-30), both for the same reason the title
	# screen's grew: with the A's fire gone the picture is 1.23 letter heights instead of 2.45, so
	# a hand-picked `cap_top` of 0.30 left the word small in the upper third with half the frame
	# empty under it. The block (mark plus its ornament) is centred off mark_height() now, so the
	# next change to the letter moves the whole composition instead of stranding it.
	# **AND THE CASCADE CAME OFF.** A little juggling loop used to arc above the mark, which is
	# exactly what the title screen dropped in July for competing with a mark that was alive. This
	# mark is not alive any more - no fire - but the cascade still lost: on a STILL store capsule
	# it reads as three stray balls and a brown streak floating over the word, which on a
	# storefront thumbnail is indistinguishable from a rendering fault.
	var cap_sz := int(round(mark_fit_size(s, 185.0 * k)))
	var orn_gap := 26.0 * k
	var block_h := mark_height(float(cap_sz)) + orn_gap
	var cap_top := s.y * 0.5 - block_h * 0.5
	var cap_bot := cap_top + mark_height(float(cap_sz))
	draw_wordmark(cap_top, cap_sz, Color(1.0, 0.88, 0.5), s)
	# NO TAGLINE, HERE EITHER (2026-07-30, Louis: "storefront capsule : jugglers climbs remove
	# it"). It came off the title screen first and this was left for one commit on the argument
	# that a storefront capsule wants a line under the logo. It does not want THIS one, and the
	# mark is the same mark in both places, so the two screens agree again.
	draw_ornament(cx, cap_bot + orn_gap, 300.0 * k, Color(0.82, 0.62, 0.34, 0.85))
	draw_vignette(s, 0.55)
	draw_frame(s, 22.0 * k, Color(0.82, 0.62, 0.34, 0.55))


#endregion

#region SLOTS / SETTINGS / GAME-OVER / MISC SCREENS
func slot_info(i: int) -> Dictionary:
	# structured per-slot summary for the card variant (draw_slots_cards), so it never has
	# to parse slot_summary's sentence. Same source of truth (the slot cfg).
	if not FileAccess.file_exists(slot_path(i)):
		return {"exists": false}
	var cf := ConfigFile.new()
	if cf.load(slot_path(i)) != OK:
		return {"exists": false}
	var rep := int(cf.get_value("stats", "reputation", 0))
	return {
		"exists": true,
		"level": int(cf.get_value("prog", "level", 1)),
		"gold": int(cf.get_value("stats", "money", START_GOLD)),
		"venue": String(venue_data(venue_index_of(rep))["name"]),
		"won": bool(cf.get_value("prog", "won", false)),
	}


func draw_slots_screen(font: Font, s: Vector2) -> void:
	draw_slots_cards(font, s)


func draw_slots_cards(font: Font, s: Vector2) -> void:
	# the save files as three tall portrait cards: a cascade motif up top, the level
	# big, venue and purse below, a crown on a finished save. (Shipped 2026-07-27 - it
	# was an F9 variant that defaulted OFF, which is the only reason the classic bars
	# were still the ones on screen; Louis wanted the new picture everywhere.)
	view_venue = 2
	draw_backdrop(s)
	view_venue = -1
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.03, 0.02, 0.03, 0.66))
	draw_string(title_font(), Vector2(0, s.y * 0.15), "SAVE FILES", HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(44), Color(1.0, 0.86, 0.5))
	draw_ornament(s.x * 0.5, s.y * 0.15 + 40.0, 200.0, Color(0.82, 0.62, 0.34, 0.85))

	var gap := 26.0
	var cw := 262.0
	var ch := 320.0
	var total := cw * float(NUM_SLOTS) + gap * float(NUM_SLOTS - 1)
	var sx := s.x * 0.5 - total * 0.5
	var cy := s.y * 0.30
	for i in NUM_SLOTS:
		var sel := i == menu_sel
		var info := slot_info(i)
		var exists := bool(info.get("exists", false))
		var crowned := exists and bool(info.get("won", false))
		var cx := sx + float(i) * (cw + gap)
		var accent := Color(1.0, 0.82, 0.42) if crowned else (Color(0.9, 0.62, 0.36) if exists else Color(0.55, 0.5, 0.48))
		var fillc := Color(accent.r * 0.16, accent.g * 0.15, accent.b * 0.14, 0.95) if sel else Color(0.10, 0.07, 0.085, 0.9)
		soft_card(Rect2(cx, cy, cw, ch), fillc, Color(accent.r, accent.g, accent.b, 0.9 if sel else 0.32), 2.0 if sel else 1.0, 14.0, 16.0)
		# a small three-ball cascade motif as the card's art (a crown for a finished save)
		var mc := Vector2(cx + cw * 0.5, cy + 74.0)
		if crowned:
			var cwn := PackedVector2Array([mc + Vector2(-24, 10), mc + Vector2(-24, -10), mc + Vector2(-10, 2), mc + Vector2(0, -16), mc + Vector2(10, 2), mc + Vector2(24, -10), mc + Vector2(24, 10)])
			draw_colored_polygon(cwn, Color(1.0, 0.84, 0.4))
		else:
			# THE SAME BALL THE GAME DRAWS (2026-07-30, Louis: "the game save file cards had a
			# different, older, ball design"). It was a bare `draw_circle`, so this card was still
			# showing the flat disc from before `cap_ball` - two art styles for the same object, on
			# the first screen a new player sees. The colours come from `ball_color` for the same
			# reason: the palette was typed out here as a THIRD copy and had already drifted off
			# the real one (0.5/0.78/0.95 against ball_color's 0.72/0.86/0.95).
			for j in 3:
				var t := float(j) / 2.0
				var bp := mc + Vector2(lerpf(-30.0, 30.0, t), -18.0 * sin(t * PI))
				var bc := ball_color(j)
				bc.a = 0.95 if exists else 0.4
				cap_ball(bp, bc, 9.0)
		var tcol := Color(1.0, 0.9, 0.6) if sel else (accent if exists else Color(0.7, 0.64, 0.58))
		draw_string(title_font(), Vector2(cx, cy + 132.0), "Slot %d" % (i + 1), HORIZONTAL_ALIGNMENT_CENTER, cw, ps(22), tcol)
		if exists:
			draw_string(title_font(), Vector2(cx, cy + 186.0), "Lv %d" % int(info["level"]), HORIZONTAL_ALIGNMENT_CENTER, cw, ps(34), Color(1.0, 0.95, 0.82))
			draw_fit_string(font, Vector2(cx, cy + 214.0), String(info["venue"]), HORIZONTAL_ALIGNMENT_CENTER, cw, 14, Color(0.84, 0.78, 0.68))
			draw_fit_string(font, Vector2(cx, cy + 238.0), "%s %s" % [commafy(int(info["gold"])), coin_word()], HORIZONTAL_ALIGNMENT_CENTER, cw, 14, Color(1.0, 0.86, 0.45))
			if crowned:
				draw_string(font, Vector2(cx, cy + 262.0), "WORLD'S GREATEST", HORIZONTAL_ALIGNMENT_CENTER, cw, ps(12), Color(1.0, 0.82, 0.4))
			draw_string(font, Vector2(cx, cy + ch - 18.0), "[X] delete", HORIZONTAL_ALIGNMENT_CENTER, cw, ps(12), Color(0.88, 0.55, 0.5) if sel else Color(0.7, 0.5, 0.47, 0.7))
		else:
			draw_string(font, Vector2(cx, cy + 190.0), "empty", HORIZONTAL_ALIGNMENT_CENTER, cw, ps(18), Color(0.7, 0.64, 0.58))
			draw_string(font, Vector2(cx, cy + 214.0), "start a new climb", HORIZONTAL_ALIGNMENT_CENTER, cw, ps(13), Color(0.6, 0.56, 0.5, 0.85))

	var by := cy + ch + 30.0
	var bsel := menu_sel == NUM_SLOTS
	draw_string(font, Vector2(0, by + 22.0), ("Back" if not bsel else ">   Back   <"), HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(24), Color(1.0, 0.9, 0.55) if bsel else Color(0.72, 0.66, 0.6))
	var sfoot := "Left / Right    A to play    X to delete    B to go back" if pad_active() else "Left / Right    Enter to play    X to delete    Esc to go back"
	draw_string(font, Vector2(0, s.y - 42.0), sfoot, HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(15), Color(0.7, 0.66, 0.6))
	draw_vignette(s, 0.5)
	draw_frame(s, 22.0, Color(0.82, 0.62, 0.34, 0.5))


func draw_settings_screen(font: Font, s: Vector2) -> void:
	# the one call site every screen uses to open Settings, same seam as
	# draw_sheet_screen (see there). settings_input owns the behaviour: menu_sel is a
	# bare index 0..9 into the rows, which is why the row list below and settings_input
	# must always carry the SAME rows in the SAME order.
	draw_settings_cards(font, s)


func draw_settings_cards(font: Font, s: Vector2) -> void:
	# SETTINGS as cards - the same ELEVEN rows in the same menu_sel order settings_input
	# already drives, in the Balatro-card language the shop and sheet use
	# (hud_card/draw_meter/a toggle plate). This screen alone never picked it up and was
	# bare text rows. (Shipped 2026-07-27, no longer a variant.)
	view_venue = 2
	draw_backdrop(s)
	view_venue = -1
	draw_rect(Rect2(0, 0, s.x, s.y), Color(0.03, 0.02, 0.03, 0.72))
	draw_title_glow(font, s.y * 0.10, "SETTINGS", 40, Color(1.0, 0.86, 0.5), s)
	draw_ornament(s.x * 0.5, s.y * 0.10 + 56.0, 200.0, Color(0.82, 0.62, 0.34, 0.85))

	var rows := [
		{"kind": "slider", "name": "Music", "val": set_music, "note": "", "col": Color(0.95, 0.75, 0.4)},
		{"kind": "slider", "name": "Sound effects", "val": set_sfx, "note": "", "col": Color(0.95, 0.6, 0.45)},
		{"kind": "bool", "name": "Screen shake", "val": set_shake, "note": "a jolt on every drop", "col": Color(0.55, 0.85, 0.8)},
		{"kind": "bool", "name": "Reduce motion", "val": reduce_motion, "note": "fewer jolts and bursts", "col": Color(0.6, 0.82, 0.72)},
		{"kind": "bool", "name": "Fullscreen", "val": set_fullscreen, "note": "F11 anywhere", "col": Color(0.6, 0.75, 0.95)},
		{"kind": "pick", "name": "Dominant hand", "val": dominant_hand == RIGHT, "note": "holds the odd prop and starts the pattern", "col": Color(0.95, 0.7, 0.55)},
		{"kind": "diff3", "name": "Difficulty", "val": difficulty, "note": difficulty_note(difficulty), "col": difficulty_accent(difficulty)},
		# ...and the eleventh row the `sections` list below has been asking for since the
		# dominant-hand row arrived: it lists rows [8, 9, 10] while `rows` only ran to 9, so
		# `rows[10]` was an out-of-range read inside _draw - which this file's own note about
		# script errors mid-draw says silently abandons the rest of the pass.
		{"kind": "bool", "name": "Catch with a full hand", "val": set_catch_full, "note": "off: a hand must be empty to receive", "col": Color(0.7, 0.85, 0.6)},
		{"kind": "nav", "name": "Controls", "val": false, "note": "rebind the keys", "col": Color(0.8, 0.7, 0.95)},
		{"kind": "nav", "name": "Records and history", "val": false, "note": "your career ledger", "col": Color(0.95, 0.82, 0.5)},
		{"kind": "nav", "name": "Back", "val": false, "note": "", "col": Color(0.7, 0.66, 0.62)},
	]
	# grouped into sections so it reads as a designed panel, not a wall of identical
	# bars. The row INDEX still matches settings_input 0..10 exactly - only the y of each
	# card shifts to leave room for the section headers between groups. Every row must
	# appear in exactly one section, or a row the input can select is never drawn.
	var sections := [
		{"head": "AUDIO", "rows": [0, 1]},
		{"head": "GAME FEEL", "rows": [2, 3, 4, 5, 6, 7]},
		{"head": "MORE", "rows": [8, 9, 10]},
	]
	var pw := minf(620.0, s.x - 90.0)
	var px := s.x * 0.5 - pw * 0.5
	# sized so ELEVEN rows plus three section headers still finish above the footer: the
	# dominant-hand row was the tenth, and at the old spacing Back sat under the hints
	var card_h := 38.0
	var gap := 6.0
	var sec_gap := 14.0
	var head_h := 18.0
	var y := s.y * 0.172
	for sec in sections:
		draw_string(font, Vector2(px + 4.0, y + 13.0), String(sec["head"]), HORIZONTAL_ALIGNMENT_LEFT, -1, ps(12), Color(0.95, 0.8, 0.55, 0.85))
		y += head_h
		for i in sec["rows"]:
			var r: Dictionary = rows[i]
			var sel: bool = i == menu_sel
			var ac: Color = r["col"]
			var card := Rect2(px, y, pw, card_h)
			var fillc := Color(ac.r * 0.16, ac.g * 0.16, ac.b * 0.17, 0.92) if sel else Color(0.10, 0.08, 0.10, 0.82)
			soft_card(card, fillc, Color(ac.r, ac.g, ac.b, 0.85 if sel else 0.28), 1.5 if sel else 1.0, 9.0, 9.0)
			# a rounded accent tab on the left edge marks the row's colour without tinting all of it
			var tab := StyleBoxFlat.new()
			tab.bg_color = ac if sel else Color(ac.r, ac.g, ac.b, 0.55)
			tab.set_corner_radius_all(2)
			tab.anti_aliasing = true
			draw_style_box(tab, Rect2(px + 8.0, y + 9.0, 4.0, card_h - 18.0))
			var nm := String(r["name"])
			var has_note := String(r["note"]) != ""
			var ny := y + (card_h * 0.5 - 4.0 if has_note else card_h * 0.5 + 6.0)
			draw_string(font, Vector2(px + 24.0, ny), nm, HORIZONTAL_ALIGNMENT_LEFT, pw - 200.0, ps(17), Color(1.0, 0.95, 0.82) if sel else Color(0.86, 0.81, 0.73))
			if has_note:
				draw_fit_string(font, Vector2(px + 24.0, ny + 15.0), String(r["note"]), HORIZONTAL_ALIGNMENT_LEFT, pw - 200.0, 11, Color(0.72, 0.66, 0.6, 0.9))
			match String(r["kind"]):
				"slider":
					var vol: float = r["val"]
					draw_meter(px + pw - 178.0, y + card_h * 0.5 - 7.0, 128.0, 14.0, vol, Color(ac.r, ac.g, ac.b, 0.95) if vol > 0.0 else Color(0.5, 0.44, 0.4))
					draw_string(font, Vector2(px + pw - 44.0, y + card_h * 0.5 + 5.0), "mute" if vol <= 0.0 else "%d%%" % int(round(vol * 100.0)),
						HORIZONTAL_ALIGNMENT_RIGHT, 34.0, ps(14), Color(0.85, 0.6, 0.55) if vol <= 0.0 else Color(0.86, 0.92, 0.84))
				"bool":
					draw_pill_toggle(px + pw - 74.0, y + card_h * 0.5 - 13.0, 54.0, 26.0, bool(r["val"]))
				"pick":
					# a two-way PICK, not a yes/no: the unchosen side stays visible so the
					# row reads as "left or right", which is what the setting is
					var isr := bool(r["val"])
					draw_string(font, Vector2(px + pw - 118.0, y + card_h * 0.5 + 6.0), "LEFT", HORIZONTAL_ALIGNMENT_LEFT, 60.0, ps(15),
						Color(0.55, 0.5, 0.46) if isr else Color(1.0, 0.88, 0.55))
					draw_string(font, Vector2(px + pw - 62.0, y + card_h * 0.5 + 6.0), "RIGHT", HORIZONTAL_ALIGNMENT_LEFT, 60.0, ps(15),
						Color(1.0, 0.88, 0.55) if isr else Color(0.55, 0.5, 0.46))
				"nav":
					draw_string(font, Vector2(px + pw - 42.0, y + card_h * 0.5 + 7.0), ">", HORIZONTAL_ALIGNMENT_RIGHT, 28.0, ps(20), Color(1.0, 0.9, 0.6) if sel else Color(0.7, 0.64, 0.58))
				"diff3":
					# three labels, not two - the same "unchosen stays visible" rule as "pick",
					# widened by one, so the row reads as which of three rather than a slider
					var cur := int(r["val"])
					var dxx := px + pw - 210.0
					for di in 3:
						var on2 := cur == di
						draw_string(font, Vector2(dxx, y + card_h * 0.5 + 6.0), DIFF_NAMES[di], HORIZONTAL_ALIGNMENT_LEFT, 66.0, ps(13),
							difficulty_accent(di) if on2 else Color(0.5, 0.46, 0.42))
						dxx += 68.0
			y += card_h + gap
		y += sec_gap

	var tfoot := "Up / Down    Left / Right adjust    A to toggle    B to go back" if pad_active() else "Up / Down    Left / Right adjust    Enter to toggle    Esc to go back"
	draw_string(font, Vector2(0, s.y - 40.0), tfoot, HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(14), Color(0.7, 0.66, 0.6))
	draw_vignette(s, 0.5)
	draw_frame(s, 22.0, Color(0.82, 0.62, 0.34, 0.5))


func draw_pill_toggle(x: float, y: float, w: float, h: float, on: bool) -> void:
	# a sliding pill switch (green + knob-right when on, muted + knob-left when off) - the
	# premium version of a bare ON/OFF plate, shared by the settings-cards experiment.
	var pill := StyleBoxFlat.new()
	pill.bg_color = Color(0.22, 0.42, 0.20, 0.95) if on else Color(0.20, 0.13, 0.13, 0.9)
	pill.set_corner_radius_all(int(h * 0.5))
	pill.border_color = Color(0.55, 0.9, 0.5, 0.7) if on else Color(0.6, 0.4, 0.38, 0.5)
	pill.set_border_width_all(1)
	pill.anti_aliasing = true
	draw_style_box(pill, Rect2(x, y, w, h))
	var kr := h * 0.5 - 3.0
	var kx := x + w - kr - 4.0 if on else x + kr + 4.0
	draw_circle(Vector2(kx, y + h * 0.5), kr, Color(0.85, 0.98, 0.82) if on else Color(0.8, 0.74, 0.7))


func draw_gameover(font: Font, s: Vector2) -> void:
	# the road's end: no strength to earn, no gold for a bed. The career closes
	# with its numbers and the slot starts over.
	#
	# SEAM (2026-08-13). This was one draw_rect of near-black with the numbers printed on
	# it, which is why check_pixel_grid scored it the CLEANEST screen in the game at 0.63%
	# off-grid - not converted, empty. The painting is the street the line of copy already
	# describes ("too tired to work, too poor for a bed"): a wet road at night, shutters
	# down, one guttering lamp, a bench nobody is sleeping on. The type still runs down the
	# middle, so the picture's middle is empty road on purpose.
	if not art_blit_rect("ui/end_gameover", Rect2(Vector2.ZERO, s)):
		draw_rect(Rect2(0, 0, s.x, s.y), Color(0.02, 0.01, 0.02))
	else:
		draw_read_column(s)
	var fin := clampf(float(cine_tick) / 60.0, 0.0, 1.0)
	draw_title_glow(font, s.y * 0.22, "THE ROAD ENDS HERE", 42, Color(0.9, 0.55, 0.4, fin), s)
	draw_ornament(s.x * 0.5, s.y * 0.22 + 68.0, 220.0, Color(0.7, 0.45, 0.3, 0.8 * fin))
	draw_string(font, Vector2(0, s.y * 0.40), "Too tired to work. Too poor for a bed. The city keeps what it takes.",
		HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(18), Color(0.85, 0.78, 0.66, fin))
	var lines := [
		"%d day%s on the road" % [int(career["days"]), "" if int(career["days"]) == 1 else "s"],
		"%s performances,  %s catches" % [commafy(int(career["perfs"])), commafy(int(career["catches"]))],
		"best streak %s,  highest score %s" % [commafy(int(career["best_streak"])), score_text(float(career["best_score"]))],
		"%s %s earned, and all of it spent" % [commafy(int(career["gold_earned"])), coin_word()],
	]
	for i in lines.size():
		var la := clampf(float(cine_tick - 80 - i * 30) / 40.0, 0.0, 1.0)
		draw_string(font, Vector2(0, s.y * 0.50 + float(i) * 30.0), String(lines[i]), HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(15), Color(0.75, 0.7, 0.62, la))
	if cine_tick > 90:
		var pa := 0.5 + 0.5 * sin(float(cine_tick) * 0.05)
		draw_string(font, Vector2(0, s.y * 0.80), "any key  -  a new juggler picks up the balls", HORIZONTAL_ALIGNMENT_CENTER, s.x, ps(15), Color(0.8, 0.72, 0.6, 0.4 + 0.5 * pa))
	draw_vignette(s, 0.7)


func draw_demo_wall(font: Font, s: Vector2) -> void:
	# a SCOPED FREE DEMO's own "that's everything" card (Still open), shown once
	# Reputation would have unlocked a venue past DEMO_MAX_VENUE. Deliberately NOT
	# framed as a lockout (Louis's pillars: the first impression is calm, never
	# flash, and this is the LAST impression a demo player gets before deciding
	# whether to buy) - it leads with what they already did, same stat-recap shape
	# as draw_gameover, and the door stays open: enter_day() afterward, no game_state
	# that strands them anywhere but back in the career they were already playing.
	# SEAM (2026-08-13): a curtain drawn shut. This is the LAST thing a demo player sees
	# before deciding whether to buy, and it was a flat near-black rect - the weakest
	# possible frame for the one screen with a commercial job to do. A closed curtain says
	# "the show stopped here, there is more of it" without a word, and it is the same
	# velvet the title screen and the Small Theatre are already made of.
	if not art_blit_rect("ui/end_demo", Rect2(Vector2.ZERO, s)):
		draw_rect(Rect2(0, 0, s.x, s.y), Color(0.03, 0.02, 0.04))
	else:
		draw_read_column(s)
