func ext_arena(s: Vector2) -> void:
	var gy := s.y * 0.80
	draw_gradient_v(Rect2(0, 0, s.x, s.y), Color(0.03, 0.03, 0.08), Color(0.07, 0.05, 0.12), 26)
	draw_stars(s, 46, 0.55)
	# three slow-sweeping search-light beams crossing the sky above the bowl
	for k in 3:
		var ang := -PI * 0.5 + sin(float(cine_tick) * 0.01 + float(k) * 2.1) * 0.5
		var src := Vector2(s.x * (0.2 + 0.3 * float(k)), gy - s.y * 0.18)
		var dir := Vector2(cos(ang), sin(ang))
		var perp := Vector2(-dir.y, dir.x) * 28.0
		draw_colored_polygon(PackedVector2Array([src, src + dir * 620.0 + perp, src + dir * 620.0 - perp]), Color(0.9, 0.85, 0.7, 0.05))
	draw_arena_bowl(Vector2(s.x * 0.5, gy), s.x * 0.96, s.y * 0.5, Color(0.10, 0.09, 0.16), Color(1.0, 0.85, 0.5))
	for i in 120:
		var seed := float(i) * 17.7
		var x := s.x * 0.5 + (fposmod(sin(seed) * 99.0, 1.0) - 0.5) * s.x * 0.7
		var y := gy - fposmod(cos(seed) * 71.0, 1.0) * s.y * 0.26 - 12.0
		var a := 0.3 + 0.4 * sin(float(cine_tick) * 0.05 + seed)
		draw_circle(Vector2(x, y), 1.5, Color(1.0, 0.8, 0.5, clampf(a, 0.1, 0.7)))
	draw_dust(s, 20, Color(1.0, 0.85, 0.55))


func ext_midnight(s: Vector2) -> void:
	# The Midnight Show's own exterior (2026-07-18): the same bowl as ext_arena
	# above (same seed formula, same bones), but no search beams and a small
	# fraction of the crowd lights, dimmer still - echoes venue_data's spot
	# 0.015 (half the Backyard's) so the establishing card promises the same
	# genuinely dark house the stage itself now delivers
	# REBUILT 2026-07-27 (Louis: "the midnight show is literally just black in preview").
	# It was the World Arena's giant bowl in near-black, which is a dark blob and says
	# nothing. The Midnight Show is not a big room - it is the LAST room, the one that
	# opens after everyone has gone home - so its picture is a narrow door down an alley:
	# one green lamp, a clock striking twelve, three people who waited, and the moon.
	# A VALUE LADDER, not a uniform dark (2026-07-27, Louis, second pass: the details are
	# still "some blurry line in the dark"). The composition here was already right - an
	# alley, a marquee, three people who waited - but every structural tone sat between
	# 0.014 and 0.09, a band far too narrow for any of them to separate from each other or
	# from the sky. Brightening them all equally would only make grey fog; what a night
	# picture needs is SPREAD: sky darkest, then the alley walls, then the facade clearly
	# lighter than both, with the lit accents well above all three. The silhouettes stay
	# near-black on purpose - they are read against the lit doorway, not against the sky.
	var gy := s.y * 0.82
	draw_gradient_v(Rect2(0, 0, s.x, s.y), Color(0.030, 0.052, 0.046), Color(0.085, 0.135, 0.105), 22)
	draw_stars(s, 34, 0.75)
	draw_moon(Vector2(s.x * 0.19, s.y * 0.16), 19.0)
	# the alley: two blank walls leaning in, the venue's door between them
	for sgn in [-1.0, 1.0]:
		draw_colored_polygon(PackedVector2Array([
			Vector2(s.x * 0.5 + sgn * s.x * 0.5, 0.0), Vector2(s.x * 0.5 + sgn * s.x * 0.5, gy),
			Vector2(s.x * 0.5 + sgn * s.x * 0.20, gy), Vector2(s.x * 0.5 + sgn * s.x * 0.26, s.y * 0.06)]),
			Color(0.068, 0.100, 0.086))
	var fw := s.x * 0.34
	var fh := s.y * 0.58
	var fx := s.x * 0.5
	draw_rect(Rect2(fx - fw * 0.5, gy - fh, fw, fh), Color(0.150, 0.205, 0.175))
	# the moon catches the parapet and the near corner: an edge is what tells you a flat
	# shape is a building, and it costs two lines
	draw_line(Vector2(fx - fw * 0.5, gy - fh), Vector2(fx + fw * 0.5, gy - fh), Color(0.55, 0.95, 0.70, 0.55), 2.5)
	draw_line(Vector2(fx - fw * 0.5, gy - fh), Vector2(fx - fw * 0.5, gy), Color(0.45, 0.88, 0.62, 0.28), 2.0)
	for i in 4:   # shuttered windows: the rest of the house is asleep
		var wx := fx - fw * 0.32 + float(i % 2) * fw * 0.42
		var wy2 := gy - fh * (0.62 - float(i / 2) * 0.16)
		draw_rect(Rect2(wx, wy2, fw * 0.22, fh * 0.10), Color(0.055, 0.080, 0.068))
		draw_rect(Rect2(wx, wy2, fw * 0.22, fh * 0.10), Color(0.42, 0.80, 0.58, 0.22), false, 1.0)
	# the clock over the door, at twelve
	draw_wall_clock(Vector2(fx, gy - fh * 0.80), 30.0, Color(0.45, 0.95, 0.60))
	# the doorway: a narrow one, with the room's own green light spilling out on the stones
	var dw := 82.0
	var dh := 142.0
	# the doorway is the BRIGHTEST thing in the picture: it is the only opening, it is
	# what the three of them are waiting at, and it is what the silhouettes read against
	draw_rect(Rect2(fx - dw * 0.5, gy - dh, dw, dh), Color(0.10, 0.26, 0.16))
	draw_glow(Vector2(fx, gy - dh * 0.55), dw * 1.35, Color(0.40, 1.0, 0.62, 0.62))
	draw_rect(Rect2(fx - dw * 0.5, gy - dh, dw, dh), Color(0.55, 1.0, 0.70, 0.75), false, 2.5)
	draw_colored_polygon(PackedVector2Array([   # the light on the ground
		Vector2(fx - dw * 0.5, gy), Vector2(fx + dw * 0.5, gy),
		Vector2(fx + dw * 1.2, s.y), Vector2(fx - dw * 1.2, s.y)]), Color(0.38, 0.92, 0.58, 0.20))
	# the one lamp over it, and the board that says there is a show at all
	draw_glow(Vector2(fx, gy - dh - 12.0), 88.0, Color(0.45, 1.0, 0.64, 0.55))
	draw_colored_polygon(PackedVector2Array([
		Vector2(fx - 11.0, gy - dh - 18.0), Vector2(fx + 11.0, gy - dh - 18.0),
		Vector2(fx + 7.0, gy - dh - 6.0), Vector2(fx - 7.0, gy - dh - 6.0)]), Color(0.55, 0.95, 0.65, 0.85))
	draw_rect(Rect2(fx - 62.0, gy - dh - 54.0, 124.0, 22.0), Color(0.075, 0.115, 0.095))
	draw_rect(Rect2(fx - 62.0, gy - dh - 54.0, 124.0, 22.0), Color(0.50, 0.95, 0.65, 0.60), false, 1.5)
	for k in 6:
		var bl := 0.5 + 0.5 * sin(float(cine_tick) * 0.05 + float(k) * 1.1)
		# a marquee bulb is a LAMP: it needs a halo, or it is a rectangle that changes
		# brightness. The halo is what makes the board read as lit from six points.
		draw_glow(Vector2(fx - 49.5 + float(k) * 19.0, gy - dh - 43.0), 15.0,
			Color(0.55, 1.0, 0.68, 0.10 + 0.22 * bl))
		draw_rect(Rect2(fx - 54.0 + float(k) * 19.0, gy - dh - 48.0, 9.0, 10.0),
			Color(0.62, 1.0, 0.72, 0.45 + 0.50 * bl))
	# the ones who waited: three silhouettes by the door, breathing
	for i in 3:
		var px := fx + (-1.0 if i == 0 else (1.0 if i == 1 else 1.35)) * (dw * 0.85 + float(i) * 12.0)
		var bob := sin(float(cine_tick) * 0.02 + float(i) * 1.7) * 1.4
		draw_capsule(Vector2(px, gy + bob), Vector2(px, gy - 52.0 + bob), 26.0, 19.0, Color(0.014, 0.024, 0.020))
		draw_circle(Vector2(px, gy - 61.0 + bob), 9.0, Color(0.014, 0.024, 0.020))
	draw_rect(Rect2(0.0, gy, s.x, s.y - gy), Color(0.062, 0.090, 0.078))
	draw_line(Vector2(0.0, gy), Vector2(s.x, gy), Color(0.42, 0.85, 0.60, 0.30), 1.5)   # the kerb
	draw_dust(s, 10, Color(0.55, 0.95, 0.65))


# --- exterior building / prop primitives -------------------------------------

func draw_stars(s: Vector2, n: int, topfrac: float) -> void:
	for i in n:
		var seed := float(i) * 23.13
		var x := fposmod(sin(seed) * 43758.5, 1.0) * s.x
		var y := fposmod(cos(seed) * 24137.0, 1.0) * s.y * topfrac
		var a := 0.3 + 0.5 * sin(atick() * 0.04 + seed)
		draw_rect(Rect2(x - 1.3, y - 1.3, 2.6, 2.6), Color(1, 1, 1, clampf(a, 0.05, 0.7)))


func draw_moon(pos: Vector2, r: float) -> void:
	draw_circle(pos, r * 1.8, Color(0.9, 0.9, 0.8, 0.08))
	draw_circle(pos, r, Color(0.96, 0.95, 0.86, 0.9))
	draw_circle(pos + Vector2(r * 0.4, -r * 0.2), r * 0.85, Color(0.9, 0.88, 0.78, 0.2))


func draw_house(base: Vector2, w: float, h: float) -> void:
	draw_rect(Rect2(base.x - w * 0.5, base.y - h, w, h), Color(0.10, 0.09, 0.11))
	draw_colored_polygon(PackedVector2Array([
		Vector2(base.x - w * 0.6, base.y - h), Vector2(base.x + w * 0.6, base.y - h), Vector2(base.x, base.y - h - h * 0.5)]), Color(0.07, 0.06, 0.08))
	# a squarer four-pane window with a full cross muntin: the old tall two-pane
	# version read as a giant pause icon (Louis spotted it immediately)
	var flick := 0.7 + 0.3 * sin(atick() * 0.05)
	var ww := w * 0.24
	var wh := h * 0.24
	var wx := base.x - w * 0.22
	var wy := base.y - h * 0.62
	draw_circle(Vector2(wx + ww * 0.5, wy + wh * 0.5), w * 0.3, Color(1.0, 0.7, 0.3, 0.12 * flick))
	draw_rect(Rect2(wx, wy, ww, wh), Color(1.0, 0.78, 0.4, 0.92 * flick))
	draw_rect(Rect2(wx, wy, ww, wh), Color(0.2, 0.12, 0.06), false, 2.0)
	draw_line(Vector2(wx + ww * 0.5, wy), Vector2(wx + ww * 0.5, wy + wh), Color(0.2, 0.12, 0.06), 2.0)
	draw_line(Vector2(wx, wy + wh * 0.5), Vector2(wx + ww, wy + wh * 0.5), Color(0.2, 0.12, 0.06), 2.0)
	# a porch light by the back door, and the pool it throws down the wall: the second
	# warm point the garden needed to read as somebody's home rather than a silhouette
	var px := base.x + w * 0.28
	var py := base.y - h * 0.50
	draw_circle(Vector2(px, py), 26.0, Color(1.0, 0.72, 0.34, 0.07))
	draw_circle(Vector2(px, py), 11.0, Color(1.0, 0.75, 0.38, 0.16))
	draw_colored_polygon(PackedVector2Array([
		Vector2(px - 5.0, py - 5.0), Vector2(px + 5.0, py - 5.0),
		Vector2(px + 3.5, py + 5.0), Vector2(px - 3.5, py + 5.0)]), Color(1.0, 0.84, 0.5, 0.9))
	draw_rect(Rect2(px - 6.0, py - 8.0, 12.0, 3.0), Color(0.14, 0.10, 0.08))


func draw_tree(base: Vector2, sc: float) -> void:
	draw_rect(Rect2(base.x - 6.0 * sc, base.y - 70.0 * sc, 12.0 * sc, 70.0 * sc), Color(0.10, 0.08, 0.07))
	var c := Color(0.09, 0.15, 0.09)
	for o in [Vector2(0, -82), Vector2(-22, -66), Vector2(22, -68), Vector2(-10, -98), Vector2(12, -94)]:
		draw_circle(base + o * sc, 27.0 * sc, c)


func draw_fence(s: Vector2, y: float, x0: float, x1: float) -> void:
	var col := Color(0.14, 0.11, 0.09)
	draw_rect(Rect2(x0, y - 2.0, x1 - x0, 4.0), col)
	var x := x0
	while x <= x1:
		draw_rect(Rect2(x, y - 22.0, 5.0, 22.0), col)
		draw_colored_polygon(PackedVector2Array([Vector2(x, y - 22.0), Vector2(x + 5.0, y - 22.0), Vector2(x + 2.5, y - 28.0)]), col)
		x += 18.0


func draw_grass(s: Vector2, y: float) -> void:
	var col := Color(0.13, 0.20, 0.10)
	var x := 0.0
	while x < s.x:
		var hgt := 6.0 + fposmod(sin(x) * 20.0, 1.0) * 8.0
		draw_line(Vector2(x, y + 6.0), Vector2(x + sin(atick() * 0.02 + x) * 2.0, y + 6.0 - hgt), col, 2.0)
		x += 14.0


func draw_city_row(s: Vector2, gy: float) -> void:
	var xs := [0.0, s.x * 0.14, s.x * 0.30, s.x * 0.50, s.x * 0.66, s.x * 0.82]
	var hs := [0.34, 0.50, 0.42, 0.56, 0.38, 0.48]
	for i in xs.size():
		var bw := s.x * 0.17
		var bh: float = s.y * float(hs[i])
		var bx: float = float(xs[i])
		draw_rect(Rect2(bx, gy - bh, bw, bh), Color(0.07, 0.07, 0.10))
		var wy := gy - bh + 12.0
		while wy < gy - 14.0:
			var wx := bx + 8.0
			while wx < bx + bw - 12.0:
				var lit := fposmod(sin(wx * 3.1 + wy * 1.7 + float(i)) * 99.0, 1.0) > 0.62
				draw_rect(Rect2(wx, wy, 7.0, 9.0), Color(1.0, 0.8, 0.4, 0.8) if lit else Color(0.13, 0.13, 0.17, 0.9))
				wx += 14.0
			wy += 18.0


func draw_streetlamp(base: Vector2, gy: float) -> void:
	draw_glow(Vector2(base.x, gy + 6.0), 150.0, Color(1.0, 0.72, 0.36, 0.22))
	fill_ellipse(Vector2(base.x, gy + 4.0), 92.0, 20.0, Color(1.0, 0.7, 0.35, 0.12))
	# the post reads as a SILHOUETTE against the night, not as black on black: at
	# 0.06 it simply vanished and left the lamp head glowing in mid-air
	draw_rect(Rect2(base.x - 3.0, base.y - 152.0, 6.0, 152.0), Color(0.17, 0.17, 0.20))
	draw_rect(Rect2(base.x - 3.0, base.y - 152.0, 30.0, 5.0), Color(0.17, 0.17, 0.20))
	fill_ellipse(Vector2(base.x, base.y), 11.0, 4.0, Color(0.13, 0.13, 0.16))   # the base plate
	var head := Vector2(base.x + 26.0, base.y - 150.0)
	draw_circle(head, 30.0, Color(1.0, 0.75, 0.4, 0.20))
	draw_colored_polygon(PackedVector2Array([
		Vector2(head.x - 8.0, head.y), Vector2(head.x + 8.0, head.y), Vector2(head.x + 5.0, head.y + 12.0), Vector2(head.x - 5.0, head.y + 12.0)]), Color(1.0, 0.85, 0.5))


func draw_hat_prop(pos: Vector2) -> void:
	fill_ellipse(pos, 26.0, 8.0, Color(0.10, 0.08, 0.09))
	draw_colored_polygon(PackedVector2Array([
		Vector2(pos.x - 14.0, pos.y), Vector2(pos.x + 14.0, pos.y), Vector2(pos.x + 10.0, pos.y - 18.0), Vector2(pos.x - 10.0, pos.y - 18.0)]), Color(0.13, 0.10, 0.11))
	draw_rect(Rect2(pos.x - 10.0, pos.y - 6.0, 20.0, 4.0), Color(0.7, 0.5, 0.3))
	# a few coins already in the brim, and the glint off them: on the street this is
	# the busker's hat lying on the pavement, and it has to read as one from ten feet
	for i in 3:
		var cx := pos.x - 9.0 + float(i) * 9.0
		draw_circle(Vector2(cx, pos.y + 1.0), 3.2, Color(1.0, 0.82, 0.38, 0.9))
		draw_circle(Vector2(cx - 1.0, pos.y), 1.2, Color(1.0, 0.96, 0.76, 0.9))
	draw_circle(pos, 22.0, Color(1.0, 0.8, 0.4, 0.05))


