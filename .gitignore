# Godot 4+ editor and import cache (regenerated automatically, never commit)
.godot/

# macOS Finder metadata
.DS_Store

# Aider working files
.aider*
export/macos/
export/windows/
export/linux/

# dev screenshot captures
shot*.png

# generated by scripts/screenshot.sh and scripts/profile.sh - reproducible,
# timestamped, and not meant to accumulate in git history.
# (the pattern excludes the CONTENTS, not the directory: git will not descend into an
# excluded directory to find a negation, so `artifacts/` plus `!artifacts/menu_half/` below
# would silently do nothing.)
artifacts/*

# ...WITH ONE EXCEPTION, AND IT IS THE WORD "REPRODUCIBLE" THAT EARNS IT (2026-08-20). Every
# other painting under artifacts/ can be re-rolled from the prompt recorded in
# docs/pixellab_prompts.md, so losing it costs one generation. The title screen cannot: the
# shipped bake is roll A's composition with roll B's footlight lamps stamped into it (see
# scripts/add_footlights.py), and no prompt reproduces a specific pair of rolls. half_lit.png
# alone rebuilds the bake; the two ingredients rebuild half_lit.
# This is the same call Assets/Props/big_torch.png already represents - when a generated
# picture is the irreplaceable SOURCE of a shipped asset, it is tracked.
!artifacts/menu_half/
artifacts/menu_half/*.import

# the mechanics reference is GENERATED, and its source IS tracked: docs/mechanics.html.
# Rebuild it with:
#   "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser" --headless --disable-gpu \
#     --no-pdf-header-footer --print-to-pdf="$PWD/TOSSA_mechanics_reference.pdf" \
#     "file://$PWD/docs/mechanics.html"
# (Brave is the only Chromium on this machine - no pandoc, wkhtmltopdf or weasyprint.)
TOSSA_mechanics_reference.pdf

# Python venv for the art/palette tooling (scripts/extract_palette.py).
# Recreate with: python3 -m venv .venv && .venv/bin/pip install Pillow numpy scikit-learn
.venv/

# Python venv for the art/palette tooling (scripts/extract_palette.py).
# Recreate with: python3 -m venv .venv && .venv/bin/pip install Pillow numpy scikit-learn
.venv/

# Python bytecode from the art tooling
scripts/__pycache__/

# Local clone of the old vector version, kept for reference
TOSSA-vector-archive/
